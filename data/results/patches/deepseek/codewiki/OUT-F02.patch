+class _CompilationCache:
+    """A thread-safe LRU cache for compiled grammars.
+
+    Supports sharing of in-progress compilations among concurrent
+    requests for the same key.
+
+    Parameters
+    ----------
+    max_size
+        The maximum number of entries in the cache. ``None`` means
+        unbounded.
+    """
+
+    def __init__(self, max_size: Optional[int] = None):
+        self._max_size = max_size
+        self._cache: OrderedDict = OrderedDict()
+        self._pending: dict = {}  # key -> threading.Event
+        self._results: dict = {}  # key -> (compiled_grammar, exception)
+        self._lock = threading.Lock()
+
+    def get(self, key, compile_fn):
+        """Return a cached compiled grammar, or compile and cache it.
+
+        If another thread is already compiling for the same key, this
+        method will wait for the in-progress compilation to finish.
+
+        Parameters
+        ----------
+        key
+            The cache key (grammar_kind, source_string).
+        compile_fn
+            A zero-argument callable that performs the compilation.
+
+        Returns
+        -------
+        The compiled grammar.
+
+        Raises
+        ------
+        Any exception raised by ``compile_fn``.
+        """
+        event_to_wait = None
+
+        # Check cache / pending
+        with self._lock:
+            if key in self._cache:
+                self._cache.move_to_end(key)
+                return self._cache[key]
+
+            if key in self._pending:
+                event_to_wait = self._pending[key]
+
+        if event_to_wait is not None:
+            # Wait for the other thread outside the lock
+            event_to_wait.wait()
+            with self._lock:
+                compiled, exc = self._results[key]
+                if exc is not None:
+                    raise exc
+                return compiled
+
+        # We might be the compiling thread: register under lock
+        event = threading.Event()
+        event_to_wait = None
+        with self._lock:
+            # Double-check after re-acquiring the lock
+            if key in self._cache:
+                self._cache.move_to_end(key)
+                return self._cache[key]
+
+            if key in self._pending:
+                event_to_wait = self._pending[key]
+            else:
+                self._pending[key] = event
+
+        if event_to_wait is not None:
+            # Another thread registered while we released the lock
+            event_to_wait.wait()
+            with self._lock:
+                compiled, exc = self._results[key]
+                if exc is not None:
+                    raise exc
+                return compiled
+
+        # We are the compiling thread
+        try:
+            compiled = compile_fn()
+            exc = None
+        except Exception as e:
+            compiled = None
+            exc = e
+
+        # Store the result and notify waiting threads
+        with self._lock:
+            self._results[key] = (compiled, exc)
+            event.set()
+
+            if exc is None:
+                # Cache the successful compilation
+                if key in self._cache:
+                    self._cache.move_to_end(key)
+                else:
+                    if self._max_size is not None and len(self._cache) >= self._max_size:
+                        self._cache.popitem(last=False)
+                    self._cache[key] = compiled
+            # For failed compilations, we keep the result in self._results
+            # but don't cache it, so a later request can retry.
+
+            # Remove the pending event since we're done
+            self._pending.pop(key, None)
+
+        if exc is not None:
+            raise exc
+        return compiled
+
+    def clear(self):
+        """Clear all cached entries."""
+        with self._lock:
+            self._cache.clear()
+            self._pending.clear()
+            self._results.clear()
+
+
