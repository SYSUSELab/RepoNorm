+def validate_template_path(template: str) -> None:
+    """Raises ``TemplateNotFound`` if the template name is invalid.
+
+    Valid template names pass without exception. Invalid names are ``None``,
+    the empty string, names containing a NUL byte, names starting with ``/``
+    or ``\\``, names starting with an ASCII drive prefix such as ``C:``, and
+    names containing ASCII control characters (code point < 32) other than
+    tab, newline, or carriage return.
+    """
+    if template is None or template == "":
+        raise TemplateNotFound(template)
+    if "\0" in template:
+        raise TemplateNotFound(template)
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+    if len(template) >= 2 and template[1] == ":" and template[0].isascii() and template[0].isalpha():
+        raise TemplateNotFound(template)
+    for ch in template:
+        if ord(ch) < 32 and ch not in ("\t", "\n", "\r"):
+            raise TemplateNotFound(template)
