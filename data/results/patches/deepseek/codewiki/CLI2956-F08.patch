+
+    def get_option_history(self, name: str) -> list[dict] | None:
+        """Return the assignment history for an option, or ``None`` if
+        tracking is disabled.
+
+        ``name`` may be an option's Python parameter name, a declared
+        long option such as ``"--count"``, or a declared short option
+        such as ``"-c"``.
+
+        Returns ``None`` when tracking is disabled on the current
+        command.  Returns ``[]`` when tracking is enabled but ``name``
+        does not identify an option on the current command.
+        """
+        if not self._track_changes:
+            return None
+
+        param = None
+        if self.command is not None:
+            for p in self.command.get_params(self):
+                if p.name == name:
+                    param = p
+                    break
+                if isinstance(p, Option):
+                    for opt in p.opts:
+                        if opt == name:
+                            param = p
+                            break
+                    if param is not None:
+                        break
+
+        if param is None:
+            return []
+
+        history = self._option_history.get(param.name)
+        if history is None:
+            return []
+        return [dict(entry) for entry in history]
+
+    def _record_option_history(
+        self, param_name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Record an option value assignment."""
+        if param_name not in self._option_history:
+            self._option_history[param_name] = []
+        self._option_history[param_name].append({
+            "value": value,
+            "source": source,
+            "timestamp": __import__("time").time(),
+        })
+
+
