+    def _check_required_if(self, ctx: Context) -> None:
+        """Check if the option is required based on other parameters'
+        values or a callable predicate.
+
+        Called after all parameters have been parsed.  If the
+        condition is met and the option's value is missing, a
+        :class:`MissingParameter` error is raised.
+
+        :param ctx: the current invocation context.
+        """
+        if not self.required_if:
+            return
+
+        if isinstance(self.required_if, cabc.Mapping):
+            # Validate that all keys name existing parameters,
+            # regardless of whether the target already has a value.
+            param_names = {p.name for p in ctx.command.get_params(ctx)}
+            for key in self.required_if:
+                if key not in param_names:
+                    raise UsageError(
+                        f"Parameter {key!r} referenced in 'required_if' of"
+                        f" option {self.name!r} does not exist.",
+                        ctx=ctx,
+                    )
+
+        # If the target already has a non-missing value, skip the check.
+        value = ctx.params.get(self.name)
+        if not self.value_is_missing(value):
+            return
+
+        if callable(self.required_if):
+            if self.required_if(ctx, self):
+                raise MissingParameter(ctx=ctx, param=self)
+            return
+
+        # It's a mapping — check if all conditions match.
+        for key, expected_value in self.required_if.items():
+            actual_value = ctx.params.get(key)
+            if actual_value != expected_value:
+                return
+
+        raise MissingParameter(ctx=ctx, param=self)
 
