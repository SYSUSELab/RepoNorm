+def extract_from_ast_with_metadata(
+    ast: nodes.Template,
+    gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
+    source_name: t.Optional[str] = None,
+) -> t.Iterator[t.MutableMapping[str, t.Any]]:
+    """Extract localizable strings with metadata from the given template
+    AST.  This is similar to :func:`extract_from_ast` but returns records
+    that include metadata from ``{% trans %}`` blocks.
+
+    Each yielded record is a dict with the following keys:
+
+    * ``source`` -- the source string from which the template was parsed
+      (currently ``None`` as it is not tracked in the AST).
+    * ``lineno`` -- the line number of the ``{% trans %}`` block.
+    * ``metadata`` -- a dict of metadata key-value pairs from the trans
+      block header (``note``, ``created``, ``modified``), or ``None``.
+    * ``messages`` -- a list of message dicts, each with:
+        * ``lineno`` -- line number of the gettext call
+        * ``function`` -- the gettext function name
+        * ``message`` -- the extracted message string(s)
+    """
+    # Walk all Output nodes, which are created by trans blocks
+    for output_node in ast.find_all(nodes.Output):
+        # Only process Output nodes that have metadata
+        metadata = getattr(output_node, "metadata", None)
+        if metadata is None:
+            continue
+
+        messages = []
+        for node in output_node.nodes:
+            if isinstance(node, nodes.Call):
+                if (
+                    isinstance(node.node, nodes.Name)
+                    and node.node.name in gettext_functions
+                ):
+                    strings: t.List[t.Optional[str]] = []
+                    for arg in node.args:
+                        if isinstance(arg, nodes.Const) and isinstance(
+                            arg.value, str
+                        ):
+                            strings.append(arg.value)
+                        else:
+                            strings.append(None)
+                    for _ in node.kwargs:
+                        strings.append(None)
+                    if node.dyn_args is not None:
+                        strings.append(None)
+                    if node.dyn_kwargs is not None:
+                        strings.append(None)
+
+                    if len(strings) == 1:
+                        message = strings[0]
+                    else:
+                        message = tuple(strings)
+
+                    messages.append(
+                        {
+                            "lineno": node.lineno,
+                            "function": node.node.name,
+                            "message": message,
+                        }
+                    )
+
+        # Also look for nested Call nodes (for expressions like MarkSafeIfAutoescape wrapping)
+        for node in output_node.find_all(nodes.Call):
+            if (
+                isinstance(node.node, nodes.Name)
+                and node.node.name in gettext_functions
+            ):
+                # Check if this call is already in messages to avoid duplicates
+                already_added = any(
+                    m["lineno"] == node.lineno
+                    and m["function"] == node.node.name
+                    for m in messages
+                )
+                if not already_added:
+                    strings: t.List[t.Optional[str]] = []
+                    for arg in node.args:
+                        if isinstance(arg, nodes.Const) and isinstance(
+                            arg.value, str
+                        ):
+                            strings.append(arg.value)
+                        else:
+                            strings.append(None)
+                    for _ in node.kwargs:
+                        strings.append(None)
+                    if node.dyn_args is not None:
+                        strings.append(None)
+                    if node.dyn_kwargs is not None:
+                        strings.append(None)
+
+                    if len(strings) == 1:
+                        message = strings[0]
+                    else:
+                        message = tuple(strings)
+
+                    messages.append(
+                        {
+                            "lineno": node.lineno,
+                            "function": node.node.name,
+                            "message": message,
+                        }
+                    )
+
+        if messages:
+            yield {
+                "source": source_name,
+                "lineno": output_node.lineno,
+                "metadata": dict(metadata),
+                "messages": messages,
+            }
+
