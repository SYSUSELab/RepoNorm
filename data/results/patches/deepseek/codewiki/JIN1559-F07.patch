+class TestInternationalizationWithFallback:
+    """Tests for install_gettext_callables_with_fallback."""
+
+    def test_method_exists(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        assert hasattr(env, "install_gettext_callables_with_fallback")
+        assert callable(env.install_gettext_callables_with_fallback)
+
+    def test_primary_gettext_hit(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables_with_fallback(
+            lambda x: {"hello": "Hallo", "world": "Welt"}.get(x, x),
+            lambda s, p, n: s if n == 1 else p,
+        )
+        assert env.globals["gettext"]("hello") == "Hallo"
+        assert env.globals["gettext"]("world") == "Welt"
+
+    def test_fallback_gettext_hit(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables_with_fallback(
+            lambda x: x,  # primary always misses
+            lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[
+                lambda x: x,  # fallback1 misses
+                lambda x: {"world": "Mundo"}.get(x, x),  # fallback2 hits for world
+            ],
+        )
+        assert env.globals["gettext"]("hello") == "hello"
+        assert env.globals["gettext"]("world") == "Mundo"
+
+    def test_fallback_first_hit_wins(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables_with_fallback(
+            lambda x: x,  # primary misses
+            lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[
+                lambda x: {"hello": "Mundo"}.get(x, x),  # first fallback hits
+                lambda x: {"hello": "Monde"}.get(x, x),  # second would also hit
+            ],
+        )
+        assert env.globals["gettext"]("hello") == "Mundo"
+
+    def test_all_miss_returns_source(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables_with_fallback(
+            lambda x: x,  # primary misses
+            lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[
+                lambda x: x,  # fallback misses
+                lambda x: x,  # fallback misses
+            ],
+        )
+        assert env.globals["gettext"]("untouched") == "untouched"
+
+    def test_ngettext_fallback_singular(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables_with_fallback(
+            lambda x: x,
+            lambda s, p, n: {"cat": "Katze"}.get(s, s if n == 1 else p),
+            fallback_ngettext_funcs=[
+                lambda s, p, n: {"cat": "Gato"}.get(s, s if n == 1 else p),
+            ],
+        )
+        # Primary translates cat -> Katze (singular), so it hits
+        assert env.globals["ngettext"]("cat", "cats", 1) == "Katze"
+
+    def test_ngettext_fallback_plural(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables_with_fallback(
