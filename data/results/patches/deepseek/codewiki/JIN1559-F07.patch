@@ -241,6 +241,100 @@ def _make_new_npgettext(
 
     return npgettext
 
+def _make_gettext_with_fallback(
+    primary: t.Callable[[str], str],
+    fallbacks: t.Sequence[t.Callable[[str], str]],
+) -> t.Callable[[str], str]:
+    """Create a gettext function that tries fallback providers on miss.
+    
+    The primary is called first. If the result equals the source message,
+    each fallback is tried in order until one returns a different result.
+    If all return the message itself, the message is returned.
+    """
+    def gettext(message: str) -> str:
+        rv = primary(message)
+        if rv != message:
+            return rv
+        for fallback in fallbacks:
+            rv = fallback(message)
+            if rv != message:
+                return rv
+        return message
+    return gettext
+
+
+def _make_ngettext_with_fallback(
+    primary: t.Callable[[str, str, int], str],
+    fallbacks: t.Sequence[t.Callable[[str, str, int], str]],
+) -> t.Callable[[str, str, int], str]:
+    """Create an ngettext function that tries fallback providers on miss.
+    
+    The primary is called first. If the result equals the selected source
+    form (singular for n == 1, plural otherwise), each fallback is tried
+    in order until one returns a different result. If all return the
+    selected form, that form is returned.
+    """
+    def ngettext(singular: str, plural: str, n: int) -> str:
+        expected = singular if n == 1 else plural
+        rv = primary(singular, plural, n)
+        if rv != expected:
+            return rv
+        for fallback in fallbacks:
+            rv = fallback(singular, plural, n)
+            if rv != expected:
+                return rv
+        return expected
+    return ngettext
+
+
+def _make_pgettext_with_fallback(
+    primary: t.Callable[[str, str], str],
+    fallbacks: t.Sequence[t.Callable[[str, str], str]],
+) -> t.Callable[[str, str], str]:
+    """Create a pgettext function that tries fallback providers on miss.
+    
+    The primary is called first with both context and message. If the
+    result equals the source message, each fallback is tried in order
+    until one returns a different result. If all return the message
+    itself, the message is returned.
+    """
+    def pgettext(context: str, message: str) -> str:
+        rv = primary(context, message)
+        if rv != message:
+            return rv
+        for fallback in fallbacks:
+            rv = fallback(context, message)
+            if rv != message:
+                return rv
+        return message
+    return pgettext
+
+
+def _make_npgettext_with_fallback(
+    primary: t.Callable[[str, str, str, int], str],
+    fallbacks: t.Sequence[t.Callable[[str, str, str, int], str]],
+) -> t.Callable[[str, str, str, int], str]:
+    """Create an npgettext function that tries fallback providers on miss.
+    
+    The primary is called first with both context, singular, plural, and
+    number. If the result equals the selected source form (singular for
+    n == 1, plural otherwise), each fallback is tried in order until one
+    returns a different result. If all return the selected form, that
+    form is returned.
+    """
+    def npgettext(context: str, singular: str, plural: str, n: int) -> str:
+        expected = singular if n == 1 else plural
+        rv = primary(context, singular, plural, n)
+        if rv != expected:
+            return rv
+        for fallback in fallbacks:
+            rv = fallback(context, singular, plural, n)
+            if rv != expected:
+                return rv
+        return expected
+    return npgettext
+
+
 
 class InternationalizationExtension(Extension):
     """This extension adds gettext support to Jinja."""
