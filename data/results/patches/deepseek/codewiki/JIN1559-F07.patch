@@ -336,6 +431,50 @@ class InternationalizationExtension(Extension):
             gettext=gettext, ngettext=ngettext, pgettext=pgettext, npgettext=npgettext
         )
 
+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, int], str]]] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str], str]]] = None,
+        fallback_npgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, str, int], str]]] = None,
+    ) -> None:
+        # Snapshot fallback iterables
+        fb_gettext = list(fallback_gettext_funcs) if fallback_gettext_funcs else []
+        fb_ngettext = list(fallback_ngettext_funcs) if fallback_ngettext_funcs else []
+        fb_pgettext = list(fallback_pgettext_funcs) if fallback_pgettext_funcs else []
+        fb_npgettext = list(fallback_npgettext_funcs) if fallback_npgettext_funcs else []
+
+        # Validate that contextual fallbacks require the primary
+        if fb_pgettext and pgettext is None:
+            raise ValueError(
+                "fallback_pgettext_funcs requires a primary pgettext callable"
+            )
+        if fb_npgettext and npgettext is None:
+            raise ValueError(
+                "fallback_npgettext_funcs requires a primary npgettext callable"
+            )
+
+        # Compose primary with fallbacks
+        if fb_gettext:
+            gettext = _make_gettext_with_fallback(gettext, fb_gettext)
+        if fb_ngettext:
+            ngettext = _make_ngettext_with_fallback(ngettext, fb_ngettext)
+        if fb_pgettext and pgettext is not None:
+            pgettext = _make_pgettext_with_fallback(pgettext, fb_pgettext)
+        if fb_npgettext and npgettext is not None:
+            npgettext = _make_npgettext_with_fallback(npgettext, fb_npgettext)
+
+        # Delegate to the existing installer for newstyle wrapping and globals update
+        self._install_callables(
+            gettext, ngettext, newstyle=newstyle,
+            pgettext=pgettext, npgettext=npgettext,
+        )
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
         for key in ("gettext", "ngettext", "pgettext", "npgettext"):
             self.environment.globals.pop(key, None)
