+    @staticmethod
+    def _validate_trans_expression(
+        parser: "Parser",
+        var_name: str,
+        expr: nodes.Expr,
+    ) -> None:
+        """Validate a trans variable expression tree.
+
+        Only constants, names, attribute access, filters, tests,
+        and calls whose callee is a simple name are allowed.
+        Dynamic *args and **kwargs are rejected.
+        """
+        from jinja2.nodes import (
+            Const, Name, Getattr, Filter, Test, Call,
+            Getitem, CondExpr,
+        )
+
+        def _check(node: nodes.Expr) -> None:
+            if isinstance(node, Const):
+                return
+            if isinstance(node, Name):
+                return
+            if isinstance(node, Getattr):
+                _check(node.node)
+                return
+            if isinstance(node, Filter):
+                if node.node is not None:
+                    _check(node.node)
+                for arg in node.args:
+                    _check(arg)
+                for kw in node.kwargs:
+                    _check(kw.value)
+                return
+            if isinstance(node, Test):
+                if node.node is not None:
+                    _check(node.node)
+                for arg in node.args:
+                    _check(arg)
+                for kw in node.kwargs:
+                    _check(kw.value)
+                return
+            if isinstance(node, Call):
+                if not isinstance(node.node, Name):
+                    parser.fail(
+                        f"Expression for {var_name!r} contains invalid call: "
+                        f"only simple name callees are allowed in trans block "
+                        f"template data and translation contexts",
+                        lineno=node.lineno,
+                    )
+                if node.dyn_args is not None or node.dyn_kwargs is not None:
+                    parser.fail(
+                        f"Expression for {var_name!r} contains dynamic *args or "
+                        f"**kwargs which are not allowed in trans block "
+                        f"template data and translation contexts",
+                        lineno=node.lineno,
+                    )
+                _check(node.node)
+                for arg in node.args:
+                    _check(arg)
+                for kw in node.kwargs:
+                    _check(kw.value)
+                return
+            if isinstance(node, Getitem):
+                parser.fail(
+                    f"Expression for {var_name!r} contains item access which "
+                    f"is not allowed in trans block "
+                    f"template data and translation contexts",
+                    lineno=node.lineno,
+                )
+            if isinstance(node, CondExpr):
+                parser.fail(
+                    f"Expression for {var_name!r} contains a conditional "
+                    f"expression which is not allowed in trans block "
+                    f"template data and translation contexts",
+                    lineno=node.lineno,
+                )
+            # Reject any other expression types (arithmetic, boolean,
+            # comparison, method calls, etc.)
+            parser.fail(
+                f"Expression for {var_name!r} contains constructs not "
+                f"allowed in trans block "
+                f"template data and translation contexts",
+                lineno=node.lineno,
+            )
+
+        _check(expr)
+
