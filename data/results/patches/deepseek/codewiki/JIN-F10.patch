+    Use the ``filter_groups`` parameter to keep only groups where the
+    given callable returns a truthy value when passed the complete
+    member list of each group. Use ``@pass_environment`` to also receive
+    the active :class:`Environment` before the member list.
+
+    .. sourcecode:: jinja
+
+        {% for grouper, items in items|groupby("city", filter_groups=check) %}
+          ...
+        {% endfor %}
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,6 +1223,22 @@ def sync_do_groupby(
