+def set_ttl(seconds: Optional[float] = None):
+    """Set the default TTL (time-to-live) for the active global DSPy cache.
+
+    This changes the lifetime used by subsequent writes without:
+        - clearing existing entries
+        - extending their existing deadlines
+        - changing the active cache's enabled layers, location or capacity
+
+    Setting it back to None makes new writes nonexpiring;
+    already expiring entries still expire.
+
+    Args:
+        seconds: Time-to-live in seconds for new cache entries.
+                 None means no expiration for new entries.
+
+    Raises:
+        ValueError: If seconds is not None and not a positive finite number.
+    """
+    _validate_ttl(seconds)
