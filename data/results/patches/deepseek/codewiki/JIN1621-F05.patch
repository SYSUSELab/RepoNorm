+            f.write("c2")
+        fname1 = loader.resolve_template_path("c1.html")
+        loader._set_cached("c1.html", fname1, 0)
+        fname2 = loader.resolve_template_path("c2.html")
+        loader._set_cached("c2.html", fname2, 0)
+        assert len(loader._path_cache) == 2
+        loader.clear_path_cache()
+        assert len(loader._path_cache) == 0
+
+    def test_clear_path_cache_noop_when_disabled(self):
+        """clear_path_cache when cache is disabled does nothing."""
+        loader = loaders.FileSystemLoader("/tmp", path_cache_size=0)
+        loader.clear_path_cache()  # Should not raise
+
+    # --- resize_path_cache ---
+
+    def test_resize_path_cache_larger(self, dirs, loader):
+        """Resizing to larger capacity keeps all entries."""
+        with open(os.path.join(dirs, "dir2", "a.html"), "w") as f:
+            f.write("a")
+        with open(os.path.join(dirs, "dir2", "b.html"), "w") as f:
+            f.write("b")
+        fname = loader.resolve_template_path("a.html")
+        loader._set_cached("a.html", fname, 0)
+        fname = loader.resolve_template_path("b.html")
+        loader._set_cached("b.html", fname, 0)
+        loader.resize_path_cache(10)
+        assert len(loader._path_cache) == 2
+
+    def test_resize_path_cache_smaller_evicts_lru(self, dirs, loader):
+        """Resizing to smaller capacity evicts LRU entries."""
+        with open(os.path.join(dirs, "dir2", "x.html"), "w") as f:
+            f.write("x")
+        with open(os.path.join(dirs, "dir2", "y.html"), "w") as f:
