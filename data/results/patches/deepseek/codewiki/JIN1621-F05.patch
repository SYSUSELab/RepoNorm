+class TestFileSystemLoaderPathCache:
+    """Tests for the optional bounded resolved-path cache on FileSystemLoader."""
+
+    @pytest.fixture
+    def dirs(self):
+        tmpdir = tempfile.mkdtemp()
+        os.makedirs(os.path.join(tmpdir, "dir1"))
+        os.makedirs(os.path.join(tmpdir, "dir2"))
+        yield tmpdir
+        shutil.rmtree(tmpdir)
+
+    @pytest.fixture
+    def loader(self, dirs):
+        return loaders.FileSystemLoader(
+            [os.path.join(dirs, "dir2"), os.path.join(dirs, "dir1")],
+            path_cache_size=5,
+        )
+
+    # --- Constructor validation ---
+
+    def test_default_no_cache(self):
+        """Default path_cache_size of 0 disables caching."""
+        loader = loaders.FileSystemLoader("/tmp")
+        assert loader._path_cache is None
+        assert loader._path_cache_size == 0
+
+    def test_positive_size_enables_cache(self):
+        """Positive integer enables the cache."""
+        loader = loaders.FileSystemLoader("/tmp", path_cache_size=10)
+        assert loader._path_cache is not None
+        assert loader._path_cache_size == 10
+
+    def test_rejects_boolean(self):
+        """Booleans are rejected."""
+        with pytest.raises(ValueError):
+            loaders.FileSystemLoader("/tmp", path_cache_size=True)
+        with pytest.raises(ValueError):
+            loaders.FileSystemLoader("/tmp", path_cache_size=False)
+
+    def test_rejects_negative(self):
+        """Negative integers are rejected."""
+        with pytest.raises(ValueError):
+            loaders.FileSystemLoader("/tmp", path_cache_size=-1)
+
+    # --- resolve_template_path ---
+
+    def test_resolve_template_path_found(self, dirs):
+        loader = loaders.FileSystemLoader(
+            [os.path.join(dirs, "dir2"), os.path.join(dirs, "dir1")],
+        )
+        with open(os.path.join(dirs, "dir1", "test.txt"), "w") as f:
+            f.write("hello")
+        result = loader.resolve_template_path("test.txt")
+        assert result == os.path.join(dirs, "dir1", "test.txt")
+
+    def test_resolve_template_path_not_found(self, dirs):
+        loader = loaders.FileSystemLoader(
+            [os.path.join(dirs, "dir2"), os.path.join(dirs, "dir1")],
+        )
+        result = loader.resolve_template_path("nonexistent.txt")
+        assert result is None
+
+    def test_resolve_template_path_priority(self, dirs):
+        """Earlier searchpath takes priority."""
+        with open(os.path.join(dirs, "dir2", "same.txt"), "w") as f:
+            f.write("dir2")
+        with open(os.path.join(dirs, "dir1", "same.txt"), "w") as f:
+            f.write("dir1")
+        loader = loaders.FileSystemLoader(
+            [os.path.join(dirs, "dir2"), os.path.join(dirs, "dir1")],
+        )
+        result = loader.resolve_template_path("same.txt")
+        assert "dir2" in result  # dir2 is first in searchpath
+
+    # --- Cache behavior ---
+
+    def test_cache_hits(self, dirs, loader):
+        """Cached templates are returned without calling resolve_template_path."""
+        with open(os.path.join(dirs, "dir2", "hit.html"), "w") as f:
+            f.write("hit")
+        # First access - resolve and cache
+        fname = loader.resolve_template_path("hit.html")
+        loader._set_cached("hit.html", fname, 0)
+        # Second access - should hit cache
+        cached = loader._get_cached("hit.html")
+        assert cached == fname
+
+    def test_cache_misses_not_cached(self, dirs, loader):
+        """Misses (template not found) are never cached."""
+        result = loader.resolve_template_path("missing.html")
+        assert result is None
+        # No caching for misses
+        assert loader._path_cache is not None
+        assert "missing.html" not in loader._path_cache
+
+    def test_cached_file_removed_is_resolved_again(self, dirs, loader):
+        """A cached file that is removed triggers re-resolution."""
+        with open(os.path.join(dirs, "dir2", "removable.html"), "w") as f:
+            f.write("removable")
+        fname = loader.resolve_template_path("removable.html")
+        loader._set_cached("removable.html", fname, 0)
+        assert loader._get_cached("removable.html") is not None
+        os.remove(os.path.join(dirs, "dir2", "removable.html"))
+        assert loader._get_cached("removable.html") is None
+
+    def test_priority_override_when_file_appears_in_earlier_path(self, dirs):
+        """If a template was cached from a lower-priority path and the same
+        name later appears in an earlier path, the earlier path takes
+        precedence."""
+        # Initially only in dir1 (lower priority)
+        with open(os.path.join(dirs, "dir1", "shared.html"), "w") as f:
+            f.write("from dir1")
+        loader = loaders.FileSystemLoader(
+            [os.path.join(dirs, "dir2"), os.path.join(dirs, "dir1")],
+            path_cache_size=5,
+        )
+        # Cache from dir1
+        fname = loader.resolve_template_path("shared.html")
+        assert "dir1" in fname
+        loader._set_cached("shared.html", fname, 1)
+        assert "dir1" in loader._get_cached("shared.html")
+
+        # Now add file to dir2 (higher priority)
+        with open(os.path.join(dirs, "dir2", "shared.html"), "w") as f:
+            f.write("from dir2")
+        # Cache should now miss because higher-priority path has the template
+        cached = loader._get_cached("shared.html")
+        assert cached is None, f"Expected None, got {cached}"
+        # Re-resolution should find dir2 version
+        fname = loader.resolve_template_path("shared.html")
+        assert "dir2" in fname
+
+    # --- clear_path_cache ---
+
+    def test_clear_path_cache(self, dirs, loader):
