+def _truncate_description(description, max_chars):
+    """Truncate a description to fit within max_chars characters.
+    
+    If max_chars is None, return description unchanged.
+    If description length <= max_chars, return description unchanged.
+    If max_chars <= 1, return only '…'.
+    
+    Otherwise, reserve one character for '…' and find the last complete
+    sentence ending (. ! ? followed by whitespace or end) that fits within
+    the remaining space. If none fits, take a hard prefix.
+    """
+    if max_chars is None:
+        return description
+    if len(description) <= max_chars:
+        return description
+    if max_chars <= 1:
+        return '…'
+
+    limit = max_chars - 1
+
+    cut = -1
+    n = len(description)
+    i = 0
+    while i < limit and i < n:
+        ch = description[i]
+        if ch in '.!?':
+            if i + 1 >= n:
+                cut = i + 1
+            elif description[i + 1] in ' \t\n\r\f\v':
+                cut = i + 2
+        i += 1
+
+    if cut > 0:
+        result = description[:cut].rstrip()
+    else:
+        result = description[:limit].rstrip()
+
+    return result + '…'
+
