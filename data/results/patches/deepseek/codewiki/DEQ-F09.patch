@@ -0,0 +1,269 @@
+import pytest
+
+from dirty_equals import IsColor
+
+
+# ========== Valid hex ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('#FF5733', IsColor),
+        ('#FF5733', IsColor()),
+        ('#FF5733', IsColor('hex')),
+        ('#f57', IsColor),
+        ('#f57', IsColor('hex')),
+        ('ff5733', IsColor),
+        ('ff5733', IsColor('hex')),
+        ('#FFF', IsColor),
+        ('#fff', IsColor('hex')),
+        ('#000', IsColor),
+        ('#000000', IsColor),
+    ],
+)
+def test_hex_true(other, dirty):
+    assert other == dirty
+
+
+# ========== Valid RGB ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('rgb(255, 87, 51)', IsColor),
+        ('rgb(255, 87, 51)', IsColor()),
+        ('rgb(255, 87, 51)', IsColor('rgb')),
+        ('RGB(255, 87, 51)', IsColor),
+        ('rgb(0, 0, 0)', IsColor('rgb')),
+        ('rgb(255, 255, 255)', IsColor('rgb')),
+        ('rgb(100, 200, 50)', IsColor),
+        ('rgb( 255 , 87 , 51 )', IsColor),
+        ('rgb(255,87,51)', IsColor),
+        ('rgb(100%, 0%, 50%)', IsColor),
+        ('rgb(100%, 0%, 50%)', IsColor('rgb')),
+        ('rgb(0%, 0%, 0%)', IsColor),
+        ('rgb(100%, 100%, 100%)', IsColor),
+        ('rgb(50%, 50%, 50%)', IsColor),
+    ],
+)
+def test_rgb_true(other, dirty):
+    assert other == dirty
+
+
+# ========== Valid HSL ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('hsl(14, 100%, 60%)', IsColor),
+        ('hsl(14, 100%, 60%)', IsColor()),
+        ('hsl(14, 100%, 60%)', IsColor('hsl')),
+        ('HSL(14, 100%, 60%)', IsColor),
+        ('hsl(0, 0%, 0%)', IsColor('hsl')),
+        ('hsl(360, 100%, 100%)', IsColor),
+        ('hsl(14deg, 100%, 60%)', IsColor),
+        ('hsl(14DEG, 100%, 60%)', IsColor),
+        ('hsl( 14 , 100% , 60% )', IsColor),
+        ('hsl(14,100%,60%)', IsColor),
+        ('hsl(180, 50%, 25%)', IsColor),
+    ],
+)
+def test_hsl_true(other, dirty):
+    assert other == dirty
+
+
+# ========== Invalid: non-string ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        (123, IsColor),
+        ([1, 2, 3], IsColor()),
+        (None, IsColor),
+        (True, IsColor()),
+        ({'color': '#fff'}, IsColor),
+    ],
+)
+def test_non_string_false(other, dirty):
+    assert other != dirty
+
+
+# ========== Invalid: malformed hex ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('xyz', IsColor),
+        ('#GGGGGG', IsColor),
+        ('#1234', IsColor),  # 4 digits not supported
+        ('#12345', IsColor),  # 5 digits not supported
+        ('1234567', IsColor),  # 7 digits not supported
+        ('##fff', IsColor),
+        ('#ff ff', IsColor),
+    ],
+)
+def test_hex_false(other, dirty):
+    assert other != dirty
+
+
+# ========== Invalid: malformed RGB ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('rgb(256, 0, 0)', IsColor),  # out of range
+        ('rgb(0, 0, 300)', IsColor),  # out of range
+        ('rgb(101%, 0, 0)', IsColor),  # percentage >100
+        ('rgb(-1, 0, 0)', IsColor),  # negative not allowed
+        ('rgb(0, 0, 0, 0)', IsColor),  # alpha not supported
+        ('rgb(255)', IsColor),  # incomplete
+        ('rgb()', IsColor),  # empty
+        ('rgb(255, 0)', IsColor),  # missing component
+        ('rgba(255, 0, 0, 0.5)', IsColor),  # rgba not supported
+        ('rgb(12.5, 0, 0)', IsColor),  # no fractions
+        ('rgb(+5, 0, 0)', IsColor),  # no signs
+    ],
+)
+def test_rgb_false(other, dirty):
+    assert other != dirty
+
+
+# ========== Invalid: malformed HSL ==========
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('hsl(361, 100%, 60%)', IsColor),  # hue >360
+        ('hsl(14, 101%, 60%)', IsColor),  # saturation >100
+        ('hsl(14, 100%, 101%)', IsColor),  # lightness >100
+        ('hsl(-1, 50%, 50%)', IsColor),  # negative hue
+        ('hsl(14, -1%, 50%)', IsColor),  # negative saturation
+        ('hsl(14, 50%, -1%)', IsColor),  # negative lightness
+        ('hsl(14, 50, 50)', IsColor),  # missing % on saturation
+        ('hsl(14, 50%, 50)', IsColor),  # missing % on lightness
+        ('hsla(14, 100%, 60%, 0.5)', IsColor),  # hsla not supported
+        ('hsl(14, 100%, 60%, 0.5)', IsColor),  # alpha not supported
+        ('hsl(14, 100%)', IsColor),  # incomplete
+        ('hsl()', IsColor),  # empty
+    ],
+)
+def test_hsl_false(other, dirty):
+    assert other != dirty
+
+
+# ========== Format-specific false ==========
+
+def test_format_specific():
+    # Only hex format
+    assert '#FF5733' == IsColor('hex')
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+    assert 'hsl(14, 100%, 60%)' != IsColor('hex')
+
+    # Only rgb format
+    assert '#FF5733' != IsColor('rgb')
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'hsl(14, 100%, 60%)' != IsColor('rgb')
+
+    # Only hsl format
+    assert '#FF5733' != IsColor('hsl')
+    assert 'rgb(255, 87, 51)' != IsColor('hsl')
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+
+
+# ========== Repr tests ==========
+
+def test_repr_no_format():
+    assert repr(IsColor()) == 'IsColor(*)'
+    assert repr(IsColor) == 'IsColor'  # class repr is just the class name
+
+
+def test_repr_hex():
+    assert repr(IsColor('hex')) == "IsColor('hex')"
+
+
+def test_repr_rgb():
+    assert repr(IsColor('rgb')) == "IsColor('rgb')"
+
+
+def test_repr_hsl():
+    assert repr(IsColor('hsl')) == "IsColor('hsl')"
+
+
+def test_repr_in_assertion_error():
+    c = IsColor()
+    with pytest.raises(AssertionError):
+        assert 'invalid' == c
+    assert str(c) == 'IsColor(*)'
+
+
+def test_repr_hex_in_assertion_error():
+    c = IsColor('hex')
+    with pytest.raises(AssertionError):
+        assert 'invalid' == c
+    assert str(c) == "IsColor('hex')"
+
+
+# ========== Edge cases ==========
+
+def test_whitespace_tolerance():
+    # Whitespace around complete value
+    assert '  #FF5733  ' == IsColor('hex')
+    assert '  rgb(255, 87, 51)  ' == IsColor('rgb')
+    assert '  hsl(14, 100%, 60%)  ' == IsColor('hsl')
+
+    # Value with leading/trailing whitespace only
+    assert '  #abc  ' == IsColor
+
+
+def test_case_insensitivity():
+    # Hex is case insensitive
+    assert '#FF5733' == IsColor('hex')
+    assert '#ff5733' == IsColor('hex')
+    assert '#Ff5733' == IsColor('hex')
+
+    # RGB function name is case insensitive
+    assert 'RGB(255, 87, 51)' == IsColor('rgb')
+    assert 'Rgb(255, 87, 51)' == IsColor('rgb')
+
+    # HSL function name is case insensitive
+    assert 'HSL(14, 100%, 60%)' == IsColor('hsl')
+    assert 'Hsl(14, 100%, 60%)' == IsColor('hsl')
+
+    # deg suffix is case insensitive
+    assert 'hsl(14DEG, 100%, 60%)' == IsColor('hsl')
+
+
+def test_named_colors_not_supported():
+    assert 'red' != IsColor
+    assert 'blue' != IsColor
+    assert 'green' != IsColor
+    assert 'transparent' != IsColor
+
+
+def test_no_alpha():
+    assert '#FF573388' != IsColor  # 8-digit hex with alpha
+    assert 'rgb(255, 87, 51, 0.5)' != IsColor
+    assert 'hsl(14, 100%, 60%, 0.5)' != IsColor
+
+
+def test_hex_without_hash():
+    assert 'FF5733' == IsColor('hex')
+    assert 'abc' == IsColor('hex')
+    assert 'ABC123' == IsColor
+
+
+def test_rgb_all_percentages():
+    assert 'rgb(0%, 50%, 100%)' == IsColor('rgb')
+    assert 'rgb(100%, 0%, 50%)' == IsColor
+
+
+def test_rgb_mixed_percentages_and_integers():
+    assert 'rgb(255, 50%, 100)' == IsColor
+
+
+def test_hsl_boundary_values():
+    # Boundary values for HSL
+    assert 'hsl(0, 0%, 0%)' == IsColor('hsl')
+    assert 'hsl(360, 100%, 100%)' == IsColor('hsl')
+    assert 'hsl(0deg, 0%, 0%)' == IsColor('hsl')
+    assert 'hsl(360DEG, 100%, 100%)' == IsColor('hsl')
