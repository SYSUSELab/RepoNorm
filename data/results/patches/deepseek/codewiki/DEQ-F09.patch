@@ -0,0 +1,144 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+
+class IsColor(DirtyEquals[str]):
+    """
+    Validates color codes across multiple formats including hex, RGB, and HSL.
+
+    Supports three- and six-digit hexadecimal values with an optional `#`,
+    integer or percentage RGB components in their valid ranges, and HSL values
+    with valid hue, saturation, and lightness ranges, including an optional
+    `deg` suffix on hue.
+
+    Args:
+        format: optional expected color format ('hex', 'rgb', or 'hsl').
+            If omitted, any supported format is allowed.
+
+    Examples:
+    ```py title="IsColor"
+    from dirty_equals import IsColor
+
+    # Hex colors
+    assert '#FF5733' == IsColor()
+    assert 'FF5733' == IsColor()
+    assert '#f57' == IsColor()
+    assert '#FF5733' == IsColor('hex')
+
+    # RGB colors
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'rgb(100%, 0%, 50%)' == IsColor()
+    assert 'RGB( 255 , 87 , 51 )' == IsColor('rgb')
+
+    # HSL colors
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'hsl(14deg, 100%, 60%)' == IsColor('hsl')
+
+    # Non-matching cases
+    assert 'foobar' != IsColor()
+    assert 123 != IsColor()
+    assert 'rgb(300, 0, 0)' != IsColor()
+    assert '#FF5733' != IsColor('hsl')
+    ```
+    """
+
+    _HEX_PATTERN = re.compile(r'^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$')
+
+    _RGB_PATTERN = re.compile(
+        r'^rgb\(\s*(\d{1,3})(%?)\s*,\s*(\d{1,3})(%?)\s*,\s*(\d{1,3})(%?)\s*\)$',
+        re.IGNORECASE,
+    )
+
+    _HSL_PATTERN = re.compile(
+        r'^hsl\(\s*(\d{1,3})(deg)?\s*,\s*(\d{1,3})%\s*,\s*(\d{1,3})%\s*\)$',
+        re.IGNORECASE,
+    )
+
+    def __init__(self, format: Optional[str] = None):
+        """
+        Args:
+            format: The expected color format ('hex', 'rgb', 'hsl').
+                If None, any format is accepted.
+        """
+        self.format = format
+        if format is None:
+            super().__init__(plain_repr('*'))
+        else:
+            super().__init__(format)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        other = other.strip()
+
+        if self.format is None or self.format == 'hex':
+            if self._check_hex(other):
+                return True
+
+        if self.format is None or self.format == 'rgb':
+            if self._check_rgb(other):
+                return True
+
+        if self.format is None or self.format == 'hsl':
+            if self._check_hsl(other):
+                return True
+
+        return False
+
+    @classmethod
+    def _check_hex(cls, value: str) -> bool:
+        """Check if value is a valid hex color code."""
+        return bool(cls._HEX_PATTERN.match(value))
+
+    @classmethod
+    def _check_rgb(cls, value: str) -> bool:
+        """Check if value is a valid RGB color code."""
+        match = cls._RGB_PATTERN.match(value)
+        if not match:
+            return False
+
+        # Validate each component
+        for i in range(3):
+            group_idx = 1 + i * 2
+            value_str = match.group(group_idx)
+            has_percent = bool(match.group(group_idx + 1))
+
+            num = int(value_str)
+            if has_percent:
+                # Percentage: 0-100
+                if num < 0 or num > 100:
+                    return False
+            else:
+                # Integer: 0-255
+                if num < 0 or num > 255:
+                    return False
+
+        return True
+
+    @classmethod
+    def _check_hsl(cls, value: str) -> bool:
+        """Check if value is a valid HSL color code."""
+        match = cls._HSL_PATTERN.match(value)
+        if not match:
+            return False
+
+        # Hue: 0-360
+        hue = int(match.group(1))
+        if hue < 0 or hue > 360:
+            return False
+
+        # Saturation: 0-100
+        sat = int(match.group(3))
+        if sat < 0 or sat > 100:
+            return False
+
+        # Lightness: 0-100
+        light = int(match.group(4))
+        if light < 0 or light > 100:
+            return False
+
+        return True
