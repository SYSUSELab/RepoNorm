         """
         raise TypeError("this loader cannot iterate over all templates")
 
+    #: Maps alias names to target names. An alias is resolved exactly once
+    #: by the loader that owns it, before that loader performs its normal
+    #: loading or composite routing; aliases do not chain.
+    #:
+    #: .. versionadded:: 3.1
+    #: Instance variable initialized lazily; do not set at class level.
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Add an alias for a template name. The alias is resolved before
+        the loader performs its normal loading. A missing target raises
+        :class:`TemplateNotFound` for the target name when the alias is
+        used, not when the alias is added.
+
+        Adding an existing alias overwrites it. Alias mutation invalidates
+        the corresponding cache entry in every environment that has loaded
+        the alias.
+
+        .. versionadded:: 3.1
+        """
+        if not hasattr(self, '_aliases'):
+            self._aliases = {}
+        self._aliases[alias] = target
+        self._alias_invalidate(alias)
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias. If the alias does not exist, nothing happens.
+        Removing an alias invalidates the corresponding cache entry in
+        every environment that has loaded the alias.
+
+        .. versionadded:: 3.1
+        """
+        aliases = getattr(self, '_aliases', None)
+        if aliases is not None and alias in aliases:
+            del aliases[alias]
+            self._alias_invalidate(alias)
+
+    def _resolve_alias(self, name: str) -> str:
+        """Resolve an alias if *name* is an alias. Aliases are resolved
+        exactly once — the target is not further resolved as an alias.
+        """
+        aliases = getattr(self, '_aliases', None)
+        if aliases is None:
+            return name
+        return aliases.get(name, name)
+
+    def _include_alias_in_list(self, template_list: t.List[str]) -> t.List[str]:
+        """Add aliases whose target appears in *template_list* to the list.
+        Broken aliases (target not in the list) are omitted.
+        """
+        aliases = getattr(self, '_aliases', None)
+        if aliases is None:
+            return template_list
+        for alias, target in aliases.items():
+            if target in template_list and alias not in template_list:
+                template_list.append(alias)
+        return template_list
+
+    def _alias_invalidate(self, alias: str) -> None:
+        """Invalidate the cache entry for *alias* in every environment that
+        has this loader registered.
+        """
+        try:
+            env_refs = self._alias_env_refs
+        except AttributeError:
+            return
+        for env in env_refs:
+            if env.cache is not None:
+                try:
+                    del env.cache[(weakref.ref(self), alias)]
+                except KeyError:
+                    pass
+
+    def _alias_register_env(self, env: "Environment") -> None:
+        """Register an environment so that alias mutations invalidate its
+        cache.
+        """
+        try:
+            self._alias_env_refs
+        except AttributeError:
+            self._alias_env_refs = weakref.WeakSet()
+        self._alias_env_refs.add(env)
+
