+class _CacheBypass:
+    """Context manager returned by Cache.bypass().
+
+    Within the context, reads behave as cache misses even when a value is stored.
+    Writes remain enabled according to the existing memory/disk configuration.
+    After the context ends, newly written values can be read normally.
+    """
+
+    def __init__(self, cache: "Cache") -> None:
+        self._cache = cache
+        self._token: Optional[contextvars.Token] = None
+
+    def __enter__(self) -> "Cache":
+        cache = self._cache
+        current = cache._bypass_depth.get()
+        self._token = cache._bypass_depth.set(current + 1)
+        return cache
+
+    def __exit__(self, *args) -> None:
+        if self._token is not None:
+            self._cache._bypass_depth.reset(self._token)
+
