+    def bypass(self):
+        """Return a context manager that bypasses cache reads.
+
+        Within the context, :meth:`get` always returns ``None`` (cache miss)
+        so that every lookup recomputes the value.  Writes via :meth:`put`
+        continue to work normally; after the context exits, newly written
+        values can be read again.
+
+        Nested contexts are supported: the bypass stays active until the
+        outermost context exits.  The state is local to the current thread
+        or asynchronous execution context and to this :class:`Cache` instance.
+
+        Example::
+
+            with dspy.cache.bypass():
+                result = lm(...)         # always recomputed, then stored
+            result = lm(...)              # reads the freshly stored value
+        """
+        return _CacheBypass(self)
+
