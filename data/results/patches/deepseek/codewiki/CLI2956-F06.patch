+    def _resolve_dynamic_defaults(self, ctx: Context) -> None:
+        """Resolve dynamic defaults for parameters whose source is DEFAULT."""
+        params = self.get_params(ctx)
+
+        # Build map: long option -> param
+        long_opt_to_param: dict[str, Parameter] = {}
+        for param in params:
+            if isinstance(param, Option):
+                for opt in param.opts:
+                    if opt.startswith("--"):
+                        long_opt_to_param[opt] = param
+
+        # Find params whose source is DEFAULT and have dynamic defaults
+        dynamic_params: dict[str, Parameter] = {}
+        for param in params:
+            if param.name is None:
+                continue
+            if ctx.get_parameter_source(param.name) is not ParameterSource.DEFAULT:
+                continue
+            if not _is_dynamic_default(param.default):
+                continue
+            dynamic_params[param.name] = param
+
+        if not dynamic_params:
+            return
+
+        # Validate: reject unknown long options and non-dict values
+        for param_name, param in dynamic_params.items():
+            default_dict = param.default
+            for dep_opt, dep_values in default_dict.items():
+                if dep_opt not in long_opt_to_param:
+                    raise UsageError(
+                        f"Dynamic default for '--{param_name}' references "
+                        f"unknown option '{dep_opt}'."
+                    )
+                if not isinstance(dep_values, dict):
+                    raise TypeError(
+                        f"Dynamic default for '--{param_name}' has "
+                        f"non-dict value for '{dep_opt}': "
+                        f"{type(dep_values).__name__}"
+                    )
+
+        # Detect cycles using DFS
+        graph: dict[str, list[str]] = {}
+        for param_name, param in dynamic_params.items():
+            deps: list[str] = []
+            for dep_opt in param.default:
+                dep_param = long_opt_to_param[dep_opt]
+                dep_name = dep_param.name
+                if dep_name is not None and dep_name in dynamic_params:
+                    deps.append(dep_name)
+            graph[param_name] = deps
+
+        WHITE, GRAY, BLACK = 0, 1, 2
+        color: dict[str, int] = {name: WHITE for name in dynamic_params}
+
+        def has_cycle(node: str) -> bool:
+            color[node] = GRAY
+            for neighbor in graph.get(node, []):
+                if color.get(neighbor) == GRAY:
+                    return True
+                if color.get(neighbor) == WHITE and has_cycle(neighbor):
+                    return True
+            color[node] = BLACK
+            return False
+
+        for name in dynamic_params:
+            if color[name] == WHITE and has_cycle(name):
+                raise UsageError(
+                    "Circular dependency detected in dynamic option "
+                    "defaults."
+                )
+
+        # Topological sort (DFS post-order)
+        visited: set[str] = set()
+        order: list[str] = []
+
+        def dfs(node: str) -> None:
+            visited.add(node)
+            for neighbor in graph.get(node, []):
+                if neighbor not in visited:
+                    dfs(neighbor)
+            order.append(node)
+
+        for name in dynamic_params:
+            if name not in visited:
+                dfs(name)
+
+        # Resolve in order (dependencies first)
+        for param_name in order:
+            param = dynamic_params[param_name]
+            default_dict = param.default
+            raw_value: t.Any = None
+
+            for dep_opt, dep_values in default_dict.items():
+                dep_param = long_opt_to_param[dep_opt]
+                dep_name = dep_param.name
+                if dep_name is None:
+                    continue
+
+                dep_raw = ctx.params.get(dep_name)
+
+                # Convert dependency value to string for matching
+                if isinstance(dep_raw, bool):
+                    dep_str = "True" if dep_raw else "False"
+                else:
+                    dep_str = str(dep_raw)
+
+                if dep_str in dep_values:
+                    raw_value = dep_values[dep_str]
+
+            # Pass through type, required, and callback pipeline exactly once
+            value = param.process_value(ctx, raw_value)
+
+            # Update context params
+            if param.expose_value and param.name is not None:
+                ctx.params[param.name] = value
+
