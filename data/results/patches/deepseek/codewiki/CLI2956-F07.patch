+    def _check_option_conflicts(self, ctx: Context) -> None:
+        """Check for mutually conflicting options."""
+        param_names = {
+            p.name: p
+            for p in self.get_params(ctx)
+            if isinstance(p, Option) and p.name is not None
+        }
+
+        for param in self.get_params(ctx):
+            if not isinstance(param, Option) or param.name is None:
+                continue
+
+            if not param.conflicts_with:
+                continue
+
+            for conflict_name in param.conflicts_with:
+                if conflict_name == param.name:
+                    raise UsageError(
+                        f"Option '{param.opts[0]}' cannot conflict with itself."
+                    )
+
+                if conflict_name not in param_names:
+                    raise UsageError(
+                        f"Option '{param.opts[0]}' references unknown option"
+                        f" '{conflict_name}' in conflicts_with."
+                    )
+
+                param_source = ctx.get_parameter_source(param.name)
+                conflict_source = ctx.get_parameter_source(conflict_name)
+
+                if param_source is None or conflict_source is None:
+                    continue
+
+                if param_source in (
+                    ParameterSource.COMMANDLINE,
+                    ParameterSource.PROMPT,
+                ) and conflict_source in (
+                    ParameterSource.COMMANDLINE,
+                    ParameterSource.PROMPT,
+                ):
+                    conflict_param = param_names[conflict_name]
+                    raise UsageError(
+                        f"Option '{param.opts[0]}' cannot be used together with"
+                        f" '{conflict_param.opts[0]}'."
+                    )
+
+
