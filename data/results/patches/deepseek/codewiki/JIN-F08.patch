+class _GroupTupleWithCount(tuple):
+    """A three-field groupby result with grouper, list, and count."""
+
+    def __new__(cls, grouper, items, count):
+        return tuple.__new__(cls, (grouper, items, count))
+
+    @property
+    def grouper(self):
+        return self[0]
+
+    @property
+    def list(self):
+        return self[1]
+
+    @property
+    def count(self):
+        return self[2]
+
+    def __repr__(self) -> str:
+        return tuple.__repr__(self)
+
+    def __str__(self) -> str:
+        return tuple.__str__(self)
