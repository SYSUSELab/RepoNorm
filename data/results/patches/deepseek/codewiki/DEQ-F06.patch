+
+CreditCardIssuer = Literal['Visa', 'Mastercard', 'AmericanExpress']
+
+
+class IsCreditCard(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid credit card number using the Luhn algorithm,
+    optionally restricting to a specific issuer.
+
+    ```py title="IsCreditCard"
+    from dirty_equals import IsCreditCard
+
+    # valid Visa (passes Luhn)
+    assert '4111111111111111' == IsCreditCard
+    assert '4111111111111111' == IsCreditCard('Visa')
+    assert 4111111111111111 == IsCreditCard
+
+    # valid Mastercard
+    assert '5555555555554444' == IsCreditCard('Mastercard')
+
+    # valid American Express
+    assert '378282246310005' == IsCreditCard('AmericanExpress')
+
+    # issuer mismatch
+    assert '4111111111111111' != IsCreditCard('Mastercard')
+
+    # invalid Luhn
+    assert '4111111111111112' != IsCreditCard
+    ```
+    """
+
+    def __init__(self, issuer: CreditCardIssuer = None):
+        """
+        Args:
+            issuer: If provided, the card number must also match the prefix and length rules
+                for the given issuer. One of 'Visa', 'Mastercard', or 'AmericanExpress'.
+        """
+        self.issuer = issuer
+        if issuer is None:
+            super().__init__(plain_repr('*'))
+        else:
+            super().__init__(issuer)
+
+    def equals(self, other: Any) -> bool:
+        # Accept strings or integers
+        if isinstance(other, str):
+            # Strip surrounding whitespace
+            raw = other.strip()
+            # Remove spaces and hyphens
+            cleaned = raw.replace(' ', '').replace('-', '')
+            # Check that only digits remain after removing allowed separators
+            if not cleaned.isdigit():
+                return False
+        elif isinstance(other, int):
+            if other < 0:
+                return False
+            cleaned = str(other)
+        else:
+            return False
+
+        # Check length: must be between 12 and 19 digits
+        if not (12 <= len(cleaned) <= 19):
+            return False
+
+        # Validate with Luhn algorithm
+        if not self._luhn_check(cleaned):
+            return False
+
+        # If an issuer is specified, check issuer-specific rules
+        if self.issuer is not None:
+            return self._check_issuer(cleaned)
+        else:
+            return True
+
+    @staticmethod
+    def _luhn_check(digits: str) -> bool:
+        """Check if the digits pass the Luhn algorithm."""
+        total = 0
+        # Process from rightmost digit, double every second digit
+        for i, digit_char in enumerate(reversed(digits)):
+            digit = ord(digit_char) - 48  # ASCII digit to int
+            if i % 2 == 1:
+                digit *= 2
+                if digit > 9:
+                    digit -= 9
+            total += digit
+        return total % 10 == 0
+
+    def _check_issuer(self, cleaned: str) -> bool:
+        """Check if the card number matches the specified issuer rules."""
+        length = len(cleaned)
+
+        if self.issuer == 'Visa':
+            # Visa: starts with 4, length 13, 16, or 19
+            return cleaned[0] == '4' and length in (13, 16, 19)
+
+        elif self.issuer == 'Mastercard':
+            # Mastercard: 16 digits, starts with 51-55 or 2221-2720
+            if length != 16:
+                return False
+            prefix2 = int(cleaned[:2])
+            prefix4 = int(cleaned[:4])
+            return (51 <= prefix2 <= 55) or (2221 <= prefix4 <= 2720)
+
+        elif self.issuer == 'AmericanExpress':
+            # American Express: 15 digits, starts with 34 or 37
+            return length == 15 and cleaned[:2] in ('34', '37')
+
+        return False
