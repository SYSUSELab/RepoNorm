+class _ResourceContextManager:
+    """Wraps a context manager to track resource counts for max_resources."""
+
+    __slots__ = ("ctx", "cm")
+
+    def __init__(self, ctx: Context, cm: AbstractContextManager) -> None:
+        self.ctx = ctx
+        self.cm = cm
+
+    def __enter__(self) -> t.Any:
+        return self.cm.__enter__()
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc_val: BaseException | None,
+        exc_tb: TracebackType | None,
+    ) -> bool | None:
+        try:
+            return self.cm.__exit__(exc_type, exc_val, exc_tb)
+        finally:
+            self.ctx._add_resource_count(-1)
+
