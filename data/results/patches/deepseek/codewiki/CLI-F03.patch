+    def _check_resource_limit(self) -> None:
+        """Check if adding a new resource would exceed any limit."""
+        node: Context | None = self
+        while node is not None:
+            if node.max_resources is not None and node._resource_count >= node.max_resources:
+                raise RuntimeError(
+                    f"Context {node.info_name!r} has reached its limit of "
+                    f"{node.max_resources} resources."
+                )
+            node = node.parent
+
+    def _add_resource_count(self, delta: int) -> None:
+        """Add delta to resource count for this context and all ancestors."""
+        node: Context | None = self
+        while node is not None:
+            node._resource_count += delta
+            node = node.parent
 
