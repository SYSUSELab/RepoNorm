+def register_filter(name: str, callable: Callable) -> None:
+    """Register a global Jinja2 filter for prompts.
+
+    Registered filters are available to prompts subsequently constructed through
+    bare ``@outlines.prompt``, ``Prompt.from_str``, and ``Prompt.from_file``,
+    including included and inherited file templates.
+
+    Registering an existing name replaces its registered callable.  The
+    Outlines-specific filters ``name``, ``description``, ``source``,
+    ``signature``, ``schema``, and ``args`` are protected and cannot be
+    overridden.
+
+    Parameters
+    ----------
+    name
+        The name of the filter as used in Jinja2 templates.
+    callable
+        The callable implementing the filter.
+    """
+    if name not in _PROTECTED_FILTERS:
+        _filter_registry[name] = callable
+
+
+def unregister_filter(name: str) -> None:
+    """Unregister a global Jinja2 filter for prompts.
+
+    Unregistering an unknown name is a no-op.  Protected filters cannot be
+    unregistered.
+
+    Parameters
+    ----------
+    name
+        The name of the filter to unregister.
+    """
+    if name not in _PROTECTED_FILTERS:
+        _filter_registry.pop(name, None)
