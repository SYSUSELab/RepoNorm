@@ -0,0 +1,71 @@
+from typing import Any
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+__all__ = 'IsHash',
+
+# Map of algorithm names (lowercase) to their hex digest lengths
+_ALGORITHM_HEX_LENGTHS: dict[str, int] = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+_SUPPORTED_ALGORITHMS = frozenset(_ALGORITHM_HEX_LENGTHS.keys())
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A type which checks that a value is a valid hexadecimal hash digest
+    of the specified algorithm.
+
+    Args:
+        algorithm: The hash algorithm name, case-insensitive.
+            Supported values: 'md5', 'sha1', 'sha224', 'sha256', 'sha384', 'sha512'.
+
+    Raises:
+        ValueError: If the algorithm is not supported.
+
+    ```py title="IsHash"
+    from dirty_equals import IsHash
+
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+    assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+    assert 'd41d8cd98f00b204e9800998ecf8427e' != IsHash('sha256')
+    assert 'not-a-hash' != IsHash('md5')
+    ```
+    """
+
+    def __init__(self, algorithm: str):
+        algorithm_lower = algorithm.lower()
+        if algorithm_lower not in _SUPPORTED_ALGORITHMS:
+            raise ValueError(
+                f"Unsupported hash algorithm: {algorithm!r}. "
+                f"Supported algorithms are: {', '.join(sorted(_SUPPORTED_ALGORITHMS))}"
+            )
+        self.algorithm = algorithm
+        self.algorithm_lower = algorithm_lower
+        self.hex_length = _ALGORITHM_HEX_LENGTHS[algorithm_lower]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if len(other) != self.hex_length:
+            return False
+
+        # Check that all characters are valid hexadecimal digits
+        try:
+            int(other, 16)
+        except (ValueError, TypeError):
+            return False
+
+        return True
+
+    def _repr_ne(self) -> str:
+        return f"IsHash({self.algorithm!r})"
