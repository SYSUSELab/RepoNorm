+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize input data to the canonical form for ToolCalls.
+
+        Handles the following input shapes:
+        - Existing container: {"tool_calls": [{"name": ..., "args": {...}}, ...]}
+        - Single tool call: {"name": ..., "args": {...}}
+        - Bare list: [{"name": ..., "args": {...}}, ...]
+        - Empty list: []
+        - JSON strings representing any of the above
+        - Existing ToolCalls instances (passed through unchanged)
+
+        Returns normalized data (not a ToolCalls instance). Non-JSON strings
+        are returned unchanged and will be rejected by model validation.
+        """
+        if isinstance(data, cls):
+            return data
+
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                return data  # Non-JSON string returned unchanged
+
+        if isinstance(data, list):
+            data = {"tool_calls": data}
+        elif isinstance(data, dict) and "tool_calls" not in data:
+            # Single tool call object (has name/args but no tool_calls key)
+            data = {"tool_calls": [data]}
+
+        return data
+
+    @model_validator(mode="before")
+    @classmethod
+    def _normalize_input(cls, data: Any) -> Any:
+        """Normalize input before model validation."""
+        return cls.validate_input(data)
