+
+
+_EMAIL_PATTERN = re.compile(
+    r'^[a-zA-Z0-9_%+\-]+(?:\.[a-zA-Z0-9_%+\-]+)*@'
+    r'(?:[a-zA-Z0-9](?:[a-zA-Z0-9\-]*[a-zA-Z0-9])?\.)+'
+    r'[a-zA-Z]{2,}$'
+)
+
+
+class IsEmail(DirtyEquals[str]):
+    """A class that checks if a value is a valid email address, optionally filtering by domain.
+
+    Args:
+        domain: If provided, the email's domain must exactly match this value (case-sensitive).
+    """
+
+    def __init__(self, domain: str = None):
+        self.domain = domain
+        if domain is not None:
+            super().__init__(domain)
+        else:
+            super().__init__(plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        if _EMAIL_PATTERN.match(other) is None:
+            return False
+        if self.domain is not None:
+            # extract domain (everything after @)
+            _, domain_part = other.rsplit('@', 1)
+            return domain_part == self.domain
+        return True
