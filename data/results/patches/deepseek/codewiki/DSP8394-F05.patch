+from diskcache.core import Disk, MODE_PICKLE
 
 logger = logging.getLogger(__name__)
 
+# DSPC header format: b"DSPC" + codec byte (1 byte) + payload
+DSPC_HEADER = b"DSPC"
+CODEC_UNCOMPRESSED = 0x00
+CODEC_GZIP = 0x01
+CODEC_ZLIB = 0x02
+
+SUPPORTED_CODECS = {None, "gzip", "zlib"}
+
+
+class CompressedDisk(Disk):
+    """Disk subclass that supports optional compression with DSPC header format.
+
+    The persisted compressed representation is bytes beginning with b"DSPC",
+    followed by one codec byte (0x00: uncompressed pickle; 0x01: gzip;
+    0x02: zlib) and the encoded pickle payload.
+    """
+
+    def __init__(self, directory, min_file_size=0, pickle_protocol=0, compress=None):
+        self._compress = compress
+        super().__init__(directory, min_file_size=min_file_size, pickle_protocol=pickle_protocol)
+
+    def store(self, value, read, key=None):
+        """Store value with optional compression."""
+        if read:
+            return super().store(value, read, key)
+
+        type_value = type(value)
+        if type_value is str or type_value is int or type_value is float or type_value is bytes:
+            return super().store(value, read, key)
+
+        # This will be pickled
+        result = pickle.dumps(value, protocol=self.pickle_protocol)
+
+        if self._compress == "gzip":
+            compressed = gzip.compress(result)
+            header_byte = bytes([CODEC_GZIP])
+        elif self._compress == "zlib":
+            compressed = zlib.compress(result)
+            header_byte = bytes([CODEC_ZLIB])
+        else:
+            compressed = result
+            header_byte = bytes([CODEC_UNCOMPRESSED])
+
+        payload = DSPC_HEADER + header_byte + compressed
+
+        min_file_size = self.min_file_size
+        if len(payload) < min_file_size:
+            return 0, MODE_PICKLE, None, sqlite3.Binary(payload)
+        else:
+            filename, full_path = self.filename(key, value)
+            self._write(full_path, io.BytesIO(payload), 'xb')
+            return len(payload), MODE_PICKLE, filename, None
+
+    def fetch(self, mode, filename, value, read):
+        """Fetch value, handling DSPC header format and legacy entries."""
+        if mode != MODE_PICKLE:
+            return super().fetch(mode, filename, value, read)
+
+        if value is None:
+            with open(os.path.join(self._directory, filename), 'rb') as reader:
+                raw = reader.read()
+        else:
+            raw = bytes(value) if type(value) is sqlite3.Binary else value
+
+        if isinstance(raw, (bytes, bytearray)) and raw[:4] == DSPC_HEADER and len(raw) >= 5:
+            codec = raw[4]
+            payload = raw[5:]
+
+            if codec == CODEC_UNCOMPRESSED:
+                data = payload
+            elif codec == CODEC_GZIP:
+                data = gzip.decompress(payload)
+            elif codec == CODEC_ZLIB:
+                data = zlib.decompress(payload)
+            else:
+                raise ValueError(f"Unknown codec selector: {codec}")
+
+            return pickle.loads(data)
+        else:
+            # Legacy entries (pre-feature): use parent's fetch which handles
+            # already-deserialized values from the backend
+            return super().fetch(mode, filename, value, read)
+
 
