+# ── Built-in filter categories ──────────────────────────────────────────────
+
+def _register_string_utils(env: jinja2.Environment):
+    """Register string_utils filters."""
+
+    def upper(value: str) -> str:
+        return str(value).upper()
+
+    def lower(value: str) -> str:
+        return str(value).lower()
+
+    def title(value: str) -> str:
+        return str(value).title()
+
+    def reverse(value: str) -> str:
+        return str(value)[::-1]
+
+    def truncate(value: str, length: int, end: str = "...") -> str:
+        text = str(value)
+        if length < 0:
+            raise ValueError("length must be non-negative")
+        if len(text) <= length:
+            return text
+        # Produce at most `length` characters by replacing the tail with
+        # as much of `end` as fits.
+        end_len = min(len(end), length)
+        return text[: length - end_len] + end[:end_len]
+
+    def pad_left(value: str, width: int, fill: str = " ") -> str:
+        if len(fill) != 1:
+            raise ValueError("fill must be a single character")
+        return str(value).rjust(width, fill)
+
+    def pad_right(value: str, width: int, fill: str = " ") -> str:
+        if len(fill) != 1:
+            raise ValueError("fill must be a single character")
+        return str(value).ljust(width, fill)
+
+    env.filters["upper"] = upper
+    env.filters["lower"] = lower
+    env.filters["title"] = title
+    env.filters["reverse"] = reverse
+    env.filters["truncate"] = truncate
+    env.filters["pad_left"] = pad_left
+    env.filters["pad_right"] = pad_right
+
+
+def _register_math_utils(env: jinja2.Environment):
+    """Register math_utils filters."""
+
+    def add(a, b):
+        return a + b
+
+    def subtract(a, b):
+        return a - b
+
+    def multiply(a, b):
+        return a * b
+
+    def divide(a, b):
+        return a / b
+
+    def math_round(value, ndigits=None):
+        return round(value, ndigits)
+
+    def math_abs(value):
+        return abs(value)
+
+    def math_min(value, *others):
+        return min(value, *others)
+
+    def math_max(value, *others):
+        return max(value, *others)
+
+    env.filters["add"] = add
+    env.filters["subtract"] = subtract
+    env.filters["multiply"] = multiply
+    env.filters["divide"] = divide
+    env.filters["round"] = math_round
+    env.filters["abs"] = math_abs
+    env.filters["min"] = math_min
+    env.filters["max"] = math_max
+
+
+def _register_format_utils(env: jinja2.Environment):
+    """Register format_utils filters."""
+
+    def json_filter(value):
+        return json.dumps(value)
+
+    def csv_filter(value):
+        import io
+        import csv as csv_module
+
+        output = io.StringIO()
+        writer = csv_module.writer(output)
+        writer.writerow(value)
+        return output.getvalue().rstrip("\r\n")
+
+    def indent_filter(value, width=4):
+        lines = str(value).splitlines(keepends=True)
+        result = []
+        for line in lines:
+            if line.strip():
+                result.append(" " * width + line)
+            else:
+                result.append(line)
+        return "".join(result)
+
+    def wrap_filter(value, width=70):
+        return textwrap.fill(str(value), width=width)
+
+    def escape_filter(value):
+        return html.escape(str(value), quote=True)
+
+    def unescape_filter(value):
+        return html.unescape(str(value))
+
+    env.filters["json"] = json_filter
+    env.filters["csv"] = csv_filter
+    env.filters["indent"] = indent_filter
+    env.filters["wrap"] = wrap_filter
+    env.filters["escape"] = escape_filter
+    env.filters["unescape"] = unescape_filter
+
+
+_BUILTIN_FILTER_REGISTRATIONS = {
+    "string_utils": _register_string_utils,
+    "math_utils": _register_math_utils,
+    "format_utils": _register_format_utils,
+}
+
+_VALID_CATEGORIES = frozenset(_BUILTIN_FILTER_REGISTRATIONS.keys())
+
+
+def _register_builtin_filters(
+    env: jinja2.Environment, builtin_filters: Optional[List[str]]
+):
+    """Register the selected built-in filter categories on *env*.
+
+    ``None`` and the empty list are no-ops.
+    """
+    if builtin_filters is None:
+        return
+    for category in builtin_filters:
+        if category not in _VALID_CATEGORIES:
+            raise ValueError(f"Unknown builtin filter category: {category}")
+        _BUILTIN_FILTER_REGISTRATIONS[category](env)
+
