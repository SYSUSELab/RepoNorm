+    def _acquire_lock(self, filename: str) -> str:
+        """Atomically create a lock file for the given filename."""
+        import datetime
+
+        lock_path = os.path.join(
+            os.path.dirname(filename) or ".",
+            f".{os.path.basename(filename)}.lock",
+        )
+
+        try:
+            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+        except OSError as e:
+            if os.path.exists(lock_path):
+                try:
+                    with open(lock_path, "r", encoding="utf-8") as lf:
+                        lock_content = lf.read()
+                except OSError:
+                    lock_content = None
+
+                if lock_content:
+                    raise ClickException(
+                        _("Lock file {path} exists. Lock content:\n{content}").format(
+                            path=lock_path, content=lock_content
+                        )
+                    ) from e
+                else:
+                    raise ClickException(
+                        _("Lock file {path} exists but could not be read.").format(
+                            path=lock_path
+                        )
+                    ) from e
+            else:
+                raise ClickException(
+                    _("Could not create lock file {path}.").format(path=lock_path)
+                ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as lf:
+                lf.write(f"PID: {os.getpid()}\n")
+                lf.write(
+                    f"Time: {datetime.datetime.now(datetime.timezone.utc).isoformat()}\n"
+                )
+        except OSError as e:
+            try:
+                os.unlink(lock_path)
+            except OSError:
+                pass
+            raise ClickException(
+                _("Could not write to lock file {path}.").format(path=lock_path)
+            ) from e
+
+        return lock_path
+
+    def _release_lock(self, lock_path: str) -> None:
+        """Remove the lock file."""
+        try:
+            os.unlink(lock_path)
+        except OSError as e:
+            raise ClickException(
+                _("Could not remove lock file {path}.").format(path=lock_path)
+            ) from e
+
