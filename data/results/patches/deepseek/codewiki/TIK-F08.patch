+def _compute_repeated_patterns(tokens: list[int]) -> dict[tuple[int, int], int]:
+    """Count occurrences of adjacent token-ID pairs, returning the top 3 distinct pairs.
+    
+    Counts overlapping pairs: [A, A, A] yields two occurrences of (A, A).
+    Empty or single-token sequences return an empty dict.
+    If fewer than three distinct pairs exist, returns all of them.
+    """
+    if len(tokens) < 2:
+        return {}
+    
+    pair_counts: dict[tuple[int, int], int] = {}
+    for i in range(len(tokens) - 1):
+        pair = (tokens[i], tokens[i + 1])
+        pair_counts[pair] = pair_counts.get(pair, 0) + 1
+    
+    # Get top 3 distinct pairs sorted by count (descending)
+    sorted_pairs = sorted(pair_counts.items(), key=lambda x: (-x[1], x[0]))
+    top_pairs = sorted_pairs[:3]
+    
+    return dict(top_pairs)
+
