+from urllib.parse import urlparse
+from typing import Any, FrozenSet, List, Optional, Set, Tuple, Union
+
+
+class IsURL(DirtyEquals[str]):
+    """
+    Validates that a value is a valid URL with protocol and network location,
+    optionally enforcing specific protocol and/or domain requirements.
+
+    Args:
+        protocol: Optional protocol requirement. Can be a string (e.g. 'https') or
+            a collection of strings (list, tuple, set, frozenset). An empty collection
+            allows no protocol (no URLs will match). None disables protocol filtering.
+        domain: Optional domain requirement. The complete network location (including
+            port if present) must match this value.
+
+    ```py title="IsURL"
+    from dirty_equals import IsURL
+
+    assert 'http://example.com' == IsURL()
+    assert 'https://example.com/path?q=1' == IsURL()
+    assert 'http://example.com' == IsURL(protocol='http')
+    assert 'https://example.com' != IsURL(protocol='http')
+    assert 'http://example.com' == IsURL(domain='example.com')
+    assert 'http://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'http://example.com:8080' != IsURL(domain='example.com')
+    assert 'https://example.com' == IsURL(protocol='https', domain='example.com')
+    assert 'not a url' != IsURL()
+    assert 123 != IsURL()
+    ```
+    """
+
+    def __init__(
+        self,
+        protocol: Union[None, str, List[str], Tuple[str, ...], Set[str], FrozenSet[str]] = None,
+        domain: Optional[str] = None,
+    ):
+        self.protocol = protocol
+        self.domain = domain
+
+        # Build repr args
+        if protocol is None and domain is None:
+            super().__init__(plain_repr('*'))
+        elif domain is None:
+            # Only protocol specified
+            super().__init__(protocol if protocol is not None else plain_repr('*'))
+        elif protocol is None:
+            # Only domain specified
+            super().__init__(domain)
+        else:
+            # Both specified
+            super().__init__(protocol, domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        parsed = urlparse(other)
+
+        # URL must have both scheme and netloc to be considered complete
+        if not parsed.scheme or not parsed.netloc:
+            return False
+
+        # Check protocol if specified
+        if self.protocol is not None:
+            if isinstance(self.protocol, str):
+                if parsed.scheme != self.protocol:
+                    return False
+            elif isinstance(self.protocol, (list, tuple, set, frozenset)):
+                if parsed.scheme not in self.protocol:
+                    return False
+
+        # Check domain if specified
+        if self.domain is not None:
+            if parsed.netloc != self.domain:
+                return False
+
+        return True
