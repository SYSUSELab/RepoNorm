+def _hierarchical_groupby(
+    environment: "Environment",
+    items: "t.List[V]",
+    attributes: "t.List[t.Union[str, int]]",
+    default: t.Optional[t.Any] = None,
+    depth: int = 0,
+) -> "t.List[_GroupTuple]":
+    """Recursively group items by multiple attributes."""
+    attr = attributes[depth]
+    expr = make_attrgetter(environment, attr, default=default)
+    sorted_items = sorted(items, key=expr)
+
+    if depth == len(attributes) - 1:
+        # Last level - contains the actual items
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted_items, expr)
+        ]
+
+    # Intermediate level - contains child groups
+    result = []
+    for key, values in groupby(sorted_items, expr):
+        child_groups = _hierarchical_groupby(
+            environment, list(values), attributes, default, depth + 1
+        )
+        result.append(_GroupTuple(key, child_groups))
+    return result
+
