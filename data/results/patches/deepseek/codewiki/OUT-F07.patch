         compiled_grammar: str
             The compiled grammar to use to create the logits processor.
 
+        fallback_processor: Optional[OutlinesLogitsProcessor]
+            An optional fallback logits processor used when the primary
+            processor raises an exception during ``process_logits``.
+
         """
         import xgrammar as xgr
 
         self.xgr = xgr
         self.compiled_grammar = compiled_grammar
         self.xgrammar_logits_processor = None
+        self.fallback_processor = fallback_processor
+        self._use_fallback = False
         super().__init__("torch")
 
     def reset(self):
