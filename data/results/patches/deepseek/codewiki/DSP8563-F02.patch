+def _has_comments(text: str) -> bool:
+    """Check if text contains Python comments outside string literals."""
+    try:
+        tokens = tokenize.generate_tokens(io.StringIO(text).readline)
+        for tok in tokens:
+            if tok.type == tokenize.COMMENT:
+                return True
+        return False
+    except tokenize.TokenError:
+        return False
+
+
+def _parse_literal(node: ast.AST):
+    """Parse a literal value from an AST node.
+
+    Only allows: strings, finite ints/floats, booleans, None,
+    lists, tuples (converted to lists), dicts with string keys.
+    """
+    if isinstance(node, ast.Constant):
+        value = node.value
+        if isinstance(value, bool):
+            return value
+        elif isinstance(value, int):
+            return value
+        elif isinstance(value, float):
+            if value != value:  # NaN check
+                raise ValueError("NaN is not allowed")
+            if value == float('inf') or value == float('-inf'):
+                raise ValueError("Infinity and -Infinity are not allowed")
+            return value
+        elif isinstance(value, str):
+            return value
+        elif value is None:
+            return None
+        elif isinstance(value, bytes):
+            raise ValueError("Bytes literals are not allowed")
+        elif isinstance(value, complex):
+            raise ValueError("Complex numbers are not allowed")
+        elif isinstance(value, type(Ellipsis)):
+            raise ValueError("Ellipsis (...) is not allowed")
+        else:
+            raise ValueError(f"Unsupported constant type: {type(value).__name__}")
+
+    elif isinstance(node, ast.UnaryOp):
+        if isinstance(node.op, ast.UAdd):
+            if isinstance(node.operand, ast.Constant) and isinstance(node.operand.value, (int, float)) and not isinstance(node.operand.value, bool):
+                val = node.operand.value
+                if isinstance(val, float) and (val != val or val == float('inf') or val == float('-inf')):
+                    raise ValueError("Infinity, -Infinity, and NaN are not allowed")
+                return +val
+            else:
+                raise ValueError("Unary + is only permitted on numeric literals")
+        elif isinstance(node.op, ast.USub):
+            if isinstance(node.operand, ast.Constant) and isinstance(node.operand.value, (int, float)) and not isinstance(node.operand.value, bool):
+                val = node.operand.value
+                if isinstance(val, float) and (val != val or val == float('inf') or val == float('-inf')):
+                    raise ValueError("Infinity, -Infinity, and NaN are not allowed")
+                return -val
+            else:
+                raise ValueError("Unary - is only permitted on numeric literals")
+        else:
+            raise ValueError(f"Unsupported unary operator: {type(node.op).__name__}")
+
+    elif isinstance(node, ast.List):
+        return [_parse_literal(el) for el in node.elts]
+
+    elif isinstance(node, ast.Tuple):
+        return [_parse_literal(el) for el in node.elts]
+
+    elif isinstance(node, ast.Dict):
+        keys = []
+        for key_node in node.keys:
+            if not isinstance(key_node, ast.Constant) or not isinstance(key_node.value, str):
+                raise ValueError("Dictionary keys must be strings")
+            keys.append(key_node.value)
+
+        if len(keys) != len(set(keys)):
+            raise ValueError("Duplicate dictionary keys are not allowed")
+
+        return {
+            key_node.value: _parse_literal(val_node)
+            for key_node, val_node in zip(node.keys, node.values)
+        }
+
+    elif isinstance(node, ast.Name):
+        if node.id == "True":
+            return True
+        elif node.id == "False":
+            return False
+        elif node.id == "None":
+            return None
+        else:
+            raise ValueError(f"Variables are not allowed, got '{node.id}'")
+
+    elif isinstance(node, ast.Call):
+        raise ValueError("Nested function calls are not allowed")
+
+    elif isinstance(node, ast.JoinedStr):
+        raise ValueError("F-strings are not allowed")
+
+    elif isinstance(node, ast.Lambda):
+        raise ValueError("Lambda expressions are not allowed")
+
+    elif isinstance(node, ast.ListComp):
+        raise ValueError("List comprehensions are not allowed")
+
+    elif isinstance(node, ast.SetComp):
+        raise ValueError("Set comprehensions are not allowed")
+
+    elif isinstance(node, ast.DictComp):
+        raise ValueError("Dict comprehensions are not allowed")
+
+    elif isinstance(node, ast.GeneratorExp):
+        raise ValueError("Generator expressions are not allowed")
+
+    elif isinstance(node, ast.BinOp):
+        raise ValueError("Binary operations are not allowed")
+
+    elif isinstance(node, ast.Compare):
+        raise ValueError("Comparison operations are not allowed")
+
+    elif isinstance(node, ast.IfExp):
+        raise ValueError("Conditional expressions are not allowed")
+
+    elif isinstance(node, ast.Subscript):
+        raise ValueError("Subscript operations are not allowed")
+
+    elif isinstance(node, ast.Attribute):
+        raise ValueError("Attribute access is not allowed in argument values")
+
+    elif isinstance(node, ast.Starred):
+        raise ValueError("Argument unpacking is not allowed")
+
+    else:
+        raise ValueError(f"Unsupported expression type: {type(node).__name__}")
+
+
+def _extract_tool_name(func_node: ast.AST) -> str:
+    """Extract the tool name from a function call node.
+
+    A callee is an identifier or a dot-separated sequence of identifiers.
+    The final (rightmost) identifier is used as the tool name.
+    """
+    if isinstance(func_node, ast.Name):
+        return func_node.id
+    elif isinstance(func_node, ast.Attribute):
+        parts = []
+        current = func_node
+        while isinstance(current, ast.Attribute):
+            parts.append(current.attr)
+            current = current.value
+        if isinstance(current, ast.Name):
+            # parts[0] is the final (rightmost/innermost) attribute
+            return parts[0]
+        else:
+            raise ValueError("Dotted names must consist only of simple identifiers")
+    else:
+        raise ValueError(f"Invalid function name expression: {type(func_node).__name__}")
+
+
+def parse_python_calls(text: str) -> dict:
+    """Parse a safe subset of Python-style tool calls.
+
+    Accepts one or more top-level calls separated by newlines or semicolons.
+    A callee is an identifier or a dot-separated sequence of identifiers;
+    the final identifier is used as the tool name.
+
+    Args:
+        text: A string containing one or more Python-style function calls
+
+    Returns:
+        A dict with ``tool_calls`` key containing a list of
+        ``{"name": ..., "args": {...}}`` dicts.
+
+    Raises:
+        ValueError: If the input is empty, contains malformed syntax, or
+            contains disallowed constructs.
+    """
+    if not text or not text.strip():
+        raise ValueError("Empty input")
+
+    if _has_comments(text):
+        raise ValueError("Python comments are not allowed")
+
+    try:
+        tree = ast.parse(text)
+    except SyntaxError as e:
+        raise ValueError(f"Malformed syntax: {e}")
+
+    if not isinstance(tree, ast.Module):
+        raise ValueError("Input must be a module-level expression")
+
+    if not tree.body:
+        raise ValueError("Empty input")
+
+    tool_calls = []
+
+    for node in tree.body:
+        if not isinstance(node, ast.Expr):
+            raise ValueError(f"Only function calls are allowed, got a {type(node).__name__}")
+
+        call = node.value
+        if not isinstance(call, ast.Call):
+            raise ValueError(f"Expected a function call, got {type(call).__name__}")
+
+        tool_name = _extract_tool_name(call.func)
+
+        if call.args:
+            raise ValueError(f"Positional arguments are not allowed in call to '{tool_name}'")
+
+        args = {}
+        for keyword in call.keywords:
+            if keyword.arg is None:
+                raise ValueError(f"Argument unpacking (**) is not allowed in call to '{tool_name}'")
+            if keyword.arg in args:
+                raise ValueError(f"Duplicate keyword argument '{keyword.arg}' in call to '{tool_name}'")
+            args[keyword.arg] = _parse_literal(keyword.value)
+
+        tool_calls.append({"name": tool_name, "args": args})
+
+    return {"tool_calls": tool_calls}
