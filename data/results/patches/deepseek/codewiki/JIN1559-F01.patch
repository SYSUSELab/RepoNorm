+    def test_extract_context_blocks(self):
+        from jinja2.ext import babel_extract
+
+        source = BytesIO(
+            b"""
+            {% trans "fruit" %}Apple{% endtrans %}
+            {% trans "fruit" count=num %}{{ num }} apple{% pluralize %}{{ num }} apples{% endtrans %}
+            """
+        )
+        result = list(
+            babel_extract(source, ("pgettext", "npgettext", "gettext", "ngettext", "_"), [], {})
+        )
+        assert result[0] == (2, "pgettext", ("fruit", "Apple"), []), f"got {result[0]}"
+        assert result[1] == (3, "npgettext", ("fruit", "%(num)s apple", "%(num)s apples", None), []), f"got {result[1]}"
 
