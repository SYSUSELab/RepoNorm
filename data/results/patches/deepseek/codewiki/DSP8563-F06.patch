+    def validate_input(cls, data: Any) -> Any:
+        """Public extraction helper: returns parsed Python JSON structures on
+        success and the original input unchanged when extraction fails.
+        """
+        if not isinstance(data, str):
+            return data
+
+        # Try plain JSON first
+        try:
