+def _extract_fenced_json(text: str) -> str | None:
+    """Extract JSON body from the first triple-backtick code fence.
+
+    Only considers the first fence block. Opening fence may have any language
+    label (json, JSON, or no label) followed by a newline. The next
+    triple-backtick closes it. Returns the trimmed body or None if no valid
+    fence is found.
+    """
+    # The opening fence must be: optional whitespace, ```, optional label, newline
+    match = re.match(r'^[ \t]*```[ \t]*\w*[ \t]*\n', text)
+    if not match:
+        return None
+
+    start = match.end()
+    close_idx = text.find('```', start)
+    if close_idx == -1:
+        return None
+
+    return text[start:close_idx].strip()
+
