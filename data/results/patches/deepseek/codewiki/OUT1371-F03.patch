+def _select_condition(conditional_filters: Optional[Dict[str, Dict[str, Callable]]]) -> Optional[str]:
+    """Determine which condition's filters should be installed.
+
+    Selection happens once based on the current environment variables.
+    Environment names and values are compared with ASCII case-insensitive exact equality.
+
+    Parameters
+    ----------
+    conditional_filters : Optional[Dict[str, Dict[str, Callable]]]
+        A mapping from condition names to filter dictionaries.
+
+    Returns
+    -------
+    Optional[str]
+        The selected condition name, or None if no condition is active.
+    """
+    if conditional_filters is None or not conditional_filters:
+        return None
+
+    # Determine which standard conditions are active based on env vars
+    # Use case-insensitive comparison
+    env_upper = {k.upper(): v.upper() for k, v in os.environ.items()}
+
+    active_conditions = set()
+
+    # OUTLINES_DEBUG=true activates debug
+    if env_upper.get("OUTLINES_DEBUG") == "TRUE":
+        active_conditions.add("debug")
+
+    # ENVIRONMENT=production activates production
+    if env_upper.get("ENVIRONMENT") == "PRODUCTION":
+        active_conditions.add("production")
+
+    # ENV=testing, OUTLINES_TESTING=true, or TESTING_MODE=on activates testing
+    if env_upper.get("ENV") == "TESTING" or env_upper.get("OUTLINES_TESTING") == "TRUE" or env_upper.get("TESTING_MODE") == "ON":
+        active_conditions.add("testing")
+
+    # Priority: debug > production > testing
+    priority_order = ["debug", "production", "testing"]
+
+    for condition in priority_order:
+        if condition in active_conditions and condition in conditional_filters:
+            return condition
+
+    # If none of the standard conditions matched, select the alphabetically first
+    # supplied condition key
+    available_keys = sorted(conditional_filters.keys())
+    if available_keys:
+        return available_keys[0]
+
+    return None
+
+
