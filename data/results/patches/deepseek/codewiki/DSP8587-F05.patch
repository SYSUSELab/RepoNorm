+def _truncate_preview(content: str, max_len: int = 80) -> str:
+    """Return a preview of at most max_len characters.
+    
+    Content of length max_len or less is unchanged;
+    longer content uses its first (max_len-3) characters plus '...'.
+    """
+    if len(content) <= max_len:
+        return content
+    return content[: max_len - 3] + "..."
