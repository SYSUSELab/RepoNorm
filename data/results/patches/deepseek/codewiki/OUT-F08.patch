+def _sample_rss() -> Optional[int]:
+    """Sample current RSS in bytes.
+
+    Returns None if sampling fails.
+    """
+    try:
+        with open("/proc/self/status") as f:
+            for line in f:
+                if line.startswith("VmRSS:"):
+                    parts = line.split()
+                    if len(parts) >= 2:
+                        # VmRSS is in kB
+                        return int(parts[1]) * 1024
+    except (OSError, ValueError, IndexError):
+        pass
+    return None
+
