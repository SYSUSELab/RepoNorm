+    By default, string keys that differ only by case are grouped
+    together, using the case of the first encountered key. Set
+    ``case_sensitive`` to ``True`` to keep keys with different case
+    separate.
+
+    .. sourcecode:: jinja
+
+        {% for items in users|groupby("name", case_sensitive=true) %}
+            ...
+        {% endfor %}
+
+    .. versionchanged:: 3.1
+        Added the ``case_sensitive`` parameter.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,10 +1225,29 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+
+    if case_sensitive:
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+
+    def key_func(item: t.Any) -> t.Any:
+        value = expr(item)
+
+        if isinstance(value, str):
+            return value.lower()
+
+        return value
+
+    result: "t.List[t.Tuple[t.Any, t.List[V]]]" = []
+    sorted_value = sorted(value, key=key_func)
+
+    for _, values in groupby(sorted_value, key=key_func):
+        items = list(values)
+        result.append(_GroupTuple(expr(items[0]), items))
+
+    return result
 
 
