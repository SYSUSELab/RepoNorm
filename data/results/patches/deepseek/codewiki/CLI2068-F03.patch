+    def _create_backup(self, filename: str) -> None:
+        import datetime
+        import shutil
+
+        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
+        backup_base = f"{filename}.backup.{timestamp}"
+        backup_name = backup_base
+        counter = 1
+
+        while os.path.exists(backup_name):
+            backup_name = f"{backup_base}_{counter}"
+            counter += 1
+
+        try:
+            shutil.copy2(filename, backup_name)
+        except OSError as e:
+            raise ClickException(
+                _("Failed to create backup file: {e}").format(e=e)
+            ) from e
