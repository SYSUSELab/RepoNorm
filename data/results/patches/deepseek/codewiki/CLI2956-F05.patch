     def get_error_hint(self, ctx: Context) -> str:
         result = super().get_error_hint(ctx)
         if self.show_envvar:
             result += f" (env var: '{self.envvar}')"
         return result
 
+    def type_cast_value(self, ctx: Context, value: t.Any) -> t.Any:
+        """Convert and validate a value against the option's
+        :attr:`type`, :attr:`multiple`, and :attr:`nargs`.
+
+        When :attr:`cache` is enabled, successful conversion results
+        are cached by the raw value. The cache is skipped for
+        ``File`` and ``Path`` types, ``multiple=True``, ``nargs != 1``,
+        ``None``, and unhashable raw values.
+        """
+        # Check cache first if caching is enabled and applicable.
+        if (
+            self.cache
+            and value is not None
+            and not self.multiple
+            and self.nargs == 1
+            and not isinstance(self.type, (types.File, types.Path))
+        ):
+            try:
+                hash(value)
+            except TypeError:
+                pass
+            else:
+                if value in self._value_cache:
+                    return self._value_cache[value]
+
+        # Perform normal type conversion via the parent class.
+        result = super().type_cast_value(ctx, value)
+
+        # Store successful result in cache if applicable.
+        if (
+            self.cache
+            and value is not None
+            and not self.multiple
+            and self.nargs == 1
+            and not isinstance(self.type, (types.File, types.Path))
+        ):
+            try:
+                hash(value)
+            except TypeError:
+                pass
+            else:
+                self._value_cache[value] = result
+
+        return result
+
