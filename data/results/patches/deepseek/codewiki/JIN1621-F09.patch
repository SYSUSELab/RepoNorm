+            # On the first scan there is nothing to compare against;
+            # just store the snapshot and return an empty list.
+            if not previous_mtimes:
+                self._mtimes = current_templates
+                return []
+
+            # Check for modified and added files
+            for path, mtime in current_templates.items():
+                old_mtime = previous_mtimes.get(path)
+                if old_mtime is not None and old_mtime != mtime:
+                    # File was modified
+                    name = self._get_template_name_from_path(path)
+                    if name is not None:
+                        invalidated.append(name)
+                        if self._environments is not None:
+                            for env in list(self._environments):
+                                self._invalidate_env_cache(env, name)
+                elif old_mtime is None:
+                    # New file added
+                    name = self._get_template_name_from_path(path)
+                    if name is not None:
+                        invalidated.append(name)
+                        if self._environments is not None:
+                            for env in list(self._environments):
+                                self._invalidate_env_cache(env, name)
+
+            # Check for deleted files
+            for path in previous_mtimes:
+                if path not in current_templates:
+                    name = self._get_template_name_from_path(path)
+                    if name is not None:
+                        invalidated.append(name)
+                        if self._environments is not None:
+                            for env in list(self._environments):
+                                self._invalidate_env_cache(env, name)
+
+            # Update stored mtimes
+            self._mtimes = current_templates
+
+        return sorted(set(invalidated))
+
+    def invalidate_changed(
+        self, paths: "t.Iterable[str]"
+    ) -> "t.List[str]":
+        """Synchronously invalidate the cache entries for the given
+        absolute file paths. Paths that are not within any search root
+        are ignored. Return a sorted list of canonical template names
+        (using ``/`` as separator) whose cache entries were removed.
+
+        This method does not update the internal mtime tracking used
+        by ``scan_once`` and the monitoring thread.
+        """
+        if not self.auto_reload:
+            return []
+
+        invalidated: "t.List[str]" = []
+        if self._environments is None:
+            return invalidated
+
+        for path in paths:
+            name = self._get_template_name_from_path(path)
+            if name is not None:
+                invalidated.append(name)
+                for env in list(self._environments):
+                    self._invalidate_env_cache(env, name)
+
+        return sorted(set(invalidated))
