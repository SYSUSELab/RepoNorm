+    def start_monitoring(self) -> None:
+        """Start the background monitoring thread. The thread polls the
+        filesystem every 0.5 seconds and invalidates the cache of all
+        tracked environments when templates change.
+
+        This method is idempotent. If monitoring is already active,
+        calling it again has no effect. If ``auto_reload`` is
+        ``False``, no thread is started.
+        """
+        if not self.auto_reload:
+            return
