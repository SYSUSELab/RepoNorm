+    def scan_once(self) -> "t.List[str]":
+        """Perform a synchronous comparison of the filesystem against the
+        last known state. Cache entries for templates that have been
+        modified, deleted, or added are invalidated. Return a sorted
+        list of canonical template names (using ``/`` as separator)
+        that were invalidated.
