+    def _get_template_name_from_path(self, path: str) -> "t.Optional[str]":
+        """Given an absolute path, return the canonical template name
+        (``/``-separated, relative to one of the search paths), or
+        ``None`` if the path is not within any search path.
+
+        Nested paths and leading-dot names are preserved.
+        """
+        norm_path = os.path.normpath(path)
+        for searchpath in self.searchpath:
+            sp = os.path.normpath(searchpath)
+            if norm_path == sp:
+                # The search path itself is not a template
+                return None
+            if norm_path.startswith(sp + os.sep):
+                rel = os.path.relpath(norm_path, sp)
+                # Convert to /-separated
+                canonical = rel.replace(os.sep, "/")
+                # Preserve leading dot segments (e.g. "./foo")
+                if canonical.startswith("../"):
+                    continue
+                if canonical.startswith("./"):
+                    # Keep the leading dot
+                    pass
+                return canonical
+        return None
+
+    def _collect_templates(self) -> "t.Dict[str, float]":
+        """Walk all search paths and return a dict mapping absolute file
+        paths to their mtimes.
+        """
+        templates: "t.Dict[str, float]" = {}
+        for searchpath in self.searchpath:
+            try:
+                for dirpath, _, filenames in os.walk(
+                    searchpath, followlinks=self.followlinks
+                ):
+                    for filename in filenames:
+                        full_path = os.path.join(dirpath, filename)
+                        try:
+                            mtime = os.path.getmtime(full_path)
+                            templates[full_path] = mtime
+                        except OSError:
+                            continue
+            except OSError:
+                continue
+        return templates
