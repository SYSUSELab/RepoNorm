+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address, optionally enforcing a specific format.
+    """
+
+    _colon_pattern = re.compile(r'^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$')
+    _hyphen_pattern = re.compile(r'^([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}$')
+    _dot_pattern = re.compile(r'^[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}$')
+    _compact_pattern = re.compile(r'^[0-9A-Fa-f]{12}$')
+
+    _format_map = {
+        None: None,
+        'colon': _colon_pattern,
+        'hyphen': _hyphen_pattern,
+        'dot': _dot_pattern,
+        'compact': _compact_pattern,
+    }
+
+    def __init__(self, format: Literal[None, 'colon', 'hyphen', 'dot', 'compact'] = None):
+        """
+        Args:
+            format: The format of the MAC address to check, if omitted, all formats are accepted.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert '00:1A:2B:3C:4D:5E' == IsMac
+        assert '00:1A:2B:3C:4D:5E' == IsMac('colon')
+        assert '00-1A-2B-3C-4D-5E' == IsMac('hyphen')
+        assert '001A.2B3C.4D5E' == IsMac('dot')
+        assert '001A2B3C4D5E' == IsMac('compact')
+        assert '00:1A:2B:3C:4D:5E' != IsMac('hyphen')
+        ```
+        """
+        self.format = format
+        super().__init__(plain_repr('*') if format is None else format)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format is not None:
+            pattern = self._format_map[self.format]
+            return bool(pattern.fullmatch(other))
+        else:
+            return (
+                bool(self._colon_pattern.fullmatch(other))
+                or bool(self._hyphen_pattern.fullmatch(other))
+                or bool(self._dot_pattern.fullmatch(other))
+                or bool(self._compact_pattern.fullmatch(other))
+            )
+
+
 AnyJson = object
 JsonType = TypeVar('JsonType', AnyJson, Any)
 
