+    def stats(self) -> dict:
+        """Return a fresh dictionary with cache hit/miss statistics."""
+        with self._lock:
+            return {
+                "hits": self._hits,
+                "mem_hits": self._mem_hits,
+                "disk_hits": self._disk_hits,
+                "misses": self._misses,
+            }
+
+    def reset_stats(self) -> None:
+        """Reset cache hit/miss counters to zero without clearing entries."""
