+        """A synchronous context manager for temporarily adding filters.
+
+        Accepts the same filter inputs as :meth:`add_filter`. Scopes may
+        nest; leaving a scope restores the filter configuration present
+        on entry, including when entering or executing the scope raises
+        an exception. Filter changes made inside the scope are temporary.
+        The scope is local to that loader and does not promise thread or
+        asynchronous-task isolation.
+        """
+        old_filters = list(self._get_filters())
+        try:
+            for pattern in patterns:
+                self.add_filter(pattern)
+            yield
+        finally:
+            self._filters = old_filters
