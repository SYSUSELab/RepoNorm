+    def add_filter(self, filter_pattern: t.Any) -> None:
+        """Register a filter that excludes a canonical ``/``-separated
+        template name from :meth:`list_templates` when any filter matches.
+
+        Strings use case-sensitive glob matching, compiled regular
+        expressions use ``search``, and callables receive the template
+        name and exclude it when truthy. Unsupported objects raise
+        :exc:`TypeError`; exceptions raised while matching propagate
+        unchanged.
+        """
+        if isinstance(filter_pattern, str):
+            pass
+        elif callable(filter_pattern):
+            pass
+        elif isinstance(filter_pattern, re.Pattern):
+            pass
+        else:
+            raise TypeError(
+                f"Filter must be a string, compiled regex, or callable, not "
+                f"{type(filter_pattern).__name__!r}"
+            )
+        self._get_filters().append(filter_pattern)
+
+    def clear_filters(self) -> None:
+        """Clear all registered filters."""
+        self._filters = []
+
+    def _filter_templates(self, names: t.List[str]) -> t.List[str]:
+        """Apply all registered filters to a list of template names."""
+        filters = self._get_filters()
+        if not filters:
+            return names
+
+        result = []
+        for name in names:
+            excluded = False
+            for f in filters:
+                if isinstance(f, str):
+                    if fnmatch.fnmatch(name, f):
+                        excluded = True
+                        break
+                elif isinstance(f, re.Pattern):
+                    if f.search(name):
+                        excluded = True
+                        break
+                elif callable(f):
+                    if f(name):
+                        excluded = True
+                        break
+            if not excluded:
+                result.append(name)
+        return result
+
