@@ -852,3 +852,336 @@ i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+
+class ConditionalI18nExtension(InternationalizationExtension):
+    """Adds a ``ctrans`` tag to Jinja that works like ``trans`` with a
+    condition.  If the condition is true, the first branch is rendered as a
+    translatable message.  If the condition is false, the fallback branch
+    is rendered as an ordinary Jinja body.
+
+    .. code-block:: jinja
+
+        {% ctrans condition %}
+            Hello {{ name }}
+        {% fallback %}
+            <div>{{ fallback_text|default("Fallback") }}</div>
+        {% endctrans %}
+
+    The condition is evaluated exactly once.  When true, the first branch
+    follows the same message, variable, pluralization, trimmed/notrimmed,
+    old/new-style, autoescape, and extraction behavior as ``trans``.
+    When false, the fallback is an ordinary Jinja body and only that body
+    is evaluated; it may contain filters, conditions, includes, and other
+    normal constructs.
+
+    An optional ``context`` header value selects ``pgettext`` or
+    ``npgettext`` for the true branch and appears in normal extraction.
+    It may occur once and must be a string literal.  The plural selector
+    follows ordinary ``trans`` rules.
+    """
+
+    tags = {"ctrans"}
+
+    def _parse_ctrans_block(
+        self, parser: "Parser", end_names: t.Set[str]
+    ) -> t.Tuple[t.List[str], str, str]:
+        """Parse until a block tag with a name in *end_names* is
+        encountered.  Returns ``(referenced, body, ended_with)`` where
+        *ended_with* is the tag name that ended the block (without the
+        trailing ``%}``).
+
+        This is a variant of :meth:`InternationalizationExtension._parse_block`
+        that recognizes arbitrary end tag names.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                tag_name = parser.stream.current.value
+                if parser.stream.current.type == "name" and tag_name in end_names:
+                    break
+                expected = ", ".join(sorted(end_names))
+                parser.fail(
+                    f"unexpected tag {tag_name!r}, expected one of: {expected}",
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, "".join(buf), tag_name
+
+    def _make_ctrans_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+        context: t.Optional[str],
+    ) -> nodes.Output:
+        """Like :meth:`InternationalizationExtension._make_node` but with
+        optional context support using ``pgettext`` / ``npgettext``.
+        """
+        newstyle = self.environment.newstyle_gettext  # type: ignore
+        node: nodes.Expr
+
+        # no variables referenced?  no need to escape for old style
+        # gettext invocations only if there are vars.
+        if not vars_referenced and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            if context is not None:
+                func = nodes.Name("pgettext", "load")
+                node = nodes.Call(
+                    func, [nodes.Const(context), nodes.Const(singular)], [], None, None
+                )
+            else:
+                gettext = nodes.Name("gettext", "load")
+                node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            if context is not None:
+                func = nodes.Name("npgettext", "load")
+                node = nodes.Call(
+                    func,
+                    [nodes.Const(context), nodes.Const(singular), nodes.Const(plural), plural_expr],
+                    [],
+                    None,
+                    None,
+                )
+            else:
+                ngettext = nodes.Name("ngettext", "load")
+                node = nodes.Call(
+                    ngettext,
+                    [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                    [],
+                    None,
+                    None,
+                )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(
+                    node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+
+        return nodes.Output([node])
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        condition = parser.parse_expression()
+
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        context: t.Optional[str] = None
+        num_called_num: bool = False
+        seen_header_item: bool = False
+
+        if parser.stream.current.type == "comma":
+            parser.stream.skip()
+            while parser.stream.current.type != "block_end":
+                if seen_header_item:
+                    parser.stream.expect("comma")
+
+                # skip colon for python compatibility
+                if parser.stream.skip_if("colon"):
+                    break
+
+                token = parser.stream.expect("name")
+                if token.value in variables:
+                    parser.fail(
+                        f"translatable variable {token.value!r} defined twice.",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+
+                # expressions
+                if trimmed is None and token.value in ("trimmed", "notrimmed"):
+                    trimmed = token.value == "trimmed"
+                    seen_header_item = True
+                    continue
+                elif token.value == "context":
+                    parser.stream.expect("assign")
+                    if parser.stream.current.type != "string":
+                        parser.fail(
+                            f"context must be a string literal, got {parser.stream.current.type}",
+                            token.lineno,
+                            exc=TemplateAssertionError,
+                        )
+                    ctx_token = parser.stream.expect("string")
+                    if context is not None:
+                        parser.fail(
+                            "context specified twice",
+                            token.lineno,
+                            exc=TemplateAssertionError,
+                        )
+                    context = ctx_token.value
+                    seen_header_item = True
+                    continue
+                elif parser.stream.current.type == "assign":
+                    next(parser.stream)
+                    variables[token.value] = var = parser.parse_expression()
+                else:
+                    variables[token.value] = var = nodes.Name(token.value, "load")
+
+                if plural_expr is None:
+                    if isinstance(var, nodes.Call):
+                        plural_expr = nodes.Name("_trans", "load")
+                        variables[token.value] = plural_expr
+                        plural_expr_assignment = nodes.Assign(
+                            nodes.Name("_trans", "store"), var
+                        )
+                    else:
+                        plural_expr = var
+                    num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        # Parse the true branch (translation body).
+        # Recognised end tags: pluralize, fallback, endctrans
+        end_names: t.Set[str] = {"pluralize", "fallback", "endctrans"}
+        singular_names, singular, ended_with = self._parse_ctrans_block(
+            parser, end_names
+        )
+
+        referenced: t.Set[str] = set(singular_names)
+        if singular_names and plural_expr is None:
+            plural_expr = nodes.Name(singular_names[0], "load")
+            num_called_num = singular_names[0] == "num"
+
+        have_plural = False
+        plural: t.Optional[str] = None
+
+        if ended_with == "pluralize":
+            have_plural = True
+            next(parser.stream)  # consume the pluralize name token
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural, ended_with = self._parse_ctrans_block(
+                parser, {"fallback", "endctrans"}
+            )
+            referenced.update(plural_names)
+
+        # Now ended_with should be "fallback" or "endctrans"
+        if ended_with == "endctrans":
+            parser.fail(
+                "conditional translation block must have a fallback section",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        if ended_with != "fallback":
+            parser.fail(
+                f'expected "fallback" but got {ended_with!r}',
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        # Consume the fallback name token; parse_statements will handle the block_end
+        next(parser.stream)
+
+        # Parse the fallback body as ordinary Jinja statements until endctrans
+        fallback_body = parser.parse_statements(
+            ("name:endctrans",), drop_needle=True
+        )
+
+        # Register free names as simple name expressions
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies["ext.i18n.trimmed"]
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+
+        # Build the translation output node for the true branch
+        true_node = self._make_ctrans_node(
+            singular,
+            plural,
+            variables,
+            plural_expr,
+            bool(referenced),
+            num_called_num and have_plural,
+            context,
+        )
+        true_node.set_lineno(lineno)
+
+        if plural_expr_assignment is not None:
+            true_body: t.List[nodes.Node] = [plural_expr_assignment, true_node]
+        else:
+            true_body = [true_node]
+
+        # Build the If node
+        if_node = nodes.If(
+            condition,
+            true_body,
+            [],
+            fallback_body,
+            lineno=lineno,
+        )
+
+        return if_node
+
+    def _trim_whitespace(
+        self, string: str, _ws_re: "t.Pattern[str]" = _ws_re
+    ) -> str:
+        return _ws_re.sub(" ", string.strip())
