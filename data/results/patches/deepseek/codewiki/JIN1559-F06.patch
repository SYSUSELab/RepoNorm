+def _make_cached_gettext(
+    func: t.Callable[[str], str],
+) -> t.Callable[..., str]:
+    """Wrap gettext with an LRU cache keyed by partition and message."""
+    @pass_environment
+    def gettext(env: "Environment", __string: str) -> str:
+        cache = env._translation_cache  # type: ignore
+        if cache is None:
+            return func(__string)
+        partition = env._translation_cache_partition  # type: ignore
+        key = (partition, "gettext", __string)
+        try:
+            return cache[key]
+        except KeyError:
+            rv = func(__string)
+            cache[key] = rv
+            return rv
+
+    return gettext
