@@ -0,0 +1,247 @@
+"""Test script for token transformer functionality."""
+
+import functools
+import tiktoken
+
+# Get an encoding for testing
+enc = tiktoken.get_encoding("cl100k_base")
+
+
+def lowercase(text: str) -> str:
+    return text.lower()
+
+
+def remove_punctuation(text: str) -> str:
+    import string
+    return text.translate(str.maketrans("", "", string.punctuation))
+
+
+def reverse_text(text: str) -> str:
+    return text[::-1]
+
+
+def strip_whitespace(text: str) -> str:
+    return text.strip()
+
+
+def test_encode_no_transformers():
+    """Test that encode works without transformers (backwards compat)."""
+    assert enc.encode("Hello World") == [9906, 4435]
+    print("PASS: test_encode_no_transformers")
+
+
+def test_encode_single_transformer():
+    """Test encode with a single transformer."""
+    tokens = enc.encode("Hello World", transformers=lowercase)
+    # lowercase("Hello World") = "hello world"
+    expected_normal = enc.encode("Hello World")
+    expected_lower = enc.encode("hello world")
+    assert tokens == expected_lower, f"{tokens} != {expected_lower}"
+    assert tokens != expected_normal
+    print("PASS: test_encode_single_transformer")
+
+
+def test_encode_chain_of_transformers():
+    """Test encode with a chain of transformers."""
+    # First lowercase then remove punctuation
+    tokens = enc.encode("Hello, World!", transformers=[lowercase, remove_punctuation])
+    expected = enc.encode("hello world")
+    assert tokens == expected, f"{tokens} != {expected}"
+    print("PASS: test_encode_chain_of_transformers")
+
+
+def test_encode_tuple_transformers():
+    """Test encode with a tuple of transformers."""
+    tokens = enc.encode("  Hello World  ", transformers=(strip_whitespace, lowercase))
+    expected = enc.encode("hello world")
+    assert tokens == expected, f"{tokens} != {expected}"
+    print("PASS: test_encode_tuple_transformers")
+
+
+def test_encode_ordinary_with_transformers():
+    """Test encode_ordinary with transformers."""
+    tokens = enc.encode_ordinary("Hello World", transformers=lowercase)
+    expected = enc.encode_ordinary("hello world")
+    assert tokens == expected, f"{tokens} != {expected}"
+    print("PASS: test_encode_ordinary_with_transformers")
+
+
+def test_encode_batch_with_transformers():
+    """Test encode_batch with transformers."""
+    texts = ["Hello World", "Goodbye World"]
+    tokens = enc.encode_batch(texts, transformers=lowercase)
+    expected = [enc.encode("hello world"), enc.encode("goodbye world")]
+    assert tokens == expected, f"{tokens} != {expected}"
+    print("PASS: test_encode_batch_with_transformers")
+
+
+def test_encode_ordinary_batch_with_transformers():
+    """Test encode_ordinary_batch with transformers."""
+    texts = ["Hello World", "Goodbye World"]
+    tokens = enc.encode_ordinary_batch(texts, transformers=lowercase)
+    expected = [enc.encode_ordinary("hello world"), enc.encode_ordinary("goodbye world")]
+    assert tokens == expected, f"{tokens} != {expected}"
+    print("PASS: test_encode_ordinary_batch_with_transformers")
+
+
+def test_empty_batch():
+    """Test that empty batch returns empty list."""
+    result = enc.encode_batch([], transformers=lowercase)
+    assert result == [], f"{result} != []"
+    print("PASS: test_empty_batch")
+
+
+def test_non_string_return_raises_type_error():
+    """Test that a transformer returning non-string raises TypeError."""
+    def bad_transformer(text):
+        return 123
+    
+    try:
+        enc.encode("hello", transformers=bad_transformer)
+        assert False, "Should have raised TypeError"
+    except TypeError:
+        print("PASS: test_non_string_return_raises_type_error")
+
+
+def test_callback_exception_propagates():
+    """Test that callback exceptions propagate unchanged."""
+    class CustomError(Exception):
+        pass
+    
+    def failing_transformer(text):
+        raise CustomError("oops")
+    
+    try:
+        enc.encode("hello", transformers=failing_transformer)
+        assert False, "Should have raised CustomError"
+    except CustomError:
+        print("PASS: test_callback_exception_propagates")
+
+
+def test_early_exception_no_later_callbacks():
+    """Test that an exception in one callback prevents later callbacks."""
+    call_count = [0]
+    
+    def first_good(text):
+        call_count[0] += 1
+        return text
+    
+    def failing_transformer(text):
+        raise ValueError("fail")
+    
+    def second_good(text):
+        # This should never be called
+        raise AssertionError("Should not be called")
+    
+    try:
+        enc.encode("hello", transformers=[first_good, failing_transformer, second_good])
+        assert False, "Should have raised ValueError"
+    except ValueError:
+        assert call_count[0] == 1, f"first_good should have been called once, got {call_count[0]}"
+        print("PASS: test_early_exception_no_later_callbacks")
+
+
+def test_repeated_documents_invoke_independently():
+    """Test that repeated documents invoke callbacks independently."""
+    call_count = [0]
+    
+    def counting(text):
+        call_count[0] += 1
+        return text
+    
+    tokens = enc.encode_batch(["hello", "hello", "hello"], transformers=counting)
+    assert call_count[0] == 3, f"should have been called 3 times, got {call_count[0]}"
+    print("PASS: test_repeated_documents_invoke_independently")
+
+
+def test_no_mutation_of_callers_pipeline():
+    """Test that the function doesn't mutate the caller's pipeline."""
+    original_transformers = [lowercase, remove_punctuation]
+    transformers_copy = original_transformers.copy()
+    
+    enc.encode("Hello World", transformers=original_transformers)
+    assert original_transformers == transformers_copy, "original transformers list was mutated"
+    print("PASS: test_no_mutation_of_callers_pipeline")
+
+
+def test_chain_order():
+    """Test that transformers are applied in order."""
+    def prepend_x(text):
+        return "X" + text
+    
+    def lowercase(text):
+        return text.lower()
+    
+    # First prepend X then lowercase: XHello World -> xhello world
+    t1 = enc.encode("Hello World", transformers=[prepend_x, lowercase])
+    # First lowercase then prepend X: hello world -> Xhello world
+    t2 = enc.encode("Hello World", transformers=[lowercase, prepend_x])
+    
+    assert t1 != t2, "Order of transformers should matter"
+    
+    expected_t1 = enc.encode("xhello world")
+    expected_t2 = enc.encode("xhello world" if False else "Xhello world")
+    # Actually:
+    # prepend_x("Hello World") = "XHello World"
+    # lowercase("XHello World") = "xhello world"
+    # lowercase("Hello World") = "hello world"
+    # prepend_x("hello world") = "Xhello world"
+    expected_t1 = enc.encode("xhello world")
+    expected_t2 = enc.encode("Xhello world")
+    assert t1 == expected_t1, f"t1={t1}, expected={expected_t1}"
+    assert t2 == expected_t2, f"t2={t2}, expected={expected_t2}"
+    
+    print("PASS: test_chain_order")
+
+
+def test_transformers_apply_to_all_special_token_checks():
+    """Test that transformers work with the special tokens logic."""
+    # The transformer should transform the text before special token check
+    def add_special(text):
+        return text + " <|endoftext|>"
+    
+    # Without allowed_special, this should raise ValueError
+    try:
+        enc.encode("hello", transformers=add_special)
+        assert False, "Should have raised ValueError about disallowed special token"
+    except ValueError as e:
+        assert "disallowed special token" in str(e)
+        print("PASS: test_transformers_apply_to_all_special_token_checks")
+
+
+def test_encode_to_numpy_with_transformers():
+    """Test encode_to_numpy with transformers."""
+    import numpy as np
+    tokens = enc.encode_to_numpy("Hello World", transformers=lowercase)
+    expected = np.array(enc.encode("hello world"), dtype=np.uint32)
+    assert np.array_equal(tokens, expected), f"{tokens} != {expected}"
+    print("PASS: test_encode_to_numpy_with_transformers")
+
+
+def test_None_transformers():
+    """Test that None transformers works fine (default)."""
+    t1 = enc.encode("Hello World")
+    t2 = enc.encode("Hello World", transformers=None)
+    assert t1 == t2
+    print("PASS: test_None_transformers")
+
+
+if __name__ == "__main__":
+    test_encode_no_transformers()
+    test_encode_single_transformer()
+    test_encode_chain_of_transformers()
+    test_encode_tuple_transformers()
+    test_encode_ordinary_with_transformers()
+    test_encode_batch_with_transformers()
+    test_encode_ordinary_batch_with_transformers()
+    test_empty_batch()
+    test_non_string_return_raises_type_error()
+    test_callback_exception_propagates()
+    test_early_exception_no_later_callbacks()
+    test_repeated_documents_invoke_independently()
+    test_no_mutation_of_callers_pipeline()
+    test_chain_order()
+    test_transformers_apply_to_all_special_token_checks()
+    test_encode_to_numpy_with_transformers()
+    test_None_transformers()
+    print("\nAll tests passed!")
