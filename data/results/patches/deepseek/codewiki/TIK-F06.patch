+def _apply_transformers(
+    text: str,
+    transformers: Callable[[str], str] | list[Callable[[str], str]] | tuple[Callable[[str], str], ...] | None,
+) -> str:
+    """Apply a chain of transformer functions to text.
+    
+    Args:
+        text: The input text to transform.
+        transformers: A single transformer function, a list/tuple of transformer functions, or None.
+        
+    Returns:
+        The transformed text.
+        
+    Raises:
+        TypeError: If a transformer returns a non-string value.
+    """
+    if transformers is None:
+        return text
+    if callable(transformers):
+        transformers = [transformers]
+    for transformer in transformers:
+        result = transformer(text)
+        if not isinstance(result, str):
+            raise TypeError(
+                f"Transformer returned non-string of type {type(result).__name__}"
+            )
+        text = result
+    return text
+
