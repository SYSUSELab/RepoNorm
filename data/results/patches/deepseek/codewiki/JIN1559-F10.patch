+    def bind(self, environment: Environment) -> "InternationalizationExtension":
+        """Create a copy bound to another environment, copying version state."""
+        rv = object.__new__(self.__class__)
+        rv.__dict__.update(self.__dict__)
+        rv.environment = environment
+        # Copy the translation versions dict for isolation in overlays
+        if hasattr(self.environment, "_translation_versions"):
+            environment._translation_versions = dict(
+                self.environment._translation_versions
+            )
+            # Re-register methods to point to the new extension copy
+            environment.set_translation_version = rv._set_translation_version
+            environment.get_translation_version = rv._get_translation_version
+            environment.compare_translation_versions = rv._compare_translation_versions
+            environment.remove_translation_version = rv._remove_translation_version
+            environment.clear_translation_versions = rv._clear_translation_versions
+        return rv
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        """Set the translation version for a message."""
+        self.environment._translation_versions[message] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        """Get the translation version for a message, or None if unknown."""
+        return self.environment._translation_versions.get(message, None)
+
+    def _compare_translation_versions(
+        self, message1: str, message2: str
+    ) -> bool:
+        """Compare versions of two messages. True only if both exist and equal."""
+        versions = self.environment._translation_versions
+        if message1 in versions and message2 in versions:
+            return versions[message1] == versions[message2]
+        return False
+
+    def _remove_translation_version(self, message: str) -> None:
+        """Remove a translation version entry. Harmless if unknown."""
+        self.environment._translation_versions.pop(message, None)
+
+    def _clear_translation_versions(self) -> None:
+        """Remove all translation version entries."""
+        self.environment._translation_versions.clear()
+
     def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
         """Parse a translatable tag."""
         lineno = next(parser.stream).lineno
