+    def _weighted_tip_selection(self):
+        """Select a tip key using self.tip_weights for weighted random selection.
+        
+        When tip_weights is None, performs uniform random selection over TIPS keys.
+        When tip_weights is provided, computes effective weights per TIPS key:
+        - Missing keys have weight 1.
+        - Unknown keys (not in TIPS) are ignored.
+        - Positive finite int/float weights are usable.
+        - Non-numeric, bool, nonfinite, and nonpositive values have weight zero.
+        - Zero-weight entries are never selected when any positive weight exists.
+        - If all effective weights are zero, falls back to uniform selection.
+        """
+        keys = list(TIPS.keys())
+        
+        if self.tip_weights is None:
+            return self.rng.choice(keys)
+        
+        weights = []
+        for key in keys:
+            if key in self.tip_weights:
+                w = self.tip_weights[key]
+                # Validate weight
+                if isinstance(w, bool):
+                    w = 0
+                elif not isinstance(w, (int, float)):
+                    w = 0
+                elif not math.isfinite(w):
+                    w = 0
+                elif w <= 0:
+                    w = 0
+            else:
+                w = 1  # missing keys have weight 1
+            weights.append(w)
+        
+        # Check if all weights are zero
+        if all(w == 0 for w in weights):
+            return self.rng.choice(keys)
+        
+        # Weighted selection using cumulative weights
+        # Avoid overflow by using Python's arbitrary precision for large weights
+        cumulative = []
+        total = 0
+        for w in weights:
+            total += w
+            cumulative.append(total)
+        
+        # Generate random number in [0, total)
+        r = self.rng.random() * total
+        
+        for i, cw in enumerate(cumulative):
+            if r < cw:
+                return keys[i]
+        
+        # Fallback (shouldn't be reached)
+        return keys[-1]
+
