index 85af9ad..2d5c3f0 100644
--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,12 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Credit card number: exactly 16 ASCII digits in one of three shapes:
+# - no separators: 1234567890123456
+# - four groups separated by single hyphens: 1234-5678-9012-3456
+# - four groups separated by single spaces: 1234 5678 9012 3456
+# Separators must be consistent. This does NOT validate Luhn checksums.
+credit_card = Regex(
+    r"(\d{16}|\d{4}-\d{4}-\d{4}-\d{4}|\d{4} \d{4} \d{4} \d{4})"
+)
