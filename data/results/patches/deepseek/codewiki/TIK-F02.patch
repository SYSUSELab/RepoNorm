+    pub fn encode_with_positions(
+        &self,
+        text: &str,
+        allowed_special: &HashSet<&str>,
+    ) -> (Vec<Rank>, Vec<usize>) {
+        let special_regex = self._get_tl_special_regex();
+        let regex = self._get_tl_regex();
+        let mut ret = vec![];
+        let mut positions = vec![];
+
+        // Build a mapping from byte offset to character index
+        let text_len = text.len();
+        let mut byte_to_char = vec![0usize; text_len + 1];
+        let mut char_idx: usize = 0;
+        let mut prev_byte = 0;
+        for (byte_idx, _) in text.char_indices() {
+            // Fill intermediate bytes (inside multibyte chars) with prev char index
+            for b in prev_byte..byte_idx {
+                byte_to_char[b] = char_idx.saturating_sub(1);
+            }
+            byte_to_char[byte_idx] = char_idx;
+            char_idx += 1;
+            prev_byte = byte_idx;
+        }
+        // Fill any remaining bytes after the last character
+        for b in prev_byte..text_len {
+            byte_to_char[b] = char_idx.saturating_sub(1);
+        }
+        byte_to_char[text_len] = char_idx;
+        
+
+        let mut start = 0;
+        loop {
+            let mut next_special;
+            let mut start_find = start;
+            loop {
+                // Find the next allowed special token, if any
+                next_special = special_regex.find_from_pos(text, start_find).unwrap();
+                match next_special {
+                    Some(m) => {
+                        if allowed_special.contains(&text[m.start()..m.end()]) {
+                            break;
+                        }
+                        start_find = m.start() + 1;
+                    }
+                    None => break,
+                }
+            }
+            let end = next_special.map_or(text.len(), |m| m.start());
+
+            // Okay, here we go, compare this logic to encode_ordinary
+            for mat in regex.find_iter(&text[start..end]) {
+                let m = mat.unwrap();
+                let piece_start = start + m.start();
+                let piece = m.as_str().as_bytes();
+                if let Some(token) = self.encoder.get(piece) {
+                    ret.push(*token);
+                    positions.push(byte_to_char[piece_start]);
+                    continue;
+                }
+                let parts = _byte_pair_merge(&self.encoder, piece);
+                for i in 0..parts.len() - 1 {
+                    let part_start = parts[i].0;
+                    let part_end = parts[i + 1].0;
+                    ret.push(self.encoder[&piece[part_start..part_end]]);
+                    positions.push(byte_to_char[piece_start + part_start]);
+                }
+            }
+
+            match next_special {
+                // And here we push the special token
+                Some(m) => {
+                    let piece = m.as_str();
+                    let token = self.special_tokens_encoder[piece];
+                    ret.push(token);
+                    positions.push(byte_to_char[m.start()]);
+                    start = m.end();
+                }
+                None => break,
+            }
+        }
+
+        (ret, positions)
+    }
