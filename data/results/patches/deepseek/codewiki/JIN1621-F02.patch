diff --git a/tests/test_loader.py b/tests/test_loader.py
index b300c8f..6922dd4 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -112,9 +112,60 @@ class TestLoaders:
         assert env.get_template("foo").render() == "two"
 
     def test_split_template_path(self):
+        # Basic normalization
         assert split_template_path("foo/bar") == ["foo", "bar"]
         assert split_template_path("./foo/bar") == ["foo", "bar"]
+        assert split_template_path("foo/./bar") == ["foo", "bar"]
+        assert split_template_path("foo//bar") == ["foo", "bar"]
+
+        # Dot-dot resolution within root
+        assert split_template_path("foo/../bar") == ["bar"]
+        assert split_template_path("foo/bar/../baz") == ["foo", "baz"]
+        assert split_template_path("a/b/../c/../d") == ["a", "d"]
+        pytest.raises(TemplateNotFound, split_template_path, "a/../../b")
+
+        # Backslash normalization
+        assert split_template_path("foo\\bar") == ["foo", "bar"]
+        assert split_template_path("foo\\..\\bar") == ["bar"]
+        assert split_template_path("foo\\bar\\../baz") == ["foo", "baz"]
+
+        # Mixed separators
+        assert split_template_path("foo/bar\\baz") == ["foo", "bar", "baz"]
+        assert split_template_path("foo\\bar/baz") == ["foo", "bar", "baz"]
+
+        # Leading dot-dot rejection
         pytest.raises(TemplateNotFound, split_template_path, "../foo")
+        pytest.raises(TemplateNotFound, split_template_path, "..")
+        pytest.raises(TemplateNotFound, split_template_path, "../..")
+
+        # Dot-dot beyond root rejection
+        pytest.raises(TemplateNotFound, split_template_path, "foo/../../..")
+        pytest.raises(TemplateNotFound, split_template_path, "foo/../..")
+
+        # Absolute path rejection
+        pytest.raises(TemplateNotFound, split_template_path, "/foo")
+        pytest.raises(TemplateNotFound, split_template_path, "/foo/bar")
+        pytest.raises(TemplateNotFound, split_template_path, "\\foo")
+        pytest.raises(TemplateNotFound, split_template_path, "\\foo\\bar")
+
+        # Drive prefix rejection
+        pytest.raises(TemplateNotFound, split_template_path, "C:foo")
+        pytest.raises(TemplateNotFound, split_template_path, "C:\\foo")
+        pytest.raises(TemplateNotFound, split_template_path, "D:foo\\bar")
+
+        # TemplateNotFound contains the original request name
+        try:
+            split_template_path("../foo")
+        except TemplateNotFound as e:
+            assert e.name == "../foo"
+        try:
+            split_template_path("/etc/passwd")
+        except TemplateNotFound as e:
+            assert e.name == "/etc/passwd"
+        try:
+            split_template_path("C:\\windows")
+        except TemplateNotFound as e:
+            assert e.name == "C:\\windows"
 
 
