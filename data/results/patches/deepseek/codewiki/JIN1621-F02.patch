diff --git a/src/jinja2/loaders.py b/src/jinja2/loaders.py
index d7d9bd0..ec4539b 100644
--- a/src/jinja2/loaders.py
+++ b/src/jinja2/loaders.py
@@ -22,20 +22,40 @@ if t.TYPE_CHECKING:
 
 
 def split_template_path(template: str) -> t.List[str]:
-    """Split a path into segments and perform a sanity check.  If it detects
-    '..' in the path it will raise a `TemplateNotFound` error.
+    """Normalize a template path and reject dangerous ones.
+
+    Both ``/`` and ``\\`` are logical separators. Empty segments and ``.``
+    are removed. An internal ``..`` removes the preceding ordinary segment.
+
+    Preserves the loader root boundary by rejecting a leading ``..``, any
+    ``..`` that would pop beyond the logical root, names beginning with
+    ``/`` or ``\\``, UNC forms, and names beginning with an ASCII drive
+    prefix such as ``C:``.
+
+    Raises ``TemplateNotFound`` containing the original request name if
+    the path is invalid.
     """
-    pieces = []
-    for piece in template.split("/"):
-        if (
-            os.path.sep in piece
-            or (os.path.altsep and os.path.altsep in piece)
-            or piece == os.path.pardir
-        ):
-            raise TemplateNotFound(template)
-        elif piece and piece != ".":
-            pieces.append(piece)
-    return pieces
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+
+    if len(template) >= 2 and template[1] == ":" and template[0].isascii() and template[0].isalpha():
+        raise TemplateNotFound(template)
+
+    normalized = template.replace("\\", "/")
+    pieces = normalized.split("/")
+
+    result: t.List[str] = []
+    for piece in pieces:
+        if piece == "" or piece == ".":
+            continue
+        elif piece == "..":
+            if not result:
+                raise TemplateNotFound(template)
+            result.pop()
+        else:
+            result.append(piece)
+
+    return result
 
 
