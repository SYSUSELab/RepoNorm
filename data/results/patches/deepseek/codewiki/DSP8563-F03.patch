+def test_coerce_duration_suffixes():
+    """Test duration suffixes ms, s, m, h."""
+    def int_func(x: int):
+        return f"result={x} type={type(x).__name__}"
+
+    int_tool = Tool(
+        func=int_func,
+        name="int_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    # ms -> seconds (truncated for integer)
+    assert int_tool(x="500ms") == "result=0 type=int"  # 0.5s -> 0
+    assert int_tool(x="1000ms") == "result=1 type=int"  # 1.0s -> 1
+
+    # s
+    assert int_tool(x="5s") == "result=5 type=int"
+    assert int_tool(x="0s") == "result=0 type=int"
+
+    # m
+    assert int_tool(x="1m") == "result=60 type=int"
+
+    # h
+    assert int_tool(x="1h") == "result=3600 type=int"
+
+    # Whitespace between magnitude and suffix
+    assert int_tool(x="2.5 s") == "result=2 type=int"  # 2.5 -> truncated to 2
+
+    def float_func(x: float):
+        return f"result={x} type={type(x).__name__}"
+
+    float_tool = Tool(
+        func=float_func,
+        name="float_tool",
+        args={"x": {"type": "number"}},
+        arg_types={"x": float},
+    )
+
+    # ms for float
+    res = float_tool(x="500ms")
+    assert "result=0.5" in res
+
+    # s for float
+    res = float_tool(x="5s")
+    assert "result=5.0" in res
+
+    # Case sensitivity: 'S' should not be recognized
+    with pytest.raises(ValueError, match="is invalid"):
+        int_tool(x="5S")
+
+
+def test_coerce_size_suffixes():
+    """Test size suffixes KB, MB, GB."""
+    def int_func(x: int):
+        return f"result={x} type={type(x).__name__}"
+
+    int_tool = Tool(
+        func=int_func,
+        name="int_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    # KB
+    assert int_tool(x="1KB") == "result=1000 type=int"
+    assert int_tool(x="0KB") == "result=0 type=int"
+
+    # MB
+    assert int_tool(x="1MB") == "result=1000000 type=int"
+
+    # GB
+    assert int_tool(x="1GB") == "result=1000000000 type=int"
+
+    # Fractional magnitude
+    assert int_tool(x="2.5KB") == "result=2500 type=int"
+
+    # Truncation toward zero for fractional bytes
+    assert int_tool(x="1.999KB") == "result=1999 type=int"  # 1999.0 -> 1999
+    assert int_tool(x="0.001KB") == "result=1 type=int"  # 1.0 -> 1
+
+    # Whitespace
+    assert int_tool(x="1 KB") == "result=1000 type=int"
+
+    # Case sensitivity: 'kb' should not be recognized
+    with pytest.raises(ValueError, match="is invalid"):
+        int_tool(x="1kb")
+
