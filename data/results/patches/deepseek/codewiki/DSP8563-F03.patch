+def test_coerce_string_fields_unchanged():
+    """Test that string-typed fields are not coerced."""
+    def str_func(x: str):
+        return f"result='{x}' type={type(x).__name__}"
+
+    tool = Tool(
+        func=str_func,
+        name="str_tool",
+        args={"x": {"type": "string"}},
+        arg_types={"x": str},
+    )
+
+    # String values stay as strings
+    assert tool(x="42") == "result='42' type=str"
+    assert tool(x="true") == "result='true' type=str"
+    assert tool(x="3.14") == "result='3.14' type=str"
+    assert tool(x="5s") == "result='5s' type=str"
+    assert tool(x="1KB") == "result='1KB' type=str"
+
+
+def test_coerce_unknown_type_not_coerced():
+    """Test that fields with unknown type are not coerced."""
+    def func(x):
+        return f"result={x!r} type={type(x).__name__}"
+
+    tool = Tool(
+        func=func,
+        name="any_tool",
+        args={"x": {"type": "Any"}},
+        arg_types={"x": str},
+    )
+
+    # String stays string even if parsable
+    result = tool(x="42")
+    assert isinstance(result, str)
+
