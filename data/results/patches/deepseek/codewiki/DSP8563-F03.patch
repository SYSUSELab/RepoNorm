+def test_coerce_kwargs_unchanged():
+    """Test that **kwargs values are not coerced."""
+    def kwarg_func(x: int, **kwargs):
+        return f"x={x} extra={kwargs}"
+
+    tool = Tool(
+        func=kwarg_func,
+        name="kwarg_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    result = tool(x="42", y="true", z="5s")
+    assert result == "x=42 extra={'y': 'true', 'z': '5s'}"
+
