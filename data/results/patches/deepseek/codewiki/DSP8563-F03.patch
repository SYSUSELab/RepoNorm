+# --- Tests for scalar and unit coercion ---
+
+def test_coerce_boolean_strings():
+    """Test that string 'true'/'false' are coerced to bool."""
+    def bool_func(x: bool):
+        return f"result={x} type={type(x).__name__}"
+
+    tool = Tool(
+        func=bool_func,
+        name="bool_tool",
+        args={"x": {"type": "boolean"}},
+        arg_types={"x": bool},
+    )
+
+    # Valid boolean strings
+    assert tool(x=True) == "result=True type=bool"
+    assert tool(x="true") == "result=True type=bool"
+    assert tool(x="True") == "result=True type=bool"
+    assert tool(x="TRUE") == "result=True type=bool"
+    assert tool(x="false") == "result=False type=bool"
+    assert tool(x="False") == "result=False type=bool"
+    assert tool(x="FALSE") == "result=False type=bool"
+    assert tool(x="  true  ") == "result=True type=bool"
+
+    # Invalid boolean string -> should raise
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="yes")
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="1")
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="no")
+
+
+def test_coerce_integer_strings():
+    """Test that string numerals are coerced to int."""
+    def int_func(x: int):
+        return f"result={x} type={type(x).__name__}"
+
+    tool = Tool(
+        func=int_func,
+        name="int_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    # Valid integer strings
+    assert tool(x=42) == "result=42 type=int"
+    assert tool(x="42") == "result=42 type=int"
+    assert tool(x="  -17  ") == "result=-17 type=int"
+    assert tool(x="+100") == "result=100 type=int"
+    assert tool(x="0") == "result=0 type=int"
+
+    # Large integer beyond float precision
+    result = tool(x="10000000000")
+    assert result == "result=10000000000 type=int"
+
+    # Non-integral string -> should raise
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="3.14")
+
+    # Non-numeric string -> should raise
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="abc")
+
+    # NaN/Inf -> should raise
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="NaN")
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="Inf")
+
+
+def test_coerce_number_strings():
+    """Test that string numerals are coerced to float."""
+    def float_func(x: float):
+        return f"result={x} type={type(x).__name__}"
+
+    tool = Tool(
+        func=float_func,
+        name="float_tool",
+        args={"x": {"type": "number"}},
+        arg_types={"x": float},
+    )
+
+    # Valid number strings
+    assert tool(x=3.14) == "result=3.14 type=float"
+    res = tool(x="3.14")
+    assert "result=3.14" in res and "type=float" in res
+    res = tool(x="-2.5e2")
+    assert "result=-250.0" in res and "type=float" in res
+
+    # Non-numeric string -> should raise
+    with pytest.raises(ValueError, match="is invalid"):
+        tool(x="abc")
+
