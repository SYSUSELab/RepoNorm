+def _coerce_arg(value, schema_type):
+    """Coerce a string value according to the JSON schema type.
+    
+    Only converts supplied strings; leaves string-typed fields, unknown kwargs,
+    and non-string values unchanged. Returns the coerced value or the original
+    value if conversion fails.
+    """
+    if not isinstance(value, str):
+        return value
+    
+    stripped = value.strip()
+    
+    if schema_type == "boolean":
+        lower = stripped.lower()
+        if lower == "true":
+            return True
+        elif lower == "false":
+            return False
+        return value
+    
+    if schema_type in ("integer", "number"):
+        # Try duration/size suffix parsing first
+        converted = _try_parse_unit(stripped, schema_type)
+        if converted is not None:
+            return converted
+        
+        # Try numeric string parsing
+        try:
+            d = Decimal(stripped)
+            if not d.is_finite():
+                return value  # NaN/Inf -> keep original for error path
+            if schema_type == "integer":
+                if d != d.to_integral_value():
+                    return value  # non-integral -> keep original for error path
+                return int(d)
+            else:  # number
+                return float(d)
+        except (InvalidOperation, ArithmeticError):
+            return value
+    
+    return value
+
+
+def _try_parse_unit(stripped, schema_type):
+    """Try to parse duration or size suffixes. Returns None if no unit matches."""
+    # Duration suffixes: ms, s, m, h (case-sensitive)
+    duration_match = re.match(r'^(\d+(?:\.\d+)?)\s*(ms|s|m|h)$', stripped)
+    if duration_match:
+        magnitude = Decimal(duration_match.group(1))
+        unit = duration_match.group(2)
+        factor = {
+            'ms': Decimal('0.001'),
+            's': Decimal('1'),
+            'm': Decimal('60'),
+            'h': Decimal('3600'),
+        }[unit]
+        seconds = float(magnitude * factor)
+        if schema_type == "integer":
+            return int(seconds)
+        return seconds
+    
+    # Size suffixes: KB, MB, GB (case-sensitive)
+    size_match = re.match(r'^(\d+(?:\.\d+)?)\s*(KB|MB|GB)$', stripped)
+    if size_match:
+        magnitude = Decimal(size_match.group(1))
+        unit = size_match.group(2)
+        factor = {
+            'KB': Decimal('1000'),
+            'MB': Decimal('1000000'),
+            'GB': Decimal('1000000000'),
+        }[unit]
+        bytes_val = magnitude * factor
+        truncated = int(bytes_val.to_integral_value(rounding='ROUND_DOWN'))
+        return truncated
+    
+    return None
+
 
