+def test_coerce_async():
+    """Test coercion works with async tools."""
+    import asyncio
+
+    async def async_func(x: int):
+        return f"result={x} type={type(x).__name__}"
+
+    tool = Tool(
+        func=async_func,
+        name="async_int_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    async def run():
+        res = await tool.acall(x="42")
+        assert res == "result=42 type=int"
+        res = await tool.acall(x="5s")
+        assert res == "result=5 type=int"
+        res = await tool.acall(x="1KB")
+        assert res == "result=1000 type=int"
+
+    asyncio.run(run())
+
+
+def test_coerce_input_mapping_not_mutated():
+    """Test that the original kwargs dict is not mutated."""
+    def int_func(x: int):
+        return f"result={x} type={type(x).__name__}"
+
+    tool = Tool(
+        func=int_func,
+        name="int_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    original_kwargs = {"x": "42"}
+    kwargs_copy = dict(original_kwargs)
+    result = tool(**kwargs_copy)
+    assert result == "result=42 type=int"
+    # Original dict unchanged
+    assert kwargs_copy == original_kwargs
+
+
+def test_coerce_non_string_values_unchanged():
+    """Test that non-string values (int, float, bool) pass through unchanged."""
+    def int_func(x: int):
+        return f"result={x} type={type(x).__name__}"
+
+    tool = Tool(
+        func=int_func,
+        name="int_tool",
+        args={"x": {"type": "integer"}},
+        arg_types={"x": int},
+    )
+
+    assert tool(x=42) == "result=42 type=int"
+    assert tool(x=0) == "result=0 type=int"
+    assert tool(x=-17) == "result=-17 type=int"
