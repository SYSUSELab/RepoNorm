+class IsRegex(DirtyEquals[str]):
+    """A class that checks if a value matches a regular expression pattern.
+
+    IsRegex uses `re.match` by default (matching at the beginning), but can also
+    use `re.search` or `re.fullmatch` via the `mode` parameter.
+
+    Args:
+        pattern: A string pattern or compiled regular expression (str patterns only).
+        flags: Optional flags for the regular expression. Cannot be used with a compiled pattern.
+        mode: The regex matching mode - 'match' (default), 'search', or 'fullmatch'.
+
+    Examples:
+        ```py title="IsRegex"
+        from dirty_equals import IsRegex
+        import re
+
+        assert 'hello world' == IsRegex('hello')
+        assert 'hello' == IsRegex('hello', mode='fullmatch')
+        assert 'hello world' != IsRegex('hello', mode='fullmatch')
+        assert 'say hello' == IsRegex('hello', mode='search')
+        assert 'HELLO' == IsRegex('hello', re.I)
+        assert 'HELLO' == IsRegex(re.compile('hello', re.I))
+        ```
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, Pattern[str]],
+        flags: int = 0,
+        *,
+        mode: Literal['match', 'search', 'fullmatch'] = 'match',
+    ):
+        if mode not in ('match', 'search', 'fullmatch'):
+            raise ValueError(f"Invalid mode {mode!r}, must be 'match', 'search', or 'fullmatch'")
+
+        if isinstance(pattern, re.Pattern):
+            if isinstance(pattern.pattern, bytes):
+                raise TypeError('Bytes patterns are not supported')
+            if flags != 0:
+                raise ValueError('Cannot specify flags with a compiled pattern')
+            self._pattern: str = pattern.pattern
+            self._flags: int = pattern.flags & ~re.UNICODE
+        else:
+            if isinstance(pattern, bytes):
+                raise TypeError('Bytes patterns are not supported')
+            # Validate the pattern
+            re.compile(pattern, flags)
+            self._pattern = pattern
+            self._flags = flags
+
+        self._mode = mode
+        self._compiled: Pattern[str] = re.compile(self._pattern, self._flags)
+
+        # Build repr arguments
+        repr_args = [self._pattern]
+        repr_kwargs = {}
+
+        if self._flags != 0:
+            repr_args.append(plain_repr(repr(re.RegexFlag(self._flags))))
+        if mode != 'match':
+            repr_kwargs['mode'] = mode
+
+        super().__init__(*repr_args, **repr_kwargs)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self._mode == 'match':
+            return bool(self._compiled.match(other))
+        elif self._mode == 'search':
+            return bool(self._compiled.search(other))
+        elif self._mode == 'fullmatch':
+            return bool(self._compiled.fullmatch(other))
+
+        return False
