diff --git a/src/click/core.py b/src/click/core.py
index f57ada6..712aa76 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -2549,6 +2549,10 @@ class Option(Parameter):
         show_choices: bool = True,
         show_envvar: bool = False,
         deprecated: bool | str = False,
+        validators: cabc.Sequence[
+            t.Callable[[Context, Parameter, t.Any], t.Any]
+        ]
+        | None = None,
         **attrs: t.Any,
     ) -> None:
         if help:
@@ -2559,6 +2563,31 @@ class Option(Parameter):
             param_decls, type=type, multiple=multiple, deprecated=deprecated, **attrs
         )
 
+        if validators is not None:
+            if isinstance(validators, str):
+                raise TypeError(
+                    "'validators' must be a sequence of callables or None, not a string."
+                )
+            for idx, validator in enumerate(validators):
+                if not callable(validator):
+                    raise TypeError(
+                        f"Validator at index {idx} is not callable."
+                    )
+
+        if validators:
+            original_callback = self.callback
+
+            def composed_callback(
+                ctx: Context, param: Parameter, value: t.Any
+            ) -> t.Any:
+                if original_callback is not None:
+                    value = original_callback(ctx, param, value)
+                for validator in validators:
+                    value = validator(ctx, param, value)
+                return value
+
+            self.callback = composed_callback
+
         if prompt is True:
             if self.name is None:
                 raise TypeError("'name' is required with 'prompt=True'.")
