+        @staticmethod
+        def _canonicalize_value(v):
+            """Recursively canonicalize a value for fingerprinting.
+
+            Rules:
+            - Sort dictionary keys (done by json.dumps sort_keys=True)
+            - Treat tuples as lists
+            - Trim surrounding whitespace from string values
+            - Preserve numeric/boolean types and list order
+            - Do not trim dictionary keys or the tool name
+            - Reject nonfinite numbers and non-JSON values with ValueError
+            """
+            if isinstance(v, dict):
+                return {k: ToolCalls.ToolCall._canonicalize_value(v) for k, v in v.items()}
+            elif isinstance(v, tuple):
+                return [ToolCalls.ToolCall._canonicalize_value(x) for x in v]
+            elif isinstance(v, list):
+                return [ToolCalls.ToolCall._canonicalize_value(x) for x in v]
+            elif isinstance(v, str):
+                return v.strip()
+            elif isinstance(v, bool):
+                return v
+            elif isinstance(v, (int, float)):
+                if isinstance(v, bool):
