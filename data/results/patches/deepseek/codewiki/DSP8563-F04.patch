+            using sorted keys and compact comma/colon separators.
+            """
+            canonical_args = self._canonicalize_value(self.args)
+            obj = {"name": self.name, "args": canonical_args}
+            json_str = json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+            return hashlib.sha256(json_str.encode("utf-8")).hexdigest()
