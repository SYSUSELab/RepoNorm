+    def _reset_active_stream_stats(self):
+        """Reset all counters and timestamps for the active stream."""
+        self._chunk_count = 0
+        self._char_count = 0
+        self._first_ts = None
+        self._last_ts = None
+
+    def _record_emission(self, chunk: str):
+        """Record metrics for an emitted chunk."""
+        self._chunk_count += 1
+        self._char_count += len(chunk)
+        now = time.time()
+        if self._first_ts is None:
+            self._first_ts = now
+        self._last_ts = now
+
+    def stats(self) -> dict:
+        """Return a serialization-friendly dictionary with metrics for the currently active field stream.
+
+        Returns:
+            A dictionary with the following keys:
+            - predict_name: The name of the predictor, or None.
+            - field: The name of the field being listened to.
+            - chunk_count: Number of chunks emitted so far (0 if no active stream).
+            - char_count: Total characters emitted (0 if no active stream).
+            - first_ts: Timestamp of first emission in seconds (None if no active stream).
+            - last_ts: Timestamp of last emission in seconds (None if no active stream).
+            - duration_s: Difference between last_ts and first_ts in seconds (None if no active stream).
+            - avg_chunk_chars: Average chunk character count (0 if no active stream).
+        """
+        if self._chunk_count == 0:
+            avg_chunk_chars = 0.0
+        else:
+            avg_chunk_chars = self._char_count / self._chunk_count
+
+        duration_s = None
+        if self._first_ts is not None and self._last_ts is not None:
+            duration_s = self._last_ts - self._first_ts
+
+        return {
+            "predict_name": self.predict_name,
+            "field": self.signature_field_name,
+            "chunk_count": self._chunk_count,
+            "char_count": self._char_count,
+            "first_ts": self._first_ts,
+            "last_ts": self._last_ts,
+            "duration_s": duration_s,
+            "avg_chunk_chars": avg_chunk_chars,
+        }
+
