+# ---- Priority gettext/ngettext helpers ----
+
+
+@pass_context
+def _priority_gettext_impl(
+    __context: Context, __message: str, __max_level: int
+) -> str:
+    """Priority gettext for old style (no formatting)."""
+    priority_func = __context.resolve("priority_gettext")
+    if isinstance(priority_func, Undefined):
+        gettext = __context.resolve("gettext")
+        return __context.call(gettext, __message)
+    try:
+        max_level = int(__max_level)
+    except (ValueError, TypeError):
+        max_level = 0
+    if max_level < 0:
+        max_level = 0
+    max_level = min(max_level, 9)
+    for level in range(max_level + 1):
+        rv = __context.call(priority_func, __message, level)
+        if rv != __message:
+            return rv
+    return __message
+
+
+@pass_context
+def _priority_ngettext_impl(
+    __context: Context,
+    __singular: str,
+    __plural: str,
+    __num: int,
+    __max_level: int,
+) -> str:
+    """Priority ngettext for old style (no formatting)."""
+    priority_func = __context.resolve("priority_ngettext")
+    if isinstance(priority_func, Undefined):
+        ngettext = __context.resolve("ngettext")
+        return __context.call(ngettext, __singular, __plural, __num)
+    try:
+        max_level = int(__max_level)
+    except (ValueError, TypeError):
+        max_level = 0
+    if max_level < 0:
+        max_level = 0
+    max_level = min(max_level, 9)
+    for level in range(max_level + 1):
+        rv = __context.call(priority_func, __singular, __plural, __num, level)
+        plural_used = __plural if __num != 1 else __singular
+        if rv != plural_used:
+            return rv
+    return __singular if __num == 1 else __plural
+
+
+@pass_context
+def _priority_gettext_newstyle_impl(
+    __context: Context,
+    __message: str,
+    __max_level: int,
+    **variables: t.Any,
+) -> str:
+    """Priority gettext for new style (handles formatting and autoescape)."""
+    priority_func = __context.resolve("priority_gettext")
+    if isinstance(priority_func, Undefined):
+        gettext = __context.resolve("gettext")
+        rv = __context.call(gettext, __message)
+    else:
+        try:
+            max_level = int(__max_level)
+        except (ValueError, TypeError):
+            max_level = 0
+        if max_level < 0:
+            max_level = 0
+        max_level = min(max_level, 9)
+        for level in range(max_level + 1):
+            rv = __context.call(priority_func, __message, level)
+            if rv != __message:
+                break
+        else:
+            rv = __message
+    if __context.eval_ctx.autoescape:
+        rv = Markup(rv)
+    return rv % variables  # type: ignore
+
+
+@pass_context
+def _priority_ngettext_newstyle_impl(
+    __context: Context,
+    __singular: str,
+    __plural: str,
+    __num: int,
+    __max_level: int,
+    **variables: t.Any,
+) -> str:
+    """Priority ngettext for new style (handles formatting and autoescape)."""
+    variables.setdefault("num", __num)
+    priority_func = __context.resolve("priority_ngettext")
+    if isinstance(priority_func, Undefined):
+        ngettext = __context.resolve("ngettext")
+        rv = __context.call(ngettext, __singular, __plural, __num)
+    else:
+        try:
+            max_level = int(__max_level)
+        except (ValueError, TypeError):
+            max_level = 0
+        if max_level < 0:
+            max_level = 0
+        max_level = min(max_level, 9)
+        plural_used = __plural if __num != 1 else __singular
+        for level in range(max_level + 1):
+            rv = __context.call(priority_func, __singular, __plural, __num, level)
+            if rv != plural_used:
+                break
+        else:
+            rv = plural_used
+    if __context.eval_ctx.autoescape:
+        rv = Markup(rv)
+    return rv % variables  # type: ignore
+
+
 
