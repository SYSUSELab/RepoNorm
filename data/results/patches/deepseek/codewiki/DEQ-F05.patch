+# IsPhoneNumber tests
+
+@pytest.mark.parametrize(
+    'value,validator',
+    [
+        # Generic validator (no country)
+        ('555-123-4567', IsPhoneNumber()),
+        ('+1-555-123-4567', IsPhoneNumber()),
+        ('+44 20 7946 0958', IsPhoneNumber()),
+        ('020 7946 0958', IsPhoneNumber()),
+        ('+123456789', IsPhoneNumber()),
+        ('1234567', IsPhoneNumber()),
+        ('123456789012345', IsPhoneNumber()),
+        ('+12345678', IsPhoneNumber()),
+        ('+1234567890123456789', IsPhoneNumber()),
+        # US country-specific
+        ('555-123-4567', IsPhoneNumber('US')),
+        ('+1-555-123-4567', IsPhoneNumber('US')),
+        ('555.123.4567', IsPhoneNumber('US')),
+        ('(555) 123-4567', IsPhoneNumber('US')),
+        # GB country-specific
+        ('020 7946 0958', IsPhoneNumber('GB')),
+        ('+44 20 7946 0958', IsPhoneNumber('GB')),
+        ('01632 960 001', IsPhoneNumber('GB')),
+        ('+44 1632 960 001', IsPhoneNumber('GB')),
+        # GB with 11 digits (starting with 0)
+        ('0117 496 0958', IsPhoneNumber('GB')),
+        # Case insensitivity
+        ('+44 20 7946 0958', IsPhoneNumber('gb')),
+        # Unknown country (generic rules)
+        ('+49 30 1234 5678', IsPhoneNumber('DE')),
+        ('030 1234 5678', IsPhoneNumber('DE')),
+        ('+33 1 23 45 67 89', IsPhoneNumber('FR')),
+    ],
+)
+def test_is_phone_number_true(value, validator):
+    assert value == validator
+
+
+@pytest.mark.parametrize(
+    'value,validator',
+    [
+        # Non-string inputs
+        (123, IsPhoneNumber()),
+        (123.45, IsPhoneNumber()),
+        ([1, 2, 3], IsPhoneNumber()),
+        (None, IsPhoneNumber()),
+        (True, IsPhoneNumber()),
+        # Empty/invalid strings
+        ('', IsPhoneNumber()),
+        ('+', IsPhoneNumber()),
+        ('abc', IsPhoneNumber()),
+        ('12+345', IsPhoneNumber()),
+        ('++12345', IsPhoneNumber()),
+        # Newlines and other invalid whitespace
+        ('123\n456', IsPhoneNumber()),
+        ('123\r456', IsPhoneNumber()),
+        ('123\x0c456', IsPhoneNumber()),
+        ('123\x0b456', IsPhoneNumber()),
+        # Non-ASCII characters
+        ('\u06611234567', IsPhoneNumber()),
+        # Parentheses without digits
+        ('()', IsPhoneNumber()),
+        ('(-)', IsPhoneNumber()),
+        # Nested parentheses
+        ('((555) 123) 4567', IsPhoneNumber()),
+        ('555 (123 (456))', IsPhoneNumber()),
+        ('((12))', IsPhoneNumber()),
+        # Wrong lengths
+        ('123456', IsPhoneNumber()),  # too short for generic national (min 7)
+        ('+1234567', IsPhoneNumber()),  # too short for generic intl (min 8)
+        ('1234567890123456', IsPhoneNumber()),  # too long for generic national (max 15)
+        ('+12345678901234567890', IsPhoneNumber()),  # too long for generic intl (max 19)
+        # US-specific rejections
+        ('020 7946 0958', IsPhoneNumber('US')),  # starts with 0
+        ('+44 20 7946 0958', IsPhoneNumber('US')),  # +44 not valid for US
+        ('555-123-45678', IsPhoneNumber('US')),  # 11 digits no country code
+        ('+1-555-123-4567', IsPhoneNumber('GB')),  # +1 not valid for GB
+        # GB-specific rejections
+        ('555-123-4567', IsPhoneNumber('GB')),  # doesn't start with 0 for national
+        ('+1-555-123-4567', IsPhoneNumber('GB')),  # wrong country code
+        # Non-string type for country-specific
+        (123, IsPhoneNumber('US')),
+        (None, IsPhoneNumber('GB')),
+    ],
+)
+def test_is_phone_number_false(value, validator):
+    assert value != validator
+
+
+def test_is_phone_number_repr():
+    assert repr(IsPhoneNumber()) == 'IsPhoneNumber(*)'
+    assert repr(IsPhoneNumber('US')) == "IsPhoneNumber('US')"
+    assert repr(IsPhoneNumber('GB')) == "IsPhoneNumber('GB')"
+    assert repr(IsPhoneNumber('gb')) == "IsPhoneNumber('gb')"
+
+
+def test_is_phone_number_case_insensitive():
+    assert IsPhoneNumber('gb').country == 'GB'
+    assert IsPhoneNumber('us').country == 'US'
+    assert IsPhoneNumber('Gb').country == 'GB'
+    assert IsPhoneNumber('Us').country == 'US'
