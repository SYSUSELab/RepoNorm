+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+SUPPORTED_COUNTRIES = frozenset({'US', 'GB'})
+
+
+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid phone number, optionally
+    with country-specific formatting checks.
+
+    The validator only accepts string inputs. It performs syntactic validation
+    (not real number allocation checks), accepting ASCII digits, spaces/tabs,
+    dashes, dots, and balanced, non-nested parentheses containing digits.
+    At most one plus sign is allowed, at the start of the input.
+
+    Examples:
+    ```py title="IsPhoneNumber"
+    from dirty_equals import IsPhoneNumber
+
+    # Generic validation (no country)
+    assert '+1-555-123-4567' == IsPhoneNumber()
+    assert '555-123-4567' == IsPhoneNumber()
+    assert 123 != IsPhoneNumber()
+
+    # US-specific validation
+    assert '555-123-4567' == IsPhoneNumber('US')
+    assert '+1-555-123-4567' == IsPhoneNumber('US')
+
+    # GB-specific validation
+    assert '020 7946 0958' == IsPhoneNumber('GB')
+    assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+    ```
+    """
+
+    def __init__(self, country: Optional[str] = None):
+        """
+        Args:
+            country: Optional country code (e.g. 'US', 'GB') for country-specific
+                validation. Country codes are matched case-insensitively.
+                If omitted, generic validation is used.
+        """
+        if country is not None:
+            self.country = country.upper()
+            super().__init__(country)
+        else:
+            self.country = None
+            super().__init__(plain_repr('*'))
+
+    @staticmethod
+    def _validate_syntax(value: str) -> bool:
+        """
+        Validate the syntax of a phone number string.
+
+        Checks:
+        - Only ASCII digits, spaces/tabs, dashes, dots, parentheses
+        - At most one plus, at the start
+        - No newlines or other invalid characters
+        - Balanced, non-nested parentheses containing digits
+        """
+        # Check for newlines and carriage returns
+        if '\n' in value or '\r' in value:
+            return False
+
+        # Only ASCII digits, spaces/tabs, dashes, dots, parentheses,
+        # and optional leading +
+        if not re.match(r'^\+?[0-9 \t\-\.\(\)]+$', value):
+            return False
+
+        # At most one +, must be at start
+        plus_count = value.count('+')
+        if plus_count > 1:
+            return False
+        if plus_count == 1 and not value.startswith('+'):
+            return False
+
+        # Check parentheses are balanced and non-nested
+        depth = 0
+        for ch in value:
+            if ch == '(':
+                if depth > 0:
+                    # Nested parentheses not allowed
+                    return False
+                depth += 1
+            elif ch == ')':
+                depth -= 1
+                if depth < 0:
+                    # Unmatched closing parenthesis
+                    return False
+
+        if depth != 0:
+            # Unmatched opening parenthesis
+            return False
+
+        # Check parentheses contain at least one digit
+        paren_contents = re.findall(r'\(([^)]*)\)', value)
+        for content in paren_contents:
+            if not re.search(r'\d', content):
+                return False
+
+        return True
+
+    @staticmethod
+    def _strip_separators(value: str) -> str:
+        """Remove all separator characters (spaces, tabs, dashes, dots, parentheses)."""
+        return re.sub(r'[ \t\-\.\(\)]', '', value)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Validate syntax
+        if not self._validate_syntax(other):
+            return False
+
+        # Strip all separators
+        stripped = self._strip_separators(other)
+
+        # After stripping, we should have either:
+        # - Just digits (national format)
+        # - '+' followed by digits (international format)
+        if stripped.startswith('+'):
+            # International format
+            digits = stripped[1:]
+            if not digits.isdigit():
+                return False
+
+            if self.country == 'US':
+                # +1 followed by exactly 10 digits
+                if not digits.startswith('1'):
+                    return False
+                if len(digits) != 11:  # 1 + 10 = 11
+                    return False
+                return True
+            elif self.country == 'GB':
+                # +44 followed by 10-11 digits
+                if not digits.startswith('44'):
+                    return False
+                remaining = digits[2:]
+                if len(remaining) < 10 or len(remaining) > 11:
+                    return False
+                return True
+            else:
+                # Generic international: + followed by 8-19 digits
+                if len(digits) < 8 or len(digits) > 19:
+                    return False
+                return True
+        else:
+            # National format
+            if not stripped.isdigit():
+                return False
+
+            if self.country == 'US':
+                # 10-digit national format
+                if len(stripped) != 10:
+                    return False
+                return True
+            elif self.country == 'GB':
+                # 10-11 digits starting with 0
+                if not stripped.startswith('0'):
+                    return False
+                if len(stripped) < 10 or len(stripped) > 11:
+                    return False
+                return True
+            else:
+                # Generic national: 7-15 digits
+                if len(stripped) < 7 or len(stripped) > 15:
+                    return False
+                return True
