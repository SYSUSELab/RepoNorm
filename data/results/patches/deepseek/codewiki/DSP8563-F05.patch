+
+def test_from_dict_list_empty_blank_comments_no_override():
+    """Empty/blank comments do not override an explicit comment field."""
+    items = [{"name": "search", "args": {"q": "hello"}, "comment": "explicit"}]
+    tcs = ToolCalls.from_dict_list(items, comments=["  ", ""])
