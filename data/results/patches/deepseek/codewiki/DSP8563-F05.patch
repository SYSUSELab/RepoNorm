+    tcs = ToolCalls.from_dict_list(items)
+    assert len(tcs.tool_calls) == 2
+    assert tcs.tool_calls[0].note == "doc note"
+    assert tcs.tool_calls[0].tags == ["urgent"]
+    assert tcs.tool_calls[1].comment == "some comment"
+
+
+def test_from_dict_list_with_comments_parameter():
+    """from_dict_list accepts comments list and applies combined comment."""
+    items = [{"name": "search", "args": {"q": "hello"}}]
+    tcs = ToolCalls.from_dict_list(items, comments=["this is a comment", "  another comment  "])
+    assert tcs.tool_calls[0].comment == "this is a comment\nanother comment"
