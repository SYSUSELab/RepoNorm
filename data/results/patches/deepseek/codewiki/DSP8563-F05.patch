--- a/tests/adapters/test_tool.py
+++ b/tests/adapters/test_tool.py
@@ -457,3 +457,263 @@ def test_tool_calls_format_from_dict_list():
     assert len(result[0]["tool_calls"]) == 2
     assert result[0]["tool_calls"][0]["function"]["name"] == "search"
     assert result[0]["tool_calls"][1]["function"]["name"] == "translate"
+
+
+# ─── Metadata fields on ToolCall ───────────────────────────────────────────────
+
+def test_toolcall_metadata_fields():
+    """Test that metadata fields can be set via direct construction."""
+    tc = ToolCalls.ToolCall(
+        name="search", args={"q": "hello"},
+        note="test note", comment="test comment",
+        annotation="test annotation", tags=["a", "b"],
+        priority="high", meta={"key": "val"},
+    )
+    assert tc.name == "search"
+    assert tc.args == {"q": "hello"}
+    assert tc.note == "test note"
+    assert tc.comment == "test comment"
+    assert tc.annotation == "test annotation"
+    assert tc.tags == ["a", "b"]
+    assert tc.priority == "high"
+    assert tc.meta == {"key": "val"}
+
+
+def test_toolcall_unknown_fields_ignored():
+    """Unknown fields should be silently ignored (model_config.extra = 'ignore')."""
+    tc = ToolCalls.ToolCall(name="search", args={"q": "hello"}, unknown_field="should_be_ignored")
+    assert tc.name == "search"
+    assert tc.args == {"q": "hello"}
+    assert not hasattr(tc, "unknown_field")
+
+
+# ─── format() must NOT include metadata ───────────────────────────────────────
+
+def test_tool_calls_format_excludes_metadata():
+    """format() keeps only type/function fields, no metadata."""
+    tc = ToolCalls.ToolCall(name="search", args={"q": "hello"}, note="secret")
+    tcs = ToolCalls(tool_calls=[tc])
+    fmt = tcs.format()
+    assert fmt[0]["type"] == "tool_calls"
+    assert fmt[0]["tool_calls"][0]["type"] == "function"
+    assert fmt[0]["tool_calls"][0]["function"]["name"] == "search"
+    assert fmt[0]["tool_calls"][0]["function"]["arguments"] == {"q": "hello"}
+    assert "note" not in fmt[0]["tool_calls"][0]
+
+
+# ─── format_with_metadata() ───────────────────────────────────────────────────
+
+def test_format_with_metadata_includes_non_none():
+    """format_with_metadata() includes non-None metadata beside type/function."""
+    tc = ToolCalls.ToolCall(name="search", args={"q": "hello"}, note="my note", comment="my comment")
+    tcs = ToolCalls(tool_calls=[tc])
+    fmt_md = tcs.format_with_metadata()
+    assert fmt_md[0]["type"] == "tool_calls"
+    assert fmt_md[0]["tool_calls"][0]["type"] == "function"
+    assert fmt_md[0]["tool_calls"][0]["function"]["name"] == "search"
+    assert fmt_md[0]["tool_calls"][0]["function"]["arguments"] == {"q": "hello"}
+    assert fmt_md[0]["tool_calls"][0]["note"] == "my note"
+    assert fmt_md[0]["tool_calls"][0]["comment"] == "my comment"
+
+
+def test_format_with_metadata_omits_none():
+    """format_with_metadata() omits metadata fields that are None."""
+    tc = ToolCalls.ToolCall(name="search", args={"q": "hello"})
+    tcs = ToolCalls(tool_calls=[tc])
+    fmt_md = tcs.format_with_metadata()
+    for key in ("note", "comment", "annotation", "tags", "priority", "meta"):
+        assert key not in fmt_md[0]["tool_calls"][0]
+
+
+def test_format_with_metadata_preserves_explicit_empty_zero():
+    """Preserve explicit empty strings/lists/dicts and zero priority."""
+    tc = ToolCalls.ToolCall(
+        name="search", args={"q": "hello"},
+        tags=[], priority=0, meta={}, comment="", annotation="",
+    )
+    tcs = ToolCalls(tool_calls=[tc])
+    fmt_md = tcs.format_with_metadata()
+    assert fmt_md[0]["tool_calls"][0]["tags"] == []
+    assert fmt_md[0]["tool_calls"][0]["priority"] == 0
+    assert fmt_md[0]["tool_calls"][0]["meta"] == {}
+    assert fmt_md[0]["tool_calls"][0]["comment"] == ""
+    assert fmt_md[0]["tool_calls"][0]["annotation"] == ""
+
+
+def test_format_with_metadata_multiple_calls():
+    """Multiple tool calls each get their own metadata."""
+    tc1 = ToolCalls.ToolCall(name="search", args={"q": "hello"}, note="note1")
+    tc2 = ToolCalls.ToolCall(name="translate", args={"text": "world"}, note="note2", priority="high")
