+def truncate_description(text, max_chars):
+    """Truncate a description to fit within max_chars.
+
+    If max_chars is None, return text unchanged.
+    If max_chars is 1 (or less), return '\u2026'.
+    If len(text) <= max_chars, return text unchanged.
+
+    Otherwise, reserve one character for '\u2026' and find the last complete
+    sentence ending (. ! ?) followed by whitespace or end of string that
+    fits within max_chars - 1 characters. If found, take text up to and
+    including that ending, remove trailing whitespace, and append '\u2026'.
+    If no sentence ending fits, take a hard prefix of max_chars - 1
+    characters, remove trailing whitespace, and append '\u2026'.
+
+    Count Python string characters, not encoded bytes.
+    """
+    if max_chars is None:
+        return text
+
+    if max_chars <= 1:
+        return "\u2026"
+
+    if len(text) <= max_chars:
+        return text
+
+    # Try to find last complete sentence ending within max_chars - 1 chars
+    prefix = text[:max_chars - 1]
+
+    # Find all sentence endings (. ! ?) followed by whitespace or end of string
+    matches = list(re.finditer(r'[.!?](?:\s|$)', prefix))
+
+    if matches:
+        # Use the last match
+        last_match = matches[-1]
+        end_pos = last_match.end()
+        truncated = text[:end_pos].rstrip()
+        return truncated + "\u2026"
+    else:
+        # No complete sentence found, take hard prefix
+        truncated = prefix.rstrip()
+        return truncated + "\u2026"
