+def validate_template_path(template: str) -> None:
+    """Validate a template name for safety and correctness.
+    
+    Returns ``None`` for a valid name and raises
+    ``TemplateNotFound(template)`` when the value is ``None`` or the
+    empty string, contains a NUL byte, begins with ``/`` or ``\\``,
+    begins with an ASCII drive prefix such as ``C:``, or contains an
+    ASCII control character below code point 32 other than tab,
+    newline, or carriage return.
+    """
+    if template is None or template == "":
+        raise TemplateNotFound(template)
+    
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+    
+    if template[0] in "/\\":
+        raise TemplateNotFound(template)
+    
+    # Check for ASCII drive prefix (e.g., C:)
+    if len(template) >= 2 and template[1] == ":" and template[0].isascii() and template[0].isalpha():
+        raise TemplateNotFound(template)
+    
+    # Check for ASCII control characters below code point 32, excluding tab, newline, carriage return
+    for ch in template:
+        if ord(ch) < 32 and ch not in "\t\n\r":
+            raise TemplateNotFound(template)
+
