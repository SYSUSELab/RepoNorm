+def _make_priority_gettext(newstyle: bool) -> t.Callable[..., str]:
+    """Create a priority-aware gettext wrapper."""
+    @pass_context
+    def _priority_gettext(
+        __context: Context, __string: str, __priority: int, **variables: t.Any
+    ) -> str:
+        priority_gettext_func = __context.get("priority_gettext")
+        if priority_gettext_func is not None:
+            try:
+                max_level = min(max(int(__priority), 0), 9)
+            except (TypeError, ValueError):
+                max_level = 0
+            result: str = __string
+            for level in range(max_level + 1):
+                trans: str = __context.call(priority_gettext_func, __string, level)
+                if trans != __string:
+                    result = trans
+                    break
+            if newstyle:
+                if __context.eval_ctx.autoescape:
+                    result = t.cast(str, Markup(result))
+                return result % variables
+            return result
+        else:
+            gettext_func = __context.get("gettext")
+            return __context.call(gettext_func, __string, **variables)
+    return _priority_gettext
+
+
+def _make_priority_ngettext(newstyle: bool) -> t.Callable[..., str]:
+    """Create a priority-aware ngettext wrapper."""
+    @pass_context
+    def _priority_ngettext(
+        __context: Context,
+        __singular: str,
+        __plural: str,
+        __num: int,
+        __priority: int,
+        **variables: t.Any,
+    ) -> str:
+        priority_ngettext_func = __context.get("priority_ngettext")
+        if priority_ngettext_func is not None:
+            try:
+                max_level = min(max(int(__priority), 0), 9)
+            except (TypeError, ValueError):
+                max_level = 0
+            source: str = __singular if __num == 1 else __plural
+            result: str = source
+            for level in range(max_level + 1):
+                trans: str = __context.call(
+                    priority_ngettext_func, __singular, __plural, __num, level
+                )
+                if trans != source:
+                    result = trans
+                    break
+            if newstyle:
+                variables.setdefault("num", __num)
+                if __context.eval_ctx.autoescape:
+                    result = t.cast(str, Markup(result))
+                return result % variables
+            return result
+        else:
+            ngettext_func = __context.get("ngettext")
+            return __context.call(ngettext_func, __singular, __plural, __num, **variables)
+    return _priority_ngettext
+
