+class TestPriorityInternationalization:
+    """Tests for priority-based gettext/ngettext fallback."""
+
+    def _make_trans_env(self, priority_gettext=None, priority_ngettext=None):
+        """Helper to create an env with priority callables installed."""
+        from jinja2 import Environment
+        from jinja2.ext import InternationalizationExtension
+
+        def dummy_gettext(message):
+            return message
+
+        def dummy_ngettext(singular, plural, n):
+            return singular if n == 1 else plural
+
+        env = Environment(extensions=[InternationalizationExtension])
+        env.install_gettext_callables(
+            gettext=dummy_gettext,
+            ngettext=dummy_ngettext,
+            priority_gettext=priority_gettext,
+            priority_ngettext=priority_ngettext,
+        )
+        return env
+
+    def test_priority_singular(self):
+        """Test priority works with singular messages."""
+        def priority_gettext(message, level):
+            translations = {
+                "Hello": {0: "Hello", 1: "Salut", 2: "Ciao"},
+            }
+            return translations.get(message, {}).get(level, message)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=1 %}Hello{% endtrans %}")
+        # Level 0 returns same as source (miss), so level 1 is tried.
+        assert tmpl.render() == "Salut"
+
+    def test_priority_zero(self):
+        """Test priority=0 tries only level 0."""
+        def priority_gettext(message, level):
+            translations = {"Hello": {0: "Hallo"}}
+            return translations.get(message, {}).get(level, message)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=0 %}Hello{% endtrans %}")
+        assert tmpl.render() == "Hallo"
+
+    def test_priority_negative_clamped(self):
+        """Test negative priority acts as 0."""
+        def priority_gettext(message, level):
+            translations = {"Hello": {0: "Hallo"}}
+            return translations.get(message, {}).get(level, message)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=-1 %}Hello{% endtrans %}")
+        assert tmpl.render() == "Hallo"
+
+    def test_priority_invalid(self):
+        """Test non-numeric priority defaults to 0."""
+        def priority_gettext(message, level):
+            translations = {"Hello": {0: "Hallo"}}
+            return translations.get(message, {}).get(level, message)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=none_val %}Hello{% endtrans %}")
+        assert tmpl.render(none_val=None) == "Hallo"
+
+    def test_priority_miss_at_level_zero(self):
+        """Test that equal-to-source result is a miss; tries next level."""
+        def priority_gettext(message, level):
+            # level 0 returns same string (miss), level 1 returns different
+            translations = {"Hello": {0: "Hello", 1: "Salut"}}
+            return translations.get(message, {}).get(level, message)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=1 %}Hello{% endtrans %}")
+        assert tmpl.render() == "Salut"
+
+    def test_priority_all_miss(self):
+        """Test that if all levels return source message, source is used."""
+        def priority_gettext(message, level):
+            return message  # always returns same (miss)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=5 %}Hello{% endtrans %}")
+        assert tmpl.render() == "Hello"
+
+    def test_priority_plural(self):
+        """Test priority works with plural messages."""
+        def priority_ngettext(singular, plural, n, level):
+            translations = {
+                ("Item", "Items"): {0: ("Gegenstand", "Gegenstände")},
+            }
+            trans = translations.get((singular, plural), {})
+            if level in trans:
+                return trans[level][0] if n == 1 else trans[level][1]
+            return singular if n == 1 else plural
+
+        env = self._make_trans_env(
+            priority_gettext=None,
+            priority_ngettext=priority_ngettext,
+        )
+        tmpl = env.from_string(
+            "{% trans priority=0 count=n %}Item{% pluralize %}Items{% endtrans %}"
+        )
+        assert tmpl.render(n=1) == "Gegenstand"
+        assert tmpl.render(n=5) == "Gegenstände"
+
+    def test_priority_duplicate_error(self):
+        """Test that duplicate priority raises TemplateAssertionError."""
+        from jinja2 import Environment, TemplateAssertionError
+        from jinja2.ext import InternationalizationExtension
+
+        env = Environment(extensions=[InternationalizationExtension])
+        try:
+            env.from_string("{% trans priority=1 priority=2 %}Hello{% endtrans %}")
+            assert False, "Should have raised TemplateAssertionError"
+        except TemplateAssertionError:
+            pass
+
+    def test_priority_with_variable(self):
+        """Test priority works with variables."""
+        # Level 0 returns same as source (miss), so level 1 is tried.
+        def priority_gettext(message, level):
+            translations = {
+                "Hello %(name)s": {0: "Hello %(name)s", 1: "Salut %(name)s"},
+            }
+            return translations.get(message, {}).get(level, message)
+
+        env = self._make_trans_env(priority_gettext=priority_gettext)
+        tmpl = env.from_string("{% trans priority=1 %}Hello {{ name }}{% endtrans %}")
+        assert tmpl.render(name="World") == "Salut World"
+
