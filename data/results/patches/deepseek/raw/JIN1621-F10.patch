     #: .. versionadded:: 2.4
     has_source_access = True
 
+    #: Mapping of aliases (alias -> target).
+    #: .. versionadded:: 3.0
+    _aliases: t.Dict[str, str] = {}
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Add an alias that maps *alias* to *target*. If the alias
+        already exists, it is overwritten. Cache entries for the
+        alias are invalidated in all environments that have loaded
+        it.
+
+        .. versionadded:: 3.0
+        """
+        if not isinstance(alias, str):
+            raise TypeError("alias must be a string")
+        if not isinstance(target, str):
+            raise TypeError("target must be a string")
+        self._aliases[alias] = target
+        self._invalidate_cache_for(alias)
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias. It is harmless to remove an alias that
+        does not exist.
+
+        .. versionadded:: 3.0
+        """
+        if alias in self._aliases:
+            del self._aliases[alias]
+            self._invalidate_cache_for(alias)
+
+    def _resolve_alias(self, name: str) -> str:
+        """Resolve a single alias step. Returns the target if *name*
+        is an alias, otherwise returns *name* unchanged.
+        """
+        # Resolve exactly one step (no chaining)
+        if name in self._aliases:
+            return self._aliases[name]
+        return name
+
+    def _invalidate_cache_for(self, alias: str) -> None:
+        """Invalidate cache entries for *alias* in all environments
+        that have used this loader."""
+        import gc
+        my_ref = weakref.ref(self)
+        for obj in gc.get_objects():
+            try:
+                obj_vars = vars(obj)
+            except TypeError:
+                continue
+            if obj_vars.get("loader") is self:
+                cache = obj_vars.get("cache")
+                if cache is not None:
+                    cache_key = (my_ref, alias)
+                    try:
+                        del cache[cache_key]
+                    except KeyError:
+                        pass
+
