+class TestAliases:
+    """Tests for loader aliases."""
+
+    def test_add_and_resolve_alias(self):
+        """Basic alias resolution."""
+        loader = BaseLoader()
+        loader.add_alias("short.html", "long_template.html")
+        # _resolve_alias should return the target for an alias
+        assert loader._resolve_alias("short.html") == "long_template.html"
+        # Non-alias names pass through unchanged
+        assert loader._resolve_alias("other.html") == "other.html"
+
+    def test_alias_overwrite(self):
+        """Adding an existing alias overwrites it."""
+        loader = BaseLoader()
+        loader.add_alias("alias", "target1")
+        assert loader._resolve_alias("alias") == "target1"
+        loader.add_alias("alias", "target2")
+        assert loader._resolve_alias("alias") == "target2"
+
+    def test_remove_alias(self):
+        """Removing an alias makes resolution return the original name."""
+        loader = BaseLoader()
+        loader.add_alias("alias", "target")
+        assert loader._resolve_alias("alias") == "target"
+        loader.remove_alias("alias")
+        assert loader._resolve_alias("alias") == "alias"
+
+    def test_remove_unknown_alias_is_harmless(self):
+        """Removing a non-existent alias does not raise."""
+        loader = BaseLoader()
+        loader.remove_alias("nonexistent")  # should not raise
+
+    def test_alias_no_chaining(self):
+        """Aliases resolve exactly once (no chaining)."""
+        loader = BaseLoader()
+        loader.add_alias("a1", "a2")
+        loader.add_alias("a2", "real_target")
+        # a1 resolves to "a2", not to "real_target"
+        assert loader._resolve_alias("a1") == "a2"
+        assert loader._resolve_alias("a2") == "real_target"
+
+    def test_alias_non_string_raises_type_error(self):
+        """add_alias requires both arguments to be strings."""
+        loader = BaseLoader()
+        with pytest.raises(TypeError, match="alias must be a string"):
+            loader.add_alias(123, "target")
+        with pytest.raises(TypeError, match="target must be a string"):
+            loader.add_alias("alias", 456)
+
+    def test_alias_missing_target_raises_template_not_found(self, env):
+        """A missing target raises TemplateNotFound for the target name."""
+        loader = DictLoader({"real.html": "content"})
+        loader.add_alias("alias.html", "nonexistent.html")
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound, match="nonexistent.html"):
+            env.get_template("alias.html")
+
+    def test_alias_works_with_dict_loader(self, env):
+        """Alias resolves to the correct template in DictLoader."""
+        mapping = {"hello.html": "Hello {{ name }}!"}
+        loader = DictLoader(mapping)
+        loader.add_alias("hi.html", "hello.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("hi.html")
+        assert tmpl.render(name="World") == "Hello World!"
+
+    def test_alias_in_list_templates(self):
+        """list_templates includes alias when its target is present."""
+        mapping = {"hello.html": "Hello!"}
+        loader = DictLoader(mapping)
+        loader.add_alias("hi.html", "hello.html")
+        names = loader.list_templates()
+        assert "hi.html" in names
+        assert "hello.html" in names
+
+    def test_alias_not_in_list_templates_for_broken_target(self):
+        """list_templates omits alias when target is missing/broken."""
+        mapping = {"hello.html": "Hello!"}
+        loader = DictLoader(mapping)
+        loader.add_alias("broken.html", "missing.html")
+        names = loader.list_templates()
+        assert "broken.html" not in names
+
+    def test_alias_not_in_list_templates_for_chained_target(self):
+        """list_templates omits alias when target is itself an alias."""
+        mapping = {"real.html": "Hello!"}
+        loader = DictLoader(mapping)
+        loader.add_alias("mid.html", "real.html")
+        loader.add_alias("top.html", "mid.html")
+        names = loader.list_templates()
+        # top.html targets "mid.html" which is an alias, not a real template
+        assert "top.html" not in names
+        # mid.html targets "real.html" which is a real template, so it should be listed
+        assert "mid.html" in names
+
+    def test_cache_invalidation_on_add(self, env):
+        """Adding an alias invalidates the cache."""
+        mapping = {"hello.html": "Hello {{ name }}!"}
+        loader = DictLoader(mapping)
+        env = Environment(loader=loader)
+        # Load the real template so it's cached
+        tmpl1 = env.get_template("hello.html")
+        # Now add an alias for it
+        loader.add_alias("hi.html", "hello.html")
+        # The alias should resolve correctly
+        tmpl2 = env.get_template("hi.html")
+        assert tmpl2.render(name="World") == "Hello World!"
+
+    def test_cache_invalidation_on_remove(self, env):
+        """Removing an alias invalidates cache and the name reverts."""
+        mapping = {"hello.html": "Hello {{ name }}!"}
+        loader = DictLoader(mapping)
+        loader.add_alias("hi.html", "hello.html")
+        env = Environment(loader=loader)
+        # Load via alias
+        tmpl1 = env.get_template("hi.html")
+        assert tmpl1.render(name="World") == "Hello World!"
+        # Remove alias
+        loader.remove_alias("hi.html")
+        # Now "hi.html" should try to load as a real template, which doesn't exist
+        with pytest.raises(TemplateNotFound):
+            env.get_template("hi.html")
+
+    def test_alias_in_prefix_loader(self, env):
+        """Aliases work with PrefixLoader."""
+        mapping = {
+            "a": DictLoader({"hello.html": "Hello {{ name }}!"}),
+        }
+        loader = PrefixLoader(mapping)
+        loader.add_alias("b/hello.html", "a/hello.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("b/hello.html")
+        assert tmpl.render(name="World") == "Hello World!"
+
+    def test_alias_in_choice_loader(self, env):
+        """Aliases work with ChoiceLoader."""
+        loader = ChoiceLoader([
+            DictLoader({"hello.html": "Hello {{ name }}!"}),
+        ])
+        loader.add_alias("hi.html", "hello.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("hi.html")
+        assert tmpl.render(name="World") == "Hello World!"
+
+    def test_alias_in_file_system_loader(self, tmpdir):
+        """Aliases work with FileSystemLoader."""
+        p = tmpdir.mkdir("templates")
+        p.join("hello.html").write("Hello {{ name }}!")
+        loader = FileSystemLoader(str(p))
+        loader.add_alias("hi.html", "hello.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("hi.html")
+        assert tmpl.render(name="World") == "Hello World!"
+
+    def test_alias_list_templates_in_file_system_loader(self, tmpdir):
+        """list_templates includes aliases in FileSystemLoader."""
+        p = tmpdir.mkdir("templates2")
+        p.join("hello.html").write("Hello!")
+        loader = FileSystemLoader(str(p))
+        loader.add_alias("hi.html", "hello.html")
+        names = loader.list_templates()
+        assert "hi.html" in names
+        assert "hello.html" in names
+
+    def test_alias_list_templates_in_prefix_loader(self):
+        """list_templates includes aliases in PrefixLoader."""
+        mapping = {
+            "a": DictLoader({"hello.html": "Hello!"}),
+        }
+        loader = PrefixLoader(mapping)
+        loader.add_alias("b/hello.html", "a/hello.html")
+        names = loader.list_templates()
+        assert "b/hello.html" in names
+        assert "a/hello.html" in names
+
+    def test_alias_list_templates_in_choice_loader(self):
+        """list_templates includes aliases in ChoiceLoader."""
+        loader = ChoiceLoader([
+            DictLoader({"hello.html": "Hello!"}),
+        ])
+        loader.add_alias("hi.html", "hello.html")
+        names = loader.list_templates()
+        assert "hi.html" in names
+        assert "hello.html" in names
