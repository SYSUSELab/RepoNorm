+def _apply_transformers(
+    text: str,
+    transformers: Callable[[str], str] | Sequence[Callable[[str], str]] | None,
+) -> str:
+    """Apply a chain of transformers to the text."""
+    if transformers is None:
+        return text
+
+    if callable(transformers):
+        transformers = [transformers]
+
+    for transformer in transformers:
+        result = transformer(text)
+        if not isinstance(result, str):
+            raise TypeError(
+                f"Transformer {transformer!r} returned non-string type {type(result).__name__}"
+            )
+        text = result
+
+    return text
+
