diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..bab912a 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -1,3 +1,5 @@
+import time
+import warnings
 import logging
 from contextlib import contextmanager
 
@@ -543,3 +545,200 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+
+@pytest.mark.parametrize(
+    ("timeout", "expected"),
+    [
+        (None, None),
+        (5.0, 5.0),
+        (0.5, 0.5),
+        (10, 10),
+    ],
+)
+def test_cleanup_timeout_init(timeout, expected):
+    """Test that cleanup_timeout is set correctly on the context."""
+    ctx = Context(click.Command("test"), cleanup_timeout=timeout)
+    assert ctx.cleanup_timeout == expected
+
+
+def test_cleanup_timeout_inherits():
+    """Test that child inherits parent's cleanup_timeout when not set."""
+    parent = Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = Context(click.Command("child"), parent=parent)
+    assert child.cleanup_timeout == 5.0
+
+
+def test_cleanup_timeout_override():
+    """Test that child can override parent's cleanup_timeout."""
+    parent = Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = Context(click.Command("child"), parent=parent, cleanup_timeout=10.0)
+    assert child.cleanup_timeout == 10.0
+
+
+def test_cleanup_timeout_no_inherit_when_set():
+    """Test that child with None inherits parent's timeout."""
+    parent = Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = Context(click.Command("child"), parent=parent, cleanup_timeout=None)
+    assert child.cleanup_timeout == 5.0
+
+
+def test_cleanup_timeout_invalid_zero():
+    """Test that cleanup_timeout=0 raises ValueError."""
+    with pytest.raises(ValueError, match="cleanup_timeout must be positive"):
+        Context(click.Command("test"), cleanup_timeout=0)
+
+
+def test_cleanup_timeout_invalid_negative():
+    """Test that cleanup_timeout=-1 raises ValueError."""
+    with pytest.raises(ValueError, match="cleanup_timeout must be positive"):
+        Context(click.Command("test"), cleanup_timeout=-1)
+
+
+def test_cleanup_timeout_invalid_type():
+    """Test that cleanup_timeout='abc' raises TypeError."""
+    with pytest.raises(TypeError):
+        Context(click.Command("test"), cleanup_timeout="abc")
+
+
+def test_cleanup_timeout_basic_close():
+    """Test that fast cleanup runs successfully with timeout."""
+    ctx = Context(click.Command("test"), cleanup_timeout=10.0)
+    results = []
+    ctx.call_on_close(lambda: results.append("ok"))
+    ctx.close()
+    assert results == ["ok"]
+
+
+def test_cleanup_timeout_error_propagates():
+    """Test that errors before timeout propagate."""
+    ctx = Context(click.Command("test"), cleanup_timeout=10.0)
+
+    def cb():
+        raise RuntimeError("bad")
+
+    ctx.call_on_close(cb)
+    with pytest.raises(RuntimeError, match="bad"):
+        ctx.close()
+
+
+def test_cleanup_timeout_sync_no_timeout():
+    """Test that without timeout, close is synchronous and errors propagate."""
+    ctx = Context(click.Command("test"))
+    ctx.call_on_close(lambda: 1 / 0)
+    with pytest.raises(ZeroDivisionError):
+        ctx.close()
+
+
+def test_cleanup_timeout_timeout_warning():
+    """Test that a slow cleanup triggers a warning after timeout."""
+    ctx = Context(click.Command("test"), cleanup_timeout=0.05)
+
+    def cb():
+        time.sleep(1.0)
+
+    ctx.call_on_close(cb)
+    with pytest.warns(RuntimeWarning, match="still running after"):
+        ctx.close()
+
+
+def test_cleanup_timeout_error_after_timeout_warned():
+    """Test that an error raised after timeout is reported via warning, not lost."""
+    ctx = Context(click.Command("test"), cleanup_timeout=0.05)
+
+    def cb():
+        time.sleep(0.2)
+        raise RuntimeError("too-late")
+
+    ctx.call_on_close(cb)
+    with pytest.warns(RuntimeWarning) as record:
+        ctx.close()
+
+    # Wait for the delayed error
+    time.sleep(0.5)
+
+    # Next close should report it
+    with pytest.warns(RuntimeWarning, match="too-late"):
+        ctx.close()
+
+
+def test_cleanup_timeout_repeated_close():
+    """Test that repeated close does not restart a timed-out cleanup batch."""
+    ctx = Context(click.Command("test"), cleanup_timeout=0.05)
+    count = [0]
+
+    def cb():
+        count[0] += 1
+        time.sleep(5.0)
+
+    ctx.call_on_close(cb)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        ctx.close()  # times out
+    time.sleep(0.2)
+    ctx.close()  # should not restart the old batch
+    assert count[0] == 1
+
+
+def test_cleanup_timeout_new_registrations_separate():
+    """Test that registrations made during timed-out cleanup belong to next close."""
+    ctx = Context(click.Command("test"), cleanup_timeout=0.2)
+    first = []
+    second = []
+
+    def cb1():
+        first.append("a")
+        ctx.call_on_close(lambda: second.append("b"))
+
+    ctx.call_on_close(cb1)
+    ctx.close()
+    time.sleep(0.3)
+    ctx.close()
+    assert first == ["a"]
+    assert second == ["b"]
+
+
+def test_cleanup_timeout_order():
+    """Test that cleanup order is preserved within a batch."""
+    ctx = Context(click.Command("test"), cleanup_timeout=5.0)
+    order = []
+    ctx.call_on_close(lambda: order.append(1))
+    ctx.call_on_close(lambda: order.append(2))
+    ctx.call_on_close(lambda: order.append(3))
+    ctx.close()
+    assert order == [3, 2, 1], "callbacks run in LIFO order (ExitStack ordering)"
+
+
+def test_cleanup_timeout_each_once():
+    """Test that each registration is cleaned at most once."""
+    ctx = Context(click.Command("test"), cleanup_timeout=0.05)
+    count = [0]
+
+    def cb():
+        count[0] += 1
+
+    ctx.call_on_close(cb)
+    ctx.close()
+    time.sleep(0.3)
+    ctx.close()
+    assert count[0] == 1
+
+
+def test_cleanup_timeout_with_resource():
+    """Test that with_resource works correctly with cleanup_timeout."""
+    ctx = Context(click.Command("test"), cleanup_timeout=5.0)
+
+    class MyCM:
+        def __init__(self):
+            self.exited = False
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *args):
+            self.exited = True
+
+    cm = MyCM()
+    ctx.with_resource(cm)
+    ctx.close()
+    assert cm.exited
