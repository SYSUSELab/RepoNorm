+        # and the caller.
+        exc_info: list[BaseException] = []
+        timed_out = threading.Event()
+
+        def _worker() -> None:
+            try:
+                cleanup_stack.close()
+            except BaseException as e:
+                exc_info.append(e)
+
+        t = threading.Thread(target=_worker, daemon=True)
+        t.start()
+        t.join(timeout=timeout)
+
+        if t.is_alive():
