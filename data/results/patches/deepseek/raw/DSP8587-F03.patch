+    def _reset_stats(self):
+        """Reset all statistics counters and timestamps."""
+        self.chunk_count = 0
+        self.char_count = 0
+        self.first_ts = None
+        self.last_ts = None
+
+    def _update_stats(self, token: str):
+        """Update statistics for an emitted token."""
+        self.chunk_count += 1
+        self.char_count += len(token)
+        now = time.time()
+        if self.first_ts is None:
+            self.first_ts = now
+        self.last_ts = now
+
+    def stats(self):
+        """Return a serialization-friendly dictionary with metrics for the currently active field stream.
+
+        Returns:
+            A dictionary with the following keys:
+            - predict_name: The name of the predictor.
+            - field: The signature field name.
+            - chunk_count: Number of responses emitted by receive().
+            - char_count: Sum of emitted chunk lengths.
+            - first_ts: Timestamp of the first emission in seconds, or None.
+            - last_ts: Timestamp of the last emission in seconds, or None.
+            - duration_s: Difference between last_ts and first_ts, or None.
+            - avg_chunk_chars: Average characters per chunk, or zero if no emissions.
+        """
+        duration_s = None
+        avg_chunk_chars = 0
+        if self.first_ts is not None and self.last_ts is not None:
+            duration_s = self.last_ts - self.first_ts
+        if self.chunk_count > 0:
+            avg_chunk_chars = self.char_count / self.chunk_count
+        return {
+            "predict_name": self.predict_name,
+            "field": self.signature_field_name,
+            "chunk_count": self.chunk_count,
+            "char_count": self.char_count,
+            "first_ts": self.first_ts,
+            "last_ts": self.last_ts,
+            "duration_s": duration_s,
+            "avg_chunk_chars": avg_chunk_chars,
+        }
