+    You can specify a ``filter_groups`` callable to filter groups based
+    on their complete member list. The callable receives the list of
+    members in a group and returns ``True`` to retain the group or
+    ``False`` to exclude it.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", filter_groups=my_filter) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
+    If the callable is decorated with :func:`pass_environment`, the
+    active environment is passed before the member list.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
+
+    .. versionadded:: NEXT_VERSION
+        Added the ``filter_groups`` parameter.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
+    result = [
         _GroupTuple(key, list(values))
         for key, values in groupby(sorted(value, key=expr), expr)
     ]
 
+    if filter_groups is not None:
+        pass_arg = _PassArg.from_obj(filter_groups)
+
+        if pass_arg is _PassArg.environment:
+            result = [
+                group for group in result
+                if filter_groups(environment, group.list)
+            ]
+        else:
+            result = [
+                group for group in result
+                if filter_groups(group.list)
+            ]
+
+    return result
