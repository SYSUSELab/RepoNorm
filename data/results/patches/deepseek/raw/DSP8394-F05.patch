+class _CompressedDisk(Disk):
+    """Disk subclass that supports optional compression with DSPC header.
+
+    The persisted format is: b'DSPC' + codec_byte + compressed_pickle_payload.
+    Codec bytes: 0x00 = uncompressed pickle, 0x01 = gzip, 0x02 = zlib.
+    """
+
+    def __init__(self, directory, min_file_size=0, pickle_protocol=0):
+        super().__init__(directory, min_file_size, pickle_protocol)
+        self._codec = None
+
+    def store(self, value, read, key=UNKNOWN):
+        codec = self._codec
+        if codec is None:
+            return super().store(value, read, key)
+
+        # Always pickle first, then compress
+        data = pickle.dumps(value, protocol=self.pickle_protocol)
+
+        if codec == 'gzip':
+            compressed = gzip.compress(data)
+            codec_byte = b'\x01'
+        elif codec == 'zlib':
+            compressed = zlib.compress(data)
+            codec_byte = b'\x02'
+        else:
+            raise ValueError(f"Unsupported codec: {codec}")
+
+        result = b'DSPC' + codec_byte + compressed
+        return 0, MODE_RAW, None, sqlite3.Binary(result)
+
+    def fetch(self, mode, filename, value, read):
+        if mode == MODE_RAW:
+            # Convert memoryview (sqlite3.Binary) to bytes; bytes stays as-is
+            raw = bytes(value) if type(value) is sqlite3.Binary else value
+            if isinstance(raw, bytes) and raw.startswith(b'DSPC'):
+                try:
+                    codec_byte = raw[4]
+                    payload = raw[5:]
+                    if codec_byte == 0x00:
+                        decompressed = payload
+                    elif codec_byte == 0x01:
+                        decompressed = gzip.decompress(payload)
+                    elif codec_byte == 0x02:
+                        decompressed = zlib.decompress(payload)
+                    else:
+                        raise ValueError(f"Unknown codec selector: {codec_byte}")
+                    return pickle.loads(decompressed)
+                except Exception:
+                    # If anything goes wrong during decompression, fall through
+                    # to return the raw bytes as-is for backward compatibility
+                    pass
+        return super().fetch(mode, filename, value, read)
+
