+    def set_translation_version(
+        self, message: str, version: str
+    ) -> None:
+        """Set or update the version for a translation message."""
+        self.environment.translation_versions[message] = version
+
+    def get_translation_version(
+        self, message: str
+    ) -> t.Optional[str]:
+        """Get the version for a translation message, or None if unknown."""
+        return self.environment.translation_versions.get(message, None)
+
+    def compare_translation_versions(
+        self, message1: str, message2: str
+    ) -> bool:
+        """Return True only when both messages are registered and versions equal."""
+        tv = self.environment.translation_versions
+        return message1 in tv and message2 in tv and tv[message1] == tv[message2]
+
+    def remove_translation_version(
+        self, message: str
+    ) -> None:
+        """Remove a single translation version entry. Harmless if unknown."""
+        self.environment.translation_versions.pop(message, None)
+
+    def clear_translation_versions(
+        self,
+    ) -> None:
+        """Remove all translation version entries."""
+        self.environment.translation_versions.clear()
