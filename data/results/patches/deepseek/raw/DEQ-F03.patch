@@ -0,0 +1,66 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+__all__ = 'IsEmail',
+
+# Local part: ASCII letters/digits and _%+-, dots only between nonempty runs
+_local_part = r'[a-zA-Z0-9_%+-]+(?:\.[a-zA-Z0-9_%+-]+)*'
+
+# Domain labels: ASCII letters/digits and internal hyphens; nonempty
+# cannot start or end with a hyphen
+_label = r'[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?'
+
+# At least two labels, final label consists of at least two ASCII letters
+_domain = r'(?:' + _label + r'\.)+[a-zA-Z]{2,}'
+
+_EMAIL_RE = re.compile(
+    r'^' + _local_part + r'@' + _domain + r'$'
+)
+
+
+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address,
+    optionally checking the domain.
+
+    The supported grammar is deliberately finite, not full RFC email syntax.
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        """
+        Args:
+            domain: If provided, the email's domain must match this exactly
+                    (case-sensitive). Without a domain filter, any valid
+                    email address is accepted.
+
+        ```py title="IsEmail"
+        from dirty_equals import IsEmail
+
+        assert 'test@example.com' == IsEmail
+        assert 'test@example.com' == IsEmail()
+        assert 'test@example.com' == IsEmail('example.com')
+        assert 'test@other.com' != IsEmail('example.com')
+        assert 'not-an-email' != IsEmail
+        ```
+        """
+        self.domain = domain
+        super().__init__(domain if domain is not None else plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if not _EMAIL_RE.fullmatch(other):
+            return False
+
+        if self.domain is not None:
+            # Extract domain part (everything after '@')
+            at_index = other.rindex('@')
+            domain = other[at_index + 1:]
+            if domain != self.domain:
+                return False
+
+        return True
