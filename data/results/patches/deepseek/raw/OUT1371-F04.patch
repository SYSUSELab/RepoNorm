+# ============================================================
+# Built-in filter categories
+# ============================================================
+
+# --- string_utils filters ---
+
+def _upper(value):
+    return str(value).upper()
+
+def _lower(value):
+    return str(value).lower()
+
+def _title(value):
+    return str(value).title()
+
+def _reverse(value):
+    return str(value)[::-1]
+
+def _truncate(value, length, end="..."):
+    text = str(value)
+    if length < 0:
+        raise ValueError("Negative length in truncate filter")
+    if len(text) <= length:
+        return text
+    # Produce at most `length` characters by replacing the tail
+    # with as much of `end` as fits.
+    end_str = str(end)
+    if len(end_str) > length:
+        # If end is longer than length, use the truncated end
+        return end_str[:length]
+    return text[:length - len(end_str)] + end_str
+
+def _pad_left(value, width, fill=" "):
+    text = str(value)
+    if len(fill) != 1:
+        raise ValueError("fill must be exactly one character")
+    return text.rjust(width, fill)
+
+def _pad_right(value, width, fill=" "):
+    text = str(value)
+    if len(fill) != 1:
+        raise ValueError("fill must be exactly one character")
+    return text.ljust(width, fill)
+
+STRING_UTILS_FILTERS = {
+    "upper": _upper,
+    "lower": _lower,
+    "title": _title,
+    "reverse": _reverse,
+    "truncate": _truncate,
+    "pad_left": _pad_left,
+    "pad_right": _pad_right,
+}
+
+# --- math_utils filters ---
+
+def _math_add(value, other):
+    return value + other
+
+def _math_subtract(value, other):
+    return value - other
+
+def _math_multiply(value, other):
+    return value * other
+
+def _math_divide(value, other):
+    return value / other
+
+def _math_round(value, ndigits=None):
+    return round(value, ndigits)
+
+def _math_abs(value):
+    return abs(value)
+
+def _math_min(value, *others):
+    if not others:
+        return value
+    return min(value, *others)
+
+def _math_max(value, *others):
+    if not others:
+        return value
+    return max(value, *others)
+
+MATH_UTILS_FILTERS = {
+    "add": _math_add,
+    "subtract": _math_subtract,
+    "multiply": _math_multiply,
+    "divide": _math_divide,
+    "round": _math_round,
+    "abs": _math_abs,
+    "min": _math_min,
+    "max": _math_max,
+}
+
+# --- format_utils filters ---
+
+def _json(value):
+    return json.dumps(value)
+
+def _csv(value):
+    output = io.StringIO()
+    writer = csv_module.writer(output)
+    writer.writerow(value)
+    return output.getvalue().rstrip("\r\n")
+
+def _indent(value, width=4):
+    lines = str(value).split("\n")
+    indented = []
+    for line in lines:
+        if line.strip():
+            indented.append(" " * width + line)
+        else:
+            indented.append(line)
+    return "\n".join(indented)
+
+def _wrap(value, width=70):
+    return textwrap.fill(str(value), width=width)
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+def _unescape(value):
+    return html.unescape(str(value))
+
+FORMAT_UTILS_FILTERS = {
+    "json": _json,
+    "csv": _csv,
+    "indent": _indent,
+    "wrap": _wrap,
+    "escape": _escape,
+    "unescape": _unescape,
+}
+
+# Mapping from category name to filter dict
+BUILTIN_FILTER_CATEGORIES = {
+    "string_utils": STRING_UTILS_FILTERS,
+    "math_utils": MATH_UTILS_FILTERS,
+    "format_utils": FORMAT_UTILS_FILTERS,
+}
+
+
+def _get_builtin_filters(builtin_filters=None):
+    """Get the filter dicts for the given category names.
+    
+    Parameters
+    ----------
+    builtin_filters : list of str or None
+        List of category names. None or empty list returns empty dict.
+        
+    Returns
+    -------
+    dict
+        Combined filter name -> function mapping.
+    """
+    if builtin_filters is None:
+        return {}
+    
+    result = {}
+    for category in builtin_filters:
+        if not category:
+            raise ValueError(f"Unknown builtin filter category: {category!r}")
+        if category not in BUILTIN_FILTER_CATEGORIES:
+            raise ValueError(f"Unknown builtin filter category: {category!r}")
+        result.update(BUILTIN_FILTER_CATEGORIES[category])
+    return result
+
+
+def _build_env(builtin_filters=None):
+    """Create a Jinja2 environment with the appropriate filters."""
+    env = jinja2.Environment(
+        trim_blocks=True,
+        lstrip_blocks=True,
+        keep_trailing_newline=True,
+        undefined=jinja2.StrictUndefined,
+    )
+    # Add Outlines-specific filters
+    env.filters["name"] = get_fn_name
+    env.filters["description"] = get_fn_description
+    env.filters["source"] = get_fn_source
+    env.filters["signature"] = get_fn_signature
+    env.filters["schema"] = get_schema
+    env.filters["args"] = get_fn_args
+    
+    # Add built-in filter categories
+    builtin = _get_builtin_filters(builtin_filters)
+    env.filters.update(builtin)
+    
+    return env
+
