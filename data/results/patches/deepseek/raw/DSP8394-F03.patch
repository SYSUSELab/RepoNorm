+def set_ttl(seconds: Optional[float] = None) -> None:
+    """Set the TTL (time-to-live) for new cache entries on the active global DSPy cache.
+
+    Changes the lifetime used by subsequent writes without clearing entries,
+    extending their existing deadlines, or changing the active cache's enabled layers,
+    location or capacity. Setting it back to None makes new writes nonexpiring;
+    already expiring entries still expire.
+
+    Args:
+        seconds: Time-to-live in seconds for new cache entries. None means no expiration.
+                 Must be a positive finite number.
+
+    Raises:
+        ValueError: If the TTL is invalid (zero, negative, nonfinite, boolean, or nonnumeric).
+    """
+    import dspy
+
+    _validate_ttl(seconds)
+    dspy.cache.ttl = seconds
+
