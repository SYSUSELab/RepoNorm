+    @staticmethod
+    def _validate_expr(
+        var_name: str, expr: nodes.Expr, lineno: int
+    ) -> None:
+        """Validate that an expression assigned to a trans variable
+        consists only of allowed node types: constants, names,
+        attribute access, filters, tests, or calls whose callee is
+        a simple name. Arguments and keyword values must follow
+        the same rule; dynamic *args and **kwargs are rejected.
+        """
+        _valid_expr_nodes = (
+            nodes.Name,
+            nodes.Const,
+            nodes.Getattr,
+            nodes.Filter,
+            nodes.Test,
+        )
+
+        def _check(node: nodes.Expr, desc: str = "") -> None:
+            if isinstance(node, _valid_expr_nodes):
+                return
+            if isinstance(node, nodes.Call):
+                # callee must be a simple name
+                if not isinstance(node.node, nodes.Name):
+                    raise TemplateSyntaxError(
+                        'translation variable "'
+                        + var_name
+                        + '": '
+                        "only simple function names are allowed for "
+                        "function calls, got "
+                        + type(node.node).__name__
+                        + '. "'
+                        + var_name
+                        + '" includes template data and '
+                        "translation contexts.",
+                        lineno,
+                    )
+                # no dynamic args/kwargs
+                if node.dyn_args is not None:
+                    raise TemplateSyntaxError(
+                        'translation variable "'
+                        + var_name
+                        + '": '
+                        "*args is not allowed. "
+                        '"'
+                        + var_name
+                        + '" includes '
+                        "template data and translation contexts.",
+                        lineno,
+                    )
+                if node.dyn_kwargs is not None:
+                    raise TemplateSyntaxError(
+                        'translation variable "'
+                        + var_name
+                        + '": '
+                        "**kwargs is not allowed. "
+                        '"'
+                        + var_name
+                        + '" includes '
+                        "template data and translation contexts.",
+                        lineno,
+                    )
+                # validate args
+                for arg in node.args:
+                    _check(arg, 'argument of "' + var_name + '"')
+                # validate kwargs
+                for kwarg in node.kwargs:
+                    _check(kwarg.key, 'keyword name of "' + var_name + '"')
+                    _check(kwarg.value, 'keyword value of "' + var_name + '"')
+                return
+            raise TemplateSyntaxError(
+                'translation variable "'
+                + var_name
+                + '": '
+                "only simple expressions (constants, names, attribute "
+                "access, filters, tests, and function calls with simple "
+                "names) are allowed, got "
+                + type(node).__name__
+                + '. "'
+                + var_name
+                + '" includes template data and '
+                "translation contexts.",
+                lineno,
+            )
+
+        _check(expr)
+
+    @staticmethod
+    def _validate_variable_name(name: str, lineno: int) -> None:
+        """Validate that a trans variable name does not conflict
+        with translation function names.
+        """
+        if name in GETTEXT_RESERVED_NAMES:
+            raise TemplateSyntaxError(
+                'translatable variable "'
+                + name
+                + '" conflicts with '
+                "translation function names.",
+                lineno,
+            )
+
