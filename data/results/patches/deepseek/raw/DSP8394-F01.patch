+class _CacheBypass:
+    """Context manager that temporarily bypasses cache reads on a specific Cache instance.
+
+    Within the context, ``cache.get()`` behaves as a cache miss even when a value
+    is stored.  Writes via ``cache.put()`` remain enabled.  After the context ends,
+    newly written values can be read normally.
+
+    Nested contexts are supported via a counter: the outermost exit restores the
+    previous state.  Normal and exceptional exits both restore the state.
+    """
+
+    def __init__(self, cache: "Cache") -> None:
+        self._cache = cache
+        self._previous_count: Optional[int] = None
+
+    def __enter__(self) -> "_CacheBypass":
+        state = dict(Cache._bypass_state.get())
+        self._previous_count = state.get(self._cache._cache_id, 0)
+        state[self._cache._cache_id] = self._previous_count + 1
+        Cache._bypass_state.set(state)
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb) -> None:
+        state = dict(Cache._bypass_state.get())
+        state[self._cache._cache_id] = self._previous_count
+        Cache._bypass_state.set(state)
+
+
