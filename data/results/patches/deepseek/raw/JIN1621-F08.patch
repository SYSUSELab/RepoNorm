diff --git a/test_filters.py b/test_filters.py
new file mode 100644
index 0000000..d0215f6
--- /dev/null
+++ b/test_filters.py
@@ -0,0 +1,303 @@
+"""Test script for filter functionality."""
+
+import re
+import pytest
+from jinja2 import Environment
+from jinja2 import loaders
+
+
+def test_add_filter_string():
+    """String patterns use case-sensitive glob matching."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+        "contact.html": "contact",
+    })
+    
+    # All templates visible
+    assert "index.html" in loader.list_templates()
+    assert "about.html" in loader.list_templates()
+    assert "contact.html" in loader.list_templates()
+    
+    # Add filter for index
+    loader.add_filter("index*")
+    
+    templates = loader.list_templates()
+    assert "index.html" not in templates, "index.html should be filtered out"
+    assert "about.html" in templates
+    assert "contact.html" in templates
+    
+    # Can still load directly
+    env = Environment(loader=loader)
+    tmpl = env.get_template("index.html")
+    assert tmpl.render() == "index"
+
+
+def test_add_filter_regex():
+    """Compiled regex patterns use search."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+        "contact.html": "contact",
+    })
+    
+    loader.add_filter(re.compile(r"\.html$"))
+    
+    templates = loader.list_templates()
+    assert len(templates) == 0, "All .html files should be filtered"
+    
+    loader.clear_filters()
+    templates = loader.list_templates()
+    assert len(templates) == 3
+
+
+def test_add_filter_callable():
+    """Callable receives template name, excludes when truthy."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+        "contact.html": "contact",
+    })
+    
+    loader.add_filter(lambda name: name.startswith("about"))
+    
+    templates = loader.list_templates()
+    assert "about.html" not in templates
+    assert "index.html" in templates
+    assert "contact.html" in templates
+
+
+def test_unsupported_type_raises_typeerror():
+    """Unsupported filter type raises TypeError."""
+    loader = loaders.DictLoader({})
+    
+    with pytest.raises(TypeError):
+        loader.add_filter(42)  # int not supported
+    
+    with pytest.raises(TypeError):
+        loader.add_filter([1, 2, 3])  # list not supported
+
+
+def test_clear_filters():
+    """clear_filters removes all filters."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+    })
+    
+    loader.add_filter("index*")
+    assert len(loader.list_templates()) == 1
+    
+    loader.clear_filters()
+    assert len(loader.list_templates()) == 2
+
+
+def test_function_loader_list_templates_unsupported():
+    """FunctionLoader should still raise TypeError for list_templates."""
+    loader = loaders.FunctionLoader(lambda name: "source")
+    
+    with pytest.raises(TypeError):
+        loader.list_templates()
+
+
+def test_module_loader_list_templates_unsupported():
+    """ModuleLoader should still raise TypeError for list_templates."""
+    import tempfile
+    loader = loaders.ModuleLoader(tempfile.gettempdir())
+    
+    with pytest.raises(TypeError):
+        loader.list_templates()
+
+
+def test_filter_scope_basic():
+    """filter_scope temporarily adds filters."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+    })
+    
+    with loader.filter_scope("index*"):
+        templates = loader.list_templates()
+        assert "index.html" not in templates
+        assert "about.html" in templates
+    
+    # After scope exit, filter is removed
+    templates = loader.list_templates()
+    assert "index.html" in templates
+    assert "about.html" in templates
+
+
+def test_filter_scope_nesting():
+    """filter_scope can be nested."""
+    loader = loaders.DictLoader({
+        "a.html": "a",
+        "b.html": "b",
+        "c.html": "c",
+    })
+    
+    with loader.filter_scope("a*"):
+        assert "a.html" not in loader.list_templates()
+        
+        with loader.filter_scope("b*"):
+            templates = loader.list_templates()
+            assert "a.html" not in templates
+            assert "b.html" not in templates
+            assert "c.html" in templates
+        
+        # Inner scope exited, outer scope still active
+        templates = loader.list_templates()
+        assert "a.html" not in templates
+        assert "b.html" in templates
+        assert "c.html" in templates
+    
+    # All filters removed
+    assert len(loader.list_templates()) == 3
+
+
+def test_filter_scope_exception_restores():
+    """Scope restores filters even if an exception occurs."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+    })
+    
+    loader.add_filter("about*")
+    assert len(loader.list_templates()) == 1
+    
+    try:
+        with loader.filter_scope("index*"):
+            assert len(loader.list_templates()) == 0
+            raise ValueError("test error")
+    except ValueError:
+        pass
+    
+    # After exception in scope, the scope's filters should be undone,
+    # but the original filter should still be in place
+    templates = loader.list_templates()
+    assert "about.html" not in templates
+    assert "index.html" in templates
+
+
+def test_prefix_loader_filters():
+    """PrefixLoader applies child filters, then its own filters to prefixed names."""
+    child1 = loaders.DictLoader({
+        "index.html": "index1",
+        "about.html": "about1",
+    })
+    child2 = loaders.DictLoader({
+        "index.html": "index2",
+        "contact.html": "contact2",
+    })
+    
+    loader = loaders.PrefixLoader({
+        "app1": child1,
+        "app2": child2,
+    })
+    
+    # All templates
+    templates = loader.list_templates()
+    assert "app1/index.html" in templates
+    assert "app1/about.html" in templates
+    assert "app2/index.html" in templates
+    assert "app2/contact.html" in templates
+    
+    # Add filter on a child
+    child1.add_filter("index*")
+    
+    templates = loader.list_templates()
+    assert "app1/index.html" not in templates
+    assert "app1/about.html" in templates
+    assert "app2/index.html" in templates
+    
+    # Add filter on the prefix loader itself
+    loader.add_filter("app2/*")
+    
+    templates = loader.list_templates()
+    assert "app1/index.html" not in templates
+    assert "app1/about.html" in templates
+    assert "app2/index.html" not in templates
+    assert "app2/contact.html" not in templates
+
+
+def test_choice_loader_filters():
+    """ChoiceLoader applies child filters, then its own filters."""
+    child1 = loaders.DictLoader({
+        "index.html": "index1",
+        "about.html": "about1",
+    })
+    child2 = loaders.DictLoader({
+        "index.html": "index2",
+        "contact.html": "contact2",
+    })
+    
+    loader = loaders.ChoiceLoader([child1, child2])
+    
+    # Add filter on child1
+    child1.add_filter("about*")
+    
+    templates = loader.list_templates()
+    assert "index.html" in templates
+    assert "about.html" not in templates  # filtered from child1
+    assert "contact.html" in templates
+    
+    # Add filter on the choice loader itself
+    loader.add_filter("contact*")
+    
+    templates = loader.list_templates()
+    assert "index.html" in templates
+    assert "about.html" not in templates
+    assert "contact.html" not in templates
+
+
+def test_environment_list_templates_filter_func():
+    """Environment.list_templates with filter_func applies one-shot filter."""
+    loader = loaders.DictLoader({
+        "index.html": "index",
+        "about.html": "about",
+        "contact.html": "contact",
+    })
+    env = Environment(loader=loader)
+    
+    # With filter_func
+    names = env.list_templates(filter_func=lambda x: x.startswith("index"))
+    assert names == ["index.html"]
+    
+    # Without filter_func, all templates
+    names = env.list_templates()
+    assert len(names) == 3
+    
+    # With persistent filter + filter_func
+    loader.add_filter("about*")
+    names = env.list_templates(filter_func=lambda x: x.endswith(".html"))
+    assert "about.html" not in names
+    assert "index.html" in names
+    assert "contact.html" in names
+
+
+if __name__ == "__main__":
+    # Run tests manually
+    test_add_filter_string()
+    print("✓ test_add_filter_string")
+    test_add_filter_regex()
+    print("✓ test_add_filter_regex")
+    test_add_filter_callable()
+    print("✓ test_add_filter_callable")
+    test_unsupported_type_raises_typeerror()
+    print("✓ test_unsupported_type_raises_typeerror")
+    test_clear_filters()
+    print("✓ test_clear_filters")
+    test_function_loader_list_templates_unsupported()
+    print("✓ test_function_loader_list_templates_unsupported")
+    test_filter_scope_basic()
+    print("✓ test_filter_scope_basic")
+    test_filter_scope_nesting()
+    print("✓ test_filter_scope_nesting")
+    test_filter_scope_exception_restores()
+    print("✓ test_filter_scope_exception_restores")
+    test_prefix_loader_filters()
+    print("✓ test_prefix_loader_filters")
+    test_choice_loader_filters()
+    print("✓ test_choice_loader_filters")
+    test_environment_list_templates_filter_func()
+    print("✓ test_environment_list_templates_filter_func")
+    print("\nAll tests passed!")
