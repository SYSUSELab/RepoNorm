+    def _normalize_filter(self, filter_pattern: t.Any) -> t.Callable[[str], bool]:
+        """Convert a filter pattern to a callable that returns True if a
+        template name should be excluded.
+        """
+        if isinstance(filter_pattern, str):
+            return lambda name: fnmatch(name, filter_pattern)
+        elif isinstance(filter_pattern, re.Pattern):
+            return lambda name: filter_pattern.search(name) is not None
+        elif callable(filter_pattern):
+            return filter_pattern
+        else:
+            raise TypeError(
+                "Filter must be a string, compiled regex, or callable, "
+                f"not {type(filter_pattern).__name__!r}."
+            )
+
+    def _filter_templates(self, names: t.List[str]) -> t.List[str]:
+        """Apply all registered filters to a list of template names.
+        Returns the filtered list with excluded names removed.
+        """
+        if not self._filters:
+            return names
+        
+        # Build callable filters from the patterns
+        filters = [self._normalize_filter(f) for f in self._filters]
+        
+        result = []
+        for name in names:
+            excluded = False
+            for filter_func in filters:
+                try:
+                    if filter_func(name):
+                        excluded = True
+                        break
+                except Exception:
+                    raise
+            if not excluded:
+                result.append(name)
+        return result
+
+    def add_filter(self, filter_pattern: t.Any) -> None:
+        """Register a filter for excluding template names from
+        :meth:`list_templates`.
+
+        A filter can be:
+
+        - A string for case-sensitive glob matching.
+        - A compiled regular expression, matched with ``search``.
+        - A callable that receives a template name and returns ``True``
+          if it should be excluded.
+
+        Unsupported types raise :exc:`TypeError`. Exceptions raised while
+        matching propagate unchanged.
+        """
+        # Validate the filter
+        self._normalize_filter(filter_pattern)
+        self._filters.append(filter_pattern)
+
+    def clear_filters(self) -> None:
+        """Remove all registered filters."""
+        self._filters.clear()
+
+    def filter_scope(self, *patterns: t.Any) -> t.Iterator[None]:
+        """A context manager that temporarily adds filters. On exit, the
+        filter configuration is restored to how it was on entry, even if
+        an exception occurs.
+
+        Scopes may nest. Filter changes made inside the scope are
+        temporary and are discarded when leaving the scope.
+
+        :param patterns: Filter patterns to add temporarily. Accepts the
+            same inputs as :meth:`add_filter`.
+        """
+        return _FilterScopeContext(self, list(patterns))
+
+
+class _FilterScopeContext:
+    """Context manager for :meth:`BaseLoader.filter_scope`."""
+
+    def __init__(self, loader: BaseLoader, patterns: t.List[t.Any]) -> None:
+        self._loader = loader
+        self._patterns = patterns
+        self._saved_filters: t.List[t.Any] = []
+
+    def __enter__(self) -> None:
+        # Save current filter state
+        self._saved_filters = list(self._loader._filters)
+        # Add new filters
+        for pattern in self._patterns:
+            self._loader.add_filter(pattern)
+
+    def __exit__(
+        self,
+        exc_type: t.Optional[t.Type[BaseException]],
+        exc_val: t.Optional[BaseException],
+        exc_tb: t.Optional[types.TracebackType],
+    ) -> None:
+        # Restore saved filter state, discarding any changes made
+        self._loader._filters = self._saved_filters
+
 
