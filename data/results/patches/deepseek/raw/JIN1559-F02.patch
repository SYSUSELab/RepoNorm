+class TestDomainInternationalization:
+    """Tests for domain support in trans blocks (old-style)."""
+
+    def test_domain_fallback(self):
+        """Domain without explicit dgettext falls back to gettext."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: "prefix: " + x,
+            lambda s, p, n: s if n == 1 else p,
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"admin\" %}hello{% endtrans %}"
+        )
+        assert tmpl.render() == "prefix: hello"
+
+    def test_domain_fallback_plural(self):
+        """Domain plural without explicit dngettext falls back to ngettext."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: x,
+            lambda s, p, n: s if n == 1 else p,
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"admin\", count=n %}{{ n }} item"
+            "{% pluralize %}{{ n }} items{% endtrans %}"
+        )
+        assert tmpl.render(n=1) == "1 item"
+        assert tmpl.render(n=2) == "2 items"
+
+    def test_domain_explicit(self):
+        """Explicit dgettext/dngettext in install_gettext_callables."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: "WRONG",
+            lambda s, p, n: "WRONG",
+            dgettext=lambda domain, msg: "[{}] {}".format(domain, msg),
+            dngettext=lambda domain, s, p, n: "[{}] {}".format(
+                domain, s if n == 1 else p
+            ),
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"app\" %}hello{% endtrans %}"
+        )
+        assert tmpl.render() == "[app] hello"
+
+    def test_domain_explicit_plural(self):
+        """Explicit dngettext in install_gettext_callables with plural."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: x,
+            lambda s, p, n: s if n == 1 else p,
+            dgettext=lambda d, m: m,
+            dngettext=lambda d, s, p, n: "[{}] {}".format(d, s if n == 1 else p),
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"app\", count=n %}{{ n }} item"
+            "{% pluralize %}{{ n }} items{% endtrans %}"
+        )
+        assert tmpl.render(n=1) == "[app] 1 item"
+        assert tmpl.render(n=2) == "[app] 2 items"
+
+    def test_domain_duplicate(self):
+        """Duplicate domain raises TemplateAssertionError."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(lambda x: x, lambda s, p, n: s)
+        with pytest.raises(TemplateAssertionError, match="defined twice"):
+            env.from_string(
+                "{% trans domain=\"admin\", domain=\"app\" %}"
+                "test{% endtrans %}"
+            )
+
+    def test_domain_not_literal(self):
+        """Non-literal domain raises TemplateAssertionError."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(lambda x: x, lambda s, p, n: s)
+        with pytest.raises(
+            TemplateAssertionError,
+            match="domain.*string.*literal",
+        ):
+            env.from_string(
+                "{% trans domain=somevar %}test{% endtrans %}"
+            )
+
+    def test_domain_with_trimmed(self):
+        """Domain combined with trimmed modifier."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: x.strip(),
+            lambda s, p, n: s.strip() if n == 1 else p.strip(),
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"admin\", trimmed %}  hello  {% endtrans %}"
+        )
+        assert tmpl.render() == "hello"
+
+    def test_domain_with_variables(self):
+        """Domain with variable interpolation."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: "{{}} {}".format(x),
+            lambda s, p, n: s if n == 1 else p,
+            newstyle=False,
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"admin\", count=n %}{{ count }} item"
+            "{% pluralize %}{{ count }} items{% endtrans %}"
+        )
+        assert tmpl.render(n=1) == "1 item"
+        assert tmpl.render(n=2) == "2 items"
+
+    def test_domain_reinstall_replaces(self):
+        """Reinstalling domain callables replaces previous behavior."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: x,
+            lambda s, p, n: s,
+            dgettext=lambda d, m: "old: " + m,
+        )
+        env.install_gettext_callables(
+            lambda x: x,
+            lambda s, p, n: s,
+            dgettext=lambda d, m: "new: " + m,
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"x\" %}test{% endtrans %}"
+        )
+        assert tmpl.render() == "new: test"
+
+    def test_domain_uninstall_removes(self):
+        """uninstall_gettext_translations removes domain globals."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: x,
+            lambda s, p, n: s,
+            dgettext=lambda d, m: m,
+        )
+        assert "dgettext" in env.globals
+        env.uninstall_gettext_translations()
+        assert "dgettext" not in env.globals
+        assert "gettext" not in env.globals
+
+    def test_domain_before_count(self):
+        """Domain before count in header."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda x: x,
+            lambda s, p, n: s if n == 1 else p,
+        )
+        tmpl = env.from_string(
+            "{% trans domain=\"admin\", count=n %}{{ n }} item"
+            "{% pluralize %}{{ n }} items{% endtrans %}"
+        )
+        assert tmpl.render(n=1) == "1 item"
+        assert tmpl.render(n=2) == "2 items"
+
