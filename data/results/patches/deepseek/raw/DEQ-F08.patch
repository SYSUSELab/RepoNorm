@@ -0,0 +1,75 @@
+import re
+from typing import Any, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+__all__ = 'IsRegex',
+
+
+class IsRegex(DirtyEquals[str]):
+    """Matches strings against regular expressions.
+
+    Examples:
+    ```py title="IsRegex"
+    from dirty_equals import IsRegex
+
+    assert 'hello' == IsRegex('hello')
+    assert 'hello world' == IsRegex(r'hello')
+    assert 'HELLO' == IsRegex('hello', flags=re.IGNORECASE)
+    assert 'hello\nworld' == IsRegex('hello.*world', flags=re.DOTALL)
+    assert 'prefix_123' == IsRegex(r'prefix_\d+')
+    ```
+    """
+
+    def __init__(self, pattern: Union[str, re.Pattern[str]], flags: int = 0, *, mode: str = 'match'):
+        if isinstance(pattern, bytes) or (isinstance(pattern, re.Pattern) and isinstance(pattern.pattern, bytes)):
+            raise TypeError('Bytes patterns are not supported by IsRegex')
+
+        valid_modes = ('match', 'search', 'fullmatch')
+        if mode not in valid_modes:
+            raise ValueError(f"Invalid mode '{mode}', must be one of {valid_modes}")
+
+        self._mode = mode
+
+        if isinstance(pattern, re.Pattern):
+            if flags != 0:
+                raise ValueError('Cannot specify flags when using a compiled pattern')
+            self._pattern = pattern.pattern
+            self._flags = pattern.flags & ~re.UNICODE & ~re.DOTALL  # hmm, let me rethink this
+            # Actually, I should just store the effective display flags
+            effective_flags = pattern.flags & ~re.UNICODE
+            self._compiled = pattern
+        else:
+            self._pattern = pattern
+            self._flags = flags
+            effective_flags = flags
+            try:
+                self._compiled = re.compile(pattern, flags)
+            except re.error:
+                raise
+
+        # Build repr args/kwargs
+        repr_args = [self._pattern]
+        repr_kwargs = {}
+
+        if effective_flags:
+            repr_kwargs['flags'] = plain_repr(repr(re.RegexFlag(effective_flags)))
+
+        if mode != 'match':
+            repr_kwargs['mode'] = mode
+
+        super().__init__(*repr_args, **repr_kwargs)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self._mode == 'match':
+            return bool(self._compiled.match(other))
+        elif self._mode == 'search':
+            return bool(self._compiled.search(other))
+        elif self._mode == 'fullmatch':
+            return bool(self._compiled.fullmatch(other))
+
+        return False
