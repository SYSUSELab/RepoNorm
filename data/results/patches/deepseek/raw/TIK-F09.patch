+def _compress_tokens(tokens: list[int]) -> list[int]:
+    """Collapse adjacent repeated token IDs into a single token ID."""
+    if not tokens:
+        return []
+    compressed = [tokens[0]]
+    for token in tokens[1:]:
+        if token != compressed[-1]:
+            compressed.append(token)
+    return compressed
+
