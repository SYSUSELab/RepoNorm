diff --git a/dirty_equals/_url.py b/dirty_equals/_url.py
new file mode 100644
index 0000000..839aed6
--- /dev/null
+++ b/dirty_equals/_url.py
@@ -0,0 +1,92 @@
+from typing import Any, Collection, Optional, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from urllib.parse import urlparse
+except ImportError:
+    from urlparse import urlparse  # type: ignore[no-redef,import]
+
+
+class IsURL(DirtyEquals[str]):
+    """
+    Validates URL structure with optional protocol and domain restrictions.
+
+    Accepts complete URLs with a protocol (scheme) and network location (netloc).
+    Rejects non-strings and incomplete URL strings.
+
+    Args:
+        protocol: Optional protocol or collection of protocols to match.
+            Can be a single string (e.g., 'https'), a collection (list, tuple, set, frozenset).
+            An empty collection allows no protocol, None disables filtering.
+        domain: Optional domain/netloc to match against the URL's complete network location,
+            including port if present.
+
+    Examples:
+    ```py title="IsURL"
+    from dirty_equals import IsURL
+
+    assert 'http://example.com' == IsURL()
+    assert 'https://example.com/path?q=1' == IsURL(protocol='https')
+    assert 'http://example.com:8080/path' == IsURL(domain='example.com:8080')
+    assert 'https://example.com' == IsURL('https', 'example.com')
+
+    assert 'not a url' != IsURL()
+    assert 123 != IsURL()
+    assert 'http://example.com' != IsURL(protocol='https')
+    assert 'https://other.com' != IsURL(domain='example.com')
+    ```
+    """
+
+    def __init__(self, protocol: Union[None, str, Collection[str]] = None, domain: Optional[str] = None):
+        """
+        Args:
+            protocol: One string or a collection of allowed protocols.
+                None disables filtering, empty collection allows no protocol.
+            domain: Expected domain/netloc including port if present.
+        """
+        self.protocol = protocol
+        self.domain = domain
+
+        # Build repr args based on what was provided
+        if protocol is None and domain is None:
+            super().__init__(plain_repr('*'))
+        elif domain is None:
+            # Only protocol specified
+            super().__init__(protocol or plain_repr('*'))
+        elif protocol is None:
+            # Only domain specified
+            super().__init__(domain)
+        else:
+            # Both specified
+            super().__init__(protocol, domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        try:
+            parsed = urlparse(other)
+        except Exception:
+            return False
+
+        # Must have a scheme and netloc to be a complete URL
+        if not parsed.scheme or not parsed.netloc:
+            return False
+
+        # Check protocol if specified
+        if self.protocol is not None:
+            if isinstance(self.protocol, str):
+                if parsed.scheme != self.protocol:
+                    return False
+            elif isinstance(self.protocol, Collection):
+                if parsed.scheme not in self.protocol:
+                    return False
+
+        # Check domain if specified (match against complete netloc)
+        if self.domain is not None:
+            if parsed.netloc != self.domain:
+                return False
+
+        return True
diff --git a/tests/test_url.py b/tests/test_url.py
new file mode 100644
index 0000000..c4fd2e6
--- /dev/null
+++ b/tests/test_url.py
@@ -0,0 +1,176 @@
+import pytest
+
+from dirty_equals import IsURL
+
+
+@pytest.mark.parametrize(
+    'url',
+    [
+        'http://example.com',
+        'https://example.com',
+        'http://example.com/path',
+        'http://example.com/path?q=1',
+        'http://example.com:8080',
+        'http://example.com:8080/path',
+        'ftp://files.example.com',
+        'https://www.example.com/path/to/resource?param=value#fragment',
+    ],
+)
+def test_is_url_any_true(url):
+    assert url == IsURL()
+    assert url == IsURL
+
+
+@pytest.mark.parametrize(
+    'value',
+    [
+        'not a url',
+        'just a string',
+        '',
+        'http://',
+        '//example.com',
+        'no-scheme.com',
+        123,
+        [1, 2, 3],
+        None,
+        True,
+    ],
+)
+def test_is_url_any_false(value):
+    assert value != IsURL()
+    assert value != IsURL
+
+
+def test_is_url_protocol_string():
+    assert 'https://example.com' == IsURL(protocol='https')
+    assert 'http://example.com' != IsURL(protocol='https')
+    assert 'ftp://example.com' != IsURL(protocol='https')
+
+
+def test_is_url_protocol_collection():
+    assert 'https://example.com' == IsURL(protocol={'http', 'https'})
+    assert 'http://example.com' == IsURL(protocol={'http', 'https'})
+    assert 'ftp://example.com' != IsURL(protocol={'http', 'https'})
+
+
+def test_is_url_protocol_list():
+    assert 'https://example.com' == IsURL(protocol=['http', 'https'])
+    assert 'ftp://example.com' != IsURL(protocol=['http', 'https'])
+
+
+def test_is_url_protocol_tuple():
+    assert 'https://example.com' == IsURL(protocol=('http', 'https'))
+    assert 'ftp://example.com' != IsURL(protocol=('http', 'https'))
+
+
+def test_is_url_protocol_frozenset():
+    assert 'https://example.com' == IsURL(protocol=frozenset({'http', 'https'}))
+    assert 'ftp://example.com' != IsURL(protocol=frozenset({'http', 'https'}))
+
+
+def test_is_url_empty_collection_allows_no_protocol():
+    """Empty collection should allow no protocol."""
+    assert 'http://example.com' != IsURL(protocol=[])
+    assert 'https://example.com' != IsURL(protocol=set())
+    assert 'ftp://example.com' != IsURL(protocol=tuple())
+
+
+def test_is_url_domain():
+    assert 'http://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com/path' == IsURL(domain='example.com')
+    assert 'http://other.com' != IsURL(domain='example.com')
+
+
+def test_is_url_domain_with_port():
+    """Domain matching should include the port."""
+    assert 'http://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'http://example.com:8080/path' == IsURL(domain='example.com:8080')
+    assert 'http://example.com' != IsURL(domain='example.com:8080')
+    assert 'http://example.com:8080' != IsURL(domain='example.com')
+
+
+def test_is_url_protocol_and_domain():
+    assert 'https://example.com' == IsURL(protocol='https', domain='example.com')
+    assert 'https://example.com/path' == IsURL(protocol='https', domain='example.com')
+    assert 'http://example.com' != IsURL(protocol='https', domain='example.com')
+    assert 'https://other.com' != IsURL(protocol='https', domain='example.com')
+
+
+def test_is_url_protocol_collection_and_domain():
+    assert 'https://example.com' == IsURL(protocol={'http', 'https'}, domain='example.com')
+    assert 'http://example.com' == IsURL(protocol={'http', 'https'}, domain='example.com')
+    assert 'ftp://example.com' != IsURL(protocol={'http', 'https'}, domain='example.com')
+    assert 'https://other.com' != IsURL(protocol={'http', 'https'}, domain='example.com')
+
+
+def test_is_url_repr_no_args():
+    is_url = IsURL()
+    with pytest.raises(AssertionError):
+        assert 'invalid' == is_url
+    assert str(is_url) == 'IsURL(*)'
+
+
+def test_is_url_repr_protocol():
+    is_url = IsURL(protocol='https')
+    with pytest.raises(AssertionError):
+        assert 'http://example.com' == is_url
+    assert str(is_url) == "IsURL('https')"
+
+
+def test_is_url_repr_domain():
+    is_url = IsURL(domain='example.com')
+    with pytest.raises(AssertionError):
+        assert 'http://other.com' == is_url
+    assert str(is_url) == "IsURL('example.com')"
+
+
+def test_is_url_repr_protocol_and_domain():
+    is_url = IsURL(protocol='https', domain='example.com')
+    with pytest.raises(AssertionError):
+        assert 'http://other.com' == is_url
+    assert str(is_url) == "IsURL('https', 'example.com')"
+
+
+def test_is_url_repr_protocol_collection():
+    is_url = IsURL(protocol={'http', 'https'})
+    with pytest.raises(AssertionError):
+        assert 'ftp://example.com' == is_url
+    # Repr of set is unordered, so just check it contains the right parts
+    repr_str = str(is_url)
+    assert repr_str.startswith('IsURL(')
+    assert repr_str.endswith(')')
+
+
+def test_is_url_with_domain_containing_port():
+    """Ensure domain matching uses full netloc including port."""
+    # With port matching
+    assert 'http://localhost:8000/api' == IsURL(domain='localhost:8000')
+    assert 'http://localhost:8000' == IsURL(domain='localhost:8000')
+    
+    # Port mismatch
+    assert 'http://localhost:9000' != IsURL(domain='localhost:8000')
+    
+    # Without port but domain specifies port
+    assert 'http://localhost' != IsURL(domain='localhost:8000')
+    
+    # Port but domain doesn't specify it
+    assert 'http://localhost:8000' != IsURL(domain='localhost')
+
+
+def test_is_url_edge_cases():
+    """Test various edge cases."""
+    # URL with user info
+    assert 'http://user:pass@example.com' == IsURL()
+    assert 'http://user:pass@example.com' == IsURL(domain='user:pass@example.com')
+    
+    # IPv4 address
+    assert 'http://127.0.0.1:8000' == IsURL()
+    assert 'http://127.0.0.1:8000' == IsURL(domain='127.0.0.1:8000')
+    
+    # IPv6 address
+    assert 'http://[::1]:8000' == IsURL()
+    assert 'http://[::1]:8000' == IsURL(domain='[::1]:8000')
+    
+    # protocol=None should be same as omitting
+    assert 'http://example.com' == IsURL(protocol=None)
+    assert 'http://example.com' == IsURL(protocol=None, domain=None)
