@@ -1157,12 +1157,45 @@ class _GroupTuple(t.NamedTuple):
         return tuple.__str__(self)
 
 
+def _groupby_with_max(
+    iterable: "t.Iterable[V]",
+    key: t.Callable,
+    max_groups: t.Optional[int] = None,
+) -> "t.List[t.Tuple[t.Any, t.List[V]]]":
+    """Like ``itertools.groupby`` but limited to a maximum number of groups.
+
+    ``max_groups`` must be ``None`` or a nonnegative integer.
+    """
+    if max_groups is not None and (isinstance(max_groups, bool) or not isinstance(max_groups, int)):
+        raise FilterArgumentError(
+            f"max_groups must be None or a nonnegative integer, "
+            f"not {type(max_groups).__name__}"
+        )
+
+    if max_groups is not None and max_groups < 0:
+        raise FilterArgumentError(
+            f"max_groups must be None or a nonnegative integer, "
+            f"not {max_groups!r}"
+        )
+
+    if max_groups is not None and max_groups == 0:
+        return []
+
+    result = []
+    for k, g in groupby(iterable, key):
+        if max_groups is not None and len(result) >= max_groups:
+            break
+        result.append((k, list(g)))
+    return result
+
+
