+            {"extensions": "jinja2.ext.ConditionalI18nExtension"}
+        ))
+        assert len(results) == 1
+        lineno, func, msg, comments = results[0]
+        assert func == "ngettext"
+        assert msg == ("%(count)s user", "%(count)s users", None)
+        # Fallback "Nobody" must NOT appear
+        assert "Nobody" not in str(results)
+
+    def test_extract_context(self):
+        from jinja2.ext import babel_extract
+        source = BytesIO(
+            b'{% ctrans True, context="Menu" %}File{% fallback %}Other{% endctrans %}'
+        )
