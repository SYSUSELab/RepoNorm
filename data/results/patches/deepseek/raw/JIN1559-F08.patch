+class TestConditionalInternationalization:
+    """Tests for ConditionalI18nExtension."""
+
+    def _make_env(self, newstyle=False):
+        env = Environment(
+            extensions=["jinja2.ext.ConditionalI18nExtension"]
+        )
+        env.globals.update({
+            "_": gettext,
+            "gettext": gettext,
+            "ngettext": ngettext,
+            "pgettext": pgettext,
+            "npgettext": npgettext,
+        })
+        if newstyle:
+            env.install_gettext_callables(
+                gettext, ngettext, newstyle=True,
+                pgettext=pgettext, npgettext=npgettext
+            )
+        return env
+
+    # --- Basic conditional behavior ---
+
+    def test_basic_condition_true(self):
+        env = self._make_env()
+        t = env.from_string("{% ctrans True %}Hello{% fallback %}World{% endctrans %}")
+        assert t.render() == "Hello"
+
+    def test_basic_condition_false(self):
+        env = self._make_env()
+        t = env.from_string("{% ctrans False %}Hello{% fallback %}World{% endctrans %}")
+        assert t.render() == "World"
+
+    def test_variable_condition(self):
+        env = self._make_env()
+        t = env.from_string("{% ctrans show_it %}Hello{% fallback %}World{% endctrans %}")
+        assert t.render(show_it=True) == "Hello"
+        assert t.render(show_it=False) == "World"
+
+    # --- Condition evaluated once ---
+
+    def test_condition_evaluated_once(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans x %}{{ x }}{% fallback %}{{ x }}{% endctrans %}"
+        )
+        # If condition is truthy, x from trans branch
+        assert t.render(x=42) == "42"
+        # If condition is falsy, x from fallback branch
+        assert t.render(x=0) == "0"
+
+    # --- Variable in true branch ---
+
+    def test_true_branch_variable(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans True, num=count %}Hello {{ num }}{% fallback %}World{% endctrans %}"
+        )
+        assert t.render(count=3) == "Hello 3"
+
+    def test_fallback_variable(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans False %}Hello{% fallback %}World {{ count }}{% endctrans %}"
+        )
+        assert t.render(count=42) == "World 42"
+
+    # --- Fallback with inner constructs ---
+
+    def test_fallback_with_if(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans False %}Hello{% fallback %}"
+            "{% if True %}Conditional Fallback{% endif %}"
+            "{% endctrans %}"
+        )
+        assert t.render() == "Conditional Fallback"
+
+    def test_fallback_with_include(self):
+        env = Environment(
+            loader=DictLoader({"inc.html": "Included"}),
+            extensions=["jinja2.ext.ConditionalI18nExtension"]
+        )
+        env.globals.update({
+            "_": gettext,
+            "gettext": gettext,
+            "ngettext": ngettext,
+        })
+        t = env.from_string(
+            "{% ctrans False %}Hello{% fallback %}{% include 'inc.html' %}{% endctrans %}"
+        )
+        assert t.render() == "Included"
+
+    def test_fallback_with_filter(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans False %}Hello{% fallback %}{{ 'world'|upper }}{% endctrans %}"
+        )
+        assert t.render() == "WORLD"
+
+    # --- Pluralization ---
+
+    def test_plural_true(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans True, num=count %}{{ count }} user{% pluralize %}"
+            "{{ count }} users{% fallback %}No users{% endctrans %}"
+        )
+        assert t.render(count=1) == "1 user"
+        assert t.render(count=5) == "5 users"
+
+    def test_plural_false(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans False, num=count %}{{ count }} user{% pluralize %}"
+            "{{ count }} users{% fallback %}No users{% endctrans %}"
+        )
+        assert t.render(count=42) == "No users"
+
+    # --- Context support ---
+
+    def test_context_true(self):
+        env = self._make_env()
+        t = env.from_string(
+            '{% ctrans True, context="Menu" %}File{% fallback %}Other{% endctrans %}'
+        )
+        # When no translation matches, the original string is used
+        assert t.render() == "File"
+
+    def test_context_false(self):
+        env = self._make_env()
+        t = env.from_string(
+            '{% ctrans False, context="Menu" %}File{% fallback %}Other{% endctrans %}'
+        )
+        assert t.render() == "Other"
+
+    def test_context_plural_true(self):
+        env = self._make_env()
+        t = env.from_string(
+            '{% ctrans True, num=n, context="fruit" %}'
+            "{{ num }} apple{% pluralize %}{{ num }} apples"
+            "{% fallback %}no fruit{% endctrans %}"
+        )
+        # Context "fruit" for "apple" uses the specialized translation
+        assert t.render(n=1, LANGUAGE="de") == "1 Apple"
+        assert t.render(n=2, LANGUAGE="de") == "2 Apples"
+
+    # --- Trimmed / Notrimmed ---
+
+    def test_trimmed(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans True, trimmed %}  Hello  {% fallback %}  World  {% endctrans %}"
+        )
+        assert t.render() == "Hello"
+
+    def test_notrimmed(self):
+        env = self._make_env()
+        t = env.from_string(
+            "{% ctrans True, notrimmed %}  Hello  {% fallback %}  World  {% endctrans %}"
+        )
+        result = t.render()
+        assert "  Hello  " in result
+
+    # --- Newstyle gettext ---
+
+    def test_newstyle_variable(self):
+        env = self._make_env(newstyle=True)
+        t = env.from_string(
+            "{% ctrans True, num=count %}Hello {{ num }}{% fallback %}World{% endctrans %}"
+        )
+        assert t.render(count=3) == "Hello 3"
+
+    def test_newstyle_fallback_variable(self):
+        env = self._make_env(newstyle=True)
+        t = env.from_string(
+            "{% ctrans False %}Hello{% fallback %}World {{ count }}{% endctrans %}"
+        )
+        assert t.render(count=42) == "World 42"
+
+    # --- Extraction behavior ---
+
+    def test_extract_simple(self):
+        from jinja2.ext import babel_extract
+        source = BytesIO(
+            b"{% ctrans True %}Hello{% fallback %}World{% endctrans %}"
+        )
+        results = list(babel_extract(
+            source,
+            ("gettext", "ngettext", "pgettext", "npgettext", "_"),
+            [],
+            {"extensions": "jinja2.ext.ConditionalI18nExtension"}
+        ))
+        assert len(results) == 1
+        lineno, func, msg, comments = results[0]
+        assert func == "gettext"
+        assert msg == "Hello"
+        # Fallback "World" must NOT appear
+        assert "World" not in str(results)
+
+    def test_extract_plural(self):
+        from jinja2.ext import babel_extract
+        source = BytesIO(
+            b"{% ctrans True, num=count %}{{ count }} user{% pluralize %}"
+            b"{{ count }} users{% fallback %}Nobody{% endctrans %}"
+        )
+        results = list(babel_extract(
+            source,
+            ("gettext", "ngettext", "pgettext", "npgettext", "_"),
