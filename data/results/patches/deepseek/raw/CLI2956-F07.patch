+    def _check_option_conflicts(self, ctx: Context) -> None:
+        """Check option conflicts after all parameters have been processed."""
+        params = self.get_params(ctx)
+        # Build a name-to-param mapping
+        name_map: dict[str, Parameter] = {}
+        for param in params:
+            if param.name is not None:
+                name_map[param.name] = param
+
+        for param in params:
+            if not isinstance(param, Option):
+                continue
+            if not param.conflicts_with:
+                continue
+            for conflicted_name in param.conflicts_with:
+                # self-reference check
+                if conflicted_name == param.name:
+                    raise UsageError(
+                        f"Option '{param.human_readable_name}' cannot conflict with itself."
+                    )
+                # unknown name check
+                if conflicted_name not in name_map:
+                    raise UsageError(
+                        f"Option '{param.human_readable_name}' has unknown conflict"
+                        f" name '{conflicted_name}'."
+                    )
+                other = name_map[conflicted_name]
+                if not isinstance(other, Option):
+                    continue
+                # Get parameter sources
+                src = ctx.get_parameter_source(param.name)
+                other_src = ctx.get_parameter_source(conflicted_name)
+                if src is None or other_src is None:
+                    continue
+                # COMMANDLINE or PROMPT in any combination triggers conflict
+                if src in (
+                    ParameterSource.COMMANDLINE,
+                    ParameterSource.PROMPT,
+                ) and other_src in (
+                    ParameterSource.COMMANDLINE,
+                    ParameterSource.PROMPT,
+                ):
+                    raise UsageError(
+                        f"Option '{param.human_readable_name}' cannot be used together"
+                        f" with '{other.human_readable_name}'."
+                    )
+
+
     def parse_args(self, ctx: Context, args: list[str]) -> list[str]:
         if not args and self.no_args_is_help and not ctx.resilient_parsing:
             raise NoArgsIsHelpError(ctx)
