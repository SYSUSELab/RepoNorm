+    If ``stable`` is ``True``, groups are ordered by the first occurrence
+    of each key, rather than sorted. This also allows grouping by
+    equality-comparable keys that are not orderable, such as lists and
+    dictionaries. The first original key object is retained as the
+    grouper for each group.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,6 +1217,26 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
+    
+    if stable:
+        # First-seen order groupby that supports unhashable, non-orderable keys
+        groups: "t.List[t.Tuple[t.Any, t.List[V]]]" = []
+        
+        for item in value:
+            k = expr(item)
+            found = False
+            
+            for i, (grouper_key, group_values) in enumerate(groups):
+                if grouper_key == k:
+                    group_values.append(item)
+                    found = True
+                    break
+            
+            if not found:
+                groups.append((k, [item]))
+        
+        return [_GroupTuple(key, vals) for key, vals in groups]
+    
     return [
         _GroupTuple(key, list(values))
         for key, values in groupby(sorted(value, key=expr), expr)
