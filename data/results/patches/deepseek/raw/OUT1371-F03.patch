+def _select_condition(
+    conditional_filters: Optional[Dict[str, Dict[str, Callable]]],
+) -> Optional[str]:
+    """Determine which condition is active based on environment variables.
+
+    Rules:
+    1. OUTLINES_DEBUG=true activates 'debug'
+    2. ENVIRONMENT=production activates 'production'
+    3. ENV=testing, OUTLINES_TESTING=true, or TESTING_MODE=on activates 'testing'
+
+    Priority: debug > production > testing.
+    If none of the standard conditions match, select the alphabetically first
+    supplied condition key. None and empty mapping return None.
+
+    Environment names and values are compared with ASCII case-insensitive equality.
+    """
+    if not conditional_filters:
+        return None
+
+    # Determine which standard conditions are active
+    active_conditions = set()
+
+    # Check environment variables (case-insensitive)
+    env = {k.upper(): v.upper() for k, v in os.environ.items()}
+
+    # 1. OUTLINES_DEBUG=true activates 'debug'
+    if env.get("OUTLINES_DEBUG") == "TRUE":
+        active_conditions.add("debug")
+
+    # 2. ENVIRONMENT=production activates 'production'
+    if env.get("ENVIRONMENT") == "PRODUCTION":
+        active_conditions.add("production")
+
+    # 3. ENV=testing, OUTLINES_TESTING=true, or TESTING_MODE=on activates 'testing'
+    if env.get("ENV") == "TESTING" or env.get("OUTLINES_TESTING") == "TRUE" or env.get("TESTING_MODE") == "ON":
+        active_conditions.add("testing")
+
+    # Check in priority order
+    priority = ["debug", "production", "testing"]
+    for condition in priority:
+        if condition in active_conditions and condition in conditional_filters:
+            return condition
+
+    # If any standard condition is active but not in the mapping, skip and
+    # fall through to the alphabetical fallback.
+    # If no standard condition is active, pick alphabetically first supplied key.
+    if conditional_filters:
+        return sorted(conditional_filters.keys())[0]
+
+    return None
+
+
