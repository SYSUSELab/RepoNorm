@@ -0,0 +1,189 @@
+import pytest
+
+from dirty_equals import IsColor
+
+
+@pytest.mark.parametrize(
+    'value,dirty',
+    [
+        # IsColor (no format) - hex tests
+        ('#FF5733', IsColor()),
+        ('#FF5733', IsColor),
+        ('#f57', IsColor()),
+        ('#f57', IsColor),
+        ('FF5733', IsColor()),
+        ('f57', IsColor()),
+        ('#abcdef', IsColor()),
+        ('#ABC123', IsColor()),
+        ('#000000', IsColor()),
+        ('#fff', IsColor()),
+        ('#FFF', IsColor()),
+
+        # IsColor (no format) - RGB tests
+        ('rgb(255, 87, 51)', IsColor()),
+        ('RGB(255, 87, 51)', IsColor()),
+        ('Rgb(255, 87, 51)', IsColor()),
+        ('rgb(0, 0, 0)', IsColor()),
+        ('rgb(255, 255, 255)', IsColor()),
+        ('rgb(100, 200, 50)', IsColor()),
+        ('rgb(50%, 50%, 50%)', IsColor()),
+        ('rgb(100%, 0%, 0%)', IsColor()),
+        ('rgb(0%, 50%, 100%)', IsColor()),
+        ('rgb(255, 50%, 100)', IsColor()),  # mixed integer and percentage
+
+        # IsColor (no format) - HSL tests
+        ('hsl(14, 100%, 60%)', IsColor()),
+        ('HSL(14, 100%, 60%)', IsColor()),
+        ('Hsl(14, 100%, 60%)', IsColor()),
+        ('hsl(0, 0%, 0%)', IsColor()),
+        ('hsl(360, 100%, 100%)', IsColor()),
+        ('hsl(180, 50%, 50%)', IsColor()),
+        ('hsl(14deg, 100%, 60%)', IsColor()),
+        ('hsl(0deg, 0%, 0%)', IsColor()),
+        ('hsl(360deg, 100%, 100%)', IsColor()),
+
+        # Whitespace tolerance
+        ('  #FF5733  ', IsColor()),
+        ('  rgb(255, 87, 51)  ', IsColor()),
+        ('rgb( 255 , 87 , 51 )', IsColor()),
+        ('  hsl(14, 100%, 60%)  ', IsColor()),
+        ('hsl( 14 , 100% , 60% )', IsColor()),
+
+        # IsColor('hex')
+        ('#FF5733', IsColor('hex')),
+        ('#f57', IsColor('hex')),
+        ('FF5733', IsColor('hex')),
+        ('f57', IsColor('hex')),
+        ('#000000', IsColor('hex')),
+        ('#fff', IsColor('hex')),
+
+        # IsColor('rgb')
+        ('rgb(255, 87, 51)', IsColor('rgb')),
+        ('rgb(0, 0, 0)', IsColor('rgb')),
+        ('rgb(255, 255, 255)', IsColor('rgb')),
+        ('rgb(50%, 50%, 50%)', IsColor('rgb')),
+        ('rgb(100%, 0%, 0%)', IsColor('rgb')),
+        ('rgb(255, 50%, 100)', IsColor('rgb')),
+
+        # IsColor('hsl')
+        ('hsl(14, 100%, 60%)', IsColor('hsl')),
+        ('hsl(0, 0%, 0%)', IsColor('hsl')),
+        ('hsl(360, 100%, 100%)', IsColor('hsl')),
+        ('hsl(180, 50%, 50%)', IsColor('hsl')),
+        ('hsl(14deg, 100%, 60%)', IsColor('hsl')),
+        ('hsl(0deg, 0%, 0%)', IsColor('hsl')),
+        ('hsl(360deg, 100%, 100%)', IsColor('hsl')),
+    ],
+)
+def test_is_color_true(value, dirty):
+    assert value == dirty
+
+
+@pytest.mark.parametrize(
+    'value,dirty',
+    [
+        # Non-string values
+        (123, IsColor()),
+        ([1, 2, 3], IsColor()),
+        (None, IsColor()),
+        (True, IsColor()),
+        (b'#FF5733', IsColor()),
+
+        # Invalid hex
+        ('#GG5733', IsColor()),
+        ('#FF573', IsColor()),
+        ('#FF57331', IsColor()),
+        ('#', IsColor()),
+        ('#12', IsColor()),
+        ('#12345', IsColor()),
+        ('#1234567', IsColor()),
+        ('FF573', IsColor()),
+        ('FF57331', IsColor()),
+
+        # Invalid RGB
+        ('rgb(256, 87, 51)', IsColor()),
+        ('rgb(255, 300, 51)', IsColor()),
+        ('rgb(255, 87, 999)', IsColor()),
+        ('rgb(101%, 50%, 50%)', IsColor()),
+        ('rgb(50%, 101%, 50%)', IsColor()),
+        ('rgb(50%, 50%, 101%)', IsColor()),
+        ('rgb(-1, 87, 51)', IsColor()),
+        ('rgb(1.5, 87, 51)', IsColor()),
+        ('rgb(255, 87)', IsColor()),  # missing component
+        ('rgb(255, 87, 51, 0.5)', IsColor()),  # alpha channel
+        ('rgb()', IsColor()),
+        ('rgb  (255, 87, 51)', IsColor()),  # space before (
+        ('rgba(255, 87, 51, 0.5)', IsColor()),  # rgba not supported
+
+        # Invalid HSL
+        ('hsl(361, 100%, 60%)', IsColor()),
+        ('hsl(14, 101%, 60%)', IsColor()),
+        ('hsl(14, 100%, 101%)', IsColor()),
+        ('hsl(-1, 100%, 60%)', IsColor()),
+        ('hsl(14, 50, 60%)', IsColor()),  # missing % on saturation
+        ('hsl(14, 100%, 60)', IsColor()),  # missing % on lightness
+        ('hsl(14, 100%, 60%, 0.5)', IsColor()),  # alpha
+        ('hsla(14, 100%, 60%, 0.5)', IsColor()),  # hsla not supported
+        ('hsl  (14, 100%, 60%)', IsColor()),  # space before (
+
+        # Named colors not supported
+        ('red', IsColor()),
+        ('blue', IsColor()),
+        ('green', IsColor()),
+
+        # Format-specific checks
+        ('#FF5733', IsColor('rgb')),
+        ('#FF5733', IsColor('hsl')),
+        ('rgb(255, 87, 51)', IsColor('hex')),
+        ('rgb(255, 87, 51)', IsColor('hsl')),
+        ('hsl(14, 100%, 60%)', IsColor('hex')),
+        ('hsl(14, 100%, 60%)', IsColor('rgb')),
+    ],
+)
+def test_is_color_false(value, dirty):
+    assert value != dirty
+
+
+def test_is_color_repr_no_format():
+    is_color = IsColor()
+    with pytest.raises(AssertionError):
+        assert 'invalid' == is_color
+    assert str(is_color) == 'IsColor(*)'
+
+
+def test_is_color_repr_hex():
+    is_color = IsColor('hex')
+    with pytest.raises(AssertionError):
+        assert 'invalid' == is_color
+    assert str(is_color) == "IsColor('hex')"
+
+
+def test_is_color_repr_rgb():
+    is_color = IsColor('rgb')
+    with pytest.raises(AssertionError):
+        assert 'invalid' == is_color
+    assert str(is_color) == "IsColor('rgb')"
+
+
+def test_is_color_repr_hsl():
+    is_color = IsColor('hsl')
+    with pytest.raises(AssertionError):
+        assert 'invalid' == is_color
+    assert str(is_color) == "IsColor('hsl')"
+
+
+def test_is_color_equals_value():
+    """Test that when equals is true, repr returns the matched value."""
+    is_color = IsColor()
+    assert '#FF5733' == is_color
+    assert str(is_color) == "'#FF5733'"
+
+
+def test_is_color_format_specific_rgb_not_hex():
+    """RGB value should not match hex format."""
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+
+
+def test_is_color_format_specific_hex_not_rgb():
+    """Hex value should not match rgb format."""
+    assert '#FF5733' != IsColor('rgb')
