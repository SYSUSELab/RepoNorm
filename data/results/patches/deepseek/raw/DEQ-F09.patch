+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsColor(DirtyEquals[str]):
+    """
+    A class that validates color codes across multiple formats including hex, RGB, and HSL.
+
+    Supports hex colors (e.g., '#FF5733', '#f57'), RGB format (e.g., 'rgb(255, 87, 51)'),
+    and HSL format (e.g., 'hsl(14, 100%, 60%)'). Users can specify the expected format or
+    allow any valid color format.
+
+    Examples:
+    ```py title="IsColor"
+    from dirty_equals import IsColor
+
+    assert '#FF5733' == IsColor()
+    assert '#FF5733' == IsColor('hex')
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+    ```
+    """
+
+    def __init__(self, format: Optional[Literal['hex', 'rgb', 'hsl']] = None):
+        """
+        Args:
+            format: The expected color format. If omitted, any supported format is accepted.
+                Can be 'hex', 'rgb', or 'hsl'.
+        """
+        self.format = format
+        if format is not None:
+            super().__init__(plain_repr(repr(format)))
+        else:
+            super().__init__(plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        other = other.strip()
+
+        if self.format is None or self.format == 'hex':
+            if self._is_hex(other):
+                return True
+
+        if self.format is None or self.format == 'rgb':
+            if self._is_rgb(other):
+                return True
+
+        if self.format is None or self.format == 'hsl':
+            if self._is_hsl(other):
+                return True
+
+        return False
+
+    @staticmethod
+    def _is_hex(value: str) -> bool:
+        """Check if value is a valid hex color (3 or 6 hex digits, optional #)."""
+        return bool(re.match(r'^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$', value))
+
+    @staticmethod
+    def _is_rgb(value: str) -> bool:
+        """Check if value is a valid RGB color."""
+        # Match rgb(r, g, b) where each component can be an integer 0-255 or a percentage 0-100%
+        # No whitespace allowed between function name and '('
+        pattern = (
+            r'^rgb\(\s*'
+            r'(\d{1,3})(%?)\s*,\s*'
+            r'(\d{1,3})(%?)\s*,\s*'
+            r'(\d{1,3})(%?)\s*'
+            r'\)$'
+        )
+        m = re.match(pattern, value, re.IGNORECASE)
+        if not m:
+            return False
+
+        for i in range(3):
+            val = int(m.group(1 + i * 2))
+            has_percent = bool(m.group(2 + i * 2))
+            if has_percent:
+                if not (0 <= val <= 100):
+                    return False
+            else:
+                if not (0 <= val <= 255):
+                    return False
+
+        return True
+
+    @staticmethod
+    def _is_hsl(value: str) -> bool:
+        """Check if value is a valid HSL color."""
+        # Match hsl(hue, saturation%, lightness%)
+        # hue: 0-360 with optional 'deg' suffix
+        # saturation: 0-100%
+        # lightness: 0-100%
+        # No whitespace allowed between function name and '('
+        pattern = (
+            r'^hsl\(\s*'
+            r'(\d{1,3})(deg)?\s*,\s*'
+            r'(\d{1,3})%\s*,\s*'
+            r'(\d{1,3})%\s*'
+            r'\)$'
+        )
+        m = re.match(pattern, value, re.IGNORECASE)
+        if not m:
+            return False
+
+        hue = int(m.group(1))
+        sat = int(m.group(3))
+        light = int(m.group(4))
+
+        return 0 <= hue <= 360 and 0 <= sat <= 100 and 0 <= light <= 100
