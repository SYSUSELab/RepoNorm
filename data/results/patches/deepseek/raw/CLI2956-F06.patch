+def _is_dynamic_default(value: t.Any) -> bool:
+    """Check if a value is a dynamic default dictionary.
+
+    A dynamic default is a non-empty dictionary whose keys are full long
+    option names beginning ``--`` and whose values are dictionaries from
+    stringified dependency values to target defaults.
+    """
+    if not isinstance(value, dict) or not value:
+        return False
+    return all(isinstance(k, str) and k.startswith("--") for k in value)
+
+
+def _resolve_dynamic_default(
+    ctx: "Context", value: dict[str, t.Any]
+) -> t.Any:
+    """Resolve a dynamic default value.
+
+    :param ctx: The current context.
+    :param value: The dynamic default dictionary.
+    :return: The resolved default value.
+    """
+    result: t.Any = None
+
+    for dep_opt, mapping in value.items():
+        # dep_opt is like "--format"
+        dep_name = dep_opt[2:]  # strip "--" prefix
+
+        # Find the parameter with this name
+        dep_param = None
+        for param in ctx.command.get_params(ctx):
+            if param.name == dep_name:
+                dep_param = param
+                break
+
+        if dep_param is None:
+            raise UsageError(
+                f"Unknown option '{dep_opt}' referenced in dynamic default."
+            )
+
+        if not isinstance(mapping, dict):
+            raise TypeError(
+                f"Dynamic default mapping for '{dep_opt}' must be "
+                f"a dictionary, not {type(mapping).__name__}."
+            )
+
+        # Get the dependency value from ctx.params
+        dep_value = ctx.params.get(dep_name)
+
+        # For boolean values, convert to "True" or "False"
+        if isinstance(dep_value, bool):
+            dep_key = "True" if dep_value else "False"
+        else:
+            dep_key = str(dep_value) if dep_value is not None else "None"
+
+        if dep_key in mapping:
+            result = mapping[dep_key]
+        else:
+            result = None
+
+    return result
+
