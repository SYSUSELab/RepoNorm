+    def _resolve_dynamic_defaults(self, ctx: Context) -> None:
+        """Resolve dynamic defaults for parameters whose source is DEFAULT.
+
+        After all explicit values, environment variables, default-map values,
+        and ordinary defaults have been parsed, resolve dynamic defaults whose
+        target source is still DEFAULT.
+        """
+        params = list(self.get_params(ctx))
+        
+        # Find parameters with dynamic defaults that still have DEFAULT source
+        dynamic_params = []
+        for param in params:
+            if _is_dynamic_default(param.default):
+                source = ctx.get_parameter_source(param.name)
+                if source == ParameterSource.DEFAULT:
+                    dynamic_params.append(param)
+
+        if not dynamic_params:
+            return
+
+        # Build dependency graph for topological sort
+        # Map param name -> set of dependency param names (within dynamic defaults)
+        deps: dict[str, set[str]] = {}
+        all_param_names = {p.name for p in params}
+        
+        for param in dynamic_params:
+            dep_names: set[str] = set()
+            for dep_opt in param.default:
+                dep_name = dep_opt[2:]  # strip "--"
+                if dep_name not in all_param_names:
+                    raise UsageError(
+                        f"Unknown option '{dep_opt}' referenced in dynamic default."
+                    )
+                dep_names.add(dep_name)
+            deps[param.name] = dep_names
+
+        # Topological sort using Kahn's algorithm
+        # Only consider edges between dynamic params for cycle detection
+        dynamic_names = {p.name for p in dynamic_params}
+        
+        # Build in-degree count considering only edges to other dynamic params
+        in_degree: dict[str, int] = {name: 0 for name in dynamic_names}
+        dep_graph: dict[str, list[str]] = {name: [] for name in dynamic_names}
+        
+        for param in dynamic_params:
+            for dep_name in deps[param.name]:
+                if dep_name in dynamic_names:
+                    # param depends on dep_name
+                    dep_graph.setdefault(dep_name, []).append(param.name)
+                    in_degree[param.name] = in_degree.get(param.name, 0) + 1
+
+        # Kahn's algorithm
+        queue = [name for name in dynamic_names if in_degree.get(name, 0) == 0]
+        topological_order = []
+        
+        while queue:
+            name = queue.pop(0)
+            topological_order.append(name)
+            for dependent in dep_graph.get(name, []):
+                in_degree[dependent] -= 1
+                if in_degree[dependent] == 0:
+                    queue.append(dependent)
+
+        if len(topological_order) != len(dynamic_names):
+            # There's a cycle
+            raise UsageError(
+                "A cyclic dependency was detected in dynamic defaults."
+            )
+
+        # Resolve dynamic defaults in topological order
+        for param_name in topological_order:
+            param = next(p for p in dynamic_params if p.name == param_name)
+            # Resolve the dynamic default
+            raw_value = _resolve_dynamic_default(ctx, param.default)
+            # Process the resolved value through the normal pipeline
+            with augment_usage_errors(ctx, param=param):
+                processed_value = param.process_value(ctx, raw_value)
+            ctx.params[param.name] = processed_value
+            ctx.set_parameter_source(param.name, ParameterSource.DEFAULT)
+
