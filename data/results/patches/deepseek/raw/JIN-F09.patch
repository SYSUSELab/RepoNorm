           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    You can specify ``levels`` to group by multiple attributes
+    hierarchically. Each level groups the items by a different
+    attribute. When ``levels`` is given, ``attribute`` can be a
+    comma-separated string or a list of attributes, with the number
+    of attributes matching ``levels``.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for dept, roles in users|groupby("dept,role", levels=2) %}
+          <li>{{ dept }}
+            <ul>{% for role, items in roles %}
+              <li>{{ role }}: {{ items|map(attribute="name")|join(", ") }}</li>
+            {% endfor %}</ul>
+          </li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
     """
+    if levels is None and isinstance(attribute, (list, tuple)):
+        if len(attribute) > 1:
+            raise FilterArgumentError(
+                "Multiple attributes require levels parameter"
+            )
+        attribute = attribute[0]
+
+    if levels is not None:
+        if isinstance(levels, bool) or not isinstance(levels, int) or levels <= 0:
+            raise FilterArgumentError(
+                "levels must be a positive integer"
+            )
+
+        if isinstance(attribute, str):
+            attrs = [a.strip() for a in attribute.split(",")]
+        elif isinstance(attribute, (list, tuple)):
+            attrs = list(attribute)
+        else:
+            attrs = [attribute]
+
+        if len(attrs) != levels:
+            raise FilterArgumentError(
+                f"Number of attributes ({len(attrs)}) must match levels ({levels})"
+            )
+
+        getters = [
+            make_attrgetter(environment, attr, default=default)
+            for attr in attrs
+        ]
+
+        def composite_key(item: t.Any) -> tuple:
+            return tuple(getter(item) for getter in getters)
+
+        sorted_items = sorted(value, key=composite_key)
+
+        def _group(items: t.List, level: int) -> t.List:
+            if level == len(getters):
+                return items
+
+            getter = getters[level]
+            result = []
+            for key, group in groupby(items, key=getter):
+                sub = _group(list(group), level + 1)
+                result.append(_GroupTuple(key, sub))
+            return result
+
+        return _group(sorted_items, 0)
+
