+class _ParamHistoryDict(dict):
+    """A dict subclass that records option assignment history when tracking is enabled."""
+
+    def __init__(self, ctx, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._ctx = ctx
+
+    def __setitem__(self, key, value):
+        super().__setitem__(key, value)
+        ctx = self._ctx
+        command = ctx.command
+        if hasattr(command, "track_changes") and command.track_changes:
+            history = ctx._option_history
+            if key not in history:
+                history[key] = []
+            # First assignment (from parsing) uses the source from set_parameter_source
+            # Subsequent assignments (from user code) use source=None
+            if len(history[key]) == 0:
+                source = ctx.get_parameter_source(key)
+            else:
+                source = None
+            history[key].append({
+                "value": value,
+                "source": source,
+                "timestamp": __import__("time").time(),
+            })
+
+
