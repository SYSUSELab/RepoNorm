+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of values assigned to an option.
+
+        :param name: The option's Python parameter name, a long option such as
+            ``"--count"``, or a short option such as ``"-c"``.
+        :return: A list of history entries, or ``None`` if tracking is not
+            enabled on the current command.
+
+        .. versionadded:: 8.2
+        """
+        command = self.command
+        if not hasattr(command, "track_changes") or not command.track_changes:
+            return None
+
+        # Resolve name to parameter name
+        param_name = None
+        for param in command.params:
+            if hasattr(param, "name") and param.name == name:
+                param_name = param.name
+                break
+            if hasattr(param, "opts") and name in param.opts:
+                param_name = param.name
+                break
+            if hasattr(param, "secondary_opts") and name in param.secondary_opts:
+                param_name = param.name
+                break
+
+        if param_name is None:
+            return []
+
+        # Return a snapshot copy
+        history = self._option_history.get(param_name, [])
+        return [dict(e) for e in history]
+
