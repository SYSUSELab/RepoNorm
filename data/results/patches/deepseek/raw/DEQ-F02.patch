+
+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address, optionally checking format.
+    """
+
+    def __init__(self, format: Literal[None, 'colon', 'hyphen', 'dot', 'compact'] = None):
+        """
+        Args:
+            format: The format of the MAC address to check, if omitted, all formats are accepted.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert 'aa:bb:cc:dd:ee:ff' == IsMac
+        assert 'aa:bb:cc:dd:ee:ff' == IsMac()
+        assert 'aa:bb:cc:dd:ee:ff' == IsMac('colon')
+        assert 'aa-bb-cc-dd-ee-ff' == IsMac('hyphen')
+        assert 'aaa.bbb.ccc' == IsMac('dot')
+        assert 'aabbccddeeff' == IsMac('compact')
+
+        assert 'aa:bb:cc:dd:ee:ff' != IsMac('hyphen')
+        assert 123 != IsMac
+        ```
+        """
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        hex_digits = '0123456789abcdefABCDEF'
+
+        if self.format == 'colon':
+            # Check pattern: xx:xx:xx:xx:xx:xx
+            parts = other.split(':')
+            if len(parts) != 6:
+                return False
+            for part in parts:
+                if len(part) != 2 or not all(c in hex_digits for c in part):
+                    return False
+            return True
+        elif self.format == 'hyphen':
+            # Check pattern: xx-xx-xx-xx-xx-xx
+            parts = other.split('-')
+            if len(parts) != 6:
+                return False
+            for part in parts:
+                if len(part) != 2 or not all(c in hex_digits for c in part):
+                    return False
+            return True
+        elif self.format == 'dot':
+            # Check pattern: xxx.xxx.xxx (3 groups of 4 hex digits)
+            parts = other.split('.')
+            if len(parts) != 3:
+                return False
+            for part in parts:
+                if len(part) != 4 or not all(c in hex_digits for c in part):
+                    return False
+            return True
+        elif self.format == 'compact':
+            # Check pattern: xxxxxxxxxxxx (12 hex digits)
+            if len(other) != 12 or not all(c in hex_digits for c in other):
+                return False
+            return True
+        else:
+            # No format specified - try all formats
+            # Colon-separated: xx:xx:xx:xx:xx:xx
+            parts = other.split(':')
+            if len(parts) == 6 and all(len(p) == 2 and all(c in hex_digits for c in p) for p in parts):
+                return True
+            # Hyphen-separated: xx-xx-xx-xx-xx-xx
+            parts = other.split('-')
+            if len(parts) == 6 and all(len(p) == 2 and all(c in hex_digits for c in p) for p in parts):
+                return True
+            # Three-group dotted: xxx.xxx.xxx
+            parts = other.split('.')
+            if len(parts) == 3 and all(len(p) == 4 and all(c in hex_digits for c in p) for p in parts):
+                return True
+            # Compact: xxxxxxxxxxxx
+            if len(other) == 12 and all(c in hex_digits for c in other):
+                return True
+            return False
