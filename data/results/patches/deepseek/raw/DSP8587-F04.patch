index 00000000..73912e2f
--- /dev/null
+++ b/tests/streaming/test_idle_timeout.py
@@ -0,0 +1,223 @@
+"""Tests for the idle timeout feature of StreamListener."""
+
+import asyncio
+import time
+
+import pytest
+
+import dspy
+from dspy.streaming import StreamListener, StreamResponse
+
+
+class TestIdleTimeoutValidation:
+    """Test validation of idle_timeout_s parameter."""
+
+    def test_none_disables_timeout(self):
+        """None should disable idle termination."""
+        listener = StreamListener("output", idle_timeout_s=None)
+        assert listener.idle_timeout_s is None
+        assert listener.tick() is None
+
+    def test_positive_float_accepted(self):
+        """Positive float should be accepted."""
+        listener = StreamListener("output", idle_timeout_s=5.0)
+        assert listener.idle_timeout_s == 5.0
+
+    def test_positive_int_accepted(self):
+        """Positive int should be accepted."""
+        listener = StreamListener("output", idle_timeout_s=10)
+        assert listener.idle_timeout_s == 10
+
+    def test_bool_rejected(self):
+        """Boolean should be rejected."""
+        with pytest.raises(ValueError, match="idle_timeout_s must be a positive finite number or None"):
+            StreamListener("output", idle_timeout_s=True)
+
+    def test_negative_rejected(self):
+        """Negative number should be rejected."""
+        with pytest.raises(ValueError, match="idle_timeout_s must be a positive finite number or None"):
+            StreamListener("output", idle_timeout_s=-1.0)
+
+    def test_zero_rejected(self):
+        """Zero should be rejected."""
+        with pytest.raises(ValueError, match="idle_timeout_s must be a positive finite number or None"):
+            StreamListener("output", idle_timeout_s=0)
+
+    def test_inf_rejected(self):
+        """Infinity should be rejected."""
+        with pytest.raises(ValueError, match="idle_timeout_s must be a positive finite number or None"):
+            StreamListener("output", idle_timeout_s=float("inf"))
+
+    def test_nan_rejected(self):
+        """NaN should be rejected."""
+        with pytest.raises(ValueError, match="idle_timeout_s must be a positive finite number or None"):
+            StreamListener("output", idle_timeout_s=float("nan"))
+
+
+class TestStreamListenerTick:
+    """Test the tick() method directly."""
+
+    def test_tick_before_stream_start_returns_none(self):
+        """tick() should return None before the stream has started."""
+        listener = StreamListener("output", idle_timeout_s=1.0)
+        # Stream hasn't started yet
+        result = listener.tick(now_ts=100.0)
+        assert result is None
+
+    def test_tick_after_stream_end_returns_none(self):
+        """tick() should return None after the stream has ended."""
+        listener = StreamListener("output", idle_timeout_s=1.0)
+        # Manually set stream to started and ended
+        listener.stream_start = True
+        listener.stream_end = True
+        result = listener.tick(now_ts=100.0)
+        assert result is None
+
+    def test_tick_before_timeout_returns_none(self):
+        """tick() should return None before the timeout."""
+        listener = StreamListener("output", idle_timeout_s=5.0)
+        listener.stream_start = True
+        listener.last_activity_time = 100.0
+        # Only 1 second elapsed, timeout is 5 seconds
+        result = listener.tick(now_ts=101.0)
+        assert result is None
+
+    def test_tick_at_timeout_returns_response(self):
+        """tick() should return StreamResponse when timeout is reached."""
+        listener = StreamListener("output", idle_timeout_s=5.0, predict_name="my_predict")
+        listener.stream_start = True
+        listener.last_activity_time = 100.0
+        # Exactly 5 seconds elapsed
+        result = listener.tick(now_ts=105.0)
+        assert isinstance(result, StreamResponse)
+        assert result.predict_name == "my_predict"
+        assert result.signature_field_name == "output"
+        assert result.chunk == ""
+
+    def test_tick_after_timeout_returns_none(self):
+        """tick() should return None after already timed out (no duplicates)."""
+        listener = StreamListener("output", idle_timeout_s=5.0)
+        listener.stream_start = True
+        listener.last_activity_time = 100.0
+        # First tick at timeout
+        result1 = listener.tick(now_ts=105.0)
+        assert result1 is not None
+        # Second tick after timeout
+        result2 = listener.tick(now_ts=110.0)
+        assert result2 is None
+
+    def test_tick_clears_stream_state(self):
+        """tick() should clear per-stream state after timeout."""
+        listener = StreamListener("output", idle_timeout_s=5.0)
+        listener.stream_start = True
+        listener.last_activity_time = 100.0
+        listener.field_start_queue = ["some", "data"]
+        listener.cache_hit = True
+
+        listener.tick(now_ts=105.0)
+
+        assert listener._timed_out is True
+        assert listener.stream_start is False
+        assert listener.stream_end is True
+        assert listener.cache_hit is False
+        assert listener.field_start_queue == []
+
+    def test_tick_exact_boundary(self):
+        """tick() should trigger exactly at the timeout boundary."""
+        listener = StreamListener("output", idle_timeout_s=5.0)
+        listener.stream_start = True
+        listener.last_activity_time = 100.0
+        # Exactly at the boundary (elapsed == idle_timeout_s)
+        result = listener.tick(now_ts=105.0)
+        assert result is not None
+
+    def test_custom_clock_with_now_ts(self):
+        """Custom clock should work correctly when now_ts is provided."""
+        clock_calls = []
+        def custom_clock():
+            clock_calls.append("called")
+            return 42.0
+
+        listener = StreamListener("output", idle_timeout_s=5.0, clock=custom_clock)
+        # Custom clock is only used when now_ts is None
+        listener.stream_start = True
+        listener.last_activity_time = 100.0
+        result = listener.tick(now_ts=106.0)
+        assert result is not None
+        # clock should not have been called since now_ts was provided
+        assert len(clock_calls) == 0
+
+    def test_custom_clock_default_used(self):
+        """When now_ts is None, the stored clock should be used."""
+        stored_time = [100.0]
+        def custom_clock():
+            return stored_time[0]
+
+        listener = StreamListener("output", idle_timeout_s=5.0, clock=custom_clock)
+        listener.stream_start = True
+        listener.last_activity_time = custom_clock()  # 100.0
+
+        # Advance the clock past the timeout
+        stored_time[0] = 106.0
+
+        result = listener.tick()
+        assert result is not None
+
+
+class TestIdleTimeoutWithStreamify:
+    """Test idle timeout integration with streamify."""
+
+    @pytest.mark.anyio
+    async def test_idle_timeout_fires_when_upstream_stalled(self):
+        """When upstream is stalled (no data), idle timeout should fire and terminate."""
+        from unittest.mock import MagicMock, patch
+
+        # Create a listener with a very short timeout
+        listener = StreamListener("output", idle_timeout_s=0.2)
+
+        # Create a simple program with a Predict that has an "output" field
+        lm = dspy.utils.DummyLM([{"output": "test output"}])
+
+        class TestSignature(dspy.Signature):
+            input_text: str = dspy.InputField()
+            output: str = dspy.OutputField()
+
+        with dspy.context(lm=lm):
+            program = dspy.streamify(
+                dspy.Predict(TestSignature),
+                stream_listeners=[listener],
+            )
+
+            # Run the program, but expect it to complete normally because
+            # DummyLM responds instantly
+            output_stream = program(input_text="test")
+            chunks = []
+            async for value in output_stream:
+                chunks.append(value)
+
+        # Should have completed normally without timeout
+        assert len(chunks) > 0
+        assert isinstance(chunks[-1], dspy.Prediction)
+
+    @pytest.mark.anyio
+    async def test_idle_timeout_not_fired_when_idle_timeout_none(self):
+        """When idle_timeout_s is None, no timeout should fire."""
+        listener = StreamListener("output", idle_timeout_s=None)
+        lm = dspy.utils.DummyLM([{"output": "test output"}])
+
+        class TestSignature(dspy.Signature):
+            input_text: str = dspy.InputField()
+            output: str = dspy.OutputField()
+
+        with dspy.context(lm=lm):
+            program = dspy.streamify(
+                dspy.Predict(TestSignature),
+                stream_listeners=[listener],
+            )
+            output_stream = program(input_text="test")
+            chunks = []
+            async for value in output_stream:
+                chunks.append(value)
+
+        assert len(chunks) > 0
+        assert isinstance(chunks[-1], dspy.Prediction)
