diff --git a/tests/backends/test_xgrammar.py b/tests/backends/test_xgrammar.py
index 1133b9f..ba8120a 100644
--- a/tests/backends/test_xgrammar.py
+++ b/tests/backends/test_xgrammar.py
@@ -93,3 +93,151 @@ def test_xgrammar_backend_invalid_model(model_llamacpp):
         match="The xgrammar backend only supports Transformers models",
     ):
         XGrammarBackend(model_llamacpp)
+
+
+# --- validate_grammar tests ---
+
+def test_xgrammar_validate_grammar_backend_default(model_transformers, json_schema, regex, cfg):
+    """Test that backend-level validate_grammar is called for all processor types."""
+    calls = []
+
+    def validator(s: str) -> None:
+        calls.append(s)
+
+    backend = XGrammarBackend(model_transformers, validate_grammar=validator)
+    assert len(calls) == 0
+
+    # JSON schema
+    backend.get_json_schema_logits_processor(json_schema)
+    assert len(calls) == 1
+    assert calls[0] == json_schema
+
+    # Regex
+    calls.clear()
+    backend.get_regex_logits_processor(regex)
+    assert len(calls) == 1
+    assert calls[0] == regex
+
+    # CFG
+    calls.clear()
+    backend.get_cfg_logits_processor(cfg)
+    assert len(calls) == 1
+    assert calls[0] == cfg
+
+
+def test_xgrammar_validate_grammar_no_backend_default(model_transformers, json_schema):
+    """Test that without backend-level validate_grammar, nothing is called."""
+    calls = []
+
+    def validator(s: str) -> None:
+        calls.append(s)
+
+    backend = XGrammarBackend(model_transformers)  # no validator
+
+    # Per-request validator should still work
+    backend.get_json_schema_logits_processor(json_schema, validate_grammar=validator)
+    assert len(calls) == 1
+
+    # Without per-request, no validation
+    calls.clear()
+    backend.get_json_schema_logits_processor(json_schema)
+    assert len(calls) == 0
+
+
+def test_xgrammar_validate_grammar_per_request_override(model_transformers, json_schema):
+    """Test that per-request validate_grammar overrides the backend default."""
+    backend_calls = []
+    request_calls = []
+
+    def backend_validator(s: str) -> None:
+        backend_calls.append(s)
+
+    def request_validator(s: str) -> None:
+        request_calls.append(s)
+
+    backend = XGrammarBackend(model_transformers, validate_grammar=backend_validator)
+
+    # Per-request should override backend default
+    backend.get_json_schema_logits_processor(json_schema, validate_grammar=request_validator)
+    assert len(backend_calls) == 0
+    assert len(request_calls) == 1
+    assert request_calls[0] == json_schema
+
+
+def test_xgrammar_validate_grammar_explicit_none_disables(model_transformers, json_schema):
+    """Test that explicit None disables validation for that request."""
+    calls = []
+
+    def validator(s: str) -> None:
+        calls.append(s)
+
+    backend = XGrammarBackend(model_transformers, validate_grammar=validator)
+
+    # Explicit None disables
+    backend.get_json_schema_logits_processor(json_schema, validate_grammar=None)
+    assert len(calls) == 0
+
+
+def test_xgrammar_validate_grammar_exception_propagation(model_transformers, json_schema):
+    """Test that exceptions from validate_grammar propagate and backend remains usable."""
+    calls = []
+
+    def failing_validator(s: str) -> None:
+        calls.append(s)
+        raise ValueError("Bad grammar!")
+
+    def good_validator(s: str) -> None:
+        calls.append(s)
+
+    backend = XGrammarBackend(model_transformers, validate_grammar=failing_validator)
+
+    # Exception propagates
+    with pytest.raises(ValueError, match="Bad grammar!"):
+        backend.get_json_schema_logits_processor(json_schema)
+    assert len(calls) == 1
+
+    # Backend is still usable with a per-request override
+    backend.get_json_schema_logits_processor(json_schema, validate_grammar=good_validator)
+    assert len(calls) == 2
+
+    # Per-request None disables the failing backend default
+    calls.clear()
+    backend.get_json_schema_logits_processor(json_schema, validate_grammar=None)
+    assert len(calls) == 0
+
+
+def test_xgrammar_validate_grammar_false_return(model_transformers, json_schema):
+    """Test that returning False is treated as success."""
+    calls = []
+
+    def validator(s: str) -> object:
+        calls.append(s)
+        return False  # should be treated as success
+
+    backend = XGrammarBackend(model_transformers, validate_grammar=validator)
+    proc = backend.get_json_schema_logits_processor(json_schema)
+    assert isinstance(proc, XGrammarLogitsProcessor)
+    assert len(calls) == 1
+
+
+def test_xgrammar_validate_grammar_backend_isolation(model_transformers, json_schema):
+    """Test that multiple backend instances are isolated."""
+    calls_a = []
+    calls_b = []
+
+    def validator_a(s: str) -> None:
+        calls_a.append(s)
+
+    def validator_b(s: str) -> None:
+        calls_b.append(s)
+
+    backend_a = XGrammarBackend(model_transformers, validate_grammar=validator_a)
+    backend_b = XGrammarBackend(model_transformers, validate_grammar=validator_b)
+
+    backend_a.get_json_schema_logits_processor(json_schema)
+    assert len(calls_a) == 1
+    assert len(calls_b) == 0
+
+    backend_b.get_json_schema_logits_processor(json_schema)
+    assert len(calls_a) == 1
+    assert len(calls_b) == 1
