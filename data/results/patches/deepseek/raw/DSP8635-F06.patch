+def test_min_instr_chars_fallback():
+    """Test that short generated instructions fall back to basic instruction."""
+    prompt_model = DummyLM([{"proposed_instruction": "short"}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset,
+                                verbose=True, min_instr_chars=30, max_instr_chars=600)
+    result = proposer.propose_instruction_for_predictor(
+        program=program, predictor=None, pred_i=0, T=0.5,
+        demo_candidates=None, demo_set_i=0, trial_logs={}, tip=None,
+    )
+    # "short" is 5 chars, less than min 30, should fall back to basic instruction
+    expected_basic = "Given the fields `question`, produce the fields `answer`."
+    assert result == expected_basic, f"Expected basic instruction, got: {result!r}"
+
+
+def test_max_instr_chars_truncation():
+    """Test that overlong instructions are truncated at sentence boundary."""
+    # Generate a long instruction that's over max_chars
+    long_instr = "First sentence about the task. Second sentence about the task. Third sentence."
+    prompt_model = DummyLM([{"proposed_instruction": long_instr}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    # Set max_chars to something small enough to trigger truncation
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset,
+                                verbose=True, min_instr_chars=0, max_instr_chars=50)
+    result = proposer.propose_instruction_for_predictor(
+        program=program, predictor=None, pred_i=0, T=0.5,
+        demo_candidates=None, demo_set_i=0, trial_logs={}, tip=None,
+    )
+    # Should be truncated with ellipsis, length <= 50
+    assert len(result) <= 50, f"Result length {len(result)} exceeds max 50: {result!r}"
+    assert result.endswith("…"), f"Result should end with ellipsis: {result!r}"
+
