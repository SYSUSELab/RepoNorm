+def test_init_bounds_validation():
+    """Test that __init__ validates min_instr_chars and max_instr_chars correctly."""
+    prompt_model = DummyLM([{"proposed_instruction": "test"}])
+    program = Predict("question -> answer")
+    trainset = []
+
+    # Default values should work
+    p = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False)
+    assert p.min_instr_chars == 30
+    assert p.max_instr_chars == 600
+    assert p.rephrase_when_too_long is False
+
+    # Valid custom values
+    p = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=50, max_instr_chars=200, rephrase_when_too_long=True)
+    assert p.min_instr_chars == 50
+    assert p.max_instr_chars == 200
+    assert p.rephrase_when_too_long is True
+
+    # min > max should raise
+    with pytest.raises(ValueError, match="min_instr_chars"):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=100, max_instr_chars=50)
+
+    # Negative values should raise
+    with pytest.raises(ValueError, match="non-negative"):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=-1, max_instr_chars=50)
+    with pytest.raises(ValueError, match="non-negative"):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=0, max_instr_chars=-5)
+
+    # Boolean values should raise
+    with pytest.raises(ValueError, match="non-boolean"):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=True, max_instr_chars=50)
+    with pytest.raises(ValueError, match="non-boolean"):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=10, max_instr_chars=False)
+
+    # Non-integer types should raise
+    with pytest.raises(ValueError, match="non-boolean"):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False,
+                         min_instr_chars=10.5, max_instr_chars=50)
+
