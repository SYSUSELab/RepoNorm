+class ShortenInstruction(dspy.Signature):
+    """Shorten the given instruction to fit within a maximum number of characters while preserving its meaning."""
+    long_instruction = dspy.InputField(
+        format=str,
+        desc="The instruction that is too long.",
+        prefix="LONG INSTRUCTION:",
+    )
+    max_chars = dspy.InputField(
+        desc="Maximum number of characters for the shortened instruction.",
+        prefix="MAX CHARS:",
+    )
+    proposed_instruction = dspy.OutputField(
+        desc="A shorter version of the instruction that fits within the character limit.",
+        prefix="PROPOSED INSTRUCTION:",
+    )
+
+
 def generate_instruction_class(
     use_dataset_summary=True,
     program_aware=True,
@@ -284,9 +301,24 @@ class GroundedProposer(Proposer):
         set_tip_randomly=True,
