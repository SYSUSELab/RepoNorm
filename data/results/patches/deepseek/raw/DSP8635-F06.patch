         verbose=False,
-        rng=None
+        rng=None,
+        min_instr_chars=30,
+        max_instr_chars=600,
+        rephrase_when_too_long=False,
     ):
         super().__init__()
+        # Validate instruction length bounds
+        if isinstance(min_instr_chars, bool) or isinstance(max_instr_chars, bool):
+            raise ValueError("Instruction length bounds must be non-boolean nonnegative integers.")
+        if not isinstance(min_instr_chars, int) or not isinstance(max_instr_chars, int):
+            raise ValueError("Instruction length bounds must be non-boolean nonnegative integers.")
+        if min_instr_chars < 0 or max_instr_chars < 0:
+            raise ValueError("Instruction length bounds must be non-negative integers.")
+        if min_instr_chars > max_instr_chars:
+            raise ValueError(f"min_instr_chars ({min_instr_chars}) must be <= max_instr_chars ({max_instr_chars}).")
+        self.min_instr_chars = min_instr_chars
+        self.max_instr_chars = max_instr_chars
+        self.rephrase_when_too_long = rephrase_when_too_long
         self.program_aware = program_aware
         self.use_dataset_summary = use_dataset_summary
         self.use_task_demos = use_task_demos
@@ -439,4 +471,129 @@ class GroundedProposer(Proposer):
             self.prompt_model.inspect_history(n=1)
             print(f"PROPOSED INSTRUCTION: {proposed_instruction}")
 
-        return strip_prefix(proposed_instruction)
+        proposed_instruction = strip_prefix(proposed_instruction)
