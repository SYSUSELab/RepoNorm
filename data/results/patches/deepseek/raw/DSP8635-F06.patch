+    def _apply_length_constraints(
+        self,
+        proposed_instruction,
+        program,
+        pred_i,
+    ):
+        """Apply min/max instruction length constraints to the proposed instruction."""
+        min_chars = self.min_instr_chars
+        max_chars = self.max_instr_chars
+
+        measured_len = len(proposed_instruction)
+
+        if max_chars == 0:
+            if self.verbose:
+                print(f"[GroundedProposer] max_instr_chars=0, returning empty string (measured len={measured_len})")
+            return ""
+
+        # If instruction is too short, fall back to canonical basic instruction
+        if measured_len < min_chars:
+            basic_instruction = get_signature(program.predictors()[pred_i]).instructions
+            basic_len = len(basic_instruction)
+            if self.verbose:
+                print(f"[GroundedProposer] Instruction too short: {measured_len} < {min_chars}, falling back to basic instruction (len={basic_len})")
+            proposed_instruction = basic_instruction
+            measured_len = basic_len
+
+        # If instruction is still too long, truncate or rephrase
+        if measured_len > max_chars:
+            if self.rephrase_when_too_long:
+                proposed_instruction = self._rephrase_instruction(
+                    proposed_instruction=proposed_instruction,
+                    max_chars=max_chars,
+                    min_chars=min_chars,
+                    program=program,
+                    pred_i=pred_i,
+                )
+            else:
+                proposed_instruction = self._truncate_instruction(
+                    proposed_instruction=proposed_instruction,
+                    max_chars=max_chars,
+                )
+                if self.verbose:
+                    print(f"[GroundedProposer] Instruction too long, truncated to {len(proposed_instruction)} chars (max={max_chars})")
+
+        return proposed_instruction
+
+    def _truncate_instruction(self, proposed_instruction, max_chars):
+        """Truncate instruction to fit within max_chars using sentence-boundary logic."""
+        if max_chars <= 0:
+            return ""
+
+        # If already within limit, return as is
+        if len(proposed_instruction) <= max_chars:
+            return proposed_instruction
+
+        # Try to find last sentence boundary (. ! ?) followed by whitespace or end of string
+        # that fits within max_chars - 1 (reserving one char for "…")
+        max_shorter = max_chars - 1
+        # Find all sentence boundaries up to max_shorter
+        best_pos = -1
+        for i in range(min(len(proposed_instruction), max_shorter)):
+            if proposed_instruction[i] in '.!?':
+                # Check if followed by whitespace or end of string
+                if i + 1 >= len(proposed_instruction) or proposed_instruction[i + 1] in ' \t\n\r':
+                    if i + 1 <= max_shorter:
+                        best_pos = i + 1  # include the punctuation
+
+        if best_pos > 0:
+            return proposed_instruction[:best_pos] + "…"
+        else:
+            # No sentence boundary found within limit, hard truncate
+            return proposed_instruction[:max_shorter] + "…"
+
+    def _rephrase_instruction(
+        self,
+        proposed_instruction,
+        max_chars,
+        min_chars,
+        program,
+        pred_i,
+    ):
+        """Try to shorten the instruction via LM, with fallback."""
+        # Save LM kwargs to prevent mutation
+        original_kwargs = dict(self.prompt_model.kwargs)
+
+        try:
+            with dspy.settings.context(lm=self.prompt_model):
+                shorten_predictor = dspy.Predict(ShortenInstruction)
+                result = shorten_predictor(
+                    long_instruction=proposed_instruction,
+                    max_chars=str(max_chars),
+                )
+                shortened = strip_prefix(result.proposed_instruction)
+        except Exception:
+            # Generation errors propagate (don't suppress)
+            raise
+        finally:
+            # Restore LM kwargs
+            self.prompt_model.kwargs.clear()
+            self.prompt_model.kwargs.update(original_kwargs)
+
+        # If empty or still shorter than min, fall back to basic instruction
+        if not shortened or len(shortened) < min_chars:
+            basic_instruction = get_signature(program.predictors()[pred_i]).instructions
+            if self.verbose:
+                print(f"[GroundedProposer] Rephrase result empty or too short (len={len(shortened) if shortened else 0} < {min_chars}), "
+                      f"falling back to basic instruction (len={len(basic_instruction)})")
+            shortened = basic_instruction
+
+        # Hard-truncate if still overlong (final safety)
+        if len(shortened) > max_chars:
+            if self.verbose:
+                print(f"[GroundedProposer] Rephrased instruction still too long (len={len(shortened)} > {max_chars}), hard-truncating")
+            shortened = self._truncate_instruction(shortened, max_chars)
+
+        return shortened
