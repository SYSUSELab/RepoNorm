+    def _extract_json_from_markdown(cls, text: str) -> Any:
+        """Try to parse as plain JSON first, then try markdown code fence extraction.
+
+        First accept valid plain JSON without treating backticks inside JSON strings as
+        fences. Otherwise inspect the first triple-backtick block: its opening fence may
+        have any language label (including json, JSON, or no label), followed by a newline;
+        the next triple-backtick delimiter closes it. Parse the trimmed body as JSON,
+        ignoring surrounding prose.
+
+        Returns parsed Python JSON structures on success, or None if extraction fails.
+        """
+        stripped = text.strip()
+        # First try plain JSON parsing (handles backticks inside JSON strings correctly)
+        try:
+            return json.loads(stripped)
+        except json.JSONDecodeError:
+            pass
+
+        # Look for the first triple-backtick block
+        # Opening fence: ``` (optional language label, then newline)
+        if stripped.startswith("```"):
+            first_newline = stripped.find("\n")
+            if first_newline >= 0:
+                body = stripped[first_newline + 1:]
+                # Find closing ```
+                closing = body.rfind("```")
+                if closing >= 0:
+                    inner = body[:closing].strip()
+                    try:
+                        return json.loads(inner)
+                    except json.JSONDecodeError:
+                        pass
+
+        return None
