diff --git a/dirty_equals/_hash.py b/dirty_equals/_hash.py
new file mode 100644
index 0000000..2850523
--- /dev/null
+++ b/dirty_equals/_hash.py
@@ -0,0 +1,67 @@
+import hashlib
+from typing import Any
+
+from ._base import DirtyEquals
+
+__all__ = 'IsHash'
+
+
+# Map of algorithm names (lowercase) to their hex digest lengths
+_HASH_ALGORITHMS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hexadecimal hash of the specified algorithm.
+
+    ```py title='IsHash'
+    from dirty_equals import IsHash
+
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('MD5')
+    assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+    assert 'not a hash' != IsHash('md5')
+    ```
+    """
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm name, case-insensitive.
+                One of 'md5', 'sha1', 'sha224', 'sha256', 'sha384', 'sha512'.
+
+        Raises:
+            ValueError: If the algorithm is not supported.
+        """
+        algorithm_lower = algorithm.lower()
+        if algorithm_lower not in _HASH_ALGORITHMS:
+            raise ValueError(
+                f'Unsupported hash algorithm: {algorithm!r}. '
+                f'Supported algorithms: {", ".join(sorted(_HASH_ALGORITHMS))}'
+            )
+        self.algorithm = algorithm
+        self._algorithm_lower = algorithm_lower
+        self._hex_length = _HASH_ALGORITHMS[algorithm_lower]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if len(other) != self._hex_length:
+            return False
+
+        # Check if all characters are valid hexadecimal digits
+        try:
+            int(other, 16)
+        except ValueError:
+            return False
+
+        return True
diff --git a/tests/test_hash.py b/tests/test_hash.py
new file mode 100644
index 0000000..75d8919
--- /dev/null
+++ b/tests/test_hash.py
@@ -0,0 +1,129 @@
+import pytest
+
+from dirty_equals import IsHash
+
+
+def test_md5():
+    md5_empty = 'd41d8cd98f00b204e9800998ecf8427e'
+    assert md5_empty == IsHash('md5')
+    assert md5_empty == IsHash('MD5')
+    assert md5_empty == IsHash('Md5')
+
+
+def test_sha1():
+    sha1_empty = 'da39a3ee5e6b4b0d3255bfef95601890afd80709'
+    assert sha1_empty == IsHash('sha1')
+    assert sha1_empty == IsHash('SHA1')
+
+
+def test_sha224():
+    sha224_empty = 'd14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f'
+    assert sha224_empty == IsHash('sha224')
+    assert sha224_empty == IsHash('SHA224')
+
+
+def test_sha256():
+    sha256_empty = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
+    assert sha256_empty == IsHash('sha256')
+    assert sha256_empty == IsHash('SHA256')
+
+
+def test_sha384():
+    sha384_empty = '38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b'
+    assert sha384_empty == IsHash('sha384')
+    assert sha384_empty == IsHash('SHA384')
+
+
+def test_sha512():
+    sha512_empty = 'cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e'
+    assert sha512_empty == IsHash('sha512')
+    assert sha512_empty == IsHash('SHA512')
+
+
+def test_not_matching():
+    """Test that non-matching values are rejected."""
+    assert 'not a hash' != IsHash('md5')
+    assert 123 != IsHash('md5')
+    assert [1, 2, 3] != IsHash('md5')
+    assert None != IsHash('md5')
+
+
+def test_wrong_length():
+    """Test that values of wrong length are rejected."""
+    md5_hash = 'd41d8cd98f00b204e9800998ecf8427e'
+    assert md5_hash[:-1] != IsHash('md5')  # too short
+    assert md5_hash + 'f' != IsHash('md5')  # too long
+
+
+def test_mixed_case_hex():
+    """Test that mixed case hex digits are accepted."""
+    assert 'D41D8CD98F00B204E9800998ECF8427E' == IsHash('md5')
+    assert 'D41d8Cd98f00b204e9800998ecf8427e' == IsHash('md5')
+
+
+def test_unsupported_algorithm():
+    """Test that unsupported algorithms raise ValueError."""
+    with pytest.raises(ValueError, match='Unsupported hash algorithm'):
+        IsHash('sha3_256')
+    with pytest.raises(ValueError, match='Unsupported hash algorithm'):
+        IsHash('unknown')
+    with pytest.raises(ValueError, match='Unsupported hash algorithm'):
+        IsHash('md4')
+
+
+def test_repr_preserves_spelling():
+    """Test that repr preserves the original spelling of the algorithm."""
+    h = IsHash('md5')
+    assert repr(h) == "IsHash('md5')"
+
+    h = IsHash('SHA256')
+    assert repr(h) == "IsHash('SHA256')"
+
+    h = IsHash('Md5')
+    assert repr(h) == "IsHash('Md5')"
+
+
+def test_whitespace():
+    """Test that whitespace is not considered valid hex."""
+    md5_hash = 'd41d8cd98f00b204e9800998ecf8427e'
+    assert md5_hash + '\n' != IsHash('md5')
+    assert ' ' + md5_hash != IsHash('md5')
+    assert md5_hash + ' ' != IsHash('md5')
+
+
+def test_value_property():
+    """Test that value property works after a successful comparison."""
+    h = IsHash('md5')
+    md5_hash = 'd41d8cd98f00b204e9800998ecf8427e'
+    assert md5_hash == h
+    assert h.value == md5_hash
+
+
+def test_repr_after_success():
+    """Test that repr returns the compared value after a successful comparison."""
+    h = IsHash('md5')
+    md5_hash = 'd41d8cd98f00b204e9800998ecf8427e'
+    assert md5_hash == h
+    assert repr(h) == repr(md5_hash)
+
+
+def test_repr_after_failure():
+    """Test that repr returns the class representation after a failed comparison."""
+    h = IsHash('md5')
+    with pytest.raises(AssertionError):
+        assert '123' == h
+    assert str(h) == "IsHash('md5')"
+
+
+def test_non_hex_characters():
+    """Test that non-hex characters are rejected."""
+    assert 'd41d8cd98f00b204e9800998ecf8427g' != IsHash('md5')  # 'g' is not hex
+    assert 'd41d8cd98f00b204e9800998ecf8427x' != IsHash('md5')  # 'x' is not hex
+
+
+def test_sha256_known_hash():
+    """Test with a known SHA256 hash."""
+    # SHA256 of "hello"
+    sha256_hello = '2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824'
+    assert sha256_hello == IsHash('sha256')
+    assert sha256_hello == IsHash('SHA256')
