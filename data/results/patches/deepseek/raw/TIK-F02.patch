+pub fn byte_pair_encode_with_positions(
+    piece: &[u8],
+    ranks: &HashMap<Vec<u8>, Rank>,
+) -> Vec<(Rank, usize)> {
+    if piece.len() == 1 {
+        return vec![(ranks[piece], 0)];
+    }
+    _byte_pair_merge(ranks, piece)
+        .windows(2)
+        .map(|part| {
+            let rank = ranks[&piece[part[0].0..part[1].0]];
+            let position = part[0].0; // byte start offset within piece
+            (rank, position)
+        })
+        .collect()
+}
