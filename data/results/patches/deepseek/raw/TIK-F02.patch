+def _byte_to_char_offsets(text: str, byte_positions: list[int]) -> list[int]:
+    """Convert byte positions to zero-based character indices.
+
+    If a token starts inside a multibyte character, use the index of that
+    containing character.
+    """
+    if not byte_positions:
+        return []
+
+    encoded = text.encode("utf-8")
+
+    # Build byte-to-character index mapping
+    byte_to_char = []
+    i = 0
+    char_idx = 0
+    while i < len(encoded):
+        b = encoded[i]
+        if b < 0x80:
+            # 1-byte character
+            byte_to_char.append(char_idx)
+            i += 1
+            char_idx += 1
+        elif b < 0xC0:
+            # Continuation byte - not a start byte
+            byte_to_char.append(char_idx - 1 if char_idx > 0 else 0)
+            i += 1
+        elif b < 0xE0:
+            # 2-byte character
+            for _ in range(2):
+                byte_to_char.append(char_idx)
+            i += 2
+            char_idx += 1
+        elif b < 0xF0:
+            # 3-byte character
+            for _ in range(3):
+                byte_to_char.append(char_idx)
+            i += 3
+            char_idx += 1
+        elif b < 0xF8:
+            # 4-byte character
+            for _ in range(4):
+                byte_to_char.append(char_idx)
+            i += 4
+            char_idx += 1
+        else:
+            byte_to_char.append(char_idx)
+            i += 1
+            char_idx += 1
+
+    return [byte_to_char[bp] for bp in byte_positions]
+
