+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize flexible input formats into the canonical ToolCalls structure.
+
+        This helper accepts the following equivalent inputs and returns a normalized
+        dictionary with a ``tool_calls`` key (or the original input unchanged for
+        non-JSON strings, or the original model instance for existing ToolCalls objects):
+
+        * ``{"tool_calls": [{"name": "...", "args": {...}}, ...]}`` (existing format)
+        * ``{"name": "...", "args": {...}}`` (single tool call object)
+        * ``[{"name": "...", "args": {...}}, ...]`` (bare list, including empty list)
+        * Plain JSON strings representing any of the above.
+
+        JSON text is parsed and normalized; non-JSON strings are returned unchanged.
+        Existing ``ToolCalls`` model instances are passed through unchanged.
+
+        Args:
+            data: The input data in any of the supported formats.
+
+        Returns:
+            A normalized dictionary with a ``tool_calls`` key, or the original input
+            if it is a non-JSON string or an existing ``ToolCalls`` instance.
+        """
+        # Pass through existing ToolCalls instances unchanged.
+        if isinstance(data, ToolCalls):
+            return data
+
+        # Parse JSON strings to Python objects.
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                # Non-JSON strings are returned unchanged.
+                return data
+
+        # Normalize a bare list of tool call dicts.
+        if isinstance(data, list):
+            return {"tool_calls": data}
+
+        # Normalize a single tool call object.
+        if isinstance(data, dict) and "name" in data and "args" in data:
+            # Only if "tool_calls" key is absent (existing format already has it).
+            if "tool_calls" not in data:
+                return {"tool_calls": [data]}
+
+        # Already in canonical format or another dict shape — return as-is.
+        return data
+
+    @model_validator(mode='before')
