+    r"(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]?|0)"
+    r"|localhost"
+    r"|(?:"
+    r"(?![0-9]+\.(?:[0-9]+\.){2}[0-9]+$)"
+    r"(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+"
+    r"[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?"
+    r")"
+    r")"
+    r"(?::[0-9]{1,5})?"
+    r"(?:/[^\s#?]*)?"
+    r"(?:\?[^\s#]+)?"
+    r"(?:#[^\s]+)?"
+)
