+            if isinstance(chunk_size, bool):
+                raise ValueError(f"chunk_size must be a positive integer, got {type(chunk_size).__name__}")
+            if not isinstance(chunk_size, int):
+                raise ValueError(f"chunk_size must be a positive integer, got {type(chunk_size).__name__}")
+            if chunk_size <= 0:
+                raise ValueError(f"chunk_size must be a positive integer, got {chunk_size}")
+            if isinstance(chunk_overlap, bool):
+                raise ValueError(f"chunk_overlap must be an integer, got {type(chunk_overlap).__name__}")
+            if not isinstance(chunk_overlap, int):
