+def _validate_tokens(
+    tokens: list[int],
+    validators: Sequence[Callable[[list[int]], bool | None]],
+) -> None:
+    """Apply validators to a copy of the token list.
+
+    Each validator receives an independent copy of the tokens, in order.
+    Mutating that copy must not alter returned tokens or another validator's input.
+    False raises ValueError; None and True mean acceptance.
+    Callback exceptions propagate unchanged.
+    On failure, later validators for that document are not called.
+    """
+    for validator in validators:
+        # Give each validator an independent copy so mutations don't affect others or the result
+        tokens_copy = list(tokens)
+        result = validator(tokens_copy)
+        if result is False:
+            raise ValueError(
+                "Token validation failed: validator returned False"
+            )
+        # None and True mean acceptance
