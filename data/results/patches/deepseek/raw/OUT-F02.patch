+    def _compile(self, kind: str, source: str) -> str:
+        """Compile a grammar string using the appropriate method.
+
+        Parameters
+        ----------
+        kind
+            One of ``"json_schema"``, ``"regex"``, or ``"cfg"``.
+        source
+            The source string to compile.
+
+        Returns
+        -------
+        str
+            The compiled grammar string.
+
+        """
+        if kind == "json_schema":
+            return self.grammar_compiler.compile_json_schema(source)
+        elif kind == "regex":
+            return self.grammar_compiler.compile_regex(source)
+        elif kind == "cfg":
+            return self.grammar_compiler.compile_grammar(source)
+        else:
+            raise ValueError(f"Unknown grammar kind: {kind}")
+
+    def _get_cached_or_compile(self, kind: str, source: str) -> str:
+        """Return a compiled grammar, using the cache when enabled.
+
+        Parameters
+        ----------
+        kind
+            The grammar kind: ``"json_schema"``, ``"regex"``, or ``"cfg"``.
+        source
+            The source string to compile.
+
+        Returns
+        -------
+        str
+            The compiled grammar string.
+
+        """
+        key = (kind, source)
+
+        # Fast path: no caching
+        if not self._cache_enabled:
+            return self._compile(kind, source)
+
+        # Fast path: already cached
+        with self._cache_lock:
+            if key in self._cache:
+                # Move to end to mark as most recently used
+                self._cache.move_to_end(key)
+                return self._cache[key]
+
+            # Check if another thread is already compiling this key
+            if key in self._pending:
+                pending = self._pending[key]
+            else:
+                pending = None
+
+        if pending is not None:
+            # Wait for the in-progress compilation to finish
+            pending.event.wait()
+            if pending.error is not None:
+                raise pending.error
+            return pending.result
+
+        # We are responsible for compiling this key
+        pending = _PendingCompilation()
+        needs_compile = True
+
+        with self._cache_lock:
+            # Double-check: the cache may have been populated while we
+            # were not holding the lock.
+            if key in self._cache:
+                self._cache.move_to_end(key)
+                return self._cache[key]
+            if key in self._pending:
+                # Another thread started compiling in the meantime
+                pending = self._pending[key]
+                needs_compile = False
+            else:
+                self._pending[key] = pending
+
+        if not needs_compile:
+            # Wait for the other thread to finish
+            pending.event.wait()
+            if pending.error is not None:
+                raise pending.error
+            return pending.result
+
+        # Perform the compilation (outside the lock)
+        try:
+            compiled = self._compile(kind, source)
+        except Exception as exc:
+            with self._cache_lock:
+                pending.error = exc
+                pending.event.set()
+                # Remove from pending so a later request can retry
+                if key in self._pending:
+                    del self._pending[key]
+            raise
+
+        # Store the successful result
+        with self._cache_lock:
+            # Evict LRU entry if the cache is at capacity
+            if (
+                self._max_cached_grammars is not None
+                and len(self._cache) >= self._max_cached_grammars
+            ):
+                self._cache.popitem(last=False)
+
+            self._cache[key] = compiled
+            pending.result = compiled
+            pending.event.set()
+            if key in self._pending:
+                del self._pending[key]
+
+        return compiled
