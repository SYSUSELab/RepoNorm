+    def type_cast_value(self, ctx: Context, value: t.Any) -> t.Any:
+        """Convert and validate a value against the option's
+        :attr:`type`, :attr:`multiple`, and :attr:`nargs`.
+
+        When :attr:`cache` is enabled and the conditions are met, a
+        successful conversion result may be reused for the same hashable
+        raw scalar value across invocations in the current process.
+        """
+        if not self.cache:
+            return super().type_cast_value(ctx, value)
+
+        if value is None:
+            return super().type_cast_value(ctx, value)
+
+        # Do not cache File or Path types
+        if isinstance(self.type, (types.File, types.Path)):
+            return super().type_cast_value(ctx, value)
+
+        # Do not cache multiple=True or nargs != 1
+        if self.multiple or self.nargs != 1:
+            return super().type_cast_value(ctx, value)
+
+        # Only cache hashable values
+        try:
+            hash(value)
+        except TypeError:
+            return super().type_cast_value(ctx, value)
+
+        # Check cache
+        if value in self._value_cache:
+            return self._value_cache[value]
+
+        # Perform conversion and cache on success
+        result = super().type_cast_value(ctx, value)
+        self._value_cache[value] = result
+        return result
+
+    def clear_value_cache(self) -> None:
+        """Clear the type conversion cache for this option.
+
+        Discards all cached type-conversion results. Future invocations
+        will convert values from scratch.
+        """
+        self._value_cache.clear()
+
