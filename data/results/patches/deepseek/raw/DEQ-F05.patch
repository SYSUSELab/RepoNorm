@@ -0,0 +1,148 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+
+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    Validator for phone number validation.
+
+    Supports both generic phone number validation and country-specific validation
+    for US and GB phone numbers.
+
+    Examples:
+    ```py title="IsPhoneNumber"
+    from dirty_equals import IsPhoneNumber
+
+    # Generic validation
+    assert '+1-555-123-4567' == IsPhoneNumber()
+    assert '555-123-4567' == IsPhoneNumber()
+
+    # US validation
+    assert '+1-555-123-4567' == IsPhoneNumber('US')
+    assert '555-123-4567' == IsPhoneNumber('US')
+
+    # GB validation
+    assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+    assert '020 7946 0958' == IsPhoneNumber('GB')
+    ```
+    """
+
+    def __init__(self, country: Optional[str] = None):
+        """
+        Args:
+            country: Optional two-letter country code (e.g., 'US', 'GB').
+                Case-insensitive.
+        """
+        self.country = country.upper() if country else None
+        if country:
+            super().__init__(plain_repr(f"'{country.upper()}'"))
+        else:
+            super().__init__(plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Validate characters
+        if not self._validate_characters(other):
+            return False
+
+        # Extract digits
+        digits = re.sub(r'[^\d]', '', other)
+
+        # Check if international (starts with +)
+        is_international = other.startswith('+')
+
+        if self.country:
+            return self._validate_with_country(digits, is_international)
+        else:
+            return self._validate_generic(digits, is_international)
+
+    def _validate_characters(self, s: str) -> bool:
+        """Validate that the string contains only allowed characters."""
+        allowed_chars = set('0123456789 \t-.+()')
+        for c in s:
+            if c not in allowed_chars:
+                return False
+
+        # Check plus sign: at most one, at the start
+        plus_count = s.count('+')
+        if plus_count > 1:
+            return False
+        if plus_count == 1 and not s.startswith('+'):
+            return False
+
+        # Check parentheses: balanced, non-nested, containing digits
+        if not self._validate_parentheses(s):
+            return False
+
+        return True
+
+    def _validate_parentheses(self, s: str) -> bool:
+        """Validate parentheses: balanced, non-nested, containing digits."""
+        depth = 0
+        last_open = -1
+        for i, c in enumerate(s):
+            if c == '(':
+                if depth > 0:
+                    # Nested parentheses
+                    return False
+                depth += 1
+                last_open = i
+            elif c == ')':
+                if depth == 0:
+                    # Unmatched closing parenthesis
+                    return False
+                # Check if parentheses contain at least one digit
+                content = s[last_open + 1:i]
+                if not re.search(r'\d', content):
+                    return False
+                last_open = -1
+                depth -= 1
+
+        if depth != 0:
+            # Unmatched opening parenthesis
+            return False
+
+        return True
+
+    def _validate_generic(self, digits: str, is_international: bool) -> bool:
+        """Validate without country code."""
+        if is_international:
+            # + followed by 8-19 digits
+            return 8 <= len(digits) <= 19
+        else:
+            # National: 7-15 digits
+            return 7 <= len(digits) <= 15
+
+    def _validate_with_country(self, digits: str, is_international: bool) -> bool:
+        """Validate with country-specific rules."""
+        country = self.country
+
+        if country == 'US':
+            if is_international:
+                # +1 followed by 10 digits = 11 digits total
+                return len(digits) == 11 and digits.startswith('1')
+            else:
+                # National: 10 digits
+                return len(digits) == 10
+
+        elif country == 'GB':
+            if is_international:
+                # +44 followed by 10-11 digits = 12-13 digits total
+                return len(digits) in (12, 13) and digits.startswith('44')
+            else:
+                # National: 10-11 digits starting with 0
+                return 10 <= len(digits) <= 11 and digits.startswith('0')
+
+        else:
+            # Unknown country - use generic syntax
+            if is_international:
+                # + followed by 8-19 digits
+                return 8 <= len(digits) <= 19
+            else:
+                # National: 7-15 digits
+                return 7 <= len(digits) <= 15
diff --git a/tests/test_phone.py b/tests/test_phone.py
