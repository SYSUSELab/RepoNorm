@@ -0,0 +1,227 @@
+import pytest
+from dirty_equals import IsPhoneNumber
+
+
+class TestGenericValidator:
+    """Tests for IsPhoneNumber() without a country code."""
+
+    def test_international_valid(self):
+        assert '+1-555-123-4567' == IsPhoneNumber()
+        assert '+44 20 7946 0958' == IsPhoneNumber()
+        assert '+33 1 23 45 67 89' == IsPhoneNumber()
+        assert '+81-3-1234-5678' == IsPhoneNumber()
+        assert '+1234567890' == IsPhoneNumber()
+
+    def test_national_valid(self):
+        assert '555-123-4567' == IsPhoneNumber()
+        assert '020 7946 0958' == IsPhoneNumber()
+        assert '1234567890' == IsPhoneNumber()
+        assert '1234567' == IsPhoneNumber()  # minimum 7 digits
+
+    def test_international_bounds(self):
+        # Minimum: + followed by 8 digits
+        assert '+' + '1' * 8 == IsPhoneNumber()
+        # Maximum: + followed by 19 digits
+        assert '+' + '1' * 19 == IsPhoneNumber()
+        # Below minimum
+        assert '+' + '1' * 7 != IsPhoneNumber()
+        # Above maximum
+        assert '+' + '1' * 20 != IsPhoneNumber()
+
+    def test_national_bounds(self):
+        # Minimum: 7 digits
+        assert '1' * 7 == IsPhoneNumber()
+        # Maximum: 15 digits
+        assert '1' * 15 == IsPhoneNumber()
+        # Below minimum
+        assert '1' * 6 != IsPhoneNumber()
+        # Above maximum
+        assert '1' * 16 != IsPhoneNumber()
+
+    def test_non_string_types(self):
+        assert IsPhoneNumber() != 123
+        assert IsPhoneNumber() != 123.45
+        assert IsPhoneNumber() != [1, 2, 3]
+        assert IsPhoneNumber() != {'phone': '123'}
+        assert IsPhoneNumber() is not None
+        assert IsPhoneNumber() != True
+        assert IsPhoneNumber() != b'+1-555-123-4567'
+
+    def test_invalid_characters(self):
+        assert IsPhoneNumber() != '+1-555-123-4567\n'
+        assert IsPhoneNumber() != 'abc'
+        assert IsPhoneNumber() != '+1-555-ABC-4567'
+        assert IsPhoneNumber() != '555-123-4567!'
+
+    def test_plus_sign_rules(self):
+        # At most one plus, must be at start
+        assert IsPhoneNumber() != '1-555-123-4567+'  # plus at end
+        assert IsPhoneNumber() != '+1-555+123-4567'  # two pluses
+        assert IsPhoneNumber() != '++1-555-123-4567'  # two pluses at start
+
+    def test_parentheses_rules(self):
+        assert '(555) 123 4567' == IsPhoneNumber()
+        assert '555 (123) 4567' == IsPhoneNumber()
+        # Empty parentheses
+        assert '() 1234567' != IsPhoneNumber()
+        # Nested parentheses
+        assert '((555)) 1234567' != IsPhoneNumber()
+        # Unbalanced
+        assert '(555 123 4567' != IsPhoneNumber()
+        assert '555) 123(4567' != IsPhoneNumber()
+
+    def test_allowed_separators(self):
+        # Tabs
+        assert '+1\t555\t123\t4567' == IsPhoneNumber()
+        # Dots
+        assert '+1.555.123.4567' == IsPhoneNumber()
+        # Multiple spaces
+        assert '555   123   4567' == IsPhoneNumber()
+        # Multiple dashes
+        assert '+1--555--123--4567' == IsPhoneNumber()
+
+    def test_empty_string(self):
+        assert IsPhoneNumber() != ''
+
+    def test_repr(self):
+        assert repr(IsPhoneNumber()) == 'IsPhoneNumber(*)'
+
+    def test_false_repr(self):
+        is_phone = IsPhoneNumber()
+        with pytest.raises(AssertionError):
+            assert 123 == is_phone
+        assert str(is_phone) == 'IsPhoneNumber(*)'
+
+
+class TestUSValidator:
+    """Tests for IsPhoneNumber('US')."""
+
+    def test_national_valid(self):
+        assert '555-123-4567' == IsPhoneNumber('US')
+        assert '5551234567' == IsPhoneNumber('US')
+        assert '555.123.4567' == IsPhoneNumber('US')
+        assert '(555) 123-4567' == IsPhoneNumber('US')
+
+    def test_international_valid(self):
+        assert '+1-555-123-4567' == IsPhoneNumber('US')
+        assert '+1 555 123 4567' == IsPhoneNumber('US')
+        assert '+1.555.123.4567' == IsPhoneNumber('US')
+        assert '+1 (555) 123-4567' == IsPhoneNumber('US')
+
+    def test_rejects_11_digit_national(self):
+        # 11 digits without +1 should be rejected for US
+        assert '15551234567' != IsPhoneNumber('US')
+        assert '1 555 123 4567' != IsPhoneNumber('US')
+
+    def test_rejects_wrong_country_code(self):
+        # +44 is not US
+        assert '+44 20 7946 0958' != IsPhoneNumber('US')
+        # +33 is not US
+        assert '+33 1 23 45 67 89' != IsPhoneNumber('US')
+
+    def test_rejects_wrong_length(self):
+        # Too short
+        assert '555-123-456' != IsPhoneNumber('US')  # 9 digits
+        # Too long
+        assert '555-123-45678' != IsPhoneNumber('US')  # 11 digits
+
+    def test_rejects_non_string(self):
+        assert IsPhoneNumber('US') != 123
+        assert IsPhoneNumber('US') is not None
+
+    def test_repr(self):
+        assert repr(IsPhoneNumber('US')) == "IsPhoneNumber('US')"
+        assert repr(IsPhoneNumber('us')) == "IsPhoneNumber('US')"
+
+
+class TestGBValidator:
+    """Tests for IsPhoneNumber('GB')."""
+
+    def test_national_valid(self):
+        assert '020 7946 0958' == IsPhoneNumber('GB')
+        assert '01632 960 001' == IsPhoneNumber('GB')
+        assert '07700 900 982' == IsPhoneNumber('GB')
+        assert '0' + '1' * 9 == IsPhoneNumber('GB')  # 10 digits starting with 0
+        assert '0' + '1' * 10 == IsPhoneNumber('GB')  # 11 digits starting with 0
+
+    def test_international_valid(self):
+        assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+        assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+        assert '+44 07700 900 982' == IsPhoneNumber('GB')  # +44 then 10 digits (0 followed by 9 more)
+        # +44 followed by 11 digits (12 total w/+44)
+        assert '+44 1234567890 1' == IsPhoneNumber('GB')
+
+    def test_rejects_no_leading_zero(self):
+        # National must start with 0
+        assert '20 7946 0958' != IsPhoneNumber('GB')  # no leading 0
+
+    def test_rejects_wrong_country_code(self):
+        # +1 is not GB
+        assert '+1-555-123-4567' != IsPhoneNumber('GB')
+        # +33 is not GB
+        assert '+33 1 23 45 67 89' != IsPhoneNumber('GB')
+
+    def test_rejects_wrong_length(self):
+        # Too short (8 digits)
+        assert '0' + '1' * 8 != IsPhoneNumber('GB')  # 9 digits, below minimum 10
+        # Too long
+        assert '0' + '1' * 11 != IsPhoneNumber('GB')  # 12 digits, above maximum 11
+
+    def test_rejects_non_string(self):
+        assert IsPhoneNumber('GB') != 123
+        assert IsPhoneNumber('GB') is not None
+
+    def test_case_insensitive(self):
+        assert '+44 20 7946 0958' == IsPhoneNumber('gb')
+        assert '+44 20 7946 0958' == IsPhoneNumber('Gb')
+        assert '+44 20 7946 0958' == IsPhoneNumber('gB')
+
+    def test_repr(self):
+        assert repr(IsPhoneNumber('GB')) == "IsPhoneNumber('GB')"
+        assert repr(IsPhoneNumber('gb')) == "IsPhoneNumber('GB')"
+
+
+class TestUnknownCountryValidator:
+    """Tests for IsPhoneNumber('FR') or other unsupported countries."""
+
+    def test_fallback_to_generic_international(self):
+        assert '+33 1 23 45 67 89' == IsPhoneNumber('FR')
+        assert '+49 30 123456' == IsPhoneNumber('DE')
+        assert '+81 3 1234 5678' == IsPhoneNumber('JP')
+
+    def test_fallback_to_generic_national(self):
+        # Generic national: 7-15 digits
+        assert '1234567890' == IsPhoneNumber('FR')
+        assert '1234567' == IsPhoneNumber('FR')
+        assert '123456789012345' == IsPhoneNumber('FR')
+
+    def test_fallback_bounds(self):
+        assert '+' + '1' * 8 == IsPhoneNumber('FR')
+        assert '+' + '1' * 19 == IsPhoneNumber('FR')
+        assert '+' + '1' * 7 != IsPhoneNumber('FR')
+        assert '+' + '1' * 20 != IsPhoneNumber('FR')
+
+    def test_repr(self):
+        assert repr(IsPhoneNumber('FR')) == "IsPhoneNumber('FR')"
+
+
+class TestOperators:
+    """Tests for |, &, ~ operators."""
+
+    def test_or(self):
+        p_or_hello = IsPhoneNumber() | 'hello'
+        assert p_or_hello == 'hello'
+        assert p_or_hello == '+1-555-123-4567'
+        assert p_or_hello != 123
+        assert p_or_hello != 'world'
+
+    def test_and(self):
+        p_and_us = IsPhoneNumber() & IsPhoneNumber('US')
+        assert p_and_us == '+1-555-123-4567'
+        assert p_and_us != '+44 20 7946 0958'
+
+    def test_invert(self):
+        not_phone = ~IsPhoneNumber()
+        assert not_phone == 123
+        assert not_phone == 'abc'
+        assert not_phone != '+1-555-123-4567'
