+# Global filter registry
+_global_filters: Dict[str, Callable] = {}
+
+# Protected filter names that cannot be overridden by global filters
+_PROTECTED_FILTER_NAMES = frozenset([
+    "name", "description", "source", "signature", "schema", "args"
+])
+
+
+def register_filter(name: str, callable_fn: Callable) -> None:
+    """Register a global Jinja2 filter for prompts.
+
+    Registered filters are available to prompts subsequently constructed through
+    bare `@outlines.prompt`, `Prompt.from_str`, and `Prompt.from_file`, including
+    included and inherited file templates.
+
+    Registering an existing name replaces its registered callable, unless the
+    name is one of the protected Outlines-specific filters (``name``,
+    ``description``, ``source``, ``signature``, ``schema``, ``args``).
+
+    Registry changes affect only templates constructed after the change: an
+    existing ``Prompt`` retains the filter callable captured by its Jinja
+    environment.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter to register.
+    callable_fn : Callable
+        The callable to register as a filter.
+    """
+    _global_filters[name] = callable_fn
+
+
+def unregister_filter(name: str) -> None:
+    """Unregister a global Jinja2 filter for prompts.
+
+    Unregistering an unknown name is a no-op.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter to unregister.
+    """
+    _global_filters.pop(name, None)
+
+
+def _apply_global_filters(env: jinja2.Environment) -> None:
+    """Apply global filters to a Jinja2 environment.
+
+    This applies all registered global filters to the environment, except
+    for protected filter names that belong to Outlines.
+
+    Parameters
+    ----------
+    env : jinja2.Environment
+        The Jinja2 environment to apply filters to.
+    """
+    for name, callable_fn in _global_filters.items():
+        if name not in _PROTECTED_FILTER_NAMES:
+            env.filters[name] = callable_fn
+
 
