     :func:`itertools.groupby`. The attribute can use dot notation for
@@ -1203,6 +1204,17 @@ def sync_do_groupby(
           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    By default, string keys that differ only by case are grouped
+    together. The spelling of the first key encountered is used for
+    the group. Set ``case_sensitive`` to ``True`` to keep them
+    separate.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", case_sensitive=True) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,10 +1222,26 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+
+    if case_sensitive:
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+
+    # Case-insensitive grouping: string keys differing only by
+    # case are grouped together, using the spelling of the first
+    # key encountered.
+    key_func = lambda x: ignore_case(expr(x))
+    sorted_value = sorted(value, key=key_func)
+    result = []
+
+    for _, values in groupby(sorted_value, key=key_func):
+        values_list = list(values)
+        original_key = expr(values_list[0])
+        result.append(_GroupTuple(original_key, values_list))
+
+    return result
 
 
