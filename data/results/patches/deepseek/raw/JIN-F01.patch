 ) -> "t.List[t.Tuple[t.Any, t.List[V]]]":
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, await auto_to_list(values))
-        for key, values in groupby(sorted(await auto_to_list(value), key=expr), expr)
-    ]
+
+    if case_sensitive:
+        return [
+            _GroupTuple(key, await auto_to_list(values))
+            for key, values in groupby(
+                sorted(await auto_to_list(value), key=expr), expr
+            )
+        ]
+
+    key_func = lambda x: ignore_case(expr(x))
+    async_value = await auto_to_list(value)
+    sorted_value = sorted(async_value, key=key_func)
+    result = []
+
+    for _, values in groupby(sorted_value, key=key_func):
+        values_list = await auto_to_list(values)
+        original_key = expr(values_list[0])
+        result.append(_GroupTuple(original_key, values_list))
+
+    return result
 
 
