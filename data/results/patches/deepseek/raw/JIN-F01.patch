@@ -94,6 +94,50 @@ def test_groupby_multidot(env_async, articles):
     ]
 
 
+@mark_dualiter(
+    "items",
+    lambda: [
+        {"name": "A", "city": "NY"},
+        {"name": "B", "city": "ny"},
+        {"name": "C", "city": "NY"},
+    ],
+)
+def test_groupby_case_sensitive(env_async, items):
+    # default case_sensitive=False groups differently-cased strings
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('city') -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.name }}{% endfor %}|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items) == "NY:A:B:C|"
+
+    # case_sensitive=True keeps differently-cased keys separate
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('city', case_sensitive=True) -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.name }}{% endfor %}|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items) == "NY:A:C|ny:B|"
+
+
+@mark_dualiter("items", lambda: [("a", 1), ("A", 2), ("b", 1)])
+def test_groupby_case_sensitive_tuple_index(env_async, items):
+    # case_sensitive=False (default) with tuple index
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby(0) -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.1 }}{% endfor %}|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items) == "a:1:2|b:1|"
+
+    # case_sensitive=True with tuple index
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby(0, case_sensitive=True) -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.1 }}{% endfor %}|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items) == "A:2|a:1|b:1|"
+
