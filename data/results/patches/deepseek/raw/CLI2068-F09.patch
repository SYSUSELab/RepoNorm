+_EDITOR_ALLOWLIST = frozenset({
+    "PATH", "HOME", "USER", "USERNAME", "LOGNAME", "SHELL", "TERM",
+    "DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "LANG", "LANGUAGE",
+    "LC_ALL", "LC_CTYPE", "LC_MESSAGES", "TMPDIR", "TMP", "TEMP",
+    "SYSTEMROOT", "COMSPEC", "PATHEXT",
+})
+
+
+def _get_editor_env(isolate_env: bool, env: cabc.Mapping[str, str] | None) -> dict[str, str] | None:
+    """Build the environment dict for the editor subprocess."""
+    if isolate_env:
+        lower_allowlist = {name.lower() for name in _EDITOR_ALLOWLIST}
+        environ = {}
+        for key, value in os.environ.items():
+            if key.lower() in lower_allowlist:
+                environ[key] = value
+        if env:
+            environ.update(env)
+        return environ
+    else:
+        if env:
+            environ = os.environ.copy()
+            environ.update(env)
+            return environ
+        return None
+
+
