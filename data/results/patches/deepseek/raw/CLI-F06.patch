+    def save_state(self) -> dict[str, t.Any]:
+        """Save the current parsing and presentation state as a snapshot.
+
+        The snapshot is a dictionary that can be used to restore the
+        context's state via :meth:`restore_state`.  Mutable values in the
+        snapshot are independent of the source context; shared references
+        and cycles are preserved.
+
+        :return: A dictionary representing the current state.
+        """
+        import copy
+
+        # Deep-copy all mutable fields together so that shared references
+        # between them (e.g. obj pointing to _meta) are preserved via a
+        # single memo dictionary.
+        state = {
+            "params": self.params,
+            "args": self.args,
+            "_protected_args": self._protected_args,
+            "_opt_prefixes": self._opt_prefixes,
+            "obj": self.obj,
+            "_meta": self._meta,
+            "default_map": self.default_map,
+            "invoked_subcommand": self.invoked_subcommand,
+            "terminal_width": self.terminal_width,
+            "max_content_width": self.max_content_width,
+            "allow_extra_args": self.allow_extra_args,
+            "allow_interspersed_args": self.allow_interspersed_args,
+            "ignore_unknown_options": self.ignore_unknown_options,
+            "resilient_parsing": self.resilient_parsing,
+            "help_option_names": self.help_option_names,
+            "token_normalize_func": self.token_normalize_func,
+            "auto_envvar_prefix": self.auto_envvar_prefix,
+            "color": self.color,
+            "show_default": self.show_default,
+            "_parameter_source": self._parameter_source,
+        }
+        return copy.deepcopy(state)
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Restore the context state from a snapshot.
+
+        The snapshot must be a dictionary previously returned by
+        :meth:`save_state`.  Restoring is transactional: if the snapshot
+        is missing required keys, contains an invalid ``_meta``, or a
+        value cannot be copied, the context is left unchanged.
+
+        The ``_meta`` dictionary is updated in place so that the shared
+        metadata dictionary between parent and child contexts is
+        preserved.  References to that dictionary from other restored
+        fields are redirected to the same shared dictionary.
+
+        Unknown keys in the snapshot are ignored.
+
+        :param snapshot: A snapshot previously obtained by
+            :meth:`save_state`.
+        :raises ValueError: If the snapshot is missing required keys.
+        :raises TypeError: If ``_meta`` is not a dictionary.
+        """
+        import copy
+
+        _required_keys = {
+            "params",
+            "args",
+            "_protected_args",
+            "_opt_prefixes",
+            "obj",
+            "_meta",
+            "default_map",
+            "invoked_subcommand",
+            "terminal_width",
+            "max_content_width",
+            "allow_extra_args",
+            "allow_interspersed_args",
+            "ignore_unknown_options",
+            "resilient_parsing",
+            "help_option_names",
+            "token_normalize_func",
+            "auto_envvar_prefix",
+            "color",
+            "show_default",
+            "_parameter_source",
+        }
+
+        if not _required_keys.issubset(snapshot.keys()):
+            missing = _required_keys - snapshot.keys()
+            raise ValueError(
+                f"Snapshot is missing required keys: "
+                f"{', '.join(sorted(missing))}"
+            )
+
+        if not isinstance(snapshot["_meta"], dict):
+            raise TypeError("Snapshot key '_meta' must be a dictionary.")
+
+        # Deep-copy the metadata contents first so that we can update
+        # the existing shared ``_meta`` dictionary in place later.
+        meta_contents = copy.deepcopy(snapshot["_meta"])
+
+        # Deep-copy every other field with a memo that redirects
+        # references to the snapshot's ``_meta`` to the context's own
+        # ``_meta`` dictionary.
+        memo: dict[int, t.Any] = {id(snapshot["_meta"]): self._meta}
+
+        restored: dict[str, t.Any] = {}
+        for key in _required_keys:
+            if key == "_meta":
+                continue
+            restored[key] = copy.deepcopy(snapshot[key], memo)
+
+        # --- everything copied successfully; apply changes ---
+
+        self._meta.clear()
+        self._meta.update(meta_contents)
+
+        for key, value in restored.items():
+            setattr(self, key, value)
+
+
 
