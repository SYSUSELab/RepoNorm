+
+def extract_from_ast_with_metadata(
+    ast: nodes.Template,
+    gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
+    source: t.Optional[str] = None,
+) -> t.Iterator[t.Dict[str, t.Any]]:
+    """Extract localizable strings with metadata from the given template node.
+
+    Returns an iterator of record mappings for metadata-bearing translation blocks.
+    Each record contains ``source``, the block ``lineno``, a copied ``metadata``
+    mapping, and ``messages``.
+
+    Each message contains the ordinary extraction ``lineno``, gettext ``function``,
+    and extracted ``message`` value.
+    """
+    from copy import deepcopy
+
+    for node in ast.find_all(nodes.Output):
+        metadata = getattr(node, "metadata", None)
+        if not metadata:
+            continue
+
+        messages = []
+        for call_node in node.find_all(nodes.Call):
+            if (
+                not isinstance(call_node.node, nodes.Name)
+                or call_node.node.name not in gettext_functions
+            ):
+                continue
+
+            strings: t.List[t.Optional[str]] = []
+            for arg in call_node.args:
+                if isinstance(arg, nodes.Const) and isinstance(arg.value, str):
+                    strings.append(arg.value)
+                else:
+                    strings.append(None)
+
+            for _ in call_node.kwargs:
+                strings.append(None)
+            if call_node.dyn_args is not None:
+                strings.append(None)
+            if call_node.dyn_kwargs is not None:
+                strings.append(None)
+
+            if len(strings) == 1:
+                out: t.Union[t.Optional[str], t.Tuple[t.Optional[str], ...]] = strings[0]
+            else:
+                out = tuple(strings)
+
+            messages.append({
+                "lineno": call_node.lineno,
+                "function": call_node.node.name,
+                "message": out,
+            })
+
+        yield {
+            "source": source if source else ast,
+            "lineno": node.lineno,
+            "metadata": deepcopy(metadata),
+            "messages": messages,
+        }
+
