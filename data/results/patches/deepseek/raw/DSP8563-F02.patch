+def parse_python_calls(text: str) -> dict:
+    """Parse a safe subset of Python-style tool calls.
+
+    Accepts one or more top-level calls separated by newlines or semicolons.
+    Returns {"tool_calls": [{"name": ..., "args": {...}}, ...]}.
+
+    Raises ValueError for invalid input.
+    """
+    # Validate input
+    if not text or not text.strip():
+        raise ValueError('Empty input is not allowed')
+
+    # Check for comments (# outside of string literals)
+    _check_comments(text)
+
+    # Parse the text using ast
+    try:
+        tree = ast.parse(text.strip(), mode='exec')
+    except SyntaxError as e:
+        raise ValueError(f'Syntax error: {e}')
+
+    result = {'tool_calls': []}
+
+    for node in tree.body:
+        if not isinstance(node, ast.Expr):
+            raise ValueError(f'Expected a call expression, got {type(node).__name__}')
+
+        if not isinstance(node.value, ast.Call):
+            raise ValueError(f'Expected a function call, got {type(node.value).__name__}')
+
+        call = node.value
+        tool_name = _extract_tool_name(call)
+        args = _extract_args(call)
+
+        result['tool_calls'].append({'name': tool_name, 'args': args})
+
+    if not result['tool_calls']:
+        raise ValueError('No tool calls found')
+
+    return result
+
+
+def _check_comments(text: str) -> None:
+    """Check for Python comments (# outside of string literals)."""
+    try:
+        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
+        for tok in tokens:
+            if tok.type == tokenize.COMMENT:
+                raise ValueError('Python comments are not allowed')
+    except tokenize.TokenError as e:
+        raise ValueError(f'Tokenization error: {e}')
+
+
+def _extract_tool_name(call_node):
+    """Extract the tool name from a Call node. Use the final identifier."""
+    func = call_node.func
+
+    if isinstance(func, ast.Name):
+        return func.id
+    elif isinstance(func, ast.Attribute):
+        # Walk down the attribute chain to verify it's dot-separated identifiers
+        current = func
+        while isinstance(current, ast.Attribute):
+            if not isinstance(current.attr, str):
+                raise ValueError('Invalid attribute name')
+            if not isinstance(current.value, (ast.Name, ast.Attribute)):
+                raise ValueError(f'Invalid dotted name component: {type(current.value).__name__}')
+            current = current.value
+        if not isinstance(current, ast.Name):
+            raise ValueError(f'Dotted name must end with an identifier, got {type(current).__name__}')
+        # Return the final identifier (last part of dotted name)
+        return func.attr
+    else:
+        raise ValueError(f'Invalid function name type: {type(func).__name__}')
+
+
+def _extract_args(call_node):
+    """Extract keyword arguments from a Call node."""
+    # Reject positional arguments
+    if call_node.args:
+        for arg in call_node.args:
+            if isinstance(arg, ast.Starred):
+                raise ValueError('Argument unpacking is not allowed')
+        raise ValueError('Positional arguments are not allowed')
+
+    args = {}
+    seen_keys = set()
+
+    for kw in call_node.keywords:
+        if kw.arg is None:
+            raise ValueError('Argument unpacking (**kwargs) is not allowed')
+        if kw.arg in seen_keys:
+            raise ValueError(f'Duplicate keyword argument: {kw.arg}')
+        seen_keys.add(kw.arg)
+        args[kw.arg] = _parse_literal(kw.value)
+
+    return args
+
+
+def _parse_literal(node):
+    """Recursively parse a literal AST node into a Python value."""
+    if isinstance(node, ast.Constant):
+        val = node.value
+        if isinstance(val, bool):
+            return val  # bool must come before int since bool is subclass of int
+        if isinstance(val, (int, float)):
+            if isinstance(val, float):
+                if not _is_finite(val):
+                    raise ValueError(f'Non-finite float values are not allowed: {val}')
+            return val
+        if isinstance(val, str):
+            return val
+        if val is None:
+            return None
+        # Reject bytes, Ellipsis, complex
+        if isinstance(val, bytes):
+            raise ValueError('Bytes literals are not allowed')
+        if val is Ellipsis:
+            raise ValueError('Ellipsis (...) is not allowed')
+        if isinstance(val, complex):
+            raise ValueError('Complex numbers are not allowed')
+        raise ValueError(f'Unsupported constant type: {type(val).__name__}')
+
+    elif isinstance(node, ast.UnaryOp):
+        # Unary + and - permitted only on numbers, not booleans
+        if isinstance(node.op, ast.UAdd):
+            operand = _parse_literal(node.operand)
+            if isinstance(operand, bool) or not isinstance(operand, (int, float)):
+                raise ValueError(f'Unary + is only allowed on numbers, not {type(operand).__name__}')
+            return +operand
+        elif isinstance(node.op, ast.USub):
+            operand = _parse_literal(node.operand)
+            if isinstance(operand, bool) or not isinstance(operand, (int, float)):
+                raise ValueError(f'Unary - is only allowed on numbers, not {type(operand).__name__}')
+            return -operand
+        elif isinstance(node.op, ast.Not):
+            raise ValueError('Unary not is not allowed')
+        elif isinstance(node.op, ast.Invert):
+            raise ValueError('Bitwise invert is not allowed')
+        else:
+            raise ValueError(f'Unsupported unary operator: {type(node.op).__name__}')
+
+    elif isinstance(node, ast.List):
+        return [_parse_literal(el) for el in node.elts]
+
+    elif isinstance(node, ast.Tuple):
+        # Convert tuples recursively into lists
+        return [_parse_literal(el) for el in node.elts]
+
+    elif isinstance(node, ast.Dict):
+        # Dictionary keys must be strings
+        d = {}
+        for k, v in zip(node.keys, node.values):
+            if k is None:
+                raise ValueError('Dict unpacking (**dict) is not allowed')
+            key = _parse_literal(k)
+            if not isinstance(key, str):
+                raise ValueError(f'Dictionary keys must be strings, got {type(key).__name__}')
+            if key in d:
+                raise ValueError(f'Duplicate dictionary key: {key}')
+            d[key] = _parse_literal(v)
+        return d
+
+    elif isinstance(node, ast.Name):
+        name = node.id
+        if name == 'True':
+            return True
+        elif name == 'False':
+            return False
+        elif name == 'None':
+            return None
+        else:
+            raise ValueError(f'Variables are not allowed: {name}')
+
+    elif isinstance(node, ast.Call):
+        raise ValueError('Nested function calls are not allowed')
+
+    elif isinstance(node, ast.ListComp):
+        raise ValueError('List comprehensions are not allowed')
+
+    elif isinstance(node, ast.DictComp):
+        raise ValueError('Dict comprehensions are not allowed')
+
+    elif isinstance(node, ast.SetComp):
+        raise ValueError('Set comprehensions are not allowed')
+
+    elif isinstance(node, ast.GeneratorExp):
+        raise ValueError('Generator expressions are not allowed')
+
+    elif isinstance(node, ast.Lambda):
+        raise ValueError('Lambda expressions are not allowed')
+
+    elif isinstance(node, ast.JoinedStr):
+        raise ValueError('f-strings are not allowed')
+
+    elif isinstance(node, ast.Set):
+        raise ValueError('Set literals are not allowed')
+
+    elif isinstance(node, ast.BinOp):
+        raise ValueError('Binary operations are not allowed')
+
+    elif isinstance(node, ast.Compare):
+        raise ValueError('Comparison operations are not allowed')
+
+    elif isinstance(node, ast.IfExp):
+        raise ValueError('Conditional expressions are not allowed')
+
+    elif isinstance(node, ast.Subscript):
+        raise ValueError('Subscript operations are not allowed')
+
+    elif isinstance(node, ast.Attribute):
+        raise ValueError('Attribute access is not allowed')
+
+    else:
+        raise ValueError(f'Unsupported expression type: {type(node).__name__}')
+
+
+def _is_finite(val):
+    """Check if a float value is finite."""
+    return not (math.isnan(val) or math.isinf(val))
+
