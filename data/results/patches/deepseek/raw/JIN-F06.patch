+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", key_transform=title) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
