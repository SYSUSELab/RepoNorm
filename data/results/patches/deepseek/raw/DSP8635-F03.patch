+    def _compute_effective_tip_weights(self):
+        """Compute effective tip weights from self.tip_weights.
+        
+        Returns:
+            dict or None: A dict mapping tip keys to weights if any positive weight exists,
+            or None for uniform selection.
+        """
+        if self.tip_weights is None:
+            return None
+        
+        tip_keys = list(TIPS.keys())
+        weights = []
+        has_positive = False
+        
+        for key in tip_keys:
+            if key in self.tip_weights:
+                w = self.tip_weights[key]
+                # Non-numeric, boolean, nonfinite and nonpositive values have weight zero
+                if isinstance(w, bool):
+                    w = 0
+                elif not isinstance(w, (int, float)):
+                    w = 0
+                elif w <= 0:
+                    w = 0
+                elif isinstance(w, float) and (w == float('inf') or w != w):
+                    # Non-finite (inf or NaN)
+                    w = 0
+            else:
+                # Missing keys have weight 1
+                w = 1
+            
+            if w > 0:
+                has_positive = True
+            weights.append(w)
+        
+        if not has_positive:
+            # All-zero effective mapping -> uniform selection
+            return None
+        
+        return dict(zip(tip_keys, weights))
+
