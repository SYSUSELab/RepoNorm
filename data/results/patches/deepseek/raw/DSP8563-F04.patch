     class ToolCall(BaseModel):
         name: str
         args: dict[str, Any]
+        _fingerprint: str = PrivateAttr(default="")
+        _id: str = PrivateAttr(default="")
+
+        def model_post_init(self, __context) -> None:
+            super().model_post_init(__context)
+            import hashlib
+            import json
+            import math
+
+            def _canonicalize(v):
+                if isinstance(v, dict):
+                    if any(not isinstance(k, str) for k in v):
+                        raise ValueError("Dictionary keys must be strings")
+                    return {k: _canonicalize(val) for k, val in sorted(v.items())}
+                elif isinstance(v, tuple):
+                    return [_canonicalize(item) for item in v]
+                elif isinstance(v, list):
+                    return [_canonicalize(item) for item in v]
+                elif isinstance(v, str):
+                    return v.strip()
+                elif isinstance(v, float):
+                    if not math.isfinite(v):
+                        raise ValueError(f"Nonfinite float value: {v}")
+                    return v
+                elif isinstance(v, bool):
+                    return v
+                elif isinstance(v, int):
+                    return v
+                elif v is None:
+                    return None
+                else:
+                    raise ValueError(f"Non-JSON value: {v}")
+
+            canonical_args = _canonicalize(self.args)
+            obj = {"name": self.name, "args": canonical_args}
+            canonical = json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+            digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+            object.__setattr__(self, "_fingerprint", digest)
+            object.__setattr__(self, "_id", digest[:8])
+
+        @property
+        def fingerprint(self) -> str:
+            """SHA-256 fingerprint of the canonical tool call (64 hex chars)."""
+            return self._fingerprint
+
+        @property
+        def id(self) -> str:
+            """Eight-character display abbreviation of the fingerprint."""
+            return self._id
 
