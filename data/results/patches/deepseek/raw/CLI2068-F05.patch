+def test_edit_lock_files(tmp_path):
+    """Test lock_files parameter for click.edit and Editor."""
+    import os
+    import datetime
+    
+    # Test with Editor directly
+    
+    # 1. lock_files=False (default) - no lock file created
+    test_file = tmp_path / "test.txt"
+    test_file.write_text("hello")
+    lock_file = tmp_path / ".test.txt.lock"
+    
+    ed = Editor(editor="cat", lock_files=False)
+    ed.edit_file(str(test_file))
+    assert not lock_file.exists(), "lock_files=False should not create lock file"
+    
+    # 2. lock_files=True - lock created and cleaned up
+    ed = Editor(editor="cat", lock_files=True)
+    ed.edit_file(str(test_file))
+    assert not lock_file.exists(), "Lock file should be removed after edit"
+    
+    # 3. Existing lock prevents edit
+    lock_file.write_text(f"PID: {os.getpid()}\nTime: 2024-01-01T00:00:00+00:00\n")
+    with pytest.raises(ClickException) as excinfo:
+        ed.edit_file(str(test_file))
+    assert str(lock_file) in str(excinfo.value)
+    assert "PID:" in str(excinfo.value)
+    assert excinfo.value.__cause__ is not None
+    assert isinstance(excinfo.value.__cause__, OSError)
+    lock_file.unlink()
+    
+    # 4. Lock removed on non-zero editor exit
+    ed = Editor(editor="false", lock_files=True)
+    with pytest.raises(ClickException):
+        ed.edit_file(str(test_file))
+    assert not lock_file.exists(), "Lock file should be removed after editor failure"
+    
+    # 5. Lock removed on OSError during launch
+    ed = Editor(editor="/nonexistent/editor_binary", lock_files=True)
+    with pytest.raises(ClickException):
+        ed.edit_file(str(test_file))
+    assert not lock_file.exists(), "Lock file should be removed after launch failure"
+    
+    # 6. Same basename in different directory - independent locks
+    tmpdir2 = tmp_path / "other"
+    tmpdir2.mkdir()
+    file2 = tmpdir2 / "test.txt"
+    file2.write_text("other")
+    lock2 = tmpdir2 / ".test.txt.lock"
+    
+    # Lock in first dir should not affect second dir
+    lock_file.write_text(f"PID: {os.getpid()}\nTime: 2024-01-01T00:00:00+00:00\n")
+    ed = Editor(editor="cat", lock_files=True)
+    ed.edit_file(str(file2))
+    assert not lock2.exists(), "Lock in other dir should not affect this dir"
+    lock_file.unlink()
+    
+    # 7. Lock does not apply to text form
+    result = click.edit("hello\n", editor="sed -i~ 's/hello/world/'", lock_files=True)
+    assert result is not None
+    assert "world" in result
+    
+    # 8. Test public API with filename
+    result = click.edit(filename=str(test_file), editor="cat", lock_files=True)
+    assert result is None
+    assert not lock_file.exists(), "Lock file should be cleaned up via public API"
+    
+    # 9. Test lock content format - verify PID and Time lines
+    lock_file.write_text("PID: 99999\nTime: 2024-06-01T12:00:00+00:00\n")
+    content = lock_file.read_text()
+    lines = content.strip().splitlines()
+    assert len(lines) == 2
+    assert lines[0] == "PID: 99999"
+    assert lines[1] == "Time: 2024-06-01T12:00:00+00:00"
+    lock_file.unlink()
+
+
+def test_edit_lock_files_text_form(tmp_path):
+    """Test that text form does not create lock files."""
+    import os
+    # Should work without any lock files being created
+    result = click.edit("test\n", editor="cat", lock_files=True)
+    assert result is None  # cat doesn't modify, require_save=True by default
+    
+    # With explicit require_save=False and text that doesn't change
+    result = click.edit("test\n", editor="cat", lock_files=True, require_save=False)
+    assert result == "test\n"
+
+
+def test_edit_lock_files_oserror_removal(tmp_path):
+    """Test that OSError on lock removal is properly raised."""
+    import os
+    
+    test_file = tmp_path / "test.txt"
+    test_file.write_text("hello")
+    lock_file = tmp_path / ".test.txt.lock"
+    
+    # Test with lock_files=True - should complete normally
+    ed = Editor(editor="cat", lock_files=True)
+    ed.edit_file(str(test_file))
+    
+    # Test that a second edit with same file works (lock was cleaned up)
+    ed.edit_file(str(test_file))
+    assert not lock_file.exists()
+
+
