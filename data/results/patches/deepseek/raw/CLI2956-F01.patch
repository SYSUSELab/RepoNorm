+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. If a
+        ``shell_complete`` function was given during init, it is used.
+        Otherwise, the :attr:`type`
+        :meth:`~click.types.ParamType.shell_complete` function is used.
+        When :attr:`auto_complete` is enabled, a built-in strategy is
+        selected based on the option's name or the explicit string value.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+
+        .. versionadded:: 8.3
+        """
+        from click.shell_completion import CompletionItem
+
+        # Explicit shell_complete callback always takes precedence.
+        if self._custom_shell_complete is not None:
+            results = self._custom_shell_complete(ctx, self, incomplete)
+            if results and isinstance(results[0], str):
+                results = [CompletionItem(c) for c in results]
+            return t.cast("list[CompletionItem]", results)
+
+        # Determine the strategy to use.
+        strategy: str | None = None
+
+        if isinstance(self.auto_complete, str):
+            # Explicit string strategy.
+            strategy = self.auto_complete
+        elif self.auto_complete is True:
+            # Automatic name-based detection.
+            if self.name is not None:
+                tokens = set(self.name.lower().split("_"))
+                if tokens & {"user", "username", "owner", "author"}:
+                    strategy = "user"
+                elif tokens & {"branch", "ref", "revision"}:
+                    strategy = "branch"
+                elif tokens & {"env", "environment", "var"}:
+                    strategy = "environment"
+                elif tokens & {"file", "path", "input", "output"}:
+                    strategy = "file"
+                elif tokens & {"dir", "directory"}:
+                    strategy = "directory"
+
+        if strategy is not None:
+            return _complete_by_strategy(strategy, ctx, self, incomplete)
+
+        # Fall through to the type's normal completion.
+        return self.type.shell_complete(ctx, self, incomplete)
+
