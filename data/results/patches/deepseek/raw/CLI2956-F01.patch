+def _complete_by_strategy(
+    strategy: str, ctx: Context, param: Parameter, incomplete: str
+) -> list[CompletionItem]:
+    """Use a built-in completion strategy."""
+    from click.shell_completion import CompletionItem
+
+    if strategy == "user":
+        return _complete_username(incomplete)
+    elif strategy == "branch":
+        return _complete_branch(incomplete)
+    elif strategy == "environment":
+        return _complete_environment(incomplete)
+    elif strategy == "file":
+        return [CompletionItem(incomplete, type="file")]
+    elif strategy == "directory":
+        return [CompletionItem(incomplete, type="dir")]
+    return []
+
+
+def _complete_username(incomplete: str) -> list[CompletionItem]:
+    """Complete usernames from the password database."""
+    from click.shell_completion import CompletionItem
+
+    try:
+        import pwd
+    except ImportError:
+        return []
+
+    try:
+        users = pwd.getpwall()
+    except Exception:
+        return []
+
+    results = []
+    for pw in users:
+        name = pw.pw_name
+        if name.startswith("_"):
+            continue
+        if incomplete and not name.startswith(incomplete):
+            continue
+        results.append(name)
+
+    results = sorted(set(results))
+    return [CompletionItem(v) for v in results[:20]]
+
+
+def _complete_branch(incomplete: str) -> list[CompletionItem]:
+    """Complete Git branch and ref names."""
+    from click.shell_completion import CompletionItem
+
+    import subprocess
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "--list", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+        if result.returncode != 0:
+            return []
+        branches = result.stdout.strip().splitlines()
+    except Exception:
+        return []
+
+    results = []
+    for name in branches:
+        if incomplete and not name.startswith(incomplete):
+            continue
+        results.append(name)
+
+    results = sorted(set(results))
+    return [CompletionItem(v) for v in results[:20]]
+
+
+def _complete_environment(incomplete: str) -> list[CompletionItem]:
+    """Complete environment variable names (not values)."""
+    from click.shell_completion import CompletionItem
+    import os
+
+    results = []
+    for name in os.environ:
+        if incomplete and not name.startswith(incomplete):
+            continue
+        results.append(name)
+
+    results = sorted(set(results))
+    return [CompletionItem(v) for v in results[:20]]
+
