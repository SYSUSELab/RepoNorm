+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str, int], str]]
+        ] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str], str]]
+        ] = None,
+        fallback_npgettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str, str, int], str]]
+        ] = None,
+    ) -> None:
+        # Snapshot fallback iterables
+        fb_gettext = tuple(fallback_gettext_funcs) if fallback_gettext_funcs else ()
+        fb_ngettext = tuple(fallback_ngettext_funcs) if fallback_ngettext_funcs else ()
+        fb_pgettext = tuple(fallback_pgettext_funcs) if fallback_pgettext_funcs else ()
+        fb_npgettext = tuple(fallback_npgettext_funcs) if fallback_npgettext_funcs else ()
+
+        # Validate: non-empty contextual fallback requires matching primary
+        if fb_pgettext and pgettext is None:
+            raise ValueError(
+                "fallback_pgettext_funcs requires pgettext primary provider"
+            )
+        if fb_npgettext and npgettext is None:
+            raise ValueError(
+                "fallback_npgettext_funcs requires npgettext primary provider"
+            )
+
+        # Build composite functions with fallback chains
+        if fb_gettext:
+            gettext = _make_fallback_gettext(gettext, fb_gettext)
+
+        if fb_ngettext:
+            ngettext = _make_fallback_ngettext(ngettext, fb_ngettext)
+
+        if fb_pgettext:
+            pgettext = _make_fallback_pgettext(pgettext, fb_pgettext)
+
+        if fb_npgettext:
+            npgettext = _make_fallback_npgettext(npgettext, fb_npgettext)
+
+        # Delegate to the existing installer with the composite functions
+        self._install_callables(
+            gettext=gettext,
+            ngettext=ngettext,
+            newstyle=newstyle,
+            pgettext=pgettext,
+            npgettext=npgettext,
+        )
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
