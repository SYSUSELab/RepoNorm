+def _make_fallback_gettext(
+    gettext: t.Callable[[str], str],
+    fallbacks: t.Sequence[t.Callable[[str], str]],
+) -> t.Callable[[str], str]:
+    """Create a gettext function with ordered fallback chain."""
+
+    def _gettext_with_fallback(message: str) -> str:
+        result = gettext(message)
+
+        if result != message:
+            return result
+
+        for fallback in fallbacks:
+            result = fallback(message)
+
+            if result != message:
+                return result
+
+        return message
+
+    return _gettext_with_fallback
+
+
+def _make_fallback_ngettext(
+    ngettext: t.Callable[[str, str, int], str],
+    fallbacks: t.Sequence[t.Callable[[str, str, int], str]],
+) -> t.Callable[[str, str, int], str]:
+    """Create an ngettext function with ordered fallback chain."""
+
+    def _ngettext_with_fallback(singular: str, plural: str, n: int) -> str:
+        result = ngettext(singular, plural, n)
+        expected = singular if n == 1 else plural
+
+        if result != expected:
+            return result
+
+        for fallback in fallbacks:
+            result = fallback(singular, plural, n)
+
+            if result != expected:
+                return result
+
+        return expected
+
+    return _ngettext_with_fallback
+
+
+def _make_fallback_pgettext(
+    pgettext: t.Callable[[str, str], str],
+    fallbacks: t.Sequence[t.Callable[[str, str], str]],
+) -> t.Callable[[str, str], str]:
+    """Create a pgettext function with ordered fallback chain."""
+
+    def _pgettext_with_fallback(context: str, message: str) -> str:
+        result = pgettext(context, message)
+
+        if result != message:
+            return result
+
+        for fallback in fallbacks:
+            result = fallback(context, message)
+
+            if result != message:
+                return result
+
+        return message
+
+    return _pgettext_with_fallback
+
+
+def _make_fallback_npgettext(
+    npgettext: t.Callable[[str, str, str, int], str],
+    fallbacks: t.Sequence[t.Callable[[str, str, str, int], str]],
+) -> t.Callable[[str, str, str, int], str]:
+    """Create an npgettext function with ordered fallback chain."""
+
+    def _npgettext_with_fallback(
+        context: str, singular: str, plural: str, n: int
+    ) -> str:
+        result = npgettext(context, singular, plural, n)
+        expected = singular if n == 1 else plural
+
+        if result != expected:
+            return result
+
+        for fallback in fallbacks:
+            result = fallback(context, singular, plural, n)
+
+            if result != expected:
+                return result
+
+        return expected
+
+    return _npgettext_with_fallback
+
