+def normalize_template_path(template: str) -> t.List[str]:
+    """Normalize a template name into path segments.
+
+    Both ``/`` and ``\\`` are treated as path separators. Empty segments
+    and ``.`` segments are removed. Internal ``..`` segments remove the
+    preceding ordinary segment. Paths that would escape the logical root,
+    absolute paths, UNC paths, and paths with a drive prefix are rejected
+    by raising ``TemplateNotFound``.
+
+    :param template: The template name to normalize.
+    :return: A list of path segments.
+    :raises TemplateNotFound: If the path is invalid.
+    """
+
+    # Reject absolute paths starting with / or \\
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+
+    # Reject UNC forms (starting with \\)
+    if template.startswith("\\\\"):
+        raise TemplateNotFound(template)
+
+    # Reject names with an ASCII drive prefix (e.g., C:)
+    if (
+        len(template) >= 2
+        and template[1] == ":"
+        and template[0].isascii()
+        and template[0].isalpha()
+    ):
+        raise TemplateNotFound(template)
+
+    # Replace backslashes with forward slashes for consistent splitting
+    normalized = template.replace("\\", "/")
+    pieces: t.List[str] = []
+
+    for piece in normalized.split("/"):
+        if piece == "" or piece == ".":
+            continue
+        elif piece == "..":
+            if not pieces:
+                raise TemplateNotFound(template)
+            pieces.pop()
+        else:
+            pieces.append(piece)
+
+    return pieces
+
