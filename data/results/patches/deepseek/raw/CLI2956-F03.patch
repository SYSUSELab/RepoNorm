+        if not isinstance(batch_size, int | None):
+            raise TypeError(
+                f"'batch_size' must be an integer or None, not '{batch_size.__class__.__name__}'."
+            )
+
+        if isinstance(batch_size, bool):
+            raise TypeError(
+                "'batch_size' must be an integer or None, not 'bool'."
+            )
+
+        if batch_size is not None and not multiple:
