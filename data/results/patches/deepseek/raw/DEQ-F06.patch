+import pytest
+
+from dirty_equals import IsCreditCard
+
+
+# Known valid test card numbers (all pass Luhn check)
+VALID_VISA_13 = '4384419175942'
+VALID_VISA_16 = '4111111111111111'
+VALID_VISA_19 = '4676139257930477495'
+VALID_MC_51 = '5198646374395896'
+VALID_MC_55 = '5518251460252508'
+VALID_MC_2221 = '2221197714315457'
+VALID_MC_2720 = '2720262357240556'
+VALID_AMEX_34 = '340405303300149'
+VALID_AMEX_37 = '375813327433788'
+
+
+@pytest.mark.parametrize(
+    'value,dirty,match',
+    [
+        # Valid card numbers without issuer
+        (VALID_VISA_16, IsCreditCard, True),
+        (VALID_VISA_16, IsCreditCard(), True),
+        (4111111111111111, IsCreditCard, True),
+        (VALID_MC_51, IsCreditCard, True),
+        (VALID_MC_55, IsCreditCard, True),
+        (VALID_MC_2221, IsCreditCard, True),
+        (VALID_MC_2720, IsCreditCard, True),
+        (VALID_AMEX_34, IsCreditCard, True),
+        (VALID_AMEX_37, IsCreditCard, True),
+        (VALID_VISA_13, IsCreditCard, True),
+        (VALID_VISA_19, IsCreditCard, True),
+        # Invalid Luhn
+        ('4111111111111112', IsCreditCard, False),
+        ('4111111111111110', IsCreditCard, False),
+        # Wrong types
+        (True, IsCreditCard, False),
+        (False, IsCreditCard, False),
+        (3.14, IsCreditCard, False),
+        (None, IsCreditCard, False),
+        (b'4111111111111111', IsCreditCard, False),
+        # Bad string format
+        ('', IsCreditCard, False),
+        ('4111-1111-1111-111a', IsCreditCard, False),
+        ('4111_1111_1111_1111', IsCreditCard, False),
+        ('abc', IsCreditCard, False),
+        # Too short
+        ('49999999994', IsCreditCard, False),  # 11 digits
+        # Too long
+        ('41111111111111111111', IsCreditCard, False),  # 20 digits
+    ],
+)
+def test_is_credit_card_basic(value, dirty, match):
+    if match:
+        assert value == dirty
+    else:
+        assert value != dirty
+
+
+@pytest.mark.parametrize(
+    'value,dirty,match',
+    [
+        # Visa
+        (VALID_VISA_16, IsCreditCard(issuer='Visa'), True),
+        (VALID_VISA_13, IsCreditCard(issuer='Visa'), True),
+        (VALID_VISA_19, IsCreditCard(issuer='Visa'), True),
+        # Mastercard
+        (VALID_MC_51, IsCreditCard(issuer='Mastercard'), True),
+        (VALID_MC_55, IsCreditCard(issuer='Mastercard'), True),
+        (VALID_MC_2221, IsCreditCard(issuer='Mastercard'), True),
+        (VALID_MC_2720, IsCreditCard(issuer='Mastercard'), True),
+        # American Express
+        (VALID_AMEX_34, IsCreditCard(issuer='AmericanExpress'), True),
+        (VALID_AMEX_37, IsCreditCard(issuer='AmericanExpress'), True),
+        # Issuer mismatches
+        (VALID_VISA_16, IsCreditCard(issuer='Mastercard'), False),
+        (VALID_VISA_16, IsCreditCard(issuer='AmericanExpress'), False),
+        (VALID_MC_51, IsCreditCard(issuer='Visa'), False),
+        (VALID_MC_51, IsCreditCard(issuer='AmericanExpress'), False),
+        (VALID_AMEX_34, IsCreditCard(issuer='Visa'), False),
+        (VALID_AMEX_34, IsCreditCard(issuer='Mastercard'), False),
+    ],
+)
+def test_is_credit_card_issuer(value, dirty, match):
+    if match:
+        assert value == dirty
+    else:
+        assert value != dirty
+
+
+def test_credit_card_with_spaces():
+    """Card numbers with spaces should work."""
+    assert '4111 1111 1111 1111' == IsCreditCard()
+    assert '4111 1111 1111 1111' == IsCreditCard(issuer='Visa')
+
+
+def test_credit_card_with_hyphens():
+    """Card numbers with hyphens should work."""
+    assert '4111-1111-1111-1111' == IsCreditCard()
+    assert '4111-1111-1111-1111' == IsCreditCard(issuer='Visa')
+
+
+def test_credit_card_with_whitespace():
+    """Card numbers with surrounding whitespace should work."""
+    assert '  4111 1111 1111 1111  ' == IsCreditCard()
+    assert '  4111-1111-1111-1111  ' == IsCreditCard()
+
+
+def test_credit_card_as_int():
+    """Card numbers as integers should work."""
+    assert 4111111111111111 == IsCreditCard()
+    assert 4111111111111111 == IsCreditCard(issuer='Visa')
+
+
+def test_credit_card_repr():
+    """Test the repr of IsCreditCard."""
+    card = IsCreditCard()
+    assert repr(card) == 'IsCreditCard()'
+
+    card_with_issuer = IsCreditCard(issuer='Visa')
+    assert repr(card_with_issuer) == "IsCreditCard(issuer='Visa')"
+
+    # After successful comparison, repr returns the value
+    assert '4111111111111111' == card
+    assert repr(card) == "'4111111111111111'"
+
+
+def test_credit_card_value_property():
+    """Test the value property after comparison."""
+    card = IsCreditCard()
+    assert '4111111111111111' == card
+    assert card.value == '4111111111111111'
+    assert card._other == '4111111111111111'
