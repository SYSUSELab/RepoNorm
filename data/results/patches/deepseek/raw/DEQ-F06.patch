+"""
+IsCreditCard validator with Luhn algorithm and issuer detection.
+"""
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit
+
+__all__ = 'IsCreditCard',
+
+# Regular expression to validate card number input format
+# Allows digits, spaces, hyphens, with optional leading/trailing whitespace
+CARD_FORMAT_RE = re.compile(r'^[\s]*[\d\s\-]+[\s]*$')
+
+ISSUERS = {
+    'Visa': {
+        'prefixes': ['4'],
+        'lengths': {13, 16, 19},
+    },
+    'Mastercard': {
+        'prefixes': [str(i) for i in range(51, 56)] + [str(i) for i in range(2221, 2721)],
+        'lengths': {16},
+    },
+    'AmericanExpress': {
+        'prefixes': ['34', '37'],
+        'lengths': {15},
+    },
+}
+
+
+def _luhn_checksum(digits: str) -> bool:
+    """
+    Validate a card number using the Luhn algorithm.
+    """
+    total = 0
+    # Process from right to left, double every second digit
+    for i, digit_char in enumerate(reversed(digits)):
+        digit = ord(digit_char) - 48  # ASCII '0' is 48
+        if i % 2 == 1:  # double every second digit (starting from the rightmost)
+            digit *= 2
+            if digit > 9:
+                digit -= 9
+        total += digit
+    return total % 10 == 0
+
+
+def _clean_card_number(raw: str) -> Optional[str]:
+    """
+    Clean and validate a card number string.
+    Returns the cleaned digit string, or None if invalid.
+    """
+    # Check format: only digits, spaces, hyphens, and surrounding whitespace allowed
+    if not CARD_FORMAT_RE.fullmatch(raw):
+        return None
+
+    # Remove spaces, hyphens, and surrounding whitespace
+    cleaned = ''.join(c for c in raw if c.isdigit())
+
+    # Ensure we only have ASCII digits (not Unicode numeric chars)
+    for c in cleaned:
+        if not ('0' <= c <= '9'):
+            return None
+
+    # Check length
+    if not (12 <= len(cleaned) <= 19):
+        return None
+
+    return cleaned
+
+
+class IsCreditCard(DirtyEquals[str]):
+    """
+    Validates card numbers with the Luhn algorithm and optionally restricts them to a named issuer.
+
+    Accepts card numbers as strings or integers. Strings may contain spaces, hyphens,
+    and surrounding whitespace; other characters and input types compare unequal.
+
+    Without an issuer, any 12--19 digit number that passes the Luhn check is accepted.
+
+    Args:
+        issuer: Optional issuer name, one of 'Visa', 'Mastercard', or 'AmericanExpress'.
+            Matched case-sensitively.
+
+    Examples:
+        ```py title="IsCreditCard"
+        from dirty_equals import IsCreditCard
+
+        # Valid Visa test number
+        assert '4111111111111111' == IsCreditCard()
+        assert '4111111111111111' == IsCreditCard(issuer='Visa')
+
+        # Invalid Luhn
+        assert '4111111111111112' != IsCreditCard()
+
+        # Issuer mismatch
+        assert '4111111111111111' != IsCreditCard(issuer='Mastercard')
+        ```
+    """
+
+    def __init__(self, issuer: Optional[str] = None):
+        """
+        Args:
+            issuer: Optional issuer name to restrict the card number to.
+        """
+        self.issuer = issuer
+        super().__init__(issuer=issuer or Omit)
+
+    def equals(self, other: Any) -> bool:
+        # Reject booleans
+        if isinstance(other, bool):
+            return False
+
+        # Convert integers to string
+        if isinstance(other, int):
+            digits = str(other)
+        elif isinstance(other, str):
+            cleaned = _clean_card_number(other)
+            if cleaned is None:
+                return False
+            digits = cleaned
+        else:
+            return False
+
+        # Check Luhn algorithm
+        if not _luhn_checksum(digits):
+            return False
+
+        # If no issuer specified, any valid Luhn number is accepted
+        if self.issuer is None:
+            return True
+
+        # Check issuer restrictions
+        issuer_config = ISSUERS.get(self.issuer)
+        if issuer_config is None:
+            # Unknown issuer - just return True (though shouldn't happen with proper usage)
+            return True
+
+        # Check length requirement
+        if len(digits) not in issuer_config['lengths']:
+            return False
+
+        # Check prefix requirement
+        for prefix in issuer_config['prefixes']:
+            if digits.startswith(prefix):
+                return True
+
+        return False
