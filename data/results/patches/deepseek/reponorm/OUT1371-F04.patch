+def test_builtin_filters_from_str():
+    """Use Prompt.from_str with string_utils filters."""
+    content = "{{ value|upper }} {{ value|lower }} {{ value|title }}"
+    prompt = Prompt.from_str(content, builtin_filters=["string_utils"])
+    assert prompt(value="hello World") == "HELLO WORLD hello world Hello World"
