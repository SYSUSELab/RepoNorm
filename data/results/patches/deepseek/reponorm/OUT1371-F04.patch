+def _add_builtin_filters(env: jinja2.Environment, builtin_filters: Optional[List[str]]):
+    """Add builtin filter categories to a Jinja2 environment.
+
+    Parameters
+    ----------
+    env : jinja2.Environment
+        The environment to add filters to.
+    builtin_filters : list of str or None
+        Category names to load. ``None`` or an empty list does nothing.
+        Unknown names raise ``ValueError``.
+
+    Raises
+    ------
+    ValueError
+        If any category name is not one of the known builtin filter categories.
+    """
+    if not builtin_filters:
+        return
+    for name in builtin_filters:
+        if name not in BUILTIN_FILTER_CATEGORIES:
+            raise ValueError(f"Unknown builtin filter category: {name}")
+        for filter_name, filter_fn in BUILTIN_FILTER_CATEGORIES[name].items():
+            env.filters[filter_name] = filter_fn
+
