+# ── Builtin filter category implementations ────────────────────────────────
+
+# string_utils
+
+def _string_upper(value):
+    return str(value).upper()
+
+
+def _string_lower(value):
+    return str(value).lower()
+
+
+def _string_title(value):
+    return str(value).title()
+
+
+def _string_reverse(value):
+    return str(value)[::-1]
+
+
+def _string_truncate(value, length, end="..."):
+    text = str(value)
+    if length < 0:
+        raise ValueError("negative length")
+    if len(text) <= length:
+        return text
+
+    remaining = length
+    end_len = min(len(end), remaining)
+    keep_len = remaining - end_len
+    if keep_len < 0:
+        keep_len = 0
+    return text[:keep_len] + end[:end_len]
+
+
+def _string_pad_left(value, width, fill=" "):
+    return str(value).rjust(width, fill)
+
+
+def _string_pad_right(value, width, fill=" "):
+    return str(value).ljust(width, fill)
+
+
+# math_utils
+
+def _math_add(a, b):
+    return a + b
+
+
+def _math_subtract(a, b):
+    return a - b
+
+
+def _math_multiply(a, b):
+    return a * b
+
+
+def _math_divide(a, b):
+    return a / b
+
+
+def _math_round(value, ndigits=None):
+    return round(value, ndigits)
+
+
+def _math_abs(value):
+    return abs(value)
+
+
+def _math_min(value, *others):
+    if not others:
+        return value
+    return min(value, *others)
+
+
+def _math_max(value, *others):
+    if not others:
+        return value
+    return max(value, *others)
+
+
+# format_utils
+
+def _format_json(value):
+    return json.dumps(value)
+
+
+def _format_csv(value):
+    out = io.StringIO()
+    writer = csv.writer(out)
+    writer.writerow(value)
+    result = out.getvalue()
+    # csv.writer always adds a line terminator; strip it
+    return result.rstrip("\r\n")
+
+
+def _format_indent(value, width=4):
+    lines = str(value).splitlines(keepends=True)
+    result = []
+    for line in lines:
+        if line.strip():
+            result.append(" " * width + line)
+        else:
+            result.append(line)
+    return "".join(result)
+
+
+def _format_wrap(value, width=70):
+    return textwrap.fill(str(value), width=width)
+
+
+def _format_escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _format_unescape(value):
+    return html.unescape(str(value))
+
+
+# ── Category registry ──────────────────────────────────────────────────────
+
+BUILTIN_FILTER_CATEGORIES: Dict[str, Dict[str, Callable]] = {
+    "string_utils": {
+        "upper": _string_upper,
+        "lower": _string_lower,
+        "title": _string_title,
+        "reverse": _string_reverse,
+        "truncate": _string_truncate,
+        "pad_left": _string_pad_left,
+        "pad_right": _string_pad_right,
+    },
+    "math_utils": {
+        "add": _math_add,
+        "subtract": _math_subtract,
+        "multiply": _math_multiply,
+        "divide": _math_divide,
+        "round": _math_round,
+        "abs": _math_abs,
+        "min": _math_min,
+        "max": _math_max,
+    },
+    "format_utils": {
+        "json": _format_json,
+        "csv": _format_csv,
+        "indent": _format_indent,
+        "wrap": _format_wrap,
+        "escape": _format_escape,
+        "unescape": _format_unescape,
+    },
+}
+
