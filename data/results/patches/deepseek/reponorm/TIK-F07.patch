+def _validate_tokens(tokens: list[int], validators: list[Callable[[list[int]], object]]) -> None:
+    """Validate tokens using the provided validators.
+
+    Each validator receives an independent copy of the tokens.
+    False raises ValueError; None and True mean acceptance.
+    Callback exceptions propagate unchanged.
+    """
+    if not validators:
+        return
+    for validator in validators:
+        tokens_copy = copy.deepcopy(tokens)
+        result = validator(tokens_copy)
+        if result is False:
+            raise ValueError("Token validation failed")
+
