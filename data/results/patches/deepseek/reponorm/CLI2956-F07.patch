+    def _check_conflicts(self, ctx: Context) -> None:
+        """Check for mutually conflicting options after all parameters
+        have been processed.
+        """
+        params_by_name = {p.name: p for p in self.get_params(ctx) if p.name is not None}
+        
+        for param in self.get_params(ctx):
+            if not isinstance(param, Option):
+                continue
+                
+            conflicts = getattr(param, "conflicts_with", None)
+            if not conflicts:
+                continue
+                
+            for conflict_name in conflicts:
+                # Check for unknown conflict name
+                if conflict_name not in params_by_name:
+                    raise UsageError(
+                        f"Option '{param.opts[0]}' has unknown conflict"
+                        f" '{conflict_name}'."
+                    )
+
+                
+        # Now check actual conflicts (sources are COMMANDLINE or PROMPT)
+        for param in self.get_params(ctx):
+            if not isinstance(param, Option):
+                continue
+                
+            conflicts = getattr(param, "conflicts_with", None)
+            if not conflicts:
+                continue
+                
+            param_source = ctx.get_parameter_source(param.name)
+            if param_source not in {ParameterSource.COMMANDLINE, ParameterSource.PROMPT}:
+                continue
+                
+            for conflict_name in conflicts:
+                if conflict_name not in params_by_name:
+                    continue
+                    
+                conflict_param = params_by_name[conflict_name]
+                conflict_source = ctx.get_parameter_source(conflict_name)
+                
+                if conflict_source in {ParameterSource.COMMANDLINE, ParameterSource.PROMPT}:
+                    # Both were explicitly provided
+                    raise UsageError(
+                        f"Option '{param.opts[0]}' cannot be used together"
+                        f" with '{conflict_param.opts[0]}'."
+                    )
+
