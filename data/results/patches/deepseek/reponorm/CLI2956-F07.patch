+
+        # Resilient parsing skips conflict check
+        ctx = click.Context(cli, resilient_parsing=True)
+        # parse_args should not raise even with conflicting options
+        cli.parse_args(ctx, ["--first", "a", "--second", "b"])
+        # If we got here without exception, resilient parsing worked
+
