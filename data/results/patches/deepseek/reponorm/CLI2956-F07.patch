+
+class TestConflictsWith:
+    """Tests for the ``conflicts_with`` option parameter."""
+
+    def test_basic_conflict(self, runner):
+        @click.command()
+        @click.option("--first", conflicts_with="second")
+        @click.option("--second")
+        def cli(first, second):
+            click.echo(f"{first}:{second}")
+
+        result = runner.invoke(cli, ["--first", "a"])
+        assert result.exit_code == 0
+
+        result = runner.invoke(cli, ["--second", "b"])
+        assert result.exit_code == 0
+
+        result = runner.invoke(cli, ["--first", "a", "--second", "b"])
+        assert result.exit_code != 0
+        assert "cannot be used together" in result.output
+
+    def test_defaults_no_conflict(self, runner):
+        @click.command()
+        @click.option("--first", default="a", conflicts_with="second")
+        @click.option("--second", default="b")
+        def cli(first, second):
+            click.echo(f"{first}:{second}")
+
+        result = runner.invoke(cli, [])
+        assert result.exit_code == 0
+        assert result.output.strip() == "a:b"
+
+    def test_envvar_no_conflict(self, runner, monkeypatch):
+        monkeypatch.setenv("FIRST", "x")
+        monkeypatch.setenv("SECOND", "y")
+
+        @click.command()
+        @click.option("--first", envvar="FIRST", conflicts_with="second")
+        @click.option("--second", envvar="SECOND")
+        def cli(first, second):
+            click.echo(f"{first}:{second}")
+
+        result = runner.invoke(cli, [])
+        assert result.exit_code == 0
+        assert result.output.strip() == "x:y"
+
+    def test_none_disables(self):
+        opt = click.Option(["--test"], conflicts_with=None)
+        assert opt.conflicts_with == []
+
+    def test_empty_sequence_disables(self):
+        opt = click.Option(["--test"], conflicts_with=())
+        assert opt.conflicts_with == []
+
+    def test_type_error_non_string(self):
+        with pytest.raises(TypeError):
+            click.Option(["--test"], conflicts_with=123)
+
+    def test_type_error_non_string_in_sequence(self):
+        with pytest.raises(TypeError):
+            click.Option(["--test"], conflicts_with=["ok", 123])
+
+    def test_type_error_prefixed_name(self):
+        with pytest.raises(TypeError):
+            click.Option(["--test"], conflicts_with="--other")
+
+    def test_type_error_prefixed_name_in_sequence(self):
+        with pytest.raises(TypeError):
+            click.Option(["--test"], conflicts_with=["other", "-x"])
+
+    def test_self_reference_error(self):
+        with pytest.raises(click.UsageError, match="cannot conflict with itself"):
+            @click.command()
+            @click.option("--test", conflicts_with="test")
+            def cli(test):
+                pass
+
+    def test_unknown_name_error(self, runner):
+        @click.command()
+        @click.option("--first", conflicts_with="unknown_name")
+        def cli(first):
+            pass
+
+        result = runner.invoke(cli, ["--first", "a"])
+        assert result.exit_code != 0
+        assert "unknown conflict" in result.output
+
+    def test_conflict_with_count_option(self, runner):
+        @click.command()
+        @click.option("-v", "--verbose", count=True, conflicts_with="quiet")
+        @click.option("-q", "--quiet", is_flag=True)
+        def cli(verbose, quiet):
+            click.echo(f"verbose={verbose}, quiet={quiet}")
+
+        result = runner.invoke(cli, ["-vvv", "-q"])
+        assert result.exit_code != 0
+        assert "cannot be used together" in result.output
+
+    def test_conflict_with_multiple_option(self, runner):
+        @click.command()
+        @click.option("--name", multiple=True, conflicts_with="other")
+        @click.option("--other")
+        def cli(name, other):
+            click.echo(f"names={name}, other={other}")
+
+        result = runner.invoke(cli, ["--name", "a", "--name", "b", "--other", "x"])
+        assert result.exit_code != 0
+        assert "cannot be used together" in result.output
+
+    def test_conflict_with_flag_option(self, runner):
+        @click.command()
+        @click.option("--verbose/--no-verbose", conflicts_with="quiet")
+        @click.option("--quiet", is_flag=True)
+        def cli(verbose, quiet):
+            click.echo(f"verbose={verbose}, quiet={quiet}")
+
+        result = runner.invoke(cli, ["--verbose", "--quiet"])
+        assert result.exit_code != 0
+        assert "cannot be used together" in result.output
+
+    def test_sequence_conflicts(self, runner):
+        @click.command()
+        @click.option("--first", conflicts_with=["second", "third"])
+        @click.option("--second")
+        @click.option("--third")
+        def cli(first, second, third):
+            click.echo(f"{first}:{second}:{third}")
+
+        result = runner.invoke(cli, ["--first", "a", "--second", "b"])
+        assert result.exit_code != 0
+        assert "cannot be used together" in result.output
+
+        result = runner.invoke(cli, ["--first", "a", "--third", "c"])
+        assert result.exit_code != 0
+        assert "cannot be used together" in result.output
+
+    def test_bidirectional_conflict(self, runner):
+        @click.command()
+        @click.option("--first", conflicts_with="second")
+        @click.option("--second", conflicts_with="first")
+        def cli(first, second):
+            click.echo(f"{first}:{second}")
+
+        # Should fail just once, not produce double errors
+        result = runner.invoke(cli, ["--first", "a", "--second", "b"])
+        assert result.exit_code != 0
+        assert result.output.count("cannot") == 1
+
+    def test_to_info_dict_default(self):
+        opt = click.Option(["--test"])
+        assert opt.to_info_dict()["conflicts_with"] == []
+
+    def test_to_info_dict_with_conflicts(self):
+        opt = click.Option(["--test"], conflicts_with=["other"])
+        assert opt.to_info_dict()["conflicts_with"] == ["other"]
+
+    def test_resilient_parsing_skips_check(self, runner):
+        @click.command()
+        @click.option("--first", conflicts_with="second")
+        @click.option("--second")
+        def cli(first, second):
+            click.echo(f"{first}:{second}")
+
+        # Normal invocation detects conflict
+        result = runner.invoke(cli, ["--first", "a", "--second", "b"],
