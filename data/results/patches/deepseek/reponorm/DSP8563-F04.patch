+    tc1 = ToolCalls.ToolCall(name="test", args={"x": "  hello  "})
+    tc2 = ToolCalls.ToolCall(name="test", args={"x": "hello"})
+    assert tc1.fingerprint == tc2.fingerprint
+
+
+def test_tool_call_fingerprint_tuple_as_list():
