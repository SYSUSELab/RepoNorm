+# --- ToolCall fingerprint and id tests ---
+
+
+def test_tool_call_fingerprint_basic():
+    """Test that ToolCall has computed fingerprint and id attributes."""
+    tc = ToolCalls.ToolCall(name="search", args={"query": "hello"})
+    assert isinstance(tc.fingerprint, str)
+    assert len(tc.fingerprint) == 64
+    assert tc.fingerprint == "b54b691b00a1d207ee46f8c97b73513715eacb6105197ee731b59d51da7ccc39"
+    assert isinstance(tc.id, str)
+    assert len(tc.id) == 8
+    assert tc.id == "b54b691b"
+
+
+def test_tool_call_fingerprint_deterministic():
+    """Test that identical inputs produce identical fingerprints."""
+    tc1 = ToolCalls.ToolCall(name="search", args={"query": "hello"})
+    tc2 = ToolCalls.ToolCall(name="search", args={"query": "hello"})
+    assert tc1.fingerprint == tc2.fingerprint
+    assert tc1.id == tc2.id
+
+
+def test_tool_call_fingerprint_different_args():
+    """Test that different args produce different fingerprints."""
+    tc1 = ToolCalls.ToolCall(name="search", args={"query": "hello"})
+    tc2 = ToolCalls.ToolCall(name="search", args={"query": "world"})
+    assert tc1.fingerprint != tc2.fingerprint
+    assert tc1.id != tc2.id
+
+
+def test_tool_call_fingerprint_key_sorting():
+    """Test that args with different key order produce identical fingerprints."""
+    tc1 = ToolCalls.ToolCall(name="test", args={"z": 1, "a": 2, "m": 3})
+    tc2 = ToolCalls.ToolCall(name="test", args={"m": 3, "a": 2, "z": 1})
+    assert tc1.fingerprint == tc2.fingerprint
+
+
+def test_tool_call_fingerprint_string_trimming():
