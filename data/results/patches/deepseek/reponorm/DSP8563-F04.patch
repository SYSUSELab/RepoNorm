+def _canonicalize_value(v: Any) -> Any:
+    """Recursively canonicalize a value for fingerprint computation.
+    
+    Sorts dictionary keys, converts tuples to lists, trims string whitespace,
+    rejects nonfinite numbers. Preserves numeric/boolean types and list order.
+    """
+    if isinstance(v, dict):
+        return {k: _canonicalize_value(v) for k, v in sorted(v.items())}
+    elif isinstance(v, tuple):
+        return [_canonicalize_value(item) for item in v]
+    elif isinstance(v, list):
+        return [_canonicalize_value(item) for item in v]
+    elif isinstance(v, str):
+        return v.strip()
+    elif isinstance(v, bool):
+        return v
+    elif isinstance(v, int):
+        return v
+    elif isinstance(v, float):
+        if not math.isfinite(v):
+            raise ValueError(f"Non-finite float value: {v}")
+        return v
+    elif v is None:
+        return None
+    else:
+        raise ValueError(f"Unsupported JSON value type for fingerprint: {type(v).__name__}")
+
+
+def _compute_tool_call_fingerprint(name: str, args: dict[str, Any]) -> str:
+    """Compute the SHA-256 fingerprint for a tool call.
+    
+    The fingerprint is the 64-character hexadecimal SHA-256 of the UTF-8
+    canonical JSON object {"name": name, "args": canonical_args}, using
+    sorted keys and compact comma/colon separators.
+    """
+    canonical_args = _canonicalize_value(args)
+    obj = {"name": name, "args": canonical_args}
+    json_str = json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    return hashlib.sha256(json_str.encode("utf-8")).hexdigest()
+
+
