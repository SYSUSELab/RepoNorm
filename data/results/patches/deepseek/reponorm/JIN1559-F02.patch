+@pass_context
+def dgettext_func(context, domain, string):
+    language = context.get("LANGUAGE", "en")
+    value = languages.get(language, {}).get(f"{domain}:{string}")
+    if value is None:
+        value = languages.get(language, {}).get(string, string)
+    return _get_with_context(value)
+
+
+@pass_context
+def dngettext_func(context, domain, s, p, n):
+    language = context.get("LANGUAGE", "en")
+    key_s = f"{domain}:{s}"
+    key_p = f"{domain}:{p}"
+    value_s = languages.get(language, {}).get(key_s)
+    value_p = languages.get(language, {}).get(key_p)
+    if value_s is not None and value_p is not None:
+        return _get_with_context(value_p if n != 1 else value_s)
+    # fallback to plain
+    if n != 1:
+        value = languages.get(language, {}).get(p, p)
+        return _get_with_context(value)
+    value = languages.get(language, {}).get(s, s)
+    return _get_with_context(value)
+
+
