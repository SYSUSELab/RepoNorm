+@pass_context
+def _trans_priority_gettext(
+    __context: Context, singular: str, priority_value: t.Any, **kwargs: t.Any
+) -> str:
+    """Try priority_gettext levels, fall back to regular gettext.
+    Returns raw translated string (no autoescape, no % formatting).
+    """
+    try:
+        max_level = int(priority_value)
+    except (ValueError, TypeError):
+        max_level = 0
+    if max_level < 0:
+        max_level = 0
+    max_level = min(max_level, 9)
+
+    priority_gettext = __context.resolve("priority_gettext")
+    if priority_gettext is not None and not isinstance(priority_gettext, Undefined):
+        for level in range(max_level + 1):
+            result = __context.call(priority_gettext, singular, level)
+            if result != singular:
+                return result
+    return __context.call(__context.resolve("gettext"), singular, **kwargs)
+
+
+@pass_context
+def _trans_priority_ngettext(
+    __context: Context, singular: str, plural: str, num: t.Any, priority_value: t.Any, **kwargs: t.Any
+) -> str:
+    """Try priority_ngettext levels, fall back to regular ngettext.
+    Returns raw translated string (no autoescape, no % formatting).
+    """
+    try:
+        max_level = int(priority_value)
+    except (ValueError, TypeError):
+        max_level = 0
+    if max_level < 0:
+        max_level = 0
+    max_level = min(max_level, 9)
+
+    priority_ngettext = __context.resolve("priority_ngettext")
+    if priority_ngettext is not None and not isinstance(priority_ngettext, Undefined):
+        for level in range(max_level + 1):
+            result = __context.call(priority_ngettext, singular, plural, num, level)
+            if result != singular:
+                return result
+    return __context.call(
+        __context.resolve("ngettext"), singular, plural, num, **kwargs
+    )
+
