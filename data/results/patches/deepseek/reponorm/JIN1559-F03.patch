+class TestPriority:
+    """Tests for priority fallback in trans blocks."""
+
+    def test_priority_singular(self):
+        """Priority resolver returns a translated result at level 0."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_gettext=lambda m, l: "Hallo" if l == 0 else m,
+        )
+        tmpl = env.from_string(
+            "{% trans priority=0 %}Hello{% endtrans %}"
+        )
+        assert tmpl.render() == "Hallo"
+
+    def test_priority_singular_level1(self):
+        """Priority resolver tries level 0 (miss), then level 1 (hit)."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_gettext=lambda m, l: m if l == 0 else "Servus",
+        )
+        tmpl = env.from_string(
+            "{% trans priority=1 %}Hello{% endtrans %}"
+        )
+        assert tmpl.render() == "Servus"
+
+    def test_priority_singular_max_level(self):
+        """Caps at level 9, goes through levels up to priority value."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        # priority_gettext that returns a match only at level 9
+        def custom_pgt(s, level):
+            if level == 9:
+                return "Matched at 9"
+            return s
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_gettext=custom_pgt,
+        )
+        tmpl = env.from_string(
+            "{% trans priority=100 %}Hello{% endtrans %}"
+        )
+        assert tmpl.render() == "Matched at 9"
+
+    def test_priority_singular_level0_cap(self):
+        """Negative becomes 0; level 0 result different from source returns it."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_gettext=lambda m, l: "Hallo" if l == 0 else m,
+        )
+        tmpl = env.from_string(
+            "{% trans priority=-5 %}Hello{% endtrans %}"
+        )
+        assert tmpl.render() == "Hallo"
+
+    def test_priority_singular_invalid_value(self):
+        """Non-integer priority becomes 0; level 0 miss -> fallback to gettext."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s.upper(),
+            lambda s, p, n: s.upper() if n == 1 else p.upper(),
+            priority_gettext=lambda m, l: m,  # always a miss
+        )
+        tmpl = env.from_string(
+            "{% trans priority='abc' %}World{% endtrans %}"
+        )
+        assert tmpl.render() == "WORLD"
+
+    def test_priority_miss_fallback(self):
+        """No match at any level falls back to ordinary gettext."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s.upper(),
+            lambda s, p, n: s.upper() if n == 1 else p.upper(),
+            priority_gettext=lambda m, l: m,  # always miss
+        )
+        tmpl = env.from_string(
+            "{% trans priority=5 %}Unmatched{% endtrans %}"
+        )
+        assert tmpl.render() == "UNMATCHED"
+
+    def test_priority_no_resolver_fallback(self):
+        """No priority resolver installed falls back to ordinary gettext."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s.upper(),
+            lambda s, p, n: s.upper() if n == 1 else p.upper(),
+            priority_gettext=None,
+            priority_ngettext=None,
+        )
+        tmpl = env.from_string(
+            "{% trans priority=5 %}Hello{% endtrans %}"
+        )
+        assert tmpl.render() == "HELLO"
+
+    def test_priority_plural(self):
+        """Priority works for plural translations (miss -> fallback to ngettext)."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_gettext=lambda m, l: m,
+            priority_ngettext=lambda s, p, n, l: (
+                p if n != 1 else s
+            ),  # miss for all
+        )
+        tmpl = env.from_string(
+            "{% trans count=5, priority=0 %}{{ count }} user{% pluralize %}{{ count }} users{% endtrans %}"
+        )
+        # level 0 is a miss, fallback to ngettext -> identity -> "5 users"
+        assert tmpl.render() == "5 users"
+
+    def test_priority_plural_hit(self):
+        """Priority ngettext returns translated plural at level 0."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_ngettext=lambda s, p, n, l: "%(count)s Benutzer" if n != 1 else s,
+        )
+        tmpl = env.from_string(
+            "{% trans count=5, priority=0 %}{{ count }} user{% pluralize %}{{ count }} users{% endtrans %}"
+        )
+        assert tmpl.render() == "5 Benutzer"
+
+    def test_priority_plural_level1(self):
+        """Priority works for plural at higher level when lower is miss."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_ngettext=lambda s, p, n, l: (
+                s if l == 0 else ("%(count)s Nutzer" if n != 1 else s)
+            ),
+        )
+        tmpl = env.from_string(
+            "{% trans count=5, priority=1 %}{{ count }} user{% pluralize %}{{ count }} users{% endtrans %}"
+        )
+        assert tmpl.render() == "5 Nutzer"
+
+    def test_priority_plural_miss_fallback(self):
+        """No priority match for plural falls back to ordinary ngettext."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: "TRANS:" + (p if n != 1 else s),
+            priority_ngettext=lambda s, p, n, l: s if n != 1 else s,  # always a miss
+        )
+        tmpl = env.from_string(
+            "{% trans count=5, priority=5 %}{{ count }} user{% pluralize %}{{ count }} users{% endtrans %}"
+        )
+        assert tmpl.render() == "TRANS:5 users"
+
+    def test_priority_with_variable(self):
+        """Priority with an interpolated variable and old-style formatting."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+            priority_gettext=priority_gettext,
+        )
+        tmpl = env.from_string(
+            "{% trans name='Welt', priority=0 %}{{ name }} Hello{% endtrans %}"
+        )
+        # Using priority_gettext from module level (not @pass_context!)
+        # Actually this uses the shared PRIORITY_TRANSLATIONS
+        assert tmpl.render() == "Welt Hello"
+
+    def test_priority_duplicate_error(self):
+        """Duplicate priority raises TemplateAssertionError."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+        )
+        with pytest.raises(TemplateAssertionError):
+            env.from_string(
+                "{% trans priority=0 priority=1 %}Hello{% endtrans %}"
+            )
