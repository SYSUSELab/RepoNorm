+# Priority gettext/ngettext callables for testing
+# priority_gettext(message, level): returns a translation if available at that level
+PRIORITY_TRANSLATIONS = {
+    "de": {
+        "Hello": {
+            0: "Hello",  # level 0 is a miss (returns source)
+            1: "Servus",
+            2: "Grüß Gott",
+        },
+        "World": {
+            0: "Welt",
+        },
+        "%(name)s user": {
+            0: "%(name)s Benutzer",
+        },
+        "%(name)s users": {
+            0: "%(name)s Benutzer",
+            1: "%(name)s Nutzer",
+        },
+    }
+}
+
+
+def priority_gettext(message, level):
+    language = "de"
+    trans_by_level = PRIORITY_TRANSLATIONS.get(language, {}).get(message, {})
+    if level in trans_by_level:
+        return trans_by_level[level]
+    return message
+
+
+def priority_ngettext(singular, plural, n, level):
+    language = "de"
+    msg = plural if n != 1 else singular
+    trans_by_level = PRIORITY_TRANSLATIONS.get(language, {}).get(msg, {})
+    if level in trans_by_level:
+        return trans_by_level[level]
+    return msg
+
+
+# Priority test helper that returns identity for levels >= 1
+# Used to test fallback when no priority resolver is installed
+NO_PRIORITY_GETTEXT = None
+NO_PRIORITY_NGETTEXT = None
+
+
