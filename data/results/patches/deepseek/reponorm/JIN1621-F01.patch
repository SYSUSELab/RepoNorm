index b300c8f..af7bddb 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -401,3 +401,145 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+class TestFileSystemLoaderFallback:
+    searchpath = (Path(__file__) / ".." / "res" / "templates").resolve()
+    fallback_searchpath = (Path(__file__) / ".." / "res" / "templates_fallback").resolve()
+
+    def test_default_fallback_is_none(self):
+        """Omitting fallback_searchpath preserves existing behavior."""
+        loader = loaders.FileSystemLoader(self.searchpath)
+        assert loader.fallback_searchpath == []
+
+    def test_fallback_none(self):
+        """None fallback_searchpath means no fallback paths."""
+        loader = loaders.FileSystemLoader(self.searchpath, fallback_searchpath=None)
+        assert loader.fallback_searchpath == []
+
+    def test_fallback_empty_list(self):
+        """Empty sequence fallback_searchpath means no fallback paths."""
+        loader = loaders.FileSystemLoader(self.searchpath, fallback_searchpath=[])
+        assert loader.fallback_searchpath == []
+
+    def test_fallback_as_str(self):
+        """fallback_searchpath accepts a single string."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=str(self.fallback_searchpath)
+        )
+        assert isinstance(loader.fallback_searchpath, list)
+        assert len(loader.fallback_searchpath) == 1
+        assert Path(loader.fallback_searchpath[0]).samefile(self.fallback_searchpath)
+
+    def test_fallback_as_pathlib(self):
+        """fallback_searchpath accepts a pathlib.Path."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=self.fallback_searchpath
+        )
+        assert isinstance(loader.fallback_searchpath, list)
+        assert len(loader.fallback_searchpath) == 1
+
+    def test_fallback_as_list(self):
+        """fallback_searchpath accepts a list of paths."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=[self.fallback_searchpath]
+        )
+        assert isinstance(loader.fallback_searchpath, list)
+        assert len(loader.fallback_searchpath) == 1
+
+    def test_primary_found_first(self):
+        """Template found in primary searchpath uses primary, not fallback."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=self.fallback_searchpath
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("test.html")
+        assert tmpl.render().strip() == "BAR"
+
+    def test_fallback_found_when_primary_missing(self):
+        """Template not in primary but in fallback is found."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=self.fallback_searchpath
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("only_fallback.html")
+        assert tmpl.render().strip() == "ONLY_IN_FALLBACK"
+
+    def test_template_not_found(self):
+        """Template not found in either raises TemplateNotFound."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=self.fallback_searchpath
+        )
+        env = Environment(loader=loader)
+        pytest.raises(TemplateNotFound, env.get_template, "nonexistent.html")
+
+    def test_fallback_ordering(self):
+        """When multiple fallback paths are given, they are searched in order."""
+        tmpdir1 = Path(tempfile.mkdtemp())
+        tmpdir2 = Path(tempfile.mkdtemp())
+        try:
+            (tmpdir1 / "order_test.html").write_text("FIRST_FALLBACK")
+            (tmpdir2 / "order_test.html").write_text("SECOND_FALLBACK")
+
+            loader = loaders.FileSystemLoader(
+                self.searchpath, fallback_searchpath=[tmpdir1, tmpdir2]
+            )
+            env = Environment(loader=loader)
+            tmpl = env.get_template("order_test.html")
+            assert tmpl.render().strip() == "FIRST_FALLBACK"
+        finally:
+            shutil.rmtree(tmpdir1)
+            shutil.rmtree(tmpdir2)
+
+    def test_list_templates_includes_fallback(self):
+        """list_templates includes templates from both primary and fallback."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=self.fallback_searchpath
+        )
+        templates = loader.list_templates()
+        assert "test.html" in templates
+        assert "foo/test.html" in templates
+        assert "only_fallback.html" in templates
+        # Templates from both should be sorted as one list
+        assert templates == sorted(templates)
+
+    def test_list_templates_deduplicates(self):
+        """Duplicate names across primary and fallback appear once."""
+        loader = loaders.FileSystemLoader(
+            self.searchpath, fallback_searchpath=self.searchpath
+        )
+        templates = loader.list_templates()
+        # Each name should appear only once
+        assert len(templates) == len(set(templates))
+
+    def test_primary_deleted_reloads_from_fallback(self):
+        """If primary template is deleted, uptodate becomes False and fallback is used on reload."""
+        tmpdir = Path(tempfile.mkdtemp())
+        try:
+            # Create template in tmpdir (primary)
+            primary_file = tmpdir / "test_delete.html"
+            primary_file.write_text("PRIMARY")
+
+            # Create same template in fallback
+            fallback_dir = Path(tempfile.mkdtemp())
+            (fallback_dir / "test_delete.html").write_text("FALLBACK")
+
+            loader = loaders.FileSystemLoader(
+                tmpdir, fallback_searchpath=fallback_dir
+            )
+            env = Environment(loader=loader)
+
+            # First load from primary
+            tmpl1 = env.get_template("test_delete.html")
+            assert tmpl1.render().strip() == "PRIMARY"
+
+            # Delete primary file - uptodate check should now return False
+            primary_file.unlink()
+
+            # Force reload - should now come from fallback
+            tmpl2 = env.get_template("test_delete.html")
+            assert tmpl2.render().strip() == "FALLBACK"
+
+            shutil.rmtree(fallback_dir)
+        finally:
+            shutil.rmtree(tmpdir)
