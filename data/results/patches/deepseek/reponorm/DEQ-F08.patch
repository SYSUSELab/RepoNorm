@@ -0,0 +1,79 @@
+import re
+from typing import Any, Union
+
+from ._base import DirtyEquals
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+__all__ = 'IsRegex',
+
+
+class IsRegex(DirtyEquals[str]):
+    """
+    A type which checks if a string matches a regular expression.
+
+    ```py title="IsRegex"
+    from dirty_equals import IsRegex
+
+    assert 'hello world' == IsRegex(r'hello')
+    assert 'HELLO WORLD' == IsRegex(r'hello', re.IGNORECASE)
+    assert 'hello world' != IsRegex(r'hello', mode='fullmatch')
+    ```
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, re.Pattern],
+        flags: int = 0,
+        *,
+        mode: Literal['match', 'search', 'fullmatch'] = 'match',
+    ):
+        """
+        Args:
+            pattern: A string pattern or compiled regular expression.
+            flags: Optional standard re flags (ignored if a compiled pattern is given).
+            mode: One of 'match', 'search', or 'fullmatch' corresponding to the
+                Python re functions with the same names.
+        """
+        if isinstance(pattern, re.Pattern):
+            if isinstance(pattern.pattern, bytes):
+                raise TypeError('Bytes patterns are not supported')
+            if flags != 0:
+                raise ValueError('Cannot specify flags when using a compiled pattern')
+            compiled = pattern
+            pattern_str = pattern.pattern
+        elif isinstance(pattern, str):
+            compiled = re.compile(pattern, flags)
+            pattern_str = pattern
+        else:
+            raise TypeError(f'Expected a string pattern or compiled regex, got {type(pattern).__name__}')
+
+        if mode not in ('match', 'search', 'fullmatch'):
+            raise ValueError(f"Invalid mode: {mode!r}, expected 'match', 'search', or 'fullmatch'")
+
+        self._compiled = compiled
+        self._mode = mode
+
+        repr_args = [pattern_str]
+        if flags:
+            repr_args.append(flags)
+
+        repr_kwargs = {}
+        if mode != 'match':
+            repr_kwargs['mode'] = mode
+
+        super().__init__(*repr_args, **repr_kwargs)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self._mode == 'match':
+            return self._compiled.match(other) is not None
+        elif self._mode == 'search':
+            return self._compiled.search(other) is not None
+        else:  # fullmatch
+            return self._compiled.fullmatch(other) is not None
diff --git a/tests/test_regex.py b/tests/test_regex.py
new file mode 100644
index 0000000..0eb5fc5
--- /dev/null
+++ b/tests/test_regex.py
@@ -0,0 +1,193 @@
+import re
+
+import pytest
+
+from dirty_equals import IsRegex
+
+
+def test_basic_match():
+    assert 'hello world' == IsRegex(r'hello')
+    assert 'hello' == IsRegex(r'hello')
+    assert 'hello world' == IsRegex(r'hello', mode='match')
+
+
+def test_search_mode():
+    assert 'hello world' == IsRegex(r'world', mode='search')
+    assert 'goodbye hello world' == IsRegex(r'hello', mode='search')
+    assert 'abc' == IsRegex(r'b', mode='search')
+
+
+def test_fullmatch_mode():
+    assert 'hello' == IsRegex(r'hello', mode='fullmatch')
+    assert 'hello world' != IsRegex(r'hello', mode='fullmatch')
+    assert 'abc' != IsRegex(r'ab', mode='fullmatch')
+    assert 'abc' == IsRegex(r'abc', mode='fullmatch')
+
+
+def test_non_string_returns_false():
+    assert 123 != IsRegex(r'\d+')
+    assert None != IsRegex(r'.*')
+    assert [1, 2] != IsRegex(r'.*')
+    assert (1, 2) != IsRegex(r'.*')
+    assert True != IsRegex(r'.*')
+    assert 3.14 != IsRegex(r'.*')
+
+
+def test_flags():
+    assert 'HELLO' == IsRegex(r'hello', re.IGNORECASE)
+    assert 'hello' == IsRegex(r'hello', re.I)
+    assert 'HELLO WORLD' == IsRegex(r'hello', re.I)
+
+    # Combined flags
+    assert 'HELLO' == IsRegex(r'hello', re.I | re.M)
+    assert 'hello' == IsRegex(r'hello', re.I | re.M)
+
+    # MULTILINE: in search mode, ^ and $ match line boundaries
+    assert 'hello\nworld' == IsRegex(r'^hello', re.M, mode='search')
+    assert 'goodbye\nhello' == IsRegex(r'hello$', re.M, mode='search')
+
+
+def test_compiled_pattern():
+    p = re.compile(r'hello', re.IGNORECASE)
+    m = IsRegex(p)
+    assert 'HELLO' == m
+    assert 'hello' == m
+    assert 'hello world' == m
+
+    p2 = re.compile(r'\d+')
+    assert '123' == IsRegex(p2)
+
+
+def test_compiled_pattern_with_flags_raises():
+    p = re.compile(r'hello', re.I)
+    with pytest.raises(ValueError, match='Cannot specify flags when using a compiled pattern'):
+        IsRegex(p, re.MULTILINE)
+
+
+def test_invalid_mode_raises():
+    with pytest.raises(ValueError, match="Invalid mode"):
+        IsRegex(r'hello', mode='invalid')
+
+    with pytest.raises(ValueError, match="expected 'match'"):
+        IsRegex(r'hello', mode='invalid_mode')
+
+
+def test_invalid_pattern_raises():
+    with pytest.raises(re.error):
+        IsRegex(r'[invalid')
+
+
+def test_bytes_pattern():
+    with pytest.raises(TypeError):
+        IsRegex(b'hello')
+
+
+def test_repr_no_flags():
+    assert repr(IsRegex(r'hello')) == "IsRegex('hello')"
+    assert repr(IsRegex(r'\d+')) == r"IsRegex('\\d+')"
+
+
+def test_repr_with_flags():
+    r = repr(IsRegex(r'hello', re.IGNORECASE))
+    assert r == "IsRegex('hello', re.IGNORECASE)"
+
+    r = repr(IsRegex(r'hello', re.I | re.M))
+    assert 're.IGNORECASE' in r
+    assert 're.MULTILINE' in r
+
+
+def test_repr_with_non_default_mode():
+    assert repr(IsRegex(r'hello', mode='search')) == "IsRegex('hello', mode='search')"
+    assert repr(IsRegex(r'hello', mode='fullmatch')) == "IsRegex('hello', mode='fullmatch')"
+
+
+def test_repr_with_flags_and_mode():
+    r = repr(IsRegex(r'hello', re.I, mode='search'))
+    assert r == "IsRegex('hello', re.IGNORECASE, mode='search')"
+
+
+def test_repr_after_successful_comparison():
+    m = IsRegex(r'hello')
+    assert m == 'hello world'
+    # After successful comparison, repr returns repr of the matched value
+    assert repr(m) == repr('hello world')
+
+
+def test_repr_before_comparison():
+    m = IsRegex(r'hello')
+    assert repr(m) == "IsRegex('hello')"
+
+    m2 = IsRegex(r'hello', re.I)
+    assert repr(m2) == "IsRegex('hello', re.IGNORECASE)"
+
+
+def test_value_after_successful_comparison():
+    m = IsRegex(r'hello')
+    assert m == 'hello world'
+    assert m.value == 'hello world'
+
+
+def test_value_before_comparison_raises():
+    m = IsRegex(r'hello')
+    with pytest.raises(AttributeError):
+        _ = m.value
+
+
+def test_empty_string():
+    assert '' == IsRegex(r'')
+    assert 'abc' == IsRegex(r'')
+    assert IsRegex(r'') == ''
+
+
+def test_escaped_metacharacters():
+    assert 'a.b' == IsRegex(r'a\.b')
+    assert 'aab' != IsRegex(r'a\.b')
+    assert 'a*b' == IsRegex(r'a\*b')
+    assert 'a\\b' == IsRegex(r'a\\b')
+
+
+def test_multiline_pattern():
+    # pattern with literal newline
+    assert 'hello\nworld' == IsRegex(r'hello\nworld')
+    # dot doesn't match newline by default
+    assert 'hello\nworld' != IsRegex(r'hello.world')  # dot doesn't match newline by default
+    assert 'hello\nworld' == IsRegex(r'hello.world', re.DOTALL)
+
+
+def test_combined_flags():
+    assert 'HELLO\nWORLD' == IsRegex(r'^hello.world$', re.I | re.M | re.DOTALL)
+    assert 'HELLO\nWORLD' == IsRegex(r'hello.world', re.I | re.DOTALL, mode='search')
+
+
+def test_unicode_pattern():
+    assert 'café' == IsRegex(r'café')
+    assert 'Café' == IsRegex(r'café', re.IGNORECASE)
+    assert 'CAFÉ' == IsRegex(r'café', re.IGNORECASE)
+
+
+def test_compiled_pattern_retains_flags():
+    p = re.compile(r'hello', re.IGNORECASE)
+    m = IsRegex(p)
+    # Before comparison, repr shows the uncompiled pattern
+    assert repr(m) == "IsRegex('hello')"
+    # Compiled pattern retains its flags
+    assert 'HELLO' == m
+
+
+def test_ne_operator():
+    assert IsRegex(r'hello') != 123
+    assert IsRegex(r'hello') != None
+    assert IsRegex(r'hello') != 'goodbye'
+
+
+def test_dirty_equals_integration():
+    from dirty_equals import IsOneOf
+
+    # IsRegex works with IsOneOf
+    assert 'hello' == IsOneOf(IsRegex(r'hello'), IsRegex(r'world'))
+    assert 'world' == IsOneOf(IsRegex(r'hello'), IsRegex(r'world'))
+    assert 'foo' != IsOneOf(IsRegex(r'hello'), IsRegex(r'world'))
+
+    # IsRegex works with __or__
+    assert 'hello' == (IsRegex(r'hello') | IsRegex(r'world'))
+    assert 'world' == (IsRegex(r'hello') | IsRegex(r'world'))
