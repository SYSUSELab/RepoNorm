index b300c8f..20362f1 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -116,6 +116,64 @@ class TestLoaders:
         assert split_template_path("./foo/bar") == ["foo", "bar"]
         pytest.raises(TemplateNotFound, split_template_path, "../foo")
 
+    def test_split_template_path_normalization(self):
+        """Test logical path normalization in split_template_path."""
+        # Normal paths unchanged
+        assert split_template_path("foo/bar") == ["foo", "bar"]
+        assert split_template_path("foo/bar/baz") == ["foo", "bar", "baz"]
+
+        # Dot segments removed
+        assert split_template_path("./foo/bar") == ["foo", "bar"]
+        assert split_template_path("foo/./bar") == ["foo", "bar"]
+        assert split_template_path("././foo") == ["foo"]
+        assert split_template_path(".") == []
+
+        # Backslash as separator
+        assert split_template_path("foo\\bar") == ["foo", "bar"]
+        assert split_template_path(".\\foo\\bar") == ["foo", "bar"]
+        assert split_template_path("foo\\..\\test.html") == ["test.html"]
+
+        # Mixed separators
+        assert split_template_path("foo/bar\\baz") == ["foo", "bar", "baz"]
+        assert split_template_path("foo\\bar/baz") == ["foo", "bar", "baz"]
+
+        # Internal .. resolution
+        assert split_template_path("foo/../test.html") == ["test.html"]
+        assert split_template_path("foo/bar/../../baz") == ["baz"]
+        assert split_template_path("a/b/c/../../d") == ["a", "d"]
+        assert split_template_path("foo/..") == []
+        assert split_template_path("foo/../bar/..") == []
+
+        # Leading .. rejected
+        pytest.raises(TemplateNotFound, split_template_path, "../foo")
+        pytest.raises(TemplateNotFound, split_template_path, "..\\foo")
+
+        # .. that pops beyond root
+        pytest.raises(TemplateNotFound, split_template_path, "foo/../../bar")
+        pytest.raises(TemplateNotFound, split_template_path, "..")
+        pytest.raises(TemplateNotFound, split_template_path, "foo/../..")
+
+        # Absolute paths rejected
+        pytest.raises(TemplateNotFound, split_template_path, "/foo")
+        pytest.raises(TemplateNotFound, split_template_path, "\\foo")
+        pytest.raises(TemplateNotFound, split_template_path, "/")
+        pytest.raises(TemplateNotFound, split_template_path, "\\")
+
+        # UNC forms rejected
+        pytest.raises(TemplateNotFound, split_template_path, "\\\\server\\share")
+
+        # Drive prefixes rejected (on any OS)
+        pytest.raises(TemplateNotFound, split_template_path, "C:foo")
+        pytest.raises(TemplateNotFound, split_template_path, "C:\\foo")
+        pytest.raises(TemplateNotFound, split_template_path, "c:foo/bar")
+
+        # Triple dot is not special
+        assert split_template_path("foo/...") == ["foo", "..."]
+        assert split_template_path(".../foo") == ["...", "foo"]
+
+        # Empty string
+        assert split_template_path("") == []
+
 
