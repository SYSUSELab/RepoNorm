diff --git a/src/jinja2/loaders.py b/src/jinja2/loaders.py
index d7d9bd0..8888fc8 100644
--- a/src/jinja2/loaders.py
+++ b/src/jinja2/loaders.py
@@ -25,15 +25,28 @@ def split_template_path(template: str) -> t.List[str]:
     """Split a path into segments and perform a sanity check.  If it detects
     '..' in the path it will raise a `TemplateNotFound` error.
     """
+    # Reject names beginning with / or \ (absolute paths and UNC forms).
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+
+    # Reject names beginning with an ASCII drive prefix such as C:.
+    if (
+        len(template) >= 2
+        and template[1] == ":"
+        and template[0].isascii()
+        and template[0].isalpha()
+    ):
+        raise TemplateNotFound(template)
+
     pieces = []
-    for piece in template.split("/"):
-        if (
-            os.path.sep in piece
-            or (os.path.altsep and os.path.altsep in piece)
-            or piece == os.path.pardir
-        ):
-            raise TemplateNotFound(template)
-        elif piece and piece != ".":
+    for piece in template.replace("\\", "/").split("/"):
+        if piece == "" or piece == ".":
+            continue
+        elif piece == "..":
+            if not pieces:
+                raise TemplateNotFound(template)
+            pieces.pop()
+        else:
             pieces.append(piece)
     return pieces
 
