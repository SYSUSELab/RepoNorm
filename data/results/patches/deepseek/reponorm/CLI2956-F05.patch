+    def clear_value_cache(self) -> None:
+        """Clear the internal value cache for this option.
+
+        Discards all cached type-conversion results. The next
+        invocation will re-convert the raw value.
+
+        .. versionadded:: 8.3
+        """
+        self._value_cache.clear()
+
+    def type_cast_value(
+        self, ctx: Context, value: t.Any
+    ) -> t.Any:
+        """Override of :meth:`Parameter.type_cast_value` that
+        caches the conversion result when ``cache`` is enabled.
+
+        .. versionadded:: 8.3
+        """
+        if (
+            self.cache
+            and self.nargs == 1
+            and not self.multiple
+            and value is not None
+            and not isinstance(self.type, (types.File, types.Path))
+        ):
+            try:
+                h = hash(value)
+            except TypeError:
+                pass
+            else:
+                try:
+                    return self._value_cache[h]
+                except KeyError:
+                    result = super().type_cast_value(ctx, value)
+                    self._value_cache[h] = result
+                    return result
+
+        return super().type_cast_value(ctx, value)
+
