+    def test_trans_reserved_variable_names(self):
+        """Reserved translation function names cannot be declared in trans header."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        for name in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(TemplateSyntaxError) as exc:
+                i18n_env.from_string(
+                    f"{{% trans {name}='hello' %}}foo{{% endtrans %}}"
+                )
+            assert "conflicts with translation function names" in str(exc.value.message)
+
+    def test_trans_reserved_body_references(self):
+        """Reserved translation function names cannot be referenced in trans body."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        for name in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(TemplateSyntaxError) as exc:
+                i18n_env.from_string(
+                    "{% trans %}{{" + name + "}}{% endtrans %}"
+                )
+            assert "conflicts with translation function names" in str(exc.value.message)
+
+    def test_trans_reserved_body_plural(self):
+        """Reserved names in plural body also raise."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        for name in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(TemplateSyntaxError) as exc:
+                i18n_env.from_string(
+                    "{% trans count=1 %}hello{% pluralize %}{{"
+                    + name
+                    + "}}{% endtrans %}"
+                )
+            assert "conflicts with translation function names" in str(exc.value.message)
+
+    def test_trans_valid_expressions(self):
+        """Valid expression types in trans assignments."""
+        i18n_env.from_string("{% trans x=42 %}hello{% endtrans %}")
+        i18n_env.from_string("{% trans x=y %}hello{% endtrans %}")
+        i18n_env.from_string("{% trans x=foo.bar %}hello{% endtrans %}")
+        i18n_env.from_string("{% trans x=foo|lower %}hello{% endtrans %}")
+        i18n_env.from_string("{% trans x=foo is defined %}hello{% endtrans %}")
+        i18n_env.from_string("{% trans x=foo(1, 2) %}hello{% endtrans %}")
+
+    def test_trans_invalid_expressions(self):
+        """Invalid expression types raise TemplateSyntaxError with proper messages."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        cases = [
+            ("{% trans x=foo[0] %}hello{% endtrans %}", "getitem"),
+            ("{% trans x=foo + 1 %}hello{% endtrans %}", "arithmetic"),
+            ("{% trans x=foo if bar else baz %}hello{% endtrans %}", "conditional"),
+            ("{% trans x=foo.bar() %}hello{% endtrans %}", "method call"),
+            ("{% trans x=foo(*args) %}hello{% endtrans %}", "*args"),
+            ("{% trans x=foo(**kwargs) %}hello{% endtrans %}", "**kwargs"),
+        ]
+
+        for tmpl, desc in cases:
+            with pytest.raises(TemplateSyntaxError) as exc:
+                i18n_env.from_string(tmpl)
+            msg = str(exc.value.message)
+            assert "template data" in msg, f"{desc}: missing 'template data' in {msg}"
+            assert "translation contexts" in msg, f"{desc}: missing 'translation contexts' in {msg}"
+
+    def test_trans_duplicate_variable(self):
+        """Duplicate-variable errors still raise TemplateAssertionError."""
+        from jinja2.exceptions import TemplateAssertionError
+
+        with pytest.raises(TemplateAssertionError):
+            i18n_env.from_string("{% trans x=1, x=2 %}hello{% endtrans %}")
+
+    def test_trans_trimmed_notrimmed_with_validation(self):
+        """trimmed/notrimmed do not interfere with expression validation."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        # trimmed with valid expression
+        i18n_env.from_string("{% trans trimmed x=42 %}hello {{ x }}{% endtrans %}")
+
+        # notrimmed with valid expression
+        i18n_env.from_string("{% trans notrimmed x=foo|lower %}hello{% endtrans %}")
+
+        # trimmed with invalid expression
+        with pytest.raises(TemplateSyntaxError):
+            i18n_env.from_string(
+                "{% trans trimmed x=foo[0] %}hello{% endtrans %}"
+            )
+
+    def test_trans_plural_validation(self):
+        """Plural block assignment validation works."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        # valid plural template
+        i18n_env.from_string(
+            "{% trans x=1 %}hello{% pluralize x %}bye{% endtrans %}"
+        )
+
+        # invalid expression in singular assignment with plural block
+        with pytest.raises(TemplateSyntaxError) as exc:
+            i18n_env.from_string(
+                "{% trans x=foo+1 %}hello{% pluralize x %}bye{% endtrans %}"
+            )
+        assert "template data" in str(exc.value.message)
+        assert "translation contexts" in str(exc.value.message)
+
+    def test_trans_reserved_names_with_plural(self):
+        """Reserved name checks work with plural blocks."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        # reserved name in singular body with plural block
+        with pytest.raises(TemplateSyntaxError) as exc:
+            i18n_env.from_string(
+                "{% trans x=1 %}hello{% pluralize x %}bye {{ gettext }}{% endtrans %}"
+            )
+        assert "conflicts with translation function names" in str(exc.value.message)
+
+        # reserved name referenced from plural body
+        with pytest.raises(TemplateSyntaxError) as exc:
+            i18n_env.from_string(
+                "{% trans x=1 %}hello{% pluralize x %}bye {{_}}{% endtrans %}"
+            )
+        assert "conflicts with translation function names" in str(exc.value.message)
+
