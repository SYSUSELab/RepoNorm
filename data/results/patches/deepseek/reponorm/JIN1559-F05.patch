+    @staticmethod
+    def _validate_trans_expr(
+        expr: nodes.Expr, var_name: str, lineno: int, parser: "Parser"
+    ) -> None:
+        """Validate that *expr* uses only node types allowed in ``trans``
+        variable assignments.  Raises ``TemplateSyntaxError`` if not.
+        """
+        # Reject dynamic *args / **kwargs on the top-level expression
+        if isinstance(expr, (nodes.Call, nodes.Filter, nodes.Test)):
+            if expr.dyn_args is not None or expr.dyn_kwargs is not None:
+                parser.fail(
+                    f'expression "{var_name}" includes *args or **kwargs,'
+                    f" which are not allowed in template data or translation"
+                    f" contexts",
+                    lineno,
+                )
+            # For Call, the callee (node) must be a simple Name
+            if isinstance(expr, nodes.Call) and not isinstance(
+                expr.node, nodes.Name
+            ):
+                parser.fail(
+                    f'expression "{var_name}" includes a method call or'
+                    f" complex callable that is not allowed in template data"
+                    f" or translation contexts",
+                    lineno,
+                )
+
+        # Check the node type
+        if isinstance(expr, nodes.Const):
+            return  # leaf node
+        elif isinstance(expr, nodes.Name):
+            return  # leaf node
+        elif isinstance(expr, nodes.Getattr):
+            InternationalizationExtension._validate_trans_expr(
+                expr.node, var_name, lineno, parser
+            )
+        elif isinstance(expr, nodes.Filter):
+            InternationalizationExtension._validate_trans_expr(
+                expr.node, var_name, lineno, parser
+            )
+            for arg in expr.args:
+                InternationalizationExtension._validate_trans_expr(
+                    arg, var_name, lineno, parser
+                )
+            for kw in expr.kwargs:
+                InternationalizationExtension._validate_trans_expr(
+                    kw.value, var_name, lineno, parser
+                )
+        elif isinstance(expr, nodes.Test):
+            InternationalizationExtension._validate_trans_expr(
+                expr.node, var_name, lineno, parser
+            )
+            for arg in expr.args:
+                InternationalizationExtension._validate_trans_expr(
+                    arg, var_name, lineno, parser
+                )
+            for kw in expr.kwargs:
+                InternationalizationExtension._validate_trans_expr(
+                    kw.value, var_name, lineno, parser
+                )
+        elif isinstance(expr, nodes.Call):
+            InternationalizationExtension._validate_trans_expr(
+                expr.node, var_name, lineno, parser
+            )
+            for arg in expr.args:
+                InternationalizationExtension._validate_trans_expr(
+                    arg, var_name, lineno, parser
+                )
+            for kw in expr.kwargs:
+                InternationalizationExtension._validate_trans_expr(
+                    kw.value, var_name, lineno, parser
+                )
+        else:
+            parser.fail(
+                f'expression "{var_name}" includes a construct that is not'
+                f" allowed in template data or translation contexts",
+                lineno,
+            )
