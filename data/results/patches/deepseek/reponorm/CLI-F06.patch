+    def save_state(self) -> dict[str, t.Any]:
+        """Create a snapshot of the current parsing and presentation
+        state that can be restored with :meth:`restore_state`.
+
+        The snapshot is a dictionary whose keys correspond to Context
+        attribute names.  Mutable values are independent of the source
+        Context.  Within a snapshot, shared references across supported
+        fields and cycles are preserved.
+
+        Snapshots are reusable and multiple snapshots remain
+        independently restorable.
+
+        .. versionadded:: 8.2
+        """
+        state = {
+            "params": self.params,
+            "args": self.args,
+            "_protected_args": self._protected_args,
+            "_opt_prefixes": self._opt_prefixes,
+            "obj": self.obj,
+            "_meta": self._meta,
+            "default_map": self.default_map,
+            "invoked_subcommand": self.invoked_subcommand,
+            "terminal_width": self.terminal_width,
+            "max_content_width": self.max_content_width,
+            "resilient_parsing": self.resilient_parsing,
+            "allow_extra_args": self.allow_extra_args,
+            "allow_interspersed_args": self.allow_interspersed_args,
+            "ignore_unknown_options": self.ignore_unknown_options,
+            "help_option_names": self.help_option_names,
+            "token_normalize_func": self.token_normalize_func,
+            "auto_envvar_prefix": self.auto_envvar_prefix,
+            "color": self.color,
+            "show_default": self.show_default,
+            "_parameter_source": self._parameter_source,
+        }
+        return copy.deepcopy(state)
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Restore parsing and presentation state from a snapshot
+        created by :meth:`save_state`.
+
+        The snapshot must contain all supported keys and have
+        dictionary-valued metadata.  Missing keys, invalid metadata,
+        or values that cannot be copied raise without partially
+        changing the Context.
+
+        Restoring metadata changes its contents while preserving the
+        existing metadata dictionary.  Unknown snapshot keys are
+        ignored.
+
+        .. versionadded:: 8.2
+        """
+        # Validate all required keys are present.
+        missing = self._save_state_keys - snapshot.keys()
+        if missing:
+            raise TypeError(
+                "Snapshot missing required keys: " + ", ".join(sorted(missing))
+            )
+
+        # Validate that _meta is a dictionary.
+        meta = snapshot.get("_meta")
+        if not isinstance(meta, dict):
+            raise TypeError(
+                "Snapshot value for _meta must be a dictionary."
+            )
+
+        try:
+            # Deep-copy the meta content to preserve independently.
+            meta_content: dict[str, t.Any] = copy.deepcopy(meta)
+
+            # Deep-copy the snapshot, but map any reference to the
+            # snapshot's _meta dict to the Context's existing _meta dict.
+            # This ensures that within the restored state, references
+            # that pointed to _meta still point to the shared dict.
+            memo: dict[int, object] = {id(meta): self._meta}
+            restored: dict[str, t.Any] = copy.deepcopy(snapshot, memo)
+        except Exception as e:
+            raise TypeError(
+                f"Failed to copy snapshot values: {e}"
+            ) from e
+
+        # Update the existing _meta dict in-place so parent/child
+        # sharing is preserved.
+        self._meta.clear()
+        self._meta.update(meta_content)
+
+        # Apply all other supported attributes.
+        self.params = restored["params"]
+        self.args = restored["args"]
+        self._protected_args = restored["_protected_args"]
+        self._opt_prefixes = restored["_opt_prefixes"]
+        self.obj = restored["obj"]
+        self.default_map = restored["default_map"]
+        self.invoked_subcommand = restored["invoked_subcommand"]
+        self.terminal_width = restored["terminal_width"]
+        self.max_content_width = restored["max_content_width"]
+        self.resilient_parsing = restored["resilient_parsing"]
+        self.allow_extra_args = restored["allow_extra_args"]
+        self.allow_interspersed_args = restored["allow_interspersed_args"]
+        self.ignore_unknown_options = restored["ignore_unknown_options"]
+        self.help_option_names = restored["help_option_names"]
+        self.token_normalize_func = restored["token_normalize_func"]
+        self.auto_envvar_prefix = restored["auto_envvar_prefix"]
+        self.color = restored["color"]
+        self.show_default = restored["show_default"]
+        self._parameter_source = restored["_parameter_source"]
+
