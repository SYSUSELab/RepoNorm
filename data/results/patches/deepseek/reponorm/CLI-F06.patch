+class TestSaveRestoreState:
+    """Tests for Context.save_state() and Context.restore_state()."""
+
+    def test_basic_save_and_restore(self):
+        ctx = click.Context(click.Command("test"))
+        snap = ctx.save_state()
+        assert isinstance(snap, dict)
+        assert snap["params"] == {}
+        assert snap["args"] == []
+        assert snap["_meta"] == {}
+        assert snap["_parameter_source"] == {}
+
+    def test_snapshot_independence(self):
+        ctx = click.Context(click.Command("test"))
+        snap = ctx.save_state()
+        ctx.params["key"] = "val"
+        ctx.args.append("--flag")
+        ctx._meta["foo"] = "bar"
+        assert snap["params"] == {}
+        assert snap["args"] == []
+        assert snap["_meta"] == {}
+
+    def test_restore_reverts_state(self):
+        ctx = click.Context(click.Command("test"))
+        ctx.params["x"] = 1
+        ctx.args = ["--opt"]
+        ctx._protected_args = ["--"]
+        ctx._opt_prefixes = {"--", "-"}
+        ctx.obj = {"hello": "world"}
+        ctx._meta["meta_key"] = "meta_val"
+        ctx.default_map = {"option": "value"}
+        ctx.invoked_subcommand = "sub"
+        ctx.terminal_width = 80
+        ctx.max_content_width = 120
+        ctx.resilient_parsing = True
+        ctx.allow_extra_args = True
+        ctx.allow_interspersed_args = False
+        ctx.ignore_unknown_options = True
+        ctx.help_option_names = ["--help", "-h"]
+        ctx.token_normalize_func = lambda s: s.upper()
+        ctx.auto_envvar_prefix = "MYAPP"
+        ctx.color = False
+        ctx.show_default = True
+
+        snap = ctx.save_state()
+        ctx.params.clear()
+        ctx.args.clear()
+        ctx._protected_args.clear()
+        ctx._opt_prefixes.clear()
+        ctx.obj = None
+        ctx._meta.clear()
+        ctx.default_map = None
+        ctx.invoked_subcommand = None
+        ctx.terminal_width = None
+        ctx.max_content_width = None
+        ctx.resilient_parsing = False
+        ctx.allow_extra_args = False
+        ctx.allow_interspersed_args = True
+        ctx.ignore_unknown_options = False
+        ctx.help_option_names = ["--help"]
+        ctx.token_normalize_func = None
+        ctx.auto_envvar_prefix = None
+        ctx.color = None
+        ctx.show_default = None
+
+        ctx.restore_state(snap)
+        assert ctx.params == {"x": 1}
+        assert ctx.args == ["--opt"]
+        assert ctx._protected_args == ["--"]
+        assert ctx._opt_prefixes == {"--", "-"}
+        assert ctx.obj == {"hello": "world"}
+        assert ctx._meta == {"meta_key": "meta_val"}
+        assert ctx.default_map == {"option": "value"}
+        assert ctx.invoked_subcommand == "sub"
+        assert ctx.terminal_width == 80
+        assert ctx.max_content_width == 120
+        assert ctx.resilient_parsing is True
+        assert ctx.allow_extra_args is True
+        assert ctx.allow_interspersed_args is False
+        assert ctx.ignore_unknown_options is True
+        assert ctx.help_option_names == ["--help", "-h"]
+        assert ctx.token_normalize_func("abc") == "ABC"
+        assert ctx.auto_envvar_prefix == "MYAPP"
+        assert ctx.color is False
+        assert ctx.show_default is True
+
+    def test_multiple_independent_snapshots(self):
+        ctx = click.Context(click.Command("test"))
+        ctx.params["a"] = 1
+        snap1 = ctx.save_state()
+        ctx.params["b"] = 2
+        snap2 = ctx.save_state()
+        ctx.params["c"] = 3
+
+        ctx.restore_state(snap1)
+        assert ctx.params == {"a": 1}
+        ctx.restore_state(snap2)
+        assert ctx.params == {"a": 1, "b": 2}
+
+    def test_unknown_keys_ignored(self):
+        ctx = click.Context(click.Command("test"))
+        snap = ctx.save_state()
+        snap["_unknown"] = "ignored"
+        ctx.restore_state(snap)  # must not raise
+
+    def test_missing_keys_raises_type_error(self):
+        ctx = click.Context(click.Command("test"))
+        with pytest.raises(TypeError, match="missing required keys"):
+            ctx.restore_state({})
+
+    def test_non_dict_meta_raises_type_error(self):
+        ctx = click.Context(click.Command("test"))
+        snap = ctx.save_state()
+        snap["_meta"] = "not-a-dict"
+        with pytest.raises(TypeError, match="_meta"):
+            ctx.restore_state(snap)
+
+    def test_meta_shared_dict_preserved(self):
+        parent = click.Context(click.Command("parent"))
+        child = click.Context(click.Command("child"), parent=parent)
+        assert child._meta is parent._meta
+
+        child._meta["foo"] = "bar"
+        snap = child.save_state()
+        child._meta["foo"] = "baz"
+        child.restore_state(snap)
+
+        assert child._meta["foo"] == "bar"
+        assert parent._meta["foo"] == "bar"
+        assert child._meta is parent._meta
+
+    def test_transactional_on_copy_failure(self):
+        class Uncopyable:
+            def __deepcopy__(self, memo):
+                raise RuntimeError("cannot copy")
+
+        ctx = click.Context(click.Command("test"))
+        ctx.params["original"] = "value"
+        snap = ctx.save_state()
+        snap["obj"] = Uncopyable()
+
+        with pytest.raises(TypeError, match="Failed to copy"):
+            ctx.restore_state(snap)
+
+        # Context must be unchanged
+        assert ctx.params == {"original": "value"}
+
+    def test_resilient_parsing_works(self):
+        ctx = click.Context(click.Command("test"), resilient_parsing=True)
+        snap = ctx.save_state()
+        assert snap["resilient_parsing"] is True
+        ctx.resilient_parsing = False
+        ctx.restore_state(snap)
+        assert ctx.resilient_parsing is True
+
+    def test_parameter_source_roundtrip(self):
+        from click.core import ParameterSource
+
+        ctx = click.Context(click.Command("test"))
+        ctx.set_parameter_source("opt", ParameterSource.COMMANDLINE)
+        snap = ctx.save_state()
+        assert snap["_parameter_source"]["opt"] == ParameterSource.COMMANDLINE
+
+        ctx.set_parameter_source("opt", ParameterSource.DEFAULT)
+        ctx.restore_state(snap)
+        assert ctx.get_parameter_source("opt") == ParameterSource.COMMANDLINE
+
+    def test_shared_references_preserved(self):
+        ctx = click.Context(click.Command("test"))
+        shared = {"x": 1}
+        ctx.obj = {"ref": shared}
+        ctx.default_map = {"ref": shared}
+        snap = ctx.save_state()
+        assert snap["obj"]["ref"] is snap["default_map"]["ref"]
+
+        ctx.obj = None
+        ctx.default_map = None
+        ctx.restore_state(snap)
+        # After restore, the shared reference must still hold in the
+        # restored state (individually deep-copied values are independent
+        # of the snapshot, but the internal graph within the restored
+        # state maintains the shared reference).
+        restored_obj = ctx.obj["ref"]
+        restored_dm = ctx.default_map["ref"]
+        assert restored_obj is restored_dm
+
+    def test_cycles_preserved(self):
+        ctx = click.Context(click.Command("test"))
+        cycle = {}
+        cycle["self"] = cycle
+        ctx.obj = cycle
+        snap = ctx.save_state()
+        assert snap["obj"]["self"] is snap["obj"]
+
+        ctx.obj = None
+        ctx.restore_state(snap)
+        assert ctx.obj["self"] is ctx.obj
+
+    def test_snapshots_remain_independent_after_restore(self):
+        ctx = click.Context(click.Command("test"))
+        ctx.params["a"] = 1
+        snap = ctx.save_state()
+        ctx.restore_state(snap)
+        # Mutating the snapshot after restore should not affect ctx
+        snap["params"]["new"] = "bad"
+        assert "new" not in ctx.params
+        # Mutating ctx after restore should not affect snapshot
+        ctx.params["other"] = "bad2"
+        assert "other" not in snap["params"]
+
+    def test_opt_prefixes_as_set(self):
+        ctx = click.Context(click.Command("test"))
+        ctx._opt_prefixes = {"--", "-", "/"}
+        snap = ctx.save_state()
+        assert isinstance(snap["_opt_prefixes"], set)
+        assert snap["_opt_prefixes"] == {"--", "-", "/"}
+        ctx._opt_prefixes = {"+"}
+        ctx.restore_state(snap)
+        assert ctx._opt_prefixes == {"--", "-", "/"}
