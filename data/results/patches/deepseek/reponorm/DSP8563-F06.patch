+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Extract Python JSON structures from supported input formats.
+
+        Accepts plain JSON strings, markdown code-fenced JSON blocks (with or
+        without language labels), and already-parsed dicts or lists. On success
+        returns the parsed Python JSON structure; on failure returns the original
+        input unchanged.
+
+        Calling this method manually is not required under normal usage; the
+        Pydantic model API (model_validate, model_validate_json) invokes it
+        automatically through a model_validator.
+        """
+        if not isinstance(data, str):
+            return data
+        stripped = data.strip()
+        # First try plain JSON parsing
+        try:
+            return json.loads(stripped)
+        except json.JSONDecodeError:
+            pass
+        # Try extracting from the first markdown code fence
+        return cls._extract_from_fence(stripped)
+
+    @pydantic.model_validator(mode="before")
+    @classmethod
+    def _validate_and_normalize(cls, data: Any) -> Any:
+        """Model validator that normalizes data for ToolCalls validation."""
+        if isinstance(data, cls):
+            return {"tool_calls": [tc.model_dump() for tc in data.tool_calls]}
+
+        if isinstance(data, str):
+            extracted = cls.validate_input(data)
+            if extracted is not data:
+                # Extraction succeeded, normalize the result
+                return cls._normalize(extracted)
+            # Extraction did not succeed; return as-is so Pydantic produces
+            # its ordinary validation error.
+            return data
+
+        # For non-string data (lists, single name/args dicts), try normalization
+        return cls._normalize(data)
+
+    @classmethod
+    def model_validate_json(cls, data: Any, *args, **kwargs) -> "ToolCalls":
+        """Validate JSON data, including code-fenced JSON strings."""
+        if isinstance(data, bytes):
+            data = data.decode("utf-8")
+        if isinstance(data, str):
+            extracted = cls._try_extract_json_for_api(data)
+            if extracted is not data:
+                normalized = cls._normalize(extracted)
+                return cls.model_validate(normalized, *args, **kwargs)
+        return super().model_validate_json(data, *args, **kwargs)
+
+    @classmethod
+    def _try_extract_json_for_api(cls, data: str) -> Any:
+        """Try plain JSON parse first, then code fence extraction."""
+        stripped = data.strip()
+        try:
+            return json.loads(stripped)
+        except json.JSONDecodeError:
+            pass
+        return cls._extract_from_fence(stripped)
+
+    @classmethod
+    def _extract_from_fence(cls, data: str) -> Any:
+        """Extract JSON from the first triple-backtick code fence.
+
+        The opening fence may have any language label (or no label), followed
+        by a newline. The next triple-backtick delimiter closes the block.
+        Only the first block is considered.
+        """
+        fence_start = data.find("```")
+        if fence_start == -1:
+            return data
+
+        after_fence = data[fence_start + 3:]
+        newline_pos = after_fence.find("\n")
+        if newline_pos == -1:
+            return data  # Inline fence without opening newline: not supported
+
+        body_start = fence_start + 3 + newline_pos + 1
+        remaining = data[body_start:]
+
+        closing_match = re.search(r"\n```", remaining)
+        if closing_match is None:
+            return data  # No closing fence
+
+        body = remaining[:closing_match.start()].strip()
+        try:
+            return json.loads(body)
+        except json.JSONDecodeError:
+            return data
+
+    @classmethod
+    def _normalize(cls, data: Any) -> Any:
+        """Normalize parsed data into a canonical ToolCalls-compatible dict."""
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            # Single name/args object
+            return {"tool_calls": [data]}
+        if isinstance(data, list):
+            return {"tool_calls": data}
+        return data
+
