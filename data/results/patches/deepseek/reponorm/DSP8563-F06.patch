+def test_tool_calls_validate_input_plain_json():
+    """validate_input extracts valid plain JSON strings."""
+    result = ToolCalls.validate_input('{"tool_calls": [{"name": "test", "args": {}}]}')
+    assert isinstance(result, dict)
