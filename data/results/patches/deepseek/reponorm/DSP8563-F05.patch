+def test_tool_call_default_metadata():
+    """Test that ToolCall metadata attributes default to None."""
+    tc = ToolCalls.ToolCall(name="test", args={})
+    assert tc.note is None
+    assert tc.comment is None
+    assert tc.annotation is None
