+
+        def worker():
+            try:
+                for _ in range(50):
+                    proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=worker) for _ in range(4)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        assert not errors, f"Threads raised: {errors}"
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 200
+
+    def test_tracking_with_real_xgrammar(self):
+        """Integration smoke test: tracking enabled through factory with real xgrammar.
+
+        This test uses the real xgrammar backend and verifies that tracking
+        does not interfere with normal generation.
+        """
+        import transformers
+
+        import outlines
+        from outlines.backends.xgrammar import XGrammarBackend
+
+        model = outlines.from_transformers(
+            transformers.AutoModelForCausalLM.from_pretrained(
+                "erwanf/gpt2-mini"
+            ),
+            transformers.AutoTokenizer.from_pretrained("erwanf/gpt2-mini"),
+        )
+        backend = XGrammarBackend(model)
+
+        json_schema = (
+            '{"type": "object", "properties": {"name": {"type": "string"}, '
+            + '"age": {"type": "integer"}}, "required": ["name", "age"], '
+            + '"additionalProperties": false}'
+        )
+        processor = backend.get_json_schema_logits_processor(
+            json_schema,
+            track_memory_usage=True,
+            memory_history_limit=3,
+        )
+        assert processor.track_memory_usage is True
+        assert processor.memory_history_limit == 3
+
+        generator = outlines.Generator(
+            model, backend="xgrammar", processor=processor
+        )
+        response = generator("Hello, how are you?")
+        assert response[0] == "{"
+        assert "name" in response
+
+        stats = processor.get_memory_stats()
+        assert stats["total_calls"] > 0
+        assert "peak_memory_mb" in stats
+        assert "avg_memory_per_call_mb" in stats
+        assert isinstance(stats["memory_history"], list)
