+"""Tests for XGrammarLogitsProcessor memory-tracking functionality."""
+
+import copy
+import threading
+
+import pytest
+import torch
+import torch
+
+from outlines.backends.xgrammar import (
+    XGrammarLogitsProcessor,
+    _validate_memory_history_limit,
+)
+
+
+# ---------------------------------------------------------------------------
+# _validate_memory_history_limit
+# ---------------------------------------------------------------------------
+
+
+class TestValidateMemoryHistoryLimit:
+    def test_none_is_valid(self):
+        _validate_memory_history_limit(None)  # no raise
+
+    def test_non_negative_int_is_valid(self):
+        _validate_memory_history_limit(0)
+        _validate_memory_history_limit(1)
+        _validate_memory_history_limit(100)
+
+    def test_bool_raises(self):
+        with pytest.raises(ValueError, match="cannot be a boolean"):
+            _validate_memory_history_limit(True)
+        with pytest.raises(ValueError, match="cannot be a boolean"):
+            _validate_memory_history_limit(False)
+
+    def test_negative_int_raises(self):
+        with pytest.raises(ValueError, match="non-negative"):
+            _validate_memory_history_limit(-1)
+
+    def test_float_raises(self):
+        with pytest.raises(ValueError, match="must be None or a non-negative int"):
+            _validate_memory_history_limit(5.0)
+
+    def test_string_raises(self):
+        with pytest.raises(ValueError, match="must be None or a non-negative int"):
+            _validate_memory_history_limit("all")
+
+
+# ---------------------------------------------------------------------------
+# XGrammarLogitsProcessor
+# ---------------------------------------------------------------------------
+
+
+class FakeXGramProcessor:
+    """Minimal stand-in for ``xgr.contrib.hf.LogitsProcessor``."""
+
+    def __init__(self, compiled_grammar):
+        self.compiled_grammar = compiled_grammar
+
+    def __call__(self, input_ids, logits):
+        return logits
+
+
+class TestXGrammarLogitsProcessorInit:
+    def test_defaults(self):
+        proc = XGrammarLogitsProcessor("grammar")
+        assert proc.track_memory_usage is False
+        assert proc.memory_history_limit is None
+
+    def test_tracking_disabled_by_default(self):
+        proc = XGrammarLogitsProcessor("grammar")
+        assert not proc.track_memory_usage
+
+    def test_enable_tracking(self):
+        proc = XGrammarLogitsProcessor("grammar", track_memory_usage=True)
+        assert proc.track_memory_usage is True
+
+    def test_with_limit(self):
+        proc = XGrammarLogitsProcessor("grammar", memory_history_limit=5)
+        assert proc.memory_history_limit == 5
+
+    def test_zero_limit(self):
+        proc = XGrammarLogitsProcessor("grammar", memory_history_limit=0)
+        assert proc.memory_history_limit == 0
+
+    def test_bool_limit_raises(self):
+        with pytest.raises(ValueError, match="cannot be a boolean"):
+            XGrammarLogitsProcessor("grammar", memory_history_limit=True)
+
+    def test_negative_limit_raises(self):
+        with pytest.raises(ValueError, match="non-negative"):
+            XGrammarLogitsProcessor("grammar", memory_history_limit=-3)
+
+    def test_float_limit_raises(self):
+        with pytest.raises(ValueError, match="must be None or a non-negative int"):
+            XGrammarLogitsProcessor("grammar", memory_history_limit=1.5)
+
+
+class TestXGrammarLogitsProcessorMemoryStats:
+    """Test memory-tracking integration using a patched _sample_rss."""
+
+    def _make_processor(self, limit=None):
+        """Build a processor with a fake xgrammar processor & controllable RSS."""
+        proc = XGrammarLogitsProcessor(
+            "grammar",
+            track_memory_usage=True,
+            memory_history_limit=limit,
+        )
+        # Replace the real xgrammar processor with our fake
+        proc.xgrammar_logits_processor = FakeXGramProcessor("grammar")
+        return proc
+
+    def test_initial_stats(self):
+        proc = self._make_processor()
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 0
+        assert stats["peak_memory_mb"] == 0.0
+        assert stats["avg_memory_per_call_mb"] == 0.0
+        assert stats["memory_history"] == []
+
+    def test_reset_clears_stats(self, monkeypatch):
+        """reset() must clear all accumulated statistics."""
+        proc = self._make_processor()
+
+        # Seed some stats directly
+        with proc._lock:
+            proc._total_calls = 3
+            proc._peak_memory_mb = 42.0
+            proc._cumulative_memory_mb = 99.0
+            proc._memory_history = [1.0, 2.0, 3.0]
+
+        proc.reset()
+
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 0
+        assert stats["peak_memory_mb"] == 0.0
+        assert stats["avg_memory_per_call_mb"] == 0.0
+        assert stats["memory_history"] == []
+
+    def test_reset_preserves_config(self):
+        """reset() must not change track_memory_usage or memory_history_limit."""
+        proc = XGrammarLogitsProcessor(
+            "grammar",
+            track_memory_usage=True,
+            memory_history_limit=7,
+        )
+        proc.reset()
+        assert proc.track_memory_usage is True
+        assert proc.memory_history_limit == 7
+
+    def test_get_memory_stats_independent_copy(self, monkeypatch):
+        """Returned dict and history list must be independent copies."""
+        proc = self._make_processor(limit=None)
+
+        # Simulate a call
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", lambda: 0
+        )
+        proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+
+        stats1 = proc.get_memory_stats()
+        stats2 = proc.get_memory_stats()
+
+        # Mutating one should not affect the other
+        stats1["total_calls"] = 999
+        stats1["memory_history"].append(99.0)
+        assert stats2["total_calls"] == 1
+        assert len(stats2["memory_history"]) == 1
+
+    def test_disabled_tracking_no_sampling(self, monkeypatch):
+        """When disabled, no RSS sampling calls are made and no stats recorded."""
+        calls = []
+
+        def tracking_sample():
+            calls.append(1)
+            return 1024 * 1024
+
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", tracking_sample
+        )
+
+        proc = XGrammarLogitsProcessor(
+            "grammar",
+            track_memory_usage=False,
+        )
+        proc.xgrammar_logits_processor = FakeXGramProcessor("grammar")
+
+
+        proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+        assert len(calls) == 0, "No RSS sampling should occur when disabled"
+
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 0
+
+    def test_history_limit_none_retains_all(self, monkeypatch):
+        """With None limit, all deltas are retained."""
+        proc = self._make_processor(limit=None)
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", lambda: 0
+        )
+
+
+        for _ in range(5):
+            proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+
+        stats = proc.get_memory_stats()
+        assert len(stats["memory_history"]) == 5
+
+    def test_history_limit_positive(self, monkeypatch):
+        """Positive limit retains only the most recent N entries."""
+        proc = self._make_processor(limit=2)
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", lambda: 0
+        )
+
+
+        for _ in range(5):
+            proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+
+        stats = proc.get_memory_stats()
+        assert len(stats["memory_history"]) == 2
+        # total_calls should still reflect all 5 calls
+        assert stats["total_calls"] == 5
+
+    def test_history_limit_zero_retains_no_detail(self, monkeypatch):
+        """Limit=0 retains no history but stats still reflect all calls."""
+        proc = self._make_processor(limit=0)
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", lambda: 0
+        )
+
+
+        for _ in range(3):
+            proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+
+        stats = proc.get_memory_stats()
+        assert stats["memory_history"] == []
+        assert stats["total_calls"] == 3
+
+    def test_peak_and_average(self, monkeypatch):
+        """Peak and average are computed from all calls."""
+        proc = self._make_processor(limit=None)
+
+        # Each processing call samples _sample_rss_bytes twice (before, after).
+        # Two calls -> 4 samples needed.
+        # Call 1: before=0, after=2*1024*1024  => delta=2.0 MB
+        # Call 2: before=2*1024*1024, after=3*1024*1024 => delta=1.0 MB
+        rss_values = [0, 2 * 1024 * 1024, 2 * 1024 * 1024, 3 * 1024 * 1024]
+        idx = [0]
+
+        def mock_rss():
+            v = rss_values[idx[0]]
+            idx[0] += 1
+            return v
+
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", mock_rss
+        )
+
+        for _ in range(2):
+            proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 2
+        assert stats["peak_memory_mb"] == pytest.approx(2.0, rel=1e-3)
+        assert stats["avg_memory_per_call_mb"] == pytest.approx(1.5, rel=1e-3)
+
+    def test_sampling_failure_records_zero(self, monkeypatch):
+        """If *either* sampling attempt fails, record zero for that call."""
+        proc = self._make_processor(limit=None)
+
+        # Four calls to _sample_rss_bytes for two processing calls:
+        # call1-before, call1-after, call2-before, call2-after.
+        # Simulate a failure for call2-after by returning None.
+        sample_results = [5 * 1024 * 1024, 5 * 1024 * 1024, 5 * 1024 * 1024, None]
+        idx = [0]
+
+        def mock_rss():
+            v = sample_results[idx[0]]
+            idx[0] += 1
+            return v
+
+        monkeypatch.setattr(
+            "outlines.backends.xgrammar._sample_rss_bytes", mock_rss
+        )
+
+        # First call: both samples succeed
+        proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 1
+
+        # Second call: after sample fails (None) -> zero delta
+        proc(torch.tensor([[1, 2]]), torch.tensor([[0.1, 0.2]]))
+        stats = proc.get_memory_stats()
+        assert stats["total_calls"] == 2
+        assert stats["memory_history"][1] == 0.0
+
