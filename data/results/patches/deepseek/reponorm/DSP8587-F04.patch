+    def test_last_activity_time_set_after_non_empty_chunk(self):
+        """receive() with a non-empty chunk sets _last_activity_time."""
+        import time
+        from litellm.types.utils import Delta, StreamingChoices
+        from dspy.dsp.utils.settings import settings
+        settings.adapter = None  # ChatAdapter default
