+    def tick(self, now_ts: float | None = None) -> StreamResponse | None:
+        """Check the idle timeout state and return a timeout response if the timeout has been reached.
+
+        Before the timeout it returns ``None``. At or after the timeout it returns one
+        ``StreamResponse`` with an empty ``chunk`` field and clears the complete per-stream
+        boundary/cache state, so subsequent ticks do not emit duplicates.
+
+        Args:
+            now_ts: A timestamp in the clock's time domain. If None, uses ``self.clock()``.
+
+        Returns:
+            A ``StreamResponse`` with an empty chunk if the timeout has been reached, or ``None``.
+        """
+        if self.idle_timeout_s is None or self._idle_emitted:
+            return None
+
+        now = now_ts if now_ts is not None else self.clock()
+
+        if self._last_activity_time is not None and (now - self._last_activity_time) >= self.idle_timeout_s:
+            self._idle_emitted = True
+            # Clear per-stream state to prevent duplicates.
+            self.stream_start = False
+            self.stream_end = True
+            self.cache_hit = False
+            self.field_start_queue = []
+            self.field_end_queue = Queue()
+            return StreamResponse(self.predict_name, self.signature_field_name, "")
+
+        return None
+
 
