+                model="gpt",
+                choices=[StreamingChoices(delta=Delta(content=" to"))]
+            )
+            yield ModelResponseStream(
+                model="gpt",
+                choices=[StreamingChoices(delta=Delta(content=" the"))]
+            )
+            yield ModelResponseStream(
+                model="gpt",
+                choices=[StreamingChoices(delta=Delta(content=" other"))]
+            )
+            yield ModelResponseStream(
