+    @pytest.mark.anyio
+    async def test_small_timeout_via_streamify(self):
+        """Integration test: idle timeout fires via streamify when upstream stalls."""
+        class StalledProgram(dspy.Module):
+            def __init__(self):
+                super().__init__()
+                self.predict = dspy.Predict("q->a")
+            def forward(self, question, **kwargs):
+                return self.predict(question=question)
+
+        # Create a stream that yields one chunk then stalls
+        async def stalled_stream(*args, **kwargs):
+            yield ModelResponseStream(
+                model="gpt",
+                choices=[StreamingChoices(delta=Delta(content='[[ ## a ## ]]\n\n'))]
+            )
+            yield ModelResponseStream(
+                model="gpt",
+                choices=[StreamingChoices(delta=Delta(content='hello'))]
+            )
+            # After this chunk, no more chunks arrive - idle timeout should fire
+            await asyncio.sleep(3600)
+
+        async def completion_side_effect(*args, **kwargs):
+            return stalled_stream()
+
+        listener = dspy.streaming.StreamListener(
+            signature_field_name="a",
+            idle_timeout_s=0.2,  # 200ms timeout
+            clock=time.monotonic,
+        )
+
+        program = dspy.streamify(
+            StalledProgram(),
+            stream_listeners=[listener],
+        )
+
+        with mock.patch("litellm.acompletion", side_effect=completion_side_effect):
+            with dspy.context(lm=dspy.LM("openai/gpt-4o-mini", cache=False)):
+                output = program(question="test")
+                timeout_responses = []
+                async for value in output:
+                    if isinstance(value, dspy.streaming.StreamResponse):
+                        if value.chunk == "":
+                            timeout_responses.append(value)
+
+        assert len(timeout_responses) == 1, (
+            f"Expected exactly one timeout response, got {len(timeout_responses)}"
+        )
+        assert timeout_responses[0].chunk == ""
+        assert timeout_responses[0].signature_field_name == "a"
+
+    @pytest.mark.anyio
+    async def test_no_timeout_when_stream_completes_normally(self):
+        """Idle timeout does not fire when the stream completes within the timeout."""
+        class FastProgram(dspy.Module):
+            def __init__(self):
+                super().__init__()
+                self.predict = dspy.Predict("q->a")
+            def forward(self, question, **kwargs):
