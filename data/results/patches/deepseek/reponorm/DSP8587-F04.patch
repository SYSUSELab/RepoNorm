+class TestStreamListenerIdleTimeoutConstruction:
+    """Tests for StreamListener idle_timeout_s validation."""
+
+    def test_default_is_none(self):
+        """No idle_timeout_s means idle termination is disabled."""
+        l = StreamListener("field")
+        assert l.idle_timeout_s is None
+
+    def test_positive_float_accepted(self):
+        l = StreamListener("field", idle_timeout_s=3.5)
+        assert l.idle_timeout_s == 3.5
+
+    def test_positive_int_accepted(self):
+        l = StreamListener("field", idle_timeout_s=5)
+        assert l.idle_timeout_s == 5
+
+    def test_none_explicit(self):
+        l = StreamListener("field", idle_timeout_s=None)
+        assert l.idle_timeout_s is None
+
+    def test_bool_true_raises(self):
+        with pytest.raises(ValueError, match="positive finite"):
+            StreamListener("field", idle_timeout_s=True)
+
+    def test_bool_false_raises(self):
+        with pytest.raises(ValueError, match="positive finite"):
+            StreamListener("field", idle_timeout_s=False)
+
+    def test_zero_raises(self):
+        with pytest.raises(ValueError, match="positive finite"):
+            StreamListener("field", idle_timeout_s=0)
+
+    def test_negative_raises(self):
+        with pytest.raises(ValueError, match="positive finite"):
+            StreamListener("field", idle_timeout_s=-1)
+
+    def test_inf_raises(self):
+        with pytest.raises(ValueError, match="positive finite"):
+            StreamListener("field", idle_timeout_s=float("inf"))
+
+    def test_nan_raises(self):
+        with pytest.raises(ValueError, match="positive finite"):
+            StreamListener("field", idle_timeout_s=float("nan"))
