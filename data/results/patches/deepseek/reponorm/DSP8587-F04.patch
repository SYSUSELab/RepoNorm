+class TestStreamListenerIdleTimeoutClockInjection:
+    """Tests for custom clock injection."""
+
+    def test_default_clock_is_time_monotonic(self):
+        import time
+        l = StreamListener("field", idle_timeout_s=5.0)
+        assert l.clock is time.monotonic
+
+    def test_custom_clock_is_used(self):
+        calls = []
+        def my_clock():
+            calls.append(1)
+            return 42.0
+        l = StreamListener("field", idle_timeout_s=5.0, clock=my_clock)
+        assert l.clock() == 42.0
+        assert len(calls) == 1
+
+    def test_tick_now_ts_overrides_clock(self):
+        """tick(now_ts=...) uses the provided timestamp regardless of clock."""
+        clock = lambda: 100.0
+        l = StreamListener("field", idle_timeout_s=5.0, clock=clock)
+        l._last_activity_time = 0.0
+        # If we used clock, now=100 would be >5s from activity=0 → timeout.
+        # But we pass now_ts=2.0, so no timeout.
+        result = l.tick(now_ts=2.0)
+        assert result is None
