+class TestStreamListenerIdleTimeoutTick:
+    """Tests for StreamListener.tick() method."""
+
+    def test_tick_before_stream_start_returns_none(self):
+        """When _last_activity_time is None (stream not started), tick returns None."""
+        clock = lambda: 100.0
+        l = StreamListener("field", idle_timeout_s=5.0, clock=clock)
+        assert l.tick() is None
+        assert l._idle_emitted is False
+
+    def test_tick_before_timeout_returns_none(self):
+        clock = lambda: 100.0
+        l = StreamListener("field", idle_timeout_s=5.0, clock=clock)
+        l._last_activity_time = 100.0  # activity at t=100
+        result = l.tick(now_ts=104.9)  # 4.9s later, still before timeout
+        assert result is None
+        assert l._idle_emitted is False
+
+    @pytest.mark.parametrize("delta", [0.0, 0.1, 5.0])
+    def test_tick_at_or_after_timeout_returns_timeout_response(self, delta):
+        clock = lambda: 100.0
+        l = StreamListener("field", predict_name="pred", idle_timeout_s=5.0, clock=clock)
+        l._last_activity_time = 100.0
+        result = l.tick(now_ts=105.0 + delta)
+        assert result is not None
+        assert isinstance(result, dspy.streaming.StreamResponse)
+        assert result.chunk == ""
+        assert result.predict_name == "pred"
+        assert result.signature_field_name == "field"
+        assert l._idle_emitted is True
+
+    def test_tick_no_duplicate_after_timeout_emitted(self):
+        clock = lambda: 100.0
+        l = StreamListener("field", idle_timeout_s=5.0, clock=clock)
+        l._last_activity_time = 100.0
+        first = l.tick(now_ts=200.0)
+        assert first is not None
+        second = l.tick(now_ts=300.0)
+        assert second is None  # No duplicate
+
+    def test_tick_disabled_when_timeout_is_none(self):
+        l = StreamListener("field")  # idle_timeout_s=None
+        l._last_activity_time = 0.0
+        result = l.tick(now_ts=1e9)
+        assert result is None
