+# Token keyword sets for automatic auto-complete strategy selection.
+_USER_TOKENS: cabc.FrozenSet[str] = frozenset(
+    {"user", "username", "owner", "author"}
+)
+_BRANCH_TOKENS: cabc.FrozenSet[str] = frozenset(
+    {"branch", "ref", "revision"}
+)
+_ENV_TOKENS: cabc.FrozenSet[str] = frozenset(
+    {"env", "environment", "var"}
+)
+_FILE_TOKENS: cabc.FrozenSet[str] = frozenset(
+    {"file", "path", "input", "output"}
+)
+_DIR_TOKENS: cabc.FrozenSet[str] = frozenset(
+    {"dir", "directory"}
+)
+
+_STRATEGY_MAP: list[tuple[str, cabc.FrozenSet[str]]] = [
+    ("user", _USER_TOKENS),
+    ("branch", _BRANCH_TOKENS),
+    ("environment", _ENV_TOKENS),
+    ("file", _FILE_TOKENS),
+    ("directory", _DIR_TOKENS),
+]
+
+
+def _resolve_auto_complete_strategy(
+    name: str | None,
+) -> str | None:
+    """Determine the built-in completion strategy from an option's
+    normalized name.  Returns the strategy key or *None* when no tokens
+    match or the name is *None*.
+    """
+    if name is None:
+        return None
+    tokens = set(name.split("_") if name else [])
+    for strategy, keywords in _STRATEGY_MAP:
+        if tokens & keywords:
+            return strategy
+    return None
+
+
+def _run_auto_complete(
+    strategy: str,
+    ctx: Context,
+    param: Parameter,
+    incomplete: str,
+) -> list["CompletionItem"]:
+    """Dispatch to the appropriate strategy function."""
+    from click.shell_completion import CompletionItem
+
+    if strategy == "user":
+        return _complete_user(incomplete)
+    elif strategy == "branch":
+        return _complete_branch(incomplete)
+    elif strategy == "environment":
+        return _complete_envvar(incomplete)
+    elif strategy == "file":
+        return _complete_file(ctx, param, incomplete)
+    elif strategy == "directory":
+        return _complete_directory(incomplete)
+    return []
+
+
+def _complete_user(incomplete: str) -> list["CompletionItem"]:
+    """Return matching user names from the password database.  Exclude
+    names starting with ``_`` and limit to at most 20 results.  Fall
+    back to normal completion when *pwd* is unavailable.
+    """
+    from click.shell_completion import CompletionItem
+
+    try:
+        import pwd
+    except ImportError:
+        return []
+
+    try:
+        all_users = pwd.getpwall()
+    except Exception:
+        return []
+
+    matches: list[CompletionItem] = []
+    for entry in all_users:
+        name = entry.pw_name
+        if name.startswith("_"):
+            continue
+        if not name.startswith(incomplete):
+            continue
+        matches.append(CompletionItem(name))
+
+    matches.sort(key=lambda x: x.value)
+    return matches[:20]
+
+
+def _complete_branch(incomplete: str) -> list["CompletionItem"]:
+    """Return matching Git branch/revision names limited to 20.  Fall
+    back to no completions when Git is not available or fails.
+    """
+    from click.shell_completion import CompletionItem
+    import subprocess
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=10,
+        )
+        if result.returncode != 0:
+            return []
+        branches = result.stdout.splitlines()
+    except Exception:
+        return []
+
+    seen: set[str] = set()
+    unique: list[CompletionItem] = []
+    for b in branches:
+        if not b.startswith(incomplete):
+            continue
+        if b not in seen:
+            seen.add(b)
+            unique.append(CompletionItem(b))
+
+    unique.sort(key=lambda x: x.value)
+    return unique[:20]
+
+
+def _complete_envvar(incomplete: str) -> list["CompletionItem"]:
+    """Return matching environment variable names.  Limit to at most
+    20 results.  Returns names only, never values.
+    """
+    from click.shell_completion import CompletionItem
+
+    names = sorted(
+        n for n in os.environ if n.startswith(incomplete)
+    )
+    return [CompletionItem(n) for n in names[:20]]
+
+
+def _complete_file(
+    ctx: "Context",
+    param: "Parameter",
+    incomplete: str,
+) -> list["CompletionItem"]:
+    """Use ordinary Path completion for file strategies."""
+    from .types import Path
+
+    return Path().shell_complete(ctx, param, incomplete)
+
+
+def _complete_directory(incomplete: str) -> list["CompletionItem"]:
+    """Return directory completion items."""
+    from .types import Path
+
+    return Path(file_okay=False).shell_complete(
+        Context.__new__(Context), None, incomplete
+    )
+
