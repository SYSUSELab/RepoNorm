+class TestAutoComplete:
+    """Tests for the ``auto_complete`` option parameter."""
+
+    def test_auto_complete_false_default(self) -> None:
+        """When auto_complete is False (default), no strategy is used."""
+
+        @click.command()
+        @click.option("--username")
+        def cli(username):
+            pass
+
+        # With option name in args to trigger value completion
+        completions = _get_completions(cli, args=["--username"], incomplete="")
+        assert completions == []
+
+    def test_auto_complete_bool_true_name_matches_user(self) -> None:
+        """Boolean True with name matching user tokens uses user strategy."""
+
+        @click.command()
+        @click.option("--username", auto_complete=True)
+        def cli(username):
+            pass
+
+        completions = _get_words(cli, args=["--username"], incomplete="r")
+        assert "root" in completions
