+    def shell_complete(
+        self, ctx: Context, incomplete: str
+    ) -> list[CompletionItem]:
+        """Return shell completions based on the option's
+        *auto_complete* setting.
+
+        If a custom ``shell_complete`` callback was provided it always
+        takes precedence. Otherwise, when *auto_complete* is enabled, a
+        built-in strategy is used when the option name matches known
+        token keywords, or when *auto_complete* is an explicit strategy
+        string.  Falls back to the default type-based completion when
+        *auto_complete* is ``False`` or no strategy matches.
+        """
+
+        # Custom callback always wins
+        if self._custom_shell_complete is not None:
+            return super().shell_complete(ctx, incomplete)
+
+        if self._auto_complete is False:
+            return super().shell_complete(ctx, incomplete)
+
+        strategy: str | None
+        if isinstance(self._auto_complete, str):
+            strategy = self._auto_complete
+        else:
+            # bool True -- determine from parameter name
+            strategy = _resolve_auto_complete_strategy(self.name)
+
+        if strategy is None:
+            return super().shell_complete(ctx, incomplete)
+
+        return _run_auto_complete(strategy, ctx, self, incomplete)
+
