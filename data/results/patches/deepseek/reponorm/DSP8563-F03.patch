+"""Tests for scalar string coercion in Tool arguments.
+
+Coercion applies before schema validation so that common string representations
+of booleans, integers, floats, durations and sizes are accepted.
+"""
+
+import pytest
+from typing import Any
+from dspy.adapters.types.tool import Tool
+
+
+# ---------------------------------------------------------------------------
+# Boolean coercion
+# ---------------------------------------------------------------------------
+
+def test_coerce_boolean():
+    def func(flag: bool):
+        return flag
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(flag="true")
+    assert result["flag"] is True
+
+
+def test_coerce_boolean_variants():
+    def func(flag: bool):
+        return flag
+    tool = Tool(func)
+    for s in ("True", "TRUE", "true"):
+        result = tool._validate_and_parse_args(flag=s)
+        assert result["flag"] is True, f"failed for {s!r}"
+    for s in ("false", "False", "FALSE"):
+        result = tool._validate_and_parse_args(flag=s)
+        assert result["flag"] is False, f"failed for {s!r}"
+
+
+def test_coerce_boolean_with_whitespace():
+    def func(flag: bool):
+        return flag
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(flag="  true  ")
+    assert result["flag"] is True
+
+
+def test_coerce_boolean_invalid_stays_string_then_fails():
+    def func(flag: bool):
+        return flag
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(flag="yes")
+
+
+# ---------------------------------------------------------------------------
+# Integer coercion
+# ---------------------------------------------------------------------------
+
+def test_coerce_integer():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(count="42")
+    assert result["count"] == 42
+    assert isinstance(result["count"], int)
+
+
+def test_coerce_integer_negative():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(count="-7")
+    assert result["count"] == -7
+
+
+def test_coerce_integer_positive_sign():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(count="+99")
+    assert result["count"] == 99
+
+
+def test_coerce_integer_large_exact():
+    """Large integers beyond binary-float precision stay exact."""
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    val = "1234567890123456789"
+    result = tool._validate_and_parse_args(count=val)
+    assert result["count"] == 1234567890123456789
+
+
+def test_coerce_integer_integral_float_string():
+    """A string with a decimal point that is integral (e.g. '3.0') should be accepted as int."""
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(count="3.0")
+    assert result["count"] == 3
+    assert isinstance(result["count"], int)
+
+
+def test_coerce_integer_nonintegral_fails():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(count="3.14")
+
+
+def test_coerce_integer_nan_fails():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(count="NaN")
+
+
+def test_coerce_integer_inf_fails():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(count="Infinity")
+
+
+# ---------------------------------------------------------------------------
+# Number (float) coercion
+# ---------------------------------------------------------------------------
+
+def test_coerce_number():
+    def func(ratio: float):
+        return ratio
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(ratio="3.14")
+    assert abs(result["ratio"] - 3.14) < 1e-12
+
+
+def test_coerce_number_integer_string():
+    def func(ratio: float):
+        return ratio
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(ratio="42")
+    assert result["ratio"] == 42.0
+
+
+def test_coerce_number_negative():
+    def func(ratio: float):
+        return ratio
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(ratio="-2.5")
+    assert result["ratio"] == -2.5
+
+
+def test_coerce_number_exponent():
+    def func(ratio: float):
+        return ratio
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(ratio="1.5e2")
+    assert result["ratio"] == 150.0
+
+
+def test_coerce_number_nan_fails():
+    def func(ratio: float):
+        return ratio
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(ratio="NaN")
+
+
+def test_coerce_number_inf_fails():
+    def func(ratio: float):
+        return ratio
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(ratio="Inf")
+
+
+# ---------------------------------------------------------------------------
+# Duration coercion
+# ---------------------------------------------------------------------------
+
+def test_coerce_duration_integer_seconds():
+    def func(timeout: int):
+        return timeout
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(timeout="5s")
+    assert result["timeout"] == 5
+    assert isinstance(result["timeout"], int)
+
+
+def test_coerce_duration_number_seconds():
+    def func(timeout: float):
+        return timeout
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(timeout="1.5s")
+    assert abs(result["timeout"] - 1.5) < 1e-12
+
+
+def test_coerce_duration_ms_nonintegral_fails_integer():
+    """500ms = 0.5s, non-integral for int schema, should fail."""
+    def func(timeout: int):
+        return timeout
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(timeout="500ms")
+
+
+def test_coerce_duration_minutes():
+    def func(timeout: float):
+        return timeout
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(timeout="2m")
+    assert abs(result["timeout"] - 120.0) < 1e-12
+
+
+def test_coerce_duration_hours():
+    def func(timeout: float):
+        return timeout
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(timeout="1h")
+    assert abs(result["timeout"] - 3600.0) < 1e-12
+
+
+def test_coerce_duration_whitespace():
+    def func(timeout: float):
+        return timeout
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(timeout="  30 s  ")
+    assert result["timeout"] == 30.0
+
+
+# ---------------------------------------------------------------------------
+# Size coercion
+# ---------------------------------------------------------------------------
+
+def test_coerce_size_kb():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(size="1KB")
+    assert result["size"] == 1000
+
+
+def test_coerce_size_mb():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(size="2.5MB")
+    assert result["size"] == 2500000
+
+
+def test_coerce_size_gb():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(size="1GB")
+    assert result["size"] == 1000000000
+
+
+def test_coerce_size_fractional_truncates():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(size="1.001KB")
+    assert result["size"] == 1001
+
+
+def test_coerce_size_whitespace():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(size="  100  KB  ")
+    assert result["size"] == 100000
+
+
+def test_coerce_size_unknown_unit_fails():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(size="10XB")
+
+
+def test_coerce_size_lowercase_unit_fails():
+    """Units are case-sensitive; 'kb' is not recognized."""
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(size="10kb")
+
+
+# ---------------------------------------------------------------------------
+# Edge cases: string fields, unknown kwargs, non-string values
+# ---------------------------------------------------------------------------
+
+def test_no_coercion_for_string_fields():
+    """String-typed fields must not be coerced."""
+    def func(name: str):
+        return name
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(name="true")
+    assert result["name"] == "true"
+    result = tool._validate_and_parse_args(name="42")
+    assert result["name"] == "42"
+
+
+def test_no_coercion_for_unknown_kwargs():
+    """Unknown kwargs pass through unchanged when function accepts **kwargs."""
+    from dspy.adapters.types.tool import Tool
+    def func(known: int, **kwargs):
+        return known
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(known="5", unknown="true")
+    # unknown kwargs are allowed (not in schema but has_kwargs=True); no coercion
+    assert result["unknown"] == "true"
+    assert result["known"] == 5
+
+
+def test_no_coercion_for_non_string_values():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(count=42)
+    assert result["count"] == 42
+
+
+def test_coerce_boolean_non_string_passthrough():
+    def func(flag: bool):
+        return flag
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(flag=True)
+    assert result["flag"] is True
+
+
+def test_coerce_value_none():
+    """_coerce_value returns None for non-coercible inputs."""
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    result = Tool._coerce_value("  hello  ", "integer")
+    assert result is None
+
+
+def test_no_coercion_on_duration_string_field():
+    def func(name: str):
+        return name
+    tool = Tool(func)
+    result = tool._validate_and_parse_args(name="5s")
+    assert result["name"] == "5s"
+
+
+def test_numeric_field_garbage_fails():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(count="not_a_number")
+
+
+def test_numeric_field_expression_fails():
+    """Arithmetic expressions should not be evaluated."""
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(count="2+2")
+
+
+def test_numeric_field_trailing_text_fails():
+    def func(count: int):
+        return count
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(count="42px")
+
+
+def test_duration_exponent_not_accepted():
+    def func(timeout: float):
+        return timeout
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(timeout="1e3ms")
+
+
+def test_size_exponent_not_accepted():
+    def func(size: int):
+        return size
+    tool = Tool(func)
+    with pytest.raises(ValueError):
+        tool._validate_and_parse_args(size="1e3KB")
+
+
+# ---------------------------------------------------------------------------
+# Async tool path (acall) - smoke test
+# ---------------------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_async_coerce_boolean():
+    async def func(flag: bool):
+        return flag
+    tool = Tool(func)
+    result = await tool.acall(flag="true")
+    assert result is True
+
+
+@pytest.mark.asyncio
+async def test_async_coerce_integer():
+    async def func(count: int):
+        return count
+    tool = Tool(func)
+    result = await tool.acall(count="42")
+    assert result == 42
+    assert isinstance(result, int)
+
+
+@pytest.mark.asyncio
+async def test_async_coerce_duration():
+    async def func(timeout: float):
+        return timeout
+    tool = Tool(func)
+    result = await tool.acall(timeout="5s")
+    assert result == 5.0
