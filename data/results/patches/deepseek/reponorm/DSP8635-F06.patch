+    def _enforce_instruction_length(self, instruction, program, pred_i):
+        """Enforce min/max instruction length constraints on the given instruction.
+
+        Returns the (possibly modified) instruction that satisfies the bounds.
+        """
+        basic_instruction = get_signature(program.predictors()[pred_i]).instructions
+
+        # Zero max returns the empty string
+        if self.max_instr_chars == 0:
+            if self.verbose:
+                print(f"Instruction truncated to empty string (max_instr_chars=0)")
+            return ""
+
+        measured_len = len(instruction)
+
+        # If shorter than min, use the predictor's canonical signature instructions
+        if measured_len < self.min_instr_chars:
+            prev_len = measured_len
+            instruction = basic_instruction
+            measured_len = len(instruction)
+            if self.verbose:
+                print(f"Instruction shorter than min_instr_chars={self.min_instr_chars} (len={prev_len}), falling back to basic instruction (len={measured_len})")
+
+        # If longer than max, apply truncation or rephrasing
+        if measured_len > self.max_instr_chars:
+            if self.rephrase_when_too_long:
+                # Make exactly one ShortenInstruction call
+                # Save LM kwargs to prevent mutation by rephrasing
+                original_kwargs = dict(self.prompt_model.kwargs)
+                with dspy.settings.context(lm=self.prompt_model):
+                    shorten_predict = dspy.Predict(ShortenInstruction)
+                    result = shorten_predict(
+                        long_instruction=instruction,
+                        max_chars=self.max_instr_chars,
+                    ).proposed_instruction
+                # Restore LM kwargs
+                self.prompt_model.kwargs.clear()
+                self.prompt_model.kwargs.update(original_kwargs)
+                rephrased = strip_prefix(result)
+                if self.verbose:
+                    print(f"Rephrased overlong instruction (len={measured_len}, max={self.max_instr_chars}) -> len={len(rephrased)}")
+                # Fall back if rephrased is empty or still shorter than min
+                if not rephrased or len(rephrased) < self.min_instr_chars:
+                    if self.verbose:
+                        print(f"Rephrased instruction empty or too short, falling back to basic instruction")
+                    instruction = basic_instruction
+                else:
+                    instruction = rephrased
+                measured_len = len(instruction)
+                # Hard-truncate if still over max
+                if measured_len > self.max_instr_chars:
+                    instruction = instruction[:self.max_instr_chars]
+                    if self.verbose:
+                        print(f"Hard-truncated rephrased/fallback instruction to max={self.max_instr_chars}")
+            else:
+                # Retain the last sentence boundary (. ! ? followed by whitespace/end) that fits
+                # with one character reserved for "…"
+                boundaries = []
+                for m in re.finditer(r'[.!?](?=\s|$)', instruction):
+                    boundaries.append(m.start() + 1)  # position right after punctuation
+
+                suitable = [b for b in boundaries if b <= self.max_instr_chars - 1]
+                if suitable:
+                    cut_at = max(suitable)
+                    instruction = instruction[:cut_at] + "…"
+                else:
+                    instruction = instruction[:self.max_instr_chars - 1] + "…"
+                if self.verbose:
+                    print(f"Trimmed instruction from {measured_len} to {len(instruction)} chars (max={self.max_instr_chars})")
+                measured_len = len(instruction)
+
+        return instruction
