+def test_min_length_fallback():
+    """When generated instruction is shorter than min_instr_chars, fall back to basic instruction."""
+    prompt_model = DummyLM([{"proposed_instruction": "short"}] * 10)
+    program = Predict("question -> answer")
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], verbose=False, min_instr_chars=100, max_instr_chars=600)
+    result = proposer.propose_instruction_for_predictor(
+        program=program,
+        predictor=None,
+        pred_i=0,
+        T=0.5,
+        demo_candidates=None,
+        demo_set_i=0,
+        trial_logs={},
+        tip=None,
+    )
+    # Should fall back to basic instruction "Given the fields `question`, produce the fields `answer`."
+    assert "Given the fields" in result
+    assert "question" in result
+    assert len(result) >= len("Given the fields `question`, produce the fields `answer`.")
+
+
+def test_min_length_fallback_shorter_than_min():
+    """When basic instruction is itself shorter than min, it is still used (no fabrication)."""
+    prompt_model = DummyLM([{"proposed_instruction": "short"}] * 10)
+    program = Predict("question -> answer")
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], verbose=False, min_instr_chars=200, max_instr_chars=600)
+    result = proposer.propose_instruction_for_predictor(
+        program=program,
+        predictor=None,
+        pred_i=0,
+        T=0.5,
+        demo_candidates=None,
+        demo_set_i=0,
+        trial_logs={},
+        tip=None,
+    )
+    # Basic instruction is 57 chars, less than min=200, but we still keep it
+    assert "Given the fields" in result
+    assert len(result) < 200
+
+
+def test_max_length_truncate_sentence_boundary():
