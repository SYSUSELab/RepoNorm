diff --git a/dirty_equals/_other.py b/dirty_equals/_other.py
index b2b8379..5fc9789 100644
--- a/dirty_equals/_other.py
+++ b/dirty_equals/_other.py
@@ -145,3 +145,34 @@ class FunctionCheck(DirtyEquals[Any]):
 
     def equals(self, other: Any) -> bool:
         return self.func(other)
+
+
+class IsHash(DirtyEquals[str]):
+    _hex_lengths: dict = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+
+    def __init__(self, algorithm: str):
+        """See the main class docstring."""
+        self._algorithm_lower = algorithm.lower()
+        if self._algorithm_lower not in self._hex_lengths:
+            raise ValueError(f'Unknown hash algorithm: {algorithm!r}')
+        self.algorithm = algorithm
+        self._hex_length = self._hex_lengths[self._algorithm_lower]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        if len(other) != self._hex_length:
+            return False
+        try:
+            int(other, 16)
+        except (ValueError, TypeError):
+            return False
+        return True
