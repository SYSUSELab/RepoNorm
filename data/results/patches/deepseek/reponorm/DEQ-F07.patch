--- /dev/null
+++ b/tests/test_hash.py
@@ -0,0 +1,92 @@
+import hashlib
+
+import pytest
+
+from dirty_equals import IsHash
+
+
+@pytest.mark.parametrize(
+    'algorithm,hex_length',
+    [
+        ('md5', 32),
+        ('sha1', 40),
+        ('sha224', 56),
+        ('sha256', 64),
+        ('sha384', 96),
+        ('sha512', 128),
+    ],
+)
+def test_hex_length(algorithm, hex_length):
+    h = hashlib.new(algorithm, b'').hexdigest()
+    assert len(h) == hex_length
+    assert h == IsHash(algorithm)
+
+
+@pytest.mark.parametrize(
+    'other,dirty,match',
+    [
+        ('d41d8cd98f00b204e9800998ecf8427e', IsHash('md5'), True),
+        ('d41d8cd98f00b204e9800998ecf8427e', IsHash('MD5'), True),
+        ('d41d8cd98f00b204e9800998ecf8427e', IsHash('Md5'), True),
+        ('da39a3ee5e6b4b0d3255bfef95601890afd80709', IsHash('sha1'), True),
+        ('da39a3ee5e6b4b0d3255bfef95601890afd80709', IsHash('SHA1'), True),
+        ('d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592', IsHash('sha256'), True),
+        ('d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592', IsHash('SHA256'), True),
+        ('d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f', IsHash('sha224'), True),
+        ('38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b', IsHash('sha384'), True),
+        ('cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e', IsHash('sha512'), True),
+        # case-insensitive hex
+        ('ABCDEF0123456789ABCDEF0123456789', IsHash('md5'), True),
+        ('AbCdEf0123456789AbCdEf0123456789', IsHash('md5'), True),
+        # non-string
+        (123, IsHash('md5'), False),
+        (None, IsHash('md5'), False),
+        ([], IsHash('md5'), False),
+        # wrong length
+        ('d41d8cd98f00b204e9800998ecf8427', IsHash('md5'), False),
+        ('d41d8cd98f00b204e9800998ecf8427e00', IsHash('md5'), False),
+        # non-hex characters
+        ('d41d8cd98f00b204e9800998ecf8427g', IsHash('md5'), False),
+        # whitespace is not hex
+        ('d41d8cd98f00b204e9800998ecf8427e ', IsHash('md5'), False),
+        (' d41d8cd98f00b204e9800998ecf8427e', IsHash('md5'), False),
+        ('d41d8cd98f00b204e9800998ecf8427e\n', IsHash('md5'), False),
+        ('\td41d8cd98f00b204e9800998ecf8427e\n', IsHash('md5'), False),
+    ],
+)
+def test_is_hash_true(other, dirty, match):
+    if match:
+        assert other == dirty
+    else:
+        assert other != dirty
+
+
+def test_unknown_algorithm():
+    with pytest.raises(ValueError, match=r'Unknown hash algorithm'):
+        IsHash('md5000')
+
+
+def test_unknown_algorithm_nonsense():
+    with pytest.raises(ValueError, match=r'Unknown hash algorithm'):
+        IsHash('foobar')
+
+
+def test_repr_preserves_spelling():
+    assert repr(IsHash('md5')) == "IsHash('md5')"
+    assert repr(IsHash('SHA256')) == "IsHash('SHA256')"
+    assert repr(IsHash('Md5')) == "IsHash('Md5')"
+    assert repr(IsHash('sha512')) == "IsHash('sha512')"
+
+
+def test_false_repr():
+    h = IsHash('md5')
+    with pytest.raises(AssertionError):
+        assert '123' == h
+    assert str(h) == "IsHash('md5')"
+
+
+def test_value_property():
+    h = IsHash('md5')
+    val = 'd41d8cd98f00b204e9800998ecf8427e'
+    assert val == h
+    assert h.value == val
