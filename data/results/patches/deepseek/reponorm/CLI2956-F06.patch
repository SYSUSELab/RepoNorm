+def _is_dynamic_default(default: t.Any) -> bool:
+    """Check if a default is a dynamic option default.
+
+    A dynamic default is a non-empty dictionary whose keys are full
+    long option names beginning with ``--`` and whose values are
+    dictionaries from stringified dependency values to target defaults.
+    """
+    if not isinstance(default, dict) or not default:
+        return False
+    return all(isinstance(k, str) and k.startswith("--") for k in default)
+
+
+def _resolve_dynamic_defaults(ctx: Context) -> None:
+    """Resolve dynamic defaults for all options whose source is DEFAULT."""
+    params = ctx.command.get_params(ctx)
+
+    # Build mapping from long opt (--name) to option name (name)
+    opt_to_name: dict[str, str] = {}
+    dynamic_options: list[Option] = []
+
+    for param in params:
+        if not isinstance(param, Option) or not _is_dynamic_default(param.default):
+            continue
+        for opt in param.opts:
+            if opt.startswith("--"):
+                opt_to_name[opt] = param.name
+        dynamic_options.append(param)
+
+    if not dynamic_options:
+        return
+
+    if ctx.resilient_parsing:
+        return
+
+    # Build resolution map: option_name -> {dep_name: {str_value: target_default}}
+    resolution_map: dict[str, dict[str, dict[str, t.Any]]] = {}
+    all_dynamic_names: set[str] = set()
+
+    for opt in dynamic_options:
+        name = opt.name
+        all_dynamic_names.add(name)
+        dep_entries: dict[str, dict[str, t.Any]] = {}
+
+        for dep_opt_str, dep_values in opt.default.items():
+            # dep_opt_str is like "--verbose" or "--output-format"
+            # Convert to param name: --verbose -> verbose, --output-format -> output_format
+            dep_name = dep_opt_str.lstrip("-").replace("-", "_")
+
+            # Validate dependency option exists
+            if dep_name not in {p.name for p in params if isinstance(p, Option)}:
+                raise UsageError(
+                    f"Unknown option '{dep_opt_str}' referenced in dynamic "
+                    f"default for option '--{name.replace('_', '-')}'."
+                )
+
+            if not isinstance(dep_values, dict):
+                raise TypeError(
+                    f"Value for option '{dep_opt_str}' in dynamic default for option "
+                    f"'--{name.replace('_', '-')}' must be a dict, "
+                    f"got {type(dep_values).__name__}."
+                )
+
+            dep_entries[dep_name] = dep_values
+
+        resolution_map[name] = dep_entries
+
+    # Topological sort for dependency resolution
+    visited: set[str] = set()
+    in_progress: set[str] = set()
+    order: list[str] = []
+
+    def _visit(opt_name: str) -> None:
+        if opt_name in in_progress:
+            raise UsageError(
+                "Circular dependency detected in dynamic defaults involving "
+                f"option '--{opt_name.replace('_', '-')}'."
+            )
+        if opt_name in visited:
+            return
+        in_progress.add(opt_name)
+        for dep_name in resolution_map.get(opt_name, {}):
+            if dep_name in all_dynamic_names:
+                _visit(dep_name)
+        in_progress.remove(opt_name)
+        visited.add(opt_name)
+        order.append(opt_name)
+
+    for name in resolution_map:
+        _visit(name)
+
+    # Resolve in topological order (dependencies first)
+    for opt_name in order:
+        source = ctx.get_parameter_source(opt_name)
+        if source is not ParameterSource.DEFAULT:
+            continue
+
+        opt = None
+        for param in params:
+            if isinstance(param, Option) and param.name == opt_name:
+                opt = param
+                break
+
+        if opt is None:
+            continue
+
+        # Resolve the raw default value
+        resolved_raw: t.Any = None
+        for dep_name, dep_values in resolution_map[opt_name].items():
+            dep_value = ctx.params.get(dep_name)
+            str_key = str(dep_value)
+            if str_key in dep_values:
+                resolved_raw = dep_values[str_key]
+
+        # Pass exactly once through the normal pipeline
+        try:
+            processed = opt.process_value(ctx, resolved_raw)
+        except Exception:
+            if not ctx.resilient_parsing:
+                raise
+            processed = None
+
+        ctx.params[opt_name] = processed
+
+
