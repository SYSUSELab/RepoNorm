+def parse_python_calls(text: str) -> dict:
+    """Parse a string containing one or more Python-style function calls into tool call dictionaries.
+
+    Accepts one or more top-level calls separated by newlines or semicolons, preserving source order.
+    A callee is an identifier or a dot-separated sequence of identifiers; the final identifier is
+    used as the tool name. Only explicit keyword arguments are supported.
+
+    Args:
+        text: A string containing one or more Python-style function calls.
+
+    Returns:
+        A dictionary with key "tool_calls" mapping to a list of dicts, each with "name" (str)
+        and "args" (dict) keys.
+
+    Raises:
+        ValueError: If the input is empty, malformed, or contains unsupported syntax.
+
+    Examples:
+        >>> parse_python_calls('search(query="hello")')
+        {'tool_calls': [{'name': 'search', 'args': {'query': 'hello'}}]}
+        >>> parse_python_calls('get_time()')
+        {'tool_calls': [{'name': 'get_time', 'args': {}}]}
+    """
+    # Reject Python comments using the tokenizer
+    try:
+        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
+    except tokenize.TokenError as e:
+        raise ValueError(f"Syntax error: {e}")
+
+    for tok in tokens:
+        if tok.type == tokenize.COMMENT:
+            raise ValueError(f"Unexpected comment: {tok.string!r}")
+
+    # Parse the AST
+    try:
+        tree = ast.parse(text, mode='exec')
+    except SyntaxError as e:
+        raise ValueError(f"Syntax error: {e}")
+
+    if not tree.body:
+        raise ValueError("Empty input")
+
+    tool_calls = []
+    for node in tree.body:
+        if not isinstance(node, ast.Expr):
+            raise ValueError(
+                f"Expected a call expression, got {type(node).__name__}"
+            )
+        call = node.value
+        if not isinstance(call, ast.Call):
+            raise ValueError(
+                f"Expected a call, got {type(call).__name__}"
+            )
+
+        name = _extract_call_name(call.func)
+        args = _extract_keyword_args(call)
+        tool_calls.append({"name": name, "args": args})
+
+    return {"tool_calls": tool_calls}
+
+
+def _extract_call_name(func_node: ast.AST) -> str:
+    """Extract the tool name from a function call AST node.
+
+    Handles simple names (e.g., "search") and dotted names (e.g., "module.search").
+    For dotted names, returns the final identifier.
+    """
+    if isinstance(func_node, ast.Name):
+        return func_node.id
+    elif isinstance(func_node, ast.Attribute):
+        # Validate the full chain contains only Name and Attribute nodes
+        node = func_node
+        while isinstance(node, ast.Attribute):
+            node = node.value
+        if not isinstance(node, ast.Name):
+            raise ValueError(
+                "Invalid function expression: expected identifier or dotted name"
+            )
+        return func_node.attr
+    else:
+        raise ValueError(
+            f"Invalid function expression: {type(func_node).__name__}"
+        )
+
+
+def _extract_keyword_args(call_node: ast.Call) -> dict[str, Any]:
+    """Extract keyword arguments from a Call AST node."""
+    if call_node.args:
+        raise ValueError("Positional arguments are not allowed")
+    # Positional argument unpacking is checked via Starred nodes in args
+    for arg in call_node.args:
+        if isinstance(arg, ast.Starred):
+            raise ValueError("Positional argument unpacking (*args) is not allowed")
+    result: dict[str, Any] = {}
+    for kw in call_node.keywords:
+        if kw.arg is None:
+            raise ValueError("Keyword argument unpacking (**kwargs) is not allowed")
+        if kw.arg in result:
+            raise ValueError(f"Duplicate keyword argument: {kw.arg}")
+        result[kw.arg] = _convert_value(kw.value)
+    return result
+
+
+def _convert_value(node: ast.AST) -> Any:
+    """Recursively convert an AST expression node to a Python literal value."""
+    if isinstance(node, ast.Constant):
+        val = node.value
+        if isinstance(val, bool):
+            return val
+        elif isinstance(val, int):
+            return val
+        elif isinstance(val, float):
+            if math.isinf(val) or math.isnan(val):
+                raise ValueError("Non-finite numbers are not allowed")
+            return val
+        elif isinstance(val, str):
+            return val
+        elif val is None:
+            return None
+        elif isinstance(val, bytes):
+            raise ValueError("Bytes literals are not allowed")
+        elif isinstance(val, complex):
+            raise ValueError("Complex numbers are not allowed")
+        elif val is Ellipsis:
+            raise ValueError("Ellipsis is not allowed")
+        else:
+            raise ValueError(f"Unsupported constant: {val!r}")
+    elif isinstance(node, ast.UnaryOp):
+        if isinstance(node.op, (ast.UAdd, ast.USub)):
+            val = _convert_value(node.operand)
+            if isinstance(val, bool):
+                raise ValueError("Unary + and - are not allowed on booleans")
+            if not isinstance(val, (int, float)):
+                raise ValueError(
+                    f"Unary operator requires a numeric operand, got {type(val).__name__}"
+                )
+            if isinstance(node.op, ast.USub):
+                return -val
+            return val
+        else:
+            raise ValueError(
+                f"Unary operator {type(node.op).__name__} is not allowed"
+            )
+    elif isinstance(node, ast.List):
+        return [_convert_value(el) for el in node.elts]
+    elif isinstance(node, ast.Tuple):
+        return [_convert_value(el) for el in node.elts]
+    elif isinstance(node, ast.Dict):
+        result: dict[str, Any] = {}
+        for k, v in zip(node.keys, node.values):
+            if k is None:
+                raise ValueError("Dict unpacking (**) is not allowed")
+            key = _convert_value(k)
+            if not isinstance(key, str):
+                raise ValueError(
+                    f"Dict keys must be strings, got {type(key).__name__}"
+                )
+            if key in result:
+                raise ValueError(f"Duplicate dict key: {key}")
+            result[key] = _convert_value(v)
+        return result
+    elif isinstance(node, ast.ListComp):
+        raise ValueError("List comprehensions are not allowed")
+    elif isinstance(node, ast.SetComp):
+        raise ValueError("Set comprehensions are not allowed")
+    elif isinstance(node, ast.DictComp):
+        raise ValueError("Dict comprehensions are not allowed")
+    elif isinstance(node, ast.Name):
+        raise ValueError(f"Variables are not allowed: {node.id}")
+    elif isinstance(node, ast.Attribute):
+        raise ValueError("Attribute access is not allowed")
+    elif isinstance(node, ast.Call):
+        raise ValueError("Nested calls are not allowed")
+    elif isinstance(node, ast.Lambda):
+        raise ValueError("Lambdas are not allowed")
+    elif isinstance(node, ast.JoinedStr):
+        raise ValueError("f-strings are not allowed")
+    elif isinstance(node, ast.BinOp):
+        raise ValueError("Binary operations are not allowed")
+    elif isinstance(node, ast.Subscript):
+        raise ValueError("Subscript access is not allowed")
+    elif isinstance(node, ast.IfExp):
+        raise ValueError("Conditional expressions are not allowed")
+    elif isinstance(node, ast.Set):
+        raise ValueError("Sets are not allowed")
+    elif isinstance(node, ast.Starred):
+        raise ValueError("Starred expressions are not allowed")
+    elif isinstance(node, ast.Slice):
+        raise ValueError("Slice expressions are not allowed")
+    else:
+        raise ValueError(f"Unsupported expression: {type(node).__name__}")
+
+
