diff --git a/outlines/types/__init__.py b/outlines/types/__init__.py
index 85af9ad..fb53659 100644
--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,11 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches MAC addresses in colon-separated (AA:BB:CC:DD:EE:FF) or
+# hyphen-separated (AA-BB-CC-DD-EE-FF) format with consistent separators.
+# Uses alternation of two branches to avoid backreference issues with
+# the to_regex wrapper which adds an outer capturing group.
+mac_address = Regex(
+    r"[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}|[0-9A-Fa-f]{2}(-[0-9A-Fa-f]{2}){5}"
+)
diff --git a/tests/types/test_dsl.py b/tests/types/test_dsl.py
index 4e13b1d..53c81de 100644
--- a/tests/types/test_dsl.py
+++ b/tests/types/test_dsl.py
@@ -789,3 +789,56 @@ def test_dsl_handle_dict():
     assert result.terms[1].term.terms[2] == types.string
     assert result.terms[1].term.terms[3] == KleeneStar(Sequence([String(", "), types.integer, String(":"), types.string]))
     assert result.terms[2] == String("}")
+
+
+def test_mac_address():
+    """Test the mac_address regex type."""
+    mac = types.mac_address
+
+    # Valid colon-separated MAC addresses
+    assert mac.matches("00:1A:2B:3C:4D:5E")
+    assert mac.matches("ff:FF:00:00:00:00")
+    assert mac.matches("ab:cd:ef:AB:CD:EF")
+    assert mac.matches("00:00:00:00:00:00")
+
+    # Valid hyphen-separated MAC addresses
+    assert mac.matches("00-1A-2B-3C-4D-5E")
+    assert mac.matches("FF-FF-00-00-00-00")
+    assert mac.matches("ab-cd-ef-AB-CD-EF")
+    assert mac.matches("00-00-00-00-00-00")
+
+    # Invalid: mixed separators
+    assert not mac.matches("00:1A-2B:3C-4D:5E")
+    assert not mac.matches("00-1A:2B-3C:4D-5E")
+
+    # Invalid: no separators
+    assert not mac.matches("001A2B3C4D5E")
+
+    # Invalid: dotted notation
+    assert not mac.matches("0011.2233.4455")
+
+    # Invalid: EUI-64 (8 octets)
+    assert not mac.matches("00:1A:2B:3C:4D:5E:6F:70")
+
+    # Invalid: shortened
+    assert not mac.matches("1A:2B:3C:4D:5E")
+
+    # Invalid: leading/trailing whitespace
+    assert not mac.matches(" 00:1A:2B:3C:4D:5E")
+    assert not mac.matches("00:1A:2B:3C:4D:5E ")
+
+    # Invalid: empty string
+    assert not mac.matches("")
+
+    # Invalid: non-hex characters
+    assert not mac.matches("0G:1A:2B:3C:4D:5E")
+
+    # Validates correctly
+    assert mac.validate("00:1A:2B:3C:4D:5E") == "00:1A:2B:3C:4D:5E"
+    assert mac.validate("00-1A-2B-3C-4D-5E") == "00-1A-2B-3C-4D-5E"
+
+    # Raises ValueError for invalid inputs
+    with pytest.raises(ValueError, match="Input should be in the language of the regular expression"):
+        mac.validate("00:1A-2B:3C-4D:5E")
+    with pytest.raises(ValueError, match="Input should be in the language of the regular expression"):
+        mac.validate("")
