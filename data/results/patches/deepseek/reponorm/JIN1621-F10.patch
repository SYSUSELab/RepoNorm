+    def _resolve_alias(self, name: str) -> str:
+        """Resolve a single alias lookup. If *name* is an alias,
+        returns its target. Otherwise returns *name* unchanged.
+        """
+        aliases = getattr(self, "_aliases", None)
+        if aliases is not None:
+            target = aliases.get(name)
+            if target is not None:
+                return target
+        return name
+
+    def _register_environment(self, environment: "Environment") -> None:
+        """Register an environment that uses this loader, for cache
+        invalidation on alias mutation.
+        """
+        envs = getattr(self, "_environments", None)
+        if envs is None:
+            envs = weakref.WeakSet()
+            self._environments = envs
+        envs.add(environment)
+
+    def _unregister_environment(self, environment: "Environment") -> None:
+        envs = getattr(self, "_environments", None)
+        if envs is not None:
+            envs.discard(environment)
+
+    def _invalidate_alias_cache(self, alias: str) -> None:
+        """Remove cache entries for *alias* in all registered environments."""
+        envs = getattr(self, "_environments", None)
+        if envs is None:
+            return
+        for env in envs:
+            cache = getattr(env, "cache", None)
+            if cache is None:
+                continue
+            key = (weakref.ref(self), alias)
+            try:
+                cache.pop(key, None)  # dict has pop
+            except AttributeError:
+                # LRUCache does not have pop
+                try:
+                    del cache[key]
+                except KeyError:
+                    pass
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Add an alias mapping. *alias* is a template name that will be
+        resolved to *target* before normal loading is attempted.
+        """
+        aliases = getattr(self, "_aliases", None)
+        if aliases is None:
+            aliases = {}
+            self._aliases = aliases
+        aliases[alias] = target
+        self._invalidate_alias_cache(alias)
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias. Harmless if the alias does not exist."""
+        aliases = getattr(self, "_aliases", None)
+        if aliases is not None and alias in aliases:
+            del aliases[alias]
+            self._invalidate_alias_cache(alias)
+
+    def _list_with_aliases(self, templates: t.List[str]) -> t.List[str]:
+        """Return a new list that includes aliases whose target appears
+        in *templates*.
+        """
+        aliases = getattr(self, "_aliases", None)
+        if aliases:
+            templates_set = set(templates)
+            for alias, target in aliases.items():
+                if target in templates_set:
+                    templates.append(alias)
+        return templates
+
 
