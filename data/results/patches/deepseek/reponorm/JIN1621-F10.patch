+class TestAliases:
+    """Tests for loader alias functionality."""
+
+    def test_add_alias_dict_loader(self):
+        """Basic alias resolution on a DictLoader."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        loader.add_alias("shortcut", "target.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render() == "HELLO"
+
+    def test_add_alias_overwrites(self):
+        """Adding an existing alias overwrites it."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        loader.add_alias("shortcut", "old_target.html")
+        loader.add_alias("shortcut", "target.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render() == "HELLO"
+
+    def test_remove_alias_harmless_unknown(self):
+        """Removing an unknown alias does nothing."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        # Should not raise
+        loader.remove_alias("nonexistent_alias")
+
+    def test_remove_alias_removes_mapping(self):
+        """After removing an alias, the alias name is no longer resolved."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        loader.add_alias("shortcut", "target.html")
+        loader.remove_alias("shortcut")
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound):
+            env.get_template("shortcut")
+
+    def test_missing_target_raises_for_target_name(self):
+        """A missing target raises TemplateNotFound for the target name."""
+        loader = loaders.DictLoader({"real.html": "HELLO"})
+        loader.add_alias("alias", "missing.html")
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("alias")
+        assert "missing.html" in str(excinfo.value)
+
+    def test_alias_no_chaining(self):
+        """Aliases are resolved exactly once; no chaining."""
+        loader = loaders.DictLoader({"real.html": "HELLO"})
+        loader.add_alias("first", "second")
+        loader.add_alias("second", "real.html")
+        env = Environment(loader=loader)
+        # "first" resolves to "second", then loading "second" fails because
+        # "second" is not in the dict (aliases are only resolved once).
+        with pytest.raises(TemplateNotFound):
+            env.get_template("first")
+
+    def test_prefix_loader_alias(self):
+        """Alias resolution on PrefixLoader."""
+        dict_loader = loaders.DictLoader({"justdict.html": "FOO"})
+        loader = loaders.PrefixLoader({"x": dict_loader})
+        loader.add_alias("shortcut", "x/justdict.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render().strip() == "FOO"
+
+    def test_choice_loader_alias(self):
+        """Alias resolution on ChoiceLoader."""
+        dict_loader = loaders.DictLoader({"justdict.html": "FOO"})
+        loader = loaders.ChoiceLoader([dict_loader])
+        loader.add_alias("shortcut", "justdict.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render().strip() == "FOO"
+
+    def test_list_templates_includes_alias(self):
+        """list_templates includes aliases whose target appears in the listing."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        loader.add_alias("shortcut", "target.html")
+        templates = loader.list_templates()
+        assert "shortcut" in templates
+        assert "target.html" in templates
+
+    def test_list_templates_omits_broken_alias(self):
+        """list_templates omits aliases whose target is not listed."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        loader.add_alias("good", "target.html")
+        loader.add_alias("broken", "missing.html")
+        templates = loader.list_templates()
+        assert "good" in templates
+        assert "broken" not in templates
+
+    def test_list_templates_omits_chained_alias(self):
+        """list_templates omits aliases whose target is another alias (chained)."""
+        loader = loaders.DictLoader({"real.html": "HELLO"})
+        loader.add_alias("chain1", "real.html")
+        loader.add_alias("chain2", "chain1")
+        templates = loader.list_templates()
+        assert "chain1" in templates  # target "real.html" is in listing
+        assert "chain2" not in templates  # target "chain1" is NOT in listing
+
+    def test_list_templates_prefix_loader(self):
+        """list_templates on PrefixLoader includes valid aliases."""
+        dict_loader = loaders.DictLoader({"justdict.html": "FOO"})
+        loader = loaders.PrefixLoader({"x": dict_loader})
+        loader.add_alias("shortcut", "x/justdict.html")
+        templates = loader.list_templates()
+        assert "shortcut" in templates
+        assert "x/justdict.html" in templates
+
+    def test_list_templates_choice_loader(self):
+        """list_templates on ChoiceLoader includes valid aliases."""
+        dict_loader = loaders.DictLoader({"justdict.html": "FOO"})
+        loader = loaders.ChoiceLoader([dict_loader])
+        loader.add_alias("shortcut", "justdict.html")
+        templates = loader.list_templates()
+        assert "shortcut" in templates
+        assert "justdict.html" in templates
+
+    def test_alias_cache_invalidation_on_add(self):
+        """Adding an alias invalidates the cache entry for that alias name."""
+        loader = loaders.DictLoader({"target.html": "HELLO", "other.html": "WORLD"})
+        env = Environment(loader=loader, cache_size=-1)
+
+        # Ensure target.html is cached
+        tmpl1 = env.get_template("target.html")
+        assert tmpl1.render() == "HELLO"
+
+        # Add alias and verify it can be loaded fresh
+        loader.add_alias("newalias", "target.html")
+        tmpl2 = env.get_template("newalias")
+        assert tmpl2.render() == "HELLO"
+
+        # Now add a different alias with a previously-used name
+        loader.add_alias("newalias2", "other.html")
+        tmpl3 = env.get_template("newalias2")
+        assert tmpl3.render() == "WORLD"
+
+    def test_alias_cache_invalidation_on_remove(self):
+        """Removing an alias invalidates the cache entry for that alias name."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        env = Environment(loader=loader, cache_size=-1)
+
+        # Use alias and cache it
+        loader.add_alias("shortcut", "target.html")
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render() == "HELLO"
+
+        # Remove alias - next request should fail
+        loader.remove_alias("shortcut")
+        with pytest.raises(TemplateNotFound):
+            env.get_template("shortcut")
+
+    def test_alias_cache_invalidation_on_overwrite(self):
+        """Overwriting an alias invalidates the old cache entry."""
+        loader = loaders.DictLoader({"first.html": "FIRST", "second.html": "SECOND"})
+        env = Environment(loader=loader, cache_size=-1)
+
+        # Cache template loaded through original name
+        loader.add_alias("myalias", "first.html")
+        tmpl = env.get_template("myalias")
+        assert tmpl.render() == "FIRST"
+
+        # Overwrite alias to point to different target
+        loader.add_alias("myalias", "second.html")
+        tmpl = env.get_template("myalias")
+        assert tmpl.render() == "SECOND"
+
+    def test_direct_target_entry_remains_listed(self):
+        """Direct target entries remain listed even when alias exists."""
+        loader = loaders.DictLoader({"target.html": "HELLO"})
+        loader.add_alias("alias1", "target.html")
+        loader.add_alias("alias2", "target.html")
+        templates = loader.list_templates()
+        assert "target.html" in templates
+        assert "alias1" in templates
+        assert "alias2" in templates
+
+    def test_alias_on_filesystem_loader(self):
+        """Alias resolution on FileSystemLoader."""
+        here = Path(__file__).parent.resolve()
+        loader = loaders.FileSystemLoader(here / "res" / "templates")
+        loader.add_alias("shortcut", "test.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render().strip() == "BAR"
+
+    def test_alias_on_function_loader(self):
+        """Alias resolution on FunctionLoader."""
+        loader = loaders.FunctionLoader({"justfunction.html": "FOO"}.get)
+        loader.add_alias("shortcut", "justfunction.html")
+        env = Environment(loader=loader)
+        tmpl = env.get_template("shortcut")
+        assert tmpl.render().strip() == "FOO"
