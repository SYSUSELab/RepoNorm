+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize diverse input shapes into the canonical ToolCalls structure.
+
+        Accepts:
+        - ``{"tool_calls": [{"name": ..., "args": ...}, ...]}`` (existing format)
+        - ``{"name": ..., "args": ...}`` (single tool call object)
+        - ``[{"name": ..., "args": ...}, ...]`` (bare list, including empty)
+        - Plain JSON strings of any of the above.
+
+        Returns the normalized dict/list structure (not a ToolCalls instance).
+        Non-JSON strings are returned unchanged.
+        Existing ToolCalls instances are passed through unchanged.
+        """
+        if isinstance(data, ToolCalls):
+            return data
+
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                return data  # Non-JSON string, let model validation reject it
+
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data  # Already canonical
+            if "name" in data:
+                return {"tool_calls": [data]}  # Single tool call
+            return data  # Malformed dict, let validation catch it
+
+        if isinstance(data, list):
+            return {"tool_calls": data}  # Bare list
+
+        return data
+
+    @model_validator(mode="before")
+    @classmethod
+    def _normalize_input(cls, data: Any) -> Any:
+        return cls.validate_input(data)
