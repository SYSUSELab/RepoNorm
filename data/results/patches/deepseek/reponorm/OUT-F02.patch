+            # Fast path: already cached.
+            if key in self._cache:
+                self._cache.move_to_end(key)
+                return self._cache[key]
+
+            # Determine whether this thread must compile or wait.
+            if key in self._pending:
+                pending_result, pending_event = self._pending[key]
+                should_compile = False
+            else:
+                pending_result = [None]
+                pending_event = threading.Event()
+                self._pending[key] = (pending_result, pending_event)
+                should_compile = True
