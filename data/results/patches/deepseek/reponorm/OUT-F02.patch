+class TestXGrammarBackendCachingEnabled:
+    """When caching is enabled, reuse compilations for same key."""
+
+    def test_cache_hit_json_schema(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True)
+
+        p1 = backend.get_json_schema_logits_processor('{"type":"string"}')
