+class TestXGrammarBackendLRUEviction:
+    """Test least-recently-used eviction when cache is full."""
+
+    def test_evict_lru(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True, max_size=2)
+
+        s1 = '{"type":"string"}'
+        s2 = '{"type":"integer"}'
+        s3 = '{"type":"boolean"}'
+
+        backend.get_json_schema_logits_processor(s1)
+        backend.get_json_schema_logits_processor(s2)
+        assert len(backend._cache) == 2
+
+        # Access s2 (refresh recency), then add s3 - should evict s1 (LRU)
+        backend.get_json_schema_logits_processor(s2)  # hit, refresh
+        backend.get_json_schema_logits_processor(s3)  # miss, add, evict
+
+        assert len(backend._cache) == 2
+        # s1 should have been evicted
+        assert ("json_schema", s1) not in backend._cache
+        assert ("json_schema", s2) in backend._cache
+        assert ("json_schema", s3) in backend._cache
+
+    def test_hit_refreshes_recency(self, mock_xgrammar):
+        """Accessing an entry keeps it from being evicted."""
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True, max_size=2)
+
+        s1 = '{"type":"string"}'
+        s2 = '{"type":"integer"}'
+        s3 = '{"type":"boolean"}'
+
+        backend.get_json_schema_logits_processor(s1)  # LRU = s1
+        backend.get_json_schema_logits_processor(s2)
+
+        backend.get_json_schema_logits_processor(s1)  # refresh s1
+        backend.get_json_schema_logits_processor(s3)  # evicts LRU = s2
+
+        assert len(backend._cache) == 2
+        assert ("json_schema", s1) in backend._cache
+        assert ("json_schema", s2) not in backend._cache  # evicted
+        assert ("json_schema", s3) in backend._cache
+
+
+class TestXGrammarBackendConcurrentAccess:
+    """Test thread safety of the cache."""
+
+    def test_concurrent_cold_requests_share_compilation(self, mock_xgrammar):
+        """Multiple threads requesting the same key share one compilation."""
+        mock_xgr, mock_compiler = mock_xgrammar
+
+        # Make compile_json_schema slow so threads pile up
+        def slow_compile(schema):
+            time.sleep(0.2)
+            return "compiled_" + schema
+
+        mock_compiler.compile_json_schema.side_effect = slow_compile
+
+        # Use same fixture patches but create backend directly
+        model = FakeModel()
+        with patch("transformers.AutoConfig") as mock_ac:
+            mock_ac.from_pretrained.return_value.vocab_size = 50000
+            backend = XGrammarBackend(model, True)
+
+        results = []
+        errors = []
+
+        def request():
+            try:
+                p = backend.get_json_schema_logits_processor('{"type":"string"}')
+                results.append(p.compiled_grammar)
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=request) for _ in range(5)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        assert len(errors) == 0
+        assert len(results) == 5
+        # Only one actual compile call
+        assert mock_compiler.compile_json_schema.call_count == 1
+
+    def test_concurrent_compilation_failure_propagates(self, mock_xgrammar):
+        """If compilation fails, all waiting threads get the exception."""
+        mock_xgr, mock_compiler = mock_xgrammar
+
+        def failing_compile(schema):
+            time.sleep(0.1)
+            raise ValueError("Compilation failed")
+
+        mock_compiler.compile_json_schema.side_effect = failing_compile
+
+        model = FakeModel()
+        with patch("transformers.AutoConfig") as mock_ac:
+            mock_ac.from_pretrained.return_value.vocab_size = 50000
+            backend = XGrammarBackend(model, True)
+
+        errors = []
+
+        def request():
+            try:
+                backend.get_json_schema_logits_processor('{"type":"string"}')
+            except ValueError as e:
+                errors.append(str(e))
+
+        threads = [threading.Thread(target=request) for _ in range(5)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        assert len(errors) == 5
+        assert all(e == "Compilation failed" for e in errors)
+        # Failed entry is not cached
+        assert len(backend._cache) == 0
+
+    def test_retry_after_failure(self, mock_xgrammar):
+        """After a failed compilation, a later request can retry and succeed."""
+        mock_xgr, mock_compiler = mock_xgrammar
+
+        call_count = [0]
+
+        def first_fail_then_succeed(schema):
+            call_count[0] += 1
+            if call_count[0] == 1:
+                raise ValueError("First attempt fails")
+            return "compiled_success"
+
+        mock_compiler.compile_json_schema.side_effect = first_fail_then_succeed
+
+        model = FakeModel()
+        with patch("transformers.AutoConfig") as mock_ac:
+            mock_ac.from_pretrained.return_value.vocab_size = 50000
+            backend = XGrammarBackend(model, True)
+
+        # First attempt fails
+        with pytest.raises(ValueError, match="First attempt fails"):
+            backend.get_json_schema_logits_processor('{"type":"string"}')
+
+        assert len(backend._cache) == 0
+
+        # Second attempt succeeds
+        p = backend.get_json_schema_logits_processor('{"type":"string"}')
+        assert p.compiled_grammar == "compiled_success"
+        assert mock_compiler.compile_json_schema.call_count == 2
+
+    def test_different_keys_compile_independently(self, mock_xgrammar):
+        """Different keys can be compiled concurrently without interference."""
+        mock_xgr, mock_compiler = mock_xgrammar
+
+        barrier = threading.Barrier(2, timeout=2)
+
+        def slow_compile1(schema):
+            barrier.wait()
+            time.sleep(0.1)
+            return "compiled_1"
+
+        def slow_compile2(schema):
+            barrier.wait()
+            time.sleep(0.1)
+            return "compiled_2"
+
+        mock_compiler.compile_json_schema.side_effect = slow_compile1
+        mock_compiler.compile_regex.side_effect = slow_compile2
+
+        model = FakeModel()
+        with patch("transformers.AutoConfig") as mock_ac:
+            mock_ac.from_pretrained.return_value.vocab_size = 50000
+            backend = XGrammarBackend(model, True)
+
+        results = {"json": None, "regex": None}
+        errors = []
+
+        def request_json():
+            try:
+                p = backend.get_json_schema_logits_processor('{"type":"string"}')
+                results["json"] = p.compiled_grammar
+            except Exception as e:
+                errors.append(("json", e))
+
+        def request_regex():
+            try:
+                p = backend.get_regex_logits_processor(r"\d+")
+                results["regex"] = p.compiled_grammar
+            except Exception as e:
+                errors.append(("regex", e))
+
+        t1 = threading.Thread(target=request_json)
+        t2 = threading.Thread(target=request_regex)
+        t1.start()
+        t2.start()
+        t1.join()
+        t2.join()
+
+        assert len(errors) == 0
+        assert results["json"] == "compiled_1"
+        assert results["regex"] == "compiled_2"
+        assert mock_compiler.compile_json_schema.call_count == 1
+        assert mock_compiler.compile_regex.call_count == 1
+
+
+class TestXGrammarBackendProcessorIndependence:
+    """Each factory call returns a fresh, independent processor."""
+
+    def test_fresh_processor_each_call(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True)
+
+        p1 = backend.get_json_schema_logits_processor('{"type":"string"}')
+        p2 = backend.get_json_schema_logits_processor('{"type":"string"}')
+
+        assert p1 is not p2
+        # Reset independently (reset sets xgrammar_logits_processor to None)
+        p1.reset()
