+class TestXGrammarBackendCachingDisabled:
+    """When caching is disabled, every request compiles normally."""
+
+    def test_no_cache_json_schema(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=False)
+
+        p1 = backend.get_json_schema_logits_processor('{"type":"string"}')
+        p2 = backend.get_json_schema_logits_processor('{"type":"string"}')
+
+        # Should compile twice
+        assert mock_compiler.compile_json_schema.call_count == 2
+        # Each processor is a fresh instance
+        assert p1 is not p2
+
+    def test_no_cache_regex(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=False)
+
+        p1 = backend.get_regex_logits_processor(r"\d+")
+        p2 = backend.get_regex_logits_processor(r"\d+")
+
+        assert mock_compiler.compile_regex.call_count == 2
+        assert p1 is not p2
+
+    def test_no_cache_cfg(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=False)
+
+        p1 = backend.get_cfg_logits_processor("root ::= yes")
+        p2 = backend.get_cfg_logits_processor("root ::= yes")
