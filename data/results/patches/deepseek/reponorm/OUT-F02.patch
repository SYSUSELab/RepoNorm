+"""Tests for compiled grammar caching in XGrammarBackend."""
+
+import threading
+import time
+import sys
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from outlines.backends.xgrammar import XGrammarBackend
+from outlines.models.transformers import Transformers
+
+
+class HFConfig:
+    _name_or_path = "erwanf/gpt2-mini"
+
+
+class HFModel:
+    config = HFConfig()
+
+
+class FakeModel(Transformers):
+    """Minimal fake Transformers model for testing XGrammarBackend."""
+
+    def __init__(self):
+        # Skip Transformers.__init__ by calling object.__init__
+        object.__init__(self)
+
+    model = HFModel()
+
+    class HFTokenizer:
+        pass
+
+    hf_tokenizer = HFTokenizer()
+
+
+@pytest.fixture
+def mock_xgrammar():
+    """Patch xgrammar module used internally by XGrammarBackend.
+
+    XGrammarBackend does ``import xgrammar as xgr`` inside __init__,
+    so we install a mock into sys.modules before instantiation.
+    """
+    # Build a mock xgrammar module
+    mock_xgr = MagicMock()
+    fake_tokenizer_info = MagicMock()
+    mock_xgr.TokenizerInfo.from_huggingface.return_value = fake_tokenizer_info
+
+    mock_compiler = MagicMock()
+    mock_compiler.compile_json_schema.return_value = "compiled_json"
+    mock_compiler.compile_regex.return_value = "compiled_regex"
+    mock_compiler.compile_grammar.return_value = "compiled_cfg"
+    mock_xgr.GrammarCompiler.return_value = mock_compiler
+
+    mock_xgr.contrib = MagicMock()
+    mock_xgr.contrib.hf.LogitsProcessor = MagicMock()
+
+    # Inject into sys.modules so 'import xgrammar as xgr' inside __init__ gets it
+    old_module = sys.modules.get("xgrammar")
+    sys.modules["xgrammar"] = mock_xgr
+
+    # Patch AutoConfig (lazy import inside __init__)
+    with patch("transformers.AutoConfig") as mock_auto_config:
+
+        fake_config = MagicMock()
+        fake_config.vocab_size = 50000
+        mock_auto_config.from_pretrained.return_value = fake_config
+
+        yield mock_xgr, mock_compiler
+
+    # Restore sys.modules
+    if old_module is not None:
+        sys.modules["xgrammar"] = old_module
+    else:
+        del sys.modules["xgrammar"]
+
+
+def _make_backend(mock_xgrammar, cache=False, max_size=None):
+    """Helper to create an XGrammarBackend with mocks."""
+    _, _ = mock_xgrammar
+    model = FakeModel()
+    backend = XGrammarBackend(model, cache, max_size)
+    return backend
+
+
+class TestXGrammarBackendCachingInit:
+    """Test __init__ parameter validation."""
+
+    def test_default_no_caching(self, mock_xgrammar):
+        """Caching is disabled by default."""
+        backend = _make_backend(mock_xgrammar, cache=False)
+        assert backend.cache_compiled_grammars is False
+        assert backend.max_cached_grammars is None
+        assert not hasattr(backend, "_cache")
+
+    def test_enable_caching_unbounded(self, mock_xgrammar):
+        """Enable caching with no limit."""
+        backend = _make_backend(mock_xgrammar, cache=True)
+        assert backend.cache_compiled_grammars is True
+        assert backend.max_cached_grammars is None
+        assert hasattr(backend, "_cache")
+        assert len(backend._cache) == 0
+
+    def test_enable_caching_with_limit(self, mock_xgrammar):
+        """Enable caching with a max size."""
+        backend = _make_backend(mock_xgrammar, cache=True, max_size=5)
+        assert backend.cache_compiled_grammars is True
+        assert backend.max_cached_grammars == 5
+
+    def test_limit_none_without_cache(self, mock_xgrammar):
+        """max_cached_grammars=None without caching is fine."""
+        backend = _make_backend(mock_xgrammar, cache=False, max_size=None)
+        assert backend.max_cached_grammars is None
+
+    def test_invalid_limit_zero(self, mock_xgrammar):
+        """max_cached_grammars=0 raises ValueError."""
+        with pytest.raises(ValueError, match="positive integer"):
+            _make_backend(mock_xgrammar, cache=True, max_size=0)
+
+    def test_invalid_limit_negative(self, mock_xgrammar):
+        """max_cached_grammars=-1 raises ValueError."""
+        with pytest.raises(ValueError, match="positive integer"):
+            _make_backend(mock_xgrammar, cache=True, max_size=-1)
+
+    def test_invalid_limit_bool_true(self, mock_xgrammar):
+        """max_cached_grammars=True raises ValueError."""
+        with pytest.raises(ValueError, match="positive integer"):
+            _make_backend(mock_xgrammar, cache=True, max_size=True)
+
+    def test_invalid_limit_bool_false(self, mock_xgrammar):
+        """max_cached_grammars=False raises ValueError."""
+        with pytest.raises(ValueError, match="positive integer"):
+            _make_backend(mock_xgrammar, cache=True, max_size=False)
+
+    def test_invalid_limit_float(self, mock_xgrammar):
+        """max_cached_grammars=1.5 raises ValueError."""
+        with pytest.raises(ValueError, match="positive integer"):
+            _make_backend(mock_xgrammar, cache=True, max_size=1.5)
+
