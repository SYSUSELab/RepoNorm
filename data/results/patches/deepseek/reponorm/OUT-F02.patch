+        p1 = backend.get_cfg_logits_processor("root ::= yes")
+        p2 = backend.get_cfg_logits_processor("root ::= yes")
+
+        assert mock_compiler.compile_grammar.call_count == 1
+        assert p1 is not p2
+
+    def test_different_keys_dont_interfere(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True)
+
+        backend.get_json_schema_logits_processor('{"type":"string"}')
+        backend.get_regex_logits_processor(r"\d+")
+
+        assert mock_compiler.compile_json_schema.call_count == 1
+        assert mock_compiler.compile_regex.call_count == 1
+
+    def test_different_sources_different_entries(self, mock_xgrammar):
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True)
+
+        p1 = backend.get_json_schema_logits_processor('{"type":"string"}')
+        p2 = backend.get_json_schema_logits_processor('{"type":"integer"}')
+
+        assert mock_compiler.compile_json_schema.call_count == 2
+        assert p1 is not p2
+
+    def test_different_kinds_isolated(self, mock_xgrammar):
+        """Same source string but different kinds are cached separately."""
+        mock_xgr, mock_compiler = mock_xgrammar
+        backend = _make_backend(mock_xgrammar, cache=True)
+
+        # Use same string but different kinds
+        backend.get_json_schema_logits_processor("same_string")
+        backend.get_regex_logits_processor("same_string")
