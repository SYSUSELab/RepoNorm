+                pending_result[0] = exc
+                pending_event.set()
+                self._pending.pop(key, None)
+            raise
+
+        with self._cache_lock:
+            pending_result[0] = compiled
+            pending_event.set()
+            self._pending.pop(key, None)
+
+            self._cache[key] = compiled
+            self._cache.move_to_end(key)
+
+            if self.max_cached_grammars is not None:
+                while len(self._cache) > self.max_cached_grammars:
