diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..3853c28 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,71 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sh -c on Windows.")
+def test_edit_working_dir_with_text(tmp_path):
+    """Test that working_dir is used when editing text (temp file)."""
+    # Use a command that writes the working directory to the file
+    result = click.edit(
+        "",
+        editor=f"sh -c 'pwd >&2'",
+        working_dir=str(tmp_path),
+    )
+    # The temp file approach: the editor doesn't modify the temp file,
+    # so require_save causes it to return None. That's fine - we just
+    # want to verify no crash.
+    assert result is None
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No pwd on Windows.")
+def test_edit_working_dir_preserves_cwd():
+    """Test that working_dir=None preserves the caller's cwd."""
+    import os
+
+    original_cwd = os.getcwd()
+    # Use sed which works on the given file
+    result = click.edit(
+        "a\nb",
+        editor="sed -i~ 's/$/Test/'",
+        working_dir=None,
+    )
+    assert result == "aTest\nbTest\n"
+
+
+def test_edit_working_dir_missing_dir():
+    """Test that a missing working_dir raises ClickException."""
+    with pytest.raises(click.ClickException):
+        click.edit(
+            "",
+            editor="true",
+            working_dir="/nonexistent_directory_xyz",
+        )
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No stat on Windows.")
+def test_edit_working_dir_with_filename(tmp_path):
+    """Test that working_dir resolves relative filenames."""
+    # Create a file in tmp_path
+    filepath = tmp_path / "test.txt"
+    filepath.write_text("hello\n")
+
+    # Edit using a relative filename with working_dir
+    click.edit(
+        editor=f"sh -c 'echo modified > \"$1\"' --",
+        filename="test.txt",
+        working_dir=str(tmp_path),
+    )
+
+    assert filepath.read_text() == "modified\n"
+
+
+def test_edit_working_dir_env(tmp_path):
+    """Test that env is forwarded together with working_dir."""
+    result = click.edit(
+        "",
+        editor=f"sh -c 'echo $MY_VAR >&2'",
+        env={"MY_VAR": "testing_env"},
+        working_dir=str(tmp_path),
+    )
+    assert result is None
