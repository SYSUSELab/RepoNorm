+    def _check_resource_limit(self) -> None:
+        """Check if any ancestor's resource limit would be exceeded.
+
+        Raises ``RuntimeError`` if the limit is reached on this context
+        or any ancestor.
+        """
+        ctx: Context | None = self
+        while ctx is not None:
+            if ctx._max_resources is not None and ctx._active_count >= ctx._max_resources:
+                raise RuntimeError(
+                    f"Context at '{self.command_path}' reached its maximum"
+                    f" number of resources ({ctx._max_resources})."
+                )
+            ctx = ctx.parent
+
+    def _reserve_resource_capacity(self) -> None:
+        """Reserve one resource slot on self and all ancestors.
+
+        Called after the limit check passes but before entering the
+        context manager. If entry fails, :meth:`_release_resource_capacity`
+        undoes this reservation.
+        """
+        self._resource_count += 1
+        ctx: Context | None = self
+        while ctx is not None:
+            ctx._active_count += 1
+            ctx = ctx.parent
+
+    def _release_resource_capacity(self) -> None:
+        """Release a reserved resource slot on self and all ancestors.
+
+        Called when entering a context manager fails after a
+        reservation was made.
+        """
+        self._resource_count -= 1
+        ctx: Context | None = self
+        while ctx is not None:
+            ctx._active_count -= 1
+            ctx = ctx.parent
+
 
     @property
     def command_path(self) -> str:
