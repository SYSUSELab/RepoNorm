+class TranslationExtractorExtension(Extension):
+    """Adds ``{% extract key=constant, ... %}...{% endextract %}`` tags.
+    Marker bodies are ordinary Jinja bodies and render unchanged.
+    Metadata values must be compile-time constants; duplicate or dynamic
+    keys raise :exc:`TemplateSyntaxError`.
+
+    .. versionadded:: 3.4
+    """
+
+    tags = {"extract"}
+
+    def __init__(self, environment: Environment) -> None:
+        super().__init__(environment)
+        environment.extend(
+            extract_marked_translations=self._extract_marked,
+            extract_marked_translations_from_templates=self._extract_marked_from_templates,
+        )
+
+    def _extract_marked(
+        self,
+        source: t.Union[str, nodes.Template],
+    ) -> "t.Iterator[t.Dict[str, t.Any]]":
+        """Extract marked translation records from *source*.
+
+        *source* is a template string or a parsed
+        :class:`~jinja2.nodes.Template`.  Each yielded record is a dict
+        with ``source`` (the string, or ``None`` if a parsed template was
+        provided), ``lineno`` (the marker start line), ``metadata`` (a
+        copy of the marker's compile-time constants), and ``messages``
+        (a list of dicts with ``lineno``, ``function``, and ``message``
+        for each gettext call in the marker body).
+
+        Extraction retains no state between calls.
+        """
+        if isinstance(source, str):
+            src: t.Optional[str] = source
+            ast = self.environment.parse(source)
+        else:
+            src = None
+            ast = source
+
+        return _extract_marked_from_ast(ast, src)
+
+    def _extract_marked_from_templates(
+        self,
+        names: t.Optional[t.Iterable[str]] = None,
+    ) -> "t.Iterator[t.Dict[str, t.Any]]":
+        """Extract marked translation records for templates from the
+        configured loader.
+
+        *names* is a finite iterable of logical template names, processed
+        in iteration order.  When omitted, all templates known to the
+        loader are processed.  Each record's ``source`` is the logical
+        name being processed.  Templates are parsed but not rendered, and
+        includes or inheritance are not followed.
+        """
+        loader = self.environment.loader
+        if loader is None:
+            return
+
+        if names is None:
+            names = list(self.environment.list_templates())
+
+        for name in names:
+            src, _, _ = loader.get_source(self.environment, name)
+            ast = self.environment.parse(src)
+            yield from _extract_marked_from_ast(ast, name)
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse ``{% extract key=value, ... %}...{% endextract %}``."""
+        lineno = next(parser.stream).lineno
+        metadata: t.Dict[str, t.Any] = {}
+
+        while parser.stream.current.type != "block_end":
+            if metadata:
+                parser.stream.expect("comma")
+
+            key_token = parser.stream.expect("name")
+            key = key_token.value
+
+            if key in metadata:
+                parser.fail(
+                    f"duplicate key {key!r} in extract marker",
+                    key_token.lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            parser.stream.expect("assign")
+            value_node = parser.parse_expression()
+
+            try:
+                value = value_node.as_const()
+            except nodes.Impossible:
+                parser.fail(
+                    f"value for key {key!r} in extract marker must be a "
+                    f"compile-time constant",
+                    value_node.lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            metadata[key] = value
+
+        body = parser.parse_statements(("name:endextract",), drop_needle=True)
+
+        return nodes.MarkedBlock(metadata, body, lineno=lineno)
+
+
+def _extract_marked_from_ast(
+    ast: nodes.Template,
+    source: t.Optional[str] = None,
+) -> "t.Iterator[t.Dict[str, t.Any]]":
+    """Yield marked translation records from AST nodes."""
+    for marker in ast.find_all(nodes.MarkedBlock):
+        messages: t.List[t.Dict[str, t.Any]] = []
+
+        # Reuse extract_from_ast on the marker body so that
+        # message extraction is consistent with normal extraction.
+        mini_ast = nodes.Template(
+            marker.body,
+            lineno=marker.lineno,
+        )
+        for lineno, func, message in extract_from_ast(mini_ast):
+            messages.append(
+                {
+                    "lineno": lineno,
+                    "function": func,
+                    "message": message,
+                }
+            )
+
+        yield {
+            "source": source,
+            "lineno": marker.lineno,
+            "metadata": dict(marker.metadata),
+            "messages": messages,
+        }
+
+
