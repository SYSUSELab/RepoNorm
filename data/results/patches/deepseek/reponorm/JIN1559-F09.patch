+class TestMarkedExtraction:
+    """Tests for ``TranslationExtractorExtension`` tag and extraction methods."""
+
+    def _env(self, **overrides):
+        from jinja2 import Environment
+        from jinja2.ext import TranslationExtractorExtension
+
+        return Environment(
+            extensions=[TranslationExtractorExtension], **overrides
+        )
+
+    def test_basic_extraction(self):
+        """Extract a simple marker with one gettext call."""
+        env = self._env()
+        records = list(
+            env.extract_marked_translations(
+                '{% extract key = "greeting" %}{{ gettext("Hello") }}{% endextract %}',
+            )
+        )
+        assert len(records) == 1
+        rec = records[0]
+        assert rec["source"] is not None
+        assert rec["lineno"] == 1
+        assert rec["metadata"] == {"key": "greeting"}
+        assert len(rec["messages"]) == 1
+        assert rec["messages"][0]["function"] == "gettext"
+        assert rec["messages"][0]["message"] == "Hello"
+
+    def test_multiple_markers(self):
+        """Multiple markers yield multiple records."""
+        env = self._env()
+        source = (
+            '{% extract a = 1 %}{{ gettext("A") }}{% endextract %}'
+            '{% extract b = 2 %}{{ gettext("B") }}{% endextract %}'
+        )
+        records = list(env.extract_marked_translations(source))
+        assert len(records) == 2
+        assert records[0]["metadata"] == {"a": 1}
+        assert records[1]["metadata"] == {"b": 2}
+        assert records[0]["messages"][0]["message"] == "A"
+        assert records[1]["messages"][0]["message"] == "B"
+
+    def test_empty_body(self):
+        """A marker with no gettext calls yields an empty messages list."""
+        env = self._env()
+        records = list(
+            env.extract_marked_translations(
+                '{% extract key = 1 %}{% endextract %}',
+            )
+        )
+        assert len(records) == 1
+        assert records[0]["messages"] == []
+
+    def test_no_markers(self):
+        """Source without markers yields no records."""
+        env = self._env()
+        records = list(env.extract_marked_translations("{{ 1 + 1 }}"))
+        assert records == []
+
+    def test_parse_from_ast(self):
+        """Accept a pre-parsed Template node."""
+        env = self._env()
+        ast = env.parse(
+            '{% extract key = 42 %}{{ gettext("hi") }}{% endextract %}',
+        )
+        records = list(env.extract_marked_translations(ast))
+        assert len(records) == 1
+        assert records[0]["metadata"] == {"key": 42}
+        assert records[0]["source"] is None  # no source string available
+
+    def test_compile_time_constant_metadata(self):
+        """Metadata values must be compile-time constants."""
+        env = self._env()
+        env.from_string('{% extract key = 42 %}{% endextract %}')
+
+    def test_dynamic_value_raises(self):
+        """Dynamic expressions in metadata raise TemplateSyntaxError."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        env = self._env()
+        try:
+            env.from_string(
+                '{% extract key = somevar %}body{% endextract %}',
+            )
+            assert False, "Expected TemplateSyntaxError"
+        except TemplateSyntaxError as e:
+            assert "compile-time constant" in str(e).lower()
+
+    def test_duplicate_key_raises(self):
+        """Duplicate keys in metadata raise TemplateSyntaxError."""
+        from jinja2.exceptions import TemplateSyntaxError
+
+        env = self._env()
+        try:
+            env.from_string(
+                '{% extract key = 1, key = 2 %}body{% endextract %}',
+            )
+            assert False, "Expected TemplateSyntaxError"
+        except TemplateSyntaxError as e:
+            assert "duplicate" in str(e).lower()
+
+    def test_multiple_gettext_functions(self):
+        """Nested gettext calls are all captured."""
+        env = self._env()
+        records = list(
+            env.extract_marked_translations(
+                '{% extract key = "x" %}'
+                '{{ gettext("Hello") }}{{ ngettext("item", "items", 1) }}'
+                '{% endextract %}',
+            )
+        )
+        assert len(records[0]["messages"]) == 2
+        funcs = {m["function"] for m in records[0]["messages"]}
+        assert funcs == {"gettext", "ngettext"}
+
+    def test_renders_unchanged(self):
+        """Marker body renders normally; markers leave no trace."""
+        env = self._env()
+        tmpl = env.from_string(
+            'before{% extract k = 1 %}inside{% endextract %}after',
+        )
+        assert tmpl.render() == "beforeinsideafter"
+
+    def test_renders_control_structures(self):
+        """Control structures inside markers render correctly."""
+        env = self._env()
+        tmpl = env.from_string(
+            '{% extract k = 1 %}'
+            '{% for x in [1, 2] %}{{ x }}{% endfor %}'
+            '{% endextract %}',
+        )
+        assert tmpl.render() == "12"
+
+    def test_stateless_between_calls(self):
+        """No stale records accumulate between extractions."""
+        env = self._env()
+
+        r1 = list(
+            env.extract_marked_translations(
+                '{% extract k = 1 %}a{% endextract %}',
+            )
+        )
+        assert len(r1) == 1
+
+        r2 = list(
+            env.extract_marked_translations(
+                '{% extract k = 2 %}b{% endextract %}',
+            )
+        )
+        assert len(r2) == 1
+        assert r2[0]["metadata"]["k"] == 2
+
+        r3 = list(env.extract_marked_translations("no markers"))
+        assert r3 == []
+
+    def test_callers_can_mutate_records(self):
+        """Callers may mutate returned record dicts without affecting others."""
+        env = self._env()
+        records = list(
+            env.extract_marked_translations(
+                '{% extract k = 1 %}{{ gettext("hi") }}{% endextract %}',
+            )
+        )
+        records[0]["metadata"]["k"] = 99
+        records[0]["messages"][0]["message"] = "modified"
+
+        # Subsequent call produces fresh copies
+        records2 = list(
+            env.extract_marked_translations(
+                '{% extract k = 1 %}{{ gettext("hi") }}{% endextract %}',
+            )
+        )
+        assert records2[0]["metadata"]["k"] == 1
+        assert records2[0]["messages"][0]["message"] == "hi"
+
+    def test_no_loader_from_templates(self):
+        """from_templates returns empty when no loader configured."""
+        env = self._env()
+        records = list(
+            env.extract_marked_translations_from_templates(names=["x.html"]),
+        )
+        assert records == []
+
+    def test_from_templates_explicit_names(self):
+        """Extract markers by explicit template names."""
+        from jinja2.loaders import DictLoader
+
+        env = self._env(
+            loader=DictLoader(
+                {
+                    "a.html": '{% extract k = 1 %}{{ gettext("A") }}{% endextract %}',
+                    "b.html": '{% extract k = 2 %}{{ gettext("B") }}{% endextract %}',
+                }
+            ),
+        )
+        records = list(
+            env.extract_marked_translations_from_templates(
+                names=["b.html", "a.html"],
+            )
+        )
+        assert len(records) == 2
+        assert [r["source"] for r in records] == ["b.html", "a.html"]
+        assert records[0]["metadata"]["k"] == 2
+        assert records[1]["metadata"]["k"] == 1
+
+    def test_from_templates_all(self):
+        """Omitting names processes all loader templates."""
+        from jinja2.loaders import DictLoader
+
+        env = self._env(
+            loader=DictLoader(
+                {
+                    "a.html": '{% extract k = 1 %}{% endextract %}',
+                    "b.html": '{% extract k = 2 %}{% endextract %}',
+                }
+            ),
+        )
+        records = list(env.extract_marked_translations_from_templates())
+        assert {r["source"] for r in records} == {"a.html", "b.html"}
+
+    def test_ordinary_extraction_independent(self):
+        """Ordinary extract_translations and Babel extraction continue to work."""
+        from jinja2.ext import InternationalizationExtension
+        from jinja2.ext import TranslationExtractorExtension
+
+        env = Environment(
+            extensions=[InternationalizationExtension, TranslationExtractorExtension],
+        )
+        records = list(env.extract_translations('{{ gettext("hello") }}'))
+        assert len(records) == 1
+        assert records[0][2] == "hello"
+
+        # marked extraction also works in the same environment
+        marked = list(
+            env.extract_marked_translations(
+                '{% extract k = 1 %}{{ gettext("world") }}{% endextract %}',
+            )
+        )
+        assert len(marked) == 1
+        assert marked[0]["messages"][0]["message"] == "world"
