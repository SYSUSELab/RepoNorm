+class MarkedBlock(Stmt):
+    """An AST node for the ``{% extract ... %}...{% endextract %}`` tag.
+
+    The rendered body is identical to the original template content.
+    The *metadata* dict holds compile-time constant keyword values
+    provided in the opening tag.
+
+    .. versionadded:: 3.4
+    """
+
+    fields = ("metadata", "body")
+    metadata: t.Dict[str, t.Any]
+    body: t.List[Node]
