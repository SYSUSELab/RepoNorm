@@ -0,0 +1,127 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+
+class IsColor(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid color code in hex, RGB, or HSL format.
+
+    Supports three- and six-digit hexadecimal values with an optional `#`,
+    RGB values with integer or percentage components in their valid ranges,
+    and HSL values with valid hue, saturation, and lightness ranges,
+    including an optional `deg` suffix on hue.
+
+    Matching is case-insensitive where applicable and permits ordinary whitespace
+    around values and components.
+
+    ```py title="IsColor"
+    from dirty_equals import IsColor
+
+    # hex
+    assert '#FF5733' == IsColor()
+    assert '#f57' == IsColor('hex')
+    assert 'FF5733' == IsColor()
+    assert '123' != IsColor('hex')  # not valid hex (contains only digits)
+
+    # rgb
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'rgb(100%, 0%, 0%)' == IsColor('rgb')
+    assert 'rgb(300, 0, 0)' != IsColor('rgb')  # 300 > 255
+
+    # hsl
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(14deg, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(361, 100%, 60%)' != IsColor('hsl')  # 361 > 360
+    ```
+    """
+
+    _valid_formats = ('hex', 'rgb', 'hsl')
+
+    _HEX_RE = re.compile(r'^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$')
+    _RGB_RE = re.compile(
+        r'^rgb\(\s*(\d{1,3})(%?)\s*,\s*(\d{1,3})(%?)\s*,\s*(\d{1,3})(%?)\s*\)$',
+        re.IGNORECASE,
+    )
+    _HSL_RE = re.compile(
+        r'^hsl\(\s*(\d{1,3})(?:deg)?\s*,\s*(\d{1,3})%\s*,\s*(\d{1,3})%\s*\)$',
+        re.IGNORECASE,
+    )
+
+    def __init__(self, format: Optional[str] = None):
+        """
+        Args:
+            format: The expected color format - `'hex'`, `'rgb'`, or `'hsl'`.
+                If omitted, any valid color format is accepted.
+
+        Examples:
+        ```py title="IsColor"
+        from dirty_equals import IsColor
+
+        assert '#FF5733' == IsColor
+        assert '#FF5733' == IsColor()
+        assert '#FF5733' == IsColor('hex')
+        assert 'rgb(255, 87, 51)' == IsColor('rgb')
+        assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+        assert 'not-a-color' != IsColor()
+        ```
+        """
+        if format is not None and format not in self._valid_formats:
+            raise ValueError(f"Invalid format '{format}', must be one of {self._valid_formats}")
+        self.format = format
+        super().__init__(plain_repr('*') if format is None else format)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        value = other.strip()
+
+        if self.format is None or self.format == 'hex':
+            if self._is_valid_hex(value):
+                return True
+
+        if self.format is None or self.format == 'rgb':
+            if self._is_valid_rgb(value):
+                return True
+
+        if self.format is None or self.format == 'hsl':
+            if self._is_valid_hsl(value):
+                return True
+
+        return False
+
+    @classmethod
+    def _is_valid_hex(cls, value: str) -> bool:
+        return bool(cls._HEX_RE.match(value))
+
+    @classmethod
+    def _is_valid_rgb(cls, value: str) -> bool:
+        m = cls._RGB_RE.match(value)
+        if not m:
+            return False
+        for i in range(3):
+            num_str = m.group(1 + i * 2)
+            has_pct = bool(m.group(2 + i * 2))
+            num = int(num_str)
+            if has_pct:
+                if num < 0 or num > 100:
+                    return False
+            else:
+                if num < 0 or num > 255:
+                    return False
+        return True
+
+    @classmethod
+    def _is_valid_hsl(cls, value: str) -> bool:
+        m = cls._HSL_RE.match(value)
+        if not m:
+            return False
+        hue = int(m.group(1))
+        sat = int(m.group(2))
+        light = int(m.group(3))
+        return 0 <= hue <= 360 and 0 <= sat <= 100 and 0 <= light <= 100
diff --git a/tests/test_color.py b/tests/test_color.py
