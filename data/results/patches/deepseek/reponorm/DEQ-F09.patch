@@ -0,0 +1,208 @@
+from dirty_equals import IsColor
+
+
+def test_is_color_repr():
+    """Test string representation follows conventions."""
+    assert repr(IsColor()) == 'IsColor(*)'
+    assert repr(IsColor('hex')) == "IsColor('hex')"
+    assert repr(IsColor('rgb')) == "IsColor('rgb')"
+    assert repr(IsColor('hsl')) == "IsColor('hsl')"
+
+
+def test_is_color_no_format():
+    """Test IsColor without format accepts any valid color."""
+    assert '#FF5733' == IsColor()
+    assert '#f57' == IsColor()
+    assert 'FF5733' == IsColor()
+    assert 'f57' == IsColor()
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'RGB(255, 87, 51)' == IsColor()
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'HSL(14, 100%, 60%)' == IsColor()
+
+
+def test_is_color_hex():
+    """Test hex color validation."""
+    # Valid 6-digit hex
+    assert '#FF5733' == IsColor('hex')
+    assert '#ff5733' == IsColor('hex')
+    assert 'FF5733' == IsColor('hex')
+    assert '#000000' == IsColor('hex')
+    assert '#FFFFFF' == IsColor('hex')
+    assert '#ffffff' == IsColor('hex')
+
+    # Valid 3-digit hex
+    assert '#f57' == IsColor('hex')
+    assert '#F57' == IsColor('hex')
+    assert 'f57' == IsColor('hex')
+    assert '#fff' == IsColor('hex')
+    assert '#000' == IsColor('hex')
+
+    # Invalid hex
+    assert '#GGGGGG' != IsColor('hex')
+    assert '#1234567' != IsColor('hex')
+    assert '#12' != IsColor('hex')
+    assert '12345' != IsColor('hex')
+    assert '' != IsColor('hex')
+    assert 'not-a-color' != IsColor('hex')
+
+
+def test_is_color_rgb():
+    """Test RGB color validation."""
+    # Valid RGB with integers
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'rgb(0, 0, 0)' == IsColor('rgb')
+    assert 'rgb(255, 255, 255)' == IsColor('rgb')
+    assert 'rgb(128, 128, 128)' == IsColor('rgb')
+
+    # Valid RGB with percentages
+    assert 'rgb(100%, 0%, 0%)' == IsColor('rgb')
+    assert 'rgb(0%, 100%, 0%)' == IsColor('rgb')
+    assert 'rgb(50%, 50%, 50%)' == IsColor('rgb')
+
+    # Valid RGB with mixed integer and percentage
+    assert 'rgb(255, 100%, 0)' == IsColor('rgb')
+
+    # Valid RGB with whitespace
+    assert 'rgb( 255 , 87 , 51 )' == IsColor('rgb')
+    assert 'rgb(255,87,51)' == IsColor('rgb')
+
+    # Case insensitive
+    assert 'RGB(255, 87, 51)' == IsColor('rgb')
+    assert 'Rgb(255, 87, 51)' == IsColor('rgb')
+
+    # Invalid RGB - out of range
+    assert 'rgb(256, 87, 51)' != IsColor('rgb')
+    assert 'rgb(-1, 87, 51)' != IsColor('rgb')
+    assert 'rgb(101%, 0%, 0%)' != IsColor('rgb')
+    assert 'rgb(100%, 101%, 0%)' != IsColor('rgb')
+
+    # Invalid RGB - format issues
+    assert 'rgb (255, 87, 51)' != IsColor('rgb')
+    assert 'rgb(255 87 51)' != IsColor('rgb')
+    assert 'rgba(255, 87, 51)' != IsColor('rgb')
+    assert '' != IsColor('rgb')
+
+    # leading zeros
+    assert 'rgb(000, 000, 000)' == IsColor('rgb')
+    assert 'rgb(255, 087, 051)' == IsColor('rgb')
+
+
+def test_is_color_hsl():
+    """Test HSL color validation."""
+    # Valid HSL
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(0, 0%, 0%)' == IsColor('hsl')
+    assert 'hsl(360, 100%, 100%)' == IsColor('hsl')
+    assert 'hsl(180, 50%, 50%)' == IsColor('hsl')
+
+    # Valid HSL with deg suffix
+    assert 'hsl(14deg, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(0deg, 0%, 0%)' == IsColor('hsl')
+    assert 'hsl(360DEG, 100%, 100%)' == IsColor('hsl')
+    assert 'hsl(180Deg, 50%, 50%)' == IsColor('hsl')
+
+    # Case insensitive
+    assert 'HSL(14, 100%, 60%)' == IsColor('hsl')
+    assert 'Hsl(14, 100%, 60%)' == IsColor('hsl')
+
+    # Whitespace
+    assert 'hsl( 14 , 100% , 60% )' == IsColor('hsl')
+    assert 'hsl(14,100%,60%)' == IsColor('hsl')
+
+    # Invalid HSL - out of range
+    assert 'hsl(361, 100%, 60%)' != IsColor('hsl')
+    assert 'hsl(-1, 100%, 60%)' != IsColor('hsl')
+    assert 'hsl(14, 101%, 60%)' != IsColor('hsl')
+    assert 'hsl(14, 100%, 101%)' != IsColor('hsl')
+
+    # Invalid HSL - no percentage on saturation/lightness
+    assert 'hsl(14, 100, 60)' != IsColor('hsl')
+    assert 'hsl(14, 100%, 60)' != IsColor('hsl')
+
+    # Invalid HSL - space between number and deg
+    assert 'hsl(14 deg, 100%, 60%)' != IsColor('hsl')
+
+    # Invalid HSL - space between function and paren
+    assert 'hsl (14, 100%, 60%)' != IsColor('hsl')
+
+    # Invalid
+    assert '' != IsColor('hsl')
+
+
+def test_is_color_non_string():
+    """Test non-string values do not match."""
+    assert 123 != IsColor()
+    assert 123 != IsColor('hex')
+    assert 123 != IsColor('rgb')
+    assert 123 != IsColor('hsl')
+    assert None != IsColor()
+    assert [1, 2, 3] != IsColor()
+    assert {'color': '#ff5733'} != IsColor()
+
+
+def test_is_color_format_mismatch():
+    """Test that a valid color in one format doesn't match a different format constraint."""
+    assert '#FF5733' != IsColor('rgb')
+    assert '#FF5733' != IsColor('hsl')
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+    assert 'rgb(255, 87, 51)' != IsColor('hsl')
+    assert 'hsl(14, 100%, 60%)' != IsColor('hex')
+    assert 'hsl(14, 100%, 60%)' != IsColor('rgb')
+
+
+def test_is_color_invalid_format():
+    """Test that invalid format argument raises ValueError."""
+    import pytest
+    with pytest.raises(ValueError, match="Invalid format 'cmyk'"):
+        IsColor('cmyk')
+
+
+def test_is_color_edge_cases():
+    """Test edge cases."""
+    # Empty string
+    assert '' != IsColor()
+    assert '' != IsColor('hex')
+    assert '' != IsColor('rgb')
+    assert '' != IsColor('hsl')
+
+    # Only whitespace
+    assert '   ' != IsColor()
+    assert '   ' != IsColor('hex')
+
+    # Hex edge cases
+    assert '#000' == IsColor('hex')
+    assert '#000000' == IsColor('hex')
+    assert '000' == IsColor('hex')
+    assert 'FFf' == IsColor('hex')
+    assert 'aAbBcC' == IsColor('hex')
+
+    # Malformed hex
+    assert '#abcd' != IsColor('hex')  # 4 digits
+    assert '#12345' != IsColor('hex')  # 5 digits
+
+    # RGB leading zeros
+    assert 'rgb(0, 0, 0)' == IsColor('rgb')
+    assert 'rgb(00, 00, 00)' == IsColor('rgb')
+    assert 'rgb(000, 000, 000)' == IsColor('rgb')
+    assert 'rgb(001, 001, 001)' == IsColor('rgb')
+
+    # RGB percentages with leading zeros
+    assert 'rgb(00%, 00%, 00%)' == IsColor('rgb')
+    assert 'rgb(100%, 100%, 100%)' == IsColor('rgb')
+
+    # Invalid - no fraction
+    assert 'rgb(1.5, 0, 0)' != IsColor('rgb')
+
+    # Invalid - no signs
+    assert 'rgb(+1, 0, 0)' != IsColor('rgb')
+    assert 'rgb(-1, 0, 0)' != IsColor('rgb')
+
+
+def test_is_color_with_whitespace_around_value():
+    """Test that whitespace around the complete value is allowed."""
+    assert '  #FF5733' == IsColor()
+    assert '#FF5733  ' == IsColor()
+    assert '  #FF5733  ' == IsColor()
+    assert '  rgb(255, 87, 51)  ' == IsColor()
+    assert '  hsl(14, 100%, 60%)  ' == IsColor()
