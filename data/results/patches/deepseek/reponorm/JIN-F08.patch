diff --git a/tests/test_async_filters.py b/tests/test_async_filters.py
index 5d4f332..0af071f 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -251,3 +251,34 @@ def test_custom_async_iteratable_filter(env_async, items):
     )
     out = tmpl.render(items=items)
     assert out == "0,1,2 .. 3,4,5"
+
+
+@mark_dualiter("items", lambda: [{"foo": 1, "bar": 2}, {"foo": 2, "bar": 3}, {"foo": 1, "bar": 1}, {"foo": 3, "bar": 4}])
+def test_groupby_with_counts(env_async, items):
+    tmpl = env_async.from_string(
+        "{%- for grouper, items, count in items()|groupby('foo', with_counts=True) -%}"
+        "{{ grouper }}:{{ count }}|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items).split("|") == ["1:2", "2:1", "3:1", ""]
+
+
+@mark_dualiter("items", lambda: [("a", 1), ("a", 2), ("b", 1)])
+def test_groupby_with_counts_tuple_index(env_async, items):
+    tmpl = env_async.from_string(
+        "{%- for group in items()|groupby(0, with_counts=True) -%}"
+        "{{ group[0] }}:{{ group[2] }}|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items) == "a:2|b:1|"
+
+
+@mark_dualiter("items", lambda: [])
+def test_groupby_with_counts_empty(env_async, items):
+    tmpl = env_async.from_string(
+        "{%- for group in items()|groupby('foo', with_counts=True) -%}"
+        "{{ group.grouper }}|"
+        "{%- else -%}empty|"
+        "{%- endfor %}"
+    )
+    assert tmpl.render(items=items) == "empty|"
diff --git a/tests/test_filters.py b/tests/test_filters.py
index 43ddf59..5ef9077 100644
--- a/tests/test_filters.py
+++ b/tests/test_filters.py
@@ -852,3 +852,56 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+    def test_groupby_with_counts(self, env):
+        tmpl = env.from_string(
+            "{%- for grouper, items, count in [{'foo': 1, 'bar': 2},"
+            "{'foo': 2, 'bar': 3},"
+            "{'foo': 1, 'bar': 1},"
+            "{'foo': 3, 'bar': 4}]|groupby('foo', with_counts=True) -%}"
+            "{{ grouper }}:{{ count }}|"
+            "{%- endfor %}"
+        )
+        assert tmpl.render().split("|") == ["1:2", "2:1", "3:1", ""]
+
+    def test_groupby_with_counts_attr(self, env):
+        tmpl = env.from_string(
+            "{%- for group in [{'foo': 1, 'bar': 2},"
+            "{'foo': 2, 'bar': 3},"
+            "{'foo': 1, 'bar': 1}]|groupby('foo', with_counts=True) -%}"
+            "{{ group.grouper }}:{{ group.count }}|"
+            "{%- endfor %}"
+        )
+        assert tmpl.render().split("|") == ["1:2", "2:1", ""]
+
+    def test_groupby_with_counts_tuple_index(self, env):
+        tmpl = env.from_string(
+            "{%- for group in [('a', 1), ('a', 2), ('b', 1)]|groupby(0, with_counts=True) -%}"
+            "{{ group[0] }}:{{ group[2] }}|"
+            "{%- endfor %}"
+        )
+        assert tmpl.render() == "a:2|b:1|"
+
+    def test_groupby_with_counts_empty(self, env):
+        tmpl = env.from_string(
+            "{%- for group in []|groupby('foo', with_counts=True) -%}"
+            "{{ group.grouper }}|"
+            "{%- else -%}empty|"
+            "{%- endfor %}"
+        )
+        assert tmpl.render() == "empty|"
+
+    def test_groupby_with_counts_default(self, env):
+        tmpl = env.from_string(
+            "{% for city, items, cnt in users|groupby('city', default='NY', with_counts=True) %}"
+            "{{ city }}:{{ cnt }} "
+            "{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "emma", "city": "NY"},
+                {"name": "smith", "city": "WA"},
+                {"name": "john"},
+            ]
+        )
+        assert out == "NY:2 WA:1 "
