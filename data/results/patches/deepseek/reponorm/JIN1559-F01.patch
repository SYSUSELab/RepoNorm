+    def test_extract_trans_block_context(self):
+        from jinja2.ext import babel_extract
+
+        source = BytesIO(
+            b"""
+            {% trans "babel" %}Hello World{% endtrans %}
+            {% trans "babel" count=users %}{{ users }} user{% pluralize %}{{ users }} users{% endtrans %}
+            """
+        )
+        assert list(babel_extract(source, ("pgettext", "npgettext", "_"), [], {})) == [
+            (2, "pgettext", ("babel", "Hello World"), []),
+            (3, "npgettext", ("babel", "%(users)s user", "%(users)s users", None), []),
+        ]
+
