+    def test_groupby_hierarchical(self, env):
+        """Test hierarchical groupby with levels parameter."""
+        tmpl = env.from_string(
+            '{% for dep, role_groups in items|groupby([\'department\', \'role\'], levels=2) %}'
+            '{{ dep }}:'
+            '{% for role, users in role_groups %}'
+            '{{ role }}({{ users|map(attribute=\'name\')|join(\',\') }})'
+            '{% endfor %}|'
+            '{% endfor %}'
+        )
+        out = tmpl.render(
+            items=[
+                {"name": "alice", "department": "eng", "role": "dev"},
+                {"name": "bob", "department": "eng", "role": "dev"},
+                {"name": "charlie", "department": "eng", "role": "manager"},
+                {"name": "dave", "department": "sales", "role": "lead"},
+            ]
+        )
+        assert out == "eng:dev(alice,bob)manager(charlie)|sales:lead(dave)|"
+
+    def test_groupby_hierarchical_comma(self, env):
+        """Test hierarchical groupby with comma-separated string."""
+        tmpl = env.from_string(
+            '{% for dep, role_groups in items|groupby(\'department , role\', levels=2) %}'
+            '{{ dep }}:'
+            '{% for role, users in role_groups %}'
+            '{{ role }}({{ users|map(attribute=\'name\')|join(\',\') }})'
+            '{% endfor %}|'
+            '{% endfor %}'
+        )
+        out = tmpl.render(
+            items=[
+                {"name": "alice", "department": "eng", "role": "dev"},
+                {"name": "bob", "department": "eng", "role": "dev"},
+                {"name": "charlie", "department": "eng", "role": "manager"},
+                {"name": "dave", "department": "sales", "role": "lead"},
+            ]
+        )
+        assert out == "eng:dev(alice,bob)manager(charlie)|sales:lead(dave)|"
+
+    def test_groupby_one_element_list(self, env):
+        """Test one-element attribute list without levels."""
