+            '{{ city }}:{{ items|map(attribute=\'name\')|join(\',\') }}|'
+            '{% endfor %}'
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "alice", "city": "NY"},
+                {"name": "bob", "city": "NY"},
+                {"name": "charlie", "city": "LA"},
+            ]
+        )
+        assert out == "LA:charlie|NY:alice,bob|"
+
