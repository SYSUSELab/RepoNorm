+def test_compress():
+    """Test the compress parameter for encode()."""
+    enc = tiktoken.get_encoding("cl100k_base")
+
+    # Compress collapses adjacent repeated tokens
+    # "a a a" -> [64, 264, 264] -> compress -> [64, 264]
+    assert enc.encode("a a a", compress=True) == [64, 264]
+
+    # Long runs collapse to single token
+    assert enc.encode("a a a a", compress=True) == [64, 264]
+
+    # No repeats: same as without compress
+    assert enc.encode("hello world", compress=True) == [15339, 1917]
+
+    # Empty string
+    assert enc.encode("", compress=True) == []
+
+    # Single token
+    assert enc.encode("a", compress=True) == [64]
+
+    # Repeats with different token in between preserved
+    assert enc.encode("a a b a a", compress=True) == [64, 264, 293, 264]
+
+    # Default compress=False preserves existing behavior
+    assert enc.encode("a a a") == [64, 264, 264]
+    assert enc.encode("a a a", compress=False) == [64, 264, 264]
+
+    # Works with other encoding
+    enc2 = tiktoken.get_encoding("r50k_base")
+    assert enc2.encode("a a a", compress=True) == [64, 257]
+
 def test_basic_encode():
