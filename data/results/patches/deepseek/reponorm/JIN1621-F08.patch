+    def test_add_filter_re_str(self):
+        """A string passed to add_filter is treated as glob, not regex."""
+        loader = loaders.DictLoader({
+            "test.html": "test",
+            "xest.html": "xest",
+        })
+        loader.add_filter("test.html")
+        result = loader.list_templates()
+        # Glob matching: ? matches any single char, * matches any sequence
+        assert "test.html" not in result
+        assert "xest.html" in result
