+    def _validate_filter(self, filter_pattern: t.Any) -> None:
+        """Validate a filter pattern.  Raises TypeError for unsupported types."""
+        if isinstance(filter_pattern, str):
+            return
+        if isinstance(filter_pattern, (t.Pattern,)):
+            return
+        if callable(filter_pattern):
+            return
+        raise TypeError(
+            f"Unsupported filter type {type(filter_pattern).__name__!r}: must be a string, "
+            f"compiled regex, or callable"
+        )
+
+    def _filter_matches(self, name: str, filter_pattern: t.Any) -> bool:
+        """Check if a template name matches a single filter pattern."""
+        if isinstance(filter_pattern, str):
+            return fnmatch.fnmatch(name, filter_pattern)
+        if isinstance(filter_pattern, (t.Pattern,)):
+            return bool(filter_pattern.search(name))
+        if callable(filter_pattern):
+            return bool(filter_pattern(name))
+        # Should not reach here if _validate_filter was called
+        raise TypeError(
+            f"Unsupported filter type {type(filter_pattern).__name__!r}"
+        )
+
+    def _filter_template_names(self, names: t.List[str]) -> t.List[str]:
+        """Apply all registered filters and return filtered list."""
+        filters = self._get_filters()
+        if not filters:
+            return names
+        result: t.List[str] = []
+        for name in names:
+            excluded = False
+            for filter_pattern in filters:
+                if self._filter_matches(name, filter_pattern):
+                    excluded = True
+                    break
+            if not excluded:
+                result.append(name)
+        return result
+
+    def _get_filters(self) -> t.List[t.Any]:
+        """Get the list of registered filters."""
+        try:
+            return self._filters
+        except AttributeError:
+            self._filters = []
+            return self._filters
+
+    def add_filter(self, filter_pattern: t.Any) -> None:
+        """Register a filter pattern to exclude templates from list_templates.
+        
+        A filter can be:
+        - A string for case-sensitive glob matching
+        - A compiled regex pattern (``re.Pattern``) using ``search``
+        - A callable that receives the template name and returns truthy to exclude
+        
+        Raises TypeError if the pattern is not a supported type.
+        """
+        self._validate_filter(filter_pattern)
+        self._get_filters().append(filter_pattern)
+
+    def clear_filters(self) -> None:
+        """Remove all registered filters."""
+        self._get_filters().clear()
+
+    @contextmanager
+    def filter_scope(self, *patterns: t.Any) -> t.Iterator[None]:
+        """Context manager that temporarily adds filters.
+        
+        Filters are added via ``add_filter`` on entry and the previous filter
+        configuration is restored on exit, even if an exception occurs.
+        Scopes may be nested.
+        """
+        saved_filters = list(self._get_filters())
+        try:
+            for pattern in patterns:
+                self.add_filter(pattern)
+            yield
+        finally:
+            self._filters = saved_filters
+
