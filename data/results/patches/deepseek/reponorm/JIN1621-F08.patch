+    def test_add_filter_pattern_str(self):
+        """Compiled regex uses search, not match."""
+        loader = loaders.DictLoader({
+            "foo/bar.html": "fb",
+            "/foo/bar.html": "fb2",
+            "bar.html": "b",
+        })
+        import re
+        # This regex should match names containing "foo"
+        loader.add_filter(re.compile("foo"))
+        result = loader.list_templates()
+        assert "foo/bar.html" not in result
+        assert "/foo/bar.html" not in result
+        assert "bar.html" in result
