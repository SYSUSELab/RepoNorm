+class TestLoaderFilters:
+    """Tests for loader persistent filters (add_filter, clear_filters, filter_scope)."""
+
+    def test_add_filter_string_glob(self, dict_loader):
+        """String filter uses case-sensitive glob matching."""
+        # Start with a loader that has multiple templates
+        loader = loaders.DictLoader({
+            "foo.html": "foo",
+            "bar.html": "bar",
+            "foo/bar.html": "foobar",
+        })
+        assert "foo.html" in loader.list_templates()
+        loader.add_filter("*.html")
+        # All match *.html, so nothing returned
+        assert loader.list_templates() == []
+
+    def test_add_filter_string_specific(self, dict_loader):
+        loader = loaders.DictLoader({
+            "include/header.html": "header",
+            "include/footer.html": "footer",
+            "index.html": "index",
+        })
+        loader.add_filter("include/*")
+        result = loader.list_templates()
+        assert "include/header.html" not in result
+        assert "include/footer.html" not in result
+        assert "index.html" in result
+
+    def test_add_filter_compiled_regex(self, dict_loader):
+        loader = loaders.DictLoader({
+            "test.html": "test",
+            "Test.html": "Test",
+            "other.html": "other",
+        })
+        import re
+        loader.add_filter(re.compile("^[Tt]est"))
+        result = loader.list_templates()
+        assert "test.html" not in result
+        assert "Test.html" not in result
+        assert "other.html" in result
+
+    def test_add_filter_callable(self, dict_loader):
+        loader = loaders.DictLoader({
+            "a.html": "a",
+            "bb.html": "bb",
+            "ccc.html": "ccc",
+        })
+        loader.add_filter(lambda name: name == "bb.html")
+        result = loader.list_templates()
+        assert "a.html" in result
+        assert "bb.html" not in result
+        assert "ccc.html" in result
+
+    def test_add_filter_unsupported_type_raises_typeerror(self, dict_loader):
+        loader = loaders.DictLoader({"x.html": "x"})
+        with pytest.raises(TypeError, match="Unsupported filter type"):
+            loader.add_filter(42)
+        with pytest.raises(TypeError, match="Unsupported filter type"):
+            loader.add_filter(None)
+        with pytest.raises(TypeError, match="Unsupported filter type"):
+            loader.add_filter([".html"])
+
+    def test_callable_exception_propagates(self, dict_loader):
+        loader = loaders.DictLoader({"x.html": "x"})
+        loader.add_filter(lambda name: 1 / 0)
+        with pytest.raises(ZeroDivisionError):
+            loader.list_templates()
+
+    def test_filters_persist(self, dict_loader):
+        loader = loaders.DictLoader({"a.html": "a", "b.html": "b"})
+        loader.add_filter("a.html")
+        assert "a.html" not in loader.list_templates()
+        assert "b.html" in loader.list_templates()
+        # Filter persists across calls
+        assert "a.html" not in loader.list_templates()
+
+    def test_clear_filters(self, dict_loader):
+        loader = loaders.DictLoader({"a.html": "a", "b.html": "b"})
+        loader.add_filter("a.html")
+        assert len(loader.list_templates()) == 1
+        loader.clear_filters()
+        assert len(loader.list_templates()) == 2
+
+    def test_filtered_name_still_loadable(self, dict_loader):
+        loader = loaders.DictLoader({"secret.html": "secret", "public.html": "public"})
+        env = Environment(loader=loader)
+        loader.add_filter("secret.html")
+        # Should not appear in listing
+        assert "secret.html" not in loader.list_templates()
+        # But still directly loadable
+        tmpl = env.get_template("secret.html")
+        assert tmpl.render() == "secret"
+
+    def test_multiple_filters(self, dict_loader):
+        loader = loaders.DictLoader({
+            "a.html": "a",
+            "b.html": "b",
+            "c.html": "c",
+        })
+        loader.add_filter("a.html")
+        loader.add_filter("b.html")
+        result = loader.list_templates()
+        assert "a.html" not in result
+        assert "b.html" not in result
+        assert "c.html" in result
+
+    def test_filter_scope_basic(self, dict_loader):
+        loader = loaders.DictLoader({
+            "visible.html": "visible",
+            "hidden.html": "hidden",
+        })
+        with loader.filter_scope("hidden.html"):
+            assert "hidden.html" not in loader.list_templates()
+            assert "visible.html" in loader.list_templates()
+        # After scope exit, filters are restored
+        assert "hidden.html" in loader.list_templates()
+        assert "visible.html" in loader.list_templates()
+
+    def test_filter_scope_nesting(self, dict_loader):
+        loader = loaders.DictLoader({
+            "a.html": "a",
+            "b.html": "b",
+            "c.html": "c",
+        })
+        loader.add_filter("a.html")
+        with loader.filter_scope("b.html"):
+            assert "a.html" not in loader.list_templates()
+            assert "b.html" not in loader.list_templates()
+            assert "c.html" in loader.list_templates()
+            with loader.filter_scope("c.html"):
+                assert len(loader.list_templates()) == 0
+            # Inner scope restored, b.html still filtered
+            assert "b.html" not in loader.list_templates()
+            assert "c.html" in loader.list_templates()
+        # Outer scope restored, only a.html still filtered
+        assert "a.html" not in loader.list_templates()
+        assert "b.html" in loader.list_templates()
+
+    def test_filter_scope_exception_safety(self, dict_loader):
+        loader = loaders.DictLoader({"x.html": "x"})
+        loader.add_filter("x.html")
+        try:
+            with loader.filter_scope():
+                assert "x.html" not in loader.list_templates()
+                raise ValueError("oops")
+        except ValueError:
+            pass
+        # Filter state restored even after exception
+        assert "x.html" not in loader.list_templates()
+
+    def test_filter_scope_no_patterns(self, dict_loader):
+        """filter_scope with no arguments does nothing but saves/restores."""
+        loader = loaders.DictLoader({"x.html": "x"})
+        loader.add_filter("x.html")
+        with loader.filter_scope():
+            assert "x.html" not in loader.list_templates()
+        assert "x.html" not in loader.list_templates()
+
+    def test_filesystem_loader_filters(self, filesystem_loader):
+        """FileSystemLoader applies filters to its template list."""
+        loader = filesystem_loader
+        all_templates = loader.list_templates()
+        loader.add_filter("*.html")
+        filtered = loader.list_templates()
+        assert len(filtered) < len(all_templates) or len(filtered) == 0
+
+    def test_package_loader_filters(self, package_loader):
+        """PackageLoader applies filters to its template list."""
+        loader = package_loader
+        original = set(loader.list_templates())
+        loader.add_filter("test.html")
+        filtered = loader.list_templates()
+        assert "test.html" not in filtered
+        assert original - {"test.html"} == set(filtered)
+        loader.clear_filters()
+        assert set(loader.list_templates()) == original
+
+    def test_choice_loader_applies_own_filters(self, dict_loader, package_loader):
+        """ChoiceLoader applies its own filters to the combined list."""
+        loader = loaders.ChoiceLoader([dict_loader, package_loader])
+        original = set(loader.list_templates())
+        # Filter out justdict.html from the combined result
+        loader.add_filter("justdict.html")
+        filtered = loader.list_templates()
+        assert "justdict.html" not in filtered
+        assert original - {"justdict.html"} == set(filtered)
+
+    def test_prefix_loader_applies_own_filters(self, filesystem_loader, dict_loader):
+        """PrefixLoader applies its own filters to the prefixed list."""
+        loader = loaders.PrefixLoader({"a": filesystem_loader, "b": dict_loader})
+        original = set(loader.list_templates())
+        loader.add_filter("b/*")
+        filtered = loader.list_templates()
+        for name in filtered:
+            assert not name.startswith("b/")
+        for name in original:
+            if name.startswith("b/"):
+                assert name not in filtered
+            else:
+                assert name in filtered
+
+    def test_child_filters_affect_composite(self, dict_loader):
+        """Filters on a child loader affect the composite loader's listing."""
+        child = loaders.DictLoader({
+            "a.html": "a",
+            "b.html": "b",
+        })
+        parent = loaders.ChoiceLoader([child])
+        original = set(parent.list_templates())
+        child.add_filter("a.html")
+        assert "a.html" not in parent.list_templates()
+        child.clear_filters()
+        assert set(parent.list_templates()) == original
+
+    def test_prefix_child_filters(self, dict_loader):
+        """Filters on the dict child of a PrefixLoader affect prefixes."""
+        child = loaders.DictLoader({
+            "common.html": "common",
+            "special.html": "special",
+        })
