+
+
+def test_groupby_key_transform_markup(env_async):
+    """Returned Markup is not auto-escaped; plain string is escaped, async mode."""
+    myenv = Environment(enable_async=True, autoescape=True)
+    tmpl = myenv.from_string(
+        "{%- for grouper, list in items|groupby('val', key_transform=kt) %}"
+        "{{ grouper }}|"
+        "{%- endfor %}"
