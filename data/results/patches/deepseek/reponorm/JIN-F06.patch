+def test_groupby_key_transform_collision(env_async, items):
+    """Same display key from different groups does not merge them in async mode."""
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('val', key_transform=kt) %}"
+        "{{ grouper }}{% for x in list %}:{{ x.val }}{% endfor %}|"
+        "{%- endfor %}"
+    )
+    out = tmpl.render(items=items, kt=lambda v: 'same')
+    assert out == "same:1|same:2|"
+
+
+@mark_dualiter("items", lambda: [])
+def test_groupby_key_transform_empty(env_async, items):
+    """Empty input calls no callback in async mode."""
