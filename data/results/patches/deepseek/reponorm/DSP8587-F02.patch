diff --git a/tests/streaming/test_streaming.py b/tests/streaming/test_streaming.py
index fe67bd6d..029e72ee 100644
--- a/tests/streaming/test_streaming.py
+++ b/tests/streaming/test_streaming.py
@@ -837,3 +837,72 @@ async def test_stream_listener_returns_correct_chunk_xml_adapter():
     assert all_chunks[1].predict_name == "predict2"
     assert all_chunks[1].signature_field_name == "judgement"
     assert all_chunks[1].chunk == "The answer is humorous."
+
+
+# ----- end_buffer_size validation -----
+
+
+def test_end_buffer_size_default():
+    """Default end_buffer_size should be 10."""
+    listener = dspy.streaming.StreamListener("output")
+    assert listener.end_buffer_size == 10
+
+
+def test_end_buffer_size_valid_values():
+    """Boundary values 3 and 64 should work."""
+    listener = dspy.streaming.StreamListener("output", end_buffer_size=3)
+    assert listener.end_buffer_size == 3
+
+    listener = dspy.streaming.StreamListener("output", end_buffer_size=64)
+    assert listener.end_buffer_size == 64
+
+    listener = dspy.streaming.StreamListener("output", end_buffer_size=20)
+    assert listener.end_buffer_size == 20
+
+
+def test_end_buffer_size_non_integer():
+    """Non-integer values (including bool) must raise ValueError."""
+    with pytest.raises(ValueError, match="end_buffer_size must be an integer"):
+        dspy.streaming.StreamListener("output", end_buffer_size="abc")
+    with pytest.raises(ValueError, match="end_buffer_size must be an integer"):
+        dspy.streaming.StreamListener("output", end_buffer_size=3.5)
+    with pytest.raises(ValueError, match="end_buffer_size must be an integer"):
+        dspy.streaming.StreamListener("output", end_buffer_size=True)
+
+
+def test_end_buffer_size_below_3():
+    """Values below 3 must raise ValueError."""
+    with pytest.raises(ValueError, match="end_buffer_size must be at least 3"):
+        dspy.streaming.StreamListener("output", end_buffer_size=2)
+    with pytest.raises(ValueError, match="end_buffer_size must be at least 3"):
+        dspy.streaming.StreamListener("output", end_buffer_size=1)
+    with pytest.raises(ValueError, match="end_buffer_size must be at least 3"):
+        dspy.streaming.StreamListener("output", end_buffer_size=0)
+    with pytest.raises(ValueError, match="end_buffer_size must be at least 3"):
+        dspy.streaming.StreamListener("output", end_buffer_size=-1)
+
+
+def test_end_buffer_size_above_64():
+    """Values above 64 must raise ValueError."""
+    with pytest.raises(ValueError, match="end_buffer_size must be at most 64"):
+        dspy.streaming.StreamListener("output", end_buffer_size=65)
+    with pytest.raises(ValueError, match="end_buffer_size must be at most 64"):
+        dspy.streaming.StreamListener("output", end_buffer_size=100)
+
+
+# ----- buffer_watermark on StreamResponse -----
+
+
+def test_stream_response_buffer_watermark_default():
+    """Default buffer_watermark should be 0."""
+    resp = dspy.streaming.StreamResponse("predict1", "answer", "hello")
+    assert resp.buffer_watermark == 0
+
+
+def test_stream_response_buffer_watermark_explicit():
+    """buffer_watermark can be set explicitly."""
+    resp = dspy.streaming.StreamResponse("predict1", "answer", "hello", buffer_watermark=5)
+    assert resp.buffer_watermark == 5
+
+    resp = dspy.streaming.StreamResponse("predict1", "answer", "hello", buffer_watermark=10)
+    assert resp.buffer_watermark == 10
