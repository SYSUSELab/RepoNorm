+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_lock_file(tmp_path):
+    """Lock file is created and removed when editing a direct filename."""
+    fname = tmp_path / "test.txt"
+    fname.write_text("hello\n")
+    lockpath = tmp_path / ".test.txt.lock"
+
+    result = click.edit(
+        filename=str(fname), editor="sed -i~ 's/hello/world/'", lock_files=True
+    )
+    assert result is None  # filename form returns None
+    assert not lockpath.exists(), "Lock file should be removed after edit"
+    assert fname.read_text() == "world\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_lock_existing(tmp_path):
+    """Existing lock file raises ClickException with lock info."""
+    fname = tmp_path / "test.txt"
+    fname.write_text("hello\n")
+    lockpath = tmp_path / ".test.txt.lock"
+    lockpath.write_text("PID: 9999\nTime: 2024-01-01T00:00:00\n")
+
+    with pytest.raises(click.ClickException) as excinfo:
+        click.edit(
+            filename=str(fname), editor="sed -i~ 's/hello/world/'", lock_files=True
+        )
+    msg = str(excinfo.value)
+    assert str(lockpath) in msg
+    assert "PID: 9999" in msg
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_lock_removed_on_failure(tmp_path):
+    """Lock file is removed even when editor exits with non-zero status."""
+    fname = tmp_path / "test.txt"
+    fname.write_text("content\n")
+    lockpath = tmp_path / ".test.txt.lock"
+
+    with pytest.raises(click.ClickException):
+        click.edit(filename=str(fname), editor="false", lock_files=True)
+
+    assert not lockpath.exists(), "Lock should be removed after editor failure"
+
+
