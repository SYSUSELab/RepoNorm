+def _acquire_edit_lock(filename: str) -> str:
+    """Atomically create a lock file for the given *filename*.
+
+    Returns the path to the lock file.
+
+    Raises :exc:`ClickException` if the lock already exists or if
+    creation fails for another reason.
+    """
+    lockpath = os.path.join(
+        os.path.dirname(filename) or ".",
+        f".{os.path.basename(filename)}.lock",
+    )
+
+    try:
+        fd = os.open(lockpath, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+    except OSError as e:
+        if e.errno == errno.EEXIST:
+            _raise_lock_exists(lockpath)
+        raise ClickException(
+            _("Failed to create lock file: {path}").format(path=lockpath)
+        ) from e
+
+    try:
+        now = datetime.datetime.now(datetime.timezone.utc)
+        content = f"PID: {os.getpid()}\nTime: {now.isoformat()}\n"
+        with os.fdopen(fd, "w") as f:
+            f.write(content)
+    except OSError as e:
+        # Clean up the lock file we just created
+        try:
+            os.unlink(lockpath)
+        except OSError:
+            pass
+        raise ClickException(
+            _("Failed to write lock file: {path}").format(path=lockpath)
+        ) from e
+
+    return lockpath
+
+
+def _raise_lock_exists(lockpath: str) -> None:
+    """Read lock info and raise :exc:`ClickException`."""
+    try:
+        with open(lockpath, "r", encoding="utf-8") as f:
+            content = f.read()
+    except OSError:
+        raise ClickException(
+            _("Lock file exists: {path}").format(path=lockpath)
+        )
+
+    raise ClickException(
+        _("Lock file exists: {path}\n{content}").format(
+            path=lockpath, content=content
+        )
+    )
+
+
+def _release_edit_lock(lockpath: str) -> None:
+    """Remove the lock file at *lockpath*.
+
+    Raises :exc:`ClickException` on failure, chaining the original
+    :exc:`OSError`.
+    """
+    try:
+        os.unlink(lockpath)
+    except OSError as e:
+        raise ClickException(
+            _("Failed to remove lock file: {path}").format(path=lockpath)
+        ) from e
+
