+def test_edit_lock_default_false(tmp_path):
+    """Default lock_files=False preserves existing behavior."""
+    fname = tmp_path / "test.txt"
+    fname.write_text("hello\n")
+
+    # Even if a .lock file exists, lock_files=False ignores it
+    lockpath = tmp_path / ".test.txt.lock"
+    lockpath.write_text("PID: 9999\nTime: 2024-01-01T00:00:00\n")
+
+    # With lock_files=False (default), no lock is acquired,
+    # so editing should succeed even though a stale lock exists
+    result = click.edit(
+        filename=str(fname),
+        editor="sed -i~ 's/hello/world/'",
+    )
+    assert result is None
+    assert fname.read_text() == "world\n"
+
+
+def test_edit_lock_different_directories(tmp_path):
+    """Same basenames in different directories have independent locks."""
+    dir1 = tmp_path / "dir1"
+    dir2 = tmp_path / "dir2"
+    dir1.mkdir()
+    dir2.mkdir()
+    fname1 = dir1 / "shared.txt"
+    fname2 = dir2 / "shared.txt"
+    fname1.write_text("a\n")
+    fname2.write_text("b\n")
+
+    lock1 = dir1 / ".shared.txt.lock"
+    lock2 = dir2 / ".shared.txt.lock"
+
+    # Lock dir1 only
+    lock1.write_text("PID: 9999\nTime: 2024-01-01T00:00:00\n")
+
+    # Editing dir2 should succeed despite lock in dir1
+    result = click.edit(
+        filename=str(fname2),
+        editor="sed -i~ 's/b/c/'",
+        lock_files=True,
+    )
+    assert result is None
+    assert fname2.read_text() == "c\n"
+    assert not lock2.exists(), "Lock in dir2 should be cleaned up"
+    assert lock1.exists(), "Lock in dir1 should still exist (independent)"
+
+    lock1.unlink()
+
