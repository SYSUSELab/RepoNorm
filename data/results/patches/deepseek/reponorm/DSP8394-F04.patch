+# ── Per-call cache usage tracking ─────────────────────────────────────────────
+
+import dspy
+
+
+def _clean_test_cache():
+    """Disable disk cache and clear memory cache for test isolation."""
+    import dspy
+    dspy.cache.enable_disk_cache = False
+    dspy.cache.memory_cache.clear()
+
+
+class _CacheTestModule(dspy.Module):
+    """A minimal module that exercises dspy.cache in forward()."""
+
+    def forward(self, key_suffix: str = ""):
+        import dspy
+        request = {"_fn_identifier": "test.fn", "prompt": f"input_{key_suffix}"}
+        result = dspy.cache.get(request)
+        if result is None:
+            dspy.cache.put(request, "computed")
+            result = dspy.cache.get(request)
+        return dspy.Prediction(result=result)
+
+
+def test_get_cache_usage_is_none_when_tracking_off():
+    """Without track_usage, Prediction.get_cache_usage() returns None."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=False)
+    module = _CacheTestModule()
+    prediction = module(key_suffix="off")
+    assert prediction.get_cache_usage() is None
+
+
+def test_get_cache_usage_basic():
+    """Per-call snapshot records miss then hit correctly."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    with dspy.settings.context(track_usage=True):
+        module = _CacheTestModule()
+
+        # First call: miss + subsequent hit
+        prediction = module(key_suffix="basic1")
+        usage = prediction.get_cache_usage()
+        assert usage is not None
+        assert usage["misses"] >= 1   # at least one miss
+        assert usage["hits"] >= 1     # at least one hit (from re-get after put)
+        assert usage["hits"] == usage["mem_hits"] + usage["disk_hits"]
+
+        # Second call with same key: only hits
+        prediction2 = module(key_suffix="basic1")
+        usage2 = prediction2.get_cache_usage()
+        assert usage2 is not None
+        assert usage2["misses"] == 0
+        assert usage2["hits"] >= 1
+        assert usage2["hits"] == usage2["mem_hits"] + usage2["disk_hits"]
+
+        # Verify snapshots are independent
+        assert usage is not prediction.get_cache_usage()
+        assert usage["misses"] == 1  # first call unchanged
+
+
+def test_get_cache_usage_independent_of_global_stats():
+    """Per-call snapshot is isolated from cache.stats() and later calls."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    dspy.cache.reset_stats()
+
+    module = _CacheTestModule()
+    pred1 = module(key_suffix="indep1")
+    usage1 = pred1.get_cache_usage()
+
+    pred2 = module(key_suffix="indep1")
+    usage2 = pred2.get_cache_usage()
+
+    global_stats = dspy.cache.stats()
+
+    # Global stats accounts for all operations
+    assert global_stats["hits"] > 0
+    assert global_stats["misses"] > 0
+
+    # First call had 1 miss, at least 1 hit
+    assert usage1["misses"] >= 1
+    assert usage1["hits"] >= 1
+
+    # Second call had only hits (key already cached)
+    assert usage2["misses"] == 0
+    assert usage2["hits"] >= 1
+
+    # Later resets don't affect already-captured snapshot
+    dspy.cache.reset_stats()
+    assert pred1.get_cache_usage()["misses"] == usage1["misses"]
+
+
+def test_get_cache_usage_mutating_return_does_not_affect_prediction():
+    """Changing the returned dict does not mutate the stored snapshot."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    dspy.cache.reset_stats()
+
+    module = _CacheTestModule()
+    prediction = module(key_suffix="mutate")
+    usage = prediction.get_cache_usage()
+    original_misses = usage["misses"]
+    usage["misses"] = 9999
+    assert prediction.get_cache_usage()["misses"] == original_misses
+
+
+def test_get_cache_usage_nested_calls():
+    """A module that calls another module merges inner usage into its snapshot."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    dspy.cache.reset_stats()
+
+    class OuterModule(dspy.Module):
+        def __init__(self):
+            super().__init__()
+            self.inner = _CacheTestModule()
+
+        def forward(self, key_suffix: str = ""):
+            # Inner call generates cache events
+            inner_pred = self.inner(key_suffix=f"inner_{key_suffix}")
+            # Direct cache events in outer
+            request = {"_fn_identifier": "outer.fn", "prompt": f"outer_{key_suffix}"}
+            dspy.cache.get(request)  # miss
+            dspy.cache.put(request, "outer_val")
+            dspy.cache.get(request)  # hit
+            return dspy.Prediction(result=inner_pred.result)
+
+    outer = OuterModule()
+    prediction = outer(key_suffix="nested")
+    usage = prediction.get_cache_usage()
+    assert usage is not None
+    # Should include both inner and outer events
+    assert usage["misses"] >= 2  # inner miss + outer miss (first call)
+    assert usage["hits"] >= 2   # inner hit + outer hit
+    assert usage["hits"] == usage["mem_hits"] + usage["disk_hits"]
+
+
+def test_get_cache_usage_exception_restores_context():
+    """Exception during forward must restore the caller's tracking context."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    dspy.cache.reset_stats()
+
+    from dspy.clients.cache import _cache_context_var
+
+    # Set up a parent context
+    parent_ctx = {
+        "lock": __import__("threading").Lock(),
+        "counts": {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 5},
+    }
+    token = _cache_context_var.set(parent_ctx)
+
+    class FailingModule(dspy.Module):
+        def forward(self):
+            # This will trigger cache events before failing
+            request = {"_fn_identifier": "fail.fn", "prompt": "fail"}
+            dspy.cache.get(request)  # miss
+            raise ValueError("simulated failure")
+
+    mod = FailingModule()
+    try:
+        mod()
+    except ValueError:
+        pass
+
+    # After the exception, the parent context should be restored
+    restored = _cache_context_var.get()
+    assert restored is parent_ctx
+    # And the parent context should NOT have the failing module's events
+    # (because the finally block resets the token without merging)
+    assert restored["counts"]["misses"] == 5
+
+    _cache_context_var.reset(token)
+
+
+def test_get_cache_usage_multiple_calls_independent():
+    """Each call to the same module produces an independent snapshot."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    dspy.cache.reset_stats()
+
+    module = _CacheTestModule()
+    preds = [module(key_suffix="multi") for _ in range(3)]
+    usages = [p.get_cache_usage() for p in preds]
+
+    # First call: miss + hit
+    assert usages[0]["misses"] >= 1
+    assert usages[0]["hits"] >= 1
+
+    # Second and third calls: only hits
+    assert usages[1]["misses"] == 0
+    assert usages[1]["hits"] >= 1
+    assert usages[2]["misses"] == 0
+    assert usages[2]["hits"] >= 1
+
+
+def test_get_cache_usage_zero_counts():
+    """A module that makes no cache calls gets zero counts."""
+    _clean_test_cache()
+    dspy.settings.configure(track_usage=True)
+    dspy.cache.reset_stats()
+
+    class NoOpModule(dspy.Module):
+        def forward(self):
+            return dspy.Prediction(result=42)
+
+    mod = NoOpModule()
+    prediction = mod()
+    usage = prediction.get_cache_usage()
+    assert usage is not None
+    assert usage == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
