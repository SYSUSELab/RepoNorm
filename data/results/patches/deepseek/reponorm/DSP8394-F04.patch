+# ── Cache statistics ────────────────────────────────────────────────────────
+
+def test_stats_initial_state(cache):
+    """Stats start at zero."""
+    s = cache.stats()
+    assert s == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+
+
+def test_stats_miss_then_hit(cache):
+    """A miss increments misses; a subsequent hit increments hits and mem_hits."""
+    request = {"_fn_identifier": "test.fn", "prompt": "hello"}
+
+    # Miss
+    assert cache.get(request) is None
+    s = cache.stats()
+    assert s["misses"] == 1
+    assert s["hits"] == 0
+
+    # Put then get → hit
+    cache.put(request, "value")
+    assert cache.get(request) == "value"
+    s = cache.stats()
+    assert s["hits"] == 1
+    assert s["mem_hits"] == 1
+    assert s["misses"] == 1
+
+
+def test_stats_key_error_is_miss(cache):
+    """A cache-key generation failure counts as a miss."""
+    request = {"_fn_identifier": "test.fn", "bad": object()}  # not serialisable
+    assert cache.get(request) is None
+    s = cache.stats()
+    assert s["misses"] == 1
+    assert s["hits"] == 0
+
+
+def test_stats_reset(cache):
+    """reset_stats() clears counters without affecting entries."""
+    request = {"_fn_identifier": "test.fn", "prompt": "x"}
+    cache.get(request)  # miss
+    assert cache.stats()["misses"] == 1
+
+    cache.reset_stats()
+    s = cache.stats()
+    assert s == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+
+    # Cache entry still exists
+    cache.put(request, "val")
+    assert cache.get(request) == "val"
+    s = cache.stats()
+    assert s["hits"] == 1  # one new hit after reset
+
+
+def test_stats_return_is_copy(cache):
+    """Modifying a returned stats dict does not mutate internal counters."""
+    request = {"_fn_identifier": "test.fn", "prompt": "y"}
+    cache.get(request)  # miss
+    s = cache.stats()
+    s["misses"] = 999
+    assert cache.stats()["misses"] == 1
+
+
+def test_hits_equals_mem_hits_plus_disk_hits(cache):
+    """hits is always the sum of mem_hits and disk_hits."""
+    request = {"_fn_identifier": "test.fn", "prompt": "z"}
+    cache.get(request)  # miss
+    cache.put(request, "val")
+    cache.get(request)  # mem hit
+    s = cache.stats()
+    assert s["hits"] == s["mem_hits"] + s["disk_hits"]
+
+
+def test_stats_disk_hit(tmp_path):
+    """A disk hit increments disk_hits when memory cache misses."""
+    c = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=True,
+        disk_cache_dir=str(tmp_path),
+    )
+    request = {"_fn_identifier": "test.fn", "prompt": "disk_test"}
+    c.put(request, "disk_val")
+
+    # Pop memory cache but keep disk
+    c.reset_memory_cache()
+
+    val = c.get(request)
+    assert val == "disk_val"
+    s = c.stats()
+    assert s["disk_hits"] == 1
+    assert s["hits"] == 1
+    assert s["mem_hits"] == 0
+
+
+def test_stats_disk_hit_no_memory(tmp_path):
+    """Disk hits work correctly even when memory cache is disabled."""
+    c = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=False,
+        disk_cache_dir=str(tmp_path),
+    )
+    request = {"_fn_identifier": "test.fn", "prompt": "disk_only"}
+    c.put(request, "disk_val")
+
+    val = c.get(request)
+    assert val == "disk_val"
+    s = c.stats()
+    assert s["disk_hits"] == 1
+    assert s["hits"] == 1
+    assert s["mem_hits"] == 0
+
+
+def test_stats_concurrent_increment(cache):
+    """Concurrent gets safely increment counters."""
+    import concurrent.futures
+
+    request = {"_fn_identifier": "test.fn", "prompt": "concurrent"}
+    cache.put(request, "val")
+
+    def do_get():
+        cache.get(request)
+        return None
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+        list(pool.map(lambda _: do_get(), range(100)))
+
+    s = cache.stats()
+    assert s["hits"] == 100
+    assert s["mem_hits"] == 100
+    assert s["misses"] == 0
+
+
+def test_stats_concurrent_key_error(cache):
+    """Concurrent key-generation failures safely increment misses."""
+    import concurrent.futures
+
+    request = {"_fn_identifier": "test.fn", "bad": object()}
+
+    def do_get():
+        cache.get(request)
+        return None
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+        list(pool.map(lambda _: do_get(), range(100)))
+
+    assert cache.stats()["misses"] == 100
