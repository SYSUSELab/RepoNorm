+def test_octal_str():
+    """Test the octal_str predefined regex type."""
+    from outlines.types import octal_str
+
+    assert repr(octal_str) == "Regex(pattern='0o[0-7]+')"
+    assert octal_str.display_ascii_tree() == "└── Regex('0o[0-7]+')\n"
+
+    # Valid octal strings
+    assert octal_str.matches("0o0")
+    assert octal_str.matches("0o7")
+    assert octal_str.matches("0o12345670")
+    assert octal_str.matches("0o007")
+    assert octal_str.matches("0o000")
+
+    # Invalid: uppercase prefix
+    assert not octal_str.matches("0O0")
+    assert not octal_str.matches("0O")
+    assert not octal_str.matches("0O123")
+
+    # Invalid: prefix without digits
+    assert not octal_str.matches("0o")
+
+    # Invalid: digits 8 or 9
+    assert not octal_str.matches("0o8")
+    assert not octal_str.matches("0o9")
+    assert not octal_str.matches("0o1238")
+    assert not octal_str.matches("0o1239")
+
+    # Invalid: signs
+    assert not octal_str.matches("-0o1")
+    assert not octal_str.matches("+0o1")
+
+    # Invalid: underscores
+    assert not octal_str.matches("0o_1")
+    assert not octal_str.matches("0o1_2")
+
+    # Invalid: whitespace
+    assert not octal_str.matches("0o 1")
+    assert not octal_str.matches(" 0o1")
+    assert not octal_str.matches("0o1 ")
+
+    # Invalid: empty string
+    assert not octal_str.matches("")
+
+    # Invalid: unrelated strings
+    assert not octal_str.matches("hello")
+    assert not octal_str.matches("0x1")
+    assert not octal_str.matches("0b1")
