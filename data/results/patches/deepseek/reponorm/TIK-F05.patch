+
+
+# ====================
+# filter_tokens tests
+# ====================
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_none(make_enc: Callable[[], tiktoken.Encoding]):
+    """filter_tokens=None should not change output."""
+    enc = make_enc()
+    text = "hello world"
+    expected = enc.encode(text)
+    result = enc.encode(text, filter_tokens=None)
+    assert result == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_empty(make_enc: Callable[[], tiktoken.Encoding]):
+    """Empty filter_tokens should not change output."""
+    enc = make_enc()
+    text = "hello world"
+    expected = enc.encode(text)
+    for empty in (set(), [], ()):
+        result = enc.encode(text, filter_tokens=empty)
+        assert result == expected, f"filter_tokens={empty!r} changed output"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_remove_some(make_enc: Callable[[], tiktoken.Encoding]):
+    """Removing some tokens preserves order of remaining tokens."""
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text)
+    assert len(tokens) >= 2, "test requires at least 2 tokens"
+    # Remove the last token
+    removed_id = tokens[-1]
+    expected = tokens[:-1]
+    result = enc.encode(text, filter_tokens=[removed_id])
+    assert result == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_remove_all(make_enc: Callable[[], tiktoken.Encoding]):
+    """Removing all tokens returns an empty list/array."""
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text)
+    result = enc.encode(text, filter_tokens=tokens)
+    assert result == []
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_duplicates(make_enc: Callable[[], tiktoken.Encoding]):
+    """Duplicates in filter_tokens have no extra effect."""
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text)
+    assert len(tokens) >= 2
+    # Remove a single token, list with duplicates
+    removed_id = tokens[-1]
+    result_single = enc.encode(text, filter_tokens=[removed_id])
+    result_dupes = enc.encode(text, filter_tokens=[removed_id, removed_id, removed_id])
+    assert result_single == result_dupes
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_tuple_set(make_enc: Callable[[], tiktoken.Encoding]):
+    """filter_tokens works with tuple and set."""
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text)
+    assert len(tokens) >= 2
+    removed_id = tokens[-1]
+    result_list = enc.encode(text, filter_tokens=[removed_id])
+    result_tuple = enc.encode(text, filter_tokens=(removed_id,))
+    result_set = enc.encode(text, filter_tokens={removed_id})
+    assert result_list == result_tuple == result_set
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_no_mutation(make_enc: Callable[[], tiktoken.Encoding]):
+    """Caller's collection must not be mutated."""
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text)
+    assert len(tokens) >= 2
+    removed_id = tokens[-1]
+
+    original_list = [removed_id, tokens[0]]
+    original_list_copy = original_list.copy()
+    enc.encode(text, filter_tokens=original_list)
+    assert original_list == original_list_copy, "list was mutated"
+
+    original_set = {removed_id, tokens[0]}
+    original_set_copy = original_set.copy()
+    enc.encode(text, filter_tokens=original_set)
+    assert original_set == original_set_copy, "set was mutated"
+
+    original_tuple = (removed_id, tokens[0])
+    original_tuple_copy = original_tuple
+    enc.encode(text, filter_tokens=original_tuple)
+    assert original_tuple == original_tuple_copy, "tuple was mutated"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_disallowed_special_before_filter(make_enc: Callable[[], tiktoken.Encoding]):
+    """disallowed_special raises before filtering, even if the token ID would be removed."""
+    enc = make_enc()
+    # Pick a special token and encode it to get its ID
+    special_token = next(iter(enc.special_tokens_set))
+    special_id = enc.encode(special_token, allowed_special="all")[0]
+
+    with pytest.raises(ValueError, match="disallowed special token"):
+        enc.encode(special_token, filter_tokens=[special_id])
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_ordinary_special(make_enc: Callable[[], tiktoken.Encoding]):
+    """disallowed_special=() treats special literals as ordinary text, and filter_tokens can remove IDs."""
+    enc = make_enc()
+    special_token = next(iter(enc.special_tokens_set))
+
+    # With disallowed_special=(), the special literal is encoded as ordinary text
+    ordinary_tokens = enc.encode(special_token, disallowed_special=())
+    assert len(ordinary_tokens) > 0
+
+    # Filtering out all tokens from ordinary encoding should return empty
+    result = enc.encode(special_token, disallowed_special=(), filter_tokens=ordinary_tokens)
+    assert result == []
+
+    # Also verify that filter_tokens removes all tokens when used with filter_tokens=ordinary_tokens
+    result2 = enc.encode(special_token, disallowed_special=(), filter_tokens=ordinary_tokens)
+    assert result2 == []
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_consistency_with_numpy(make_enc: Callable[[], tiktoken.Encoding]):
+    """encode and encode_to_numpy produce the same values with the same filter_tokens."""
+    import numpy as np
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text)
+
+    for filter_tokens in [None, [], [tokens[-1]], tokens]:
+        list_result = enc.encode(text, filter_tokens=filter_tokens)
+        np_result = enc.encode_to_numpy(text, filter_tokens=filter_tokens)
+        assert list(list_result) == list(np_result), \
+            f"Mismatch for filter_tokens={filter_tokens!r}: {list_result} != {list(np_result)}"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_numpy_dtype(make_enc: Callable[[], tiktoken.Encoding]):
+    """NumPy results remain one-dimensional uint32 arrays."""
+    import numpy as np
+    enc = make_enc()
+
+    # Normal case
+    result = enc.encode_to_numpy("hello world", filter_tokens=[])
+    assert isinstance(result, np.ndarray)
+    assert result.dtype == np.uint32
+    assert result.ndim == 1
+
+    # All removed case
+    tokens = enc.encode("hello world")
+    result = enc.encode_to_numpy("hello world", filter_tokens=tokens)
+    assert isinstance(result, np.ndarray)
+    assert result.dtype == np.uint32
+    assert result.ndim == 1
+    assert len(result) == 0
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_filter_tokens_preserves_order(make_enc: Callable[[], tiktoken.Encoding]):
+    """Removing some tokens preserves remaining token order."""
+    enc = make_enc()
+    text = "a b c d e f g h i j"
+    tokens = enc.encode(text)
+    # Remove every other token
+    to_remove = tokens[1::2]
+    expected = tokens[0::2]
+    result = enc.encode(text, filter_tokens=to_remove)
+    assert result == expected
