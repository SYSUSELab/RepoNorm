+def test_file_option_resources_closed():
+    """Completion for a command with a ``File`` option must not leave the
+    file unclosed, producing a ``ResourceWarning`` after garbage collection.
+
+    The fix covers top-level commands, nested subcommands, and chained
+    command groups.
+    """
+    warnings.filterwarnings("error", category=ResourceWarning)
+
+    # -- top-level command with File option ----------------------------
+    cli = Command("cli", params=[Option(["-f"], type=File())])
+    comp = ShellComplete(cli, {}, cli.name, "_CLI_COMPLETE")
+
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        tmp_path = f.name
+        f.write("content")
+
+    try:
+        comp.get_completions(["-f", tmp_path], "")
+        gc.collect()
+    except ResourceWarning as e:
+        raise AssertionError(
+            f"ResourceWarning raised for top-level File option: {e}"
+        )
+    finally:
+        os.unlink(tmp_path)
+
+    # -- nested subcommand with File option ---------------------------
+    cli2 = Group("cli", commands=[Command("show", params=[Option(["-f"], type=File())])])
+    comp2 = ShellComplete(cli2, {}, cli2.name, "_CLI_COMPLETE")
+
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        tmp_path = f.name
+        f.write("content")
+
+    try:
+        comp2.get_completions(["show", "-f", tmp_path], "")
+        gc.collect()
+    except ResourceWarning as e:
+        raise AssertionError(
+            f"ResourceWarning raised for nested File option: {e}"
+        )
+    finally:
+        os.unlink(tmp_path)
+
+    # -- chained group with File options ------------------------------
+    cli3 = Group(
+        "cli",
+        chain=True,
+        commands=[
+            Command("proc", params=[Option(["-f"], type=File())]),
+            Command("filter", params=[Option(["-o"], type=File())]),
+        ],
+    )
+    comp3 = ShellComplete(cli3, {}, cli3.name, "_CLI_COMPLETE")
+
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        tmp_path1 = f.name
+        f.write("a")
+
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        tmp_path2 = f.name
+        f.write("b")
+
+    try:
+        comp3.get_completions(["proc", "-f", tmp_path1, "filter", "-o", tmp_path2], "")
+        gc.collect()
+    except ResourceWarning as e:
+        raise AssertionError(
+            f"ResourceWarning raised for chained group File option: {e}"
+        )
+    finally:
+        os.unlink(tmp_path1)
+        os.unlink(tmp_path2)
+
+    # -- repeated requests --------------------------------------------
+    cli4 = Command("cli", params=[Option(["-f"], type=File())])
+    comp4 = ShellComplete(cli4, {}, cli4.name, "_CLI_COMPLETE")
+
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        tmp_path = f.name
+        f.write("content")
+
+    try:
+        for _ in range(3):
+            comp4.get_completions(["-f", tmp_path], "")
+            gc.collect()
+    except ResourceWarning as e:
+        raise AssertionError(
+            f"ResourceWarning raised on repeated completion: {e}"
+        )
+    finally:
+        os.unlink(tmp_path)
+
 
