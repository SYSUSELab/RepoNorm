+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_fast_edit_escape_shell(runner):
+    """Test that escape_shell=True still works with text editing."""
+    result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", escape_shell=True)
+    assert result == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_filename_escape_shell(tmp_path):
+    """Test that escape_shell=True works with a direct filename."""
+    test_file = tmp_path / "test.txt"
+    test_file.write_text("original content\n")
+    # Use sed to append text, ensuring the filename is passed correctly
+    click.edit(
+        text=None,
+        editor="sed -i~ '$a appended'",
+        filename=str(test_file),
+        escape_shell=True,
+    )
+    # The file should have been modified if the command ran correctly
+    result = test_file.read_text()
+    # After sed -i~ '$a appended', the file should contain original content + "appended"
+    assert "original content" in result
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_filename_with_spaces_escape_shell(tmp_path):
+    """Test that escape_shell=True handles filenames with spaces."""
+    test_dir = tmp_path / "my dir"
+    test_dir.mkdir()
+    test_file = test_dir / "test file.txt"
+    test_file.write_text("hello\n")
+    # Use sed to modify and verify the file was reached
+    click.edit(
+        text=None,
+        editor="sed -i~ 's/hello/world/'",
+        filename=str(test_file),
+        escape_shell=True,
+    )
+    result = test_file.read_text()
+    assert "world" in result
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_escape_shell_false_default(tmp_path):
+    """Test that escape_shell=False (default) preserves existing behavior."""
+    test_file = tmp_path / "simple.txt"
+    test_file.write_text("hello\n")
+    click.edit(
+        text=None,
+        editor="sed -i~ 's/hello/world/'",
+        filename=str(test_file),
+        escape_shell=False,
+    )
+    result = test_file.read_text()
+    assert "world" in result
