+
+
+# ====================
+# Transformers
+# ====================
+
+
+def _lowercase(text: str) -> str:
+    return text.lower()
+
+
+def _strip_whitespace(text: str) -> str:
+    return text.strip()
+
+
+def _remove_punctuation(text: str) -> str:
+    import string
+    return text.translate(str.maketrans("", "", string.punctuation))
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_single(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+    text = "Hello World"
+    expected = enc.encode(text.lower())
+    assert enc.encode(text, transformers=_lowercase) == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_chain(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+    text = "  Hello, World!  "
+    # strip -> lowercase -> remove punctuation
+    transformed = _remove_punctuation(_lowercase(_strip_whitespace(text)))
+    expected = enc.encode(transformed)
+    assert enc.encode(text, transformers=[_strip_whitespace, _lowercase, _remove_punctuation]) == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_none_default(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+    text = "hello world"
+    # transformers=None should behave exactly as without the parameter
+    assert enc.encode(text, transformers=None) == enc.encode(text)
+    assert enc.encode_batch([text], transformers=None) == enc.encode_batch([text])
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_non_string_return(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+
+    def bad_transformer(text: str) -> int:
+        return 42
+
+    with pytest.raises(TypeError, match="Transformer returned non-string"):
+        enc.encode("hello", transformers=bad_transformer)
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_exception_propagation(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+
+    class CustomError(Exception):
+        pass
+
+    def failing_transformer(text: str) -> str:
+        raise CustomError("oops")
+
+    with pytest.raises(CustomError, match="oops"):
+        enc.encode("hello", transformers=failing_transformer)
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_chain_exception_stops(make_enc: Callable[[], tiktoken.Encoding]):
+    """Verify that if a transformer in a chain raises, later transformers are not called."""
+    enc = make_enc()
+    call_log = []
+
+    def first(text: str) -> str:
+        call_log.append("first")
+        return text
+
+    def second(text: str) -> str:
+        call_log.append("second")
+        raise ValueError("fail")
+
+    def third(text: str) -> str:
+        call_log.append("third")
+        return text
+
+    with pytest.raises(ValueError):
+        enc.encode("hello", transformers=[first, second, third])
+
+    assert call_log == ["first", "second"], f"Expected first and second to be called, got {call_log}"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_batch(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+    texts = ["Hello World", "  Foo Bar  ", "Test!"]
+    expected = [enc.encode(t.lower()) for t in texts]
+    assert enc.encode_batch(texts, transformers=_lowercase) == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_batch_empty(make_enc: Callable[[], tiktoken.Encoding]):
+    enc = make_enc()
+    assert enc.encode_batch([], transformers=_lowercase) == []
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_mutation_isolation(make_enc: Callable[[], tiktoken.Encoding]):
+    """Verify that transformers are not mutated and repeated documents invoke callbacks independently."""
+    enc = make_enc()
+    call_count = 0
+
+    def counting_transformer(text: str) -> str:
+        nonlocal call_count
+        call_count += 1
+        return text.lower()
+
+    pipeline = [counting_transformer]
+
+    # First call
+    result1 = enc.encode("Hello", transformers=pipeline)
+    assert call_count == 1
+
+    # Second call with same pipeline object
+    result2 = enc.encode("Hello", transformers=pipeline)
+    # Should be called again independently
+    assert call_count == 2, f"Expected 2 calls, got {call_count}"
+    assert result1 == result2
+
+    # Ensure pipeline list not mutated
+    assert pipeline == [counting_transformer]
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_transformer_typed_empty_tuple(make_enc: Callable[[], tiktoken.Encoding]):
+    """Callables may be passed as a tuple (Sequence)."""
+    enc = make_enc()
+    text = "Hello World"
+    expected = enc.encode(text.lower())
+    assert enc.encode(text, transformers=(_lowercase,)) == expected
