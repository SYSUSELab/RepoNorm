+def _make_cached_gettext(func, env):
+    """Wrap a gettext callable with LRU caching."""
+    if env.translation_cache is None:
+        return func
+
+    def wrapper(singular):
+        cache = env.translation_cache
+        if cache is None:
+            return func(singular)
+        partition = env.translation_cache_partition
+        key = ("gettext", singular, partition)
+        try:
+            return cache[key]
+        except KeyError:
+            result = func(singular)
+            cache[key] = result
+            return result
+
+    return wrapper
+
+
