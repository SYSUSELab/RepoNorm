+    def _resize_translation_cache(self, capacity: int) -> None:
+        if capacity < 0:
+            raise ValueError(
+                "Capacity must be a non-negative integer."
+            )
+        env = self.environment
+        if capacity == 0:
+            env.translation_cache = None
+        elif env.translation_cache is None:
+            env.translation_cache = LRUCache(capacity)
+        else:
+            new_cache = LRUCache(capacity)
+            # Copy entries up to the new capacity. Iterate over old items
+            # to preserve the most recently used entries.
+            for key, value in list(env.translation_cache.items()):
+                if len(new_cache) >= capacity:
+                    break
+                new_cache[key] = value
+            env.translation_cache = new_cache
