+def test_edit_isolate_env(runner):
+    """Test the isolate_env parameter of click.edit."""
+    import os
+    from click._termui_impl import Editor
+
+    # Mark a custom variable to test isolation
+    os.environ["_CLICK_TEST_SECRET"] = "should_not_leak"
+
+    try:
+        # --- Test 1: _build_env returns None when no env and not isolated ---
+        ed = Editor()
+        assert ed._build_env() is None
+
+        # --- Test 2: isolate_env=True filters out non-allowlist vars ---
+        ed_iso = Editor(isolate_env=True)
+        env = ed_iso._build_env()
+        assert env is not None, "isolate_env=True should produce non-None env"
+        assert "_CLICK_TEST_SECRET" not in env, (
+            "isolate_env should exclude non-allowlist variables"
+        )
+        # Allowlisted keys present in os.environ should be copied
+        if "PATH" in os.environ:
+            assert env.get("PATH") == os.environ["PATH"]
+
+        # --- Test 3: isolate_env=True with explicit env mapping ---
+        ed_explicit = Editor(isolate_env=True, env={"_CLICK_TEST_SECRET": "explicit"})
+        env2 = ed_explicit._build_env()
+        assert env2 is not None
+        assert env2["_CLICK_TEST_SECRET"] == "explicit", (
+            "Explicit env should be applied after isolation"
+        )
+        # Explicit env can also override allowlisted variables
+        ed_override = Editor(isolate_env=True, env={"PATH": "/overridden"})
+        env3 = ed_override._build_env()
+        assert env3["PATH"] == "/overridden"
+
+        # --- Test 4: isolate_env=False with env inherits all ---
+        ed_inherit = Editor(env={"EDITOR": "vim"})
+        env4 = ed_inherit._build_env()
+        assert env4 is not None
+        assert "_CLICK_TEST_SECRET" in env4, (
+            "Non-isolated mode should inherit all vars including test secret"
+        )
+        assert env4["EDITOR"] == "vim"
+
+        # --- Test 5: Function signature has isolate_env parameter ---
+        import inspect
+        sig = inspect.signature(click.edit)
+        assert "isolate_env" in sig.parameters
+        assert sig.parameters["isolate_env"].default is False
+
+    finally:
+        os.environ.pop("_CLICK_TEST_SECRET", None)
+
+
