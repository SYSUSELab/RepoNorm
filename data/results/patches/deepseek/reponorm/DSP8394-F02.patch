+class TestNamespaceThreading:
+    def test_bare_thread_isolation(self):
+        results = []
+
+        def thread_func():
+            from dspy.clients.cache import _namespace_var
+            start = _namespace_var.get()
+            _namespace_var.set("thread-ns")
+            results.append((start, _namespace_var.get()))
+
+        import dspy
+        dspy.cache.set_namespace(None)
+        t = threading.Thread(target=thread_func)
+        t.start()
+        t.join()
+        assert len(results) == 1
+        start, current = results[0]
+        assert start is None
+        assert current == "thread-ns"
+        assert _namespace_var.get() is None
+
