+class _NamespaceAccessor:
+    """Accessor returned by ``cache.namespace``.
+
+    Compares equal to the current namespace string or None, exposes the
+    current value through ``.value``, and supports ``with cache.namespace(v)``
+    for temporary changes.
+    """
+
+    __hash__ = None  # mutable-like; unhashable
+
+    def __init__(self) -> None:
+        pass
+
+    @property
+    def value(self) -> Optional[str]:
+        return _namespace_var.get()
+
+    def __eq__(self, other: object) -> bool:
+        return self.value == other
+
+    def __ne__(self, other: object) -> bool:
+        return self.value != other
+
+    def __repr__(self) -> str:
+        return f"Namespace(value={self.value!r})"
+
+    def __call__(self, value: Optional[str]):
+        """Return a context manager that temporarily sets *value* as namespace."""
+        _validate_namespace(value)
+        return _NamespaceContext(value)
+
+
+class _NamespaceContext:
+    """Context manager that temporarily sets a cache namespace."""
+
+    def __init__(self, value: Optional[str]) -> None:
+        self._value = value
+        self._token = None
+
+    def __enter__(self):
+        self._token = _namespace_var.set(self._value)
+        return self._value
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        _namespace_var.reset(self._token)
+        self._token = None
+
+
+def _validate_namespace(value: Any) -> None:
+    """Raise ``ValueError`` if *value* is not None or a string."""
+    if value is not None and not isinstance(value, str):
+        raise ValueError(
+            f"Namespace must be a string or None, got {type(value).__name__}"
+        )
+
+
+def _namespace_prefix() -> str:
+    """Return the namespace prefix string, or empty string if no namespace is active.
+
+    When a namespace (including empty string) is active the returned string is
+    ``<first 8 hex chars of SHA-256(namespace)>:``.  When the namespace is
+    ``None`` (the original behaviour) the returned string is empty.
+    """
+    ns = _namespace_var.get()
+    if ns is not None:
+        digest = sha256(ns.encode("utf-8")).hexdigest()[:8]
+        return f"{digest}:"
+    return ""
+
 
