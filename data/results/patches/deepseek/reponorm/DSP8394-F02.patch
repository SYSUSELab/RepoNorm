+class TestRequestCacheDecoratorNamespace:
+    def test_decorator_no_namespace_uses_caller(self, cache):
+        with patch("dspy.cache", cache):
+            call_count = 0
+
+            @request_cache(cache_arg_name="prompt")
+            def my_func(prompt):
+                nonlocal call_count
+                call_count += 1
+                return {"response": f"result-{prompt['text']}"}
+
+            cache.set_namespace("caller-ns")
+            r1 = my_func(prompt={"text": "hello"})
+            assert r1["response"] == "result-hello"
+            assert call_count == 1
+
+            # Cache hit
+            r2 = my_func(prompt={"text": "hello"})
+            assert call_count == 1
+
+    def test_decorator_namespace_override(self, cache):
+        with patch("dspy.cache", cache):
+            call_count = 0
+
+            @request_cache(cache_arg_name="prompt", namespace="decorator-ns")
+            def my_func(prompt):
+                nonlocal call_count
+                call_count += 1
+                return {"response": f"result-{prompt['text']}"}
+
+            cache.set_namespace("caller-ns")
+            r1 = my_func(prompt={"text": "hello"})
+            assert r1["response"] == "result-hello"
+            assert call_count == 1
+
+            # Second call hits cache under decorator namespace
+            r2 = my_func(prompt={"text": "hello"})
+            assert call_count == 1
+
+            # Caller namespace is restored
+            assert cache.namespace.value == "caller-ns"
+
+    def test_decorator_namespace_exception_restore(self, cache):
+        with patch("dspy.cache", cache):
+            @request_cache(cache_arg_name="prompt", namespace="decorator-ns")
+            def failing_func(prompt):
+                raise RuntimeError("oops")
+
+            cache.set_namespace("caller-ns")
+            with pytest.raises(RuntimeError):
+                failing_func(prompt={"text": "hello"})
+            assert cache.namespace.value == "caller-ns"
