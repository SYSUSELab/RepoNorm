+class TestNamespaceAsync:
+    @pytest.mark.asyncio
+    async def test_async_task_isolation(self):
+        results = {}
+
+        async def task(task_id):
+            initial = _namespace_var.get()
+            _namespace_var.set(f"async-{task_id}")
+            await asyncio.sleep(0.01)
+            results[task_id] = (initial, _namespace_var.get())
+
+        await asyncio.gather(task(1), task(2))
+        assert results[1][0] is None
+        assert results[1][1] == "async-1"
+        assert results[2][0] is None
+        assert results[2][1] == "async-2"
