+class TestNamespacePrefix:
+    def test_default_no_prefix(self):
+        assert _namespace_prefix() == ""
+
+    def test_non_none_prefix(self):
+        token = _namespace_var.set("test-ns")
+        try:
+            prefix = _namespace_prefix()
+            expected = sha256("test-ns".encode("utf-8")).hexdigest()[:8]
+            assert prefix == f"{expected}:"
+        finally:
+            _namespace_var.reset(token)
+
+    def test_empty_string_prefix(self):
+        token = _namespace_var.set("")
+        try:
+            prefix = _namespace_prefix()
+            expected = sha256("".encode("utf-8")).hexdigest()[:8]
+            assert prefix == f"{expected}:"
+        finally:
+            _namespace_var.reset(token)
+
+    def test_none_after_set_returns_no_prefix(self):
+        token = _namespace_var.set("temp")
+        _namespace_var.reset(token)
+        assert _namespace_prefix() == ""
+
+
+class TestNamespaceAccessor:
+    def test_value_property(self):
+        accessor = _NamespaceAccessor()
+        assert accessor.value is None
+        token = _namespace_var.set("hello")
+        try:
+            assert accessor.value == "hello"
+        finally:
+            _namespace_var.reset(token)
+
+    def test_equality(self):
+        accessor = _NamespaceAccessor()
+        token = _namespace_var.set("hello")
+        try:
+            assert accessor == "hello"
+            assert accessor != "world"
+        finally:
+            _namespace_var.reset(token)
+
+    def test_equality_none(self):
+        accessor = _NamespaceAccessor()
+        assert accessor == None
+        assert not (accessor is None)
+
+    def test_context_manager(self):
+        accessor = _NamespaceAccessor()
+        assert accessor.value is None
+        with accessor("inside"):
+            assert accessor.value == "inside"
+        assert accessor.value is None
+
+    def test_context_manager_nesting(self):
+        accessor = _NamespaceAccessor()
+        with accessor("outer"):
+            with accessor("inner"):
+                assert accessor.value == "inner"
+            assert accessor.value == "outer"
+
+    def test_context_manager_exception_restore(self):
+        accessor = _NamespaceAccessor()
