+from diskcache.core import Disk, MODE_PICKLE, MODE_RAW, UNKNOWN
 
 logger = logging.getLogger(__name__)
 
 
+class _CompressedDisk(Disk):
+    """Disk subclass that applies optional compression to pickled cache entries.
+
+    The persisted format for compressed entries is:
+        b"DSPC" + codec_byte + compressed_pickle_payload
+
+    Codec bytes:
+        0x00: uncompressed pickle (with DSPC header)
+        0x01: gzip-compressed pickle
+        0x02: zlib-compressed pickle
+
+    Pre-feature entries (plain pickle without header) remain readable.
+    Uncompressed writes (codec=None) use the existing backend representation
+    (plain pickle without header).
+    """
+
+    _write_codec = None
+
+    CODEC_BYTE = {None: 0x00, 'gzip': 0x01, 'zlib': 0x02}
+
+    def store(self, value, read, key=UNKNOWN):
+        type_value = type(value)
+        min_file_size = self.min_file_size
+
+        if (
+            (type_value is str and len(value) < min_file_size)
+            or (
+                type_value is int
+                and -9223372036854775808 <= value <= 9223372036854775807
+            )
+            or (type_value is float)
+        ):
+            return 0, MODE_RAW, None, value
+        if type_value is bytes or type_value is str or read:
+            return super().store(value, read, key)
+
+        result = pickle.dumps(value, protocol=self.pickle_protocol)
+        codec = self._write_codec
+
+        if codec is None:
+            payload = result
+        else:
+            codec_byte = self.CODEC_BYTE[codec]
+            if codec == 'gzip':
+                compressed = gzip.compress(result)
+            else:
+                compressed = zlib.compress(result)
+            payload = b'DSPC' + bytes([codec_byte]) + compressed
+
+        if len(payload) < min_file_size:
+            return 0, MODE_PICKLE, None, sqlite3.Binary(payload)
+        else:
+            filename, full_path = self.filename(key, payload)
+            self._write(full_path, io.BytesIO(payload), 'xb')
+            return len(payload), MODE_PICKLE, filename, None
+
+    def fetch(self, mode, filename, value, read):
+        if mode == MODE_PICKLE:
+            if value is None:
+                with open(_os.path.join(self._directory, filename), 'rb') as reader:
+                    payload = reader.read()
+            else:
+                payload = bytes(value) if isinstance(value, sqlite3.Binary) else value
+
+            if payload[:4] == b'DSPC':
+                codec_byte = payload[4]
+                if codec_byte == 0x00:
+                    data = payload[5:]
+                elif codec_byte == 0x01:
+                    data = gzip.decompress(payload[5:])
+                elif codec_byte == 0x02:
+                    data = zlib.decompress(payload[5:])
+                else:
+                    raise ValueError(
+                        f'Unknown compression codec byte: {codec_byte}'
+                    )
+                return pickle.loads(data)
+            else:
+                return pickle.loads(payload)
+        else:
+            return super().fetch(mode, filename, value, read)
+
+
