+def _apply_path_transform(
+    path_transform: t.Optional[t.Callable[[str], str]], template: str
+) -> str:
+    """Apply a path transform to a template name, returning the transformed
+    name. Raises TypeError if the return value is not a string.
+    """
+    if path_transform is None:
+        return template
+    rv = path_transform(template)
+    if not isinstance(rv, str):
+        raise TypeError("path_transform must return a string")
+    return rv
