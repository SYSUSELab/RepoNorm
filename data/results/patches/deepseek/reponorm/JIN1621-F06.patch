+class TestPathTransform:
+    """Tests for the path_transform feature on all loaders."""
+
+    def test_dict_loader_transform(self):
+        """DictLoader applies path_transform before lookup."""
+        mapping = {"transformed.html": "CONTENT"}
+        loader = loaders.DictLoader(
+            mapping,
+            path_transform=lambda name: "transformed.html",
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("original.html")
+        assert tmpl.render() == "CONTENT"
+
+    def test_dict_loader_transform_not_found_original_name(self):
+        """TemplateNotFound.name is the original name, not transformed."""
+        loader = loaders.DictLoader(
+            {},
+            path_transform=lambda name: "nonexistent.html",
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("my_template.html")
+        assert exc_info.value.name == "my_template.html"
+
+    def test_dict_loader_non_string_return(self):
+        """Non-string return from path_transform raises TypeError."""
+        loader = loaders.DictLoader(
+            {},
+            path_transform=lambda name: 42,  # type: ignore
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TypeError, match="path_transform must return a string"):
+            env.get_template("test.html")
+
+    def test_dict_loader_exception_propagation(self):
+        """Exceptions from path_transform propagate unchanged."""
+        class CustomError(Exception):
+            pass
+
+        def raiser(name: str) -> str:
+            raise CustomError("boom")
+
+        loader = loaders.DictLoader(
+            {},
+            path_transform=raiser,
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(CustomError, match="boom"):
+            env.get_template("test.html")
+
+    def test_dict_loader_empty_input(self):
+        """Empty string is passed to path_transform."""
+        loader = loaders.DictLoader(
+            {"": "EMPTY"},
+            path_transform=lambda name: name if name else "",
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("")
+        assert tmpl.render() == "EMPTY"
+
+    def test_filesystem_loader_transform(self, tmp_path):
+        """FileSystemLoader applies path_transform before filesystem lookup."""
+        d = tmp_path / "templates"
+        d.mkdir()
+        (d / "hello.txt").write_text("WORLD")
+        loader = loaders.FileSystemLoader(
+            str(d),
+            path_transform=lambda name: f"{name}.txt",
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("hello")
+        assert tmpl.render() == "WORLD"
+
+    def test_filesystem_loader_transform_safety_check(self, tmp_path):
+        """Filesystem transform does not bypass path safety checks (e.g. '..')."""
+        d = tmp_path / "templates"
+        d.mkdir()
+        loader = loaders.FileSystemLoader(
+            str(d),
+            path_transform=lambda name: "../../etc/passwd",
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound):
+            env.get_template("innocent")
+
+    def test_function_loader_transform(self):
+        """FunctionLoader applies path_transform before calling the function."""
+        calls = []
+
+        def load_func(name: str):
+            calls.append(name)
+            return f"LOADED:{name}"
+
+        loader = loaders.FunctionLoader(
+            load_func,
+            path_transform=lambda name: f"prefix_{name}",
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("myname")
+        assert tmpl.render() == "LOADED:prefix_myname"
+        assert calls == ["prefix_myname"]
+
+    def test_function_loader_transform_not_found_original_name(self):
+        """FunctionLoader raises TemplateNotFound with original name."""
+        loader = loaders.FunctionLoader(
+            lambda name: None,
+            path_transform=lambda name: f"x{name}",
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("orig")
+        assert exc_info.value.name == "orig"
+
+    def test_package_loader_transform(self, monkeypatch):
+        """PackageLoader applies path_transform before package lookup."""
+        monkeypatch.syspath_prepend(str(Path(__file__).parent))
+        loader = loaders.PackageLoader(
+            "res", "templates",
+            path_transform=lambda name: f"foo/{name}",
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("test.html")
+        assert tmpl.render().strip() == "FOO"
+
+    def test_choice_loader_transform(self):
+        """ChoiceLoader transforms complete name before trying children."""
+        mapping = {"real.html": "REAL"}
+        loader = loaders.ChoiceLoader(
+            [loaders.DictLoader(mapping)],
+            path_transform=lambda name: "real.html",
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("alias.html")
+        assert tmpl.render() == "REAL"
+
+    def test_choice_loader_transform_original_name(self):
+        """ChoiceLoader raises TemplateNotFound with original name."""
+        loader = loaders.ChoiceLoader(
+            [loaders.DictLoader({})],
+            path_transform=lambda name: "nonexistent.html",
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("original_name")
+        assert exc_info.value.name == "original_name"
+
+    def test_choice_loader_child_own_transform(self):
+        """ChoiceLoader applies its transform, then child loader applies its own."""
+        child = loaders.DictLoader(
+            {"child_target.html": "CHILD"},
+            path_transform=lambda name: "child_target.html",
+        )
+        parent = loaders.ChoiceLoader(
+            [child],
+            path_transform=lambda name: "anything",  # transforms to "anything"
+        )
+        # The child receives "anything" (after parent transform), then
+        # child's transform maps it to "child_target.html"
+        env = Environment(loader=parent)
+        tmpl = env.get_template("original_name")
+        assert tmpl.render() == "CHILD"
+
+    def test_prefix_loader_transform(self):
+        """PrefixLoader transforms complete name before splitting prefix."""
+        child = loaders.DictLoader({"target.html": "PREFIX_OK"})
+        loader = loaders.PrefixLoader(
+            {"app": child},
+            delimiter=":",
+            path_transform=lambda name: name.replace("-", ":"),
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("app-target.html")
+        assert tmpl.render() == "PREFIX_OK"
+
+    def test_prefix_loader_transform_original_name(self):
+        """PrefixLoader raises TemplateNotFound with original name."""
+        loader = loaders.PrefixLoader(
+            {},
+            path_transform=lambda name: "nonexistent/test",
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("my_template")
+        assert exc_info.value.name == "my_template"
+
+    def test_prefix_loader_child_own_transform(self):
+        """PrefixLoader applies its transform, then child applies its own."""
+        child = loaders.DictLoader(
+            {"foo.html": "CHILD_TRANSFORM"},
+            path_transform=lambda name: "foo.html",
+        )
+        parent = loaders.PrefixLoader(
+            {"app": child},
+            path_transform=lambda name: "app/anything",
+        )
+        env = Environment(loader=parent)
+        tmpl = env.get_template("original")
+        assert tmpl.render() == "CHILD_TRANSFORM"
+
+    def test_module_loader_transform(self, tmp_path):
+        """ModuleLoader applies path_transform before key lookup."""
+        from jinja2 import FileSystemLoader
+        from jinja2.environment import Environment
+
+        # Create a source loader, compile, and use ModuleLoader with transform
+        src_dir = tmp_path / "src_templates"
+        src_dir.mkdir()
+        (src_dir / "real_target.html").write_text("MODULE_OK")
+
+        src_env = Environment(loader=FileSystemLoader(str(src_dir)))
+        compiled_path = tmp_path / "compiled"
+        src_env.compile_templates(compiled_path, zip=None)
+
+        mod_loader = loaders.ModuleLoader(
+            str(compiled_path),
+            path_transform=lambda name: "real_target.html",
+        )
+        mod_env = Environment(loader=mod_loader)
+        tmpl = mod_env.get_template("alias_name")
+        assert tmpl.render() == "MODULE_OK"
+
+    def test_module_loader_transform_not_found_original_name(self, tmp_path):
+        """ModuleLoader raises TemplateNotFound with original name."""
+        compiled_path = tmp_path / "empty_compiled"
+        compiled_path.mkdir()
+        loader = loaders.ModuleLoader(
+            str(compiled_path),
+            path_transform=lambda name: "nonexistent",
+        )
+        env = Environment(loader=loader)
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("original_name")
+        assert exc_info.value.name == "original_name"
+
+    def test_list_templates_not_affected(self, dict_loader):
+        """list_templates() returns stored names, not transformed."""
+        loader = loaders.DictLoader(
+            {"foo.html": "A", "bar.html": "B"},
+            path_transform=lambda name: "bar.html",
+        )
+        templates = loader.list_templates()
+        assert "foo.html" in templates
+        assert "bar.html" in templates
+
+    def test_cache_key_is_original_name(self):
+        """Environment cache key is the original public request name."""
+        mapping = {"real.html": "CACHED"}
+        loader = loaders.DictLoader(
+            mapping,
+            path_transform=lambda name: "real.html",
+        )
+        env = Environment(loader=loader, cache_size=-1)
+        # First load
+        tmpl1 = env.get_template("alias")
+        assert tmpl1.render() == "CACHED"
+        # Load again with same alias, should be from cache
+        tmpl2 = env.get_template("alias")
+        assert tmpl2 is tmpl1
+        # Load with different alias, should get same template object
+        # because both resolve to the same transformed name
+        tmpl3 = env.get_template("alias2")
+        # Since transform maps alias2 -> real.html, same content,
+        # but different cache key, so different template object
+        # Actually, since both are cached separately, they may be
+        # different objects. Let's just check they both work.
+        assert tmpl3.render() == "CACHED"
+
