diff --git a/src/jinja2/loaders.py b/src/jinja2/loaders.py
index d7d9bd0..66b39a1 100644
--- a/src/jinja2/loaders.py
+++ b/src/jinja2/loaders.py
@@ -173,18 +173,72 @@ class FileSystemLoader(BaseLoader):
 
     .. versionchanged:: 2.8
         Added the ``followlinks`` parameter.
+
+    .. versionchanged:: 3.1
+        Added support for ``(path, priority)`` tuples in the search
+        path. Items with higher priority are searched first.
     """
 
     def __init__(
         self,
-        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        searchpath: t.Union[
+            str,
+            os.PathLike,
+            t.Sequence[
+                t.Union[
+                    str,
+                    os.PathLike,
+                    t.Tuple[t.Union[str, os.PathLike], int],
+                ]
+            ],
+        ],
         encoding: str = "utf-8",
         followlinks: bool = False,
     ) -> None:
         if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
             searchpath = [searchpath]
 
-        self.searchpath = [os.fspath(p) for p in searchpath]
+        paths: t.List[t.Tuple[str, int]] = []
+
+        for item in searchpath:
+            if isinstance(item, tuple):
+                if len(item) != 2:
+                    raise TypeError(
+                        "Expected a tuple of the form (path, priority), "
+                        f"got {len(item)} elements"
+                    )
+
+                path, priority = item
+
+                if isinstance(priority, bool):
+                    raise TypeError(
+                        "Priority must be an integer, not bool"
+                    )
+
+                if not isinstance(priority, int):
+                    raise TypeError(
+                        "Priority must be an integer, "
+                        f"got {type(priority).__name__}"
+                    )
+
+                if not isinstance(path, (str, os.PathLike)):
+                    raise TypeError(
+                        "Path must be a string or os.PathLike, "
+                        f"got {type(path).__name__}"
+                    )
+
+                paths.append((os.fspath(path), priority))
+            elif isinstance(item, (str, os.PathLike)):
+                paths.append((os.fspath(item), 0))
+            else:
+                raise TypeError(
+                    "Expected a string, os.PathLike, or tuple of "
+                    "(path, priority), got "
+                    f"{type(item).__name__}"
+                )
+
+        paths.sort(key=lambda x: x[1], reverse=True)
+        self.searchpath = [p for p, _ in paths]
         self.encoding = encoding
         self.followlinks = followlinks
 
