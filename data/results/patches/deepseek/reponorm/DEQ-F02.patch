+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address, optionally requiring a specific format.
+
+    Args:
+        format: The format of the MAC address to check, one of `'colon'`, `'hyphen'`, `'dot'`, or `'compact'`.
+            If omitted, any valid MAC address format is accepted.
+    """
+
+    _colon_re = re.compile(r'^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\Z')
+    _hyphen_re = re.compile(r'^([0-9a-fA-F]{2}-){5}[0-9a-fA-F]{2}\Z')
+    _dot_re = re.compile(r'^([0-9a-fA-F]{4}\.){2}[0-9a-fA-F]{4}\Z')
+    _compact_re = re.compile(r'^[0-9a-fA-F]{12}\Z')
+
+    def __init__(self, format: str = None):
+        """
+        Args:
+            format: The format of the MAC address to check, one of `'colon'`, `'hyphen'`, `'dot'`, or `'compact'`.
+                If omitted, any valid MAC address format is accepted.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert '00:1a:2b:3c:4d:5e' == IsMac
+        assert '00-1a-2b-3c-4d-5e' == IsMac
+        assert '001a.2b3c.4d5e' == IsMac
+        assert '001a2b3c4d5e' == IsMac
+
+        assert '00:1a:2b:3c:4d:5e' == IsMac('colon')
+        assert '00-1a-2b-3c-4d-5e' != IsMac('colon')
+        ```
+        """
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format == 'colon':
+            return bool(self._colon_re.match(other))
+        elif self.format == 'hyphen':
+            return bool(self._hyphen_re.match(other))
+        elif self.format == 'dot':
+            return bool(self._dot_re.match(other))
+        elif self.format == 'compact':
+            return bool(self._compact_re.match(other))
+        elif self.format is None:
+            return bool(
+                self._colon_re.match(other)
+                or self._hyphen_re.match(other)
+                or self._dot_re.match(other)
+                or self._compact_re.match(other)
+            )
+        else:
+            return False
+
+
 AnyJson = object
 JsonType = TypeVar('JsonType', AnyJson, Any)
 
