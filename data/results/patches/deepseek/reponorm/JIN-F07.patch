         {% endfor %}</ul>
 
+    When *stable* is ``True``, groups are ordered by the first occurrence
+    of each key rather than sorted by key. This supports equality-comparable
+    keys including unhashable types such as lists and dictionaries.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
+
+    .. versionadded:: 3.X
+        Added the ``stable`` parameter.
     """
     expr = make_attrgetter(environment, attribute, default=default)
+
+    if stable:
+        # Group by first-seen order, retaining the first key object as
+        # the grouper.  Uses equality comparison so unhashable keys
+        # (e.g. lists, dicts) are supported.
+        groups: "t.List[t.Tuple[t.Any, t.List[V]]]" = []
+
+        for item in value:
+            k = expr(item)
+            found = False
+
+            for grouper, group in groups:
+                if grouper == k:
+                    group.append(item)
+                    found = True
+                    break
+
+            if not found:
+                groups.append((k, [item]))
+
+        return [_GroupTuple(grouper, group) for grouper, group in groups]
+
     return [
