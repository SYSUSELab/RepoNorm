diff --git a/tests/test_async_filters.py b/tests/test_async_filters.py
index 5d4f332..9f9bb29 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -94,6 +94,47 @@ def test_groupby_multidot(env_async, articles):
     ]
 
 
+@mark_dualiter("items", lambda: [{"foo": 3, "bar": "a"}, {"foo": 1, "bar": "b"}, {"foo": 2, "bar": "c"}, {"foo": 1, "bar": "d"}])
+def test_groupby_stable(env_async, items):
+    tmpl = env_async.from_string(
+        """{%- for grouper, list in items()|groupby("foo", stable=true) -%}
+            {{ grouper }}{% for x in list %}:{{ x.bar }}{% endfor %}|
+        {%- endfor %}"""
+    )
+    assert tmpl.render(items=items).split("|") == ["3:a", "1:b:d", "2:c", ""]
+
+
+@mark_dualiter("items", lambda: [("b", 1), ("a", 2), ("b", 3)])
+def test_groupby_stable_tuple_index(env_async, items):
+    tmpl = env_async.from_string(
+        """{%- for grouper, list in items()|groupby(0, stable=true) -%}
+            {{ grouper }}{% for x in list %}:{{ x.1 }}{% endfor %}|
+        {%- endfor %}"""
+    )
+    assert tmpl.render(items=items) == "b:1:3|a:2|"
+
+
+@mark_dualiter("items", lambda: [{"name": "a", "city": "NY"}, {"name": "b"}, {"name": "c", "city": "WA"}])
+def test_groupby_stable_with_default(env_async, items):
+    tmpl = env_async.from_string(
+        "{% for city, items in items()|groupby('city', default='NY', stable=true) %}"
+        "{{ city }}:{{ items|map(attribute='name')|join(',') }} "
+        "{% endfor %}"
+    )
+    out = tmpl.render(items=items)
+    assert out == "NY:a,b WA:c "
+
+
+@mark_dualiter("items", lambda: [{"foo": 2}, {"foo": 1}, {"foo": 2}])
+def test_groupby_stable_namedtuple(env_async, items):
+    tmpl = env_async.from_string(
+        """{% for group in items()|groupby("foo", stable=true) -%}
+            {{ group.grouper }}-{{ group.list|length }}|
+        {%- endfor %}"""
+    )
+    assert tmpl.render(items=items) == "2-2|1-1|"
+
+
