+        tmpl = env.from_string(
+            """{%- for grouper, list in [{'foo': 3, 'bar': 'a'},
+                                      {'foo': 1, 'bar': 'b'},
+                                      {'foo': 2, 'bar': 'c'},
+                                      {'foo': 1, 'bar': 'd'}]|groupby('foo', stable=true) -%}
+            {{ grouper }}{% for x in list %}:{{ x.bar }}{% endfor %}|
+        {%- endfor %}"""
