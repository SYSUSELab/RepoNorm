+"""Test additions for cleanup_timeout feature."""
+
+
+def test_cleanup_timeout_default_none(runner):
+    """A context without cleanup_timeout cleans up synchronously."""
+    called = []
+    ctx = click.Context(click.Command("test"))
+    assert ctx._cleanup_timeout is None
+    @ctx.call_on_close
+    def cb():
+        called.append(True)
+    ctx.close()
+    assert called == [True]
+
+
+def test_cleanup_timeout_inherits_from_parent():
+    """A child inherits cleanup_timeout from its parent when not explicitly set."""
+    parent = click.Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = click.Context(click.Command("child"), parent=parent)
+    assert child._cleanup_timeout == 5.0
+
+
+def test_cleanup_timeout_child_explicit_overrides_parent():
+    """A child can override the parent's cleanup_timeout."""
+    parent = click.Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = click.Context(click.Command("child"), parent=parent, cleanup_timeout=10.0)
+    assert child._cleanup_timeout == 10.0
+
+
+def test_cleanup_timeout_child_none_no_parent():
+    """A child without parent and without cleanup_timeout has None."""
+    ctx = click.Context(click.Command("test"))
+    assert ctx._cleanup_timeout is None
+
+
+def test_cleanup_timeout_negative_raises():
+    """A negative cleanup_timeout raises ValueError."""
+    with pytest.raises(ValueError, match="must be positive"):
+        click.Context(click.Command("test"), cleanup_timeout=-1)
+
+
+def test_cleanup_timeout_zero_raises():
+    """A zero cleanup_timeout raises ValueError."""
+    with pytest.raises(ValueError, match="must be positive"):
+        click.Context(click.Command("test"), cleanup_timeout=0)
+
+
+def test_cleanup_timeout_successful_cleanup():
+    """When cleanup completes within the timeout, callbacks run normally."""
+    called = []
+    ctx = click.Context(click.Command("test"), cleanup_timeout=5.0)
+    @ctx.call_on_close
+    def cb():
+        called.append(True)
+    ctx.close()
+    assert called == [True]
+
+
+def test_cleanup_timeout_successful_cleanup_error():
+    """When cleanup completes within the timeout and raises, the error propagates."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=5.0)
+    @ctx.call_on_close
+    def cb():
+        raise RuntimeError("cleanup error")
+    with pytest.raises(RuntimeError, match="cleanup error"):
+        ctx.close()
+
+
+def test_cleanup_timeout_new_registrations_preserved():
+    """Registrations made during cleanup belong to the next close()."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=5.0)
+    cleanup1_called = []
+    cleanup2_called = []
+
+    @ctx.call_on_close
+    def cb1():
+        cleanup1_called.append(True)
+        # Register another callback during cleanup
+        @ctx.call_on_close
+        def cb2():
+            cleanup2_called.append(True)
+
+    ctx.close()
+    assert cleanup1_called == [True]
+    # cb2 was registered during cb1's execution, so it runs on the next close
+    assert cleanup2_called == []
+
+    # Second close should run cb2
+    ctx.close()
+    assert cleanup2_called == [True]
+
+
+def test_cleanup_timeout_repeated_close_no_restart():
+    """Repeated close does not restart an earlier timed-out cleanup."""
+    event = threading.Event()
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+
+    @ctx.call_on_close
+    def slow_cb():
+        event.wait()  # Block until released
+
+    # Start close (will time out)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        ctx.close()
+    # First close timed out; slow_cb is still waiting on event
+
+    # Register a new callback for the second close
+    second_called = []
+    @ctx.call_on_close
+    def second_cb():
+        second_called.append(True)
+
+    # Second close runs only second_cb
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        ctx.close()
+    assert second_called == [True]
+
+    # Now release the slow callback so the background thread can finish
+    event.set()
+
+
+def test_cleanup_timeout_error_after_timeout_warned():
+    """An error raised after the caller has stopped waiting is reported via warning."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.05)
+    call_count = [0]
+
+    @ctx.call_on_close
+    def raises_after_delay():
+        call_count[0] += 1
+        time.sleep(0.2)  # Longer than timeout
+        raise RuntimeError("delayed error")
+
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        ctx.close()
+
+    # Should have timed out and issued a warning about the timeout
+    timeout_warnings = [x for x in w if "did not complete" in str(x.message)]
+    assert len(timeout_warnings) >= 1
+
+    # Wait for the thread to finish so the delayed error is warned
+    time.sleep(0.3)
+
+    # Now we should have a warning about the delayed error
+    # (The thread catches it after the main thread has timed out)
+    assert call_count[0] == 1
+
+
+def test_cleanup_timeout_keeps_exception_when_completed():
+    """Exceptions from cleanup that completes before the deadline propagate."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=5.0)
+
+    @ctx.call_on_close
+    def cb():
+        raise ValueError("something went wrong")
+
+    with pytest.raises(ValueError, match="something went wrong"):
+        ctx.close()
+
+
+def test_cleanup_timeout_context_manager():
+    """with_resource context managers are properly cleaned up with timeout."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=5.0)
+    records = []
+
+    class Tracker:
+        def __enter__(self):
+            records.append("enter")
+            return self
+        def __exit__(self, *args):
+            records.append("exit")
+
+    ctx.with_resource(Tracker())
+    ctx.close()
+    assert records == ["enter", "exit"]
+
+
+def test_cleanup_timeout_batch_separation():
+    """Cleanup callbacks registered during a timed close belong to the next batch."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.2)
+    results = []
+
+    @ctx.call_on_close
+    def first_batch():
+        results.append("first_start")
+        # Register for next batch
+        @ctx.call_on_close
+        def inner():
+            results.append("second_batch")
+        time.sleep(0.05)
+        results.append("first_end")
+
+    ctx.close()
+    # First batch ran
+    assert results == ["first_start", "first_end"]
+
+    # Second close runs the inner callback
+    ctx.close()
+    assert results == ["first_start", "first_end", "second_batch"]
