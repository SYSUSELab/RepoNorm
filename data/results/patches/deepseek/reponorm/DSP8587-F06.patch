+@pytest.mark.anyio
+async def test_stream_listener_on_chunk_exception_propagates():
+    """Test that exceptions from on_chunk propagate to the caller."""
+    import dspy
+    from dspy.streaming import StreamListener, StreamResponse
+    from unittest.mock import AsyncMock
+
+    class MyProgram(dspy.Module):
+        def __init__(self):
+            super().__init__()
+            self.predict1 = dspy.Predict("question->answer")
+
+        def forward(self, question, **kwargs):
+            answer = self.predict1(question=question, **kwargs)
+            return dspy.Prediction(answer=answer.answer)
+
+    def failing_callback(response):
+        raise RuntimeError("on_chunk failed")
+
+    async def gemini_stream(*args, **kwargs):
+        yield ModelResponseStream(model="gemini", choices=[StreamingChoices(delta=Delta(content="[[ ##"))])
+        yield ModelResponseStream(model="gemini", choices=[StreamingChoices(delta=Delta(content=" answer ## ]]"))])
+        yield ModelResponseStream(
+            model="gemini", choices=[StreamingChoices(delta=Delta(content="To get to the other side."))]
+        )
+        yield ModelResponseStream(
+            model="gemini", choices=[StreamingChoices(delta=Delta(content="\n\n[[ ## completed ## ]]"))]
+        )
+
+    with mock.patch("litellm.acompletion", new_callable=AsyncMock, side_effect=[gemini_stream()]):
+        program = dspy.streamify(
+            MyProgram(),
+            stream_listeners=[
+                StreamListener(
+                    signature_field_name="answer",
+                    on_chunk=failing_callback,
+                ),
+            ],
+        )
+        with dspy.context(lm=dspy.LM("gemini/gemini-2.5-flash", cache=False), adapter=dspy.ChatAdapter()):
+            output = program(question="why did a chicken cross the kitchen?")
+            with pytest.raises(ExceptionGroup) as exc_info:
+                async for value in output:
+                    pass
+            assert any("on_chunk failed" in str(e) for e in exc_info.value.exceptions)
+
