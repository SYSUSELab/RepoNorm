@@ -1203,17 +1204,45 @@ def sync_do_groupby(
           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    Use the ``max_groups`` parameter to limit the number of groups
+    returned, returning only the first *N* groups in key order.
+    ``None`` (the default) returns every group.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", max_groups=3) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
+    .. versionchanged:: 3.5
+        Added the ``max_groups`` parameter.
+
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+
+    if max_groups is None:
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+
+    if type(max_groups) is not int or max_groups < 0:
+        raise FilterArgumentError(
+            "'max_groups' must be a nonnegative integer or None, "
+            f"got {max_groups!r}"
+        )
+
+    result: "t.List[t.Tuple[t.Any, t.List[V]]]" = []
+    for key, values in groupby(sorted(value, key=expr), expr):
+        if len(result) >= max_groups:
+            break
+        result.append(_GroupTuple(key, list(values)))
+    return result
 
 
