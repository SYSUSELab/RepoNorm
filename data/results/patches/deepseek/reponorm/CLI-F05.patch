+    def _exec_close_callback(self, f: t.Callable[..., t.Any]) -> None:
+        """Execute a close callback with retry logic."""
+        retries = self.retry_cleanup
+        if retries <= 0:
+            f()
+            return
+
+        backoff = self.retry_cleanup_backoff
+        delay = backoff
+        last_exc: BaseException | None = None
+
+        for attempt in range(retries + 1):
+            try:
+                f()
+                return
+            except (KeyboardInterrupt, SystemExit):
+                raise
+            except BaseException as e:
+                last_exc = e
