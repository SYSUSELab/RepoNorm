diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..2c4ffc2 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -543,3 +543,264 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+
+def test_retry_cleanup_success_after_retry():
+    """A callback that fails transiently and then succeeds should succeed."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=2)
+    attempts = []
+
+    def flaky():
+        attempts.append(1)
+        if len(attempts) < 2:
+            raise ValueError("transient")
+
+    ctx.call_on_close(flaky)
+    ctx.close()
+    assert len(attempts) == 2
+
+
+def test_retry_cleanup_exhausted():
+    """A callback that always fails should propagate the last exception after retries."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=1)
+    attempts = []
+
+    def always_fails():
+        attempts.append(1)
+        raise ValueError("persistent")
+
+    ctx.call_on_close(always_fails)
+    with pytest.raises(ValueError, match="persistent"):
+        ctx.close()
+    # First attempt + 1 retry = 2 attempts
+    assert len(attempts) == 2
+
+
+def test_retry_cleanup_zero_no_retry():
+    """retry_cleanup=0 should not retry."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=0)
+    attempts = []
+
+    def fail_once():
+        attempts.append(1)
+        raise ValueError("fail")
+
+    ctx.call_on_close(fail_once)
+    with pytest.raises(ValueError):
+        ctx.close()
+    assert len(attempts) == 1
+
+
+def test_retry_cleanup_no_retry_on_keyboard_interrupt():
+    """KeyboardInterrupt should not be retried."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=2)
+    attempts = []
+
+    def raise_kbi():
+        attempts.append(1)
+        raise KeyboardInterrupt()
+
+    ctx.call_on_close(raise_kbi)
+    with pytest.raises(KeyboardInterrupt):
+        ctx.close()
+    assert len(attempts) == 1
+
+
+def test_retry_cleanup_no_retry_on_system_exit():
+    """SystemExit should not be retried."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=2)
+    attempts = []
+
+    def raise_se():
+        attempts.append(1)
+        raise SystemExit(1)
+
+    ctx.call_on_close(raise_se)
+    with pytest.raises(SystemExit):
+        ctx.close()
+    assert len(attempts) == 1
+
+
+def test_retry_cleanup_success_first_try():
+    """A callback that succeeds on first try should not retry."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=2)
+    called = False
+
+    def ok():
+        nonlocal called
+        called = True
+
+    ctx.call_on_close(ok)
+    ctx.close()
+    assert called
+
+
+def test_retry_cleanup_remaining_callbacks_still_run():
+    """If one callback exhausts its retries, remaining callbacks still run."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=1)
+    order = []
+
+    def always_fails():
+        order.append("fail")
+        raise ValueError("bad")
+
+    def always_ok():
+        order.append("ok")
+
+    # Register in order: always_fails first, always_ok second
+    ctx.call_on_close(always_fails)
+    ctx.call_on_close(always_ok)
+
+    # close runs in reverse order, so always_ok runs first, then always_fails
+    with pytest.raises(ValueError, match="bad"):
+        ctx.close()
+
+    # always_ok ran, always_fails ran twice (1 attempt + 1 retry)
+    assert order.count("ok") == 1
+    assert order.count("fail") == 2
+
+
+def test_retry_cleanup_backoff_default():
+    """Default retry_cleanup_backoff is 0.1 for root."""
+    ctx = click.Context(click.Command("test"))
+    assert ctx.retry_cleanup_backoff == 0.1
+
+
+def test_retry_cleanup_backoff_inherit():
+    """Child inherits parent's backoff when omitted."""
+    parent = click.Context(click.Command("parent"), retry_cleanup_backoff=0.5)
+    child = click.Context(click.Command("child"), parent=parent)
+    assert child.retry_cleanup_backoff == 0.5
+
+
+def test_retry_cleanup_backoff_explicit():
+    """Child can override backoff explicitly."""
+    parent = click.Context(click.Command("parent"), retry_cleanup_backoff=0.5)
+    child = click.Context(
+        click.Command("child"), parent=parent, retry_cleanup_backoff=2.0
+    )
+    assert child.retry_cleanup_backoff == 2.0
+
+
+def test_retry_cleanup_inherit():
+    """Child inherits retry_cleanup from parent when omitted."""
+    parent = click.Context(click.Command("parent"), retry_cleanup=3)
+    child = click.Context(click.Command("child"), parent=parent)
+    assert child.retry_cleanup == 3
+
+
+def test_retry_cleanup_explicit_zero_child():
+    """Explicit 0 on child disables retries for that child."""
+    parent = click.Context(click.Command("parent"), retry_cleanup=3)
+    child = click.Context(
+        click.Command("child"), parent=parent, retry_cleanup=0
+    )
+    assert child.retry_cleanup == 0
+
+
+def test_retry_cleanup_invalid_backoff_bool():
+    """Boolean values should be rejected for backoff."""
+    with pytest.raises(ValueError, match="must be a finite positive number"):
+        click.Context(click.Command("test"), retry_cleanup_backoff=True)
+
+
+def test_retry_cleanup_invalid_backoff_zero():
+    """Zero should be rejected for backoff."""
+    with pytest.raises(ValueError, match="must be a finite positive number"):
+        click.Context(click.Command("test"), retry_cleanup_backoff=0)
+
+
+def test_retry_cleanup_invalid_backoff_negative():
+    """Negative values should be rejected for backoff."""
+    with pytest.raises(ValueError, match="must be a finite positive number"):
+        click.Context(click.Command("test"), retry_cleanup_backoff=-1)
+
+
+def test_retry_cleanup_invalid_backoff_inf():
+    """Infinite values should be rejected for backoff."""
+    import math
+    with pytest.raises(ValueError, match="must be a finite positive number"):
+        click.Context(click.Command("test"), retry_cleanup_backoff=math.inf)
+
+
+def test_retry_cleanup_backoff_valid_values():
+    """Valid finite positive numbers should be accepted."""
+    ctx = click.Context(click.Command("test"), retry_cleanup_backoff=0.5)
+    assert ctx.retry_cleanup_backoff == 0.5
+    ctx2 = click.Context(click.Command("test"), retry_cleanup_backoff=2)
+    assert ctx2.retry_cleanup_backoff == 2
+    ctx3 = click.Context(click.Command("test"), retry_cleanup_backoff=3.0)
+    assert ctx3.retry_cleanup_backoff == 3.0
+
+
+def test_with_resource_not_retried():
+    """with_resource should not be retried; it exits normally."""
+    @contextmanager
+    def manager():
+        val = [1]
+        yield val
+        val[0] = 0
+
+    ctx = click.Context(click.Command("test"), retry_cleanup=5)
+
+    with ctx.scope():
+        rv = ctx.with_resource(manager())
+        assert rv[0] == 1
+
+    assert rv == [0]
+
+
+def test_call_on_close_decorator():
+    """call_on_close should still work as a decorator."""
+    called = []
+    ctx = click.Context(click.Command("test"))
+
+    @ctx.call_on_close
+    def my_callback():
+        called.append(True)
+
+    ctx.close()
+    assert called == [True]
+
+
+def test_retry_cleanup_mixed_success_and_failure():
+    """Multiple callbacks: some succeed, some fail after retries."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=2)
+    results = []
+
+    def always_ok():
+        results.append("ok")
+
+    fail_attempts = [0]
+
+    def sometimes_fails():
+        fail_attempts[0] += 1
+        if fail_attempts[0] < 2:
+            raise ValueError("not yet")
+        results.append("eventual_ok")
+
+    ctx.call_on_close(always_ok)
+    ctx.call_on_close(sometimes_fails)
+
+    # close runs in reverse: sometimes_fails first, then always_ok
+    ctx.close()
+    assert results == ["eventual_ok", "ok"]
+
+
+def test_successful_callback_not_run_again():
+    """Callbacks that already succeeded must not run again."""
+    ctx = click.Context(click.Command("test"), retry_cleanup=2)
+    call_count = 0
+
+    def once():
+        nonlocal call_count
+        call_count += 1
+
+    ctx.call_on_close(once)
+    ctx.close()
+    assert call_count == 1
+
+    # close a second time
+    ctx.close()
+    # Should not run again because _close_callbacks was cleared
+    assert call_count == 1
