index 5d4f332..fbadf2d 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -4,6 +4,7 @@ import pytest
 from markupsafe import Markup
 
 from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
 from jinja2.async_utils import auto_aiter
 
 
@@ -251,3 +252,85 @@ def test_custom_async_iteratable_filter(env_async, items):
     )
     out = tmpl.render(items=items)
     assert out == "0,1,2 .. 3,4,5"
+
+
+@mark_dualiter("items", lambda: [{"foo": "a", "bar": 1}, {"foo": "b", "bar": 2}, {"foo": "a", "bar": 3}])
+def test_groupby_separator_async(env_async, items):
+    # Default separator "." splits "foo" into ["foo"] -> works normally.
+    tmpl = env_async.from_string(
+        '{{ items()|groupby("foo")|list }}'
+    )
+    assert tmpl.render(items=items) == "[('a', [{'foo': 'a', 'bar': 1}, {'foo': 'a', 'bar': 3}]), ('b', [{'foo': 'b', 'bar': 2}])]"
+
+
+@mark_dualiter("items", lambda: [{"foo": {"bar": "a"}}, {"foo": {"bar": "b"}}])
+def test_groupby_literal_dot_with_separator_async(env_async, items):
+    # With separator="__", "foo__bar" splits into ["foo", "bar"]
+    # accessing item["foo"]["bar"]. A literal dot in the path is just a character.
+    tmpl = env_async.from_string(
+        '{{ items()|groupby("foo__bar", separator="__")|list }}'
+    )
+    assert tmpl.render(items=items) == "[('a', [{'foo': {'bar': 'a'}}]), ('b', [{'foo': {'bar': 'b'}}])]"
+
+
+@mark_dualiter("items", lambda: [{"foo": [{"name": "Alice"}]}, {"foo": [{"name": "Bob"}]}])
+def test_groupby_multi_char_separator_async(env_async, items):
+    # With separator="::", "foo::0::name" splits into ["foo", 0, "name"]
+    # accessing item["foo"][0]["name"].
+    tmpl = env_async.from_string(
+        '{{ items()|groupby("foo::0::name", separator="::")|list }}'
+    )
+    assert tmpl.render(items=items) == "[('Alice', [{'foo': [{'name': 'Alice'}]}]), ('Bob', [{'foo': [{'name': 'Bob'}]}])]"
+
+
+@mark_dualiter("items", lambda: [{"foo": "a"}, {"foo": "b"}])
+def test_groupby_empty_separator_async(env_async, items):
+    # Empty separator should raise FilterArgumentError on evaluation.
+    tmpl = env_async.from_string(
+        '{{ items()|groupby("foo", separator="")|list }}'
+    )
+    with pytest.raises(FilterArgumentError):
+        tmpl.render(items=items)
+
+
+@mark_dualiter("items", lambda: [{"foo": {"bar": "Alice"}}, {"foo": {"bar": "Bob"}}])
+def test_map_separator_async(env_async, items):
+    # Default separator="." works normally for nested attribute.
+    tmpl = env_async.from_string(
+        '{{ items()|map(attribute="foo.bar")|list }}'
+    )
+    assert tmpl.render(items=items) == "['Alice', 'Bob']"
+
+
+@mark_dualiter("items", lambda: [{"foo.bar": "val"}])
+def test_map_literal_dot_with_separator_async(env_async, items):
+    # With separator="__", ordinary dots are literal; "foo.bar" is not split.
+    tmpl = env_async.from_string(
+        "{{ items()|map(attribute=\"foo.bar\", separator=\"__\")|list }}"
+    )
+    assert tmpl.render(items=items) == "['val']"
+
+
+@mark_dualiter("items", lambda: [{"foo": [{"name": "Alice"}]}, {"foo": [{"name": "Bob"}]}])
+def test_map_multi_char_separator_async(env_async, items):
+    tmpl = env_async.from_string(
+        '{{ items()|map(attribute="foo::0::name", separator="::")|list }}'
+    )
+    assert tmpl.render(items=items) == "['Alice', 'Bob']"
+
+
+@mark_dualiter("items", lambda: [{"foo": "a"}, {"foo": "b"}])
+def test_map_empty_separator_async(env_async, items):
+    tmpl = env_async.from_string(
+        '{{ items()|map(attribute="foo", separator="")|list }}'
+    )
+    with pytest.raises(FilterArgumentError):
+        tmpl.render(items=items)
+
+
+@mark_dualiter("items", lambda: [1, 2, 3])
+def test_map_separator_pass_to_filter_async(env_async, items):
+    tmpl = env_async.from_string(
+        '{{ items()|map("format", separator="__")|list }}'
+    )
+    assert tmpl.render(items=items) == "['1', '2', '3']"
