+
+    def test_groupby_literal_dot_with_separator(self, env):
+        # With separator='__', a plain '.' is just a literal character.
+        # The path 'foo.bar' is not split and looks up item['foo.bar'].
+        tmpl = env.from_string(
+            "{{ items|groupby('foo.bar', separator='__')|list }}"
+        )
+        items = [{'foo.bar': 'x'}, {'foo.bar': 'y'}, {'foo.bar': 'x'}]
+        assert tmpl.render(items=items) == "[('x', [{'foo.bar': 'x'}, {'foo.bar': 'x'}]), ('y', [{'foo.bar': 'y'}])]"
+
+    def test_groupby_multi_char_separator(self, env):
+        # With separator='::', 'foo::0::name' splits into ['foo', 0, 'name']
+        # accessing item['foo'][0]['name'].
+        tmpl = env.from_string(
+            "{{ items|groupby('foo::0::name', separator='::')|list }}"
+        )
+        items = [{'foo': [{'name': 'Alice'}]}, {'foo': [{'name': 'Bob'}]}]
+        assert tmpl.render(items=items) == "[('Alice', [{'foo': [{'name': 'Alice'}]}]), ('Bob', [{'foo': [{'name': 'Bob'}]}])]"
+
+    def test_groupby_empty_separator(self, env):
