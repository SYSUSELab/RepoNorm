+class IsEmail(DirtyEquals[str]):
+    """Checks if the value is a valid email address.
+
+    Args:
+        domain: optional domain to filter by, must match the complete domain exactly and case-sensitively.
+
+    ```py title="IsEmail"
+    from dirty_equals import IsEmail
+
+    assert 'test.email+tag@domain.co.uk' == IsEmail()
+    assert 'user@example.com' == IsEmail('example.com')
+    assert 'user@example.com' != IsEmail('Example.com')
+    assert 'user@sub.example.com' != IsEmail('example.com')
+    assert 'not-an-email' != IsEmail()
+    assert 123 != IsEmail()
+    ```
+    """
+
+    expected_types = (str,)
+
+    def __init__(self, domain: Optional[str] = None):
+        self._domain = domain
+        super().__init__(plain_repr('*') if domain is None else domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Must have exactly one @
+        at_count = other.count('@')
+        if at_count != 1:
+            return False
+
+        local_part, domain_part = other.split('@')
+
+        # Local part must be non-empty
+        if not local_part:
+            return False
+
+        # Local part characters: ASCII letters/digits and _ % + - .
+        if not all(c.isascii() and (c.isalnum() or c in '_%+-.') for c in local_part):
+            return False
+
+        # No leading, trailing or consecutive dots in local part
+        if local_part.startswith('.') or local_part.endswith('.'):
+            return False
+        if '..' in local_part:
+            return False
+
+        # Domain part must be non-empty
+        if not domain_part:
+            return False
+
+        # Optional domain filter: exact match, case-sensitive
+        if self._domain is not None and domain_part != self._domain:
+            return False
+
+        # Domain labels separated by dots
+        labels = domain_part.split('.')
+        if len(labels) < 2:
+            return False
+
+        for label in labels:
+            if not label:
+                return False
+            # Labels use ASCII letters/digits and internal hyphens
+            if not all(c.isascii() and (c.isalnum() or c == '-') for c in label):
+                return False
+            # Cannot start or end with hyphen
+            if label.startswith('-') or label.endswith('-'):
+                return False
+
+        # Final label must consist of at least two ASCII letters
+        final_label = labels[-1]
+        if len(final_label) < 2:
+            return False
+        if not all(c.isascii() and c.isalpha() for c in final_label):
+            return False
+
+        return True
