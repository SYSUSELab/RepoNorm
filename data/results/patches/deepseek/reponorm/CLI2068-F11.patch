+    def _invoke_monitor(
+        self, event: str, pid: int, command: str
+    ) -> None:
+        """Call the monitor_process callback if configured."""
+        if self.monitor_process is not None:
+            try:
+                self.monitor_process(event, pid, command, time.time())
+            except Exception as exc:
+                warnings.warn(
+                    f"monitor_process callback raised: {exc}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+
+    def _wait_and_monitor(
+        self, c: "subprocess.Popen[bytes]", editor: str
+    ) -> int:
+        pid = c.pid
+        cmd = c.args if isinstance(c.args, str) else str(c.args)
+
+        self._invoke_monitor("start", pid, cmd)
+
+        # Platforms without reliable stopped-state monitoring
+        if WIN or not hasattr(os, "WUNTRACED"):
+            exit_code = c.wait()
+            self._invoke_monitor("terminate", pid, cmd)
+            return exit_code
+
+        # POSIX: monitor stop/continue/terminate transitions
+        while True:
+            try:
+                wpid, status = os.waitpid(
+                    pid, os.WUNTRACED | os.WCONTINUED
+                )
+            except ChildProcessError:
+                # Process already reaped, use poll to get exit code
+                c.poll()
+                exit_code = (
+                    c.returncode if c.returncode is not None else 0
+                )
+                self._invoke_monitor("terminate", pid, cmd)
+                return exit_code
+
+            if os.WIFSTOPPED(status):
+                self._invoke_monitor("suspend", pid, cmd)
+            elif os.WIFCONTINUED(status):
+                self._invoke_monitor("resume", pid, cmd)
+            elif os.WIFEXITED(status):
+                c.returncode = os.WEXITSTATUS(status)
+                self._invoke_monitor("terminate", pid, cmd)
+                return c.returncode
+            elif os.WIFSIGNALED(status):
+                c.returncode = -os.WTERMSIG(status)
+                self._invoke_monitor("terminate", pid, cmd)
+                return c.returncode
+            else:
+                # Unknown status, fall back to poll
+                c.poll()
+                exit_code = (
+                    c.returncode if c.returncode is not None else 0
+                )
+                self._invoke_monitor("terminate", pid, cmd)
+                return exit_code
+
