diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..6473491 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,155 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+
+def test_edit_monitor_process(runner):
+    """Test that monitor_process callback captures events in order."""
+    import platform
+    if platform.system() == "Windows":
+        pytest.skip("No sed on Windows.")
+
+    events = []
+
+    def monitor(event, pid, command, timestamp):
+        events.append((event, pid, command, timestamp))
+
+    result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", monitor_process=monitor)
+    assert result == "aTest\nbTest\n"
+
+    assert len(events) >= 2
+    assert events[0][0] == "start"
+    assert events[-1][0] == "terminate"
+    # All events share the same pid
+    pids = {e[1] for e in events}
+    assert len(pids) == 1
+    # Timestamps are non-decreasing
+    ts = [e[3] for e in events]
+    for i in range(1, len(ts)):
+        assert ts[i] >= ts[i - 1]
+
+
+def test_edit_monitor_process_non_callable_raises_type_error():
+    """Test that a non-callable monitor_process raises TypeError."""
+    with pytest.raises(TypeError, match="monitor_process"):
+        click.edit("hello", editor="cat", monitor_process="bad")
+
+
+def test_edit_monitor_process_callback_exception(runner):
+    """Test that callback exceptions produce UserWarning and do not affect execution."""
+    import platform
+    import warnings
+
+    if platform.system() == "Windows":
+        pytest.skip("No sed on Windows.")
+
+    events = []
+
+    def bad_monitor(event, pid, command, timestamp):
+        events.append((event, pid, command, timestamp))
+        if event == "start":
+            raise ValueError("monitor error")
+
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", monitor_process=bad_monitor)
+
+    assert result == "aTest\nbTest\n"
+    assert len(events) == 2  # start + terminate
+    assert events[0][0] == "start"
+    assert events[1][0] == "terminate"
+    assert any("monitor error" in str(x.message) for x in w)
+
+
+def test_edit_monitor_process_fast_exit(runner):
+    """Test that a quickly exiting process still gets start then terminate."""
+    import platform
+    if platform.system() == "Windows":
+        pytest.skip("No cat on Windows.")
+
+    events = []
+
+    def monitor(event, pid, command, timestamp):
+        events.append((event, pid, command, timestamp))
+
+    click.edit("hello", editor="cat", monitor_process=monitor)
+    assert len(events) >= 2
+    assert events[0][0] == "start"
+    assert events[-1][0] == "terminate"
+
+
+def test_edit_monitor_process_editor_class_directly():
+    """Test that Editor class accepts and uses monitor_process."""
+    from click._termui_impl import Editor
+
+    # Non-callable raises TypeError
+    with pytest.raises(TypeError, match="monitor_process"):
+        Editor(monitor_process="bad")
+
+    # None is accepted
+    ed = Editor(editor="cat", monitor_process=None)
+    assert ed.monitor_process is None
+
+    # Valid callable is accepted
+    def dummy(*args):
+        pass
+
+    ed = Editor(editor="cat", monitor_process=dummy)
+    assert ed.monitor_process is dummy
+
+
+def test_edit_monitor_process_edit_file(runner):
+    """Test that edit_file path also monitors correctly."""
+    import platform
+    import tempfile
+    import os
+
+    if platform.system() == "Windows":
+        pytest.skip("No sed on Windows.")
+
+    f = tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False)
+    f.write("original\n")
+    f.close()
+
+    events = []
+
+    def monitor(event, pid, command, timestamp):
+        events.append((event, pid, command, timestamp))
+
+    try:
+        click.edit(editor="sed -i~ 's/original/modified/'", filename=f.name, monitor_process=monitor)
+        with open(f.name) as fh:
+            content = fh.read()
+        assert content == "modified\n"
+    finally:
+        os.unlink(f.name)
+
+    assert len(events) >= 2
+    assert events[0][0] == "start"
+    assert events[-1][0] == "terminate"
+
+
+def test_edit_monitor_process_exception_on_terminate(runner):
+    """Test that exception on terminate does not affect return value."""
+    import platform
+    import warnings
+
+    if platform.system() == "Windows":
+        pytest.skip("No sed on Windows.")
+
+    events = []
+
+    def bad_term(event, pid, command, timestamp):
+        events.append((event, pid, command, timestamp))
+        if event == "terminate":
+            raise RuntimeError("term error")
+
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", monitor_process=bad_term)
+
+    assert result == "aTest\nbTest\n"
+    assert len(events) == 2
+    assert events[0][0] == "start"
+    assert events[1][0] == "terminate"
+    assert any("term error" in str(x.message) for x in w)
