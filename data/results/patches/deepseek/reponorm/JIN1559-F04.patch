+    def _extract_with_metadata(
+        self,
+        source: t.Union[str, nodes.Template],
+        source_name: t.Optional[str] = None,
+        gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        if isinstance(source, str):
+            parsed = self.environment.parse(source)
+            src = source_name if source_name is not None else source
+        else:
+            parsed = source
+            src = source_name if source_name is not None else ""
+
+        for node in parsed.find_all(nodes.Output):
+            if not hasattr(node, "trans_metadata"):
+                continue
+
+            metadata = getattr(node, "trans_metadata", None)
+
+            messages = []
+            for child in node.find_all(nodes.Call):
+                if (
+                    not isinstance(child.node, nodes.Name)
+                    or child.node.name not in gettext_functions
+                ):
+                    continue
+
+                strings: t.List[t.Optional[str]] = []
+                for arg in child.args:
+                    if isinstance(arg, nodes.Const) and isinstance(
+                        arg.value, str
+                    ):
+                        strings.append(arg.value)
+                    else:
+                        strings.append(None)
+
+                for _ in child.kwargs:
+                    strings.append(None)
+                if child.dyn_args is not None:
+                    strings.append(None)
+                if child.dyn_kwargs is not None:
+                    strings.append(None)
+
+                if len(strings) == 1:
+                    msg: t.Union[
+                        t.Optional[str], t.Tuple[t.Optional[str], ...]
+                    ] = strings[0]
+                else:
+                    msg = tuple(strings)
+
+                messages.append(
+                    {
+                        "lineno": child.lineno,
+                        "function": child.node.name,
+                        "message": msg,
+                    }
+                )
+
+            yield {
+                "source": src,
+                "lineno": node.lineno,
+                "metadata": dict(metadata),
+                "messages": messages,
+            }
+
