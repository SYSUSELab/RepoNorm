+class TestExtractWithMetadata:
+    """Tests for Environment.extract_translations_with_metadata."""
+
+    def setup_method(self, method):
+        self.env = Environment(extensions=[InternationalizationExtension])
+        self.env.install_null_translations()
+
+    def test_no_metadata(self):
+        """Without metadata keys, result has empty metadata dict."""
+        results = list(
+            self.env.extract_translations_with_metadata(
+                "{% trans %}Hello{% endtrans %}"
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {}
+        assert len(results[0]["messages"]) == 1
+        assert results[0]["messages"][0]["message"] == "Hello"
+
+    def test_note_key(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="test note" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"note": "test note"}
+        assert results[0]["messages"][0]["message"] == "Hello"
+
+    def test_created_key(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans created="2024-01-01" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"created": "2024-01-01"}
+
+    def test_modified_key(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans modified="2024-01-02" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"modified": "2024-01-02"}
+
+    def test_all_three_keys(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a" created="b" modified="c" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {
+            "note": "a",
+            "created": "b",
+            "modified": "c",
+        }
+
+    def test_any_order(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans modified="z" note="a" created="b" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"]["note"] == "a"
+        assert results[0]["metadata"]["created"] == "b"
+        assert results[0]["metadata"]["modified"] == "z"
+
+    def test_empty_value(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"note": ""}
+
+    def test_unicode_value(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="\\u00e9\\u00e0\\u00fc" %}Hello{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"note": "\u00e9\u00e0\u00fc"}
+
+    def test_with_variables_and_trimmed(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a", count=n, trimmed %} Hello {% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"note": "a"}
+        assert len(results[0]["messages"]) == 1
+
+    def test_with_plural(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a", count=n %}item{% pluralize %}items{% endtrans %}'
+            )
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"note": "a"}
+        msg = results[0]["messages"][0]
+        assert msg["function"] == "ngettext"
+        assert msg["message"] == ("item", "items", None)
+
+    def test_missing_assignment_raises(self):
+        with pytest.raises(TemplateAssertionError) as excinfo:
+            self.env.parse('{% trans note %}Hello{% endtrans %}')
+        assert "note" in str(excinfo.value)
+
+    def test_non_string_value_raises(self):
+        with pytest.raises(TemplateAssertionError) as excinfo:
+            self.env.parse('{% trans note=42 %}Hello{% endtrans %}')
+        assert "note" in str(excinfo.value)
+
+    def test_duplicate_key_raises(self):
+        with pytest.raises(TemplateAssertionError) as excinfo:
+            self.env.parse(
+                '{% trans note="a" note="b" %}Hello{% endtrans %}'
+            )
+        assert "note" in str(excinfo.value)
+        assert "twice" in str(excinfo.value)
+
+    def test_unknown_metadata_key_allowed(self):
+        """Keys not in (note, created, modified) are variables, not metadata."""
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a", count=n %}Hello{% endtrans %}'
+            )
+        )
+        assert results[0]["metadata"] == {"note": "a"}
+
+    def test_record_fields(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a" %}Hello{% endtrans %}',
+                source_name="test.html",
+            )
+        )
+        rec = results[0]
+        assert "source" in rec
+        assert "lineno" in rec
+        assert "metadata" in rec
+        assert "messages" in rec
+        assert rec["source"] == "test.html"
+        assert isinstance(rec["lineno"], int)
+        assert isinstance(rec["metadata"], dict)
+        assert isinstance(rec["messages"], list)
+
+    def test_message_fields(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a", count=n %}item{% pluralize %}items{% endtrans %}'
+            )
+        )
+        msg = results[0]["messages"][0]
+        assert "lineno" in msg
+        assert "function" in msg
+        assert "message" in msg
+        assert msg["function"] == "ngettext"
+
+    def test_source_name(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                "{% trans %}Hello{% endtrans %}",
+                source_name="my_template.html",
+            )
+        )
+        assert results[0]["source"] == "my_template.html"
+
+    def test_ast_input(self):
+        parsed = self.env.parse('{% trans note="a" %}Hello{% endtrans %}')
+        results = list(
+            self.env.extract_translations_with_metadata(parsed)
+        )
+        assert len(results) == 1
+        assert results[0]["metadata"] == {"note": "a"}
+
+    def test_ast_input_with_source_name(self):
+        parsed = self.env.parse('{% trans note="a" %}Hello{% endtrans %}')
+        results = list(
+            self.env.extract_translations_with_metadata(
+                parsed, source_name="from_ast.html"
+            )
+        )
+        assert results[0]["source"] == "from_ast.html"
+
+    def test_multiple_blocks(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a" %}Block1{% endtrans %}'
+                '{% trans note="b" %}Block2{% endtrans %}'
+            )
+        )
+        assert len(results) == 2
+        assert results[0]["metadata"] == {"note": "a"}
+        assert results[1]["metadata"] == {"note": "b"}
+
+    def test_repeated_extraction_stable(self):
+        src = '{% trans note="a" %}Hello{% endtrans %}'
+        r1 = list(self.env.extract_translations_with_metadata(src))
+        r2 = list(self.env.extract_translations_with_metadata(src))
+        assert r1 == r2
+
+    def test_no_retained_state(self):
+        src = '{% trans note="a" %}Hello{% endtrans %}'
+        r1 = list(self.env.extract_translations_with_metadata(src))
+        # Modify the returned records
+        r1[0]["metadata"]["extra"] = "modified"
+        r1[0]["messages"][0]["message"] = "changed"
+        # Re-extract should not reflect modifications
+        r2 = list(self.env.extract_translations_with_metadata(src))
+        assert "extra" not in r2[0]["metadata"]
+        assert r2[0]["messages"][0]["message"] == "Hello"
+
+    def test_ordinary_extract_unchanged(self):
+        """Metadata does not change ordinary extract_translations results."""
+        # Template with metadata
+        r1 = list(
+            self.env.extract_translations(
+                '{% trans note="a" %}Hello{% endtrans %}'
+            )
+        )
+        # Template without metadata
+        r2 = list(
+            self.env.extract_translations(
+                "{% trans %}Hello{% endtrans %}"
+            )
+        )
+        assert r1 == r2
+
+    def test_gettext_functions_parameter(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a" %}Hello{% endtrans %}',
+                gettext_functions=("gettext", "ngettext"),
+            )
+        )
+        assert len(results) == 1
+
+    def test_rendering_unchanged(self):
+        """Metadata does not change rendering output."""
+        t1 = self.env.from_string('{% trans note="test" %}Hello{% endtrans %}')
+        t2 = self.env.from_string("{% trans %}Hello{% endtrans %}")
+        assert t1.render() == t2.render() == "Hello"
+
+    def test_context_with_metadata(self):
+        results = list(
+            self.env.extract_translations_with_metadata(
+                '{% trans note="a" %}Hello{% endtrans %}'
+            )
+        )
+        # Non-plural, no explicit context: message is a plain string
+        assert results[0]["messages"][0]["message"] == "Hello"
+
