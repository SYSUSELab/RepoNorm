+@pytest.mark.anyio
+async def test_stream_listener_stats():
+    """Test StreamListener.stats() behavior throughout the lifecycle."""
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener = StreamListener(
+            signature_field_name="answer",
+            predict_name="predict1",
+        )
+
+        # --- 1. Initial state (before any emission) ---
+        s = listener.stats()
+        assert s["predict_name"] == "predict1"
+        assert s["field"] == "answer"
+        assert s["chunk_count"] == 0
+        assert s["char_count"] == 0
+        assert s["first_ts"] is None
+        assert s["last_ts"] is None
+        assert s["duration_s"] is None
+        assert s["avg_chunk_chars"] == 0.0
+
+        # --- 2. Feed start identifier tokens ---
+        for content in ["[[", " ##", " answer", " ##", " ]]"]:
+            chunk = ModelResponseStream(
+                model="gpt-4o-mini",
+                choices=[StreamingChoices(delta=Delta(content=content))],
+            )
+            result = listener.receive(chunk)
+            assert result is None  # Not yet emitting
+
+        # --- 3. Feed content tokens (need >10 to get individual emits) ---
+        # The first 10 tokens are buffered; token 11+ are emitted individually.
+        # When token 11 arrives, token 1 is dequeued and emitted.
+        tokens = [
+            "Hello", " world", " this", " is", " a", " test", " of", " the",
+            " stats", " method", "!", " More", " text", " here", "."
+        ]
+        emitted_count = 0
+        for token in tokens:
+            chunk = ModelResponseStream(
+                model="gpt-4o-mini",
+                choices=[StreamingChoices(delta=Delta(content=token))],
+            )
+            result = listener.receive(chunk)
+            if result is not None:
+                emitted_count += 1
+                assert isinstance(result, dspy.streaming.StreamResponse)
+
+        # Check that some tokens were emitted (first 10 buffered, rest emitted)
+        assert emitted_count > 0
+
+        # Stats should now reflect emitted chunks
+        s = listener.stats()
+        assert s["predict_name"] == "predict1"
+        assert s["field"] == "answer"
+        assert s["chunk_count"] == emitted_count
+        if emitted_count > 0:
+            assert s["first_ts"] is not None
+            assert s["last_ts"] is not None
+            assert s["duration_s"] is not None
+            assert s["duration_s"] >= 0
+
+        # --- 4. End the stream with end identifier ---
+        for content in ["\n\n", "[[ ##", " completed", " ##", " ]]"]:
+            chunk = ModelResponseStream(
+                model="gpt-4o-mini",
+                choices=[StreamingChoices(delta=Delta(content=content))],
+            )
+            result = listener.receive(chunk)
+
+        # After stream end, stats should be reset to zero
+        s = listener.stats()
+        assert s["chunk_count"] == 0, "Stats should reset after stream end"
+        assert s["char_count"] == 0
+        assert s["first_ts"] is None
+        assert s["last_ts"] is None
+        assert s["duration_s"] is None
+        assert s["avg_chunk_chars"] == 0.0
+
+
+@pytest.mark.anyio
+async def test_stream_listener_stats_cache_hit():
+    """Test stats reset on cache hit (full response in one chunk)."""
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener = StreamListener(
+            signature_field_name="answer",
+            predict_name="predict1",
+        )
+
+        # Verify initial zero state
+        s = listener.stats()
+        assert s["chunk_count"] == 0
+
+        # Send a chunk that contains both start and end identifiers
+        chunk = ModelResponseStream(
+            model="gpt-4o-mini",
+            choices=[StreamingChoices(delta=Delta(
+                content="[[ ## answer ## ]]\n\nHello world!\n\n[[ ## completed ## ]]"
+            ))],
+        )
+        result = listener.receive(chunk)
+        assert result is None  # Cache hit returns None (no individual emissions)
+
+        # Stats should be reset (zeroed) since stream_end was set
+        s = listener.stats()
+        assert s["chunk_count"] == 0
+        assert s["char_count"] == 0
+        assert s["first_ts"] is None
+        assert s["last_ts"] is None
+
+
+@pytest.mark.anyio
+async def test_stream_listener_stats_allow_reuse():
+    """Test stats reset on stream reuse with allow_reuse=True."""
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener = StreamListener(
+            signature_field_name="answer",
+            predict_name="predict1",
+            allow_reuse=True,
+        )
+
+        def make_chunk(content):
+            return ModelResponseStream(
+                model="gpt-4o-mini",
+                choices=[StreamingChoices(delta=Delta(content=content))],
+            )
+
+        # First stream: feed start identifier and content to generate some stats
+        for c in ["[[", " ##", " answer", " ##", " ]]"]:
+            listener.receive(make_chunk(c))
+
+        tokens = ["A", " B", " C", " D", " E", " F", " G", " H", " I", " J", " K"]
+        for t in tokens:
+            listener.receive(make_chunk(t))
+
+        # End first stream
+        for c in ["\n\n", "[[ ##", " completed", " ##", " ]]"]:
+            listener.receive(make_chunk(c))
+
+        # After first stream ends, stats should be zero
+        s = listener.stats()
+        assert s["chunk_count"] == 0
+
+        # Second stream on the same listener (reused)
+        for c in ["[[", " ##", " answer", " ##", " ]]"]:
+            listener.receive(make_chunk(c))
+
+        # Before any content emission, stats should still be zero
+        s = listener.stats()
+        assert s["chunk_count"] == 0
+
+        # Feed content to the second stream
+        for t in ["X", " Y", " Z"]:
+            listener.receive(make_chunk(t))
+
+        # Still no emits yet (buffer < 10)
+        s = listener.stats()
+        assert s["chunk_count"] == 0
+
+        # End second stream - flush triggers
+        for c in ["\n\n", "[[ ##", " completed", " ##", " ]]"]:
+            result = listener.receive(make_chunk(c))
+
+        # After stream end, stats reset to zero
+        s = listener.stats()
+        assert s["chunk_count"] == 0
