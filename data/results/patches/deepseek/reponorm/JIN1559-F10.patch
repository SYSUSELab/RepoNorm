--- a/src/jinja2/ext.py
+++ b/src/jinja2/ext.py
@@ -265,6 +265,55 @@ class InternationalizationExtension(Extension):
             extract_translations=self._extract,
             newstyle_gettext=False,
         )
+        self._translation_versions: t.Dict[str, str] = {}
+        environment.set_translation_version = self._set_translation_version
+        environment.get_translation_version = self._get_translation_version
+        environment.compare_translation_versions = self._compare_translation_versions
+        environment.remove_translation_version = self._remove_translation_version
+        environment.clear_translation_versions = self._clear_translation_versions
+
+
+    def bind(self, environment: Environment) -> "InternationalizationExtension":
+        """Create a copy of this extension bound to another environment.
+        The translation version state is copied for overlay isolation.
+        """
+        rv: "InternationalizationExtension" = super().bind(environment)  # type: ignore[return-value]
+        rv._translation_versions = self._translation_versions.copy()
+        rv._register_version_methods(environment)
+        return rv
+
+    def _register_version_methods(self, environment: Environment) -> None:
+        """Register translation version methods on the given environment."""
+        environment.set_translation_version = self._set_translation_version
+        environment.get_translation_version = self._get_translation_version
+        environment.compare_translation_versions = self._compare_translation_versions
+        environment.remove_translation_version = self._remove_translation_version
+        environment.clear_translation_versions = self._clear_translation_versions
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        """Set the translation version for a message."""
+        self._translation_versions[message] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        """Get the translation version for a message, returning None if unknown."""
+        return self._translation_versions.get(message)
+
+    def _compare_translation_versions(self, message1: str, message2: str) -> bool:
+        """Compare translation versions of two messages.
+        Returns True only when both messages are registered and their
+        versions are equal.
+        """
+        if message1 in self._translation_versions and message2 in self._translation_versions:
+            return self._translation_versions[message1] == self._translation_versions[message2]
+        return False
+
+    def _remove_translation_version(self, message: str) -> None:
+        """Remove the translation version for a message. Harmless if unknown."""
+        self._translation_versions.pop(message, None)
+
+    def _clear_translation_versions(self) -> None:
+        """Remove all translation version entries."""
+        self._translation_versions.clear()
 
     def _install(
         self, translations: "_SupportedTranslations", newstyle: t.Optional[bool] = None
