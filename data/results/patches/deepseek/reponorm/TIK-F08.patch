--- a/tests/test_encoding.py
+++ b/tests/test_encoding.py
@@ -254,3 +254,47 @@ def test_hyp_batch_roundtrip(make_enc: Callable[[], tiktoken.Encoding], batch):
     assert encoded == [enc.encode(t) for t in batch]
     decoded = enc.decode_batch(encoded)
     assert decoded == batch
+
+
+
+def test_repeated_patterns_overlapping_from_helper():
+    """Overlapping counting: three copies of token A contribute two (A,A) occurrences."""
+    from tiktoken.core import _compute_repeated_patterns
+
+    assert _compute_repeated_patterns([1, 1, 1]) == {(1, 1): 2}
+    assert _compute_repeated_patterns([1, 1, 1, 1]) == {(1, 1): 3}
+    assert _compute_repeated_patterns([1, 2, 1, 2]) == {(1, 2): 2, (2, 1): 1}
+
+
+def test_repeated_patterns_fewer_than_three_helper():
+    """If fewer than three distinct pairs exist, all are returned."""
+    from tiktoken.core import _compute_repeated_patterns
+
+    assert len(_compute_repeated_patterns([1, 2])) == 1
+    assert len(_compute_repeated_patterns([1, 2, 3, 4])) == 3  # exactly 3
+    assert len(_compute_repeated_patterns([1, 2, 3])) == 2  # only 2 distinct
+
+
+def test_repeated_patterns_top_three_helper():
+    """At most three most frequent pairs are returned."""
+    from tiktoken.core import _compute_repeated_patterns
+
+    result = _compute_repeated_patterns([5, 5, 5, 5, 6, 7, 6, 7])
+    # pairs: (5,5):3, (5,6):1, (6,7):2, (7,6):1
+    # sorted: (5,5):3, (6,7):2, (5,6):1 (or (7,6):1)
+    assert len(result) <= 3
+    assert result[(5, 5)] == 3
+    assert result[(6, 7)] == 2
+
+
+def test_repeated_patterns_integration():
+    """Integration test using a real encoding produces correct types."""
+    enc = tiktoken.get_encoding("gpt2")
+
+    tokens, patterns = enc.encode("hello world", return_repeated_pattern=True)
+    assert isinstance(tokens, list)
+    assert isinstance(patterns, dict)
+    # The single pair should be present
+    assert len(patterns) <= 3
+    assert all(isinstance(k, tuple) and len(k) == 2 for k in patterns)
+    assert all(isinstance(v, int) for v in patterns.values())
