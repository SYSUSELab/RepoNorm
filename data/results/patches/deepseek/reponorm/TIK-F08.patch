+def _compute_repeated_patterns(
+    tokens: list[int],
+) -> dict[tuple[int, int], int]:
+    """Compute up to three most frequent adjacent token-ID pairs with occurrence counts.
+
+    Overlapping pairs are counted. For example, three consecutive copies of token A
+    contribute two occurrences of (A, A). Empty or single-token sequences return an
+    empty dict. If fewer than three distinct pairs exist, all are returned.
+    """
+    if len(tokens) < 2:
+        return {}
+    counts: dict[tuple[int, int], int] = {}
+    for i in range(len(tokens) - 1):
+        pair = (tokens[i], tokens[i + 1])
+        counts[pair] = counts.get(pair, 0) + 1
+    # Sort by frequency descending, then by pair for determinism
+    sorted_pairs = sorted(counts.items(), key=lambda x: (-x[1], x[0]))
+    return dict(sorted_pairs[:3])
