diff --git a/outlines/types/__init__.py b/outlines/types/__init__.py
index 85af9ad..d0e935b 100644
--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,11 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+
+# Matches IPv6 addresses with exactly eight colon-separated groups of 1-4 hex digits each.
+# This is a textual subset only: it does not support :: compression, zone identifiers,
+# IPv4 tails, or groups longer than four digits.
+ipv6 = Regex(
+    r"[A-Fa-f0-9]{1,4}(:[A-Fa-f0-9]{1,4}){7}"
+)
diff --git a/tests/types/test_dsl.py b/tests/types/test_dsl.py
index 4e13b1d..573fd3e 100644
--- a/tests/types/test_dsl.py
+++ b/tests/types/test_dsl.py
@@ -789,3 +789,46 @@ def test_dsl_handle_dict():
     assert result.terms[1].term.terms[2] == types.string
     assert result.terms[1].term.terms[3] == KleeneStar(Sequence([String(", "), types.integer, String(":"), types.string]))
     assert result.terms[2] == String("}")
+
+
+def test_dsl_ipv6():
+    """Test that the ipv6 Regex type matches full-form IPv6 addresses only."""
+    ipv6 = types.ipv6
+    assert isinstance(ipv6, Regex)
+    assert ipv6.pattern == r"[A-Fa-f0-9]{1,4}(:[A-Fa-f0-9]{1,4}){7}"
+
+    # Valid full-form IPv6 addresses (eight groups, 1-4 hex digits each)
+    valid_addresses = [
+        "2001:0db8:85a3:0000:0000:8a2e:0370:7334",
+        "2001:db8:85a3:0:0:8a2e:370:7334",
+        "0000:0000:0000:0000:0000:0000:0000:0001",
+        "FFFF:ffff:0000:0000:0000:0000:0000:0000",
+        "1:2:3:4:5:6:7:8",
+        "0123:4567:89ab:cdef:ABCD:EF01:2345:6789",
+        "a:b:c:d:e:f:A:B",
+        "1234:5678:9abc:def0:1234:5678:9ABC:DEF0",
+    ]
+    for addr in valid_addresses:
+        assert ipv6.matches(addr), f"Expected {addr!r} to be a valid IPv6 address"
+
+    # Invalid addresses
+    invalid_addresses = [
+        "::1",                              # empty groups / compression
+        "1:2:3:4:5:6:7:8:9",               # nine groups
+        "2001:db8::1",                      # :: compression
+        "::ffff:192.0.2.1",                 # compression + IPv4 tail
+        "2001:db8:85a3::8a2e:370:7334",     # compression
+        ":1:2:3:4:5:6:7",                   # leading empty group
+        "1:2:3:4:5:6:7:",                   # trailing empty group
+        "1:2:3:4:5:6:7:8:",                 # trailing colon + extra
+        "GHIJ:0000:0000:0000:0000:0000:0000:0000",  # non-hex chars
+        "1:2:3:4:5:6:7:12345",              # group with 5 hex digits
+        "",                                  # empty string
+        "2001:db8:85a3:0:0:8a2e:370:7334:extra",  # too many groups
+        "2001:db8:85a3::8a2e:0370:7334",     # compression
+        "fe80::1%eth0",                      # zone identifier
+        "::",                                # all zero compression
+        "1:2:3:4:5:6:1.2.3.4",             # IPv4 tail
+    ]
+    for addr in invalid_addresses:
+        assert not ipv6.matches(addr), f"Expected {addr!r} to be an invalid IPv6 address"
