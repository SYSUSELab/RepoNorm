--- a/tests/test_encoding.py
+++ b/tests/test_encoding.py
@@ -254,3 +254,103 @@ def test_hyp_batch_roundtrip(make_enc: Callable[[], tiktoken.Encoding], batch):
     assert encoded == [enc.encode(t) for t in batch]
     decoded = enc.decode_batch(encoded)
     assert decoded == batch
+
+
+# ====================
+# Token frequency (analyze_frequency)
+# ====================
+
+
+def test_encode_with_frequency():
+    """analyze_frequency=True returns (tokens, freq_dict) without changing token order."""
+    enc = tiktoken.get_encoding("cl100k_base")
+
+    # Default (False) keeps original return type
+    tokens = enc.encode("hello world")
+    assert isinstance(tokens, list)
+    assert all(isinstance(t, int) for t in tokens)
+
+    # With frequency
+    tokens2, freq = enc.encode("hello world", analyze_frequency=True)
+    assert tokens2 == tokens
+    assert isinstance(freq, dict)
+    assert freq == {t: 1 for t in tokens}
+
+
+def test_encode_frequency_repeated():
+    """Repeated tokens inside a single document are counted correctly."""
+    enc = tiktoken.get_encoding("r50k_base")
+
+    tokens, freq = enc.encode("0" * 20, analyze_frequency=True)
+    # Verify roundtrip consistency
+    assert sorted(freq.values(), reverse=True)[0] > 0
+    assert sum(freq.values()) == len(tokens)
+
+
+def test_encode_frequency_empty():
+    """Empty string with analyze_frequency returns ([], {})."""
+    enc = tiktoken.get_encoding("r50k_base")
+    assert enc.encode("", analyze_frequency=True) == ([], {})
+
+
+def test_encode_frequency_special_tokens():
+    """Special token policy is respected when computing frequency."""
+    enc = tiktoken.get_encoding("cl100k_base")
+    eot = enc.eot_token
+
+    # Allowed special tokens appear in frequency
+    tokens, freq = enc.encode("<|endoftext|>", allowed_special="all", analyze_frequency=True)
+    assert eot in tokens
+    assert freq[eot] == 1
+
+    # Disallowed special raises error even with analyze_frequency
+    with pytest.raises(ValueError):
+        enc.encode("<|endoftext|>", analyze_frequency=True)
+
+
+def test_batch_encode_with_frequency():
+    """encode_batch with analyze_frequency=True returns (docs, corpus_freq)."""
+    enc = tiktoken.get_encoding("r50k_base")
+
+    # Default (False) keeps original return type
+    docs = enc.encode_batch(["hello world", "goodbye world"])
+    assert isinstance(docs, list)
+
+    # With frequency
+    docs2, corpus_freq = enc.encode_batch(["hello world", "goodbye world"], analyze_frequency=True)
+    assert docs2 == docs
+    assert isinstance(corpus_freq, dict)
+    # Each token from any document contributes to the count
+    all_tokens = [t for d in docs2 for t in d]
+    assert sum(corpus_freq.values()) == len(all_tokens)
+    assert all(corpus_freq[t] >= 1 for t in all_tokens)
+
+
+def test_batch_encode_frequency_repeated_documents():
+    """Counts are summed across every document, including repeated documents."""
+    enc = tiktoken.get_encoding("r50k_base")
+
+    _, freq1 = enc.encode_batch(["hello world", "hello world"], analyze_frequency=True)
+    _, freq2 = enc.encode_batch(["hello world"], analyze_frequency=True)
+    # Repeated documents double frequencies
+    for token, count in freq2.items():
+        assert freq1[token] == count * 2, f"Token {token}: expected {count*2}, got {freq1[token]}"
+
+
+def test_batch_encode_frequency_empty():
+    """Empty batch with analyze_frequency returns ([], {})."""
+    enc = tiktoken.get_encoding("r50k_base")
+    assert enc.encode_batch([], analyze_frequency=True) == ([], {})
+    assert enc.encode_batch([]) == []
+
+
+def test_batch_encode_frequency_thread_consistency():
+    """Batch thread count must not change the frequency summary."""
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = ["hello world", "goodbye world", "hello there"]
+
+    docs_1, freq_1 = enc.encode_batch(text, num_threads=1, analyze_frequency=True)
+    docs_8, freq_8 = enc.encode_batch(text, num_threads=8, analyze_frequency=True)
+
+    assert docs_1 == docs_8
+    assert freq_1 == freq_8
