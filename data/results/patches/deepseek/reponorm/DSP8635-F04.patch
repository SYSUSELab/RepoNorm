+def truncate_description(description, max_chars):
+    """Truncate description to at most max_chars characters.
+    
+    Args:
+        description: String to truncate, or None.
+        max_chars: Maximum allowed length, or None to disable.
+    
+    Returns:
+        Truncated string, or original if unchanged.
+    """
+    if max_chars is None or description is None:
+        return description
+    if len(description) <= max_chars:
+        return description
+    if max_chars == 1:
+        return "\u2026"
+    
+    cap = max_chars
+    max_content_len = cap - 1  # reserve 1 char for ellipsis
+    text_prefix = description[:max_content_len]
+    
+    # Find last complete sentence ending (. ! ?) followed by whitespace or end of string
+    matches = list(re.finditer(r'[.!?](?:\s|$)', text_prefix))
+    if matches:
+        last_match = matches[-1]
+        end_pos = last_match.end()
+        truncated = description[:end_pos]
+    else:
+        truncated = description[:max_content_len]
+    
+    truncated = truncated.rstrip()
+    return truncated + "\u2026"
+
