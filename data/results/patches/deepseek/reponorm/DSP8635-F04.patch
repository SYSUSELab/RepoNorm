+from dspy.propose.grounded_proposer import truncate_description
+
+
+class TestTruncateDescription:
+    """Tests for the truncate_description helper function."""
+
+    def test_none_disables(self):
+        """None max_chars returns description unchanged."""
+        assert truncate_description("Hello world", None) == "Hello world"
+
+    def test_none_description(self):
+        """None description with a cap returns None."""
+        assert truncate_description(None, 100) is None
+
+    def test_already_within_cap(self):
+        """Description shorter than cap is unchanged."""
+        assert truncate_description("Hi", 2000) == "Hi"
+
+    def test_exactly_at_cap(self):
+        """Description exactly at cap is unchanged."""
+        assert truncate_description("Hello!", 6) == "Hello!"
+
+    def test_cap_one_produces_ellipsis(self):
+        """A cap of 1 produces only the ellipsis character."""
+        assert truncate_description("Hello world!", 1) == "\u2026"
+
+    def test_finds_last_sentence_ending(self):
+        """Overlong text is truncated at the last complete sentence that fits within cap-1."""
+        result = truncate_description("First sentence. Second sentence. More text.", 30)
+        # cap-1=29 characters for prefix: "First sentence. Second senten"
+        # Last sentence-ending match: ". " at position 14 → end_pos=16
+        # truncated = "First sentence. " → rstrip → "First sentence." → + "…"
+        assert result == "First sentence.\u2026"
+
+    def test_exclamation_sentence_ending(self):
+        """Exclamation mark is recognized as a sentence ending."""
+        result = truncate_description("Hello world! More text.", 14)
+        # cap-1=13: "Hello world! M"
+        # Match: "! " at 11-13 → end_pos=13
+        # truncated = "Hello world! " → rstrip → "Hello world!" → + "…"
+        assert result == "Hello world!\u2026"
+
+    def test_question_sentence_ending(self):
+        """Question mark is recognized as a sentence ending."""
+        result = truncate_description("Is this working? Yes it is.", 20)
+        # cap-1=19: "Is this working? Ye"
+        # Match: "? " at 15-17 → end_pos=17
+        # truncated = "Is this working? " → rstrip → "Is this working?" → + "…"
+        assert result == "Is this working?\u2026"
+
+    def test_no_sentence_ending_uses_hard_prefix(self):
+        """No sentence-ending punctuation in prefix results in a hard truncation."""
+        result = truncate_description("No punctuation here just text", 20)
+        # cap-1=19: "No punctuation here " - no matches
+        # hard prefix → rstrip → + "…"
+        assert result == "No punctuation here\u2026"
+        assert len(result) == 20
+
+    def test_trailing_whitespace_stripped(self):
+        """Trailing whitespace after the sentence ending is stripped before appending ellipsis."""
+        result = truncate_description("End.   Extra stuff after", 10)
+        # cap-1=9: "End.   Ex"
+        # Match ".   " → '.' at pos 3, first space at pos 4 → end_pos=5
+        # truncated = "End. " → rstrip → "End." → + "…"
+        assert result == "End.\u2026"
+
+    def test_sentence_ending_at_string_end_matches_dollar(self):
+        """Sentence ending at the end of the prefix (matched by \$)."""
+        result = truncate_description("End! More text.", 5)
+        # cap=5, max_content_len=4: "End!" which is exactly 4 chars
+        # prefix "End!" - match '!' followed by end-of-string ($) at positions 3-4 -> end_pos=4
+        # truncated = "End!" (no change, rstrip doesn't change) -> + "…" -> "End!…" (5 chars)
+
+class TestGroundedProposerValidation:
+    """Tests for GroundedProposer max_description_chars parameter validation."""
+
+    def test_default_is_2000(self):
+        """Default max_description_chars should be 2000."""
+        import dspy
+        from dspy.utils.dummies import DummyLM
+
+        prompt_model = DummyLM([{"proposed_instruction": "test"}])
+        program = dspy.Predict("question -> answer")
+        proposer = GroundedProposer(
+            prompt_model=prompt_model, program=program, trainset=[], verbose=False
+        )
+        assert proposer.max_description_chars == 2000
+
+    def test_none_allowed(self):
+        """None should be accepted."""
+        import dspy
+        from dspy.utils.dummies import DummyLM
+
+        prompt_model = DummyLM([{"proposed_instruction": "test"}])
+        program = dspy.Predict("question -> answer")
+        proposer = GroundedProposer(
+            prompt_model=prompt_model, program=program, trainset=[],
+            verbose=False, max_description_chars=None
+        )
+        assert proposer.max_description_chars is None
+
+    def test_bool_rejected(self):
+        """Boolean values should raise ValueError."""
+        import dspy
+        from dspy.utils.dummies import DummyLM
+
+        prompt_model = DummyLM([{"proposed_instruction": "test"}])
+        program = dspy.Predict("question -> answer")
+        with pytest.raises(ValueError, match="max_description_chars must be None or a positive integer"):
+            GroundedProposer(
