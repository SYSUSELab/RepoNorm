--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -379,6 +379,61 @@ def test_fast_edit(runner):
     result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'")
     assert result == "aTest\nbTest\n"
 
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_timeout_none(runner):
+    """timeout=None preserves existing behavior."""
+    result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", timeout=None)
+    assert result == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_timeout_positive(runner):
+    """A positive timeout works with a fast editor."""
+    result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", timeout=30)
+    assert result == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="Bash not available on Windows.")
+class TestEditTimeoutExpired:
+    def test_edit_timeout_expires(self, runner):
+        """A slow editor times out and raises ClickException."""
+        with pytest.raises(click.ClickException) as exc_info:
+            click.edit("test", editor="bash -c 'sleep 10'", timeout=1)
+        msg = exc_info.value.format_message()
+        assert "Editing timed out after 1 seconds" in msg
+
+    def test_edit_timeout_expires_with_filename(self, runner):
+        """Timeout works with a direct filename."""
+        import tempfile, os
+        f = tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False)
+        f.write("hello")
+        f.close()
+        try:
+            with pytest.raises(click.ClickException) as exc_info:
+                click.edit(filename=f.name, editor="bash -c 'sleep 10'", timeout=1)
+            msg = exc_info.value.format_message()
+            assert "Editing timed out after 1 seconds" in msg
+        finally:
+            os.unlink(f.name)
+
+
+def test_edit_timeout_invalid_values(runner):
+    """Invalid timeout values raise ValueError."""
+    for val in [0, -1, True, "foo", 1.5]:
+        with pytest.raises(ValueError, match="timeout must be a positive integer or None"):
+            click.edit("test", editor="sed", timeout=val)
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="Bash not available on Windows.")
+def test_edit_timeout_fail_before_timeout(runner):
+    """Non-zero exit before timeout still raises Editing failed."""
+    with pytest.raises(click.ClickException) as exc_info:
+        click.edit("test", editor="false", timeout=30)
+    msg = exc_info.value.format_message()
+    assert "Editing failed" in msg
+    assert "timed out" not in msg
+
+
 
