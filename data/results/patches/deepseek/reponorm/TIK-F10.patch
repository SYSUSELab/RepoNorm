--- a/tests/test_encoding.py
+++ b/tests/test_encoding.py
@@ -254,3 +254,128 @@ def test_hyp_batch_roundtrip(make_enc: Callable[[], tiktoken.Encoding], batch):
     assert encoded == [enc.encode(t) for t in batch]
     decoded = enc.decode_batch(encoded)
     assert decoded == batch
+
+# ====================
+# Cache encoding
+# ====================
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_basic_hit(make_enc: Callable[[], tiktoken.Encoding]):
+    """Cache hit returns same result as cache miss."""
+    enc = make_enc()
+    text = "hello world"
+    expected = enc.encode(text)
+    cached = enc.encode(text, use_cache=True)
+    assert cached == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_returns_copy(make_enc: Callable[[], tiktoken.Encoding]):
+    """Returned list must not allow mutation of cached value."""
+    enc = make_enc()
+    text = "hello world"
+    tokens = enc.encode(text, use_cache=True)
+    tokens.append(-1)
+    tokens2 = enc.encode(text, use_cache=True)
+    assert tokens2 == enc.encode(text), "Cache should return independent copy"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_policies_independent(make_enc: Callable[[], tiktoken.Encoding]):
+    """Different special-token policies must not share cache entries."""
+    enc = make_enc()
+    text = "<|endoftext|> hello"
+    tokens_all = enc.encode(text, allowed_special="all", use_cache=True)
+    tokens_none = enc.encode(text, disallowed_special=(), use_cache=True)
+    assert tokens_all != tokens_none, "Different policies must yield different results"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_raises_on_disallowed(make_enc: Callable[[], tiktoken.Encoding]):
+    """Disallowed-special validation must not be bypassed by earlier cached calls under a different policy."""
+    enc = make_enc()
+    text = "<|endoftext|>"
+    # Warm cache with allowed_special="all"
+    enc.encode(text, allowed_special="all", use_cache=True)
+    # Now call with default disallowed_special="all" — should still raise
+    with pytest.raises(ValueError):
+        enc.encode(text, use_cache=True)
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_batch(make_enc: Callable[[], tiktoken.Encoding]):
+    """encode_batch with use_cache preserves order and matches single encode."""
+    enc = make_enc()
+    texts = ["hello world", "goodbye world"]
+    expected = [enc.encode(t) for t in texts]
+    batch_result = enc.encode_batch(texts, use_cache=True)
+    assert batch_result == expected
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_isolated_instances(make_enc: Callable[[], tiktoken.Encoding]):
+    """Different Encoding instances must have isolated caches."""
+    enc1 = make_enc()
+    enc2 = make_enc()
+    text = "hello world"
+    enc1.encode(text, use_cache=True)
+    # enc2 starts with empty cache — should compute and not share state
+    result = enc2.encode(text, use_cache=True)
+    assert result == enc1.encode(text)
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_eviction(make_enc: Callable[[], tiktoken.Encoding]):
+    """LRU eviction must work — inserting beyond capacity evicts least recently used."""
+    enc = make_enc()
+    # Fill cache with distinct texts
+    texts = [f"unique text {i}" for i in range(130)]
+    for t in texts:
+        enc.encode(t, use_cache=True)
+    # The first few should have been evicted
+    # Verify the most recent 128 are still cached
+    for i in range(2, 130):
+        result = enc.encode(texts[i], use_cache=True)
+        assert result == enc.encode(texts[i]), f"Text {i} should be in cache"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_special_policy_not_contaminated(make_enc: Callable[[], tiktoken.Encoding]):
+    """A cache entry created under one policy must not be returned for a different policy."""
+    enc = make_enc()
+    text = "<|endoftext|>"
+    # Policy 1: treat endoftext as a single special token
+    r1 = enc.encode(text, allowed_special={"<|endoftext|>"}, use_cache=True)
+    # Policy 2: don't allow any special tokens (encode as natural text)
+    r2 = enc.encode(text, allowed_special=set(), disallowed_special=(), use_cache=True)
+    assert r1 != r2, "Different policies must produce different results"
+    # Re-using policy 1 should return cached result
+    r3 = enc.encode(text, allowed_special={"<|endoftext|>"}, use_cache=True)
+    assert r3 == r1, "Same policy should produce cache hit"
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_cache_batch_use_cache_default(make_enc: Callable[[], tiktoken.Encoding]):
+    """encode_batch default use_cache=False must preserve existing behavior."""
+    enc = make_enc()
+    texts = ["hello world"]
+    # Should work the same as before (no TypeError about unexpected keyword)
+    result = enc.encode_batch(texts)
+    assert result == [enc.encode("hello world")]
+
+
+def test_cache_concurrent_safety():
+    """Concurrent cache hits, insertion, and eviction must not corrupt results or raise cache-race errors."""
+    import concurrent.futures
+    enc = tiktoken.get_encoding("cl100k_base")
+    texts = [f"thread test text {i}" for i in range(200)]
+
+    def encode_text(t):
+        return enc.encode(t, use_cache=True)
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as executor:
+        results = list(executor.map(encode_text, texts))
+    # Verify all results are correct
+    expected = [enc.encode(t) for t in texts]
+    assert results == expected
