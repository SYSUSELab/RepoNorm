+class TestConditionalI18nExtension:
+    """Tests for the ConditionalI18nExtension with {% ctrans %} tag."""
+
+    def setup_env(self):
+        """Create a fresh environment with ConditionalI18nExtension."""
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.ctrans"])
+        env.globals.update(
+            {
+                "_": gettext,
+                "gettext": gettext,
+                "ngettext": ngettext,
+                "pgettext": pgettext,
+                "npgettext": npgettext,
+            }
+        )
+        return env
+
+    def test_ctrans_true_basic(self):
+        """Condition true renders the translation block."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans True %}hello{% fallback %}world{% endctrans %}"
+        )
+        assert tmpl.render() == "hello"
+
+    def test_ctrans_false_basic(self):
+        """Condition false renders the fallback block."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans False %}hello{% fallback %}world{% endctrans %}"
+        )
+        assert tmpl.render() == "world"
+
+    def test_ctrans_variable_condition(self):
+        """Condition can be a variable."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans x %}hello{% fallback %}world{% endctrans %}"
+        )
+        assert tmpl.render(x=True) == "hello"
+        assert tmpl.render(x=False) == "world"
+
+    def test_ctrans_var_in_true_branch(self):
+        """Variables can be used in the translatable body."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans True %}Hello {{ name }}{% fallback %}World{% endctrans %}"
+        )
+        assert tmpl.render(name="Alice") == "Hello Alice"
+
+    def test_ctrans_var_in_fallback(self):
+        """Fallback body can reference template variables."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans flag %}Hello{% fallback %}World {{ name }}{% endctrans %}"
+        )
+        assert tmpl.render(flag=False, name="Bob") == "World Bob"
+
+    def test_ctrans_fallback_with_filter(self):
+        """Fallback body can include filters."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans flag %}hello{% fallback %}{{ word|upper }}{% endctrans %}"
+        )
+        assert tmpl.render(flag=False, word="world") == "WORLD"
+
+    def test_ctrans_plural(self):
+        """Plural selector works in the translation branch."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans True, count %}There is {{ count }} apple"
+            "{% pluralize %}There are {{ count }} apples"
+            "{% fallback %}Fallback{% endctrans %}"
+        )
+        # Note: endctrans closes the block
+        result1 = tmpl.render(count=1)
+        assert "There is 1 apple" in result1
+        result2 = tmpl.render(count=3)
+        assert "There are 3 apples" in result2
+
+    def test_ctrans_plural_condition_false(self):
+        """When condition is false, fallback is shown (plural in true branch ignored)."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans False, count %}singular{% pluralize %}plural"
+            "{% fallback %}fallback {{ count }}{% endctrans %}"
+        )
+        assert tmpl.render(count=5) == "fallback 5"
+
+    def test_ctrans_context(self):
+        """Context selects pgettext/npgettext in the true branch."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            '{% ctrans True context="button" %}Click{% fallback %}Not click{% endctrans %}'
+        )
+        result = tmpl.render(LANGUAGE="de")
+        # 'Apple' with context 'fruit' -> 'Apple'; check that context works
+        assert result == "Click"
+
+    def test_ctrans_trimmed(self):
+        """Trimmed whitespace in translatable body."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans True trimmed %}  hello\n  world  {% fallback %}  foo\n  bar  {% endctrans %}"
+        )
+        assert tmpl.render() == "hello world"
+
+    def test_ctrans_notrimmed(self):
+        """notrimmed preserves whitespace in translatable body."""
+        env = self.setup_env()
+        tmpl = env.from_string(
+            "{% ctrans True notrimmed %}  hello\n\n  world  {% fallback %}bye{% endctrans %}"
+        )
+        # The trans branch is notrimmed, so whitespace is preserved
+        # (but fallback is always ordinary Jinja body which strips block whitespace)
+        result = tmpl.render()
+        assert "hello" in result
+        assert "world" in result
+
+    def test_ctrans_extract(self):
+        """Extraction reports only the true translation message."""
+        from jinja2.ext import extract_from_ast
+
+        env = self.setup_env()
+        ast = env.parse(
+            "{% ctrans True %}Hello{% fallback %}World{% endctrans %}"
+        )
+        result = list(extract_from_ast(ast))
+        assert result == [(1, "gettext", "Hello")]
+
+    def test_ctrans_extract_plural(self):
+        """Extraction of plural ctrans block."""
+        from jinja2.ext import extract_from_ast
+
+        env = self.setup_env()
+        ast = env.parse(
+            "{% ctrans True, count %}{{ count }} item"
+            "{% pluralize %}{{ count }} items"
+            "{% fallback %}fallback{% endctrans %}"
+        )
+        result = list(extract_from_ast(ast))
+        assert len(result) == 1
+        func, msg = result[0][1], result[0][2]
+        assert func == "ngettext"
+        assert msg[0] == "%(count)s item"
+        assert msg[1] == "%(count)s items"
+
+    def test_ctrans_extract_context(self):
+        """Extraction of ctrans block with context."""
+        from jinja2.ext import extract_from_ast
+
+        env = self.setup_env()
+        ast = env.parse(
+            '{% ctrans True context="button" %}Click{% fallback %}Not click{% endctrans %}'
+        )
+        result = list(extract_from_ast(ast))
+        assert len(result) == 1
+        func, msg = result[0][1], result[0][2]
+        assert func == "pgettext"
+        assert msg == ("button", "Click")
+
+    def test_ctrans_extract_multiple(self):
+        """Multiple ctrans blocks are extracted."""
+        from jinja2.ext import extract_from_ast
+
+        env = self.setup_env()
+        ast = env.parse(
+            "{% ctrans True %}First{% fallback %}f1{% endctrans %}"
+            "{% ctrans False %}Second{% fallback %}f2{% endctrans %}"
+        )
+        result = list(extract_from_ast(ast))
+        assert len(result) == 2
+        assert result[0][2] == "First"
+        assert result[1][2] == "Second"
+
+    def test_ctrans_fallback_gettext_extracted(self):
+        """gettext in fallback is extracted independently."""
+        from jinja2.ext import extract_from_ast
+
+        env = self.setup_env()
+        ast = env.parse(
+            "{% ctrans True %}Hello{% fallback %}{{ gettext('World') }}{% endctrans %}"
+        )
+        result = list(extract_from_ast(ast))
+        # Both the ctrans message and the independent gettext call in fallback
+        assert len(result) == 2
+        assert ("gettext", "Hello") in [(r[1], r[2]) for r in result]
+        assert ("gettext", "World") in [(r[1], r[2]) for r in result]
+
+    def test_ctrans_newstyle(self):
+        """Newstyle gettext with ctrans."""
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.ctrans"])
+        env.install_gettext_callables(
+            gettext, ngettext, newstyle=True, pgettext=pgettext, npgettext=npgettext
+        )
+        tmpl = env.from_string(
+            "{% ctrans x, name=user %}Hello {{ name }}{% fallback %}Bye {{ user }}{% endctrans %}"
+        )
+        assert tmpl.render(x=True, user="Alice") == "Hello Alice"
+        assert tmpl.render(x=False, user="Bob") == "Bye Bob"
+
+    def test_ctrans_missing_fallback(self):
+        """Missing fallback raises TemplateSyntaxError."""
+        env = self.setup_env()
+        with pytest.raises(TemplateSyntaxError, match="fallback"):
+            env.from_string(
+                "{% ctrans True %}hello{% endctrans %}"
+            )
+
+    def test_ctrans_duplicate_context(self):
+        """Duplicate context raises TemplateAssertionError."""
+        env = self.setup_env()
+        with pytest.raises(TemplateAssertionError, match="duplicate context"):
+            env.from_string(
+                '{% ctrans True context="a", context="b" %}hello{% fallback %}world{% endctrans %}'
+            )
+
+    def test_ctrans_nonliteral_context(self):
+        """Non-literal context raises TemplateAssertionError."""
+        env = self.setup_env()
+        with pytest.raises(TemplateAssertionError, match="literal"):
+            env.from_string(
+                "{% ctrans True context=x %}hello{% fallback %}world{% endctrans %}"
+            )
+
+    def test_ctrans_unclosed_block(self):
+        """Unclosed ctrans block raises TemplateSyntaxError."""
+        env = self.setup_env()
+        with pytest.raises(TemplateSyntaxError, match="Unexpected end of template"):
+            env.from_string(
+                "{% ctrans True %}hello{% fallback %}world"
+            )
