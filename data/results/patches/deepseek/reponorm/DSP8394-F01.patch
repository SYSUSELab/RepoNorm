                 # Disk cache writing can fail for different reasons, e.g. disk full or the `value` is not picklable.
                 logger.debug(f"Failed to put value in disk cache: {value}, {e}")
 
+    @contextmanager
+    def bypass(self):
+        """Synchronous context manager that bypasses cache reads while retaining writes.
+
+        Within this context, reads behave as cache misses even when a value is stored.
+        Writes remain enabled according to the existing memory/disk configuration.
+        After the context ends, newly written values can be read normally.
+
+        Nested contexts retain bypass until their outer context exits.
+        Normal and exceptional exits restore the previous state.
+        Bypass is local to the current thread/asynchronous execution context.
+        """
+        current = _bypass_state.get()
+        instance_id = id(self)
+        new_state = {**current}
+        new_state[instance_id] = current.get(instance_id, 0) + 1
+        token = _bypass_state.set(new_state)
+        try:
+            yield
+        finally:
+            _bypass_state.reset(token)
+
     def reset_memory_cache(self) -> None:
