+    def _select_tip_key(self):
+        """Select a tip key using tip_weights for weighted random selection."""
+        keys = list(TIPS.keys())
+
+        if self.tip_weights is None:
+            return self.rng.choice(keys)
+
+        # Build effective weights for each TIPS key
+        effective_weights = []
+
+        for key in keys:
+            if key in self.tip_weights:
+                w = self.tip_weights[key]
+                # Check if weight is usable (positive finite int/float, not bool)
+                if isinstance(w, bool):
+                    effective_weights.append(0)
+                elif isinstance(w, (int, float)):
+                    if w > 0 and math.isfinite(w):
+                        effective_weights.append(w)
+                    else:
+                        effective_weights.append(0)
+                else:
+                    # Non-numeric -> weight 0
+                    effective_weights.append(0)
+            else:
+                # Missing key -> weight 1
+                effective_weights.append(1)
+
+        # If all weights are zero, use uniform selection
+        if all(w == 0 for w in effective_weights):
+            return self.rng.choice(keys)
+
+        return self.rng.choices(keys, weights=effective_weights, k=1)[0]
+
