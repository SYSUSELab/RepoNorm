+def _resolve_condition(conditional_filters):
+    """Determine which condition key to select based on environment variables.
+
+    Parameters
+    ----------
+    conditional_filters : dict or None
+        Mapping of condition names to filter dicts.
+
+    Returns
+    -------
+    str or None
+        The selected condition key, or None if no conditional filters.
+    """
+    if not conditional_filters:
+        return None
+
+    # Priority-ordered standard conditions (ASCII case-insensitive)
+    standard_conditions = [
+        (
+            "debug",
+            lambda: os.environ.get("OUTLINES_DEBUG", "").lower() == "true",
+        ),
+        (
+            "production",
+            lambda: os.environ.get("ENVIRONMENT", "").lower() == "production",
+        ),
+        (
+            "testing",
+            lambda: (
+                os.environ.get("ENV", "").lower() == "testing"
+                or os.environ.get("OUTLINES_TESTING", "").lower() == "true"
+                or os.environ.get("TESTING_MODE", "").lower() == "on"
+            ),
+        ),
+    ]
+
+    for name, check in standard_conditions:
+        if name in conditional_filters and check():
+            return name
+
+    # Fallback: alphabetically first supplied key
+    return sorted(conditional_filters.keys())[0]
+
+
+
 
