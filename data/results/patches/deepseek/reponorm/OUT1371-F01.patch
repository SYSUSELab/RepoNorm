+# ---------------------------------------------------------------------------
+# Custom Jinja filters
+# ---------------------------------------------------------------------------
+
+def surround(value, left, right):
+    return f"{left}{value}{right}"
+
+
+def upper(value):
+    return value.upper()
+
+
+def repeat(value, times):
+    return value * times
+
+
+def reverse(value):
+    return value[::-1]
+
+
+class TestCustomFilters:
+    """Tests for the `filters` argument on Prompt and @prompt."""
+
+    def test_decorator_custom_filter(self):
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        assert tagged("hello") == "<hello>"
+
+    def test_bare_decorator_still_works(self):
+        @outlines.prompt
+        def bare(text):
+            """{{ text }}"""
+
+        assert bare("hello") == "hello"
+
+    def test_empty_parens_decorator_still_works(self):
+        @outlines.prompt()
+        def empty(text):
+            """{{ text }}"""
+
+        assert empty("hello") == "hello"
+
+    def test_decorator_overrides_builtin(self):
+        @outlines.prompt(filters={"name": surround})
+        def overridden(text):
+            """{{ text | name("<", ">") }}"""
+
+        assert overridden("hello") == "<hello>"
+
+    def test_from_str_custom_filter(self):
+        prompt = Prompt.from_str(
+            '{{ text | upper }}', filters={"upper": upper}
+        )
+        assert prompt(text="hello") == "HELLO"
+
+    def test_from_str_without_filters(self):
+        prompt = Prompt.from_str("{{ text }}")
+        assert prompt(text="hello") == "hello"
+
+    def test_from_str_with_none(self):
+        prompt = Prompt.from_str("{{ text }}", filters=None)
+        assert prompt(text="hello") == "hello"
+
+    def test_from_str_with_empty_dict(self):
+        prompt = Prompt.from_str("{{ text }}", filters={})
+        assert prompt(text="hello") == "hello"
+
+    def test_multiple_custom_filters(self):
+        @outlines.prompt(filters={"surround": surround, "repeat": repeat})
+        def multi(text):
+            """{{ text | surround("<", ">") | repeat(2) }}"""
+
+        assert multi("hello") == "<hello><hello>"
+
+    def test_default_and_custom_together(self):
+        def empty_fn():
+            pass
+
+        @outlines.prompt(filters={"surround": surround})
+        def both(fn):
+            """{{ fn | name }} {{ fn | surround("<", ">") }}"""
+
+        result = both(empty_fn)
+        assert "empty_fn" in result
+        assert "<" in result and ">" in result
+
+
+class TestWithFilters:
+    """Tests for Prompt.with_filters() derivation."""
+
+    def test_with_filters_extends(self):
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        derived = tagged.with_filters({"reverse": reverse})
+        assert derived("hello") == "<hello>"
+
+    def test_with_filters_overrides(self):
+        def surround2(value, left, right):
+            return f"[{left}{value}{right}]"
+
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        derived = tagged.with_filters({"surround": surround2})
+        assert derived("hello") == "[<hello>]"
+
+    def test_with_filters_does_not_mutate_original(self):
+        def surround2(value, left, right):
+            return f"[{left}{value}{right}]"
+
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        derived = tagged.with_filters({"surround": surround2})
+        assert derived("hello") == "[<hello>]"
+        assert tagged("world") == "<world>"
+
+    def test_with_filters_none_retains_all(self):
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        derived = tagged.with_filters(None)
+        assert derived("hello") == "<hello>"
+
+    def test_with_filters_empty_retains_all(self):
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        derived = tagged.with_filters({})
+        assert derived("hello") == "<hello>"
+
+    def test_chained_with_filters(self):
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text):
+            """{{ text | surround("<", ">") }}"""
+
+        derived = (
+            tagged
+            .with_filters({"reverse": reverse})
+            .with_filters({"double": lambda v: v * 2})
+        )
+        assert derived("hello") == "<hello>"
+
+    def test_with_filters_from_str_prompt(self):
+        prompt = Prompt.from_str(
+            '{{ text | upper }}', filters={"upper": upper}
+        )
+        derived = prompt.with_filters({"reverse": reverse})
+        assert derived(text="hello") == "HELLO"
+
+    def test_with_filters_from_file_prompt(self, temp_prompt_file):
+        prompt = Prompt.from_file(temp_prompt_file)
+        # Ensure we can derive it and it still renders correctly
+        derived = prompt.with_filters({"surround": surround})
+        # The template doesn't use {{ surround }}, so it just renders normally
+        examples = [
+            {"question": "Q1?", "answer": "A1"},
+        ]
+        result = derived(examples=examples, question="Q?")
+        assert "Q: Q?" in result
+        assert "A1" in result
+
+    def test_derived_preserves_call_signature(self):
+        @outlines.prompt(filters={"surround": surround})
+        def tagged(text, num=42):
+            """{{ text }} {{ num }}"""
+
+        derived = tagged.with_filters({"reverse": reverse})
+        assert derived("hello") == "hello 42"
+        assert derived("hello", num=7) == "hello 7"
+
+    def test_derived_from_prompt_with_default_args(self):
+        def greet(value, greeting="Hello"):
+            return f"{greeting}, {value}!"
+
+        @outlines.prompt(filters={"greet": greet})
+        def greeting_prompt(name):
+            """{{ name | greet }}"""
+
+        assert greeting_prompt("World") == "Hello, World!"
+
+        derived = greeting_prompt.with_filters({"surround": surround})
+        # template only uses greet, so result unchanged
+        assert derived("World") == "Hello, World!"
+
+
+class TestFromFileWithFilters:
+    """Tests for Prompt.from_file(..., filters=...)."""
+
+    def test_from_file_with_custom_filter(self, temp_prompt_file):
+        prompt = Prompt.from_file(
+            temp_prompt_file, filters={"upper": upper}
+        )
+        # Template doesn't use upper, but the env should have it
+        examples = [
+            {"question": "Q1?", "answer": "A1"},
+        ]
+        result = prompt(examples=examples, question="Q?")
+        assert "Q: Q?" in result
+        assert "A1" in result
+
+    def test_from_file_custom_filter_in_include(self, tmp_path):
+        """Custom filters propagate to included and inherited templates."""
+        # Write base template
+        base = tmp_path / "base_custom.txt"
+        base.write_text(
+            "{% block content %}{% endblock %}\n"
+        )
+        # Write include file that uses a custom filter
+        inc = tmp_path / "include_custom.txt"
+        inc.write_text("{{ 'hello' | upper_dec }}")
+        # Write child template
+        child = tmp_path / "child.txt"
+        child.write_text(
+            '{% extends "base_custom.txt" %}\n'
+            "{% block content %}\n"
+            '{% include "include_custom.txt" %}\n'
+            "{% endblock %}\n"
+        )
+
+        def upper_dec(value):
+            return value.upper() + "!!"
+
+        prompt = Prompt.from_file(
+            child, filters={"upper_dec": upper_dec}
+        )
+        assert prompt() == "HELLO!!"
