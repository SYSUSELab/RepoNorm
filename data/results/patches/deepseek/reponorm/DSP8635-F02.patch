diff --git a/tests/propose/test_grounded_proposer.py b/tests/propose/test_grounded_proposer.py
index 252afe8a..91be637c 100644
--- a/tests/propose/test_grounded_proposer.py
+++ b/tests/propose/test_grounded_proposer.py
@@ -52,3 +52,84 @@ def test_propose_instruction_for_predictor(demo_candidates):
         tip=None,
     )
     assert result == "instruction"
+
+
+def test_max_instruct_history_default():
+    """Default max_instruct_history should be 5."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], verbose=False)
+    assert proposer.max_instruct_history == 5
+
+
+@pytest.mark.parametrize("value,expected", [
+    (0, 0),
+    (1, 1),
+    (5, 5),
+    (10, 10),
+    (20, 20),
+    (-1, 0),   # Clamped to 0
+    (21, 20),  # Clamped to 20
+    (100, 20), # Clamped to 20
+    (-100, 0), # Clamped to 0
+])
+def test_max_instruct_history_clamping(value, expected):
+    """max_instruct_history should be clamped to [0, 20]."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    proposer = GroundedProposer(
+        prompt_model=prompt_model, program=program, trainset=[], verbose=False,
+        max_instruct_history=value,
+    )
+    assert proposer.max_instruct_history == expected
+
+
+@pytest.mark.parametrize("value", [True, False])
+def test_max_instruct_history_rejects_bool(value):
+    """max_instruct_history must not accept booleans."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    with pytest.raises(ValueError, match="max_instruct_history must be an integer, not a boolean"):
+        GroundedProposer(
+            prompt_model=prompt_model, program=program, trainset=[], verbose=False,
+            max_instruct_history=value,
+        )
+
+
+@pytest.mark.parametrize("value", [3.14, "5", None, [5], {"n": 5}])
+def test_max_instruct_history_rejects_non_int(value):
+    """max_instruct_history must not accept non-integer types."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    with pytest.raises(ValueError, match="max_instruct_history must be an integer"):
+        GroundedProposer(
+            prompt_model=prompt_model, program=program, trainset=[], verbose=False,
+            max_instruct_history=value,
+        )
+
+
+@pytest.mark.parametrize(
+    "demo_candidates",
+    [
+        None,
+        [[[dspy.Example(question="What is the capital of France?", answer="Paris")]]],
+    ],
+)
+def test_propose_with_zero_history(demo_candidates):
+    """max_instruct_history=0 should result in no instruction history."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    proposer = GroundedProposer(
+        prompt_model=prompt_model, program=program, trainset=trainset,
+        verbose=False, max_instruct_history=0,
+    )
+    result = proposer.propose_instructions_for_program(
+        trainset=trainset, program=program, demo_candidates=demo_candidates,
+        trial_logs={}, N=1, T=0.5
+    )
+    assert isinstance(result, dict)
+    assert len(result) == len(program.predictors())
+    for pred_instructions in result.values():
+        assert pred_instructions == ["instruction"]
