+# ---------------------------------------------------------------------------
+# Edge cases
+# ---------------------------------------------------------------------------
+
+class TestEdgeCases:
+    def test_very_short_ttl(self):
+        c = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
+            ttl=0.001,
+        )
+        c.put({"k": "v"}, "value")
+        time.sleep(0.01)
+        assert c.get({"k": "v"}) is None
+
+    def test_large_ttl(self):
+        c = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
+            ttl=1e9,
+        )
+        c.put({"k": "v"}, "value")
+        assert c.get({"k": "v"}) == "value"
+
+    def test_nonexpiring_and_expiring_coexist(self):
+        c = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
+            ttl=None,
+        )
+        c.put({"k": "persistent"}, "forever")
+        c.set_ttl(0.1)
+        c.put({"k": "temporary"}, "ephemeral")
+        time.sleep(0.15)
+        assert c.get({"k": "persistent"}) == "forever"
+        assert c.get({"k": "temporary"}) is None
+
+    def test_usage_cleared_on_ttl_hit(self):
+        """Clear usage on cache hit even when TTL is set."""
+        c = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
+            ttl=60,
+        )
+
+        class Resp:
+            usage = {"prompt_tokens": 5}
+
+        c.put({"k": "v"}, Resp())
+        retrieved = c.get({"k": "v"})
+        assert retrieved.usage == {}
