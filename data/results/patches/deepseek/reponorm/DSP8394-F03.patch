+# ---------------------------------------------------------------------------
+# set_ttl method
+# ---------------------------------------------------------------------------
+
+class TestSetTtl:
+    @pytest.fixture
+    def cache(self):
+        return Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
+            ttl=None,
+        )
+
+    def test_updates_ttl(self, cache):
+        assert cache.ttl is None
+        cache.set_ttl(30)
+        assert cache.ttl == 30.0
+
+    def test_back_to_none(self, cache):
+        cache.set_ttl(30)
+        cache.set_ttl(None)
+        assert cache.ttl is None
+
+    def test_invalid_raises_and_unchanged(self, cache):
+        with pytest.raises(ValueError):
+            cache.set_ttl(0)
+        assert cache.ttl is None
+
+    def test_invalid_negative(self, cache):
+        with pytest.raises(ValueError):
+            cache.set_ttl(-5)
+        assert cache.ttl is None
+
+    def test_invalid_bool(self, cache):
+        with pytest.raises(ValueError):
+            cache.set_ttl(True)
+        assert cache.ttl is None
+
+    def test_affects_only_new_writes(self, cache):
+        """Setting TTL must not retroactively expire existing entries."""
+        cache.put({"k": "old"}, "old_entry")
+        cache.set_ttl(0.1)
+        cache.put({"k": "new"}, "new_ttl_entry")
+        # Old entry has no TTL
+        assert cache.get({"k": "old"}) == "old_entry"
+        time.sleep(0.15)
+        assert cache.get({"k": "old"}) == "old_entry"
+        assert cache.get({"k": "new"}) is None
+
+    def test_none_after_ttl(self, cache):
+        """Switching back to None makes new writes nonexpiring."""
+        cache.set_ttl(0.1)
+        cache.put({"k": "will_expire"}, "ephemeral")
+        cache.set_ttl(None)
+        cache.put({"k": "persistent"}, "forever")
+        time.sleep(0.15)
+        assert cache.get({"k": "will_expire"}) is None
+        assert cache.get({"k": "persistent"}) == "forever"
+
+    def test_does_not_clear_entries(self, cache):
+        cache.put({"k": "v"}, "value")
+        cache.set_ttl(60)
+        assert cache.get({"k": "v"}) == "value"
+
+    def test_does_not_change_configuration(self, cache):
+        cache.set_ttl(60)
+        cache.put({"k": "v"}, "value")
+        assert cache.get({"k": "v"}) == "value"
+
