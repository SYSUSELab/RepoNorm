+# ---------------------------------------------------------------------------
+# Combined memory + disk cache with TTL
+# ---------------------------------------------------------------------------
+
+class TestTtlCombined:
+    @pytest.fixture
+    def cache(self):
+        tmpdir = tempfile.mkdtemp(prefix="dspy_ttl_combined_")
+        yield Cache(
+            enable_disk_cache=True,
+            enable_memory_cache=True,
+            disk_cache_dir=tmpdir,
+            ttl=0.15,
+        )
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+    def test_entry_expires(self, cache):
+        cache.put({"k": "v"}, "hello")
+        assert cache.get({"k": "v"}) == "hello"
+        time.sleep(0.2)
+        assert cache.get({"k": "v"}) is None
+
+    def test_disk_promotion_does_not_renew_ttl(self, cache):
+        """Entry promoted from disk to memory must not have its deadline reset."""
+        cache.put({"k": "v"}, "hello")
+        assert cache.get({"k": "v"}) == "hello"
+        cache.reset_memory_cache()
+        time.sleep(0.08)
+        assert cache.get({"k": "v"}) == "hello"  # Promoted from disk
+        time.sleep(0.10)  # Total ~0.18 > 0.15
+        assert cache.get({"k": "v"}) is None
+
+    def test_load_memory_preserves_deadline(self, cache, tmp_path):
+        """Save / load memory cache must not reset deadlines."""
+        cache.put({"k": "v"}, "hello")
+        fp = str(tmp_path / "mem.pkl")
+        cache.save_memory_cache(fp)
+        cache.reset_memory_cache()
+        cache.load_memory_cache(fp)
+        time.sleep(0.2)
+        assert cache.get({"k": "v"}) is None
+
+
