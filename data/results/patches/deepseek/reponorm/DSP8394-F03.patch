+            enable_disk_cache=True,
+            enable_memory_cache=False,
+            disk_cache_dir=tmpdir,
+            ttl=0.1,
+        )
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+    def test_entry_expires(self, cache):
+        cache.put({"k": "v"}, "hello")
+        assert cache.get({"k": "v"}) == "hello"
+        time.sleep(0.15)
+        assert cache.get({"k": "v"}) is None
+
+    def test_contains_after_expiry(self, cache):
+        cache.put({"k": "v"}, "hello")
+        k = cache.cache_key({"k": "v"})
+        time.sleep(0.15)
+        assert k not in cache
+
+    def test_overwrite_resets_ttl(self, cache):
+        cache.put({"k": "x"}, "first")
+        time.sleep(0.08)
+        cache.put({"k": "x"}, "second")
+        time.sleep(0.08)
+        assert cache.get({"k": "x"}) == "second"
+        time.sleep(0.08)
+        assert cache.get({"k": "x"}) is None
+
