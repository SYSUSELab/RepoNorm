+
+        with patch("dspy.cache", c):
+            @request_cache()
+            def fn(prompt, model):
+                return f"Response for {prompt} with {model}"
+
+            r1 = fn(prompt="Hello", model="gpt-4")
+            assert r1 == "Response for Hello with gpt-4"
+
+            with patch.object(c, "get") as mock_get:
+                mock_get.return_value = "Cached"
+                r2 = fn(prompt="Hello", model="gpt-4")
+                assert r2 == "Cached"
