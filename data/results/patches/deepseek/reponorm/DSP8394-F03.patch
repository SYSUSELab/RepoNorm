+"""Tests for TTL (time-to-live) support in DSPy cache."""
+
+import copy
+import math
+import pickle
+import shutil
+import tempfile
+import time
+
+import pytest
+
+from dspy.clients.cache import Cache, _CacheEntry, _validate_ttl
+
+
+# ---------------------------------------------------------------------------
+# _validate_ttl
+# ---------------------------------------------------------------------------
+
+class TestValidateTtl:
+    def test_valid_positive(self):
+        assert _validate_ttl(1.0) == 1.0
+        assert _validate_ttl(0.001) == 0.001
+        assert _validate_ttl(100) == 100.0
+        assert _validate_ttl(10.5) == 10.5
+
+    def test_valid_none(self):
+        assert _validate_ttl(None) is None
+
+    def test_rejects_zero(self):
+        with pytest.raises(ValueError, match="positive"):
+            _validate_ttl(0)
+
+    def test_rejects_negative(self):
+        with pytest.raises(ValueError, match="positive"):
+            _validate_ttl(-1)
+
+    def test_rejects_infinity(self):
+        with pytest.raises(ValueError, match="finite|positive"):
+            _validate_ttl(float("inf"))
+
+    def test_rejects_neg_infinity(self):
+        with pytest.raises(ValueError, match="finite|positive"):
+            _validate_ttl(float("-inf"))
+
+    def test_rejects_nan(self):
+        with pytest.raises(ValueError, match="finite|positive"):
+            _validate_ttl(float("nan"))
+
+    def test_rejects_bool_true(self):
+        with pytest.raises(ValueError, match="positive number"):
+            _validate_ttl(True)
+
+    def test_rejects_bool_false(self):
+        with pytest.raises(ValueError, match="positive number"):
+            _validate_ttl(False)
+
+    def test_rejects_string(self):
+        with pytest.raises(ValueError, match="positive number"):
+            _validate_ttl("10")
+
+
+# ---------------------------------------------------------------------------
+# Cache construction with ttl
+# ---------------------------------------------------------------------------
+
+class TestCacheConstruction:
+    def test_default_ttl_is_none(self):
+        c = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/nonexistent")
+        assert c.ttl is None
+
+    def test_ttl_set_at_construction(self):
+        c = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/nonexistent", ttl=60)
+        assert c.ttl == 60.0
+
+    def test_invalid_ttl_at_construction_raises(self):
+        with pytest.raises(ValueError):
+            Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/nonexistent", ttl=-1)
+
+    def test_ttl_property_readonly_via_underscore(self):
+        c = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/nonexistent", ttl=30)
+        assert c.ttl == 30.0
+
+
+# ---------------------------------------------------------------------------
+# Memory-only cache with TTL
+# ---------------------------------------------------------------------------
+
+class TestTtlMemoryOnly:
+    @pytest.fixture
+    def cache(self):
+        return Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
+            ttl=0.1,  # 100 ms
+        )
+
+    def test_entry_expires(self, cache):
+        cache.put({"key": "val"}, "hello")
+        assert cache.get({"key": "val"}) == "hello"
+        time.sleep(0.15)
+        assert cache.get({"key": "val"}) is None
+
+    def test_entry_not_expired_before_ttl(self, cache):
+        cache.put({"key": "val"}, "hello")
+        assert cache.get({"key": "val"}) == "hello"
+
+    def test_contains_expired_returns_false(self, cache):
+        cache.put({"key": "val"}, "hello")
+        k = cache.cache_key({"key": "val"})
+        assert k in cache
+        time.sleep(0.15)
+        assert k not in cache
+
+    def test_multiple_entries_independent_expiry(self, cache):
+        cache.put({"k": "1"}, "a")
+        cache.put({"k": "2"}, "b")
+        time.sleep(0.15)
+        assert cache.get({"k": "1"}) is None
+        assert cache.get({"k": "2"}) is None
+
+    def test_overwrite_resets_ttl(self, cache):
+        cache.put({"k": "x"}, "first")
+        time.sleep(0.08)  # Not yet expired
+        cache.put({"k": "x"}, "second")  # Overwrite resets deadline
+        time.sleep(0.08)  # Past original deadline, within new deadline
+        assert cache.get({"k": "x"}) == "second"
+        time.sleep(0.08)  # Past new deadline
+        assert cache.get({"k": "x"}) is None
+
+    def test_read_does_not_renew_ttl(self, cache):
+        cache.put({"k": "x"}, "hello")
+        time.sleep(0.08)
+        assert cache.get({"k": "x"}) == "hello"  # Read does not renew
+        time.sleep(0.08)  # Total ~0.16 > 0.1, should expire
+        assert cache.get({"k": "x"}) is None
+
