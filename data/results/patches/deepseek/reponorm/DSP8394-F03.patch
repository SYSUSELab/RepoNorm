+# No TTL (original behavior preserved)
+# ---------------------------------------------------------------------------
+
+class TestNoTtl:
+    @pytest.fixture
+    def cache(self):
+        return Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="/tmp/nonexistent",
