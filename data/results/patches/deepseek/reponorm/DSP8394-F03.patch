+class _CacheEntry:
+    """Internal wrapper for cache entries with optional TTL expiration."""
+    __slots__ = ('value', 'deadline')
+
+    def __init__(self, value: Any, deadline: Optional[float]):
+        self.value = value
+        self.deadline = deadline  # None means no expiration; float is a Unix timestamp
+
+    def is_expired(self, now: Optional[float] = None) -> bool:
+        if self.deadline is None:
+            return False
+        if now is None:
+            now = time.time()
+        return now > self.deadline
+
+
+def _validate_ttl(ttl):
+    """Validate the TTL value. Returns the validated value (or None)."""
+    if ttl is None:
+        return None
+    if isinstance(ttl, bool):
+        raise ValueError(f"TTL must be a positive number of seconds, got bool ({ttl!r})")
+    if not isinstance(ttl, (int, float)):
+        raise ValueError(f"TTL must be a positive number of seconds, got {type(ttl).__name__} ({ttl!r})")
+    if ttl <= 0:
+        raise ValueError(f"TTL must be a positive number of seconds, got {ttl!r}")
+    if not (float('-inf') < ttl < float('inf')):
+        raise ValueError(f"TTL must be a finite number of seconds, got {ttl!r}")
+    return float(ttl)
+
