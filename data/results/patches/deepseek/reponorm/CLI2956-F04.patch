+    def _check_required_if(self, ctx: Context) -> None:
+        # Collect all parameter names for validation
+        param_names = {p.name for p in self.get_params(ctx) if p.name is not None}
+
+        for param in self.get_params(ctx):
+            required_if = getattr(param, "required_if", None)
+            if required_if is None:
+                continue
+
+            # Determine if the target option is conditionally required
+            condition_met = False
+
+            if isinstance(required_if, cabc.Mapping):
+                # Validate that all keys name existing parameters
+                for key in required_if:
+                    if key not in param_names:
+                        raise UsageError(
+                            f'Conditional requirement: "{key}" is not a '
+                            f'parameter on the command.'
+                        )
+
+                # Check if all mapping entries match the final parameter values
+                condition_met = True
+                for key, expected_value in required_if.items():
+                    actual_value = ctx.params.get(key)
+                    if actual_value != expected_value:
+                        condition_met = False
+                        break
+
+            elif callable(required_if):
+                try:
+                    condition_met = required_if(ctx, param)
+                except Exception:
+                    condition_met = False
+
+            if condition_met and param.value_is_missing(
+                ctx.params.get(param.name)
+            ):
+                raise MissingParameter(
+                    ctx=ctx,
+                    param=param,
+                    param_type=param.human_readable_name,
+                )
+
