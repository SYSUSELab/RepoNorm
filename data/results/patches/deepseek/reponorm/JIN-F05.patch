diff --git a/tests/test_async_filters.py b/tests/test_async_filters.py
index 5d4f332..cd4dc10 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -3,7 +3,7 @@ from collections import namedtuple
 import pytest
 from markupsafe import Markup
 
-from jinja2 import Environment
+from jinja2 import Environment, StrictUndefined, UndefinedError
 from jinja2.async_utils import auto_aiter
 
 
@@ -251,3 +251,100 @@ def test_custom_async_iteratable_filter(env_async, items):
     )
     out = tmpl.render(items=items)
     assert out == "0,1,2 .. 3,4,5"
+
+
+@mark_dualiter(
+    "users",
+    lambda: [
+        {"name": "emma", "city": "NY"},
+        {"name": "smith", "city": "WA"},
+        {"name": "john"},
+        {"name": "jane", "city": None},
+        {"name": "bob", "city": ""},
+    ],
+)
+def test_groupby_include_empty_false(env_async, users):
+    """Test include_empty=False removes items with falsy grouping keys."""
+    tmpl = env_async.from_string(
+        "{% for group in users()|groupby(\"city\", include_empty=False) %}"
+        "{{ group.grouper }}:{{ group.list|map(attribute=\"name\")|join(\",\") }} "
+        "{% endfor %}"
+    )
+    out = tmpl.render(users=users)
+    assert out == "NY:emma WA:smith "
+
+
+@mark_dualiter(
+    "users",
+    lambda: [
+        {"name": "missing2"},
+        {"name": "none1", "city": None},
+        {"name": "empty", "city": ""},
+        {"name": "zulu", "city": "z"},
+        {"name": "missing1"},
+        {"name": "none2", "city": None},
+    ],
+)
+def test_groupby_include_empty_order(env_async, users):
+    """Test ordering: normal keys (including empty str), then None, then Undefined."""
+    tmpl = env_async.from_string(
+        "{% for group in users()|groupby(\"city\") %}"
+        "{{ group.grouper }}:{{ group.list|map(attribute=\"name\")|join(\",\") }} "
+        "{% endfor %}"
+    )
+    out = tmpl.render(users=users)
+    assert out == ":empty z:zulu None:none1,none2 :missing2,missing1 "
+
+
+@mark_dualiter(
+    "users",
+    lambda: [
+        {"name": "a", "city": None},
+        {"name": "b"},
+        {"name": "c", "city": None},
+        {"name": "d"},
+    ],
+)
+def test_groupby_include_empty_interleaved(env_async, users):
+    """Test interleaved None and Undefined produce single groups."""
+    tmpl = env_async.from_string(
+        "{% for group in users()|groupby(\"city\") %}"
+        "{{ group.grouper }}:{{ group.list|map(attribute=\"name\")|join(\",\") }} "
+        "{% endfor %}"
+    )
+    out = tmpl.render(users=users)
+    assert out == "None:a,c :b,d "
+
+
+def test_groupby_include_empty_strict_undefined(env_async):
+    """Test StrictUndefined raises error when include_empty=True."""
+    env = Environment(undefined=StrictUndefined, enable_async=True)
+    tmpl = env.from_string(
+        "{% for group in users|groupby(\"city\") %}"
+        "{{ group.grouper }}:{{ group.list|map(attribute=\"name\")|join(\",\") }} "
+        "{% endfor %}"
+    )
+    with pytest.raises(UndefinedError):
+        tmpl.render(
+            users=[
+                {"name": "john", "city": "NY"},
+                {"name": "jane"},
+            ]
+        )
+
+
+def test_groupby_include_empty_strict_undefined_filtered(env_async):
+    """Test StrictUndefined items are filtered when include_empty=False."""
+    env = Environment(undefined=StrictUndefined, enable_async=True)
+    tmpl = env.from_string(
+        "{% for group in users|groupby(\"city\", include_empty=False) %}"
+        "{{ group.grouper }}:{{ group.list|map(attribute=\"name\")|join(\",\") }} "
+        "{% endfor %}"
+    )
+    out = tmpl.render(
+        users=[
+            {"name": "john", "city": "NY"},
+            {"name": "jane"},
+        ]
+    )
+    assert out == "NY:john "
