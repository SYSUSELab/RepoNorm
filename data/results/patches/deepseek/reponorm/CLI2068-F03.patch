+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_auto_backup_no_filename(runner, monkeypatch, tmp_path):
+    """When auto_backup=True but no filename is given, no backup is created."""
+    import os
+
+    # Create a temp file to use as a marker - no backup should be created
+    marker = tmp_path / "marker"
+    marker.touch()
+    # Using text without filename - should not create backup
+    result = click.edit(
+        "test content", editor="sed -i~ 's/$/Test/'", auto_backup=True
+    )
+    assert result is not None
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_auto_backup_new_file(runner, monkeypatch, tmp_path):
+    """When auto_backup=True but the file doesn't exist, no backup is created."""
+    import os
+
+    nonexistent = tmp_path / "nonexistent.txt"
+    assert not nonexistent.exists()
+
+    # Editor will fail on nonexistent file, but we just verify no backup
+    with pytest.raises(click.ClickException):
+        click.edit(filename=str(nonexistent), editor="cat", auto_backup=True)
+
+    # Verify no backup file was created
+    assert not list(tmp_path.glob("nonexistent.txt.backup.*"))
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_auto_backup_creates_backup(runner, monkeypatch, tmp_path):
+    """When auto_backup=True and file exists, a backup is created."""
+    import os
+
+    # Create a test file
+    test_file = tmp_path / "test_edit.txt"
+    test_file.write_text("original content")
+
+    # Use cat as a no-op editor (reads and outputs file)
+    click.edit(filename=str(test_file), editor="cat", auto_backup=True)
+
+    # Check backup exists
+    backups = list(tmp_path.glob("test_edit.txt.backup.*"))
+    assert len(backups) == 1
+    assert backups[0].read_text() == "original content"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_auto_backup_preserves_mode(runner, monkeypatch, tmp_path):
+    """Backup preserves the source file's permission mode."""
+    import os
+    import stat
+
+    # Create a test file with specific permissions
+    test_file = tmp_path / "test_mode.txt"
+    test_file.write_text("content")
+    test_file.chmod(0o755)
+    original_mode = os.stat(test_file).st_mode
+
+    click.edit(filename=str(test_file), editor="cat", auto_backup=True)
+
+    backups = list(tmp_path.glob("test_mode.txt.backup.*"))
+    assert len(backups) == 1
+    backup_mode = os.stat(backups[0]).st_mode
+    assert backup_mode == original_mode
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_auto_backup_no_overwrite(runner, monkeypatch, tmp_path):
+    """Repeated edits in the same second don't overwrite earlier backups."""
+    import os
+    from datetime import datetime
+
+    test_file = tmp_path / "test_no_overwrite.txt"
+    test_file.write_text("v1")
+
+    click.edit(filename=str(test_file), editor="cat", auto_backup=True)
+    test_file.write_text("v2")
+    click.edit(filename=str(test_file), editor="cat", auto_backup=True)
+
+    backups = sorted(tmp_path.glob("test_no_overwrite.txt.backup.*"))
+    assert len(backups) == 2
+    # First backup should be v1, second backup should match regardless
+    # but both should exist
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_auto_backup_oserror(runner, monkeypatch, tmp_path):
+    """OSError during backup raises ClickException and doesn't launch editor."""
+    import os
+    import stat
+
+    # Create a test file in a directory that will become unwritable
+    backup_dir = tmp_path / "backup_dir"
+    backup_dir.mkdir()
+    test_file = backup_dir / "test_oserror.txt"
+    test_file.write_text("content")
+
+    # Make the directory read-only to cause OSError when shutil.copy2 tries to write
+    backup_dir.chmod(stat.S_IRUSR | stat.S_IXUSR)
+
+    with pytest.raises(click.ClickException) as exc_info:
+        click.edit(filename=str(test_file), editor="cat", auto_backup=True)
+
+    assert str(exc_info.value).startswith("Failed to create backup file")
+
+    # Restore permissions for cleanup
+    backup_dir.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)
