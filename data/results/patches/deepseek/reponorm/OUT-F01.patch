diff --git a/tests/backends/test_xgrammar.py b/tests/backends/test_xgrammar.py
index 1133b9f..c17ff15 100644
--- a/tests/backends/test_xgrammar.py
+++ b/tests/backends/test_xgrammar.py
@@ -93,3 +93,66 @@ def test_xgrammar_backend_invalid_model(model_llamacpp):
         match="The xgrammar backend only supports Transformers models",
     ):
         XGrammarBackend(model_llamacpp)
+
+
+def test_xgrammar_logits_processor_attributes(model_transformers, json_schema):
+    """Test that the XGrammarLogitsProcessor exposes required API attributes."""
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor(json_schema)
+
+    # Read-only attributes from the API contract
+    assert hasattr(processor, "compiled_grammar")
+    assert hasattr(processor, "tensor_library_name")
+    assert hasattr(processor, "is_first_token")
+    assert callable(getattr(processor, "reset", None))
+    assert callable(getattr(processor, "process_logits", None))
+
+    # Initial state
+    assert processor.is_first_token is True
+    assert processor.tensor_library_name == model_transformers.tensor_library_name
+
+
+def test_xgrammar_logits_processor_reset(model_transformers, json_schema):
+    """Test that reset() restores the processor to first-token state."""
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor(json_schema)
+
+    # Simulate one generation step
+    import torch
+    input_ids = torch.zeros((1, 1), dtype=torch.long)
+    logits = torch.randn((1, 50257))
+    processor.process_logits(input_ids, logits)
+    assert processor.is_first_token is False
+
+    # Reset and verify
+    processor.reset()
+    assert processor.is_first_token is True
+
+
+def test_xgrammar_logits_processor_first_token(model_transformers, json_schema):
+    """Test that process_logits works on the first token call."""
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor(json_schema)
+
+    import torch
+    input_ids = torch.zeros((1, 1), dtype=torch.long)
+    logits = torch.randn((1, 50257))
+
+    # First call should succeed and modify logits
+    processed = processor.process_logits(input_ids, logits)
+    assert processed is logits  # in-place modification
+    assert processor.is_first_token is False
+
+    # The logits should differ after bitmask application
+    # (bitmask zeros out some tokens)
+
+
+def test_xgrammar_logits_processor_unsupported_library(model_transformers, json_schema):
+    """Test that unsupported tensor libraries raise NotImplementedError."""
+    backend = XGrammarBackend(model_transformers)
+    compiled = backend.grammar_compiler.compile_json_schema(json_schema)
+
+    with pytest.raises(NotImplementedError) as excinfo:
+        XGrammarLogitsProcessor(compiled, "nonexistent_library")
+    assert "nonexistent_library" in str(excinfo.value)
+    assert "not available" in str(excinfo.value)
