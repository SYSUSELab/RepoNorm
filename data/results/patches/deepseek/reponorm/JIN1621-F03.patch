+def validate_template_path(template: str) -> None:
+    """Validate a template name for invalid characters or patterns.
+    
+    Returns ``None`` for a valid name and raises ``TemplateNotFound(template)``
+    when the value is ``None`` or empty, contains a NUL byte, begins with ``/``
+    or ``\\``, begins with an ASCII drive prefix such as ``C:``, or contains
+    an ASCII control character below code point 32 other than tab, newline, or
+    carriage return.
+    """
+    if not template:
+        raise TemplateNotFound(template)
+
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    if template[0] in ("/", "\\"):
+        raise TemplateNotFound(template)
+
+    if (
+        len(template) > 1
+        and template[1] == ":"
+        and template[0].isascii()
+        and template[0].isalpha()
+    ):
+        raise TemplateNotFound(template)
+
+    for ch in template:
+        if ch < " " and ch not in ("\t", "\n", "\r"):
+            raise TemplateNotFound(template)
+
+
