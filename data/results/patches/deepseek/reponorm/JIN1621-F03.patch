+
+    def test_validate_template_path_valid(self):
+        """validate_template_path returns None for valid names."""
+        assert loaders.validate_template_path("foo.html") is None
+        assert loaders.validate_template_path("foo/bar.html") is None
+        assert loaders.validate_template_path("foo/bar/baz.html") is None
+        assert loaders.validate_template_path("./foo.html") is None
+
+    def test_validate_template_path_none_and_empty(self):
+        """validate_template_path raises for None or empty string."""
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path(None)
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("")
+
+    def test_validate_template_path_nul_byte(self):
+        """validate_template_path raises for NUL byte in name."""
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("foo\x00bar.html")
+
+    def test_validate_template_path_leading_slash(self):
+        """validate_template_path raises for leading / or \\."""
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("/absolute/path.html")
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("\\absolute\\path.html")
+
+    def test_validate_template_path_drive_prefix(self):
+        """validate_template_path raises for drive prefix like C:."""
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("C:foo.html")
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("a:foo.html")
+
+    def test_validate_template_path_control_characters(self):
+        """validate_template_path raises for control characters below space
+        except tab, newline, and carriage return."""
+        # Invalid control characters (BEL, etc.)
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("foo\x07bar.html")
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("foo\x01bar.html")
+        with pytest.raises(TemplateNotFound):
+            loaders.validate_template_path("foo\x1fbar.html")
+        # Valid control characters
+        assert loaders.validate_template_path("foo\tbar.html") is None
+        assert loaders.validate_template_path("foo\nbar.html") is None
+        assert loaders.validate_template_path("foo\rbar.html") is None
+
+    def test_split_template_path_new_validations(self):
+        """split_template_path now validates via validate_template_path."""
+        # Existing checks still work
+        pytest.raises(TemplateNotFound, split_template_path, "../foo")
+        # New validation failures via validate_template_path
+        pytest.raises(TemplateNotFound, split_template_path, "/absolute")
+        pytest.raises(TemplateNotFound, split_template_path, "C:foo")
+        # Valid names still work
+        assert split_template_path("foo/bar") == ["foo", "bar"]
+
