diff --git a/dirty_equals/_url.py b/dirty_equals/_url.py
new file mode 100644
index 0000000..03e06c6
--- /dev/null
+++ b/dirty_equals/_url.py
@@ -0,0 +1,87 @@
+from typing import Any, Collection, FrozenSet, List, Optional, Set, Tuple, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+
+class IsURL(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid URL, optionally enforcing specific protocols or domains.
+
+    The URL must have a scheme (protocol) and a network location (netloc) to be considered valid.
+    """
+
+    def __init__(
+        self,
+        protocol: Union[None, str, Collection[str]] = None,
+        domain: Optional[str] = None,
+    ):
+        """
+        Args:
+            protocol: Optional protocol(s) to enforce. Can be a single string (e.g. 'https'),
+                or a collection of strings (list, tuple, set, frozenset).
+                An empty collection allows no protocol, while None disables filtering.
+            domain: Optional domain to enforce against the full netloc (including port if present).
+
+        Examples:
+        ```py title="IsURL"
+        from dirty_equals import IsURL
+
+        assert 'http://example.com' == IsURL()
+        assert 'https://example.com' == IsURL(protocol='https')
+        assert 'http://example.com' == IsURL(protocol=['http', 'https'])
+        assert 'https://example.com:443/path' == IsURL(domain='example.com:443')
+        assert 'http://example.com' == IsURL(protocol='http', domain='example.com')
+        assert 'not a url' != IsURL()
+        assert 123 != IsURL()
+        ```
+        """
+        self.protocol = protocol
+        self.domain = domain
+
+        # Build repr args
+        if protocol is None and domain is None:
+            super().__init__(plain_repr('*'))
+        elif domain is None:
+            # Only protocol
+            super().__init__(protocol if isinstance(protocol, str) else protocol)
+        elif protocol is None:
+            # Only domain
+            super().__init__(domain)
+        else:
+            # Both
+            super().__init__(
+                protocol if isinstance(protocol, str) else protocol,
+                domain,
+            )
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        from urllib.parse import urlparse
+
+        parsed = urlparse(other)
+
+        # A valid URL must have a scheme and a netloc
+        if not parsed.scheme or not parsed.netloc:
+            return False
+
+        # Check protocol if specified
+        if self.protocol is not None:
+            if isinstance(self.protocol, str):
+                if parsed.scheme != self.protocol:
+                    return False
+            elif isinstance(self.protocol, Collection):
+                # Empty collection means no protocol is allowed
+                if not self.protocol:
+                    return False
+                if parsed.scheme not in self.protocol:
+                    return False
+
+        # Check domain if specified
+        if self.domain is not None:
+            if parsed.netloc != self.domain:
+                return False
+
+        return True
diff --git a/tests/test_url.py b/tests/test_url.py
new file mode 100644
index 0000000..51bec2f
--- /dev/null
+++ b/tests/test_url.py
@@ -0,0 +1,129 @@
+import pytest
+
+from dirty_equals import IsURL
+
+
+def test_is_url_basic():
+    assert 'http://example.com' == IsURL()
+    assert 'https://example.com/path' == IsURL()
+    assert 'ftp://files.example.com' == IsURL()
+    assert 'http://example.com:8080' == IsURL()
+    assert 'http://user:pass@example.com' == IsURL()
+    assert 'http://example.com/path?query=1#fragment' == IsURL()
+
+
+def test_is_url_class():
+    assert 'http://example.com' == IsURL
+
+
+def test_is_url_invalid():
+    assert 'not a url' != IsURL()
+    assert 'http://' != IsURL()
+    assert '' != IsURL()
+    assert 123 != IsURL()
+    assert None != IsURL()
+    assert [1, 2, 3] != IsURL()
+    assert {} != IsURL()
+
+
+def test_is_url_protocol_string():
+    assert 'https://example.com' == IsURL(protocol='https')
+    assert 'http://example.com' != IsURL(protocol='https')
+    assert 'ftp://example.com' != IsURL(protocol='https')
+    assert 'https://example.com:443/path' == IsURL(protocol='https')
+
+
+def test_is_url_protocol_list():
+    assert 'http://example.com' == IsURL(protocol=['http', 'https'])
+    assert 'https://example.com' == IsURL(protocol=['http', 'https'])
+    assert 'ftp://example.com' != IsURL(protocol=['http', 'https'])
+
+
+def test_is_url_protocol_tuple():
+    assert 'http://example.com' == IsURL(protocol=('http', 'https'))
+    assert 'https://example.com' == IsURL(protocol=('http', 'https'))
+
+
+def test_is_url_protocol_set():
+    assert 'http://example.com' == IsURL(protocol={'http', 'https'})
+    assert 'https://example.com' == IsURL(protocol={'http', 'https'})
+
+
+def test_is_url_protocol_frozenset():
+    assert 'http://example.com' == IsURL(protocol=frozenset(['http', 'https']))
+    assert 'https://example.com' == IsURL(protocol=frozenset(['http', 'https']))
+
+
+def test_is_url_protocol_empty_collection():
+    assert 'https://example.com' != IsURL(protocol=[])
+    assert 'https://example.com' != IsURL(protocol=())
+    assert 'https://example.com' != IsURL(protocol=set())
+    assert 'https://example.com' != IsURL(protocol=frozenset())
+
+
+def test_is_url_protocol_none():
+    assert 'https://example.com' == IsURL(protocol=None)
+
+
+def test_is_url_domain():
+    assert 'https://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com/path' == IsURL(domain='example.com')
+    assert 'https://other.com' != IsURL(domain='example.com')
+
+
+def test_is_url_domain_with_port():
+    assert 'https://example.com:443' == IsURL(domain='example.com:443')
+    assert 'https://example.com:443/path' == IsURL(domain='example.com:443')
+    # Port is part of netloc, so domain match against netloc means port matters
+    assert 'https://example.com:443' != IsURL(domain='example.com')
+    assert 'https://example.com' != IsURL(domain='example.com:443')
+
+
+def test_is_url_domain_with_auth():
+    url = 'http://user:pass@example.com:8080/path'
+    assert url == IsURL(domain='user:pass@example.com:8080')
+
+
+def test_is_url_protocol_and_domain():
+    assert 'http://example.com' == IsURL(protocol='http', domain='example.com')
+    assert 'https://example.com' != IsURL(protocol='http', domain='example.com')
+    assert 'http://other.com' != IsURL(protocol='http', domain='example.com')
+
+
+def test_is_url_repr_no_args():
+    assert repr(IsURL()) == 'IsURL(*)'
+
+
+def test_is_url_repr_protocol_only():
+    assert repr(IsURL(protocol='https')) == "IsURL('https')"
+
+
+def test_is_url_repr_domain_only():
+    assert repr(IsURL(domain='example.com')) == "IsURL('example.com')"
+
+
+def test_is_url_repr_both():
+    assert repr(IsURL(protocol='https', domain='example.com')) == "IsURL('https', 'example.com')"
+
+
+def test_is_url_value():
+    u = IsURL()
+    assert 'http://example.com' == u
+    assert u.value == 'http://example.com'
+
+
+def test_is_url_value_not_set():
+    u = IsURL()
+    try:
+        _ = u.value
+        assert False, 'Expected AttributeError'
+    except AttributeError:
+        pass
+
+
+def test_is_url_repr_on_match():
+    u = IsURL()
+    with pytest.raises(AssertionError):
+        assert 'invalid' == u
+    # After failed match, repr shows the IsURL form
+    assert str(u) == 'IsURL(*)'
