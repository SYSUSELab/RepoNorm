+# --- Global filter registry ---
+
+# Built-in Outlines filters that cannot be overridden
+_PROTECTED_FILTERS: frozenset = frozenset({
+    "name", "description", "source", "signature", "schema", "args"
+})
+
+# Global filter registry shared across all prompt construction paths.
+_global_filters: Dict[str, Callable] = {}
+
+
+def register_filter(name: str, fn: Callable) -> None:
+    """Register a global Jinja template filter for prompts.
+
+    The filter will be available on all prompts constructed *after* this
+    call through @outlines.prompt, Prompt.from_str, and
+    Prompt.from_file, including included and inherited file templates.
+
+    If *name* is already registered the callable is replaced.  The Outlines-
+    specific built-in filters (name, description, source,
+    signature, schema, args) cannot be overridden.
+
+    Parameters
+    ----------
+    name
+        Filter name as used in templates ({{ value | name }}).
+    fn
+        Callable that implements the filter.
+    """
+    _global_filters[name] = fn
+
+
+def unregister_filter(name: str) -> None:
+    """Remove a previously registered global filter.
+
+    This is a no-op when *name* was never registered.
+
+    Parameters
+    ----------
+    name
+        Filter name to unregister.
+    """
+    _global_filters.pop(name, None)
+
+
+def _apply_global_filters(env: jinja2.Environment) -> None:
+    """Apply registered global filters to *env*, skipping protected names."""
+    for name, fn in _global_filters.items():
+        if name not in _PROTECTED_FILTERS:
+            env.filters[name] = fn
+
+
 
