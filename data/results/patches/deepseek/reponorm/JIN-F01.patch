diff --git a/tests/test_async_filters.py b/tests/test_async_filters.py
index 5d4f332..cc46894 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -94,6 +94,66 @@ def test_groupby_multidot(env_async, articles):
     ]
 
 
+@mark_dualiter(
+    "items",
+    lambda: [
+        {"name": "Alice"},
+        {"name": "alice"},
+        {"name": "Bob"},
+    ],
+)
+def test_groupby_case_sensitive(env_async, items):
+    """case_sensitive=True keeps differently cased keys separate."""
+    tmpl = env_async.from_string(
+        "{% for grouper, list in items()|groupby('name', case_sensitive=True) %}"
+        "{{ grouper }}:{{ list|map(attribute='name')|join(',') }}|"
+        "{% endfor %}"
+    )
+    assert tmpl.render(items=items) == "Alice:Alice|Bob:Bob|alice:alice|"
+
+
+@mark_dualiter(
+    "items",
+    lambda: [
+        {"name": "Alice"},
+        {"name": "alice"},
+        {"name": "Bob"},
+    ],
+)
+def test_groupby_case_insensitive(env_async, items):
+    """Default case_sensitive=False groups string keys case-insensitively,
+    retaining spelling of first encountered key."""
+    tmpl = env_async.from_string(
+        "{% for grouper, list in items()|groupby('name') %}"
+        "{{ grouper }}:{{ list|map(attribute='name')|join(',') }}|"
+        "{% endfor %}"
+    )
+    assert tmpl.render(items=items) == "Alice:Alice,alice|Bob:Bob|"
+
+
+@mark_dualiter("items", lambda: [("a", 1), ("a", 2), ("b", 1)])
+def test_groupby_case_insensitive_non_string(env_async, items):
+    """Non-string keys are unaffected by case_sensitive=False."""
+    tmpl = env_async.from_string(
+        "{% for grouper, list in items()|groupby(0) %}"
+        "{{ grouper }}:{% for x in list %}:{{ x.1 }}{% endfor %}|"
+        "{% endfor %}"
+    )
+    assert tmpl.render(items=items) == "a::1:2|b::1|"
+
+
+def test_groupby_case_insensitive_unicode(env_async):
+    """Unicode lowercasing is used, not casefolding."""
+    tmpl = env_async.from_string(
+        "{% for grouper, list in [{'name': '\u00c9lise'}, "
+        "{'name': '\u00e9lise'}]|groupby('name') %}"
+        "{{ grouper }}:{{ list|map(attribute='name')|join(',') }}|"
+        "{% endfor %}"
+    )
+    result = tmpl.render()
+    assert "\u00c9lise" in result
+    assert "\u00e9lise" in result
+
