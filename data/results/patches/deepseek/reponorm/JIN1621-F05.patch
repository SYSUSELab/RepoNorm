+    def test_path_cache_freshness_earlier_path(self):
+        """Earlier searchpath takes precedence on next load."""
+        import tempfile
+        tmpdir1 = tempfile.mkdtemp()
+        tmpdir2 = tempfile.mkdtemp()
+        try:
+            (Path(tmpdir1) / "name.html").write_text("FIRST")
+            (Path(tmpdir2) / "name.html").write_text("SECOND")
+            loader = loaders.FileSystemLoader(
+                [tmpdir1, tmpdir2], path_cache_size=10
+            )
