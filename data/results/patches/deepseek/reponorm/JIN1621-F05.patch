+    def test_path_cache_resolve_template_hook_called(self):
+        """Cache misses call resolve_template_path."""
+        import tempfile
+        tmpdir = tempfile.mkdtemp()
+        try:
+            (Path(tmpdir) / "hook.html").write_text("Hook")
+            loader = loaders.FileSystemLoader(tmpdir, path_cache_size=10)
+            # Monkey-patch to track calls
+            calls = []
+            original = loader.resolve_template_path
+            def tracking_resolve(template):
+                calls.append(template)
+                return original(template)
+            loader.resolve_template_path = tracking_resolve
+            env = Environment(loader=loader)
+            # First access: miss, calls resolve_template_path
+            env.get_template("hook.html")
+            assert "hook.html" in calls
+            calls.clear()
+            # Second access: cache hit, does NOT call resolve_template_path
+            env.get_template("hook.html")
+            assert "hook.html" not in calls
+            # Miss should call it
+            with pytest.raises(TemplateNotFound):
+                env.get_template("nope.html")
+            assert "nope.html" in calls
+        finally:
+            import shutil
+            shutil.rmtree(tmpdir)
+
+    def test_path_cache_lru_eviction(self):
+        """LRU eviction removes least recently used entries."""
+        import tempfile
+        tmpdir = tempfile.mkdtemp()
+        try:
+            # Create templates
+            for i in range(5):
+                (Path(tmpdir) / f"t{i}.html").write_text(f"Template {i}")
+            loader = loaders.FileSystemLoader(tmpdir, path_cache_size=3)
+            env = Environment(loader=loader)
+            # Load t0, t1, t2 (all cached)
+            for i in range(5):
+                env.get_template(f"t{i}.html")
+            # Cache size is 3, so only t2, t3, t4 should be cached (t2 most recently used at this point due to order)
+            # Actually, let's be more precise:
+            # Load order: t0, t1, t2, t3, t4
+            # After t0: cache = [t0]
+            # After t1: cache = [t0, t1]
+            # After t2: cache = [t0, t1, t2]
+            # After t3: cache = [t1, t2, t3]  (t0 evicted)
+            # After t4: cache = [t2, t3, t4]  (t1 evicted)
+            assert "t0.html" not in loader._path_cache
+            assert "t1.html" not in loader._path_cache
+            assert "t2.html" in loader._path_cache
+            assert "t3.html" in loader._path_cache
+            assert "t4.html" in loader._path_cache
+        finally:
+            import shutil
+            shutil.rmtree(tmpdir)
+
