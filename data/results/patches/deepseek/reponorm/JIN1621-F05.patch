+    def test_path_cache_disabled_by_default(self):
+        """Default path_cache_size=0 means no caching."""
+        loader = loaders.FileSystemLoader(str(self.searchpath))
+        assert loader._path_cache is None
+
+    def test_path_cache_rejects_bool(self):
+        """Booleans raise TypeError."""
+        with pytest.raises(TypeError):
+            loaders.FileSystemLoader(str(self.searchpath), path_cache_size=True)
+        with pytest.raises(TypeError):
+            loaders.FileSystemLoader(str(self.searchpath), path_cache_size=False)
+
+    def test_path_cache_rejects_negative(self):
+        """Negative integers raise ValueError."""
+        with pytest.raises(ValueError):
+            loaders.FileSystemLoader(str(self.searchpath), path_cache_size=-1)
+
+    def test_path_cache_zero_disables(self):
+        """Explicit zero disables cache."""
+        loader = loaders.FileSystemLoader(str(self.searchpath), path_cache_size=0)
+        assert loader._path_cache is None
+
+    def test_path_cache_hit_and_miss(self):
+        """Positive size caches hits; misses are not cached."""
+        loader = loaders.FileSystemLoader(str(self.searchpath), path_cache_size=10)
+        env = Environment(loader=loader)
+        # A hit
+        tmpl = env.get_template("test.html")
+        assert tmpl.render().strip() == "BAR"
+        assert "test.html" in loader._path_cache
+        # A miss is not cached
+        with pytest.raises(TemplateNotFound):
+            env.get_template("nonexistent.html")
+        assert "nonexistent.html" not in loader._path_cache
+
+    def test_path_cache_clear(self):
+        """clear_path_cache() removes all entries."""
+        loader = loaders.FileSystemLoader(str(self.searchpath), path_cache_size=10)
+        env = Environment(loader=loader)
+        env.get_template("test.html")
+        env.get_template("foo/test.html")
+        assert len(loader._path_cache) == 2
+        loader.clear_path_cache()
+        assert len(loader._path_cache) == 0
+
+    def test_resize_path_cache_increase(self):
+        """resize_path_cache can increase capacity."""
+        loader = loaders.FileSystemLoader(str(self.searchpath), path_cache_size=1)
+
+        def _load(name):
+            # Fresh Environment to bypass compiled template cache.
+            return Environment(loader=loader).get_template(name)
+
+        _load("test.html")
+        _load("foo/test.html")
+        # Only one entry kept due to LRU
+        assert len(loader._path_cache) == 1
+        loader.resize_path_cache(10)
+        _load("test.html")
+        _load("foo/test.html")
+        assert len(loader._path_cache) == 2
+
