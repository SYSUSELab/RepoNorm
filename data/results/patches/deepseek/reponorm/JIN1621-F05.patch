+            # tmpdir1 is first, so "name.html" resolves to FIRST
+            tmpl = env.get_template("name.html")
+            assert tmpl.render().strip() == "FIRST"
+            # Remove from first path
+            (Path(tmpdir1) / "name.html").unlink()
+            # Should now resolve from second path
