+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str, int], str]]
+        ] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str], str]]
+        ] = None,
+        fallback_npgettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str, str, int], str]]
+        ] = None,
+    ) -> None:
+        # Validate contextual fallback requirements.
+        if fallback_pgettext_funcs is not None and pgettext is None:
+            raise ValueError(
+                "install_gettext_callables_with_fallback requires pgettext "
+                "when fallback_pgettext_funcs is provided"
+            )
+        if fallback_npgettext_funcs is not None and npgettext is None:
+            raise ValueError(
+                "install_gettext_callables_with_fallback requires npgettext "
+                "when fallback_npgettext_funcs is provided"
+            )
+
+        # Snapshot fallback iterables.
+        fb_gettext: t.Tuple[t.Callable[[str], str], ...] = ()
+        fb_ngettext: t.Tuple[t.Callable[[str, str, int], str], ...] = ()
+        fb_pgettext: t.Tuple[t.Callable[[str, str], str], ...] = ()
+        fb_npgettext: t.Tuple[t.Callable[[str, str, str, int], str], ...] = ()
+
+        if fallback_gettext_funcs is not None:
+            fb_gettext = tuple(fallback_gettext_funcs)
+
+        if fallback_ngettext_funcs is not None:
+            fb_ngettext = tuple(fallback_ngettext_funcs)
+
+        if fallback_pgettext_funcs is not None:
+            fb_pgettext = tuple(fallback_pgettext_funcs)
+
+        if fallback_npgettext_funcs is not None:
+            fb_npgettext = tuple(fallback_npgettext_funcs)
+
+        # Build chained functions that try primary then fallbacks.
+        if fb_gettext:
+            gettext = _chain_gettext(gettext, fb_gettext)
+
+        if fb_ngettext:
+            ngettext = _chain_ngettext(ngettext, fb_ngettext)
+
+        if fb_pgettext:
+            pgettext = _chain_pgettext(pgettext, fb_pgettext)
+
+        if fb_npgettext:
+            npgettext = _chain_npgettext(npgettext, fb_npgettext)
+
+        # Delegate to the standard installer for newstyle wrapping and globe updates.
+        self._install_callables(
+            gettext, ngettext, newstyle=newstyle, pgettext=pgettext, npgettext=npgettext
+        )
+
