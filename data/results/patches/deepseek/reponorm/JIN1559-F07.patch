+class TestInternationalizationWithFallback:
+    """Tests for install_gettext_callables_with_fallback."""
+
+    def _make_env(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        return env
+
+    def test_basic_gettext_fallback(self):
+        """Primary returns source message, fallback translates it."""
+        env = self._make_env()
+        primary = lambda msg: msg  # returns source -> miss
+        fallback = lambda msg: "translated-" + msg
+        env.install_gettext_callables_with_fallback(
+            gettext=primary, ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[fallback],
+        )
+        assert env.globals["gettext"]("hello") == "translated-hello"
+
+    def test_basic_gettext_no_fallback_needed(self):
+        """Primary provides translation, fallbacks not consulted."""
+        calls = []
+        env = self._make_env()
+        primary = lambda msg: "primary-" + msg
+        fallback = lambda msg: calls.append("called") or "fb-" + msg
+        env.install_gettext_callables_with_fallback(
+            gettext=primary, ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[fallback],
+        )
+        assert env.globals["gettext"]("hello") == "primary-hello"
+        assert calls == []
+
+    def test_fallback_stops_at_first_hit(self):
+        """Fallback chain stops at first non-missing result."""
+        order = []
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[
+                lambda msg: order.append("fb1") or msg,
+                lambda msg: order.append("fb2") or "fb2-" + msg,
+                lambda msg: order.append("fb3") or "fb3-" + msg,
+            ],
+        )
+        assert env.globals["gettext"]("hello") == "fb2-hello"
+        assert order == ["fb1", "fb2"]
+
+    def test_all_fallbacks_miss(self):
+        """Every provider misses: return the source message."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[
+                lambda msg: msg,
+                lambda msg: msg,
+            ],
+        )
+        assert env.globals["gettext"]("hello") == "hello"
+
+    def test_basic_ngettext_fallback(self):
+        """Primary returns source form, fallback translates."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,  # returns source -> miss
+            fallback_ngettext_funcs=[
+                lambda s, p, n: "fb-" + (s if n == 1 else p),
+            ],
+        )
+        ngt = env.globals["ngettext"]
+        assert ngt("cat", "cats", 1) == "fb-cat"
+        assert ngt("cat", "cats", 2) == "fb-cats"
+
+    def test_ngettext_source_selection(self):
+        """Miss comparison uses singular when n==1, plural otherwise."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: "not-" + (s if n == 1 else p),
+            fallback_ngettext_funcs=[
+                lambda s, p, n: "fb-" + (s if n == 1 else p),
+            ],
+        )
+        ngt = env.globals["ngettext"]
+        # Primary already returned a non-missing result
+        assert ngt("cat", "cats", 1) == "not-cat"
+        assert ngt("cat", "cats", 2) == "not-cats"
+
+    def test_ngettext_source_selection_miss(self):
+        """Primary returns source form, fallback consulted."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,  # returns source = miss
+            fallback_ngettext_funcs=[
+                lambda s, p, n: "fb-" + (s if n == 1 else p),
+            ],
+        )
+        ngt = env.globals["ngettext"]
+        assert ngt("cat", "cats", 1) == "fb-cat"
+        assert ngt("cat", "cats", 2) == "fb-cats"
+
+    def test_exception_propagation(self):
+        """Provider exception propagates without calling later fallbacks."""
+        order = []
+        env = self._make_env()
+        primary = lambda msg: msg  # miss
+        fb1 = lambda msg: (_ for _ in ()).throw(RuntimeError("fb1 failed"))
+        fb2 = lambda msg: order.append("fb2") or "fb2-" + msg
+
+        with pytest.raises(RuntimeError, match="fb1 failed"):
+            env.install_gettext_callables_with_fallback(
+                gettext=primary,
+                ngettext=lambda s, p, n: s if n == 1 else p,
+                fallback_gettext_funcs=[fb1, fb2],
+            )
+            env.globals["gettext"]("hello")
+        assert order == []
+
+    def test_fallback_pgettext_requires_primary(self):
+        """Non-empty fallback_pgettext_funcs without pgettext raises ValueError."""
+        env = self._make_env()
+        with pytest.raises(ValueError, match="pgettext"):
+            env.install_gettext_callables_with_fallback(
+                gettext=lambda m: m,
+                ngettext=lambda s, p, n: s if n == 1 else p,
+                fallback_pgettext_funcs=[lambda c, m: m],
+            )
+
+    def test_fallback_npgettext_requires_primary(self):
+        """Non-empty fallback_npgettext_funcs without npgettext raises ValueError."""
+        env = self._make_env()
+        with pytest.raises(ValueError, match="npgettext"):
+            env.install_gettext_callables_with_fallback(
+                gettext=lambda m: m,
+                ngettext=lambda s, p, n: s if n == 1 else p,
+                fallback_npgettext_funcs=[lambda c, s, p, n: s if n == 1 else p],
+            )
+
+    def test_pgettext_with_pgettext_ok(self):
+        """Non-empty fallback_pgettext_funcs with pgettext works."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda m: m,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            pgettext=lambda c, m: m,  # returns source -> miss
+            fallback_pgettext_funcs=[lambda c, m: c + ":" + m],
+        )
+        assert env.globals["pgettext"]("ctx", "hello") == "ctx:hello"
+
+    def test_npgettext_with_npgettext_ok(self):
+        """Non-empty fallback_npgettext_funcs with npgettext works."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda m: m,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            npgettext=lambda c, s, p, n: s if n == 1 else p,  # source -> miss
+            fallback_npgettext_funcs=[lambda c, s, p, n: c + ":" + (s if n == 1 else p)],
+        )
+        npgt = env.globals["npgettext"]
+        assert npgt("ctx", "cat", "cats", 1) == "ctx:cat"
+        assert npgt("ctx", "cat", "cats", 2) == "ctx:cats"
+
+    def test_context_provided_on_each_fallback_attempt(self):
+        """Context string is passed to every context fallback provider."""
+        contexts = []
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda m: m,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            pgettext=lambda c, m: m,  # miss
+            fallback_pgettext_funcs=[lambda c, m: contexts.append(c) or m],
+        )
+        env.globals["pgettext"]("fruit", "Apple")
+        assert contexts == ["fruit"]
+
+    def test_snapshot(self):
+        """Fallback iterable is snapshot when installed; later mutations ignored."""
+        env = self._make_env()
+        fallbacks = [lambda msg: "first"]
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=fallbacks,
+        )
+        # Modify the original list
+        fallbacks.append(lambda msg: "second")
+        # Should still return "first" (from snapshot)
+        assert env.globals["gettext"]("hello") == "first"
+
+    def test_reinstall_replaces_chains(self):
+        """Calling installer again replaces all installed providers and chains."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[lambda msg: "fb1-" + msg],
+        )
+        assert env.globals["gettext"]("hello") == "fb1-hello"
+
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: "primary-" + msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+        )
+        assert env.globals["gettext"]("hello") == "primary-hello"
+
+    def test_empty_fallback_behavior(self):
+        """Empty or None fallbacks behave like install_gettext_callables."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: "yes-" + msg,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+        )
+        assert env.globals["gettext"]("hello") == "yes-hello"
+
+    def test_newstyle_with_fallback(self):
+        """Newstyle formatting works with fallback chains."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,  # miss
+            ngettext=lambda s, p, n: s if n == 1 else p,
