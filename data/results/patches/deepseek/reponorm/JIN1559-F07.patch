+
+    def test_trans_block_with_fallback(self):
+        """{% trans %} blocks use chained gettext/ngettext."""
+        env = self._make_env()
+        env.install_gettext_callables_with_fallback(
+            gettext=lambda msg: msg,  # miss
+            ngettext=lambda s, p, n: s if n == 1 else p,  # miss
+            fallback_gettext_funcs=[lambda msg: "fb-" + msg],
