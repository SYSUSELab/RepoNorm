+def _chain_gettext(
+    primary: t.Callable[[str], str],
+    fallbacks: t.Iterable[t.Callable[[str], str]],
+) -> t.Callable[[str], str]:
+    """Combine a primary gettext callable with ordered fallbacks."""
+    fallback_list: t.Tuple[t.Callable[[str], str], ...] = tuple(fallbacks)
+
+    def gettext(message: str) -> str:
+        rv = primary(message)
+        if rv != message:
+            return rv
+        for fb in fallback_list:
+            rv = fb(message)
+            if rv != message:
+                return rv
+        return message
+
+    return gettext
+
+
+def _chain_ngettext(
+    primary: t.Callable[[str, str, int], str],
+    fallbacks: t.Iterable[t.Callable[[str, str, int], str]],
+) -> t.Callable[[str, str, int], str]:
+    """Combine a primary ngettext callable with ordered fallbacks."""
+    fallback_list: t.Tuple[t.Callable[[str, str, int], str], ...] = tuple(fallbacks)
+
+    def ngettext(singular: str, plural: str, n: int) -> str:
+        rv = primary(singular, plural, n)
+        source = singular if n == 1 else plural
+        if rv != source:
+            return rv
+        for fb in fallback_list:
+            rv = fb(singular, plural, n)
+            if rv != source:
+                return rv
+        return source
+
+    return ngettext
+
+
+def _chain_pgettext(
+    primary: t.Callable[[str, str], str],
+    fallbacks: t.Iterable[t.Callable[[str, str], str]],
+) -> t.Callable[[str, str], str]:
+    """Combine a primary pgettext callable with ordered fallbacks."""
+    fallback_list: t.Tuple[t.Callable[[str, str], str], ...] = tuple(fallbacks)
+
+    def pgettext(context: str, message: str) -> str:
+        rv = primary(context, message)
+        if rv != message:
+            return rv
+        for fb in fallback_list:
+            rv = fb(context, message)
+            if rv != message:
+                return rv
+        return message
+
+    return pgettext
+
+
+def _chain_npgettext(
+    primary: t.Callable[[str, str, str, int], str],
+    fallbacks: t.Iterable[t.Callable[[str, str, str, int], str]],
+) -> t.Callable[[str, str, str, int], str]:
+    """Combine a primary npgettext callable with ordered fallbacks."""
+    fallback_list: t.Tuple[t.Callable[[str, str, str, int], str], ...] = tuple(fallbacks)
+
+    def npgettext(context: str, singular: str, plural: str, n: int) -> str:
+        rv = primary(context, singular, plural, n)
+        source = singular if n == 1 else plural
+        if rv != source:
+            return rv
+        for fb in fallback_list:
+            rv = fb(context, singular, plural, n)
+            if rv != source:
+                return rv
+        return source
+
+    return npgettext
+
+
