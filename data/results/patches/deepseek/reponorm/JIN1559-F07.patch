+
+        t_plural = env.from_string(
+            "{% trans count=2 %}{{ count }} cat{% pluralize %}{{ count }} cats{% endtrans %}"
+        )
+        assert t_plural.render() == "fb-2 cats"
+
+    def test_newstyle_autoescape_with_fallback(self):
+        """Autoescaping works after fallback selection."""
+        env = self._make_env()
