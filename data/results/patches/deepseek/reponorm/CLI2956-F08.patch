+import time
+import pytest
+import click
+from click.core import Context, ParameterSource, Option
+
+
+def test_get_option_history_returns_none_when_disabled():
+    """When tracking is disabled, get_option_history returns None."""
+    @click.command()
+    @click.option("--count", default=1)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    rv = cli([], standalone_mode=False)
+    assert rv is None
+
+
+def test_get_option_history_empty_list_for_unknown_name():
+    """When tracking is enabled but name doesn't identify an option, returns []."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("nonexistent")
+
+    rv = cli([], standalone_mode=False)
+    assert rv == []
+
+
+def test_get_option_history_unknown_name_still_returns_list():
+    """Returns [] for unknown option name even when tracking is enabled."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("--nonexistent")
+
+    rv = cli([], standalone_mode=False)
+    assert rv == []
+
+
+def test_get_option_history_by_python_name():
+    """Lookup by Python parameter name works."""
+    @click.command(track_changes=True)
+    @click.option("--count", "-c", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    rv = cli(["--count", "5"], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] == 5
+
+
+def test_get_option_history_by_long_opt():
+    """Lookup by --long-option works."""
+    @click.command(track_changes=True)
+    @click.option("--count", "-c", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("--count")
+
+    rv = cli(["-c", "5"], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] == 5
+
+
+def test_get_option_history_by_short_opt():
+    """Lookup by -short works."""
+    @click.command(track_changes=True)
+    @click.option("--count", "-c", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("-c")
+
+    rv = cli(["--count", "5"], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] == 5
+
+
+def test_history_entry_shape():
+    """Each entry has value, source, and timestamp keys."""
+    @click.command(track_changes=True)
+    @click.option("--name", default="world")
+    def cli(name):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("name")
+
+    rv = cli(["--name", "hello"], standalone_mode=False)
+    assert len(rv) == 1
+    entry = rv[0]
+    assert "value" in entry
+    assert "source" in entry
+    assert "timestamp" in entry
+    assert entry["value"] == "hello"
+    assert entry["source"] == ParameterSource.COMMANDLINE
+    assert isinstance(entry["timestamp"], float)
+
+
+def test_default_source():
+    """When no value is provided, uses DEFAULT source."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=42, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    rv = cli([], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["source"] == ParameterSource.DEFAULT
+    assert rv[0]["value"] == 42
+
+
+def test_environment_source(runner):
+    """When value comes from environment, uses ENVIRONMENT source."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, envvar="TEST_COUNT", type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    rv = runner.invoke(cli, [], env={"TEST_COUNT": "99"}, standalone_mode=False)
+    assert rv.exit_code == 0
+    assert len(rv.return_value) == 1
+    assert rv.return_value[0]["source"] == ParameterSource.ENVIRONMENT
+    assert rv.return_value[0]["value"] == 99
+
+
+def test_commandline_source():
+    """When value comes from command line, uses COMMANDLINE source."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    rv = cli(["--count", "5"], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["source"] == ParameterSource.COMMANDLINE
+    assert rv[0]["value"] == 5
+
+
+def test_manual_assignment_appends_with_source_none():
+    """Manual assignment via ctx.params appends with source=None."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        ctx.params["count"] = 99
+        return ctx.get_option_history("count")
+
+    rv = cli([], standalone_mode=False)
+    assert len(rv) == 2
+    assert rv[0]["source"] == ParameterSource.DEFAULT
+    assert rv[0]["value"] == 1
+    assert rv[1]["source"] is None
+    assert rv[1]["value"] == 99
+
+
+def test_manual_assignment_does_not_inherit_previous_source():
+    """Manual assignment must not inherit the parser's earlier source."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        ctx.params["count"] = 99
+        return ctx.get_option_history("count")
+
+    rv = cli(["--count", "5"], standalone_mode=False)
+    assert len(rv) == 2
+    assert rv[0]["source"] == ParameterSource.COMMANDLINE
+    assert rv[0]["value"] == 5
+    assert rv[1]["source"] is None
+    assert rv[1]["value"] == 99
+
+
+def test_repeated_manual_assignments_retain_order():
+    """Repeated manual assignments are all retained in order."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        ctx.params["count"] = 10
+        ctx.params["count"] = 20
+        return ctx.get_option_history("count")
+
+    rv = cli(["--count", "5"], standalone_mode=False)
+    assert len(rv) == 3
+    assert rv[0]["value"] == 5
+    assert rv[1]["value"] == 10
+    assert rv[2]["value"] == 20
+
+
+def test_snapshot_isolation():
+    """Returned snapshots don't change when new values are assigned."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        hist = ctx.get_option_history("count")
+        orig_len = len(hist)
+        ctx.params["count"] = 99
+        assert len(hist) == orig_len, "Snapshot should not grow"
+        return hist
+
+    rv = cli([], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] == 1
+
+
+def test_snapshot_entry_immutable():
+    """Mutating returned entries should not affect history."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        hist = ctx.get_option_history("count")
+        # Mutate the returned entry (dict copy)
+        if hist:
+            hist[0]["value"] = 999
+        # Get a fresh snapshot
+        hist2 = ctx.get_option_history("count")
+        return hist2
+
+    rv = cli([], standalone_mode=False)
+    assert rv[0]["value"] == 1, "Mutation of snapshot should not affect underlying history"
+
+
+def test_multiple_option_recorded_once_with_tuple():
+    """Multiple option is recorded once with final tuple."""
+    @click.command(track_changes=True)
+    @click.option("--name", multiple=True)
+    def cli(name):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("name")
+
+    rv = cli(["--name", "a", "--name", "b"], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] == ("a", "b")
+    assert rv[0]["source"] == ParameterSource.COMMANDLINE
+
+
+def test_boolean_flag():
+    """Boolean flag is tracked correctly."""
+    @click.command(track_changes=True)
+    @click.option("--verbose", "-v", is_flag=True)
+    def cli(verbose):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("verbose")
+
+    rv = cli(["-v"], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] is True
+    assert rv[0]["source"] == ParameterSource.COMMANDLINE
+
+
+def test_boolean_flag_default():
+    """Boolean flag default (False) is tracked with DEFAULT source."""
+    @click.command(track_changes=True)
+    @click.option("--verbose", "-v", is_flag=True)
+    def cli(verbose):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("verbose")
+
+    rv = cli([], standalone_mode=False)
+    assert len(rv) == 1
+    assert rv[0]["value"] is False
+    assert rv[0]["source"] == ParameterSource.DEFAULT
+
