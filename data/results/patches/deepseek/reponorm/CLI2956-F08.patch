+def test_group_subcommand_independence(runner):
+    """Group and subcommand have independent histories."""
+    @click.group(track_changes=True)
+    @click.option("--verbose", "-v", is_flag=True)
+    def cli(verbose):
+        pass
+
+    @cli.command(track_changes=True)
+    @click.option("--name", default="world")
+    def hello(name):
+        ctx = click.get_current_context()
+        return {
+            "sub_name": ctx.get_option_history("name"),
+            "sub_verbose": ctx.get_option_history("verbose"),
+            "parent_verbose": ctx.parent.get_option_history("verbose"),
+        }
+
+    rv = runner.invoke(cli, ["-v", "hello", "--name", "test"], standalone_mode=False)
+    assert rv.exit_code == 0
+    data = rv.return_value
+    # Subcommand's own option
+    assert len(data["sub_name"]) == 1
+    assert data["sub_name"][0]["value"] == "test"
+    assert data["sub_name"][0]["source"] == ParameterSource.COMMANDLINE
+    # Subcommand doesn't have 'verbose' (it's on the group)
+    assert data["sub_verbose"] == []
+    # Parent has verbose
+    assert len(data["parent_verbose"]) == 1
+    assert data["parent_verbose"][0]["value"] is True
+    assert data["parent_verbose"][0]["source"] == ParameterSource.COMMANDLINE
+
+
+def test_group_tracking_does_not_leak_to_subcommand(runner):
+    """Enabling tracking on a group does not enable it on a subcommand."""
+    @click.group(track_changes=True)
+    @click.option("--verbose", "-v", is_flag=True)
+    def cli(verbose):
+        pass
+
+    @cli.command()  # no track_changes
+    @click.option("--name", default="world")
+    def hello(name):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("name")
+
+    rv = runner.invoke(cli, ["-v", "hello", "--name", "test"], standalone_mode=False)
+    assert rv.exit_code == 0
+    assert rv.return_value is None
+
+
+def test_subcommand_tracking_does_not_leak_to_group(runner):
