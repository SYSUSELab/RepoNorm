+def test_fresh_history_each_invocation(runner):
+    """Each invocation creates a fresh history."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    rv1 = runner.invoke(cli, ["--count", "5"], standalone_mode=False)
+    rv2 = runner.invoke(cli, ["--count", "10"], standalone_mode=False)
+    assert rv1.exit_code == 0
+    assert rv2.exit_code == 0
+    assert rv1.return_value[0]["value"] == 5
+    assert rv2.return_value[0]["value"] == 10
+
+
+def test_timestamp_roughly_current_time():
+    """Timestamp should be roughly current time."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=1, type=int)
+    def cli(count):
+        ctx = click.get_current_context()
+        return ctx.get_option_history("count")
+
+    before = time.time()
+    rv = cli([], standalone_mode=False)
+    after = time.time()
+    assert len(rv) == 1
+    ts = rv[0]["timestamp"]
+    assert before - 2 <= ts <= after + 2, f"Timestamp {ts} outside range [{before}, {after}]"
+
+
+def test_no_history_for_arguments():
+    """Positional arguments are not option history entries."""
+    @click.command(track_changes=True)
+    @click.argument("input_file")
+    @click.option("--output", "-o", default="out.txt")
+    def cli(input_file, output):
+        ctx = click.get_current_context()
+        return (
+            ctx.get_option_history("input_file"),
+            ctx.get_option_history("output"),
+        )
+
+    rv = cli(["in.txt", "-o", "out.log"], standalone_mode=False)
+    arg_hist, opt_hist = rv
+    assert arg_hist == [], "Arguments should have no history"
+    assert len(opt_hist) == 1
+    assert opt_hist[0]["value"] == "out.log"
+
