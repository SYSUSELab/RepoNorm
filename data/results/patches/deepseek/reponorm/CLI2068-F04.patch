+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_editor_args_with_sed(runner):
+    """Test that editor_args are passed correctly between editor and filename."""
+    result = click.edit("a\nb", editor="sed", editor_args=["-i~", "s/$/Test/"])
+    assert result == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_editor_args_none_and_empty(runner):
+    """Test that None and empty iterable preserve existing behavior."""
+    result1 = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", editor_args=None)
+    assert result1 == "aTest\nbTest\n"
+    result2 = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", editor_args=[])
+    assert result2 == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_editor_args_with_filename(runner):
+    """Test that editor_args work with direct file editing."""
+    import tempfile
+    import os
+
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
+        f.write("hello\n")
+        fname = f.name
+
+    try:
+        click.edit(editor="sed", editor_args=["-i", "s/hello/world/"], filename=fname)
+        with open(fname) as fh:
+            assert fh.read() == "world\n"
+    finally:
+        os.unlink(fname)
+
+
+def test_editor_args_type_error():
+    """Test that non-string items raise TypeError."""
+    with pytest.raises(TypeError):
+        click.edit("test", editor="cat", editor_args=[1, 2, 3])
+
+    with pytest.raises(TypeError):
+        click.edit("test", editor="cat", editor_args=["-n", None])
+
+    with pytest.raises(TypeError):
+        click.edit("test", editor="cat", editor_args=[b"bytes"])
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_editor_args_with_editor_containing_args(runner):
+    """Test that editor_args combine correctly with editor that already has args."""
+    result = click.edit(
+        "a\nb",
+        editor="sed -i~",
+        editor_args=["s/$/Test/"],
+    )
+    assert result == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_editor_args_one_shot_iterable(runner):
+    """Test that a one-shot iterable (e.g., generator) is properly consumed."""
+    def gen():
+        yield "-i~"
+        yield "s/$/Test/"
+
+    result = click.edit("a\nb", editor="sed", editor_args=gen())
+    assert result == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_editor_args_spaces_and_special_chars(runner):
+    """Test that editor_args with spaces and special characters works safely."""
+    result = click.edit(
+        "a\nb",
+        editor="sed",
+        editor_args=["-i~", "s/$/Test/"],
+    )
+    assert result == "aTest\nbTest\n"
+
