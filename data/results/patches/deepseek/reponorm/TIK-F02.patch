+    def _compute_token_offsets(self, tokens: Sequence[int]) -> list[int]:
+        """Computes character offsets for each token.
+
+        Each offset is the zero-based Python character index in the original text
+        corresponding to the start of each token. If a token starts inside a multibyte
+        character, the offset is the index of that containing character.
+
+        Empty input yields ([]).
+        """
+        token_bytes = self.decode_tokens_bytes(tokens)
+
+        text_len = 0
+        offsets = []
+        for token in token_bytes:
+            offsets.append(max(0, text_len - (0x80 <= token[0] < 0xC0)))
+            text_len += sum(1 for c in token if not 0x80 <= c < 0xC0)
+        return offsets
+
