     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches credit card numbers. Accepts exactly 16 ASCII digits in one of three
+# shapes: no separators, four groups of four separated by single hyphens, or
+# four groups of four separated by single spaces. Separators must be consistent.
+# This type checks textual shape only; it does not validate Luhn checksums,
+# issuers, BIN ranges, or whether a number was issued.
+credit_card = Regex(
+    r"([0-9]{16}|[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}|[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4})"
+)
