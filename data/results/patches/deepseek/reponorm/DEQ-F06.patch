diff --git a/dirty_equals/_credit_card.py b/dirty_equals/_credit_card.py
new file mode 100644
index 0000000..d4af72e
--- /dev/null
+++ b/dirty_equals/_credit_card.py
@@ -0,0 +1,131 @@
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+Issuer = Literal['Visa', 'Mastercard', 'AmericanExpress']
+
+
+def _luhn_checksum(card_number: str) -> bool:
+    """
+    Validate a card number using the Luhn algorithm.
+    """
+    digits = [int(d) for d in card_number]
+    # Double every second digit from the right
+    for i in range(len(digits) - 2, -1, -2):
+        digits[i] *= 2
+        if digits[i] > 9:
+            digits[i] -= 9
+    return sum(digits) % 10 == 0
+
+
+_ASCII_DIGITS = set('0123456789')
+
+
+def _normalize(card_str: str) -> Optional[str]:
+    """
+    Normalize a card number string: strip whitespace, remove spaces and hyphens,
+    then check it contains only ASCII digits.
+    """
+    stripped = card_str.strip()
+    cleaned = stripped.replace(' ', '').replace('-', '')
+    # Check all characters are ASCII digits
+    if not all(c in _ASCII_DIGITS for c in cleaned):
+        return None
+    return cleaned
+
+
+_VISA_LENGTHS = {13, 16, 19}
+_MASTERCARD_LENGTHS = {16}
+_AMEX_LENGTHS = {15}
+
+
+def _check_issuer(card_number: str, issuer: Optional[str]) -> bool:
+    """Check issuer rules for a normalized card number."""
+    length = len(card_number)
+    if length < 12 or length > 19:
+        return False
+
+    if issuer is None:
+        return True
+
+    if issuer == 'Visa':
+        if length not in _VISA_LENGTHS:
+            return False
+        if not card_number.startswith('4'):
+            return False
+    elif issuer == 'Mastercard':
+        if length not in _MASTERCARD_LENGTHS:
+            return False
+        first_two = int(card_number[:2])
+        first_four = int(card_number[:4])
+        if not (51 <= first_two <= 55 or 2221 <= first_four <= 2720):
+            return False
+    elif issuer == 'AmericanExpress':
+        if length not in _AMEX_LENGTHS:
+            return False
+        if not (card_number.startswith('34') or card_number.startswith('37')):
+            return False
+    else:
+        # Unknown issuer - not equal
+        return False
+
+    return True
+
+
+class IsCreditCard(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid credit card number using the Luhn algorithm,
+    optionally checking the card issuer.
+
+    Accepts strings (with optional spaces, hyphens, and surrounding whitespace)
+    and integers.
+    """
+
+    def __init__(self, issuer: Optional[Issuer] = None):
+        """
+        Args:
+            issuer: The expected card issuer, one of `'Visa'`, `'Mastercard'`,
+                or `'AmericanExpress'`. If omitted, any valid card number is accepted.
+
+        ```py title="IsCreditCard"
+        from dirty_equals import IsCreditCard
+
+        assert '4111111111111111' == IsCreditCard
+        assert '4111111111111111' == IsCreditCard()
+        assert '4111 1111 1111 1111' == IsCreditCard
+        assert '4111-1111-1111-1111' == IsCreditCard
+        assert '  4111111111111111  ' == IsCreditCard
+        assert 4111111111111111 == IsCreditCard
+
+        assert '4111111111111111' == IsCreditCard('Visa')
+        assert '5500000000000004' == IsCreditCard('Mastercard')
+        assert '378282246310005' == IsCreditCard('AmericanExpress')
+
+        assert '4111111111111111' != IsCreditCard('Mastercard')
+        assert '1234567890123456' != IsCreditCard
+        ```
+        """
+        self.issuer = issuer
+        super().__init__(issuer or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if isinstance(other, str):
+            normalized = _normalize(other)
+            if normalized is None:
+                return False
+        elif isinstance(other, int):
+            normalized = str(other)
+        else:
+            return False
+
+        if not _check_issuer(normalized, self.issuer):
+            return False
+
+        return _luhn_checksum(normalized)
diff --git a/tests/test_credit_card.py b/tests/test_credit_card.py
