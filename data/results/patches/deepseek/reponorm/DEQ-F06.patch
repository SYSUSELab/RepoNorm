index 0000000..ed8a80e
--- /dev/null
+++ b/tests/test_credit_card.py
@@ -0,0 +1,148 @@
+import pytest
+
+from dirty_equals import IsCreditCard
+
+
+# Luhn-valid card numbers
+VALID_VISA_16 = '4111111111111111'
+VALID_VISA_13 = '4111111111119'
+VALID_VISA_19 = '4111111111111111110'
+VALID_MASTERCARD = '5555555555554444'
+VALID_MASTERCARD_51 = '5100000000000008'
+VALID_MASTERCARD_55 = '5500000000000004'
+VALID_MASTERCARD_2221 = '2221000000000009'
+VALID_MASTERCARD_2720 = '2720000000000005'
+VALID_AMEX = '378282246310005'
+VALID_AMEX_34 = '340000000000009'
+VALID_AMEX_37 = '370000000000002'
+INVALID_LUHN = '4111111111111112'
+
+
+# --- True cases (matches without issuer) ---
+TRUE_CASES = [
+    (VALID_VISA_16, IsCreditCard()),
+    (VALID_VISA_13, IsCreditCard()),
+    (VALID_VISA_19, IsCreditCard()),
+    (VALID_MASTERCARD, IsCreditCard()),
+    (VALID_AMEX, IsCreditCard()),
+    # with spaces
+    ('4111 1111 1111 1111', IsCreditCard()),
+    # with hyphens
+    ('4111-1111-1111-1111', IsCreditCard()),
+    # with surrounding whitespace
+    ('  4111111111111111  ', IsCreditCard()),
+    # integer input
+    (4111111111111111, IsCreditCard()),
+    # class-level equality
+    (VALID_VISA_16, IsCreditCard),
+    (VALID_MASTERCARD, IsCreditCard),
+    (VALID_AMEX, IsCreditCard),
+]
+
+
+@pytest.mark.parametrize('other, dirty', TRUE_CASES)
+def test_is_credit_card_true(other, dirty):
+    assert other == dirty
+
+
+# --- False cases ---
+FALSE_CASES = [
+    # wrong type
+    ([1, 2, 3], IsCreditCard()),
+    # invalid Luhn
+    (INVALID_LUHN, IsCreditCard()),
+    # too short (11 digits)
+    ('41111111111', IsCreditCard()),
+    # too long (20 digits)
+    ('41111111111111111111', IsCreditCard()),
+    # non-ASCII digit (fullwidth '4')
+    ('\uff1411111111111111', IsCreditCard()),
+    # letters
+    ('abc', IsCreditCard()),
+    # invalid characters
+    ('4111_1111_1111_1111', IsCreditCard()),
+    # empty string
+    ('', IsCreditCard()),
+    # None
+    (None, IsCreditCard()),
+    # True (bool)
+    (True, IsCreditCard()),
+]
+
+
+@pytest.mark.parametrize('other, dirty', FALSE_CASES)
+def test_is_credit_card_false(other, dirty):
+    assert other != dirty
+
+
+# --- Issuer true cases ---
+ISSUER_TRUE_CASES = [
+    (VALID_VISA_16, IsCreditCard('Visa')),
+    (VALID_VISA_13, IsCreditCard('Visa')),
+    (VALID_VISA_19, IsCreditCard('Visa')),
+    (VALID_MASTERCARD, IsCreditCard('Mastercard')),
+    (VALID_MASTERCARD_51, IsCreditCard('Mastercard')),
+    (VALID_MASTERCARD_55, IsCreditCard('Mastercard')),
+    (VALID_MASTERCARD_2221, IsCreditCard('Mastercard')),
+    (VALID_MASTERCARD_2720, IsCreditCard('Mastercard')),
+    (VALID_AMEX, IsCreditCard('AmericanExpress')),
+    (VALID_AMEX_34, IsCreditCard('AmericanExpress')),
+    (VALID_AMEX_37, IsCreditCard('AmericanExpress')),
+]
+
+
+@pytest.mark.parametrize('other, dirty', ISSUER_TRUE_CASES)
+def test_is_credit_card_issuer_true(other, dirty):
+    assert other == dirty
+
+
+# --- Issuer false cases ---
+ISSUER_FALSE_CASES = [
+    # Visa with wrong lengths
+    ('411111111111', IsCreditCard('Visa')),  # 12 digits - too short for Visa
+    ('41111111111111111', IsCreditCard('Visa')),  # 17 digits - not a Visa length
+    # Visa that doesn't start with 4
+    ('5111111111111111', IsCreditCard('Visa')),
+    # Mastercard with wrong prefix
+    ('50' + '0' * 13 + '0', IsCreditCard('Mastercard')),  # 50xx... invalid, this needs Luhn
+    ('56' + '0' * 13 + '0', IsCreditCard('Mastercard')),  # 56xx... invalid
+    ('2220' + '0' * 11 + '0', IsCreditCard('Mastercard')),  # too low
+    ('2721' + '0' * 11 + '0', IsCreditCard('Mastercard')),  # too high
+    # Mastercard with wrong length (13 digits)
+    ('5111111111111', IsCreditCard('Mastercard')),
+    # Amex with wrong prefix
+    ('36' + '0' * 12 + '0', IsCreditCard('AmericanExpress')),
+    ('33' + '0' * 12 + '0', IsCreditCard('AmericanExpress')),
+    # Amex with wrong length (16 digits)
+    ('34' + '0' * 13 + '0', IsCreditCard('AmericanExpress')),
+    # Number that is a valid Visa but checked against Mastercard
+    (VALID_VISA_16, IsCreditCard('Mastercard')),
+    (VALID_MASTERCARD, IsCreditCard('AmericanExpress')),
+    (VALID_AMEX, IsCreditCard('Visa')),
+]
+
+
+@pytest.mark.parametrize('other, dirty', ISSUER_FALSE_CASES)
+def test_is_credit_card_issuer_false(other, dirty):
+    assert other != dirty
+
+
+def test_repr_no_issuer():
+    c = IsCreditCard()
+    assert repr(c) == 'IsCreditCard(*)'
+
+
+def test_repr_with_issuer():
+    c = IsCreditCard('Visa')
+    assert repr(c) == "IsCreditCard('Visa')"
+
+
+def test_value_property():
+    c = IsCreditCard()
+    assert VALID_VISA_16 == c
+    assert c.value == VALID_VISA_16
+
+
+def test_class_equality():
+    assert VALID_VISA_16 == IsCreditCard
+    assert INVALID_LUHN != IsCreditCard
