new file mode 100644
index 0000000..1fa121f
--- /dev/null
+++ b/test_debug.py
@@ -0,0 +1,12 @@
+import click
+from click.testing import CliRunner
+
+@click.command()
+@click.option("--foo", "foo")
+@click.option("--bar", "bar", conflicts_with=["foo"])
+def cli(foo, bar):
+    click.echo(f"foo={foo}, bar={bar}")
+
+runner = CliRunner()
+result = runner.invoke(cli, ["--foo", "1", "--bar", "2"], catch_exceptions=False)
+print(f"Result: {result.exit_code}, Output: {result.output}")
