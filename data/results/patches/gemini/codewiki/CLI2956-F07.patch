diff --git a/reproduce_conflict.py b/reproduce_conflict.py
new file mode 100644
index 0000000..80cb94b
--- /dev/null
+++ b/reproduce_conflict.py
@@ -0,0 +1,30 @@
+import click
+from click.testing import CliRunner
+
+@click.command()
+@click.option("--foo", "foo", conflicts_with=["bar"])
+@click.option("--bar", "bar")
+def cli(foo, bar):
+    click.echo(f"foo={foo}, bar={bar}")
+
+runner = CliRunner()
+
+print("Test 1: Both provided")
+result = runner.invoke(cli, ["--foo", "1", "--bar", "2"])
+print(result.output)
+print(result.exit_code)
+
+print("\nTest 2: Only one provided")
+result = runner.invoke(cli, ["--foo", "1"])
+print(result.output)
+print(result.exit_code)
+
+print("\nTest 3: Invalid conflict")
+@click.command()
+@click.option("--foo", "foo", conflicts_with=["baz"])
+def invalid_cli(foo):
+    pass
+
+result = runner.invoke(invalid_cli, ["--foo", "1"])
+print(result.output)
+print(result.exit_code)
