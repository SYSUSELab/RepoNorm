diff --git a/tests/test_trans_validation.py b/tests/test_trans_validation.py
new file mode 100644
index 0000000..6714a19
--- /dev/null
+++ b/tests/test_trans_validation.py
@@ -0,0 +1,32 @@
+import pytest
+from jinja2 import Environment, DictLoader, exceptions
+from jinja2.ext import i18n
+
+@pytest.fixture
+def env():
+    env = Environment(loader=DictLoader({}), extensions=[i18n])
+    env.filters['filter'] = lambda x: x
+    env.tests['test'] = lambda x: True
+    return env
+
+def test_reserved_names(env):
+    for name in ["gettext", "ngettext", "pgettext", "npgettext", "_"]:
+        with pytest.raises(exceptions.TemplateSyntaxError, match=f"conflicts with translation function names"):
+            env.compile(f"{{% trans {name}='foo' %}}bar{{% endtrans %}}")
+
+def test_invalid_expressions(env):
+    invalid_exprs = [
+        "a+b", "a-b", "a*b", "a/b", "a if b else c", "obj[key]",
+        "func(*args)", "func(**kwargs)", "obj.method()"
+    ]
+    for expr in invalid_exprs:
+        with pytest.raises(exceptions.TemplateSyntaxError, match="has an invalid expression"):
+            env.compile(f"{{% trans x={expr} %}}bar{{% endtrans %}}")
+
+def test_valid_expressions(env):
+    valid_exprs = [
+        "1", "y", "obj.attr", "obj.attr.sub", "func(a, b=c)",
+        "val|filter", "val|filter(a)", "val is test"
+    ]
+    for expr in valid_exprs:
+        env.compile(f"{{% trans x={expr} %}}bar{{% endtrans %}}")
