@@ -0,0 +1,93 @@
+import sys
+
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the get_default method
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def get_default(' in line and 'self, ctx: Context, call: bool = True' in line:
+        start_line = i
+        break
+
+# Find the end of the method
+end_line = 0
+for i in range(start_line, len(lines)):
+    if lines[i].strip() == 'return value':
+        end_line = i
+        break
+
+# Replace the method body
+new_body = [
+    '        value = ctx.lookup_default(self.name, call=False)  # type: ignore\n',
+    '\n',
+    '        if value is None:\n',
+    '            value = self.default\n',
+    '\n',
+    '        if isinstance(value, dict) and value and all(k.startswith("--") for k in value.keys()):\n',
+    '            # Dynamic default\n',
+    '            # Check for cycle\n',
+    '            if getattr(ctx, "_dynamic_default_stack", None) is None:\n',
+    '                ctx._dynamic_default_stack = set()\n',
+    '            if self.name in ctx._dynamic_default_stack:\n',
+    '                raise UsageError(f"Dependency cycle detected for {self.name}.")\n',
+    '            ctx._dynamic_default_stack.add(self.name)\n',
+    '            try:\n',
+    '                for dep_name, mapping in value.items():\n',
+    '                    if not isinstance(mapping, dict):\n',
+    '                        raise TypeError(f"Dynamic default for {self.name} must be a dictionary.")\n',
+    '                    \n',
+    '                    # Find the parameter\n',
+    '                    dep_param = None\n',
+    '                    for param in ctx.command.params:\n',
+    '                        if dep_name in param.opts or dep_name in param.secondary_opts:\n',
+    '                            dep_param = param\n',
+    '                            break\n',
+    '                    \n',
+    '                    if dep_param is None:\n',
+    '                        raise UsageError(f"Unknown option {dep_name} in dynamic default for {self.name}.")\n',
+    '                    \n',
+    '                    # Get the value of the dependency\n',
+    '                    # We need to make sure the dependency is resolved\n',
+    '                    # We can use dep_param.get_default(ctx) to get the default value\n',
+    '                    # But we need to be careful about recursion.\n',
+    '                    # Actually, the requirement says "Resolve referenced dynamic options first".\n',
+    '                    # So we should call dep_param.get_default(ctx) which will trigger the resolution.\n',
+    '                    # We also need to check if the dependency was provided on the command line.\n',
+    '                    # ctx.params contains the parsed values.\n',
+    '                    dep_value = ctx.params.get(dep_param.name)\n',
+    '                    if dep_value is None:\n',
+    '                        dep_value = dep_param.get_default(ctx)\n',
+    '                    \n',
+    '                    # Match the dependency value\n',
+    '                    dep_value_str = str(dep_value)\n',
+    '                    if dep_value_str in mapping:\n',
+    '                        value = mapping[dep_value_str]\n',
+    '                        break\n',
+    '                else:\n',
+    '                    value = None\n',
+    '            finally:\n',
+    '                ctx._dynamic_default_stack.remove(self.name)\n',
+    '\n',
+    '        if call and callable(value):\n',
+    '            value = value()\n',
+    '\n',
+    '        return value\n'
+]
+
+start_replace = 0
+for i, line in enumerate(lines):
+    if 'value = ctx.lookup_default(self.name, call=False)  # type: ignore' in line:
+        start_replace = i
+        break
+
+end_replace = 0
+for i in range(start_replace, len(lines)):
+    if lines[i].strip() == 'return value':
+        end_replace = i
+        break
+
+lines[start_replace:end_replace+1] = new_body
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(lines)
