+import click
+from click.testing import CliRunner
+
+def test_dynamic_default():
+    @click.command()
+    @click.option("--foo")
+    @click.option("--bar", default={"--foo": {"a": "bar_a", "b": "bar_b"}})
+    def cli(foo, bar):
+        click.echo(f"foo={foo}, bar={bar}")
+
+    runner = CliRunner()
+    
+    # Test case 1: foo is 'a', bar should be 'bar_a'
+    result = runner.invoke(cli, ["--foo", "a"])
+    print(f"Result 1: {result.output}")
+    assert "bar=bar_a" in result.output
+
+    # Test case 2: foo is 'b', bar should be 'bar_b'
+    result = runner.invoke(cli, ["--foo", "b"])
+    print(f"Result 2: {result.output}")
+    assert "bar=bar_b" in result.output
+
+    # Test case 3: foo is 'c', bar should be None (no match)
+    result = runner.invoke(cli, ["--foo", "c"])
+    print(f"Result 3: {result.output}")
+    assert "bar=None" in result.output
+
+if __name__ == "__main__":
+    try:
+        test_dynamic_default()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
