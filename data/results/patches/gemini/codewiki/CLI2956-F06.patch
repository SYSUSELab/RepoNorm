+import click
+from click.testing import CliRunner
+
+def test_debug():
+    @click.command()
+    @click.option("--foo", default="a")
+    @click.option("--bar", default={"--foo": {"a": "bar_a"}})
+    def cli(foo, bar):
+        click.echo(f"foo={foo}, bar={bar}")
+
+    runner = CliRunner()
+    # We need to make sure we are actually using the dynamic default.
+    # The default for bar is {"--foo": {"a": "bar_a"}}.
+    # If foo is "a", bar should be "bar_a".
+    # Let's check if it works.
+    result = runner.invoke(cli, [])
+    print(f"Output: {result.output}")
+    
+    # Now let's test the cycle
+    @click.command()
+    @click.option("--foo", default={"--bar": {"a": "foo_a"}})
+    @click.option("--bar", default={"--foo": {"a": "bar_a"}})
+    def cli_cycle(foo, bar):
+        click.echo(f"foo={foo}, bar={bar}")
+    
+    result = runner.invoke(cli_cycle, [])
+    print(f"Cycle Output: {result.output}")
+    print(f"Cycle Exit code: {result.exit_code}")
+    print(f"Cycle Exception: {result.exception}")
+
+if __name__ == "__main__":
+    test_debug()
