+import re
+
+with open("src/jinja2/loaders.py", "r") as f:
+    content = f.read()
+
+def fix_init(content, class_name):
+    # Find the __init__ method
+    pattern = rf"(class {class_name}\(BaseLoader\):.*?def __init__\(.*?\):)"
+    match = re.search(pattern, content, re.DOTALL)
+    if match:
+        # Find the end of the signature
+        # The signature ends with `):` or `) -> None:`
+        # Let's find the end of the signature
+        signature_end = re.search(r"\) -> None:|\):", match.group(1)).end()
+        
+        # Remove any existing `super().__init__()`
+        body = content[match.start() + signature_end:]
+        body = body.replace("        super().__init__()", "")
+        
+        # Insert `super().__init__()` after the signature
+        new_content = content[:match.start() + signature_end] + "\n        super().__init__()" + body
+        return new_content
+    return content
+
+content = fix_init(content, "FileSystemLoader")
+content = fix_init(content, "PrefixLoader")
+content = fix_init(content, "ChoiceLoader")
+content = fix_init(content, "ModuleLoader")
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.write(content)
