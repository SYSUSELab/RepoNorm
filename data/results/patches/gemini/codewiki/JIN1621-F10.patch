+import unittest
+from jinja2 import BaseLoader, Environment, TemplateNotFound
+import weakref
+
+class AliasLoaderMixin:
+    def __init__(self):
+        self.aliases = {}
+        self._cache_refs = weakref.WeakSet()
+
+    def add_alias(self, alias, target):
+        self.aliases[alias] = target
+        self._invalidate_cache(alias)
+
+    def remove_alias(self, alias):
+        if alias in self.aliases:
+            del self.aliases[alias]
+            self._invalidate_cache(alias)
+
+    def _invalidate_cache(self, name):
+        for env_ref in self._cache_refs:
+            env = env_ref()
+            if env is not None and env.cache is not None:
+                # The cache key is (weakref.ref(self), name)
+                # We need to find the entry for this loader and this name
+                # Since we don't have easy access to the cache keys,
+                # we might need to iterate over the cache.
+                # Wait, the cache is a dict-like object.
+                # Let's see if we can just delete the specific key.
+                # The key is (weakref.ref(self), name)
+                # But we don't have the weakref.ref(self) easily here.
+                # Actually, we can just iterate over the cache and remove entries
+                # that match this loader and this name.
+                
+                # This is a bit tricky. Let's see if we can do it.
+                # The cache is a dict-like object.
+                keys_to_remove = []
+                for key in env.cache:
+                    loader_ref, template_name = key
+                    if loader_ref() is self and template_name == name:
+                        keys_to_remove.append(key)
+                for key in keys_to_remove:
+                    del env.cache[key]
+
+    def register_env(self, env):
+        self._cache_refs.add(weakref.ref(env))
+
+class FileSystemLoader(BaseLoader, AliasLoaderMixin):
+    def __init__(self, path):
+        BaseLoader.__init__(self)
+        AliasLoaderMixin.__init__(self)
+        self.path = path
+        self.templates = {"real.html": "Hello World"}
+
+    def get_source(self, environment, template):
+        self.register_env(environment)
+        if template in self.aliases:
+            template = self.aliases[template]
+        
+        if template in self.templates:
+            return self.templates[template], template, lambda: True
+        raise TemplateNotFound(template)
+
+class TestAlias(unittest.TestCase):
+    def test_alias(self):
+        loader = FileSystemLoader("templates")
+        env = Environment(loader=loader)
+        
+        loader.add_alias("alias.html", "real.html")
+        t1 = env.get_template("alias.html")
+        self.assertEqual(t1.render(), "Hello World")
+        
+        loader.remove_alias("alias.html")
+        with self.assertRaises(TemplateNotFound):
+            env.get_template("alias.html")
+
+if __name__ == "__main__":
+    unittest.main()
