+import re
+
+with open("src/jinja2/loaders.py", "r") as f:
+    content = f.read()
+
+def add_super_init(content, class_name):
+    # Find the class definition
+    pattern = rf"(class {class_name}\(BaseLoader\):.*?def __init__\(.*?\):)"
+    match = re.search(pattern, content, re.DOTALL)
+    if match:
+        # Find the end of the __init__ signature
+        # The signature ends with `) -> None:` or `):`
+        # We need to find the end of the signature, which is the first `):` or `) -> None:`
+        # after `def __init__`.
+        
+        # Let's find the end of the signature
+        # The signature starts at `def __init__`
+        signature_start = match.group(1).rfind("def __init__")
+        signature_end = content.find("):", match.start() + signature_start)
+        if signature_end == -1:
+            signature_end = content.find(") -> None:", match.start() + signature_start)
+        
+        # The signature ends at `signature_end + 2`
+        insert_pos = signature_end + 2
+        
+        # Insert `super().__init__()`
+        new_content = content[:insert_pos] + "\n        super().__init__()" + content[insert_pos:]
+        return new_content
+    return content
+
+content = add_super_init(content, "FileSystemLoader")
+content = add_super_init(content, "PrefixLoader")
+content = add_super_init(content, "ChoiceLoader")
+content = add_super_init(content, "ModuleLoader")
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.write(content)
