+# Add AliasLoaderMixin
+alias_mixin = """
+class AliasLoaderMixin:
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.aliases = {}
+        self._envs = weakref.WeakSet()
+
+    def register_env(self, env):
+        self._envs.add(env)
+
+    def add_alias(self, alias: str, target: str) -> None:
+        self.aliases[alias] = target
+        for env in self._envs:
+            if env.cache is not None:
+                env.cache.clear()
+
+    def remove_alias(self, alias: str) -> None:
+        if alias in self.aliases:
+            del self.aliases[alias]
+            for env in self._envs:
+                if env.cache is not None:
+                    env.cache.clear()
+"""
+
+# Insert AliasLoaderMixin before BaseLoader
+content = content.replace("class BaseLoader:", alias_mixin + "\nclass BaseLoader(AliasLoaderMixin):")
+
+# Update get_source in BaseLoader
+# Find the get_source method in BaseLoader
+# It's now after the AliasLoaderMixin definition.
+# The docstring ends with `"""`.
+# I'll find the first `"""` after `def get_source` and insert the alias resolution logic.
+pattern = r"(def get_source\(.*?\):.*?\"\"\")"
+def add_alias_logic(match):
+    return match.group(1) + "\n        self.register_env(environment)\n        if template in self.aliases:\n            template = self.aliases[template]"
+
+content = re.sub(pattern, add_alias_logic, content, flags=re.DOTALL)
+
+with open("src/jinja2/loaders.py", "w") as f:
