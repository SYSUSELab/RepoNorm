new file mode 100644
index 0000000..b151d11
--- /dev/null
+++ b/test_octal.py
@@ -0,0 +1,33 @@
+import re
+from outlines.types import Regex
+
+# The requirement:
+# "It matches the exact lowercase prefix 0o followed by one or more ASCII digits from 0 through 7."
+# "Leading zeroes in the digit portion are allowed."
+# "Uppercase 0O, signs, underscores, whitespace, digits 8 or 9, and a prefix without digits are invalid."
+
+# Regex pattern: 0o[0-7]+
+pattern = r"0o[0-7]+"
+regex = Regex(pattern)
+
+def test_octal():
+    # Valid cases
+    assert regex.matches("0o0")
+    assert regex.matches("0o7")
+    assert regex.matches("0o01234567")
+    assert regex.matches("0o000")
+    
+    # Invalid cases
+    assert not regex.matches("0O0") # Uppercase
+    assert not regex.matches("0o") # No digits
+    assert not regex.matches("0o8") # Digit 8
+    assert not regex.matches("0o9") # Digit 9
+    assert not regex.matches(" 0o0") # Whitespace
+    assert not regex.matches("0o0 ") # Whitespace
+    assert not regex.matches("+0o0") # Sign
+    assert not regex.matches("0o0_0") # Underscore
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_octal()
