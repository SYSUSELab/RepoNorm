@@ -0,0 +1,104 @@
+import click
+from click.core import Context
+import pytest
+
+def test_context_snapshot_restore():
+    @click.command()
+    def cli():
+        pass
+
+    ctx = Context(cli, info_name="test")
+    ctx.params = {"a": 1}
+    ctx.args = ["arg1"]
+    ctx._protected_args = ["p1"]
+    ctx._opt_prefixes = {"--"}
+    ctx.obj = {"data": 1}
+    ctx.meta["m"] = 1
+    ctx.default_map = {"a": 2}
+    ctx.invoked_subcommand = "sub"
+    ctx.terminal_width = 100
+    ctx.max_content_width = 80
+    ctx.resilient_parsing = True
+    ctx.help_option_names = ["-h"]
+    ctx.token_normalize_func = lambda x: x
+    ctx.auto_envvar_prefix = "TEST"
+    ctx.color = True
+    ctx.show_default = True
+    ctx._parameter_source = {"a": "default"}
+
+    snapshot = ctx.save_state()
+    
+    # Modify state
+    ctx.params = {"a": 3}
+    ctx.meta["m"] = 2
+    
+    # Restore
+    ctx.restore_state(snapshot)
+    
+    assert ctx.params == {"a": 1}
+    assert ctx.meta["m"] == 1
+    assert ctx.args == ["arg1"]
+    assert ctx._protected_args == ["p1"]
+    assert ctx._opt_prefixes == {"--"}
+    assert ctx.obj == {"data": 1}
+    assert ctx.default_map == {"a": 2}
+    assert ctx.invoked_subcommand == "sub"
+    assert ctx.terminal_width == 100
+    assert ctx.max_content_width == 80
+    assert ctx.resilient_parsing is True
+    assert ctx.help_option_names == ["-h"]
+    assert ctx.auto_envvar_prefix == "TEST"
+    assert ctx.color is True
+    assert ctx.show_default is True
+    assert ctx._parameter_source == {"a": "default"}
+
+def test_transactional_restore():
+    @click.command()
+    def cli():
+        pass
+
+    ctx = Context(cli)
+    ctx.params = {"a": 1}
+    
+    snapshot = ctx.save_state()
+    
+    # Create a broken snapshot
+    class FailCopy:
+        def __deepcopy__(self, memo):
+            raise ValueError("Copy failed")
+            
+    broken_snapshot = snapshot.copy()
+    broken_snapshot["params"] = {"a": 3}
+    broken_snapshot["args"] = FailCopy()
+    
+    # Modify ctx
+    ctx.params = {"a": 2}
+    
+    with pytest.raises(ValueError, match="Copy failed"):
+        ctx.restore_state(broken_snapshot)
+        
+    # Check if ctx was partially changed
+    assert ctx.params == {"a": 2}
+
+def test_meta_shared():
+    @click.command()
+    def cli():
+        pass
+
+    parent = Context(cli)
+    parent.meta["a"] = 1
+    
+    child = Context(cli, parent=parent)
+    assert child.meta["a"] == 1
+    
+    snapshot = child.save_state()
+    
+    # Modify child meta
+    child.meta["a"] = 2
+    
+    # Restore
+    child.restore_state(snapshot)
+    
+    assert child.meta["a"] == 1
+    assert parent.meta["a"] == 1
+    assert child.meta is parent.meta
