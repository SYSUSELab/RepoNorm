diff --git a/tests/test_retry_cleanup.py b/tests/test_retry_cleanup.py
new file mode 100644
index 0000000..a981bbc
--- /dev/null
+++ b/tests/test_retry_cleanup.py
@@ -0,0 +1,72 @@
+import click
+import pytest
+import time
+
+def test_retry_cleanup_success():
+    attempts = 0
+    
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.retry_cleanup = 2
+        ctx.retry_cleanup_backoff = 0.01
+        
+        def cleanup():
+            nonlocal attempts
+            attempts += 1
+            if attempts < 3:
+                raise Exception("Transient failure")
+        
+        ctx.call_on_close(cleanup)
+    
+    cli.main(args=[], standalone_mode=False)
+    assert attempts == 3
+
+def test_retry_cleanup_exhaustion():
+    attempts = 0
+    
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.retry_cleanup = 1
+        ctx.retry_cleanup_backoff = 0.01
+        
+        def cleanup():
+            nonlocal attempts
+            attempts += 1
+            raise Exception("Persistent failure")
+        
+        ctx.call_on_close(cleanup)
+    
+    with pytest.raises(Exception, match="Persistent failure"):
+        cli.main(args=[], standalone_mode=False)
+    assert attempts == 2
+
+def test_retry_cleanup_inheritance():
+    attempts = 0
+    
+    @click.group()
+    @click.pass_context
+    def cli(ctx):
+        ctx.retry_cleanup = 2
+        ctx.retry_cleanup_backoff = 0.01
+        
+    @cli.command()
+    @click.pass_context
+    def sub(ctx):
+        def cleanup():
+            nonlocal attempts
+            attempts += 1
+            if attempts < 3:
+                raise Exception("Transient failure")
+        
+        ctx.call_on_close(cleanup)
+        
+    cli.main(args=["sub"], standalone_mode=False)
+    assert attempts == 3
+
+def test_retry_cleanup_invalid_backoff():
+    # Test that invalid backoff raises ValueError in constructor
+    with pytest.raises(ValueError, match="retry_cleanup_backoff must be a finite positive number."):
+        click.Command("test", callback=lambda: None).make_context("test", [], retry_cleanup_backoff=-1)
+
