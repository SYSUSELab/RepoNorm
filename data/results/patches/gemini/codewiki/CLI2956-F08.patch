+++ b/edit_core.py
@@ -0,0 +1,31 @@
+import sys
+
+with open("src/click/core.py", "r") as f:
+    lines = f.readlines()
+
+# Add track_changes to Command.__init__
+# Find the line with `deprecated: bool | str = False,`
+# and add `track_changes: bool = False,` after it.
+# Then add `self.track_changes = track_changes` in the body.
+
+new_lines = []
+in_init = False
+for line in lines:
+    if "def __init__(" in line and "Command" in lines[lines.index(line)-5:lines.index(line)]:
+        in_init = True
+    
+    if in_init and "deprecated: bool | str = False," in line:
+        new_lines.append(line)
+        new_lines.append("        track_changes: bool = False,\n")
+        continue
+    
+    if in_init and "self.deprecated = deprecated" in line:
+        new_lines.append(line)
+        new_lines.append("        self.track_changes = track_changes\n")
+        in_init = False
+        continue
+        
+    new_lines.append(line)
+
+with open("src/click/core.py", "w") as f:
+    f.writelines(new_lines)
