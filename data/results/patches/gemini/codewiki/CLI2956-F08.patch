diff --git a/get_option_history_method.py b/get_option_history_method.py
new file mode 100644
index 0000000..9462d35
--- /dev/null
+++ b/get_option_history_method.py
@@ -0,0 +1,16 @@
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        if not self.command.track_changes:
+            return None
+        
+        # Find the parameter
+        param = None
+        for p in self.command.get_params(self):
+            if name in p.opts or name in p.secondary_opts or p.name == name:
+                param = p
+                break
+        
+        if param is None:
+            return []
+            
+        return self._option_history.get(param.name, [])
