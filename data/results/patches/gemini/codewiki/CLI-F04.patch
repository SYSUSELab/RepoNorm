+++ b/tests/test_context_timeout.py
@@ -0,0 +1,61 @@
+import click
+import time
+import warnings
+import pytest
+
+def test_cleanup_timeout():
+    def slow_cleanup():
+        time.sleep(0.2)
+    
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    ctx.call_on_close(slow_cleanup)
+    
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        ctx.close()
+        assert len(w) == 1
+        assert "Cleanup timed out" in str(w[-1].message)
+
+def test_cleanup_no_timeout():
+    def fast_cleanup():
+        pass
+    
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    ctx.call_on_close(fast_cleanup)
+    
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        ctx.close()
+        assert len(w) == 0
+
+def test_cleanup_inheritance():
+    ctx_parent = click.Context(click.Command("parent"), cleanup_timeout=0.1)
+    ctx_child = click.Context(click.Command("child"), parent=ctx_parent)
+    assert ctx_child.cleanup_timeout == 0.1
+
+def test_invalid_timeout():
+    with pytest.raises(ValueError, match="cleanup_timeout must be positive"):
+        click.Context(click.Command("test"), cleanup_timeout=-1)
+
+def test_later_registrations():
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    
+    def slow_cleanup():
+        time.sleep(0.2)
+        
+    def register_more():
+        ctx.call_on_close(lambda: None)
+        
+    ctx.call_on_close(slow_cleanup)
+    ctx.call_on_close(register_more)
+    
+    with warnings.catch_warnings(record=True):
+        warnings.simplefilter("ignore")
+        ctx.close()
+    
+    # After timeout, the exit stack should be empty, and a new one should be created.
+    # The `register_more` should have been called, and its registration should be in the new stack.
+    assert len(ctx._exit_stack._exit_callbacks) == 1
+    
+    ctx.close()
+    assert len(ctx._exit_stack._exit_callbacks) == 0
