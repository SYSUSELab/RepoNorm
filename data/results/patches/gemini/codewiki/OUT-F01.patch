@@ -0,0 +1,30 @@
+import torch
+import xgrammar as xgr
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+from outlines.models.transformers import Transformers
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+# Mocking a model for testing
+model_name = "gpt2"
+tokenizer = AutoTokenizer.from_pretrained(model_name)
+model = AutoModelForCausalLM.from_pretrained(model_name)
+
+# Create a dummy compiled grammar
+vocab_size = model.config.vocab_size
+tokenizer_info = xgr.TokenizerInfo.from_huggingface(tokenizer, vocab_size=vocab_size)
+grammar_compiler = xgr.GrammarCompiler(tokenizer_info)
+compiled_grammar = grammar_compiler.compile_regex(r"\d+")
+
+# Test the processor
+processor = XGrammarLogitsProcessor(compiled_grammar, "torch")
+print(f"Processor initialized: {processor}")
+
+# Test reset
+processor.reset()
+print("Processor reset")
+
+# Test process_logits
+input_ids = torch.tensor([[1, 2, 3]])
+logits = torch.randn(1, vocab_size)
+processed_logits = processor.process_logits(input_ids, logits)
+print(f"Processed logits shape: {processed_logits.shape}")
