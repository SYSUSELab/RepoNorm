+import torch
+import xgrammar as xgr
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+import unittest.mock as mock
+
+# Mock the compiled grammar
+class MockCompiledGrammar:
+    pass
+
+compiled_grammar = MockCompiledGrammar()
+
+# Mock the GrammarMatcher
+class MockGrammarMatcher:
+    def __init__(self, compiled_grammar):
+        pass
+    def update_state(self, input_ids):
+        pass
+    def fill_token_bitmask(self, bitmask):
+        bitmask[:] = 1 # All allowed
+
+# Mock xgr.allocate_token_bitmask
+def mock_allocate_token_bitmask(batch_size, vocab_size, device):
+    return torch.ones(batch_size, vocab_size, device=device)
+
+with mock.patch("xgrammar.GrammarMatcher", MockGrammarMatcher), \
+     mock.patch("xgrammar.allocate_token_bitmask", mock_allocate_token_bitmask):
+    
+    processor = XGrammarLogitsProcessor(compiled_grammar, "torch")
+    
+    input_ids = torch.tensor([[1, 2, 3]])
+    logits = torch.randn(1, 100)
+    
+    processed_logits = processor.process_logits(input_ids, logits)
+    print(f"Processed logits shape: {processed_logits.shape}")
+    
+    # Test reset
+    processor.reset()
+    assert processor.matcher is None
+    assert processor.is_first_token is True
+    print("Reset successful")
