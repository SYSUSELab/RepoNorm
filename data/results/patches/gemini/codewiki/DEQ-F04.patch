@@ -0,0 +1,32 @@
+from dirty_equals import IsURL
+import pytest
+
+def test_isurl_basic():
+    assert 'https://example.com' == IsURL()
+    assert 'http://example.com:8080' == IsURL()
+    assert 'not-a-url' != IsURL()
+    assert 123 != IsURL()
+    assert 'example.com' != IsURL() # Missing protocol
+
+def test_isurl_protocol():
+    assert 'https://example.com' == IsURL('https')
+    assert 'http://example.com' == IsURL(['http', 'https'])
+    assert 'https://example.com' == IsURL({'http', 'https'})
+    assert 'https://example.com' == IsURL(('http', 'https'))
+    assert 'ftp://example.com' != IsURL('https')
+
+def test_isurl_domain():
+    assert 'https://example.com' == IsURL(None, 'example.com')
+    assert 'https://example.com:8080' == IsURL(None, 'example.com:8080')
+    assert 'https://example.com:8080' != IsURL(None, 'example.com')
+
+def test_isurl_both():
+    assert 'https://example.com:8080' == IsURL('https', 'example.com:8080')
+    assert 'http://example.com:8080' != IsURL('https', 'example.com:8080')
+    assert 'https://example.com' != IsURL('https', 'example.com:8080')
+
+def test_isurl_repr():
+    assert repr(IsURL()) == 'IsURL()'
+    assert repr(IsURL('https')) == "IsURL('https')"
+    assert repr(IsURL(None, 'example.com')) == "IsURL(None, 'example.com')"
+    assert repr(IsURL('https', 'example.com')) == "IsURL('https', 'example.com')"
