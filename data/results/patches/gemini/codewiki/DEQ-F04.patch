diff --git a/dirty_equals/_url.py b/dirty_equals/_url.py
new file mode 100644
index 0000000..1dcc345
--- /dev/null
+++ b/dirty_equals/_url.py
@@ -0,0 +1,61 @@
+from typing import Any, Collection, Optional, Union
+from urllib.parse import urlparse
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+class IsURL(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid URL, optionally checking protocol and domain.
+    """
+
+    def __init__(
+        self,
+        protocol: Optional[Union[str, Collection[str]]] = None,
+        domain: Optional[str] = None,
+    ):
+        """
+        Args:
+            protocol: The protocol(s) to check, e.g., 'http', 'https', or a collection of them.
+            domain: The domain to check, including port if present.
+        """
+        self.protocol = protocol
+        self.domain = domain
+        
+        # Prepare repr args
+        repr_args = []
+        if protocol is not None or domain is not None:
+            repr_args.append(protocol)
+        if domain is not None:
+            repr_args.append(domain)
+        
+        super().__init__(*repr_args)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        try:
+            parsed = urlparse(other)
+        except Exception:
+            return False
+            
+        if not parsed.scheme or not parsed.netloc:
+            return False
+            
+        # Protocol check
+        if self.protocol is not None:
+            if isinstance(self.protocol, str):
+                if parsed.scheme != self.protocol:
+                    return False
+            elif isinstance(self.protocol, Collection):
+                if parsed.scheme not in self.protocol:
+                    return False
+            else:
+                return False
+                
+        # Domain check
+        if self.domain is not None:
+            if parsed.netloc != self.domain:
+                return False
+                
+        return True
diff --git a/reproduce_isurl.py b/reproduce_isurl.py
new file mode 100644
index 0000000..a791fa6
--- /dev/null
+++ b/reproduce_isurl.py
@@ -0,0 +1,33 @@
+from dirty_equals import IsURL
+from urllib.parse import urlparse
+
+# Test cases
+def test_isurl():
+    # Basic
+    assert 'https://example.com' == IsURL()
+    assert 'http://example.com:8080' == IsURL()
+    assert 'not-a-url' != IsURL()
+    assert 123 != IsURL()
+
+    # Protocol
+    assert 'https://example.com' == IsURL('https')
+    assert 'http://example.com' == IsURL(['http', 'https'])
+    assert 'ftp://example.com' != IsURL('https')
+
+    # Domain
+    assert 'https://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'https://example.com:8080' != IsURL(domain='example.com')
+
+    # Both
+    assert 'https://example.com:8080' == IsURL('https', 'example.com:8080')
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    try:
+        test_isurl()
+    except NameError as e:
+        print(f"Caught expected error: {e}")
+    except Exception as e:
+        print(f"Caught unexpected error: {e}")
