+from jinja2.filters import sync_do_groupby
+from jinja2.environment import Environment
+
+class MockObject:
+    def __init__(self, name, attr):
+        self.name = name
+        self.attr = attr
+    def __repr__(self):
+        return f"MockObject({self.name}, {self.attr})"
+
+env = Environment()
+data = [
+    MockObject("a", [1]),
+    MockObject("b", [2]),
+    MockObject("c", [1]),
+]
+
+# Test stable=True
+try:
+    result = sync_do_groupby(env, data, "attr", stable=True)
+    print(f"Stable=True result: {result}")
+    # Expected: [([1], [a, c]), ([2], [b])]
+    assert len(result) == 2
+    assert result[0][0] == [1]
+    assert result[1][0] == [2]
+except Exception as e:
+    print(f"Caught error: {e}")
+
+# Test stable=False (default)
+try:
+    result = sync_do_groupby(env, data, "attr", stable=False)
+    print(f"Stable=False result: {result}")
+    # Expected: [([1], [a, c]), ([2], [b])] (sorted by key)
+    assert len(result) == 2
+    assert result[0][0] == [1]
+    assert result[1][0] == [2]
+except Exception as e:
+    print(f"Caught error: {e}")
+
+# Test unhashable keys
+data2 = [
+    MockObject("a", [1]),
+    MockObject("b", [2]),
+    MockObject("c", [1]),
+]
+# This should work with stable=True
+try:
+    result = sync_do_groupby(env, data2, "attr", stable=True)
+    print(f"Unhashable keys result: {result}")
+except Exception as e:
+    print(f"Caught error: {e}")
+
