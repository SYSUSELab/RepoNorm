+    if stable:
+        return _stable_groupby(await auto_to_list(value), expr)
+    return [
+        _GroupTuple(key, await auto_to_list(values))
+        for key, values in groupby(sorted(await auto_to_list(value), key=expr), expr)
+    ]"""
+content = re.sub(
+    r'    expr = make_attrgetter\(environment, attribute, default=default\)\n    return \[\n        _GroupTuple\(key, await auto_to_list\(values\)\)\n        for key, values in groupby\(sorted\(await auto_to_list\(value\), key=expr\), expr\)\n    \]',
