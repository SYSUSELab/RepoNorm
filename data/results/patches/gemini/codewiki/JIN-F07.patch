+# 1. Add _stable_groupby helper
+helper = """
+def _stable_groupby(value, key_func):
+    groups = []
+    for item in value:
+        key = key_func(item)
+        found = False
+        for existing_key, group in groups:
+            if existing_key == key:
+                group.append(item)
+                found = True
+                break
+        if not found:
+            groups.append((key, [item]))
+    return [_GroupTuple(key, group) for key, group in groups]
+"""
+content = content.replace("def sync_do_groupby(", helper + "\n\ndef sync_do_groupby(")
+
+# 2. Add stable=False to sync_do_groupby
+content = content.replace(
+    "def sync_do_groupby(\n    environment: \"Environment\",\n    value: \"t.Iterable[V]\",\n    attribute: t.Union[str, int],\n    default: t.Optional[t.Any] = None,",
+    "def sync_do_groupby(\n    environment: \"Environment\",\n    value: \"t.Iterable[V]\",\n    attribute: t.Union[str, int],\n    default: t.Optional[t.Any] = None, stable: bool = False,"
+)
+
+# 3. Update sync_do_groupby body
+sync_body = """    expr = make_attrgetter(environment, attribute, default=default)
+    if stable:
+        return _stable_groupby(value, expr)
+    return [
+        _GroupTuple(key, list(values))
+        for key, values in groupby(sorted(value, key=expr), expr)
+    ]"""
+content = re.sub(
+    r'    expr = make_attrgetter\(environment, attribute, default=default\)\n    return \[\n        _GroupTuple\(key, list\(values\)\)\n        for key, values in groupby\(sorted\(value, key=expr\), expr\)\n    \]',
+    sync_body,
+    content,
+    count=1
+)
+
+# 4. Add stable=False to do_groupby
+content = content.replace(
+    "async def do_groupby(\n    environment: \"Environment\",\n    value: \"t.Union[t.AsyncIterable[V], t.Iterable[V]]\",\n    attribute: t.Union[str, int],\n    default: t.Optional[t.Any] = None,",
