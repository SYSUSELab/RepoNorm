+from itertools import groupby
+from jinja2.filters import make_attrgetter
+from jinja2.environment import Environment
+import typing as t
+from jinja2.exceptions import FilterArgumentError
+
+class _GroupTuple(t.NamedTuple):
+    grouper: t.Any
+    list: t.List
+
+    def __repr__(self) -> str:
+        return tuple.__repr__(self)
+
+    def __str__(self) -> str:
+        return tuple.__str__(self)
+
+class Item:
+    def __init__(self, department, role, name):
+        self.department = department
+        self.role = role
+        self.name = name
+    def __repr__(self):
+        return f"Item({self.department}, {self.role}, {self.name})"
+
+items = [
+    Item('IT', 'Dev', 'Alice'),
+    Item('IT', 'Dev', 'Bob'),
+    Item('IT', 'QA', 'Charlie'),
+    Item('HR', 'Recruiter', 'Dave'),
+]
+
+env = Environment()
+
+def hierarchical_groupby(env, items, attribute, levels=None, default=None):
+    if levels is not None:
+        if not isinstance(levels, int) or levels <= 0:
+            raise FilterArgumentError("levels must be a positive integer")
+        
+        if isinstance(attribute, str):
+            attributes = [x.strip() for x in attribute.split(',')]
+        elif isinstance(attribute, (list, tuple)):
+            attributes = list(attribute)
+        else:
+            raise FilterArgumentError("attribute must be a string or list")
+            
+        if len(attributes) != levels:
+            raise FilterArgumentError("attribute count must equal levels")
+    else:
+        # Default behavior
+        if isinstance(attribute, (list, tuple)):
+            if len(attribute) > 1:
+                raise FilterArgumentError("Multiple attributes without levels")
+            attribute = attribute[0]
+        attributes = [attribute]
+
+    def _recursive_groupby(items, attrs):
+        if not attrs:
+            return items
+        
+        attr = attrs[0]
+        expr = make_attrgetter(env, attr, default=default)
+        
+        # Sort by the current attribute
+        items = sorted(items, key=expr)
+        
+        result = []
+        for key, group in groupby(items, key=expr):
+            result.append(_GroupTuple(key, _recursive_groupby(list(group), attrs[1:])))
+        return result
+
+    return _recursive_groupby(items, attributes)
+
+# Test cases
+print(hierarchical_groupby(env, items, ['department', 'role'], levels=2))
+print(hierarchical_groupby(env, items, 'department, role', levels=2))
+print(hierarchical_groupby(env, items, 'department'))
+try:
+    hierarchical_groupby(env, items, ['department', 'role'])
+except FilterArgumentError as e:
+    print("Caught expected error:", e)
