+        
+        # Sort by the current attribute
+        items = sorted(items, key=expr)
+        
+        result = []
+        for key, group in groupby(items, key=expr):
+            result.append(_GroupTuple(key, _recursive_groupby(list(group), attrs[1:])))
+        return result
+
+    return _recursive_groupby(value, attributes)
+
+
+@async_variant(sync_do_groupby)  # type: ignore
+async def do_groupby(
+    environment: "Environment",
+    value: "t.Union[t.AsyncIterable[V], t.Iterable[V]]",
+    attribute: t.Union[str, int, t.List[str]],
