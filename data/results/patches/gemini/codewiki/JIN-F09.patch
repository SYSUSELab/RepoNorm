+from itertools import groupby
+
+class Item:
+    def __init__(self, department, role, name):
+        self.department = department
+        self.role = role
+        self.name = name
+    def __repr__(self):
+        return f"Item({self.department}, {self.role}, {self.name})"
+
+items = [
+    Item('IT', 'Dev', 'Alice'),
+    Item('IT', 'Dev', 'Bob'),
+    Item('IT', 'QA', 'Charlie'),
+    Item('HR', 'Recruiter', 'Dave'),
+]
+
+def get_attr(item, attr):
+    return getattr(item, attr)
+
+def hierarchical_groupby(items, attributes):
+    if not attributes:
+        return items
+    
+    attr = attributes[0]
+    # Sort by the current attribute
+    items = sorted(items, key=lambda x: get_attr(x, attr))
+    
+    result = []
+    for key, group in groupby(items, key=lambda x: get_attr(x, attr)):
+        result.append((key, hierarchical_groupby(list(group), attributes[1:])))
+    return result
+
+print(hierarchical_groupby(items, ['department', 'role']))
