diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..cc74eca
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,39 @@
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+import gettext
+
+def test_cache():
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    # Mock translations
+    class MockTranslations:
+        def gettext(self, message):
+            print(f"gettext called for {message}")
+            return message
+        def ngettext(self, singular, plural, n):
+            return singular if n == 1 else plural
+        def pgettext(self, context, message):
+            return message
+        def npgettext(self, context, singular, plural, n):
+            return singular if n == 1 else plural
+
+    translations = MockTranslations()
+    
+    # This is the method we need to update to accept cache_size and cache_partition
+    # Currently it only accepts gettext, ngettext, newstyle, pgettext, npgettext
+    # We need to check if it accepts cache_size and cache_partition
+    try:
+        env.install_gettext_callables(
+            translations.gettext,
+            translations.ngettext,
+            pgettext=translations.pgettext,
+            npgettext=translations.npgettext,
+            cache_size=10,
+            cache_partition="test"
+        )
+        print("Successfully called with cache_size and cache_partition")
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
+
+if __name__ == "__main__":
+    test_cache()
