+    '            if pgettext is not None:\n',
+    '                pgettext = _make_new_pgettext(pgettext)\n',
+    '            if npgettext is not None:\n',
+    '                npgettext = _make_new_npgettext(npgettext)\n',
+    '        self._cache = _TranslationCache(\n',
+    '            cache_size, cache_partition, gettext, ngettext, pgettext, npgettext\n',
+    '        )\n',
+    '        self.environment.globals.update(\n',
+    '            gettext=self._cache.gettext,\n',
+    '            ngettext=self._cache.ngettext,\n',
+    '            pgettext=self._cache.pgettext,\n',
+    '            npgettext=self._cache.npgettext,\n',
+    '        )\n',
+    '\n',
+    '    def _set_partition(self, value: t.Hashable) -> None:\n',
+    '        if self._cache is not None:\n',
+    '            self._cache.set_partition(value)\n',
+    '\n',
+    '    def _clear_cache(self) -> None:\n',
+    '        if self._cache is not None:\n',
+    '            self._cache.clear()\n',
+    '\n',
+    '    def _resize_cache(self, capacity: int) -> None:\n',
+    '        if self._cache is not None:\n',
+    '            self._cache.resize(capacity)\n',
+    '\n'
+]
+
+lines = lines[:start_line] + new_method + lines[end_line:]
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
