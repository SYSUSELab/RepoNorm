+from functools import lru_cache
+import typing as t
+
+class _TranslationCache:
+    def __init__(self, capacity, partition, gettext, ngettext, pgettext, npgettext):
+        self.capacity = capacity
+        self.partition = partition
+        self.gettext_func = gettext
+        self.ngettext_func = ngettext
+        self.pgettext_func = pgettext
+        self.npgettext_func = npgettext
+        self._cache = lru_cache(maxsize=capacity)(self._gettext)
+
+    def _gettext(self, kind, partition, context, *args):
+        if kind == 'gettext':
+            return self.gettext_func(args[0])
+        elif kind == 'ngettext':
+            return self.ngettext_func(*args)
+        elif kind == 'pgettext':
+            return self.pgettext_func(context, args[0])
+        elif kind == 'npgettext':
+            return self.npgettext_func(context, *args)
+
+    def gettext(self, message):
+        if self.capacity == 0:
+            return self.gettext_func(message)
+        return self._cache('gettext', self.partition, None, message)
+
+    def ngettext(self, singular, plural, n):
+        if self.capacity == 0:
+            return self.ngettext_func(singular, plural, n)
+        return self._cache('ngettext', self.partition, None, singular, plural, n)
+
+    def pgettext(self, context, message):
+        if self.capacity == 0:
+            if self.pgettext_func is None:
+                return message
+            return self.pgettext_func(context, message)
+        if self.pgettext_func is None:
+            return message
+        return self._cache('pgettext', self.partition, context, message)
+
+    def npgettext(self, context, singular, plural, n):
+        if self.capacity == 0:
+            if self.npgettext_func is None:
+                return singular if n == 1 else plural
+            return self.npgettext_func(context, singular, plural, n)
+        if self.npgettext_func is None:
+            return singular if n == 1 else plural
+        return self._cache('npgettext', self.partition, context, singular, plural, n)
+
+    def resize(self, capacity):
+        if capacity < 0:
+            raise ValueError("Capacity must be non-negative")
+        self.capacity = capacity
+        self._cache = lru_cache(maxsize=capacity)(self._gettext)
+
+    def set_partition(self, partition):
+        self.partition = partition
+        self._cache.cache_clear()
+
+    def clear(self):
+        self._cache.cache_clear()
