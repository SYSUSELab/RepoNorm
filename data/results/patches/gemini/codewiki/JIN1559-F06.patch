+++ b/fix_init.py
@@ -0,0 +1,24 @@
+import re
+
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# Find the `environment.extend(` block
+pattern = r'environment\.extend\((.*?)\)'
+match = re.search(pattern, content, re.DOTALL)
+if match:
+    block = match.group(1)
+    # Remove duplicates
+    lines = [line.strip() for line in block.split('\n') if line.strip()]
+    unique_lines = []
+    seen = set()
+    for line in lines:
+        if line not in seen:
+            unique_lines.append(line)
+            seen.add(line)
+    
+    new_block = '        environment.extend(\n            ' + ',\n            '.join(unique_lines) + '\n        )'
+    content = content.replace(match.group(0), new_block)
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
