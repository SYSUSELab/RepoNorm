+
+# Find the `environment.extend(` line
+start_line = 0
+for i, line in enumerate(lines):
+    if 'environment.extend(' in line:
+        start_line = i
+        break
+
+# Find the closing `)`
+end_line = 0
+for i in range(start_line, len(lines)):
+    if ')' in lines[i]:
+        end_line = i
+        break
+
+# Replace the block
+new_block = [
+    '        environment.extend(\n',
+    '            install_gettext_translations=self._install,\n',
+    '            install_null_translations=self._install_null,\n',
+    '            install_gettext_callables=self._install_callables,\n',
+    '            uninstall_gettext_translations=self._uninstall,\n',
+    '            extract_translations=self._extract,\n',
+    '            newstyle_gettext=False,\n',
+    '            set_translation_cache_partition=self._set_partition,\n',
+    '            clear_translation_cache=self._clear_cache,\n',
+    '            resize_translation_cache=self._resize_cache,\n',
+    '        )\n'
+]
+
+lines = lines[:start_line] + new_block + lines[end_line+1:]
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
