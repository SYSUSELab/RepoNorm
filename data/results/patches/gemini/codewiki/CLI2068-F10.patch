+import os
+import click
+import tempfile
+import shutil
+
+def test_edit_text_with_working_dir():
+    # Create a temporary directory to act as the working directory
+    working_dir = tempfile.mkdtemp()
+    
+    # We need to mock the editor to modify the file
+    # We can set EDITOR to a command that appends to the file
+    # The file path is passed as the first argument
+    editor_script = os.path.join(working_dir, "editor.sh")
+    with open(editor_script, "w") as f:
+        f.write('#!/bin/sh\necho "appended" >> "$1"')
+    os.chmod(editor_script, 0o755)
+    
+    os.environ["EDITOR"] = editor_script
+    
+    try:
+        # This should now work
+        result = click.edit(text="hello world", working_dir=working_dir)
+        print(f"Successfully called click.edit with working_dir, result: {result}")
+        if result and "appended" in result:
+            print("Result contains appended text")
+        else:
+            print("Result does not contain appended text")
+    except Exception as e:
+        print(f"Caught unexpected exception: {e}")
+        import traceback
+        traceback.print_exc()
+    finally:
+        shutil.rmtree(working_dir)
+
+if __name__ == "__main__":
+    test_edit_text_with_working_dir()
