@@ -0,0 +1,34 @@
+import os
+import click
+import tempfile
+import shutil
+import subprocess
+
+def test_edit_with_working_dir():
+    # Create a temporary directory to act as the working directory
+    working_dir = tempfile.mkdtemp()
+    
+    # Create a file inside the working directory
+    filename = "test.txt"
+    filepath = os.path.join(working_dir, filename)
+    with open(filepath, "w") as f:
+        f.write("hello world")
+        
+    # Try to edit the file with a custom working directory
+    # We need to mock the editor to avoid actually opening one
+    # We can set EDITOR to a command that just exits
+    os.environ["EDITOR"] = "true"
+    
+    try:
+        # This should now work
+        click.edit(filename=filename, working_dir=working_dir)
+        print("Successfully called click.edit with working_dir")
+    except Exception as e:
+        print(f"Caught unexpected exception: {e}")
+        import traceback
+        traceback.print_exc()
+    finally:
+        shutil.rmtree(working_dir)
+
+if __name__ == "__main__":
+    test_edit_with_working_dir()
