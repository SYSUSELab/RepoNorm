+import re
+
+with open("src/jinja2/loaders.py", "r") as f:
+    content = f.read()
+
+new_function = r"""def split_template_path(template: str) -> t.List[str]:
+    """Split a path into segments and perform a sanity check.  If it detects
+    '..' in the path it will raise a `TemplateNotFound` error.
+    """
+    # Normalize separators
+    template = template.replace("\\", "/")
+
+    # Reject leading /
+    if template.startswith("/"):
+        raise TemplateNotFound(template)
+
+    # Reject drive prefix (e.g., C:)
+    if len(template) >= 2 and template[1] == ":":
+        raise TemplateNotFound(template)
+
+    # Reject UNC (starts with //)
+    if template.startswith("//"):
+        raise TemplateNotFound(template)
+
+    pieces = []
+    for piece in template.split("/"):
+        if piece == "" or piece == ".":
+            continue
+        if piece == "..":
+            if not pieces:
+                raise TemplateNotFound(template)
+            pieces.pop()
+        else:
+            pieces.append(piece)
+    return pieces
+"""
+
+# Regex to match the old function
+pattern = r"def split_template_path\(template: str\) -> t\.List\[str\]:.*?return pieces"
+# Use re.DOTALL to match across lines
+new_content = re.sub(pattern, new_function, content, flags=re.DOTALL)
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.write(new_content)
