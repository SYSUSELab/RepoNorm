diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 0000000..0836d6c
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,38 @@
+import os
+from jinja2 import FileSystemLoader, Environment, TemplateNotFound
+
+# Setup a simple environment
+loader = FileSystemLoader("tests/res/templates")
+env = Environment(loader=loader)
+
+# Test cases
+test_cases = [
+    ("foo/../test.html", "tests/res/templates/test.html"),
+    ("foo/./test.html", "tests/res/templates/foo/test.html"),
+    ("foo/../foo/test.html", "tests/res/templates/foo/test.html"),
+    ("../test.html", None), # Should raise TemplateNotFound
+    ("/test.html", None), # Should raise TemplateNotFound
+    ("C:/test.html", None), # Should raise TemplateNotFound
+    ("foo/../../test.html", None), # Should raise TemplateNotFound
+]
+
+for template, expected_path in test_cases:
+    try:
+        print(f"Testing: {template}")
+        source, filename, uptodate = loader.get_source(env, template)
+        print(f"  Resolved to: {filename}")
+        if expected_path:
+            assert os.path.abspath(filename) == os.path.abspath(expected_path)
+        else:
+            print(f"  Error: Expected TemplateNotFound for {template}")
+            assert False
+    except TemplateNotFound:
+        if expected_path is None:
+            print(f"  Caught expected TemplateNotFound for: {template}")
+        else:
+            print(f"  Error: Unexpected TemplateNotFound for {template}")
+            assert False
+    except Exception as e:
+        print(f"  Caught unexpected exception: {type(e).__name__}: {e}")
+        assert False
+
