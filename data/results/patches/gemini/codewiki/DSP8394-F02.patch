diff --git a/dspy/clients/namespace.py b/dspy/clients/namespace.py
new file mode 100644
index 00000000..77364192
--- /dev/null
+++ b/dspy/clients/namespace.py
@@ -0,0 +1,35 @@
+import contextvars
+import hashlib
+from typing import Optional
+
+class Namespace:
+    def __init__(self):
+        self._namespace = contextvars.ContextVar("dspy_cache_namespace", default=None)
+
+    @property
+    def value(self) -> Optional[str]:
+        return self._namespace.get()
+
+    def set(self, value: Optional[str]):
+        if value is not None and not isinstance(value, str):
+            raise ValueError("Namespace must be a string or None")
+        self._namespace.set(value)
+
+    def __call__(self, value: Optional[str]):
+        return NamespaceContext(self, value)
+
+    def __eq__(self, other):
+        return self.value == other
+
+class NamespaceContext:
+    def __init__(self, namespace_obj, value):
+        self.namespace_obj = namespace_obj
+        self.value = value
+        self.token = None
+
+    def __enter__(self):
+        self.token = self.namespace_obj._namespace.set(self.value)
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        self.namespace_obj._namespace.reset(self.token)
diff --git a/reproduce_cache_namespace.py b/reproduce_cache_namespace.py
new file mode 100644
index 00000000..84f961c1
--- /dev/null
+++ b/reproduce_cache_namespace.py
@@ -0,0 +1,40 @@
+import dspy
+from dspy.clients import configure_cache
+import os
+import shutil
+
+# Setup a temporary cache directory
+CACHE_DIR = ".test_dspy_cache"
+if os.path.exists(CACHE_DIR):
+    shutil.rmtree(CACHE_DIR)
+
+configure_cache(disk_cache_dir=CACHE_DIR)
+
+# Test that we can set and get a namespace
+dspy.cache.namespace.set("test_namespace")
+print(f"Namespace set to: {dspy.cache.namespace.value}")
+assert dspy.cache.namespace.value == "test_namespace"
+
+# Test that we can use a context manager
+with dspy.cache.namespace("temp_namespace"):
+    print(f"Namespace inside context: {dspy.cache.namespace.value}")
+    assert dspy.cache.namespace.value == "temp_namespace"
+print(f"Namespace after context: {dspy.cache.namespace.value}")
+assert dspy.cache.namespace.value == "test_namespace"
+
+# Test namespaced caching
+request = {"prompt": "hello"}
+dspy.cache.put(request, "response1")
+assert dspy.cache.get(request) == "response1"
+
+with dspy.cache.namespace("other_namespace"):
+    assert dspy.cache.get(request) is None
+    dspy.cache.put(request, "response2")
+    assert dspy.cache.get(request) == "response2"
+
+assert dspy.cache.get(request) == "response1"
+
+# Cleanup
+if os.path.exists(CACHE_DIR):
+    shutil.rmtree(CACHE_DIR)
+print("All tests passed!")
diff --git a/test_contextvars.py b/test_contextvars.py
new file mode 100644
index 00000000..03d31baa
--- /dev/null
+++ b/test_contextvars.py
@@ -0,0 +1,24 @@
+import contextvars
+import threading
+import asyncio
+
+namespace = contextvars.ContextVar("namespace", default=None)
+
+def set_ns(val):
+    namespace.set(val)
+
+def get_ns():
+    return namespace.get()
+
+def thread_func(val):
+    set_ns(val)
+    print(f"Thread {threading.current_thread().name} namespace: {get_ns()}")
+
+set_ns("main")
+print(f"Main namespace: {get_ns()}")
+
+t = threading.Thread(target=thread_func, args=("thread1",), name="thread1")
+t.start()
+t.join()
+
+print(f"Main namespace after thread: {get_ns()}")
