new file mode 100644
index 00000000..d1835703
--- /dev/null
+++ b/test_contextvars_nesting.py
@@ -0,0 +1,21 @@
+import contextvars
+
+namespace = contextvars.ContextVar("namespace", default=None)
+
+class NamespaceContext:
+    def __init__(self, val):
+        self.val = val
+        self.token = None
+    
+    def __enter__(self):
+        self.token = namespace.set(self.val)
+        return self
+    
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        namespace.reset(self.token)
+
+namespace.set("main")
+print(f"Before: {namespace.get()}")
+with NamespaceContext("temp"):
+    print(f"Inside: {namespace.get()}")
+print(f"After: {namespace.get()}")
