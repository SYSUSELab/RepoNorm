--- /dev/null
+++ b/test_contextvars_async.py
@@ -0,0 +1,18 @@
+import contextvars
+import asyncio
+
+namespace = contextvars.ContextVar("namespace", default=None)
+
+async def task_func(val):
+    namespace.set(val)
+    await asyncio.sleep(0.1)
+    print(f"Task {val} namespace: {namespace.get()}")
+
+async def main():
+    namespace.set("main")
+    t1 = asyncio.create_task(task_func("task1"))
+    t2 = asyncio.create_task(task_func("task2"))
+    await asyncio.gather(t1, t2)
+    print(f"Main namespace: {namespace.get()}")
+
+asyncio.run(main())
