index 00000000..50be02e1
--- /dev/null
+++ b/test_namespace_threading.py
@@ -0,0 +1,36 @@
+import dspy
+from dspy.clients import configure_cache
+import os
+import shutil
+import threading
+import time
+
+# Setup a temporary cache directory
+CACHE_DIR = ".test_dspy_cache_4"
+if os.path.exists(CACHE_DIR):
+    shutil.rmtree(CACHE_DIR)
+
+configure_cache(disk_cache_dir=CACHE_DIR)
+
+def thread_task(ns, event):
+    dspy.cache.namespace.set(ns)
+    event.wait()
+    assert dspy.cache.namespace.value == ns
+    print(f"Thread {ns} passed")
+
+event = threading.Event()
+t1 = threading.Thread(target=thread_task, args=("ns1", event))
+t2 = threading.Thread(target=thread_task, args=("ns2", event))
+
+t1.start()
+t2.start()
+event.set()
+t1.join()
+t2.join()
+
+assert dspy.cache.namespace.value is None
+print("Passed: Thread isolation")
+
+# Cleanup
+if os.path.exists(CACHE_DIR):
+    shutil.rmtree(CACHE_DIR)
diff --git a/test_request_cache_namespace.py b/test_request_cache_namespace.py
