--- /dev/null
+++ b/test_request_cache_namespace.py
@@ -0,0 +1,41 @@
+import dspy
+from dspy.clients import configure_cache
+from dspy.clients.cache import request_cache
+import os
+import shutil
+
+# Setup a temporary cache directory
+CACHE_DIR = ".test_dspy_cache_2"
+if os.path.exists(CACHE_DIR):
+    shutil.rmtree(CACHE_DIR)
+
+configure_cache(disk_cache_dir=CACHE_DIR)
+
+@request_cache(namespace="ns1")
+def my_func(x):
+    return x + 1
+
+@request_cache(namespace="ns2")
+def my_func_ns2(x):
+    return x + 1
+
+# Test namespaced decorator
+assert my_func(1) == 2
+assert my_func_ns2(1) == 2
+
+# Verify they are in different namespaces
+# If we change the namespace of one, it shouldn't affect the other.
+# Actually, the decorator forces the namespace.
+
+# Let's verify that calling with different namespaces works
+@request_cache()
+def my_func_no_ns(x):
+    return x + 1
+
+with dspy.cache.namespace("ns3"):
+    assert my_func_no_ns(1) == 2
+
+# Cleanup
+if os.path.exists(CACHE_DIR):
+    shutil.rmtree(CACHE_DIR)
+print("All tests passed!")
