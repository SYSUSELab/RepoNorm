+import tiktoken
+import pytest
+
+def test_budgets():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test encode max_tokens
+    tokens = enc.encode("hello world")
+    assert enc.encode("hello world", max_tokens=10) == tokens
+    with pytest.raises(ValueError, match="Encoding exceeded max_tokens"):
+        enc.encode("hello world", max_tokens=1)
+    
+    # Test encode_batch max_tokens
+    tokens_batch = enc.encode_batch(["hello", "world"])
+    assert enc.encode_batch(["hello", "world"], max_tokens=10) == tokens_batch
+    with pytest.raises(ValueError, match="Encoding exceeded max_tokens"):
+        enc.encode_batch(["hello world", "world"], max_tokens=1)
+    
+    # Test encode_batch max_total_tokens
+    assert enc.encode_batch(["hello", "world"], max_total_tokens=10) == tokens_batch
+    with pytest.raises(ValueError, match="Encoding exceeded max_total_tokens"):
+        enc.encode_batch(["hello", "world"], max_total_tokens=1)
+        
+    # Test invalid max_tokens
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello", max_tokens=-1)
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello", max_tokens=True)
+        
+    # Test invalid max_total_tokens
+    with pytest.raises(ValueError, match="max_total_tokens must be a positive integer"):
+        enc.encode_batch(["hello"], max_total_tokens=-1)
+    with pytest.raises(ValueError, match="max_total_tokens must be a positive integer"):
+        enc.encode_batch(["hello"], max_total_tokens=True)
+
+test_budgets()
