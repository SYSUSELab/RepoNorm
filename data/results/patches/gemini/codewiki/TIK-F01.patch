+import tiktoken
+import pytest
+
+def test_token_budgets():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test encode with max_tokens
+    tokens = enc.encode("hello world", max_tokens=10)
+    assert len(tokens) == 2
+    
+    try:
+        enc.encode("hello world", max_tokens=1)
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+    
+    # Test encode_batch with max_tokens
+    tokens_list = enc.encode_batch(["hello world", "goodbye world"], max_tokens=10)
+    assert len(tokens_list) == 2
+    
+    try:
+        enc.encode_batch(["hello world", "goodbye world"], max_tokens=1)
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+        
+    # Test encode_batch with max_total_tokens
+    tokens_list = enc.encode_batch(["hello world", "goodbye world"], max_total_tokens=10)
+    assert len(tokens_list) == 2
+    
+    try:
+        enc.encode_batch(["hello world", "goodbye world"], max_total_tokens=1)
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+
+    # Test invalid max_tokens
+    try:
+        enc.encode("hello world", max_tokens=-1)
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+
+    try:
+        enc.encode("hello world", max_tokens=True)
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+
+if __name__ == "__main__":
+    test_token_budgets()
