+import tiktoken
+import pytest
+
+def test_encode_max_tokens():
+    enc = tiktoken.get_encoding("gpt2")
+    # Valid
+    assert enc.encode("hello", max_tokens=10) == [31373]
+    # Exact
+    assert enc.encode("hello", max_tokens=1) == [31373]
+    # Exceeded
+    with pytest.raises(ValueError, match="Encoding exceeded max_tokens"):
+        enc.encode("hello", max_tokens=0)
+    # Invalid
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello", max_tokens=-1)
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello", max_tokens=True)
+
+def test_encode_batch_max_tokens():
+    enc = tiktoken.get_encoding("gpt2")
+    # Valid
+    assert enc.encode_batch(["hello", "world"], max_tokens=10) == [[31373], [6894]]
+    # Exceeded
+    with pytest.raises(ValueError, match="Encoding exceeded max_tokens at index 0"):
+        enc.encode_batch(["hello", "world"], max_tokens=0)
+    with pytest.raises(ValueError, match="Encoding exceeded max_tokens at index 1"):
+        enc.encode_batch(["", "world"], max_tokens=0)
+
+def test_encode_batch_max_total_tokens():
+    enc = tiktoken.get_encoding("gpt2")
+    # Valid
+    assert enc.encode_batch(["hello", "world"], max_total_tokens=10) == [[31373], [6894]]
+    # Exact
+    assert enc.encode_batch(["hello", "world"], max_total_tokens=2) == [[31373], [6894]]
+    # Exceeded
+    with pytest.raises(ValueError, match="Encoding exceeded max_total_tokens"):
+        enc.encode_batch(["hello", "world"], max_total_tokens=1)
+    # Invalid
+    with pytest.raises(ValueError, match="max_total_tokens must be a positive integer"):
+        enc.encode_batch(["hello", "world"], max_total_tokens=-1)
+
+def test_both_limits():
+    enc = tiktoken.get_encoding("gpt2")
+    # Both valid
+    assert enc.encode_batch(["hello", "world"], max_tokens=1, max_total_tokens=2) == [[31373], [6894]]
+    # Per-document exceeded
+    with pytest.raises(ValueError, match="Encoding exceeded max_tokens at index 0"):
+        enc.encode_batch(["hello world", "world"], max_tokens=1, max_total_tokens=10)
+    # Total exceeded
+    with pytest.raises(ValueError, match="Encoding exceeded max_total_tokens"):
+        enc.encode_batch(["hello", "world"], max_tokens=10, max_total_tokens=1)
+
+if __name__ == "__main__":
+    # Run tests manually
+    try:
+        test_encode_max_tokens()
+        test_encode_batch_max_tokens()
+        test_encode_batch_max_total_tokens()
+        test_both_limits()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
