index 0000000..caa7a11
--- /dev/null
+++ b/tests/test_filesystem_loader_fallback.py
@@ -0,0 +1,49 @@
+import os
+import tempfile
+from pathlib import Path
+from jinja2 import Environment, FileSystemLoader
+
+def test_filesystem_loader_fallback():
+    with tempfile.TemporaryDirectory() as tmpdir1, tempfile.TemporaryDirectory() as tmpdir2:
+        # Create templates
+        with open(os.path.join(tmpdir1, 'primary.html'), 'w') as f:
+            f.write('primary')
+        with open(os.path.join(tmpdir2, 'fallback.html'), 'w') as f:
+            f.write('fallback')
+        with open(os.path.join(tmpdir2, 'shared.html'), 'w') as f:
+            f.write('fallback_shared')
+        with open(os.path.join(tmpdir1, 'shared.html'), 'w') as f:
+            f.write('primary_shared')
+
+        # Test with new FileSystemLoader
+        loader = FileSystemLoader(tmpdir1, fallback_searchpath=tmpdir2)
+        env = Environment(loader=loader)
+        
+        assert env.get_template('primary.html').render() == 'primary'
+        assert env.get_template('fallback.html').render() == 'fallback'
+        assert env.get_template('shared.html').render() == 'primary_shared'
+        
+        # Verify list_templates
+        templates = loader.list_templates()
+        assert sorted(templates) == ['fallback.html', 'primary.html', 'shared.html']
+
+def test_filesystem_loader_fallback_none():
+    with tempfile.TemporaryDirectory() as tmpdir1:
+        loader = FileSystemLoader(tmpdir1, fallback_searchpath=None)
+        assert loader.fallback_searchpath == []
+
+def test_filesystem_loader_fallback_sequence():
+    with tempfile.TemporaryDirectory() as tmpdir1, tempfile.TemporaryDirectory() as tmpdir2, tempfile.TemporaryDirectory() as tmpdir3:
+        with open(os.path.join(tmpdir2, 'f1.html'), 'w') as f:
+            f.write('f1')
+        with open(os.path.join(tmpdir3, 'f2.html'), 'w') as f:
+            f.write('f2')
+            
+        loader = FileSystemLoader(tmpdir1, fallback_searchpath=[tmpdir2, tmpdir3])
+        env = Environment(loader=loader)
+        
+        assert env.get_template('f1.html').render() == 'f1'
+        assert env.get_template('f2.html').render() == 'f2'
+        
+        templates = loader.list_templates()
+        assert sorted(templates) == ['f1.html', 'f2.html']
