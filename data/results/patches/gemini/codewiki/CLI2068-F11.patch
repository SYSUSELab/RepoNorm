diff --git a/tests/test_monitor_process.py b/tests/test_monitor_process.py
new file mode 100644
index 0000000..07ee4d7
--- /dev/null
+++ b/tests/test_monitor_process.py
@@ -0,0 +1,26 @@
+import click
+import pytest
+from unittest.mock import MagicMock
+
+def test_monitor_process_callback():
+    editor_cmd = "true"
+    mock_callback = MagicMock()
+    click.edit("hello", editor=editor_cmd, monitor_process=mock_callback)
+    assert mock_callback.call_count == 2
+    assert mock_callback.call_args_list[0][0][0] == 'start'
+    assert mock_callback.call_args_list[1][0][0] == 'terminate'
+
+def test_invalid_callback():
+    with pytest.raises(TypeError, match="monitor_process must be a callable"):
+        click.edit("hello", editor="true", monitor_process="not a callable")
+
+def test_callback_exception():
+    def bad_callback(event_type, process_id, editor_command, timestamp):
+        raise Exception("Boom!")
+    
+    import warnings
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        click.edit("hello", editor="true", monitor_process=bad_callback)
+        assert len(w) == 2
+        assert "Exception in monitor_process callback" in str(w[0].message)
