+class IsCreditCard(DirtyEquals[str]):
+    def __init__(self, issuer: Optional[str] = None, *repr_args: Any, **repr_kwargs: Any):
+        self.issuer = issuer
+        super().__init__(issuer=issuer, *repr_args, **repr_kwargs)
 
     def equals(self, other: Any) -> bool:
-        return self.func(other)
+        if not isinstance(other, (str, int)):
+            return False
+        
+        s = str(other).replace(' ', '').replace('-', '')
+        if not s.isdigit():
+            return False
+        
+        if not (12 <= len(s) <= 19):
+            return False
+            
+        # Luhn algorithm
+        digits = [int(d) for d in s]
+        checksum = 0
+        reverse_digits = digits[::-1]
+        for i, digit in enumerate(reverse_digits):
+            if i % 2 == 1:
+                digit *= 2
+                if digit > 9:
+                    digit -= 9
+            checksum += digit
+        
+        if checksum % 10 != 0:
+            return False
+            
+        if self.issuer:
+            if self.issuer == 'Visa':
+                if not (s.startswith('4') and len(s) in (13, 16, 19)):
+                    return False
+            elif self.issuer == 'Mastercard':
+                if len(s) != 16:
+                    return False
+                prefix = int(s[:4])
+                if not ((51 <= int(s[:2]) <= 55) or (2221 <= prefix <= 2720)):
+                    return False
+            elif self.issuer == 'AmericanExpress':
+                if not (len(s) == 15 and (s.startswith('34') or s.startswith('37'))):
+                    return False
+            else:
+                # Unknown issuer
+                return False
+                
+        return True
