+from dirty_equals import IsCreditCard
+
+@pytest.mark.parametrize(
+    'card',
+    [
+        '4000000000000002',
+        '4000-0000-0000-0002',
+        '4000 0000 0000 0002',
+        4000000000000002,
+    ],
+)
+def test_is_credit_card_visa(card):
+    assert card == IsCreditCard(issuer='Visa')
+    assert card == IsCreditCard()
+
+@pytest.mark.parametrize(
+    'card',
+    [
+        '5100000000000008',
+    ],
+)
+def test_is_credit_card_mastercard(card):
+    assert card == IsCreditCard(issuer='Mastercard')
+    assert card != IsCreditCard(issuer='Visa')
+
+@pytest.mark.parametrize(
+    'card',
+    [
+        '340000000000009',
+    ],
+)
+def test_is_credit_card_amex(card):
+    assert card == IsCreditCard(issuer='AmericanExpress')
+    assert card != IsCreditCard(issuer='Visa')
+
+def test_is_credit_card_invalid():
+    assert '4000000000000003' != IsCreditCard()
+    assert '123' != IsCreditCard()
+    assert 'abc' != IsCreditCard()
+    assert 123 != IsCreditCard()
+    assert '4000000000000002' != IsCreditCard(issuer='Mastercard')
