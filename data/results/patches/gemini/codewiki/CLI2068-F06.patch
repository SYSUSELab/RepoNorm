diff --git a/tests/test_process_priority.py b/tests/test_process_priority.py
new file mode 100644
index 0000000..76ee05f
--- /dev/null
+++ b/tests/test_process_priority.py
@@ -0,0 +1,28 @@
+import click
+import pytest
+import os
+from unittest.mock import patch, MagicMock
+
+def test_process_priority_invalid():
+    with pytest.raises(ValueError):
+        click.edit("hello", process_priority="invalid")
+
+def test_process_priority_valid():
+    # Mock subprocess.Popen to verify it's called with the right arguments
+    with patch('subprocess.Popen') as mock_popen:
+        mock_popen.return_value.wait.return_value = 0
+        
+        # We need to mock the editor detection to avoid issues
+        with patch('click._termui_impl.Editor.get_editor', return_value='true'):
+            click.edit("hello", process_priority="high")
+            
+            # Check if Popen was called
+            assert mock_popen.called
+            
+            # Check if preexec_fn was passed (on Linux)
+            if os.name != 'nt':
+                args, kwargs = mock_popen.call_args
+                assert 'preexec_fn' in kwargs
+                # Verify the preexec_fn sets the priority
+                # We can't easily check the value of preexec_fn, but we can check if it's a callable
+                assert callable(kwargs['preexec_fn'])
