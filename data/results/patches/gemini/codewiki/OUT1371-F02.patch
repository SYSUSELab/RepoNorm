@@ -11,6 +11,44 @@ from typing import Any, Callable, Dict, Optional, Type, cast
 import jinja2
 import pydantic
 
+# Global registry for filters
+_GLOBAL_FILTERS: Dict[str, Callable] = {}
+
+# Protected filters that cannot be overridden
+_PROTECTED_FILTERS = {"name", "description", "source", "signature", "schema", "args"}
+
+def register_filter(name: str, callable: Callable):
+    """Register a global filter."""
+    if name in _PROTECTED_FILTERS:
+        return
+    _GLOBAL_FILTERS[name] = callable
+
+def unregister_filter(name: str):
+    """Unregister a global filter."""
+    if name in _GLOBAL_FILTERS:
+        del _GLOBAL_FILTERS[name]
+
+def _get_env():
+    """Create a Jinja2 environment with default and global filters."""
+    env = jinja2.Environment(
+        trim_blocks=True,
+        lstrip_blocks=True,
+        keep_trailing_newline=True,
+        undefined=jinja2.StrictUndefined,
+    )
+    # Default filters
+    env.filters["name"] = get_fn_name
+    env.filters["description"] = get_fn_description
+    env.filters["source"] = get_fn_source
+    env.filters["signature"] = get_fn_signature
+    env.filters["schema"] = get_schema
+    env.filters["args"] = get_fn_args
+    
+    # Global filters
+    for name, filter_func in _GLOBAL_FILTERS.items():
+        env.filters[name] = filter_func
+        
+    return env
 
