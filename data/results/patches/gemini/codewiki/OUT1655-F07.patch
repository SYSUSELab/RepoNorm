--- /dev/null
+++ b/test_credit_card.py
@@ -0,0 +1,38 @@
+from outlines.types import Regex
+
+# Define the regex for credit card
+# 16 digits
+# Shapes:
+# 1. 16 digits: \d{16}
+# 2. 4 groups of 4 separated by hyphens: \d{4}-\d{4}-\d{4}-\d{4}
+# 3. 4 groups of 4 separated by spaces: \d{4} \d{4} \d{4} \d{4}
+
+# Combined regex:
+# (\d{16})|(\d{4}-\d{4}-\d{4}-\d{4})|(\d{4} \d{4} \d{4} \d{4})
+# Wait, the requirement says "Separators must be consistent."
+# The above regex allows mixing, e.g., 1234-5678 9012-3456.
+# I need to make sure it's consistent.
+
+# Correct regex:
+# (\d{16})|(\d{4}-\d{4}-\d{4}-\d{4})|(\d{4} \d{4} \d{4} \d{4})
+# Actually, the above regex *does* enforce consistency because each alternative is a complete pattern.
+# Let's test it.
+
+import re
+
+pattern = r"(\d{16})|(\d{4}-\d{4}-\d{4}-\d{4})|(\d{4} \d{4} \d{4} \d{4})"
+regex = re.compile(pattern)
+
+test_cases = [
+    "1234567812345678",
+    "1234-5678-1234-5678",
+    "1234 5678 1234 5678",
+    "1234-5678 1234-5678", # Should fail
+    "123456781234567", # Should fail (too short)
+    "12345678123456789", # Should fail (too long)
+]
+
+for tc in test_cases:
+    match = regex.fullmatch(tc)
+    print(f"'{tc}': {'Match' if match else 'No match'}")
+
diff --git a/tests/types/test_credit_card.py b/tests/types/test_credit_card.py
new file mode 100644
index 0000000..b9cfd73
--- /dev/null
+++ b/tests/types/test_credit_card.py
@@ -0,0 +1,16 @@
+from outlines.types import credit_card
+import re
+
+def test_credit_card_regex():
+    pattern = credit_card.pattern
+    regex = re.compile(pattern)
+    
+    assert regex.fullmatch("1234567812345678")
+    assert regex.fullmatch("1234-5678-1234-5678")
+    assert regex.fullmatch("1234 5678 1234 5678")
+    
+    assert not regex.fullmatch("1234-5678 1234-5678")
+    assert not regex.fullmatch("123456781234567")
+    assert not regex.fullmatch("12345678123456789")
+    assert not regex.fullmatch("1234-5678-1234-567")
+    assert not regex.fullmatch("1234 5678 1234 567")
diff --git a/verify_credit_card.py b/verify_credit_card.py
new file mode 100644
index 0000000..b09c993
