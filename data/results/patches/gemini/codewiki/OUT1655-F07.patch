+++ b/verify_credit_card.py
@@ -0,0 +1,25 @@
+from outlines.types import credit_card
+import re
+
+# The regex is stored in credit_card.pattern
+pattern = credit_card.pattern
+print(f"Pattern: {pattern}")
+
+regex = re.compile(pattern)
+
+test_cases = [
+    ("1234567812345678", True),
+    ("1234-5678-1234-5678", True),
+    ("1234 5678 1234 5678", True),
+    ("1234-5678 1234-5678", False),
+    ("123456781234567", False),
+    ("12345678123456789", False),
+]
+
+for tc, expected in test_cases:
+    match = regex.fullmatch(tc)
+    result = bool(match)
+    print(f"'{tc}': {'Match' if result else 'No match'} (Expected: {'Match' if expected else 'No match'})")
+    assert result == expected
+
+print("All tests passed!")
