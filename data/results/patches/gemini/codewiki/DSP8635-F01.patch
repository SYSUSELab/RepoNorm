+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+import random
+import json
+
+# Mocking a simple program and predictor
+class SimplePredictor(dspy.Predict):
+    def __init__(self):
+        super().__init__(dspy.Signature("input -> output"))
+
+class SimpleProgram(dspy.Module):
+    def __init__(self):
+        super().__init__()
+        self.predictor = SimplePredictor()
+    def forward(self, x):
+        return self.predictor(input=x)
+
+# Setup
+program = SimpleProgram()
+# Mocking the prompt_model
+class MockLM(dspy.LM):
+    def __init__(self):
+        super().__init__("mock/model")
+        self.kwargs = {"temperature": 0.7}
+        self.history = []
+    def __call__(self, prompt=None, messages=None, **kwargs):
+        self.history.append(kwargs.get("temperature"))
+        # Return a structure that the JSONAdapter expects
+        return [{"text": json.dumps({"proposed_instruction": "new instruction"})}]
+    def inspect_history(self, n=1):
+        pass
+
+mock_lm = MockLM()
+trainset = []
+proposer = GroundedProposer(mock_lm, program, trainset)
+proposer.use_dataset_summary = False # Disable to avoid error
+proposer.program_aware = False # Disable to avoid error
+
+# Run proposal
+demo_candidates = [[[]]]
+trial_logs = {}
+N = 1
+T = 0.7
+
+# We need to make sure we don't trigger the temperature override in dspy.Predict
+# The override happens if n > 1. Let's check if n is 1.
+# In GroundedProposer, it seems it uses default n=1.
+
+proposer.propose_instructions_for_program(trainset, program, demo_candidates, trial_logs, N, T)
+
+print(f"Temperatures used: {mock_lm.history}")
+# Filter out None values if any
+temps = [t for t in mock_lm.history if t is not None]
+if any(t != 0.7 for t in temps):
+    print("Issue reproduced: Temperature was perturbed.")
+else:
+    print("Issue not reproduced: Temperature was not perturbed.")
