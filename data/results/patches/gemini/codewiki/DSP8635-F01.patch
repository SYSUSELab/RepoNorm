+    "        num_demos_in_context=3,\n",
+    "        tip=None,\n",
+    "    ):\n",
+    "        def gather_examples_from_sets(candidate_sets, max_examples):\n",
+    "            \"\"\"Helper function to gather up to augmented examples from given sets.\"\"\"\n",
+    "            count = 0\n",
+    "            for candidate_set in candidate_sets:\n",
+    "                for example in candidate_set:\n",
+    "                    if \"augmented\" in example.keys():\n",
+    "                        fields_to_use = get_signature(program.predictors()[pred_i]).fields\n",
+    "                        yield create_example_string(fields_to_use, example)\n",
+    "                        count += 1\n",
+    "                        if count >= max_examples:\n",
+    "                            return\n",
+    "\n",
+    "        # Construct full program demo or single module demo depending on settings\n",
+    "        basic_instruction = get_signature(program.predictors()[pred_i]).instructions\n",
+    "        task_demos = \"\"\n",
+    "\n",
+    "        if self.use_task_demos:\n",
+    "            # Combine current and adjacent sets\n",
+    "            adjacent_sets = (\n",
+    "                [demo_candidates[pred_i][demo_set_i]] +\n",
+    "                [demo_candidates[pred_i][i] for i in range(len(demo_candidates[pred_i])) if i != demo_set_i]\n",
+    "            )\n",
+    "            task_demos = \"\\n\".join(gather_examples_from_sets(adjacent_sets, num_demos_in_context))\n",
+    "\n",
+    "        # Describe the program and module\n",
+    "        program_description = self.describe_program(cache_salt=self.cache_salt, program_code=self.program_code_string).program_description\n",
+    "        module_description = self.describe_module(cache_salt=self.cache_salt, program_code=self.program_code_string, module=get_dspy_source_code(program.predictors()[pred_i])).module_description\n",
+    "\n",
+    "        # Generate the instruction\n",
+    "        return self.generate_module_instruction(\n",
+    "            cache_salt=self.cache_salt,\n",
+    "            program_description=program_description,\n",
