+    "            data_summary=data_summary,\n",
+    "            tip=tip,\n",
+    "        ).instruction\n"
+]
+
+# Replace the old `forward` method.
+new_lines = lines[:start_line-1] + new_forward + lines[end_line-1:]
+
+with open("dspy/propose/grounded_proposer.py", "w") as f:
+    f.writelines(new_lines)
