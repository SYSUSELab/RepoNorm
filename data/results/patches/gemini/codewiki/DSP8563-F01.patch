 class ToolCalls(Type):
+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize input data to a ToolCalls-compatible dictionary."""
+        if isinstance(data, cls):
+            return data
+
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except json.JSONDecodeError:
+                return data
+
+        if isinstance(data, dict) and "name" in data and "args" in data:
+            data = {"tool_calls": [data]}
+        elif isinstance(data, list):
+            data = {"tool_calls": data}
+        
+        return data
+
+    @classmethod
+    def model_validate(cls, obj, **kwargs):
+        obj = cls.validate_input(obj)
+        return super().model_validate(obj, **kwargs)
+
