@@ -0,0 +1,45 @@
+import re
+
+with open('tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# Add parameter
+content = re.sub(
+    r'(def encode\(\n\s+self,\n\s+text: str,\n\s+\*,)',
+    r'\1\n        return_repeated_pattern: bool = False,',
+    content
+)
+
+# Change return type
+content = re.sub(
+    r'(\) -> list\[int\]:)',
+    r') -> list[int] | tuple[list[int], dict[tuple[int, int], int]]:',
+    content,
+    count=1 # Only the first one, which is `encode`
+)
+
+# Replace return statement
+def get_replacement(tokens_var):
+    return f"""        {tokens_var} = self._core_bpe.encode(text, allowed_special)
+        if not return_repeated_pattern:
+            return {tokens_var}
+        
+        if len({tokens_var}) < 2:
+            return {tokens_var}, {{}}
+        
+        from collections import Counter
+        pairs = []
+        for j in range(len({tokens_var}) - 1):
+            pairs.append(({tokens_var}[j], {tokens_var}[j+1]))
+        
+        counts = Counter(pairs)
+        return {tokens_var}, dict(counts.most_common(3))"""
+
+content = re.sub(
+    r'return self\._core_bpe\.encode\(text, allowed_special\)',
+    get_replacement('tokens'),
+    content
+)
+
+with open('tiktoken/core.py', 'w') as f:
+    f.write(content)
