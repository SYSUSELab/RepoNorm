+import tiktoken
+import pytest
+
+def test_pattern_tracking():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello hello hello world"
+    
+    # Test default behavior
+    tokens = enc.encode(text)
+    assert isinstance(tokens, list)
+    
+    # Test pattern tracking
+    tokens, patterns = enc.encode(text, return_repeated_pattern=True)
+    assert isinstance(tokens, list)
+    assert isinstance(patterns, dict)
+    
+    # "hello hello hello world" -> [31373, 23748, 23748, 995]
+    # Pairs:
+    # (31373, 23748) - 1
+    # (23748, 23748) - 1
+    # (23748, 995) - 1
+    assert len(patterns) == 3
+    assert patterns[(31373, 23748)] == 1
+    assert patterns[(23748, 23748)] == 1
+    assert patterns[(23748, 995)] == 1
+
+def test_pattern_tracking_empty():
+    enc = tiktoken.get_encoding("gpt2")
+    tokens, patterns = enc.encode("", return_repeated_pattern=True)
+    assert tokens == []
+    assert patterns == {}
+
+def test_pattern_tracking_single_token():
+    enc = tiktoken.get_encoding("gpt2")
+    tokens, patterns = enc.encode("hello", return_repeated_pattern=True)
+    assert tokens == [31373]
+    assert patterns == {}
+
+def test_pattern_tracking_overlap():
+    enc = tiktoken.get_encoding("gpt2")
+    # "aaaaaaaaaaaa" -> [24794, 24794, 24794]
+    # Pairs: (24794, 24794), (24794, 24794)
+    # Count: (24794, 24794) -> 2
+    tokens, patterns = enc.encode("aaaaaaaaaaaa", return_repeated_pattern=True)
+    assert tokens == [24794, 24794, 24794]
+    assert patterns == {(24794, 24794): 2}
