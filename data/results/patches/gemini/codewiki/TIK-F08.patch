+import re
+
+with open('tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# Add parameter
+# The regex was too broad. Let's be more specific.
+# The signature is:
+#    def encode(
+#        self,
+#        text: str,
+#        *,
+#        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006
+#        disallowed_special: Literal["all"] | Collection[str] = "all",
+#    ) -> list[int]:
+
+content = re.sub(
+    r'(def encode\(\n\s+self,\n\s+text: str,\n\s+\*,)',
+    r'\1\n        return_repeated_pattern: bool = False,',
+    content
+)
+
+# Change return type
+# This is still a bit risky. Let's look for the specific signature.
+# The signature is followed by `) -> list[int]:`
+# Let's use a more specific regex.
+content = re.sub(
+    r'(\n\s+disallowed_special: Literal\["all"\] \| Collection\[str\] = "all",\n\s+\) ->) list\[int\]:',
+    r'\1 list[int] | tuple[list[int], dict[tuple[int, int], int]]:',
+    content
+)
+
+# Replace return statement
+def get_replacement(tokens_var):
+    return f"""        {tokens_var} = self._core_bpe.encode(text, allowed_special)
+        if not return_repeated_pattern:
+            return {tokens_var}
+        
+        if len({tokens_var}) < 2:
+            return {tokens_var}, {{}}
+        
+        from collections import Counter
+        pairs = []
+        for j in range(len({tokens_var}) - 1):
+            pairs.append(({tokens_var}[j], {tokens_var}[j+1]))
+        
+        counts = Counter(pairs)
+        return {tokens_var}, dict(counts.most_common(3))"""
+
+# We need to be careful not to replace the one in `encode_ordinary` if it exists.
+# `encode_ordinary` uses `self._core_bpe.encode_ordinary(text)`.
+# So `self._core_bpe.encode(text, allowed_special)` should be unique to `encode`.
+
+content = re.sub(
+    r'return self\._core_bpe\.encode\(text, allowed_special\)',
+    get_replacement('tokens'),
+    content
+)
+
+with open('tiktoken/core.py', 'w') as f:
+    f.write(content)
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..562f8a7
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,45 @@
+import tiktoken
+from collections import Counter
+
+def encode_with_pattern_tracking(enc, text, return_repeated_pattern=False):
+    tokens = enc.encode(text)
+    if not return_repeated_pattern:
+        return tokens
+    
+    if len(tokens) < 2:
+        return tokens, {}
+    
+    pairs = []
+    for i in range(len(tokens) - 1):
+        pairs.append((tokens[i], tokens[i+1]))
+    
+    counts = Counter(pairs)
+    
+    # Get top 3
+    # "Include pairs occurring only once if they belong in the top three."
+    # "If fewer than three distinct pairs exist, return all of them."
+    # "At the top-three boundary any selection among equal-frequency pairs is valid"
+    
+    # Counter.most_common(3) does exactly this.
+    top_three = dict(counts.most_common(3))
+    
+    return tokens, top_three
+
+# Test
+enc = tiktoken.get_encoding("gpt2")
+text = "hello hello hello world"
+tokens = enc.encode(text)
+print(f"Tokens: {tokens}")
+
+# Expected behavior:
+# "hello" -> 31373
+# " " -> 220
+# "world" -> 995
+# "hello hello hello world" -> [31373, 220, 31373, 220, 31373, 220, 995]
+# Pairs:
+# (31373, 220) - 3 times
+# (220, 31373) - 2 times
+# (220, 995) - 1 time
+
+tokens, patterns = encode_with_pattern_tracking(enc, text, return_repeated_pattern=True)
+print(f"Patterns: {patterns}")
