+        # Find the try block
+        for j in range(i, i+30):
+            if 'try:' in lines[j]:
+                # Replace the whole try block
+                lines[j+1:j+15] = [
+                    '            if self.escape_shell:\n',
+                    '                args = shlex.split(editor) + [filename]\n',
+                    '                c = subprocess.Popen(args, env=environ)\n',
+                    '            else:\n',
+                    '                c = subprocess.Popen(f\'{editor} "{filename}"\', env=environ, shell=True)\n',
+                    '\n',
+                    '            exit_code = c.wait()\n',
+                    '            if exit_code != 0:\n',
+                    '                raise ClickException(\n',
+                    '                    _("{editor}: Editing failed").format(editor=editor)\n',
+                    '                )\n'
+                ]
+                # Find the except block
+                for k in range(j+1, j+30):
+                    if 'except OSError as e:' in lines[k]:
