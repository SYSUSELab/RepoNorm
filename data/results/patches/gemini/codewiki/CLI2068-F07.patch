+import sys
+
+with open('src/click/termui.py', 'r') as f:
+    content = f.read()
+
+# Add escape_shell to edit()
+edit_def = """def edit(
+    text: t.AnyStr | None = None,
+    editor: str | None = None,
+    env: cabc.Mapping[str, str] | None = None,
+    require_save: bool = True,
+    extension: str = ".txt",
+    filename: str | None = None,
+) -> t.AnyStr | None:"""
+
+new_edit_def = """def edit(
+    text: t.AnyStr | None = None,
+    editor: str | None = None,
+    env: cabc.Mapping[str, str] | None = None,
+    require_save: bool = True,
+    extension: str = ".txt",
+    filename: str | None = None,
+    escape_shell: bool = False,
+) -> t.AnyStr | None:"""
+
+content = content.replace(edit_def, new_edit_def)
+
+# Update the call to Editor
+editor_call = """    ed = Editor(editor=editor, env=env, require_save=require_save, extension=extension)
+
+    if filename is None:
+        return ed.edit(text)
+
+    ed.edit_file(filename)"""
+
+new_editor_call = """    ed = Editor(editor=editor, env=env, require_save=require_save, extension=extension, escape_shell=escape_shell)
+
+    if filename is None:
+        return ed.edit(text)
+
+    ed.edit_file(filename)"""
+
+content = content.replace(editor_call, new_editor_call)
+
+with open('src/click/termui.py', 'w') as f:
+    f.write(content)
