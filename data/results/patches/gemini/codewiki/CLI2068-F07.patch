+                        lines[k+1] = '                raise ClickException(\n'
+                        lines[k+2] = '                    _("{editor}: Editing failed: {e}").format(editor=editor, e=e)\n'
+                        lines[k+3] = '                ) from e\n'
+                        break
+                break
+        break
+
+with open('src/click/_termui_impl.py', 'w') as f:
+    f.writelines(lines)
