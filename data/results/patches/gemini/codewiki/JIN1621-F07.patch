diff --git a/test_edge_cases.py b/test_edge_cases.py
new file mode 100644
index 0000000..55d3854
--- /dev/null
+++ b/test_edge_cases.py
@@ -0,0 +1,33 @@
+import os
+from jinja2 import FileSystemLoader
+
+# Set up environment variables
+os.environ["MY_TEMPLATE_DIR"] = "/tmp/templates"
+os.environ["HOME"] = "/home/user"
+
+# Test case: Undefined environment variable
+# expandvars leaves undefined variables as is
+loader = FileSystemLoader("$UNDEFINED_VAR/templates", expand_searchpath=True)
+print(f"Undefined var searchpath: {loader.searchpath}")
+assert loader.searchpath == ["$UNDEFINED_VAR/templates"]
+
+# Test case: Empty environment variable
+os.environ["EMPTY_VAR"] = ""
+loader = FileSystemLoader("$EMPTY_VAR/templates", expand_searchpath=True)
+print(f"Empty var searchpath: {loader.searchpath}")
+# expandvars replaces $EMPTY_VAR with ""
+assert loader.searchpath == ["/templates"]
+
+# Test case: PathLike object
+from pathlib import Path
+path = Path("~/templates")
+loader = FileSystemLoader(path, expand_searchpath=True)
+print(f"PathLike searchpath: {loader.searchpath}")
+assert loader.searchpath == ["/home/user/templates"]
+
+# Test case: Sequence of paths
+loader = FileSystemLoader(["$MY_TEMPLATE_DIR", "~/templates"], expand_searchpath=True)
+print(f"Sequence searchpath: {loader.searchpath}")
+assert loader.searchpath == ["/tmp/templates", "/home/user/templates"]
+
+print("All edge cases passed!")
diff --git a/test_expansion.py b/test_expansion.py
new file mode 100644
index 0000000..84b7caf
--- /dev/null
+++ b/test_expansion.py
@@ -0,0 +1,22 @@
+import os
+from jinja2 import FileSystemLoader
+
+# Set up environment variables
+os.environ["MY_TEMPLATE_DIR"] = "/tmp/templates"
+os.environ["HOME"] = "/home/user"
+
+# Test expansion logic
+def expand_path(path):
+    return os.path.expanduser(os.path.expandvars(os.fspath(path)))
+
+path1 = "$MY_TEMPLATE_DIR"
+path2 = "~/templates"
+path3 = "/absolute/path"
+
+print(f"'{path1}' -> '{expand_path(path1)}'")
+print(f"'{path2}' -> '{expand_path(path2)}'")
+print(f"'{path3}' -> '{expand_path(path3)}'")
+
+assert expand_path(path1) == "/tmp/templates"
+assert expand_path(path2) == "/home/user/templates"
+assert expand_path(path3) == "/absolute/path"
