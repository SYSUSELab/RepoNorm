diff --git a/fix_loaders_v2.py b/fix_loaders_v2.py
new file mode 100644
index 0000000..9214139
--- /dev/null
+++ b/fix_loaders_v2.py
@@ -0,0 +1,49 @@
+import re
+
+with open('src/jinja2/loaders.py', 'r') as f:
+    content = f.read()
+
+# Define the pattern for the old __init__ method
+# It starts with "    def __init__(" and ends with "        self.followlinks = followlinks"
+# But I need to be careful because I already messed it up.
+# Let's just replace the whole block from "    def __init__(" to "        self.followlinks = followlinks"
+# and remove the extra lines.
+
+pattern = re.compile(
+    r'    def __init__\(.*?\) -> None:.*?self\.followlinks = followlinks',
+    re.DOTALL
+)
+
+new_init = """    def __init__(
+        self,
+        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+        expand_searchpath: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        if expand_searchpath:
+            self.searchpath = [
+                os.path.expanduser(os.path.expandvars(os.fspath(p))) for p in searchpath
+            ]
+        else:
+            self.searchpath = [os.fspath(p) for p in searchpath]
+        self.encoding = encoding
+        self.followlinks = followlinks"""
+
+# Replace the first occurrence
+content = pattern.sub(new_init, content, count=1)
+
+# Now remove the extra lines that were left behind
+# The extra lines start with "        encoding: str = "utf-8","
+# Let's find and remove them.
+extra_pattern = re.compile(
+    r'        encoding: str = "utf-8",.*?self\.followlinks = followlinks',
+    re.DOTALL
+)
+content = extra_pattern.sub('', content)
+
+with open('src/jinja2/loaders.py', 'w') as f:
+    f.write(content)
