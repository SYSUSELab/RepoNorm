diff --git a/dirty_equals/_phone.py b/dirty_equals/_phone.py
new file mode 100644
index 0000000..bc24d9f
--- /dev/null
+++ b/dirty_equals/_phone.py
@@ -0,0 +1,64 @@
+import re
+from typing import Any, Optional
+from ._base import DirtyEquals
+
+class IsPhoneNumber(DirtyEquals[str]):
+    def __init__(self, country: Optional[str] = None):
+        self.country = country.upper() if country else None
+        super().__init__(country=self.country)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check for invalid characters
+        if re.search(r'[^0-9 \t\-\.\+\(\)]', other):
+            return False
+        
+        # Check for plus sign
+        if other.count('+') > 1 or (other.count('+') == 1 and not other.startswith('+')):
+            return False
+            
+        # Check for balanced parentheses
+        if other.count('(') != other.count(')'):
+            return False
+        
+        # Check for nested parentheses
+        # A simple way to check for nested parentheses is to see if there's a '(' after a '(' before a ')'
+        # Or just check if there's a '(' inside a pair of parentheses
+        if re.search(r'\([^()]*\([^()]*\)[^()]*\)', other):
+            return False
+            
+        # Normalize: remove separators
+        digits_only = re.sub(r'[^0-9]', '', other)
+        
+        if self.country == 'US':
+            # US: 10-digit national (e.g., 555-123-4567) or +1 + 10 digits
+            if other.startswith('+'):
+                if not other.startswith('+1'):
+                    return False
+                return len(digits_only) == 11
+            else:
+                return len(digits_only) == 10
+        elif self.country == 'GB':
+            # GB: national starting with 0 (10-11 digits) or +44 + 10-11 digits
+            if other.startswith('+'):
+                if not other.startswith('+44'):
+                    return False
+                return len(digits_only) in (12, 13) # 44 + 10 or 11 digits
+            else:
+                if not other.startswith('0'):
+                    return False
+                return len(digits_only) in (10, 11)
+        else:
+            # Generic: + followed by 8-19 digits
+            if other.startswith('+'):
+                return 8 <= len(digits_only) <= 19
+            else:
+                # National: 7-15 digits
+                return 7 <= len(digits_only) <= 15
+
+    def __repr__(self) -> str:
+        if self.country:
+            return f'IsPhoneNumber({self.country!r})'
+        return 'IsPhoneNumber(*)'
diff --git a/tests/test_phone_number.py b/tests/test_phone_number.py
new file mode 100644
index 0000000..8dbf881
--- /dev/null
+++ b/tests/test_phone_number.py
@@ -0,0 +1,48 @@
+import pytest
+from dirty_equals import IsPhoneNumber
+
+def test_is_phone_number_basic():
+    assert '+1-555-123-4567' == IsPhoneNumber()
+    assert '555-123-4567' == IsPhoneNumber()
+    assert '+44 20 7946 0958' == IsPhoneNumber()
+    assert '020 7946 0958' == IsPhoneNumber()
+    assert '+1234567890' == IsPhoneNumber()
+    assert '1234567' == IsPhoneNumber()
+    assert 123 != IsPhoneNumber()
+    assert None != IsPhoneNumber()
+
+def test_is_phone_number_us():
+    assert '+1-555-123-4567' == IsPhoneNumber('US')
+    assert '555-123-4567' == IsPhoneNumber('US')
+    assert '+15551234567' == IsPhoneNumber('US')
+    assert '5551234567' == IsPhoneNumber('US')
+    assert '+44 20 7946 0958' != IsPhoneNumber('US')
+    assert '020 7946 0958' != IsPhoneNumber('US')
+
+def test_is_phone_number_gb():
+    assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+    assert '020 7946 0958' == IsPhoneNumber('GB')
+    assert '+442079460958' == IsPhoneNumber('GB')
+    assert '02079460958' == IsPhoneNumber('GB')
+    assert '+1-555-123-4567' != IsPhoneNumber('GB')
+    assert '555-123-4567' != IsPhoneNumber('GB')
+
+def test_is_phone_number_invalid():
+    assert 'abc' != IsPhoneNumber()
+    assert '+1-555-123-456' != IsPhoneNumber('US') # Too short
+    assert '123456' != IsPhoneNumber() # Too short
+
+def test_is_phone_number_invalid_chars():
+    assert 'abc' != IsPhoneNumber()
+    assert '123-456-789a' != IsPhoneNumber()
+    assert '+1-555-123-4567!' != IsPhoneNumber()
+
+def test_is_phone_number_parentheses():
+    assert '(555) 123-4567' == IsPhoneNumber('US')
+    assert '(555) 123-4567' == IsPhoneNumber()
+    assert '((555)) 123-4567' != IsPhoneNumber() # Nested
+    assert '(555) 123-4567)' != IsPhoneNumber() # Unbalanced
+
+def test_is_phone_number_plus_position():
+    assert '1-555-123-4567+' != IsPhoneNumber()
+    assert '++1-555-123-4567' != IsPhoneNumber()
