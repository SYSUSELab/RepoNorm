+                dgettext = _make_new_dgettext(dgettext)
+            if dngettext is not None:
+                dngettext = _make_new_dngettext(dngettext)
+        self.environment.globals.update(
+            gettext=gettext,
+            ngettext=ngettext,
+            pgettext=pgettext,
+            npgettext=npgettext,
+            dgettext=dgettext,
+            dngettext=dngettext,
+        )
+"""
+content = content[:start_install] + new_install + content[end_install:]
+
+# 3. Update `_uninstall`
+start_uninstall = content.find("    def _uninstall(")
+end_uninstall = content.find("    def _extract(", start_uninstall)
+new_uninstall = """    def _uninstall(self, translations: "_SupportedTranslations") -> None:
+        for key in ("gettext", "ngettext", "pgettext", "npgettext", "dgettext", "dngettext"):
+            self.environment.globals.pop(key, None)
+"""
+content = content[:start_uninstall] + new_uninstall + content[end_uninstall:]
+
+# 4. Update `parse`
+# I will use the `parse` method I wrote earlier.
+# I need to make sure it's correctly indented.
+# I'll just read it from a file.
+with open('new_parse.py', 'r') as f:
+    new_parse = f.read()
+start_parse = content.find("    def parse(self, parser: \"Parser\")")
+end_parse = content.find("    def _trim_whitespace", start_parse)
+content = content[:start_parse] + new_parse + "\n" + content[end_parse:]
+
+# 5. Update `_make_node`
+with open('new_make_node.py', 'r') as f:
+    new_make_node = f.read()
+start_make_node = content.find("    def _make_node(")
+end_make_node = content.find("    def _extract", start_make_node)
+content = content[:start_make_node] + new_make_node + "\n" + content[end_make_node:]
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
