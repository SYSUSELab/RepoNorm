+
+# 3. Update `_uninstall`
+pattern_uninstall = re.compile(r'    def _uninstall\(self, translations: "_SupportedTranslations"\) -> None:.*?self\.environment\.globals\.pop\(key, None\)', re.DOTALL)
+new_uninstall = """    def _uninstall(self, translations: "_SupportedTranslations") -> None:
