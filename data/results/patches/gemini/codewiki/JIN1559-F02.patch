+# I will use a regex that matches the entire method.
+pattern_install = re.compile(r'    def _install_callables\(self,.*?\) -> None:.*?self\.environment\.globals\.update\(.*?\)', re.DOTALL)
+new_install_callables = """    def _install_callables(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        newstyle: t.Optional[bool] = None,
