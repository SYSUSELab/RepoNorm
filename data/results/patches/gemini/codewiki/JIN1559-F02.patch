+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Update `_install_callables`
+# I will add `dgettext` and `dngettext` to the arguments and to the globals.
+# This is the new `_install_callables` method.
+new_install_callables = [
+    '    def _install_callables(\n',
+    '        self,\n',
+    '        gettext: t.Callable[[str], str],\n',
+    '        ngettext: t.Callable[[str, str, int], str],\n',
+    '        newstyle: t.Optional[bool] = None,\n',
+    '        pgettext: t.Optional[t.Callable[[str, str], str]] = None,\n',
+    '        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,\n',
+    '        dgettext: t.Optional[t.Callable[[str, str], str]] = None,\n',
+    '        dngettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,\n',
+    '    ) -> None:\n',
+    '        if newstyle is not None:\n',
+    '            self.environment.newstyle_gettext = newstyle  # type: ignore\n',
+    '        if self.environment.newstyle_gettext:  # type: ignore\n',
+    '            gettext = _make_new_gettext(gettext)\n',
+    '            ngettext = _make_new_ngettext(ngettext)\n',
+    '            if pgettext is not None:\n',
+    '                pgettext = _make_new_pgettext(pgettext)\n',
+    '            if npgettext is not None:\n',
+    '                npgettext = _make_new_npgettext(npgettext)\n',
+    '            if dgettext is not None:\n',
+    '                dgettext = _make_new_dgettext(dgettext)\n',
+    '            if dngettext is not None:\n',
+    '                dngettext = _make_new_dngettext(dngettext)\n',
+    '        self.environment.globals.update(\n',
+    '            gettext=gettext,\n',
+    '            ngettext=ngettext,\n',
+    '            pgettext=pgettext,\n',
+    '            npgettext=npgettext,\n',
+    '            dgettext=dgettext,\n',
+    '            dngettext=dngettext,\n',
+    '        )\n',
+]
+
+# Update `_uninstall`
+new_uninstall = [
+    '    def _uninstall(self, translations: "_SupportedTranslations") -> None:\n',
+    '        for key in ("gettext", "ngettext", "pgettext", "npgettext", "dgettext", "dngettext"):\n',
+    '            self.environment.globals.pop(key, None)\n',
+]
+
+# Find the `_install_callables` method
+start_line = 0
+for i, line in enumerate(lines):
+    if '    def _install_callables(' in line:
+        start_line = i
+        break
+
+# Find the end of the `_install_callables` method.
+end_line = 0
+for i in range(start_line + 1, len(lines)):
+    if lines[i].startswith('    def _uninstall('):
+        end_line = i
+        break
+
+lines[start_line:end_line] = new_install_callables
+
+# Find the `_uninstall` method
+start_line = 0
+for i, line in enumerate(lines):
+    if '    def _uninstall(' in line:
+        start_line = i
+        break
+
+# Find the end of the `_uninstall` method.
+end_line = 0
+for i in range(start_line + 1, len(lines)):
+    if lines[i].startswith('    def '):
+        end_line = i
+        break
+
+lines[start_line:end_line] = new_uninstall
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
