index 0000000..cc55a99
--- /dev/null
+++ b/replace_methods.py
@@ -0,0 +1,71 @@
+import re
+
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+with open('new_methods.py', 'r') as f:
+    new_methods = f.read()
+
+# Extract parse and _make_node from new_methods
+# They are defined as:
+# def parse(...)
+# def _make_node(...)
+
+# I will use regex to find the start and end of the methods in the original file and replace them.
+
+# Find start of parse
+start_parse = content.find("    def parse(self, parser: \"Parser\")")
+# Find end of parse (it ends before _trim_whitespace)
+end_parse = content.find("    def _trim_whitespace", start_parse)
+
+# Find start of _make_node
+start_make_node = content.find("    def _make_node(", start_parse)
+# Find end of _make_node (it ends before the next method or end of class)
+# The next method is _extract, but I need to be careful.
+# Actually, _make_node is at the end of the class.
+# Let's find the end of _make_node by looking for the next method or end of file.
+# Wait, _make_node is not at the end of the class.
+# Let's look at the file structure again.
+
+# The file structure is:
+# ...
+#    def parse(...)
+#    def _trim_whitespace(...)
+#    def _parse_block(...)
+#    def _make_node(...)
+#    def _extract(...)
+
+# So I should replace `parse` and `_make_node` separately.
+
+# Let's extract the new methods from new_methods.py
+with open('new_methods.py', 'r') as f:
+    new_methods_content = f.read()
+
+# Split new_methods_content into parse and _make_node
+# This is a bit tricky. I'll just use regex.
+parse_method = re.search(r"(def parse\(.*?\n    def _make_node)", new_methods_content, re.DOTALL).group(1)[:-15]
+make_node_method = re.search(r"(def _make_node\(.*?\n    return nodes\.Output\(\[node\]\))", new_methods_content, re.DOTALL).group(1)
+
+# Replace parse
+# Find the end of parse
+# The original parse ends with:
+#        if plural_expr_assignment is not None:
+#            return [plural_expr_assignment, node]
+#        else:
+#            return node
+#
+#    def _trim_whitespace(...)
+
+# Let's find the end of parse by searching for the next method definition.
+end_parse = content.find("    def _trim_whitespace", start_parse)
+content = content[:start_parse] + parse_method + "\n\n" + content[end_parse:]
+
+# Replace _make_node
+# Find start of _make_node
+start_make_node = content.find("    def _make_node(", start_parse)
+# Find end of _make_node
+end_make_node = content.find("    def _extract", start_make_node)
+content = content[:start_make_node] + make_node_method + "\n\n" + content[end_make_node:]
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
