+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Update `_install_callables`
+for i, line in enumerate(lines):
+    if 'def _install_callables' in line:
+        start_install = i
+        break
+else:
+    print("Could not find _install_callables")
+    exit(1)
+
+for i in range(start_install, len(lines)):
+    if 'def _uninstall' in lines[i]:
+        end_install = i
+        break
+else:
+    print("Could not find _uninstall")
+    exit(1)
+
+new_install = [
+    "    def _install_callables(\n",
+    "        self,\n",
+    "        gettext: t.Callable[[str], str],\n",
+    "        ngettext: t.Callable[[str, str, int], str],\n",
+    "        newstyle: bool = False,\n",
+    "        dgettext: t.Optional[t.Callable[[str, str], str]] = None,\n",
+    "        dngettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,\n",
+    "    ) -> None:\n",
+    "        self.gettext = _make_new_gettext(gettext) if newstyle else gettext\n",
+    "        self.ngettext = _make_new_ngettext(ngettext) if newstyle else ngettext\n",
+    "        self.dgettext = _make_new_dgettext(dgettext) if newstyle else dgettext\n",
+    "        self.dngettext = _make_new_dngettext(dngettext) if newstyle else dngettext\n",
+    "        self.newstyle_gettext = newstyle\n",
+    "\n"
+]
+lines[start_install:end_install] = new_install
+
+# Update `_uninstall`
+for i, line in enumerate(lines):
+    if 'def _uninstall' in line:
+        start_uninstall = i
+        break
+else:
+    print("Could not find _uninstall")
+    exit(1)
+
+for i in range(start_uninstall, len(lines)):
+    if 'def parse' in lines[i]:
+        end_uninstall = i
+        break
+else:
+    print("Could not find parse")
+    exit(1)
+
+new_uninstall = [
+    "    def _uninstall(self) -> None:\n",
+    "        self.gettext = None\n",
+    "        self.ngettext = None\n",
+    "        self.dgettext = None\n",
+    "        self.dngettext = None\n",
+    "\n"
+]
+lines[start_uninstall:end_uninstall] = new_uninstall
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
