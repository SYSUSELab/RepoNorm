+import re
+from queue import Queue
+from dataclasses import dataclass
+from typing import Any
+
+# Mocking dependencies
+class ModelResponseStream:
+    def __init__(self, content):
+        self.choices = [type('obj', (object,), {'delta': type('obj', (object,), {'content': content})})]
+
+@dataclass
+class StreamResponse:
+    predict_name: str
+    signature_field_name: str
+    chunk: str
+    buffer_watermark: int = 0 # This will be added
+
+# Mocking StreamListener
+class StreamListener:
+    def __init__(self, signature_field_name: str, end_buffer_size: int = 10):
+        self.signature_field_name = signature_field_name
+        self.field_end_queue = Queue()
+        self.end_buffer_size = end_buffer_size
+        self.adapter_identifiers = {
+            "ChatAdapter": {
+                "end_identifier": re.compile(r"\[\[ ## (\w+) ## \]\]"),
+            }
+        }
+
+    def receive(self, chunk: ModelResponseStream):
+        chunk_message = chunk.choices[0].delta.content
+        self.field_end_queue.put(chunk_message)
+        
+        # Current logic uses hardcoded 10
+        if self.field_end_queue.qsize() > 10:
+            token = self.field_end_queue.get()
+        else:
+            token = None
+            
+        # This is where we need to add buffer_watermark
+        # The requirement says: min(current_queue_size, end_buffer_size)
+        # current_queue_size is captured after enqueued and before dequeues/flushes
+        
+        return StreamResponse("predict_name", self.signature_field_name, token or "")
+
+# Test
+listener = StreamListener("field", end_buffer_size=5)
+chunk = ModelResponseStream("test")
+response = listener.receive(chunk)
+print(f"Response: {response}")
