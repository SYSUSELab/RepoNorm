+def validate_end_buffer_size(end_buffer_size):
+    if not isinstance(end_buffer_size, int) or isinstance(end_buffer_size, bool):
+        raise ValueError("end_buffer_size must be an integer")
+    if end_buffer_size < 3:
+        raise ValueError("end_buffer_size must be at least 3")
+    if end_buffer_size > 64:
+        raise ValueError("end_buffer_size must be at most 64")
+    return True
+
+# Test cases
+try:
+    validate_end_buffer_size(True)
+except ValueError as e:
+    print(f"Bool test: {e}")
+
+try:
+    validate_end_buffer_size(2)
+except ValueError as e:
+    print(f"Below 3 test: {e}")
+
+try:
+    validate_end_buffer_size(65)
+except ValueError as e:
+    print(f"Above 64 test: {e}")
+
+try:
+    validate_end_buffer_size(10)
+    print("10 is valid")
+except ValueError as e:
+    print(f"10 test: {e}")
diff --git a/tests/streaming/test_buffer_watermark.py b/tests/streaming/test_buffer_watermark.py
new file mode 100644
index 00000000..25d4bc9e
--- /dev/null
+++ b/tests/streaming/test_buffer_watermark.py
@@ -0,0 +1,40 @@
+import pytest
+from unittest.mock import MagicMock
+from dspy.streaming.streaming_listener import StreamListener
+from dspy.streaming.messages import StreamResponse
+from queue import Queue
+
+def test_buffer_watermark():
+    listener = StreamListener(signature_field_name="answer", end_buffer_size=5)
+    listener.stream_start = True
+    
+    # Simulate receiving 10 chunks
+    for i in range(10):
+        chunk = MagicMock()
+        chunk.choices = [MagicMock()]
+        chunk.choices[0].delta.content = f"chunk{i}"
+        
+        response = listener.receive(chunk)
+        
+        # Expected watermark: min(i+1, 5)
+        expected_watermark = min(i + 1, 5)
+        assert response.buffer_watermark == expected_watermark
+        
+        # The first 5 chunks (i=0 to 4) should be empty because they are in the buffer.
+        # Wait, if end_buffer_size is 5, then the first 5 chunks are in the buffer.
+        # So for i=0, 1, 2, 3, 4, the chunk should be empty.
+        # For i=5, the chunk should be chunk0.
+        
+        if i < 5:
+            assert response.chunk == ""
+        else:
+            assert response.chunk == f"chunk{i-5}"
+
+def test_invalid_buffer_size():
+    with pytest.raises(ValueError, match="end_buffer_size must be an integer"):
+        StreamListener(signature_field_name="answer", end_buffer_size="10")
+    with pytest.raises(ValueError, match="end_buffer_size must be at least 3"):
+        StreamListener(signature_field_name="answer", end_buffer_size=2)
+    with pytest.raises(ValueError, match="end_buffer_size must be at most 64"):
+        StreamListener(signature_field_name="answer", end_buffer_size=65)
+
