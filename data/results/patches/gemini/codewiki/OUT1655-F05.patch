+import re
+import pytest
+from pydantic import BaseModel
+from outlines import types
+from outlines.types.dsl import to_regex
+
+@pytest.mark.parametrize(
+    "test_string,should_match",
+    [
+        ("2001:0db8:85a3:0000:0000:8a2e:0370:7334", True),
+        ("2001:db8:85a3:0:0:8a2e:370:7334", True),
+        ("ABCD:EF01:2345:6789:ABCD:EF01:2345:6789", True),
+        ("2001:db8::1", False),
+        ("::1", False),
+        ("2001:db8:85a3:0000:0000:8a2e:0370:7334:1234", False),
+        ("2001:db8:85a3:0000:0000:8a2e:0370", False),
+        ("2001:db8:85a3:00000:0000:8a2e:0370:7334", False),
+        ("2001:db8:85a3:0000:0000:8a2e:0370:733g", False),
+    ],
+)
+def test_ipv6_regex(test_string, should_match):
+    class Model(BaseModel):
+        attr: types.ipv6
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(types.ipv6)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
