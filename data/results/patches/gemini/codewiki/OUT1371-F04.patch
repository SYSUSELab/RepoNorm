+import json
+import textwrap
+import html
+import csv
+import io
+
+def get_builtin_filters():
+    return {
+        "upper": lambda v: str(v).upper(),
+        "lower": lambda v: str(v).lower(),
+        "title": lambda v: str(v).title(),
+        "reverse": lambda v: str(v)[::-1],
+        "truncate": lambda v, length, end="...": (str(v) if len(str(v)) <= length else str(v)[:length - len(end)] + end) if length >= 0 else (_ for _ in ()).throw(ValueError("Length must be non-negative")),
+        "pad_left": lambda v, width, fill=" ": str(v).rjust(width, fill) if len(fill) == 1 else (_ for _ in ()).throw(ValueError("Fill must be a single character")),
+        "pad_right": lambda v, width, fill=" ": str(v).ljust(width, fill) if len(fill) == 1 else (_ for _ in ()).throw(ValueError("Fill must be a single character")),
+        "add": lambda a, b: a + b,
+        "subtract": lambda a, b: a - b,
+        "multiply": lambda a, b: a * b,
+        "divide": lambda a, b: a / b,
+        "round": lambda v, ndigits=None: round(v, ndigits),
+        "abs": lambda v: abs(v),
+        "min": lambda v, *others: min(v, *others),
+        "max": lambda v, *others: max(v, *others),
+        "json": lambda v: json.dumps(v),
+        "csv": lambda v: (lambda output: (csv.writer(output, quoting=csv.QUOTE_MINIMAL, lineterminator='').writerow(v), output.getvalue())[1])(io.StringIO()),
+        "indent": lambda v, width=4: textwrap.indent(str(v), ' ' * width),
+        "wrap": lambda v, width=70: textwrap.fill(str(v), width=width),
+        "escape": lambda v: html.escape(str(v), quote=True),
+        "unescape": lambda v: html.unescape(str(v)),
+    }
