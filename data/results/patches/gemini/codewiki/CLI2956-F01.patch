             return t.cast("list[CompletionItem]", results)
 
+        if getattr(self, "auto_complete", False):
+            # Logic to determine strategy
+            strategy = self.auto_complete
+            if strategy is True:
+                # Determine from name
+                name = self.name or ""
+                tokens = name.split("_")
+                if any(t in ["user", "username", "owner", "author"] for t in tokens):
+                    strategy = "user"
+                elif any(t in ["branch", "ref", "revision"] for t in tokens):
+                    strategy = "branch"
+                elif any(t in ["env", "environment", "var"] for t in tokens):
+                    strategy = "environment"
+                elif any(t in ["file", "path", "input", "output"] for t in tokens):
+                    strategy = "file"
+                elif any(t in ["dir", "directory"] for t in tokens):
+                    strategy = "directory"
+                else:
+                    strategy = None
+            
+            if strategy:
+                from .shell_completion import CompletionItem
+                results = []
+                if strategy == "user":
+                    try:
+                        import pwd
+                        users = [u.pw_name for u in pwd.getpwall()]
+                        results = [u for u in users if not u.startswith("_") and u.startswith(incomplete)]
+                        results = sorted(list(set(results)))[:20]
+                    except (ImportError, OSError):
+                        pass
+                elif strategy == "branch":
+                    import subprocess
+                    try:
+                        result = subprocess.run(["git", "branch", "--list", f"{incomplete}*"], capture_output=True, text=True, check=True)
+                        results = [b.strip().lstrip("* ") for b in result.stdout.splitlines()]
+                        results = sorted(list(set(results)))[:20]
+                    except (subprocess.CalledProcessError, FileNotFoundError):
+                        pass
+                elif strategy == "environment":
+                    import os
+                    envs = list(os.environ.keys())
+                    results = [e for e in envs if e.startswith(incomplete)]
+                    results = sorted(list(set(results)))[:20]
+                elif strategy == "file":
+                    from pathlib import Path
+                    path = Path(incomplete)
+                    if incomplete.endswith(os.sep):
+                        parent = path
+                        prefix = ""
+                    else:
+                        parent = path.parent
+                        prefix = path.name
+                    if parent.exists():
+                        try:
+                            results = [str(p) for p in parent.iterdir() if p.name.startswith(prefix)]
+                            results = sorted(list(set(results)))
+                        except OSError:
+                            pass
+                elif strategy == "directory":
+                    from pathlib import Path
+                    path = Path(incomplete)
+                    if incomplete.endswith(os.sep):
+                        parent = path
+                        prefix = ""
+                    else:
+                        parent = path.parent
+                        prefix = path.name
+                    if parent.exists():
+                        try:
+                            results = [str(p) for p in parent.iterdir() if p.is_dir() and p.name.startswith(prefix)]
+                            results = sorted(list(set(results)))
+                        except OSError:
+                            pass
+                
+                if results:
+                    return [CompletionItem(c, type=strategy if strategy in ["file", "directory"] else None) for c in results]
         return self.type.shell_complete(ctx, self, incomplete)
 
 
