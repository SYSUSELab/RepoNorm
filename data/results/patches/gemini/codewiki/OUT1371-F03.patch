+print(f"Custom + Standard (Active): {select_condition({'my_condition': {}, 'debug': {}})}")
+# Expected: 'debug'
+
+# What if I have a custom condition AND a standard condition, and the standard condition is NOT active,
+# but the custom condition is alphabetically first?
+# Mapping: {'a_custom': {}, 'debug': {}}
+# Active: None.
+# 'debug' is a standard condition, but not active.
+# 'a_custom' is not a standard condition.
+# So no active standard conditions are in the mapping.
+# So we should fall back to alphabetically first: 'a_custom' (because 'a_custom' < 'debug').
+os.environ.clear()
+print(f"Custom + Standard (Alphabetical): {select_condition({'a_custom': {}, 'debug': {}})}")
+# Expected: 'a_custom'
