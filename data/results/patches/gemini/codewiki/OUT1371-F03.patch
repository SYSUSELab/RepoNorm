+++ b/fix_prompts.py
@@ -0,0 +1,20 @@
+import re
+
+with open("outlines/prompts.py", "r") as f:
+    content = f.read()
+
+# Move the docstring to the right place
+# The docstring starts at line 186
+# The function definition starts at line 173
+# I want to move the docstring to before line 173
+
+# Find the docstring
+docstring_match = re.search(r'    """Decorate a function that contains a prompt template\..*?templates\.\n    """', content, re.DOTALL)
+if docstring_match:
+    docstring = docstring_match.group(0)
+    content = content.replace(docstring, "")
+    # Insert it before the function definition
+    content = content.replace("def prompt(fn: Callable = None, *, conditional_filters: Optional[Mapping] = None) -> Prompt:", docstring + "\ndef prompt(fn: Callable = None, *, conditional_filters: Optional[Mapping] = None) -> Prompt:")
+
+with open("outlines/prompts.py", "w") as f:
+    f.write(content)
