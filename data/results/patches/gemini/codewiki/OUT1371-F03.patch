@@ -0,0 +1,164 @@
+import os
+
+# Read the original file
+with open("outlines/prompts.py", "r") as f:
+    lines = f.readlines()
+
+# Insert the helper functions
+# Find the imports and insert after them
+insert_pos = 0
+for i, line in enumerate(lines):
+    if line.startswith("import"):
+        insert_pos = i + 1
+    elif line.startswith("from"):
+        insert_pos = i + 1
+
+# Add the helper functions
+helper_code = """
+def get_active_conditions():
+    conditions = []
+    if os.environ.get("OUTLINES_DEBUG", "").lower() == "true":
+        conditions.append("debug")
+    if os.environ.get("ENVIRONMENT", "").lower() == "production":
+        conditions.append("production")
+    if (
+        os.environ.get("ENV", "").lower() == "testing" or
+        os.environ.get("OUTLINES_TESTING", "").lower() == "true" or
+        os.environ.get("TESTING_MODE", "").lower() == "on"
+    ):
+        conditions.append("testing")
+    return conditions
+
+def select_condition(conditional_filters: Optional[Mapping[str, Mapping[str, callable]]]) -> Optional[str]:
+    if not conditional_filters:
+        return None
+    
+    active = get_active_conditions()
+    
+    # Priority: debug, then production, then testing.
+    priority = ["debug", "production", "testing"]
+    
+    # "When more than one available condition is active, priority is debug, then production, then testing."
+    # "An active standard condition absent from the supplied mapping is skipped."
+    
+    # This means we should filter the active conditions to only those present in the mapping.
+    active_in_mapping = [p for p in priority if p in active and p in conditional_filters]
+    
+    if active_in_mapping:
+        return active_in_mapping[0]
+            
+    # If none of those conditions both matches and exists, select the alphabetically first supplied condition key.
+    available_keys = sorted(conditional_filters.keys())
+    if available_keys:
+        return available_keys[0]
+    
+    return None
+"""
+lines.insert(insert_pos, helper_code)
+
+# Update _template_from_str to accept conditional_filters
+# Find _template_from_str definition
+for i, line in enumerate(lines):
+    if "def _template_from_str" in line:
+        # Change signature
+        lines[i] = line.replace("(_, content: str) -> jinja2.Template:", "(_, content: str, conditional_filters: Optional[Mapping] = None) -> jinja2.Template:")
+        
+        # Find where env is created and add filters
+        for j in range(i, i + 20):
+            if "env = jinja2.Environment(" in lines[j]:
+                # Insert filter logic after env creation
+                # Find where filters are added
+                for k in range(j, j + 20):
+                    if 'env.filters["args"] = get_fn_args' in lines[k]:
+                        # Insert conditional filters logic
+                        insert_pos_filters = k + 1
+                        lines.insert(insert_pos_filters, """
+        selected_condition = select_condition(conditional_filters)
+        if selected_condition and conditional_filters:
+            for name, filter_fn in conditional_filters[selected_condition].items():
+                env.filters[name] = filter_fn
+""")
+                        break
+                break
+        break
+
+# Update _template_from_file to accept conditional_filters
+for i, line in enumerate(lines):
+    if "def _template_from_file" in line:
+        # Change signature
+        lines[i] = line.replace("(_, path: Path) -> jinja2.Template:", "(_, path: Path, conditional_filters: Optional[Mapping] = None) -> jinja2.Template:")
+        
+        # Find where env is created and add filters
+        for j in range(i, i + 20):
+            if "env = jinja2.Environment(" in lines[j]:
+                # Insert filter logic after env creation
+                # Find where env is returned
+                for k in range(j, j + 20):
+                    if "return env.get_template" in lines[k]:
+                        # Insert conditional filters logic
+                        insert_pos_filters = k
+                        lines.insert(insert_pos_filters, """
+        selected_condition = select_condition(conditional_filters)
+        if selected_condition and conditional_filters:
+            for name, filter_fn in conditional_filters[selected_condition].items():
+                env.filters[name] = filter_fn
+""")
+                        break
+                break
+        break
+
+# Update Prompt.from_str
+for i, line in enumerate(lines):
+    if "def from_str(cls, content: str):" in line:
+        lines[i] = line.replace("content: str):", "content: str, conditional_filters: Optional[Mapping] = None):")
+        # Update call to _template_from_str
+        for j in range(i, i + 5):
+            if "return cls(cls._template_from_str(content), None)" in lines[j]:
+                lines[j] = lines[j].replace("_template_from_str(content)", "_template_from_str(content, conditional_filters)")
+                break
+        break
+
+# Update Prompt.from_file
+for i, line in enumerate(lines):
+    if "def from_file(cls, path: Path):" in line:
+        lines[i] = line.replace("path: Path):", "path: Path, conditional_filters: Optional[Mapping] = None):")
+        # Update call to _template_from_file
+        for j in range(i, i + 5):
+            if "return cls(cls._template_from_file(path), None)" in lines[j]:
+                lines[j] = lines[j].replace("_template_from_file(path)", "_template_from_file(path, conditional_filters)")
+                break
+        break
+
+# Update prompt decorator
+for i, line in enumerate(lines):
+    if "def prompt(fn: Callable) -> Prompt:" in line:
+        # Change signature
+        lines[i] = "def prompt(fn: Callable = None, *, conditional_filters: Optional[Mapping] = None) -> Prompt:\n"
+        # Add logic to handle decorator with or without arguments
+        lines.insert(i + 1, """
+    def decorator(fn: Callable) -> Prompt:
+        signature = inspect.signature(fn)
+        docstring = fn.__doc__
+        if docstring is None:
+            raise TypeError("Could not find a template in the function's docstring.")
+        template = Prompt._template_from_str(cast(str, docstring), conditional_filters)
+        return Prompt(template, signature)
+
+    if fn is None:
+        return decorator
+    return decorator(fn)
+""")
+        # Remove the old implementation
+        for j in range(i + 2, i + 20):
+            if "signature = inspect.signature(fn)" in lines[j]:
+                # Remove lines until the end of the function
+                # The function ends before get_fn_name
+                for k in range(j, len(lines)):
+                    if "def get_fn_name" in lines[k]:
+                        del lines[i+2:k]
+                        break
+                break
+        break
+
+with open("outlines/prompts.py", "w") as f:
+    f.writelines(lines)
