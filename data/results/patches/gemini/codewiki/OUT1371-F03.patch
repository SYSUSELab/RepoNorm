+import os
+
+def get_active_condition():
+    # 1. OUTLINES_DEBUG=true activates debug.
+    # 2. ENVIRONMENT=production activates production.
+    # 3. ENV=testing, OUTLINES_TESTING=true, or TESTING_MODE=on activates testing.
+    
+    # Priority: debug, then production, then testing.
+    
+    debug = os.environ.get("OUTLINES_DEBUG", "").lower() == "true"
+    production = os.environ.get("ENVIRONMENT", "").lower() == "production"
+    testing = (
+        os.environ.get("ENV", "").lower() == "testing" or
+        os.environ.get("OUTLINES_TESTING", "").lower() == "true" or
+        os.environ.get("TESTING_MODE", "").lower() == "on"
+    )
+    
+    if debug:
+        return "debug"
+    if production:
+        return "production"
+    if testing:
+        return "testing"
+    return None
+
+# Test cases
+os.environ["OUTLINES_DEBUG"] = "true"
+print(f"DEBUG=true: {get_active_condition()}")
+
+del os.environ["OUTLINES_DEBUG"]
+os.environ["ENVIRONMENT"] = "production"
+print(f"ENVIRONMENT=production: {get_active_condition()}")
+
+del os.environ["ENVIRONMENT"]
+os.environ["ENV"] = "testing"
+print(f"ENV=testing: {get_active_condition()}")
+
+del os.environ["ENV"]
+os.environ["OUTLINES_TESTING"] = "true"
+print(f"OUTLINES_TESTING=true: {get_active_condition()}")
+
+del os.environ["OUTLINES_TESTING"]
+os.environ["TESTING_MODE"] = "on"
+print(f"TESTING_MODE=on: {get_active_condition()}")
+
+del os.environ["TESTING_MODE"]
+print(f"None: {get_active_condition()}")
+
+# Priority test
+os.environ["OUTLINES_DEBUG"] = "true"
+os.environ["ENVIRONMENT"] = "production"
+print(f"DEBUG+PROD: {get_active_condition()}")
