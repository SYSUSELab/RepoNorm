 from .exceptions import TemplateNotFound
+
+def validate_template_path(template: str) -> None:
+    """Validate a template path.
+
+    :param template: The template path to validate.
+    :raises TemplateNotFound: If the path is invalid.
+    """
+    if template is None or not template:
+        raise TemplateNotFound(template)
+    if "\0" in template:
+        raise TemplateNotFound(template)
+    if template.startswith(("/", "\\")):
+        raise TemplateNotFound(template)
+    if len(template) >= 2 and template[1] == ":" and template[0].isalpha():
+        raise TemplateNotFound(template)
+    for char in template:
+        if ord(char) < 32 and char not in ("\t", "\n", "\r"):
+            raise TemplateNotFound(template)
