--- /dev/null
+++ b/test_final_regex.py
@@ -0,0 +1,20 @@
+import re
+url_pattern = r"https?://(?:localhost|(?:(?:0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(?:\.(?:0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){3})|(?:(?=[a-zA-Z0-9-]{1,63})(?=.*[a-zA-Z])[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.(?=[a-zA-Z0-9-]{1,63})(?=.*[a-zA-Z])[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+))(?::[0-9]{1,5})?(?:/[^ \t\r\n]*)?(?:\?[^ \t\r\n]+)?(?:#[^ \t\r\n]+)?"
+test_cases = [
+    ("http://localhost", True),
+    ("https://example.com", True),
+    ("http://192.168.1.1", True),
+    ("http://192.168.1.256", False),
+    ("http://example.com:8080", True),
+    ("http://example.com/path/to/resource", True),
+    ("http://example.com?query=1", True),
+    ("http://example.com#fragment", True),
+    ("http://example.com/path?query=1#fragment", True),
+    ("http://invalid-host", False), # Needs at least two labels
+    ("http://-invalid.com", False),
+    ("http://invalid-.com", False),
+]
+for url, expected in test_cases:
+    match = bool(re.fullmatch(url_pattern, url))
+    print(f"{url}: {match} (expected {expected})")
+    assert match == expected
diff --git a/test_url_regex.py b/test_url_regex.py
new file mode 100644
index 0000000..02fad62
--- /dev/null
+++ b/test_url_regex.py
@@ -0,0 +1,38 @@
+import re
+
+# Let's test the full URL regex again.
+octet = r"(?:0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])"
+ipv4 = rf"{octet}(?:\.{octet}){{3}}"
+# DNS label:
+# - Start and end with alphanumeric
+# - Length 1-63
+# - Contain at least one letter (to avoid matching IPv4 addresses)
+dns_label = r"(?=[a-zA-Z0-9-]{1,63})(?=.*[a-zA-Z])[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?"
+dns_name = rf"{dns_label}(?:\.{dns_label})+"
+host = rf"(?:localhost|{ipv4}|{dns_name})"
+port = r"(?::[0-9]{1,5})?"
+path = r"(?:/[^ \t\r\n]*)?"
+query = r"(?:\?[^ \t\r\n]+)?"
+fragment = r"(?:#[^ \t\r\n]+)?"
+url_pattern = rf"https?://{host}{port}{path}{query}{fragment}"
+
+# Test cases
+test_cases = [
+    ("http://localhost", True),
+    ("https://example.com", True),
+    ("http://192.168.1.1", True),
+    ("http://192.168.1.256", False),
+    ("http://example.com:8080", True),
+    ("http://example.com/path/to/resource", True),
+    ("http://example.com?query=1", True),
+    ("http://example.com#fragment", True),
+    ("http://example.com/path?query=1#fragment", True),
+    ("http://invalid-host", False), # Needs at least two labels
+    ("http://-invalid.com", False),
+    ("http://invalid-.com", False),
+]
+
+for url, expected in test_cases:
+    match = bool(re.fullmatch(url_pattern, url))
+    print(f"{url}: {match} (expected {expected})")
+    assert match == expected
