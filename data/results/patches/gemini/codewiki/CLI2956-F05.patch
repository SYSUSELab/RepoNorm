+++ b/reproduce_issue.py
@@ -0,0 +1,25 @@
+import click
+import time
+
+# Define a custom type that is slow to convert
+class SlowType(click.ParamType):
+    name = "slow"
+    def convert(self, value, param, ctx):
+        time.sleep(0.1)
+        return int(value) * 2
+
+@click.command()
+@click.option("--val", type=SlowType(), cache=True)
+def cli(val):
+    click.echo(f"Value: {val}")
+
+if __name__ == "__main__":
+    start = time.time()
+    # This should be slow
+    cli.main(args=["--val", "10"], standalone_mode=False)
+    print(f"First call took: {time.time() - start:.2f}s")
+    
+    start = time.time()
+    # This should be fast if caching works
+    cli.main(args=["--val", "10"], standalone_mode=False)
+    print(f"Second call took: {time.time() - start:.2f}s")
