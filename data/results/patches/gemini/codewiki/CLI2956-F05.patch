index 0000000..e4c25e8
--- /dev/null
+++ b/tests/test_option_cache.py
@@ -0,0 +1,127 @@
+import click
+import pytest
+
+def test_option_cache():
+    class CachedType(click.ParamType):
+        name = "cached"
+        def __init__(self):
+            self.convert_count = 0
+        def convert(self, value, param, ctx):
+            self.convert_count += 1
+            return int(value)
+            
+    cached_type = CachedType()
+    
+    @click.command()
+    @click.option("--val", type=cached_type, cache=True)
+    def cmd2(val):
+        pass
+        
+    cmd2.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 1
+    
+    cmd2.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 1 # Should be cached!
+    
+    cmd2.main(args=["--val", "20"], standalone_mode=False)
+    assert cached_type.convert_count == 2 # New value, should not be cached
+    
+    cmd2.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 2 # Cached again!
+
+def test_option_cache_disabled():
+    class CachedType(click.ParamType):
+        name = "cached"
+        def __init__(self):
+            self.convert_count = 0
+        def convert(self, value, param, ctx):
+            self.convert_count += 1
+            return int(value)
+            
+    cached_type = CachedType()
+    
+    @click.command()
+    @click.option("--val", type=cached_type, cache=False)
+    def cmd3(val):
+        pass
+        
+    cmd3.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 1
+    
+    cmd3.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 2 # Not cached!
+
+def test_clear_value_cache():
+    class CachedType(click.ParamType):
+        name = "cached"
+        def __init__(self):
+            self.convert_count = 0
+        def convert(self, value, param, ctx):
+            self.convert_count += 1
+            return int(value)
+            
+    cached_type = CachedType()
+    
+    @click.command()
+    @click.option("--val", type=cached_type, cache=True)
+    def cmd4(val):
+        pass
+        
+    cmd4.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 1
+    
+    cmd4.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 1
+    
+    # Clear cache
+    cmd4.params[0].clear_value_cache()
+    
+    cmd4.main(args=["--val", "10"], standalone_mode=False)
+    assert cached_type.convert_count == 2
+
+def test_option_cache_edge_cases():
+    # Test multiple=True
+    class CounterType(click.ParamType):
+        def convert(self, value, param, ctx):
+            self.convert_count += 1
+            return value
+    
+    counter = CounterType()
+    counter.convert_count = 0
+    
+    @click.command()
+    @click.option("--val", type=counter, cache=True, multiple=True)
+    def cmd_multiple(val):
+        pass
+        
+    cmd_multiple.main(args=["--val", "10", "--val", "10"], standalone_mode=False)
