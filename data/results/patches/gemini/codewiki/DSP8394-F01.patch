--- /dev/null
+++ b/tests/caching/test_bypass.py
@@ -0,0 +1,39 @@
+import dspy
+from dspy.clients.cache import Cache
+from dspy.clients.cache import request_cache
+import pytest
+
+def test_cache_bypass():
+    # Setup a dummy cache
+    cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+    dspy.cache = cache
+
+    @request_cache()
+    def my_function(x):
+        return x * 2
+
+    # 1. Normal caching
+    assert my_function(10) == 20
+    
+    # 2. Bypass
+    with dspy.cache.bypass():
+        # This should recompute
+        assert my_function(10) == 20
+        
+    # 3. Normal read
+    assert my_function(10) == 20
+
+def test_cache_bypass_nested():
+    cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+    dspy.cache = cache
+
+    @request_cache()
+    def my_function(x):
+        return x * 2
+
+    with dspy.cache.bypass():
+        with dspy.cache.bypass():
+            assert my_function(10) == 20
+        assert my_function(10) == 20
+    assert my_function(10) == 20
+
