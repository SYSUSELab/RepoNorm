diff --git a/tests/streaming/test_listener_callback.py b/tests/streaming/test_listener_callback.py
new file mode 100644
index 00000000..525faa0e
--- /dev/null
+++ b/tests/streaming/test_listener_callback.py
@@ -0,0 +1,48 @@
+from dspy.streaming.streaming_listener import StreamListener
+from dspy.streaming.messages import StreamResponse
+from unittest.mock import MagicMock
+import pytest
+
+def test_on_chunk_callback():
+    # Mocking the necessary components
+    mock_chunk = MagicMock()
+    mock_chunk.choices = [MagicMock()]
+    
+    # Create a listener with a callback
+    callback_called = False
+    def on_chunk_callback(response: StreamResponse):
+        nonlocal callback_called
+        callback_called = True
+        assert isinstance(response, StreamResponse)
+        assert response.chunk == "test"
+
+    listener = StreamListener(signature_field_name="answer", on_chunk=on_chunk_callback)
+    
+    # Simulate stream start
+    listener.stream_start = True
+    
+    # Send 11 chunks
+    for i in range(11):
+        mock_chunk.choices[0].delta.content = "test"
+        listener.receive(mock_chunk)
+    
+    assert callback_called, "Callback was not called"
+
+def test_on_chunk_callback_not_called_if_no_response():
+    # Mocking the necessary components
+    mock_chunk = MagicMock()
+    mock_chunk.choices = [MagicMock()]
+    
+    # Create a listener with a callback
+    callback_called = False
+    def on_chunk_callback(response: StreamResponse):
+        nonlocal callback_called
+        callback_called = True
+
+    listener = StreamListener(signature_field_name="answer", on_chunk=on_chunk_callback)
+    
+    # Send a chunk that doesn't trigger a response
+    mock_chunk.choices[0].delta.content = None
+    listener.receive(mock_chunk)
+    
+    assert not callback_called, "Callback was called"
