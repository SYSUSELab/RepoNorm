+def limit_description(description, cap):
+    if cap is None:
+        return description
+    if not isinstance(cap, int) or isinstance(cap, bool) or cap <= 0:
+        raise ValueError("cap must be a positive, non-boolean integer or None")
+    
+    if len(description) <= cap:
+        return description
+    
+    if cap == 1:
+        return "…"
+    
+    # Regex to find sentence endings: [.!?](?:\s+|$)
+    pattern = re.compile(r'[.!?](?:\s+|$)')
+    matches = list(pattern.finditer(description))
+    
+    best_match = None
+    for match in reversed(matches):
+        if match.end() <= cap - 1:
+            best_match = match
+            break
+            
+    if best_match:
+        result = description[:best_match.end()].rstrip()
+        return result + "…"
+    else:
+        # Hard prefix
+        result = description[:cap-1].rstrip()
+        return result + "…"
