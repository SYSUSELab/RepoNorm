index 00000000..ceb1c979
--- /dev/null
+++ b/edit_cache_v4.py
@@ -0,0 +1,37 @@
+import re
+
+with open("dspy/clients/cache.py", "r") as f:
+    content = f.read()
+
+# Add _cache_usage_tracker to __init__
+content = re.sub(
+    r"(self._stats = {'hits': 0, 'mem_hits': 0, 'disk_hits': 0, 'misses': 0})",
+    r"\1\n        self._cache_usage_tracker = None",
+    content
+)
+
+# Update get() to track usage if enabled
+# We need to import settings to check track_usage
+# Actually, we can just check dspy.settings.context(track_usage=True)
+# The requirement says: "When dspy.settings.context(track_usage=True) is active..."
+# Let's look at how to check this.
+# dspy.settings.context(track_usage=True) sets settings.track_usage = True.
+# Let's check dspy/dsp/utils/settings.py
+
+# Wait, the requirement says: "each synchronous Module call or asynchronous acall that returns a Prediction attaches an independent cache usage snapshot"
+# This means the tracking should happen in the Module call, not in the Cache.get() method itself.
+# But the Cache.get() method needs to return the usage snapshot.
+# "each synchronous Module call or asynchronous acall that returns a Prediction attaches an independent cache usage snapshot available through Prediction.get_cache_usage()"
+
+# So, the Cache.get() should return the usage snapshot, and the Module call should attach it to the Prediction.
+# Let's re-read: "each synchronous Module call or asynchronous acall that returns a Prediction attaches an independent cache usage snapshot available through Prediction.get_cache_usage()"
+# "Nested calls each capture their own events; the enclosing call includes its nested calls' events."
+
+# This sounds like the Cache.get() should return the usage snapshot, and the caller (Module) should handle it.
+# But the Cache.get() is called by the decorator `request_cache`.
+# Let's look at `request_cache` in `dspy/clients/cache.py`.
+
+# The `request_cache` decorator calls `cache.get()`.
+# If `cache.get()` returns a result, it returns it.
+# We need to modify `request_cache` to attach the cache usage to the result if it's a Prediction.
+
