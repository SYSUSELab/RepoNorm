+++ b/edit_cache_v5.py
@@ -0,0 +1,110 @@
+with open("dspy/clients/cache.py", "r") as f:
+    content = f.read()
+
+# We need to import dspy inside the wrappers, which is already done.
+# We need to check if track_usage is active.
+# dspy.settings.track_usage is the flag.
+
+# Let's modify sync_wrapper and async_wrapper in request_cache.
+
+# sync_wrapper:
+# ...
+# cached_result = cache.get(modified_request, ignored_args_for_cache_key)
+# if cached_result is not None:
+#     # If track_usage is active, attach cache usage
+#     return cached_result
+# ...
+
+# We need to define what "cache usage" is.
+# "Cache usage snapshot" - probably a dict with hits/misses for this call.
+# Since it's a cache hit, it's 1 hit.
+
+# Let's modify sync_wrapper
+sync_wrapper_old = """        @wraps(fn)
+        def sync_wrapper(*args, **kwargs):
+            import dspy
+
+            cache = dspy.cache
+            modified_request = process_request(args, kwargs)
+
+            # Retrieve from cache if available
+            cached_result = cache.get(modified_request, ignored_args_for_cache_key)
+
+            if cached_result is not None:
+                return cached_result
+
+            # Otherwise, compute and store the result
+            result = fn(*args, **kwargs)
+            # `enable_memory_cache` can be provided at call time to avoid indefinite growth.
+            cache.put(modified_request, result, ignored_args_for_cache_key, enable_memory_cache)
+
+            return result"""
+
+sync_wrapper_new = """        @wraps(fn)
+        def sync_wrapper(*args, **kwargs):
+            import dspy
+
+            cache = dspy.cache
+            modified_request = process_request(args, kwargs)
+
+            # Retrieve from cache if available
+            cached_result = cache.get(modified_request, ignored_args_for_cache_key)
+
+            if cached_result is not None:
+                if dspy.settings.track_usage and hasattr(cached_result, "set_cache_usage"):
+                    # Cache hit: 1 hit, 0 misses
+                    cached_result.set_cache_usage({"hits": 1, "mem_hits": 1 if cache.enable_memory_cache else 0, "disk_hits": 1 if not cache.enable_memory_cache else 0, "misses": 0})
+                return cached_result
+
+            # Otherwise, compute and store the result
+            result = fn(*args, **kwargs)
+            # `enable_memory_cache` can be provided at call time to avoid indefinite growth.
+            cache.put(modified_request, result, ignored_args_for_cache_key, enable_memory_cache)
+
+            return result"""
+
+# Similarly for async_wrapper
+async_wrapper_old = """        @wraps(fn)
+        async def async_wrapper(*args, **kwargs):
+            import dspy
+
+            cache = dspy.cache
+            modified_request = process_request(args, kwargs)
+
+            # Retrieve from cache if available
+            cached_result = cache.get(modified_request, ignored_args_for_cache_key)
+            if cached_result is not None:
+                return cached_result
+
+            # Otherwise, compute and store the result
+            result = await fn(*args, **kwargs)
+            cache.put(modified_request, result, ignored_args_for_cache_key, enable_memory_cache)
+
+            return result"""
+
+async_wrapper_new = """        @wraps(fn)
+        async def async_wrapper(*args, **kwargs):
+            import dspy
+
+            cache = dspy.cache
+            modified_request = process_request(args, kwargs)
+
+            # Retrieve from cache if available
+            cached_result = cache.get(modified_request, ignored_args_for_cache_key)
+            if cached_result is not None:
+                if dspy.settings.track_usage and hasattr(cached_result, "set_cache_usage"):
+                    # Cache hit: 1 hit, 0 misses
+                    cached_result.set_cache_usage({"hits": 1, "mem_hits": 1 if cache.enable_memory_cache else 0, "disk_hits": 1 if not cache.enable_memory_cache else 0, "misses": 0})
+                return cached_result
+
+            # Otherwise, compute and store the result
+            result = await fn(*args, **kwargs)
+            cache.put(modified_request, result, ignored_args_for_cache_key, enable_memory_cache)
+
+            return result"""
+
+content = content.replace(sync_wrapper_old, sync_wrapper_new)
+content = content.replace(async_wrapper_old, async_wrapper_new)
+
+with open("dspy/clients/cache.py", "w") as f:
+    f.write(content)
