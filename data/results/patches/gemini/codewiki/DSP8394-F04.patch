+++ b/edit_cache_v2.py
@@ -0,0 +1,117 @@
+import re
+
+with open("dspy/clients/cache.py", "r") as f:
+    content = f.read()
+
+# Add _stats to __init__
+content = re.sub(
+    r"(self._lock = threading.RLock\(\))",
+    r"\1\n        self._stats = {'hits': 0, 'mem_hits': 0, 'disk_hits': 0, 'misses': 0}",
+    content
+)
+
+# Add stats() and reset_stats()
+new_methods = """
+    def stats(self) -> Dict[str, int]:
+        with self._lock:
+            return self._stats.copy()
+
+    def reset_stats(self) -> None:
+        with self._lock:
+            self._stats = {'hits': 0, 'mem_hits': 0, 'disk_hits': 0, 'misses': 0}
+"""
+content = re.sub(
+    r"(    def __contains__\(self, key: str\) -> bool:)",
+    new_methods + r"\n\1",
+    content
+)
+
+# Update get() to record stats
+# We need to be careful with the logic here.
+# The requirement: "Each get records exactly one outcome: memory hit, disk hit, or miss, including failed key generation."
+# "hits equals mem_hits plus disk_hits."
+# "Writes do not count as reads; disk-to-memory promotion does not count as an extra hit."
+
+# Current get():
+# 1. key generation (if fails, return None) -> This is a miss.
+# 2. if memory hit -> mem_hit
+# 3. elif disk hit -> disk_hit
+# 4. else -> miss
+
+# Let's modify get()
+get_method_pattern = r"""    def get\(self, request: Dict\[str, Any\], ignored_args_for_cache_key: Optional\[list\[str\]\] = None\) -> Any:
+        try:
+            key = self.cache_key\(request, ignored_args_for_cache_key\)
+        except Exception:
+            logger.debug\(f"Failed to generate cache key for request: {request}"\)
+            return None
+
+        if self.enable_memory_cache and key in self.memory_cache:
+            with self._lock:
+                response = self.memory_cache\[key\]
+        elif self.enable_disk_cache and key in self.disk_cache:
+            # Found on disk but not in memory cache, add to memory cache
+            response = self.disk_cache\[key\]
+            if self.enable_memory_cache:
+                with self._lock:
+                    self.memory_cache\[key\] = response
+        else:
+            return None
+
+        response = copy.deepcopy\(response\)
+        if hasattr\(response, "usage"\):
+            # Clear the usage data when cache is hit, because no LM call is made
+            response.usage = {}
+        return response"""
+
+new_get_method = """    def get(self, request: Dict[str, Any], ignored_args_for_cache_key: Optional[list[str]] = None) -> Any:
+        try:
+            key = self.cache_key(request, ignored_args_for_cache_key)
+        except Exception:
+            logger.debug(f"Failed to generate cache key for request: {request}")
+            with self._lock:
+                self._stats['misses'] += 1
+            return None
+
+        response = None
+        is_hit = False
+        is_mem_hit = False
+        is_disk_hit = False
+
+        if self.enable_memory_cache and key in self.memory_cache:
+            with self._lock:
+                response = self.memory_cache[key]
+                is_hit = True
+                is_mem_hit = True
+        elif self.enable_disk_cache and key in self.disk_cache:
+            # Found on disk but not in memory cache, add to memory cache
+            response = self.disk_cache[key]
+            if self.enable_memory_cache:
+                with self._lock:
+                    self.memory_cache[key] = response
+            is_hit = True
+            is_disk_hit = True
+        
+        with self._lock:
+            if is_hit:
+                self._stats['hits'] += 1
+                if is_mem_hit:
+                    self._stats['mem_hits'] += 1
+                if is_disk_hit:
+                    self._stats['disk_hits'] += 1
+            else:
+                self._stats['misses'] += 1
+
+        if not is_hit:
+            return None
+
+        response = copy.deepcopy(response)
+        if hasattr(response, "usage"):
+            # Clear the usage data when cache is hit, because no LM call is made
+            response.usage = {}
+        return response"""
+
+content = content.replace(get_method_pattern, new_get_method)
+
+with open("dspy/clients/cache.py", "w") as f:
+    f.write(content)
