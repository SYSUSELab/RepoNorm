+import dspy
+from dspy.clients.cache import Cache
+from dspy.primitives.prediction import Prediction
+import unittest
+
+class TestCacheFinal(unittest.TestCase):
+    def test_cache_stats(self):
+        cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+        
+        # Add to cache
+        request = {"prompt": "hello"}
+        value = Prediction(text="world")
+        cache.put(request, value)
+        
+        # Get from cache (hit)
+        result = cache.get(request)
+        self.assertEqual(result.text, "world")
+        
+        # Check stats
+        stats = cache.stats()
+        self.assertEqual(stats["hits"], 1)
+        self.assertEqual(stats["mem_hits"], 1)
+        self.assertEqual(stats["misses"], 0)
+        
+        # Reset stats
+        cache.reset_stats()
+        stats = cache.stats()
+        self.assertEqual(stats["hits"], 0)
+        
+    def test_usage_tracking(self):
+        # Enable usage tracking
+        dspy.settings.configure(track_usage=True)
+        
+        cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+        
+        # Add to cache
+        request = {"prompt": "hello"}
+        value = Prediction(text="world")
+        cache.put(request, value)
+        
+        # We need to simulate the request_cache decorator behavior
+        # The decorator calls cache.get() and then sets cache usage if track_usage is True
+        
+        cached_result = cache.get(request)
+        if dspy.settings.track_usage and hasattr(cached_result, "set_cache_usage"):
+            cached_result.set_cache_usage({"hits": 1, "mem_hits": 1, "disk_hits": 0, "misses": 0})
+            
+        self.assertIsNotNone(cached_result.get_cache_usage())
+        self.assertEqual(cached_result.get_cache_usage()["hits"], 1)
+
+if __name__ == "__main__":
+    unittest.main()
