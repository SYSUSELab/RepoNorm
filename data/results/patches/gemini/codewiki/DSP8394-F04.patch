+import dspy
+from dspy.clients.cache import Cache
+import threading
+
+def test_cache_stats():
+    # Initialize Cache
+    cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+    
+    # Add to cache
+    request = {"prompt": "hello"}
+    value = "world"
+    cache.put(request, value)
+    
+    # Get from cache (hit)
+    result = cache.get(request)
+    print(f"Result: {result}")
+    
+    # Check stats after hit
+    stats = cache.stats()
+    print(f"Stats: {stats}")
+    
+    # Get from cache (miss)
+    result = cache.get({"prompt": "unknown"})
+    print(f"Result: {result}")
+    
+    # Check stats after miss
+    stats = cache.stats()
+    print(f"Stats: {stats}")
+
+if __name__ == "__main__":
+    test_cache_stats()
