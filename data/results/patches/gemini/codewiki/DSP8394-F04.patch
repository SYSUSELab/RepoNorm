+++ b/reproduce_cache_stats.py
@@ -0,0 +1,54 @@
+import dspy
+from dspy.clients.cache import Cache
+import threading
+
+def test_cache_stats():
+    # Initialize Cache
+    cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+    
+    # Check if stats() and reset_stats() exist
+    assert hasattr(cache, "stats"), "Cache should have stats() method"
+    assert hasattr(cache, "reset_stats"), "Cache should have reset_stats() method"
+    
+    # Check initial stats
+    stats = cache.stats()
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}, f"Initial stats incorrect: {stats}"
+    
+    # Add to cache
+    request = {"prompt": "hello"}
+    value = "world"
+    cache.put(request, value)
+    
+    # Get from cache (hit)
+    result = cache.get(request)
+    assert result == value
+    
+    # Check stats after hit
+    stats = cache.stats()
+    assert stats["hits"] == 1
+    assert stats["mem_hits"] == 1
+    assert stats["misses"] == 0
+    
+    # Get from cache (miss)
+    result = cache.get({"prompt": "unknown"})
+    assert result is None
+    
+    # Check stats after miss
+    stats = cache.stats()
+    assert stats["hits"] == 1
+    assert stats["misses"] == 1
+    
+    # Reset stats
+    cache.reset_stats()
+    stats = cache.stats()
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+    
+    print("Cache stats test passed!")
+
+if __name__ == "__main__":
+    try:
