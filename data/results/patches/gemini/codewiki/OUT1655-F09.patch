+import re
+from outlines.types import guid
+
+def test_guid_regex():
+    # The regex pattern used in outlines.types.guid
+    pattern = guid.pattern
+    
+    # Valid GUIDs
+    assert re.fullmatch(pattern, "{123e4567-e89b-12d3-a456-426614174000}") is not None
+    assert re.fullmatch(pattern, "{123E4567-E89B-12D3-A456-426614174000}") is not None
+    
+    # Invalid GUIDs
+    assert re.fullmatch(pattern, "123e4567-e89b-12d3-a456-426614174000") is None # No braces
+    assert re.fullmatch(pattern, "{123e4567-e89b-12d3-a456-42661417400}") is None # Too short
+    assert re.fullmatch(pattern, "{123e4567-e89b-12d3-a456-4266141740000}") is None # Too long
+    assert re.fullmatch(pattern, " {123e4567-e89b-12d3-a456-426614174000}") is None # Whitespace
+    assert re.fullmatch(pattern, "{123e4567-e89b-12d3-a456-426614174000} ") is None # Whitespace
+    assert re.fullmatch(pattern, "(123e4567-e89b-12d3-a456-426614174000)") is None # Wrong braces
