+from dirty_equals import IsEmail
+
+def test_is_email():
+    # Without domain filter
+    assert 'test.email+tag@domain.co.uk' == IsEmail()
+    assert 'invalid-email' != IsEmail()
+    
+    # With domain filter
+    assert 'test@example.com' == IsEmail('example.com')
+    assert 'test@other.com' != IsEmail('example.com')
+    
+    # Malformed
+    assert 'test@' != IsEmail()
+    assert '@domain.com' != IsEmail()
+    assert 'test@domain' != IsEmail() # Needs at least two labels
+    
+    # Repr
+    assert repr(IsEmail()) == 'IsEmail()'
+    assert repr(IsEmail('example.com')) == "IsEmail('example.com')"
+    
+    print("Tests passed!")
+
+if __name__ == "__main__":
+    test_is_email()
