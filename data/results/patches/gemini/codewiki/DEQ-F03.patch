@@ -0,0 +1,56 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+
+__all__ = 'IsEmail',
+
+class IsEmail(DirtyEquals[str]):
+    """
+    Checks if the value is a valid email address.
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        super().__init__(domain=domain)
+        self.domain = domain
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        if '@' not in other:
+            return False
+        
+        local, domain_part = other.rsplit('@', 1)
+        
+        # Local part validation
+        if not local or local.startswith('.') or local.endswith('.') or '..' in local:
+            return False
+        
+        if not re.fullmatch(r'[a-zA-Z0-9_%+.-]+', local):
+            return False
+            
+        # Domain validation
+        if self.domain is not None and domain_part != self.domain:
+            return False
+            
+        labels = domain_part.split('.')
+        if len(labels) < 2:
+            return False
+            
+        for label in labels:
+            if not label or label.startswith('-') or label.endswith('-'):
+                return False
+            if not re.fullmatch(r'[a-zA-Z0-9-]+', label):
+                return False
+                
+        if not re.fullmatch(r'[a-zA-Z]{2,}', labels[-1]):
+            return False
+            
+        return True
+
+    def _repr_ne(self) -> str:
+        if self.domain:
+            return f'IsEmail({self.domain!r})'
+        else:
+            return 'IsEmail()'
