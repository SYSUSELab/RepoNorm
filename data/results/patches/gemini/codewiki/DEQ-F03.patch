+import pytest
+from dirty_equals import IsEmail
+
+@pytest.mark.parametrize(
+    'value,dirty,match',
+    [
+        ('test.email+tag@domain.co.uk', IsEmail(), True),
+        ('test@example.com', IsEmail(), True),
+        ('test@example.com', IsEmail('example.com'), True),
+        ('test@other.com', IsEmail('example.com'), False),
+        ('invalid-email', IsEmail(), False),
+        ('test@', IsEmail(), False),
+        ('@domain.com', IsEmail(), False),
+        ('test@domain', IsEmail(), False),
+        ('test..email@domain.com', IsEmail(), False),
+        ('.test@domain.com', IsEmail(), False),
+        ('test.@domain.com', IsEmail(), False),
+        ('test@domain-.com', IsEmail(), False),
+        ('test@-domain.com', IsEmail(), False),
+        ('test@domain.c', IsEmail(), False),
+        (123, IsEmail(), False),
+    ],
+)
+def test_is_email(value, dirty, match):
+    if match:
+        assert value == dirty
+    else:
+        assert value != dirty
+
+def test_repr():
+    assert repr(IsEmail()) == 'IsEmail()'
+    assert repr(IsEmail('example.com')) == "IsEmail('example.com')"
