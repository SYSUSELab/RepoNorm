@@ -0,0 +1,39 @@
+from dirty_equals import IsEmail
+
+def test_is_email_edge_cases():
+    # Local part: ASCII letters/digits and _ % + -
+    # Dots only between nonempty runs (no leading, trailing or consecutive dots).
+    
+    # Valid local parts
+    assert 'a@b.co' == IsEmail()
+    assert 'a.b@b.co' == IsEmail()
+    assert 'a_b@b.co' == IsEmail()
+    assert 'a%b@b.co' == IsEmail()
+    assert 'a+b@b.co' == IsEmail()
+    assert 'a-b@b.co' == IsEmail()
+    
+    # Invalid local parts
+    assert '.a@b.co' != IsEmail()
+    assert 'a.@b.co' != IsEmail()
+    assert 'a..b@b.co' != IsEmail()
+    assert 'a!b@b.co' != IsEmail() # ! not allowed
+    
+    # Domain labels: ASCII letters/digits and internal hyphens; labels are nonempty and cannot start or end with a hyphen.
+    # At least two labels and the final label consists of at least two ASCII letters.
+    
+    # Valid domains
+    assert 'a@b.co' == IsEmail()
+    assert 'a@b-c.co' == IsEmail()
+    assert 'a@b.c-d.co' == IsEmail()
+    
+    # Invalid domains
+    assert 'a@b' != IsEmail() # Only one label
+    assert 'a@-b.co' != IsEmail() # Label starts with hyphen
+    assert 'a@b-.co' != IsEmail() # Label ends with hyphen
+    assert 'a@b.c' != IsEmail() # Final label must be at least 2 letters
+    assert 'a@b.12' != IsEmail() # Final label must be letters
+    
+    print("Edge cases passed!")
+
+if __name__ == "__main__":
+    test_is_email_edge_cases()
