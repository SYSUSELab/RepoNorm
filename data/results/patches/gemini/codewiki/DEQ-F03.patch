@@ -0,0 +1,79 @@
+import re
+from dirty_equals import IsStr
+
+# Grammar:
+# Local part: ASCII letters/digits and _ % + -
+# Dots only between nonempty runs (no leading, trailing or consecutive dots).
+# Domain labels: ASCII letters/digits and internal hyphens; labels are nonempty and cannot start or end with a hyphen.
+# At least two labels and the final label consists of at least two ASCII letters.
+
+# Local part regex:
+# [a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*
+# Wait, the requirement says: "The local part uses ASCII letters/digits and _ % + -, with dots only between nonempty runs (no leading, trailing or consecutive dots)."
+# So: [a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*
+# Let's test this.
+
+def is_valid_email(email, domain=None):
+    if not isinstance(email, str):
+        return False
+    
+    # Split local and domain
+    if '@' not in email:
+        return False
+    
+    local, domain_part = email.rsplit('@', 1)
+    
+    # Local part validation
+    # ASCII letters/digits and _ % + -
+    # Dots only between nonempty runs (no leading, trailing or consecutive dots).
+    # This means:
+    # - Cannot start with dot
+    # - Cannot end with dot
+    # - Cannot have consecutive dots
+    # - Only allowed characters: a-zA-Z0-9_%+- and .
+    
+    if not local or local.startswith('.') or local.endswith('.') or '..' in local:
+        return False
+    
+    if not re.fullmatch(r'[a-zA-Z0-9_%+.-]+', local):
+        return False
+        
+    # Domain validation
+    # ASCII letters/digits and internal hyphens
+    # Labels are nonempty and cannot start or end with a hyphen.
+    # At least two labels and the final label consists of at least two ASCII letters.
+    
+    if domain is not None and domain_part != domain:
+        return False
+        
+    labels = domain_part.split('.')
+    if len(labels) < 2:
+        return False
+        
+    for label in labels:
+        if not label or label.startswith('-') or label.endswith('-'):
+            return False
+        if not re.fullmatch(r'[a-zA-Z0-9-]+', label):
+            return False
+            
+    if not re.fullmatch(r'[a-zA-Z]{2,}', labels[-1]):
+        return False
+        
+    return True
+
+# Test cases
+assert is_valid_email('test.email+tag@domain.co.uk') == True
+assert is_valid_email('test@example.com') == True
+assert is_valid_email('test@example.com', domain='example.com') == True
+assert is_valid_email('test@other.com', domain='example.com') == False
+assert is_valid_email('test@') == False
+assert is_valid_email('@domain.com') == False
+assert is_valid_email('test@domain') == False
+assert is_valid_email('test..email@domain.com') == False
+assert is_valid_email('.test@domain.com') == False
+assert is_valid_email('test.@domain.com') == False
+assert is_valid_email('test@domain-.com') == False
+assert is_valid_email('test@-domain.com') == False
+assert is_valid_email('test@domain.c') == False # Final label must be at least 2 letters
+
+print("All tests passed!")
