@@ -0,0 +1,38 @@
+class ConditionalI18nExtension(InternationalizationExtension):
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        lineno = next(parser.stream).lineno
+        condition = parser.parse_expression()
+        
+        # Optional context
+        context = None
+        if parser.stream.skip_if("comma"):
+            if parser.stream.current.value == "context":
+                next(parser.stream)
+                parser.stream.expect("assign")
+                context = parser.parse_expression()
+                if not isinstance(context, nodes.Const):
+                    parser.fail("context must be a string literal", lineno)
+            else:
+                parser.fail("expected 'context'", lineno)
+        
+        parser.stream.expect("block_end")
+        
+        # Parse true branch
+        referenced, singular = self._parse_block(parser, False, ["name:fallback", "name:endctrans"])
+        node = self._make_node(singular, None, {}, context, bool(referenced), False)
+        
+        # Parse fallback
+        if parser.stream.current.test("name:fallback"):
+            next(parser.stream) # consume 'fallback'
+            parser.stream.expect("block_end")
+            fallback_body = parser.parse_statements(["name:endctrans"], drop_needle=True)
+        elif parser.stream.current.test("name:endctrans"):
+            next(parser.stream) # consume 'endctrans'
+            parser.stream.expect("block_end")
+            fallback_body = []
+        else:
+            parser.fail("missing fallback", lineno)
+            
+        return nodes.Output([nodes.Call(nodes.Name("bool", "load"), [condition], [], None, None), node, nodes.Output(fallback_body)])
