+import sys
+
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the `parse` method in `InternationalizationExtension`
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:' in line:
+        start_line = i
+        break
+
+# Find the end of the `parse` method
+end_line = 0
+for i in range(start_line + 1, len(lines)):
+    if lines[i].startswith('    def '):
+        end_line = i
+        break
+
+# Extract the `parse` method
+parse_method = lines[start_line:end_line]
+
+# Create `_parse_trans_body` method
+# It should take `parser` and `lineno` as arguments.
+# I need to remove the `lineno = next(parser.stream).lineno` line from the copied `parse` method.
+parse_trans_body = []
+for line in parse_method:
+    if 'lineno = next(parser.stream).lineno' in line:
+        continue
+    parse_trans_body.append(line.replace('def parse', 'def _parse_trans_body'))
+
+# Insert `_parse_trans_body` method after `parse` method
+new_lines = lines[:end_line] + parse_trans_body + lines[end_line:]
+
+# Now update `ConditionalI18nExtension` to use `_parse_trans_body`
+# I need to find `ConditionalI18nExtension` and update its `parse` method.
+#
+# Actually, I will just rewrite the `ConditionalI18nExtension` class.
+#
+# Let's find the start of `ConditionalI18nExtension`.
+start_class = 0
+for i, line in enumerate(new_lines):
+    if 'class ConditionalI18nExtension(InternationalizationExtension):' in line:
+        start_class = i
+        break
+
+# Remove the old `ConditionalI18nExtension` class
+new_lines = new_lines[:start_class]
+
+# Add the new `ConditionalI18nExtension` class
+new_lines.extend([
+    '\n',
+    'class ConditionalI18nExtension(InternationalizationExtension):\n',
+    '    tags = {"ctrans", "fallback", "endctrans"}\n',
+    '\n',
+    '    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:\n',
+    '        lineno = next(parser.stream).lineno\n',
+    '        condition = parser.parse_expression()\n',
+    '        # ... (context parsing)\n',
+    '        parser.stream.expect("block_end")\n',
+    '        \n',
+    '        # Parse true branch using _parse_trans_body\n',
+    '        true_node = self._parse_trans_body(parser, lineno)\n',
+    '        \n',
+    '        # Parse fallback\n',
+    '        if parser.stream.current.value == "fallback":\n',
+    '            next(parser.stream)\n',
+    '            parser.stream.expect("block_end")\n',
+    '            fallback_body = parser.parse_statements(["name:endctrans"], drop_needle=True)\n',
+    '        else:\n',
+    '            parser.fail("missing fallback", lineno)\n',
+    '            \n',
+    '        return nodes.Output([nodes.Call(nodes.Name("bool", "load"), [condition], [], None, None), true_node, fallback_body])\n',
+])
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(new_lines)
