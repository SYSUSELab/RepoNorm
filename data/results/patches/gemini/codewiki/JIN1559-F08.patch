+++ b/debug_tokens.py
@@ -0,0 +1,19 @@
+from jinja2 import Environment
+from jinja2.ext import Extension
+
+class DebugExtension(Extension):
+    tags = {"ctrans", "fallback", "endctrans"}
+    def parse(self, parser):
+        tag = next(parser.stream).value
+        if tag == "ctrans":
+            expr = parser.parse_expression()
+            # Instead of expect, let's just skip the block_end
+            parser.stream.skip(1)
+            # Now parse the body
+            parser.parse_statements(["name:fallback", "name:endctrans"], drop_needle=True)
+            
+        return []
+
+env = Environment(extensions=[DebugExtension])
+template_str = "{% ctrans True %}{% fallback %}{% endctrans %}"
+env.from_string(template_str)
