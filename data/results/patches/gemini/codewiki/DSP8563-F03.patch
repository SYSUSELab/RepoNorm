index 00000000..ea10ee3d
--- /dev/null
+++ b/tests/adapters/test_tool_coercion.py
@@ -0,0 +1,50 @@
+import pytest
+from dspy.adapters.types.tool import Tool
+
+def test_tool_coercion():
+    def my_tool(x: int, y: bool, z: float, s: str):
+        return f"x={x}, y={y}, z={z}, s={s}"
+
+    tool = Tool(my_tool)
+
+    # Test boolean
+    assert tool(x=1, y="true", z=1.0, s="hello") == "x=1, y=True, z=1.0, s=hello"
+    assert tool(x=1, y="FALSE", z=1.0, s="hello") == "x=1, y=False, z=1.0, s=hello"
+
+    # Test integer
+    assert tool(x="10", y=True, z=1.0, s="hello") == "x=10, y=True, z=1.0, s=hello"
+
+    # Test number
+    assert tool(x=1, y=True, z="1.5", s="hello") == "x=1, y=True, z=1.5, s=hello"
+
+    # Test duration
+    def duration_tool(d: int):
+        return d
+    tool_dur = Tool(duration_tool)
+    assert tool_dur(d="10s") == 10
+    assert tool_dur(d="1m") == 60
+    assert tool_dur(d="1h") == 3600
+    assert tool_dur(d="1000ms") == 1
+
+    # Test size
+    def size_tool(s: int):
+        return s
+    tool_size = Tool(size_tool)
+    assert tool_size(s="1KB") == 1000
+    assert tool_size(s="1MB") == 1000000
+    assert tool_size(s="1GB") == 1000000000
+
+    # Test whitespace
+    assert tool(x=" 10 ", y=" true ", z=" 1.5 ", s=" hello ") == "x=10, y=True, z=1.5, s=hello"
+
+def test_tool_coercion_failures():
+    def my_tool(x: int, y: bool, z: float, s: str):
+        return f"x={x}, y={y}, z={z}, s={s}"
+
+    tool = Tool(my_tool)
+
+    with pytest.raises(ValueError, match="Arg y is invalid"):
+        tool(x=1, y="not_a_bool", z=1.0, s="hello")
+
+    with pytest.raises(ValueError, match="Arg z is invalid"):
+        tool(x=1, y=True, z="not_a_number", s="hello")
