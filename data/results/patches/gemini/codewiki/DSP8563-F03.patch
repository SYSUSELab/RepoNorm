diff --git a/dspy/adapters/types/tool_coercion.py b/dspy/adapters/types/tool_coercion.py
new file mode 100644
index 00000000..4cc32d8e
--- /dev/null
+++ b/dspy/adapters/types/tool_coercion.py
@@ -0,0 +1,64 @@
+import re
+from decimal import Decimal, InvalidOperation
+from typing import Any
+
+def coerce_value(value: Any, schema: dict[str, Any]) -> Any:
+    if not isinstance(value, str):
+        return value
+    
+    value = value.strip()
+    type_str = schema.get("type")
+    
+    # Boolean
+    if type_str == "boolean":
+        if value.lower() == "true":
+            return True
+        if value.lower() == "false":
+            return False
+            
+    # Integer / Number
+    if type_str in ["integer", "number"]:
+        # Check for duration/size units
+        match = re.match(r"^([\d\.]+)\s*(ms|s|m|h|KB|MB|GB)$", value)
+        if match:
+            magnitude_str = match.group(1)
+            unit = match.group(2)
+            
+            try:
+                magnitude = Decimal(magnitude_str)
+            except InvalidOperation:
+                return value
+            
+            if unit == "ms":
+                res = magnitude / Decimal(1000)
+            elif unit == "s":
+                res = magnitude
+            elif unit == "m":
+                res = magnitude * Decimal(60)
+            elif unit == "h":
+                res = magnitude * Decimal(3600)
+            elif unit == "KB":
+                res = magnitude * Decimal(1000)
+            elif unit == "MB":
+                res = magnitude * Decimal(1000000)
+            elif unit == "GB":
+                res = magnitude * Decimal(1000000000)
+            else:
+                return value
+            
+            if type_str == "integer":
+                return int(res)
+            return float(res)
+        
+        # Plain number
+        try:
+            if type_str == "integer":
+                # Check if it's a valid integer string
+                if re.match(r"^-?\d+$", value):
+                    return int(value)
+            elif type_str == "number":
+                return float(value)
+        except (ValueError, OverflowError):
+            pass
+            
+    return value
diff --git a/dspy/adapters/types/tool_new.py b/dspy/adapters/types/tool_new.py
new file mode 100644
index 00000000..a4755d13
--- /dev/null
+++ b/dspy/adapters/types/tool_new.py
@@ -0,0 +1,36 @@
+    def _validate_and_parse_args(self, **kwargs):
+        # Coerce the args value according to the json schema.
+        coerced_kwargs = {}
+        for k, v in kwargs.items():
+            if k in self.args:
+                coerced_kwargs[k] = coerce_value(v, self.args[k])
+            else:
+                coerced_kwargs[k] = v
+        
+        # Validate the args value comply to the json schema.
+        for k, v in coerced_kwargs.items():
+            if k not in self.args:
+                if self.has_kwargs:
+                    continue
+                else:
+                    raise ValueError(f"Arg {k} is not in the tool's args.")
+            try:
+                instance = v.model_dump() if hasattr(v, "model_dump") else v
+                type_str = self.args[k].get("type")
+                if type_str is not None and type_str != "Any":
+                    validate(instance=instance, schema=self.args[k])
+            except ValidationError as e:
+                raise ValueError(f"Arg {k} is invalid: {e.message}")
+
+        # Parse the args to the correct type.
+        parsed_kwargs = {}
+        for k, v in coerced_kwargs.items():
+            if k in self.arg_types and self.arg_types[k] != Any:
+                # Create a pydantic model wrapper with a dummy field `value` to parse the arg to the correct type.
+                # This is specifically useful for handling nested Pydantic models like `list[list[MyPydanticModel]]`
+                pydantic_wrapper = create_model("Wrapper", value=(self.arg_types[k], ...))
+                parsed = pydantic_wrapper.model_validate({"value": v})
+                parsed_kwargs[k] = parsed.value
+            else:
+                parsed_kwargs[k] = v
+        return parsed_kwargs
