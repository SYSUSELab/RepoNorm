diff --git a/dirty_equals/_color.py b/dirty_equals/_color.py
new file mode 100644
index 0000000..935f57f
--- /dev/null
+++ b/dirty_equals/_color.py
@@ -0,0 +1,105 @@
+import re
+from typing import Any, Optional
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+__all__ = ('IsColor',)
+
+class IsColor(DirtyEquals[str]):
+    """
+    Validator for hex, RGB, and HSL color codes.
+    """
+
+    def __init__(self, format: Optional[str] = None):
+        """
+        Args:
+            format: The expected color format ('hex', 'rgb', or 'hsl').
+                If omitted, any supported format is allowed.
+        """
+        if format not in (None, 'hex', 'rgb', 'hsl'):
+            raise ValueError("format must be 'hex', 'rgb', or 'hsl'")
+        self.format = format
+        super().__init__(format if format else plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        other = other.strip()
+        
+        if self.format in (None, 'hex'):
+            if re.fullmatch(r'#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})', other):
+                return True
+        
+        if self.format in (None, 'rgb'):
+            if self._is_rgb(other):
+                return True
+                
+        if self.format in (None, 'hsl'):
+            if self._is_hsl(other):
+                return True
+                
+        return False
+
+    def _is_rgb(self, s: str) -> bool:
+        # RGB: rgb(r, g, b)
+        # "Whitespace is allowed around the complete value and around comma-separated components, but not inside a number, between function name and (, or between hue and deg."
+        # The regex `(?i)rgb\s*\(` is wrong because it allows whitespace between `rgb` and `(`.
+        # It should be `(?i)rgb\(`
+        
+        match = re.fullmatch(r'(?i)rgb\(\s*([^,]+)\s*,\s*([^,]+)\s*,\s*([^,]+)\s*\)', s)
+        if not match:
+            return False
+        
+        for comp in match.groups():
+            comp = comp.strip()
+            # "not inside a number"
+            if ' ' in comp:
+                return False
+            
+            if comp.endswith('%'):
+                val = comp[:-1]
+                if not val.isdigit() or not (0 <= int(val) <= 100):
+                    return False
+            else:
+                if not comp.isdigit() or not (0 <= int(comp) <= 255):
+                    return False
+        return True
+
+    def _is_hsl(self, s: str) -> bool:
+        # HSL: hsl(h, s, l)
+        # "not inside a number, between function name and (, or between hue and deg."
+        
+        match = re.fullmatch(r'(?i)hsl\(\s*([^,]+)\s*,\s*([^,]+)\s*,\s*([^,]+)\s*\)', s)
+        if not match:
+            return False
+        
+        # Hue
+        hue = match.group(1).strip()
+        # "not inside a number"
+        if ' ' in hue:
+            return False
+            
+        if hue.lower().endswith('deg'):
+            # "not between hue and deg"
+            # Wait, the requirement says "not between hue and deg".
+            # Does that mean '14 deg' is invalid? Yes.
+            # My regex `hue.lower().endswith('deg')` doesn't check for space.
+            # Let's check if there's a space before 'deg'.
+            if hue.lower().endswith(' deg'):
+                return False
+            hue = hue[:-3]
+            
+        if not hue.isdigit() or not (0 <= int(hue) <= 360):
+            return False
+            
+        # Saturation/Lightness
+        for comp in [match.group(2).strip(), match.group(3).strip()]:
+            if ' ' in comp:
+                return False
+            if not comp.endswith('%'):
+                return False
+            val = comp[:-1]
+            if not val.isdigit() or not (0 <= int(val) <= 100):
+                return False
+        return True
diff --git a/tests/test_color.py b/tests/test_color.py
new file mode 100644
index 0000000..90ee85f
--- /dev/null
+++ b/tests/test_color.py
@@ -0,0 +1,57 @@
+import pytest
+from dirty_equals import IsColor
+
+def test_is_color_hex():
+    assert '#FF5733' == IsColor('hex')
+    assert '#f57' == IsColor('hex')
+    assert 'FF5733' == IsColor('hex')
+    assert 'f57' == IsColor('hex')
+    assert '#FF5733' != IsColor('rgb')
+    assert '#FF5733' != IsColor('hsl')
+
+def test_is_color_rgb():
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'rgb(255,87,51)' == IsColor('rgb')
+    assert 'RGB(0, 0, 0)' == IsColor('rgb')
+    assert 'rgb(100%, 0%, 0%)' == IsColor('rgb')
+    assert 'rgb(256, 0, 0)' != IsColor('rgb')
+    assert 'rgb(101%, 0%, 0%)' != IsColor('rgb')
+
+def test_is_color_hsl():
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(14deg, 100%, 60%)' == IsColor('hsl')
+    assert 'HSL(360, 100%, 100%)' == IsColor('hsl')
+    assert 'hsl(361, 100%, 100%)' != IsColor('hsl')
+    assert 'hsl(14, 101%, 60%)' != IsColor('hsl')
+
+def test_is_color_any():
+    assert '#FF5733' == IsColor()
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+
+def test_is_color_repr():
+    assert repr(IsColor()) == "IsColor(*)"
+    assert repr(IsColor('hex')) == "IsColor('hex')"
+    assert repr(IsColor('rgb')) == "IsColor('rgb')"
+    assert repr(IsColor('hsl')) == "IsColor('hsl')"
+
+def test_is_color_invalid():
+    assert '#FF5733' != IsColor('rgb')
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+    assert 'hsl(14, 100%, 60%)' != IsColor('hex')
+    assert 'not a color' != IsColor()
+    assert 'rgb(255, 255, 255, 0.5)' != IsColor() # No alpha
+    assert 'rgb(255, 255, 255)' == IsColor()
+    assert 'hsl(0, 0%, 0%)' == IsColor()
+    assert 'hsl(0, 0%, 0%, 0.5)' != IsColor() # No alpha
+
+def test_is_color_whitespace():
+    assert '  #FF5733  ' == IsColor('hex')
+    assert 'rgb( 255 , 87 , 51 )' == IsColor('rgb')
+    assert 'hsl( 14deg , 100% , 60% )' == IsColor('hsl')
+
+def test_is_color_invalid_whitespace():
+    # "not inside a number, between function name and (, or between hue and deg."
+    assert 'rgb( 2 55, 87, 51 )' != IsColor('rgb')
+    assert 'rgb (255, 87, 51)' != IsColor('rgb')
+    assert 'hsl(14 deg, 100%, 60%)' != IsColor('hsl')
