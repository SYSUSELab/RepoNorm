@@ -0,0 +1,34 @@
+import os
+import pytest
+from jinja2 import FileSystemLoader
+
+def test_filesystem_loader_priority():
+    # Test case 1: Ordinary paths
+    loader = FileSystemLoader(["path1", "path2"])
+    assert loader.searchpath == ["path1", "path2"]
+
+    # Test case 2: Paths with priorities
+    loader = FileSystemLoader([("path1", 1), ("path2", 2)])
+    assert loader.searchpath == ["path2", "path1"]
+
+    # Test case 3: Mixed paths
+    loader = FileSystemLoader(["path1", ("path2", 2), ("path3", 1), "path4"])
+    assert loader.searchpath == ["path2", "path3", "path1", "path4"]
+
+    # Test case 4: Negative priorities
+    loader = FileSystemLoader([("path1", -1), ("path2", -2)])
+    assert loader.searchpath == ["path1", "path2"]
+
+    # Test case 5: Duplicate paths
+    loader = FileSystemLoader([("path1", 1), ("path1", 2)])
+    assert loader.searchpath == ["path1", "path1"]
+
+    # Test case 6: Type errors
+    with pytest.raises(TypeError, match="Tuple must have exactly 2 elements"):
+        FileSystemLoader([("path1", 1, 2)])
+
+    with pytest.raises(TypeError, match="Priority must be an integer"):
+        FileSystemLoader([("path1", "high")])
+
+    with pytest.raises(TypeError, match="Priority must be an integer"):
+        FileSystemLoader([("path1", True)])
