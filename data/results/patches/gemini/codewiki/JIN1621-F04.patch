diff --git a/test_logic.py b/test_logic.py
new file mode 100644
index 0000000..c64230b
--- /dev/null
+++ b/test_logic.py
@@ -0,0 +1,31 @@
+import os
+from typing import Union, Sequence, Tuple, List
+
+def process_searchpath(searchpath: Union[str, os.PathLike, Sequence[Union[str, os.PathLike, Tuple[Union[str, os.PathLike], int]]]]) -> List[str]:
+    if not isinstance(searchpath, (list, tuple)):
+        searchpath = [searchpath]
+    
+    processed = []
+    for item in searchpath:
+        if isinstance(item, tuple):
+            if len(item) != 2:
+                raise TypeError("Tuple must have exactly 2 elements")
+            path, priority = item
+            if not isinstance(priority, int) or isinstance(priority, bool):
+                raise TypeError("Priority must be an integer")
+            # Validate path
+            os.fspath(path)
+            processed.append((os.fspath(path), priority))
+        else:
+            # Validate path
+            os.fspath(item)
+            processed.append((os.fspath(item), 0))
+            
+    # Sort by descending priority, stable sort
+    processed.sort(key=lambda x: x[1], reverse=True)
+    
+    return [p[0] for p in processed]
+
+# Test
+print(process_searchpath(["path1", ("path2", 2), ("path3", 1), "path4"]))
+print(process_searchpath([("path1", 1), ("path2", 1)]))
