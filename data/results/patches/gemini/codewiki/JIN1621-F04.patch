+import os
+from jinja2 import FileSystemLoader
+import pytest
+
+def test_invalid_tuple_length():
+    try:
+        FileSystemLoader([("path1", 1, 2)])
+    except TypeError as e:
+        print(f"Caught expected error: {e}")
+    else:
+        print("Failed to catch error")
+
+def test_non_integer_priority():
+    try:
+        FileSystemLoader([("path1", "high")])
+    except TypeError as e:
+        print(f"Caught expected error: {e}")
+    else:
+        print("Failed to catch error")
+
+def test_boolean_priority():
+    try:
+        FileSystemLoader([("path1", True)])
+    except TypeError as e:
+        print(f"Caught expected error: {e}")
+    else:
+        print("Failed to catch error")
+
+test_invalid_tuple_length()
+test_non_integer_priority()
+test_boolean_priority()
