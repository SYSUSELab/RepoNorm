@@ -0,0 +1,35 @@
+import tiktoken
+import string
+import pytest
+
+def lowercase_transform(text):
+    return text.lower()
+
+def remove_punctuation(text):
+    return text.translate(str.maketrans("", "", string.punctuation))
+
+def test_transformers():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test single transformer
+    tokens = enc.encode("Hello, World!", transformers=lowercase_transform)
+    assert tokens == enc.encode("hello, world!")
+    
+    # Test chain of transformers
+    tokens = enc.encode("Hello, World!", transformers=[lowercase_transform, remove_punctuation])
+    assert tokens == enc.encode("hello world")
+    
+    # Test encode_batch
+    tokens_batch = enc.encode_batch(["Hello, World!", "TikToken"], transformers=[lowercase_transform, remove_punctuation])
+    assert tokens_batch == [enc.encode("hello world"), enc.encode("tiktoken")]
+    
+    # Test error cases
+    with pytest.raises(TypeError, match="transformers must be a callable or a list/tuple of callables"):
+        enc.encode("Hello", transformers=123)
+        
+    with pytest.raises(TypeError, match="Transformer must return a string"):
+        enc.encode("Hello", transformers=[lambda x: 123])
+        
+    with pytest.raises(TypeError, match="Each transformer must be a callable"):
+        enc.encode("Hello", transformers=[123])
+
