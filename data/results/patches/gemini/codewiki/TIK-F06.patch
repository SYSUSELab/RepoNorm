@@ -0,0 +1,37 @@
+from typing import Callable, Iterable
+
+def apply_transformers(text: str, transformers: Callable[[str], str] | Iterable[Callable[[str], str]] | None) -> str:
+    if transformers is None:
+        return text
+    
+    if callable(transformers):
+        transformers = [transformers]
+    
+    if not isinstance(transformers, (list, tuple)):
+        raise TypeError("transformers must be a callable or a list/tuple of callables")
+        
+    for t in transformers:
+        if not callable(t):
+            raise TypeError("Each transformer must be a callable")
+        text = t(text)
+        if not isinstance(text, str):
+            raise TypeError("Transformer must return a string")
+            
+    return text
+
+# Test cases
+def test():
+    assert apply_transformers("Hello", lambda x: x.lower()) == "hello"
+    assert apply_transformers("Hello", [lambda x: x.lower(), lambda x: x + "!"]) == "hello!"
+    
+    try:
+        apply_transformers("Hello", 123)
+    except TypeError as e:
+        print("Caught expected error:", e)
+        
+    try:
+        apply_transformers("Hello", [lambda x: 123])
+    except TypeError as e:
+        print("Caught expected error:", e)
+
+test()
