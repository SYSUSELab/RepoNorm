@@ -0,0 +1,90 @@
+import re
+
+with open("tiktoken/core.py", "r") as f:
+    content = f.read()
+
+# Add imports
+content = content.replace(
+    "from typing import TYPE_CHECKING, AbstractSet, Collection, Literal, NoReturn, Sequence",
+    "from typing import TYPE_CHECKING, AbstractSet, Callable, Collection, Iterable, Literal, NoReturn, Sequence"
+)
+
+# Update encode method
+encode_pattern = re.compile(
+    r"(def encode\(\n\s+self,\n\s+text: str,\n\s+\*,\n\s+allowed_special: Literal\[\"all\"\] \| AbstractSet\[str\] = set\(\),  # noqa: B006\n\s+disallowed_special: Literal\[\"all\"\] \| Collection\[str\] = \"all\",\n\s+\) -> list\[int\]:)",
+    re.MULTILINE
+)
+
+new_encode_def = """def encode(
+        self,
+        text: str,
+        *,
+        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006
+        disallowed_special: Literal["all"] | Collection[str] = "all",
+        transformers: Callable[[str], str] | Iterable[Callable[[str], str]] | None = None,
+    ) -> list[int]:"""
+
+content = encode_pattern.sub(new_encode_def, content)
+
+# Add transformer logic to encode
+transformer_logic = """
+        if transformers is not None:
+            if callable(transformers):
+                transformers = [transformers]
+            if not isinstance(transformers, (list, tuple)):
+                raise TypeError("transformers must be a callable or a list/tuple of callables")
+            for t in transformers:
+                if not callable(t):
+                    raise TypeError("Each transformer must be a callable")
+                text = t(text)
+                if not isinstance(text, str):
+                    raise TypeError("Transformer must return a string")
+"""
+
+# Insert logic after the docstring of encode
+# The docstring ends with """
+# Find the end of the docstring
+docstring_end = content.find('"""', content.find('def encode('))
+docstring_end = content.find('"""', docstring_end + 3) + 3
+content = content[:docstring_end] + transformer_logic + content[docstring_end:]
+
+# Update encode_batch method
+encode_batch_pattern = re.compile(
+    r"(def encode_batch\(\n\s+self,\n\s+text: list\[str\],\n\s+\*,\n\s+num_threads: int = 8,\n\s+allowed_special: Literal\[\"all\"\] \| AbstractSet\[str\] = set\(\),  # noqa: B006\n\s+disallowed_special: Literal\[\"all\"\] \| Collection\[str\] = \"all\",\n\s+\) -> list\[list\[int\]\]:)",
+    re.MULTILINE
+)
+
+new_encode_batch_def = """def encode_batch(
+        self,
+        text: list[str],
+        *,
+        num_threads: int = 8,
+        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006
+        disallowed_special: Literal["all"] | Collection[str] = "all",
+        transformers: Callable[[str], str] | Iterable[Callable[[str], str]] | None = None,
+    ) -> list[list[int]]:"""
+
+content = encode_batch_pattern.sub(new_encode_batch_def, content)
+
+# Update encode_batch logic
+# The docstring ends with """
+docstring_end = content.find('"""', content.find('def encode_batch('))
+docstring_end = content.find('"""', docstring_end + 3) + 3
+
+# We need to pass transformers to the encoder
+# The current code is:
+#        encoder = functools.partial(
+#            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special
+#        )
+# We need to change it to:
+#        encoder = functools.partial(
+#            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special, transformers=transformers
+#        )
+
+content = content.replace(
+    "            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special",
+    "            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special, transformers=transformers"
+)
+
+with open("tiktoken/core.py", "w") as f:
+    f.write(content)
