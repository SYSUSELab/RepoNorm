diff --git a/tests/test_groupby_limit.py b/tests/test_groupby_limit.py
new file mode 100644
index 0000000..f424795
--- /dev/null
+++ b/tests/test_groupby_limit.py
@@ -0,0 +1,52 @@
+import pytest
+from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
+from jinja2.filters import do_groupby
+
+def test_groupby_limit():
+    env = Environment()
+    data = [
+        {'name': 'a', 'city': 'NY'},
+        {'name': 'b', 'city': 'NY'},
+        {'name': 'c', 'city': 'LA'},
+        {'name': 'd', 'city': 'LA'},
+        {'name': 'e', 'city': 'SF'},
+        {'name': 'f', 'city': 'SF'},
+    ]
+    
+    # Test max_groups=1
+    result = do_groupby(env, data, 'city', max_groups=1)
+    assert len(result) == 1
+    assert result[0][0] == 'LA'
+
+    # Test max_groups=0
+    result = do_groupby(env, data, 'city', max_groups=0)
+    assert len(result) == 0
+
+    # Test max_groups=None
+    result = do_groupby(env, data, 'city', max_groups=None)
+    assert len(result) == 3
+
+    # Test invalid max_groups
+    for val in [-1, 1.5, True]:
+        with pytest.raises(FilterArgumentError):
+            do_groupby(env, data, 'city', max_groups=val)
+
+def test_async_groupby_limit():
+    import asyncio
+    env = Environment(enable_async=True)
+    data = [
+        {'name': 'a', 'city': 'NY'},
+        {'name': 'b', 'city': 'NY'},
+        {'name': 'c', 'city': 'LA'},
+        {'name': 'd', 'city': 'LA'},
+        {'name': 'e', 'city': 'SF'},
+        {'name': 'f', 'city': 'SF'},
+    ]
+    
+    async def run():
+        # Test async
+        result = await do_groupby(env, data, 'city', max_groups=2)
+        assert len(result) == 2
+    
+    asyncio.run(run())
