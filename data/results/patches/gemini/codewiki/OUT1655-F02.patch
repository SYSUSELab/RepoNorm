+from outlines.types import binary_str
+from pydantic import BaseModel
+import pytest
+
+def test_binary_str_type():
+    class Model(BaseModel):
+        val: binary_str
+
+    # Valid
+    assert Model(val="0b0").val == "0b0"
+    assert Model(val="0b1").val == "0b1"
+    assert Model(val="0b0101010101").val == "0b0101010101"
+
+    # Invalid
+    invalid_cases = [
+        "0B01",
+        "0b",
+        "101",
+        "0b0102",
+        " 0b01",
+        "0b01 ",
+        "0b_01",
+        "+0b01",
+        "-0b01",
+    ]
+    for case in invalid_cases:
+        with pytest.raises(ValueError):
+            Model(val=case)
