             t2.render(x=42)
+
+def test_groupby_key_transform():
+    from jinja2 import Environment
+    from jinja2.filters import do_groupby
+    env = Environment()
+    users = [
+        {"name": "Alice", "city": "NY"},
+        {"name": "Bob", "city": "LA"},
+        {"name": "Charlie", "city": "ny"},
+    ]
+    
+    def transform(key):
+        return key.upper()
+    
+    result = do_groupby(env, users, "city", key_transform=transform)
+    
+    assert len(result) == 3
+    assert result[0].grouper == "LA"
+    assert result[1].grouper == "NY"
+    assert result[2].grouper == "NY"
+    assert result[0].list[0]["name"] == "Bob"
+    assert result[1].list[0]["name"] == "Alice"
+    assert result[2].list[0]["name"] == "Charlie"
+
+def test_groupby_key_transform_pass_env():
+    from jinja2 import Environment
+    from jinja2.filters import do_groupby, pass_environment
+    env = Environment()
+    env.name = "TEST"
+    users = [
+        {"name": "Alice", "city": "NY"},
+    ]
+    
+    @pass_environment
+    def transform(env, key):
+        return f"{env.name}: {key}"
+    
+    result = do_groupby(env, users, "city", key_transform=transform)
+    assert result[0].grouper == "TEST: NY"
