     assert out == "[3, 4]"
+
+import asyncio
+from jinja2.filters import do_groupby
+from jinja2 import Environment
+
+def test_groupby_key_transform_async():
+    async def run():
+        env = Environment(enable_async=True)
+        users = [
+            {"name": "Alice", "city": "NY"},
+            {"name": "Bob", "city": "LA"},
+            {"name": "Charlie", "city": "ny"},
+        ]
+        
+        async def transform(key):
+            await asyncio.sleep(0.01)
+            return key.upper()
+        
+        result = await do_groupby(env, users, "city", key_transform=transform)
+        
+        assert len(result) == 3
+        assert result[0].grouper == "LA"
+        assert result[1].grouper == "NY"
+        assert result[2].grouper == "NY"
+        assert result[0].list[0]["name"] == "Bob"
+        assert result[1].list[0]["name"] == "Alice"
+        assert result[2].list[0]["name"] == "Charlie"
+    
+    asyncio.run(run())
