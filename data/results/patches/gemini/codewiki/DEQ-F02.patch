diff --git a/dirty_equals/_mac.py b/dirty_equals/_mac.py
new file mode 100644
index 0000000..13925b8
--- /dev/null
+++ b/dirty_equals/_mac.py
@@ -0,0 +1,51 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+HEX = r'[0-9a-fA-F]'
+COLON_RE = re.compile(rf'^{HEX}{{2}}(:{HEX}{{2}}){{5}}$')
+HYPHEN_RE = re.compile(rf'^{HEX}{{2}}(-{HEX}{{2}}){{5}}$')
+DOT_RE = re.compile(rf'^{HEX}{{4}}(\.{HEX}{{4}}){{2}}$')
+COMPACT_RE = re.compile(rf'^{HEX}{{12}}$')
+
+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address.
+    """
+
+    def __init__(self, format: Optional[Literal['colon', 'hyphen', 'dot', 'compact']] = None):
+        """
+        Args:
+            format: The format of the MAC address to check. If omitted, all formats are accepted.
+        """
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        if self.format == 'colon':
+            return bool(COLON_RE.fullmatch(other))
+        elif self.format == 'hyphen':
+            return bool(HYPHEN_RE.fullmatch(other))
+        elif self.format == 'dot':
+            return bool(DOT_RE.fullmatch(other))
+        elif self.format == 'compact':
+            return bool(COMPACT_RE.fullmatch(other))
+        elif self.format is None:
+            return bool(
+                COLON_RE.fullmatch(other) or 
+                HYPHEN_RE.fullmatch(other) or 
+                DOT_RE.fullmatch(other) or 
+                COMPACT_RE.fullmatch(other)
+            )
+        else:
+            return False
