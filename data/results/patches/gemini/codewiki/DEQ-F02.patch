+
+def test_is_mac():
+    assert '00:11:22:33:44:55' == IsMac()
+    assert '00-11-22-33-44-55' == IsMac()
+    assert '0011.2233.4455' == IsMac()
+    assert '001122334455' == IsMac()
+    assert '00:11:22:33:44:55' == IsMac('colon')
+    assert '00:11:22:33:44:55' != IsMac('hyphen')
+    assert '00-11-22-33-44-55' == IsMac('hyphen')
+    assert '0011.2233.4455' == IsMac('dot')
+    assert '001122334455' == IsMac('compact')
+    assert '00:11:22:33:44:55' != IsMac('compact')
+    assert '00:11:22:33:44:5G' != IsMac()
+    assert '00:11:22:33:44' != IsMac()
+    assert '00:11:22:33:44:55:66' != IsMac()
+    assert ' 00:11:22:33:44:55' != IsMac()
+    assert '00:11:22:33:44:55\n' != IsMac()
+    assert 123 != IsMac()
+
+def test_is_mac_repr():
+    assert repr(IsMac()) == 'IsMac(*)'
+    assert repr(IsMac('colon')) == "IsMac('colon')"
+    m = IsMac()
+    assert '00:11:22:33:44:55' == m
+    assert repr(m) == "'00:11:22:33:44:55'"
