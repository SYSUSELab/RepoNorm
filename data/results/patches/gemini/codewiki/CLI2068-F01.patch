--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,40 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+def test_edit_multiple_files(runner, monkeypatch):
+    import json
+    import sys
+    
+    # Mock the editor to verify the arguments passed
+    mock_editor_script = "mock_editor.py"
+    with open(mock_editor_script, "w") as f:
+        f.write("""
+import sys
+import json
+with open("args.json", "w") as f:
+    json.dump(sys.argv[1:], f)
+""")
+    
+    editor = f"{sys.executable} {mock_editor_script}"
+    
+    # Create some dummy files
+    with open("file1.txt", "w") as f:
+        f.write("file1 content")
+    with open("file 2.txt", "w") as f:
+        f.write("file2 content")
+        
+    try:
+        click.edit(filename=["file1.txt", "file 2.txt"], editor=editor)
+        
+        # Check the arguments passed to the editor
+        with open("args.json", "r") as f:
+            args = json.load(f)
+        assert args == ["file1.txt", "file 2.txt"]
+    finally:
+        import os
+        os.remove("file1.txt")
+        os.remove("file 2.txt")
+        os.remove(mock_editor_script)
+        if os.path.exists("args.json"):
+            os.remove("args.json")
