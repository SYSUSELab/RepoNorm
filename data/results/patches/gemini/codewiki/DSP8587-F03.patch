@@ -0,0 +1,74 @@
+import time
+from dspy.streaming.streaming_listener import StreamListener
+from unittest.mock import MagicMock
+
+# Mocking ModelResponseStream
+class MockDelta:
+    def __init__(self, content):
+        self.content = content
+
+class MockChoice:
+    def __init__(self, content):
+        self.delta = MockDelta(content)
+
+class MockResponse:
+    def __init__(self, content):
+        self.choices = [MockChoice(content)]
+
+def test_stats_reuse():
+    from dspy.dsp.utils.settings import settings
+    from dspy.adapters.chat_adapter import ChatAdapter
+    settings.adapter = ChatAdapter()
+    
+    listener = StreamListener(signature_field_name="answer", predict_name="my_predictor", allow_reuse=True)
+    
+    # First stream
+    listener.receive(MockResponse("[[ ## answer ## ]]"))
+    
+    # The start identifier is consumed.
+    # The next chunk should be the first one that counts.
+    
+    listener.receive(MockResponse("Hello"))
+    
+    # Check stats BEFORE the end of the stream
+    stats = listener.stats()
+    print(f"Stats during first stream: {stats}")
+    # The chunk "Hello" should have been processed by the "Update metrics" section
+    # Let's see if it was.
+    
+    # Wait, I see the issue.
+    # In receive():
+    # if not self.stream_start:
+    #     self.field_start_queue.append(chunk_message)
+    #     ...
+    #     return
+    
+    # If I send "[[ ## answer ## ]]", it sets self.stream_start = True.
+    # Then I send "Hello".
+    # It should go to "Update metrics".
+    
+    # Let's add some print statements in receive() to debug.
+    
+    assert stats["chunk_count"] == 1
+    assert stats["char_count"] == 5
+    
+    # The end of the stream is triggered by the next field identifier
+    listener.receive(MockResponse("[[ ## next ## ]]")) 
+    
+    # Check stats after first stream
+    stats = listener.stats()
+    print(f"Stats after first stream: {stats}")
+    assert stats["chunk_count"] == 0 
+    
+    # Second stream
+    listener.receive(MockResponse("[[ ## answer ## ]]"))
+    listener.receive(MockResponse("World"))
+    
+    stats = listener.stats()
+    print(f"Stats after second stream: {stats}")
+    assert stats["chunk_count"] == 1
+    assert stats["char_count"] == 5
+
+if __name__ == "__main__":
+    test_stats_reuse()
+    print("Test passed!")
