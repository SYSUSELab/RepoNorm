+++ b/test_stats.py
@@ -0,0 +1,26 @@
+import time
+from dspy.streaming.streaming_listener import StreamListener
+from unittest.mock import MagicMock
+
+def test_stats():
+    listener = StreamListener(signature_field_name="answer", predict_name="my_predictor")
+    
+    # Initial state
+    stats = listener.stats()
+    assert stats["predict_name"] == "my_predictor"
+    assert stats["field"] == "answer"
+    assert stats["chunk_count"] == 0
+    assert stats["char_count"] == 0
+    assert stats["first_ts"] is None
+    assert stats["last_ts"] is None
+    assert stats["duration_s"] is None
+    assert stats["avg_chunk_chars"] == 0
+
+if __name__ == "__main__":
+    try:
+        test_stats()
+        print("Test passed!")
+    except AttributeError:
+        print("AttributeError: StreamListener has no attribute 'stats'")
+    except Exception as e:
+        print(f"An error occurred: {e}")
diff --git a/test_stats_full.py b/test_stats_full.py
new file mode 100644
index 00000000..04398078
--- /dev/null
+++ b/test_stats_full.py
@@ -0,0 +1,53 @@
+import time
+from dspy.streaming.streaming_listener import StreamListener
+from unittest.mock import MagicMock
+
+# Mocking ModelResponseStream
+class MockDelta:
+    def __init__(self, content):
+        self.content = content
+
+class MockChoice:
+    def __init__(self, content):
+        self.delta = MockDelta(content)
+
+class MockResponse:
+    def __init__(self, content):
+        self.choices = [MockChoice(content)]
+
+def test_stats_full():
+    # We need to mock settings.adapter to avoid issues
+    from dspy.dsp.utils.settings import settings
+    from dspy.adapters.chat_adapter import ChatAdapter
+    settings.adapter = ChatAdapter()
+    
+    listener = StreamListener(signature_field_name="answer", predict_name="my_predictor")
+    
+    # Simulate receiving chunks
+    # 1. Start identifier
+    chunk1 = MockResponse("[[ ## answer ## ]]")
+    listener.receive(chunk1)
+    
+    # 2. Content
+    chunk2 = MockResponse("Hello")
+    listener.receive(chunk2)
+    
+    # 3. More content
+    chunk3 = MockResponse(" world")
+    listener.receive(chunk3)
+    
+    stats = listener.stats()
+    print(f"Stats: {stats}")
+    
+    assert stats["predict_name"] == "my_predictor"
+    assert stats["field"] == "answer"
+    assert stats["chunk_count"] == 2 # "Hello" and " world"
+    assert stats["char_count"] == 11 # len("Hello") + len(" world")
+    assert stats["first_ts"] is not None
+    assert stats["last_ts"] is not None
+    assert stats["duration_s"] >= 0
+    assert stats["avg_chunk_chars"] == 5.5
+
+if __name__ == "__main__":
+    test_stats_full()
+    print("Test passed!")
