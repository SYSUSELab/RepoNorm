@@ -0,0 +1,18 @@
+import click
+from click.testing import CliRunner
+
+def validator1(ctx, param, value):
+    return value + "_v1"
+
+def validator2(ctx, param, value):
+    return value + "_v2"
+
+@click.command()
+@click.option("--foo", validators=[validator1, validator2])
+def cli(foo):
+    click.echo(f"foo: {foo}")
+
+runner = CliRunner()
+result = runner.invoke(cli, ["--foo", "bar"], catch_exceptions=False)
+print(f"Result: {result.output}")
+print(f"Exit code: {result.exit_code}")
