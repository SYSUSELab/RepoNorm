@@ -0,0 +1,39 @@
+import sys
+
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the start of process_value
+start_line = -1
+for i, line in enumerate(lines):
+    if 'def process_value(self, ctx: Context, value: t.Any) -> t.Any:' in line:
+        start_line = i
+        break
+
+# Reconstruct the method
+new_lines = lines[:start_line+1]
+new_lines.append('        value = self.type_cast_value(ctx, value)\n')
+new_lines.append('\n')
+new_lines.append('        if self.required and self.value_is_missing(value):\n')
+new_lines.append('            raise MissingParameter(ctx=ctx, param=self)\n')
+new_lines.append('\n')
+new_lines.append('        if self.callback is not None:\n')
+new_lines.append('            value = self.callback(ctx, self, value)\n')
+new_lines.append('\n')
+new_lines.append('        if self.validators:\n')
+new_lines.append('            for validator in self.validators:\n')
+new_lines.append('                value = validator(ctx, self, value)\n')
+new_lines.append('\n')
+new_lines.append('        return value\n')
+
+# Find the end of process_value
+end_line = -1
+for i in range(start_line + 1, len(lines)):
+    if 'def resolve_envvar_value(self, ctx: Context) -> str | None:' in lines[i]:
+        end_line = i
+        break
+
+new_lines.extend(lines[end_line:])
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(new_lines)
