diff --git a/fix_invoke.py b/fix_invoke.py
new file mode 100644
index 0000000..eed73f5
--- /dev/null
+++ b/fix_invoke.py
@@ -0,0 +1,39 @@
+import sys
+
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the start of invoke
+start_line = -1
+for i, line in enumerate(lines):
+    if 'def invoke(self, ctx: Context) -> t.Any:' in line:
+        start_line = i
+        break
+
+# Reconstruct the method
+new_lines = lines[:start_line+1]
+new_lines.append('        """Given a context, this invokes the attached callback (if it exists)\n')
+new_lines.append('        """\n')
+new_lines.append('        if self.deprecated:\n')
+new_lines.append('            extra_message = (\n')
+new_lines.append('                f" {self.deprecated}" if isinstance(self.deprecated, str) else ""\n')
+new_lines.append('            )\n')
+new_lines.append('            message = _(\n')
+new_lines.append('                "DeprecationWarning: The command {name!r} is deprecated.{extra_message}"\n')
+new_lines.append('            ).format(name=self.name, extra_message=extra_message)\n')
+new_lines.append('            echo(style(message, fg="red"), err=True)\n')
+new_lines.append('        if self.callback is not None:\n')
+new_lines.append('            return ctx.invoke(self.callback, **ctx.params)\n')
+new_lines.append('        return None\n')
+
+# Find the end of invoke
+end_line = -1
+for i in range(start_line + 1, len(lines)):
+    if 'def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:' in lines[i]:
+        end_line = i
+        break
+
+new_lines.extend(lines[end_line:])
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(new_lines)
