diff --git a/test_validators.py b/test_validators.py
new file mode 100644
index 0000000..720649c
--- /dev/null
+++ b/test_validators.py
@@ -0,0 +1,30 @@
+import click
+from click.testing import CliRunner
+
+def validator1(ctx, param, value):
+    return value + 1
+
+def validator2(ctx, param, value):
+    return value * 2
+
+@click.command()
+@click.option('--count', type=int, validators=[validator1, validator2])
+def cli(count):
+    click.echo(count)
+
+runner = CliRunner()
+result = runner.invoke(cli, ['--count', '10'])
+print(f"Result: {result.output.strip()}")
+assert result.output.strip() == '22'
+
+# Test with invalid validator
+try:
+    @click.command()
+    @click.option('--count', type=int, validators=[123])
+    def cli_invalid(count):
+        click.echo(count)
+except TypeError as e:
+    print(f"Caught expected error: {e}")
+else:
+    print("Failed to catch invalid validator")
+
diff --git a/test_validators_2.py b/test_validators_2.py
new file mode 100644
index 0000000..2ecb30a
--- /dev/null
+++ b/test_validators_2.py
@@ -0,0 +1,38 @@
+import click
+from click.testing import CliRunner
+
+def validator1(ctx, param, value):
+    return value + 1
+
+def validator2(ctx, param, value):
+    return value * 2
+
+@click.command()
+@click.option('--count', type=int, validators=[validator1, validator2])
+def cli(count):
+    click.echo(count)
+
+runner = CliRunner()
+
+# Test multiple=True
+@click.command()
+@click.option('--count', type=int, multiple=True, validators=[validator1])
+def cli_multiple(count):
+    click.echo(list(count))
+
+result = runner.invoke(cli_multiple, ['--count', '1', '--count', '2'])
+print(f"Multiple Result: {result.output.strip()}")
+# validator1 is called for each value in multiple=True
+# 1 -> 2, 2 -> 3
+assert result.output.strip() == '[2, 3]'
+
+# Test default value
+@click.command()
+@click.option('--count', type=int, default=10, validators=[validator1])
+def cli_default(count):
+    click.echo(count)
+
+result = runner.invoke(cli_default, [])
+print(f"Default Result: {result.output.strip()}")
+assert result.output.strip() == '11'
+
diff --git a/test_validators_3.py b/test_validators_3.py
new file mode 100644
index 0000000..b6daa3d
--- /dev/null
+++ b/test_validators_3.py
@@ -0,0 +1,18 @@
+import click
+from click.testing import CliRunner
+
+def validator1(ctx, param, value):
+    # If multiple=True, value is a tuple.
+    if isinstance(value, tuple):
+        return tuple(v + 1 for v in value)
+    return value + 1
+
+@click.command()
+@click.option('--count', type=int, multiple=True, validators=[validator1])
+def cli_multiple(count):
+    click.echo(list(count))
+
+runner = CliRunner()
+result = runner.invoke(cli_multiple, ['--count', '1', '--count', '2'])
+print(f"Multiple Result: {result.output.strip()}")
+assert result.output.strip() == '[2, 3]'
