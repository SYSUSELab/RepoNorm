+import jinja2
+from jinja2 import FileSystemLoader, TemplateNotFound
+import os
+
+# Create a template file
+os.makedirs("templates", exist_ok=True)
+with open("templates/hello.txt", "w") as f:
+    f.write("Hello World!")
+
+# Test FileSystemLoader with path_transform
+def transform(name):
+    return name.replace("hello", "hello_transformed")
+
+# This should fail because hello_transformed.txt does not exist
+loader = FileSystemLoader("templates", path_transform=transform)
+env = jinja2.Environment(loader=loader)
+
+try:
+    env.get_template("hello.txt")
+except TemplateNotFound:
+    print("TemplateNotFound as expected")
+except Exception as e:
+    print(f"Unexpected exception: {e}")
+
+# Create the transformed template file
+with open("templates/hello_transformed.txt", "w") as f:
+    f.write("Hello Transformed!")
+
+# This should succeed
+try:
+    template = env.get_template("hello.txt")
+    print(template.render())
+except Exception as e:
+    print(f"Unexpected exception: {e}")
