+# I will use a more robust way to find and replace.
+
+# FileSystemLoader
+content = re.sub(
+    r"(def __init__\(self,\n\s+searchpath: t\.Union\[str, os\.PathLike, t\.Sequence\[t\.Union\[str, os\.PathLike\]\]\],\n\s+encoding: str = \"utf-8\",\n\s+followlinks: bool = False,\n\s+\) -> None:)",
+    r"def __init__(self, searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]], encoding: str = 'utf-8', followlinks: bool = False, path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# PackageLoader
+content = re.sub(
+    r"(def __init__\(self,\n\s+package_name: str,\n\s+package_path: \"str\" = \"templates\",\n\s+encoding: str = \"utf-8\",\n\s+\) -> None:)",
+    r"def __init__(self, package_name: str, package_path: 'str' = 'templates', encoding: str = 'utf-8', path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# DictLoader
+content = re.sub(
+    r"(def __init__\(self, mapping: t\.Mapping\[str, str\]\) -> None:)",
+    r"def __init__(self, mapping: t.Mapping[str, str], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# FunctionLoader
+content = re.sub(
+    r"(def __init__\(\n\s+self,\n\s+load_func: t\.Callable\[\[str\], t\.Optional\[t\.Union\[str, t\.Tuple\[str, t\.Optional\[str\], t\.Optional\[t\.Callable\[\[\], bool\]\]\]\]\]\],\n\s+\) -> None:)",
+    r"def __init__(self, load_func: t.Callable[[str], t.Optional[t.Union[str, t.Tuple[str, t.Optional[str], t.Optional[t.Callable[[], bool]]]]]], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# PrefixLoader
+content = re.sub(
+    r"(def __init__\(\n\s+self,\n\s+mapping: t\.Mapping\[str, BaseLoader\],\n\s+delimiter: str = \"/\"\n\s+\) -> None:)",
+    r"def __init__(self, mapping: t.Mapping[str, BaseLoader], delimiter: str = '/', path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# ChoiceLoader
+content = re.sub(
+    r"(def __init__\(self, loaders: t\.Sequence\[BaseLoader\]\) -> None:)",
+    r"def __init__(self, loaders: t.Sequence[BaseLoader], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# ModuleLoader
+content = re.sub(
+    r"(def __init__\(\n\s+self,\n\s+path: t\.Union\[str, os\.PathLike, t\.Sequence\[t\.Union\[str, os\.PathLike\]\]\]\n\s+\) -> None:)",
+    r"def __init__(self, path: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:\n        self.path_transform = path_transform",
+    content
+)
+
+# 2. Add path_transform logic to get_source/load
+# I will use a simpler approach: find the method and insert the code.
+
+# I will just use a simple string replacement for each method.
+# This is safer than regex.
+
+# FileSystemLoader.get_source
+content = content.replace(
+    "    def get_source(\n        self, environment: \"Environment\", template: str\n    ) -> t.Tuple[str, t.Optional[str], t.Optional[t.Callable[[], bool]]]:",
+    "    def get_source(\n        self, environment: \"Environment\", template: str\n    ) -> t.Tuple[str, t.Optional[str], t.Optional[t.Callable[[], bool]]]:\n        if self.path_transform is not None:\n            template = self.path_transform(template)\n            if not isinstance(template, str):\n                raise TypeError('path_transform must return a string')"
+)
+
+# PackageLoader.get_source
+# It's the same as FileSystemLoader.get_source.
+# I need to be careful.
+
+# I will use a more specific approach.
+# I will read the file and replace the methods one by one.
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.write(content)
