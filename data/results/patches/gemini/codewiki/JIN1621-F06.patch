+)
+
+# ChoiceLoader
+content = re.sub(
+    r"(def __init__\(self, loaders: t\.Sequence\[BaseLoader\]\) -> None:)",
+    r"def __init__(self, loaders: t.Sequence[BaseLoader], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:",
+    content
+)
+content = re.sub(
+    r"(self\.loaders = loaders)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+# ModuleLoader
+content = re.sub(
+    r"(def __init__\(\n\s+self,\n\s+path: t\.Union\[str, os\.PathLike, t\.Sequence\[t\.Union\[str, os\.PathLike\]\]\],\n\s+\) -> None:)",
+    r"\1\n        path_transform: t.Optional[t.Callable[[str], str]] = None,",
+    content
+)
+content = re.sub(
+    r"(package_name = f\"_jinja2_module_templates_{id\(self\):x}\")",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.write(content)
