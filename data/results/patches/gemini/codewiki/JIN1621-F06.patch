+import re
+
+with open("src/jinja2/loaders.py", "r") as f:
+    content = f.read()
+
+# FileSystemLoader
+content = re.sub(
+    r"(def __init__\(self,\n\s+searchpath: t\.Union\[str, os\.PathLike, t\.Sequence\[t\.Union\[str, os\.PathLike\]\]\],\n\s+encoding: str = \"utf-8\",\n\s+followlinks: bool = False,\n\s+\) -> None:)",
+    r"\1\n        path_transform: t.Optional[t.Callable[[str], str]] = None,",
+    content
+)
+content = re.sub(
+    r"(self\.followlinks = followlinks)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+# PackageLoader
+content = re.sub(
+    r"(def __init__\(self,\n\s+package_name: str,\n\s+package_path: \"str\" = \"templates\",\n\s+encoding: str = \"utf-8\",\n\s+\) -> None:)",
+    r"\1\n        path_transform: t.Optional[t.Callable[[str], str]] = None,",
+    content
+)
+content = re.sub(
+    r"(self\.encoding = encoding)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+# DictLoader
+content = re.sub(
+    r"(def __init__\(self, mapping: t\.Mapping\[str, str\]\) -> None:)",
+    r"def __init__(self, mapping: t.Mapping[str, str], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:",
+    content
+)
+content = re.sub(
+    r"(self\.mapping = mapping)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+# FunctionLoader
+content = re.sub(
+    r"(def __init__\(\n\s+self,\n\s+load_func: t\.Callable\[\[str\], t\.Optional\[t\.Union\[str, t\.Tuple\[str, t\.Optional\[str\], t\.Optional\[t\.Callable\[\[\], bool\]\]\]\]\]\],\n\s+\) -> None:)",
+    r"\1\n        path_transform: t.Optional[t.Callable[[str], str]] = None,",
+    content
+)
+content = re.sub(
+    r"(self\.load_func = load_func)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+# PrefixLoader
+content = re.sub(
+    r"(def __init__\(\n\s+self,\n\s+mapping: t\.Mapping\[str, BaseLoader\],\n\s+delimiter: str = \"/\",\n\s+\) -> None:)",
+    r"\1\n        path_transform: t.Optional[t.Callable[[str], str]] = None,",
+    content
+)
+content = re.sub(
+    r"(self\.delimiter = delimiter)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
+# ChoiceLoader
+content = re.sub(
+    r"(def __init__\(self, loaders: t\.Sequence\[BaseLoader\]\) -> None:)",
+    r"def __init__(self, loaders: t.Sequence[BaseLoader], path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:",
+    content
+)
+content = re.sub(
+    r"(self\.loaders = loaders)",
+    r"\1\n        self.path_transform = path_transform",
+    content
+)
+
