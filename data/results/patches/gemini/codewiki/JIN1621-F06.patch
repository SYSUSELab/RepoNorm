@@ -0,0 +1,32 @@
+import os
+from jinja2 import Environment, FileSystemLoader, TemplateNotFound
+
+# Create a dummy template
+os.makedirs("templates", exist_ok=True)
+with open("templates/test.html", "w") as f:
+    f.write("Hello {{ name }}!")
+
+# Define a path transform
+def my_transform(name):
+    if not isinstance(name, str):
+        raise TypeError("path_transform must return a string")
+    return name.replace("foo", "test")
+
+# Test FileSystemLoader with path_transform
+# We will manually patch FileSystemLoader to test the logic
+class PatchedFileSystemLoader(FileSystemLoader):
+    def __init__(self, searchpath, encoding="utf-8", followlinks=False, path_transform=None):
+        super().__init__(searchpath, encoding, followlinks)
+        self.path_transform = path_transform
+
+    def get_source(self, environment, template):
+        if self.path_transform:
+            template = self.path_transform(template)
+            if not isinstance(template, str):
+                raise TypeError("path_transform must return a string")
+        return super().get_source(environment, template)
+
+loader = PatchedFileSystemLoader("templates", path_transform=my_transform)
+env = Environment(loader=loader)
+template = env.get_template("foo.html")
+print(template.render(name="World"))
