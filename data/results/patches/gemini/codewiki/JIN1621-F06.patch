+++ b/update_loaders_v14.py
@@ -0,0 +1,71 @@
+import re
+
+with open("src/jinja2/loaders.py", "r") as f:
+    lines = f.readlines()
+
+def add_path_transform(lines, class_name, init_signature_end_pattern, init_body_end_pattern):
+    # Find the class
+    class_start = -1
+    for i, line in enumerate(lines):
+        if f"class {class_name}(BaseLoader):" in line:
+            class_start = i
+            break
+    
+    if class_start == -1:
+        return lines
+    
+    # Find the __init__ method
+    init_start = -1
+    for i in range(class_start, len(lines)):
+        if "def __init__(" in lines[i]:
+            init_start = i
+            break
+    
+    if init_start == -1:
+        return lines
+    
+    # Find the end of the signature
+    init_signature_end = -1
+    for i in range(init_start, len(lines)):
+        if init_signature_end_pattern in lines[i]:
+            init_signature_end = i
+            break
+    
+    if init_signature_end == -1:
+        return lines
+    
+    # Insert path_transform
+    lines.insert(init_signature_end, "        path_transform: t.Optional[t.Callable[[str], str]] = None,\n")
+    
+    # Find the end of the body
+    init_body_end = -1
+    for i in range(init_signature_end, len(lines)):
+        if init_body_end_pattern in lines[i]:
+            init_body_end = i
+            break
+    
+    if init_body_end == -1:
+        return lines
+    
+    # Insert self.path_transform
+    lines.insert(init_body_end + 1, "        self.path_transform = path_transform\n")
+    
+    return lines
+
+# FileSystemLoader
+lines = add_path_transform(lines, "FileSystemLoader", "followlinks: bool = False,", "self.followlinks = followlinks")
+# PackageLoader
+lines = add_path_transform(lines, "PackageLoader", "encoding: str = \"utf-8\",", "self.encoding = encoding")
+# DictLoader
+lines = add_path_transform(lines, "DictLoader", "mapping: t.Mapping[str, str]) -> None:", "self.mapping = mapping")
+# FunctionLoader
+lines = add_path_transform(lines, "FunctionLoader", "load_func: t.Callable", "self.load_func = load_func")
+# PrefixLoader
+lines = add_path_transform(lines, "PrefixLoader", "delimiter: str = \"/\",", "self.delimiter = delimiter")
+# ChoiceLoader
+lines = add_path_transform(lines, "ChoiceLoader", "loaders: t.Sequence[BaseLoader]) -> None:", "self.loaders = loaders")
+# ModuleLoader
+lines = add_path_transform(lines, "ModuleLoader", "path: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],", "package_name = f\"_jinja2_module_templates_{id(self):x}\"")
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.writelines(lines)
