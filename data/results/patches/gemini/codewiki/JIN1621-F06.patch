+from jinja2 import BaseLoader, TemplateNotFound
+
+class BaseLoaderWithTransform(BaseLoader):
+    def __init__(self, path_transform=None):
+        self.path_transform = path_transform
+
+    def _transform(self, name):
+        if self.path_transform is None:
+            return name
+        transformed = self.path_transform(name)
+        if not isinstance(transformed, str):
+            raise TypeError("path_transform must return a string")
+        return transformed
+
+# Test with a simple loader
+class MyLoader(BaseLoaderWithTransform):
+    def get_source(self, environment, template):
+        template = self._transform(template)
+        if template == "exists":
+            return "source", None, None
+        raise TemplateNotFound(template)
+
+loader = MyLoader(path_transform=lambda n: "exists" if n == "foo" else n)
+try:
+    loader.get_source(None, "foo")
+    print("Success")
+except TemplateNotFound:
+    print("Failed")
