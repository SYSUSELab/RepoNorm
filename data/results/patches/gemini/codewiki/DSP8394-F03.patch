new file mode 100644
index 00000000..1e01db9c
--- /dev/null
+++ b/reproduce_cache_ttl.py
@@ -0,0 +1,44 @@
+import dspy
+from dspy.clients.cache import Cache
+import time
+import os
+import shutil
+
+# Setup a temporary cache directory
+cache_dir = ".test_cache"
+if os.path.exists(cache_dir):
+    shutil.rmtree(cache_dir)
+
+# Initialize Cache
+cache = Cache(enable_disk_cache=True, enable_memory_cache=True, disk_cache_dir=cache_dir)
+
+# Test put and get
+request = {"prompt": "hello"}
+value = "world"
+cache.put(request, value)
+assert cache.get(request) == value
+
+print("Cache basic functionality works.")
+
+# Now we need to implement TTL.
+# The requirement is:
+# 1. Add ttl=None to Cache.__init__
+# 2. Add ttl=None to configure_cache
+# 3. Expose dspy.clients.set_ttl(seconds)
+# 4. Reject invalid TTLs
+# 5. TTL is a positive finite number of seconds; None means no expiration.
+# 6. Each successful write starts that entry's lifetime.
+# 7. Reads must not restart it.
+# 8. Once the deadline passes, reads must miss.
+# 9. Overwriting an entry starts a new lifetime.
+# 10. Disk entries retain their expiry when another Cache instance opens the same store.
+
+# Let's verify if we can even set a TTL now.
+try:
+    cache.set_ttl(10)
+    print("set_ttl exists")
+except AttributeError:
+    print("set_ttl does not exist")
+
+if os.path.exists(cache_dir):
+    shutil.rmtree(cache_dir)
diff --git a/test_cache_ttl_fix.py b/test_cache_ttl_fix.py
new file mode 100644
index 00000000..80753aed
--- /dev/null
+++ b/test_cache_ttl_fix.py
@@ -0,0 +1,63 @@
+import dspy
+from dspy.clients.cache import Cache
+import time
+import os
+import shutil
+import dspy.clients
+
+# Setup a temporary cache directory
+cache_dir = ".test_cache"
+if os.path.exists(cache_dir):
+    shutil.rmtree(cache_dir)
+
+# Initialize Cache with TTL
+cache = Cache(enable_disk_cache=True, enable_memory_cache=True, disk_cache_dir=cache_dir, ttl=0.5)
+
+# Test put and get
+request = {"prompt": "hello"}
+value = "world"
+cache.put(request, value)
+assert cache.get(request) == value
+print("Cache basic functionality works.")
+
+# Test expiration
+print("Waiting for expiration...")
+time.sleep(0.6)
+assert cache.get(request) is None
+print("Expiration works.")
+
+# Test set_ttl
+cache.set_ttl(1.0)
+cache.put(request, value)
+assert cache.get(request) == value
+time.sleep(0.6)
+assert cache.get(request) == value # Should still be there
+print("set_ttl works (still there after 0.6s).")
+time.sleep(0.5)
+assert cache.get(request) is None
+print("set_ttl works (expired after 1.1s).")
+
+# Test global set_ttl
+dspy.clients.configure_cache(enable_disk_cache=True, enable_memory_cache=True, disk_cache_dir=cache_dir, ttl=0.5)
+dspy.cache.put(request, value)
+assert dspy.cache.get(request) == value
+dspy.clients.set_ttl(1.0)
+dspy.cache.put(request, "new_value")
+assert dspy.cache.get(request) == "new_value"
+time.sleep(0.6)
+assert dspy.cache.get(request) == "new_value" # Should still be there
+print("Global set_ttl works.")
+
+# Test invalid TTL
+try:
+    cache.set_ttl(0)
+except ValueError as e:
+    print(f"Caught expected error for 0 TTL: {e}")
+
+try:
+    cache.set_ttl(-1)
+except ValueError as e:
+    print(f"Caught expected error for -1 TTL: {e}")
+
+if os.path.exists(cache_dir):
+    shutil.rmtree(cache_dir)
diff --git a/test_ttl_logic.py b/test_ttl_logic.py
new file mode 100644
index 00000000..063372f4
--- /dev/null
+++ b/test_ttl_logic.py
@@ -0,0 +1,42 @@
+import time
+import math
+
+def validate_ttl(ttl):
+    if ttl is not None:
+        if not isinstance(ttl, (int, float)) or isinstance(ttl, bool):
+            raise ValueError("TTL must be a number")
+        if ttl <= 0 or not math.isfinite(ttl):
+            raise ValueError("TTL must be a positive finite number")
+    return ttl
+
+# Test cases
+try:
+    validate_ttl(None)
+    print("None: OK")
+    validate_ttl(10)
+    print("10: OK")
+    validate_ttl(10.5)
+    print("10.5: OK")
+    validate_ttl(0)
+except ValueError as e:
+    print(f"0: {e}")
+
+try:
+    validate_ttl(-1)
+except ValueError as e:
+    print(f"-1: {e}")
+
+try:
+    validate_ttl(float('inf'))
+except ValueError as e:
+    print(f"inf: {e}")
+
+try:
+    validate_ttl("10")
+except ValueError as e:
+    print(f"string: {e}")
+
+try:
+    validate_ttl(True)
+except ValueError as e:
+    print(f"bool: {e}")
