diff --git a/tests/test_groupby_case.py b/tests/test_groupby_case.py
new file mode 100644
index 0000000..82e8b6f
--- /dev/null
+++ b/tests/test_groupby_case.py
@@ -0,0 +1,35 @@
+import pytest
+from jinja2.environment import Environment
+
+def test_groupby_case_sensitive():
+    env = Environment()
+    data = ["apple", "Apple", "banana", "Banana", "cherry"]
+    
+    # Default (case_sensitive=True)
+    result = env.filters["groupby"](env, data, None)
+    assert len(result) == 5
+    
+    # case_sensitive=False
+    result = env.filters["groupby"](env, data, None, case_sensitive=False)
+    assert len(result) == 3
+    assert result[0].grouper == "apple"
+    assert result[0].list == ["apple", "Apple"]
+    assert result[1].grouper == "banana"
+    assert result[1].list == ["banana", "Banana"]
+    assert result[2].grouper == "cherry"
+    assert result[2].list == ["cherry"]
+
+def test_groupby_case_sensitive_attribute():
+    env = Environment()
+    class Item:
+        def __init__(self, name):
+            self.name = name
+    data = [Item("apple"), Item("Apple"), Item("banana")]
+    
+    # case_sensitive=False
+    result = env.filters["groupby"](env, data, "name", case_sensitive=False)
+    assert len(result) == 2
+    assert result[0].grouper == "apple"
+    assert len(result[0].list) == 2
+    assert result[1].grouper == "banana"
+    assert len(result[1].list) == 1
