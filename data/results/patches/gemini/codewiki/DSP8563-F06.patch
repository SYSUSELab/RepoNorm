+import json
+from dspy.adapters.types.tool import ToolCalls
+from pydantic import ValidationError
+
+def test_edge_cases():
+    # Test case 1: No language label
+    data_no_label = """
+```
+[{"name": "search", "args": {"query": "hello"}}]
+```
+"""
+    try:
+        tool_calls = ToolCalls.model_validate(data_no_label)
+        print("No label success")
+    except Exception as e:
+        print(f"No label failed: {e}")
+
+    # Test case 2: Empty list
+    data_empty = """
+```json
+[]
+```
+"""
+    try:
+        tool_calls = ToolCalls.model_validate(data_empty)
+        print("Empty list success")
+    except Exception as e:
+        print(f"Empty list failed: {e}")
+
+    # Test case 3: Invalid JSON inside fence
+    data_invalid = """
+```json
+[{"name": "search", "args": {"query": "hello"}]
+```
+"""
+    try:
+        tool_calls = ToolCalls.model_validate(data_invalid)
+        print("Invalid JSON success (unexpected)")
+    except Exception as e:
+        print(f"Invalid JSON failed as expected: {e}")
+
+    # Test case 4: Multiple fences (should only take the first)
+    data_multiple = """
+```json
+[{"name": "first", "args": {}}]
+```
+```json
+[{"name": "second", "args": {}}]
+```
+"""
+    try:
+        tool_calls = ToolCalls.model_validate(data_multiple)
+        if tool_calls.tool_calls[0].name == "first":
+            print("Multiple fences success")
+        else:
+            print(f"Multiple fences failed: {tool_calls.tool_calls[0].name}")
+    except Exception as e:
+        print(f"Multiple fences failed: {e}")
+
+test_edge_cases()
