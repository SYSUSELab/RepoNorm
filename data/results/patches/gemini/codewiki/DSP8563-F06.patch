+    '            ]\n',
+    '            tool_calls = ToolCalls.from_dict_list(tool_calls_dict)\n',
+    '            ```\n',
+    '        """\n',
+    '        tool_calls = [cls.ToolCall(**item) for item in tool_calls_dicts]\n',
+    '        return cls(tool_calls=tool_calls)\n',
+    '\n',
+    '    @classmethod\n',
+    '    def description(cls) -> str:\n',
+    '        return (\n',
+    '            "Tool calls information, including the name of the tools and the arguments to be passed to it. "\n',
+    '            "Arguments must be provided in JSON format."\n',
+    '        )\n',
+    '\n',
+    '    def format(self) -> list[dict[str, Any]]:\n',
+    '        # The tool_call field is compatible with OpenAI\'s tool calls schema.\n',
+    '        return [\n',
+    '            {\n',
+    '                "type": "tool_calls",\n',
+    '                "tool_calls": [\n',
+    '                    {\n',
+    '                        "type": "function",\n',
+    '                        "function": {\n',
+    '                            "name": tool_call.name,\n',
