+
+def test_tool_calls_parsing():
+    # Test case 1: Valid plain JSON
+    data = [{"name": "search", "args": {"query": "hello"}}]
+    try:
+        tool_calls = ToolCalls.model_validate(data)
+        print("Plain JSON success")
+    except Exception as e:
+        print(f"Plain JSON failed: {e}")
+
+    # Test case 2: JSON wrapped in markdown fence
+    data_fenced = """
+```json
+[{"name": "search", "args": {"query": "hello"}}]
+```
+"""
+    try:
+        # This should now work
+        tool_calls = ToolCalls.model_validate(data_fenced)
