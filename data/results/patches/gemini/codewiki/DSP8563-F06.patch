+import json
+from dspy.adapters.types.tool import ToolCalls
+
+def test_validate_input():
+    # Test plain JSON
+    data = '[{"name": "test_tool", "args": {"arg1": "val1"}}]'
+    assert ToolCalls.validate_input(data) == [{"name": "test_tool", "args": {"arg1": "val1"}}]
+
+    # Test markdown fence
+    data = '```json\n[{"name": "test_tool", "args": {"arg1": "val1"}}]\n```'
+    assert ToolCalls.validate_input(data) == [{"name": "test_tool", "args": {"arg1": "val1"}}]
+
+    # Test markdown fence with no language
+    data = '```\n[{"name": "test_tool", "args": {"arg1": "val1"}}]\n```'
+    assert ToolCalls.validate_input(data) == [{"name": "test_tool", "args": {"arg1": "val1"}}]
+
+    # Test invalid JSON
+    data = '```\n[{"name": "test_tool", "args": {"arg1": "val1"}}\n```'
+    assert ToolCalls.validate_input(data) == data
+
+    # Test no fence
+    data = 'some text'
+    assert ToolCalls.validate_input(data) == data
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_validate_input()
