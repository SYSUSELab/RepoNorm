index 0000000..7defc73
--- /dev/null
+++ b/dirty_equals/_regex.py
@@ -0,0 +1,55 @@
+import re
+from typing import Any, Pattern, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit
+
+__all__ = 'IsRegex',
+
+class IsRegex(DirtyEquals[str]):
+    """
+    Checks if the value is a string and matches the given regular expression.
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, Pattern[str]],
+        flags: int = 0,
+        *,
+        mode: str = 'match',
+    ):
+        """
+        Args:
+            pattern: The regular expression pattern (string or compiled).
+            flags: Optional `re` flags.
+            mode: The matching mode: 'match', 'search', or 'fullmatch'.
+        """
+        if mode not in ('match', 'search', 'fullmatch'):
+            raise ValueError(f"Invalid mode: {mode}. Must be 'match', 'search', or 'fullmatch'.")
+
+        self.mode = mode
+        
+        if isinstance(pattern, re.Pattern):
+            if flags != 0:
+                raise ValueError("Cannot pass flags when pattern is already compiled.")
+            self.pattern = pattern
+            self.flags = pattern.flags
+            # Use the pattern string for representation
+            repr_pattern = pattern.pattern
+        else:
+            self.pattern = re.compile(pattern, flags)
+            self.flags = flags
+            repr_pattern = pattern
+
+        repr_kwargs = {'mode': mode} if mode != 'match' else {}
+        if flags != 0:
+            repr_kwargs['flags'] = re.RegexFlag(flags)
+        
+        super().__init__(repr_pattern, **repr_kwargs)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        func = getattr(re, self.mode)
+        return bool(func(self.pattern, other))
diff --git a/reproduce_isregex.py b/reproduce_isregex.py
new file mode 100644
index 0000000..7955966
--- /dev/null
+++ b/reproduce_isregex.py
@@ -0,0 +1,49 @@
+import re
+import pytest
+from dirty_equals import IsRegex
+
+def test_isregex_basic():
+    assert 'foo' == IsRegex('foo')
+    assert 'foobar' == IsRegex('foo')
+    assert 'barfoo' != IsRegex('foo')
+
+def test_isregex_flags():
+    assert 'FOO' == IsRegex('foo', flags=re.IGNORECASE)
+    assert 'foo' == IsRegex('FOO', flags=re.IGNORECASE)
+
+def test_isregex_mode():
+    assert 'foobar' == IsRegex('bar', mode='search')
+    assert 'foobar' != IsRegex('bar', mode='match')
+    assert 'foobar' == IsRegex('foobar', mode='fullmatch')
+    assert 'foobar' != IsRegex('foo', mode='fullmatch')
+
+def test_isregex_invalid_mode():
+    with pytest.raises(ValueError):
+        IsRegex('foo', mode='invalid')
+
+def test_isregex_compiled():
+    pattern = re.compile('foo')
+    assert 'foobar' == IsRegex(pattern)
+
+def test_isregex_repr():
+    assert repr(IsRegex('foo')) == "IsRegex('foo')"
+    assert repr(IsRegex('foo', flags=re.IGNORECASE)) == "IsRegex('foo', flags=re.IGNORECASE)"
+    assert repr(IsRegex('foo', mode='search')) == "IsRegex('foo', mode='search')"
+    
+    # Test compiled pattern repr
+    pattern = re.compile('foo')
+    assert repr(IsRegex(pattern)) == "IsRegex('foo')"
+
+if __name__ == '__main__':
+    try:
+        test_isregex_basic()
+        test_isregex_flags()
+        test_isregex_mode()
+        test_isregex_invalid_mode()
+        test_isregex_compiled()
+        test_isregex_repr()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
