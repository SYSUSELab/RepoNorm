+    def format_with_metadata(self) -> list[dict[str, Any]]:
+        # The tool_call field is compatible with OpenAI's tool calls schema.
+        # Metadata is added beside each call's type/function fields.
+        
+        calls = []
+        for tool_call in self.tool_calls:
+            call = {
+                "type": "function",
+                "function": {
+                    "name": tool_call.name,
+                    "arguments": tool_call.args,
+                },
+            }
+            
+            # Add metadata if present
+            metadata = {}
+            if tool_call.note is not None: metadata["note"] = tool_call.note
+            if tool_call.comment is not None: metadata["comment"] = tool_call.comment
+            if tool_call.annotation is not None: metadata["annotation"] = tool_call.annotation
+            if tool_call.tags is not None: metadata["tags"] = tool_call.tags
+            if tool_call.priority is not None: metadata["priority"] = tool_call.priority
+            if tool_call.meta is not None: metadata["meta"] = tool_call.meta
+            
+            if metadata:
+                call.update(metadata)
+            
+            calls.append(call)
+            
+        return [
+            {
+                "type": "tool_calls",
+                "tool_calls": calls,
+            }
+        ]
+
+    @classmethod
+    def from_string(cls, text: str) -> "ToolCalls":
+        import json
+        
+        # Remove Python-style # comments
+        cleaned_text = ""
+        in_string = False
+        escaped = False
+        comment_lines = []
+        
+        i = 0
+        while i < len(text):
+            char = text[i]
+            if char == '\\' and not escaped:
+                escaped = True
+                cleaned_text += char
+            elif char == '"' and not escaped:
+                in_string = not in_string
+                cleaned_text += char
+            elif char == '#' and not in_string:
+                # Comment starts here
+                comment = text[i+1:].split('\n')[0]
+                comment_lines.append(comment.strip())
+                # Skip to the end of the line
+                i = text.find('\n', i)
+                if i == -1:
+                    break
+                continue
+            else:
+                cleaned_text += char
+                escaped = False
+            i += 1
+            
+        # Combine comments
+        combined_comment = "\n".join([c for c in comment_lines if c.strip()])
+        
+        # Parse JSON
+        try:
+            data = json.loads(cleaned_text)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Invalid JSON: {e}")
+        
+        # Handle different formats
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                tool_calls_dicts = data["tool_calls"]
+            else:
+                # Maybe it's a single call?
+                tool_calls_dicts = [data]
+        elif isinstance(data, list):
+            tool_calls_dicts = data
+        else:
+            raise ValueError("Invalid JSON format")
+            
+        # Create ToolCalls
+        tool_calls = cls.from_dict_list(tool_calls_dicts)
+        
+        # Apply combined_comment as annotation to all calls
+        if combined_comment:
+            for tc in tool_calls.tool_calls:
+                tc.annotation = combined_comment
+                
+        return tool_calls
+
 
