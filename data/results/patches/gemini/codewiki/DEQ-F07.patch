diff --git a/dirty_equals/_hash.py b/dirty_equals/_hash.py
new file mode 100644
index 0000000..64b9a32
--- /dev/null
+++ b/dirty_equals/_hash.py
@@ -0,0 +1,59 @@
+import re
+from typing import Any
+
+from ._base import DirtyEquals
+
+HASH_LENGTHS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hexadecimal hash string.
+    """
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm to check (md5, sha1, sha224, sha256, sha384, sha512).
+        """
+        self.algorithm_name = algorithm
+        self.algorithm = algorithm.lower()
+        if self.algorithm not in HASH_LENGTHS:
+            raise ValueError(f'Unsupported hash algorithm: {algorithm}')
+        self.length = HASH_LENGTHS[self.algorithm]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        if len(other) != self.length:
+            return False
+        # The issue might be that I'm not actually checking the content,
+        # just the length and if it's hex.
+        # Wait, the requirement says:
+        # "Validation concerns only the complete hexadecimal representation,
+        # not whether it is the digest of a real file."
+        # So my `equals` method is actually correct for the requirement.
+        # Why did my test fail?
+        # Ah, I see. The test `assert 'd41d8cd98f00b204e9800998ecf8427a' != h`
+        # is checking if it's NOT equal.
+        # But my `equals` method returns `True` for ANY 32-character hex string.
+        # That's not right.
+        # The requirement says:
+        # "A matching value is a string with exactly the hexadecimal length defined by the selected algorithm."
+        # This implies that `IsHash` is a validator for the *format* of the hash,
+        # not for a *specific* hash value.
+        # So `IsHash('md5')` should match ANY 32-character hex string.
+        # If so, then `assert 'd41d8cd98f00b204e9800998ecf8427a' != h`
+        # should be `False` (i.e., it should be equal).
+        # Let me re-read the requirement.
+        return bool(re.fullmatch(r'[0-9a-fA-F]+', other))
+
+    def _repr_ne(self) -> str:
+        return f'IsHash({self.algorithm_name})'
diff --git a/tests/test_hash.py b/tests/test_hash.py
new file mode 100644
index 0000000..14eed5a
--- /dev/null
+++ b/tests/test_hash.py
@@ -0,0 +1,26 @@
+import pytest
+from dirty_equals import IsHash
+
+def test_is_hash_md5():
+    h = IsHash('md5')
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == h
+    assert 'D41D8CD98F00B204E9800998ECF8427E' == h
+    assert 'd41d8cd98f00b204e9800998ecf8427a' == h
+    assert 'short' != h
+    assert 123 != h
+    assert 'g' * 32 != h # Not hex
+
+def test_is_hash_sha256():
+    h = IsHash('SHA256')
+    assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == h
+    assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85a' == h
+
+def test_is_hash_invalid_algo():
+    with pytest.raises(ValueError):
+        IsHash('invalid')
+
+def test_is_hash_repr():
+    h = IsHash('md5')
+    assert repr(h) == 'IsHash(md5)'
+    h2 = IsHash('SHA256')
+    assert repr(h2) == 'IsHash(SHA256)'
