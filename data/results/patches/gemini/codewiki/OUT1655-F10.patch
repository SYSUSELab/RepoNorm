+from outlines.types import hash_sha256
+from pydantic import BaseModel, ValidationError
+import pytest
+
+def test_sha256_validation():
+    valid_hashes = [
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+        "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855",
+        "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
+    ]
+    for h in valid_hashes:
+        assert hash_sha256.validate(h) == h
+        assert hash_sha256.matches(h) is True
+
+def test_sha256_invalid():
+    invalid_hashes = [
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85", # Too short
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b8555", # Too long
+        "g3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", # Invalid char 'g'
+        " e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", # Leading space
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ", # Trailing space
+    ]
+    for h in invalid_hashes:
+        with pytest.raises(ValueError):
+            hash_sha256.validate(h)
+        assert hash_sha256.matches(h) is False
+
+def test_sha256_pydantic():
+    class HashModel(BaseModel):
+        hash: hash_sha256
+
+    # Valid
+    m = HashModel(hash="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
+    assert m.hash == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+
+    # Invalid
+    with pytest.raises(ValidationError):
+        HashModel(hash="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85")
