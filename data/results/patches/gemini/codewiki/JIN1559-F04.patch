+def extract_from_ast_with_metadata(ast):
+    records = []
+    for node in ast.find_all(nodes.Call):
+        if hasattr(node, 'metadata') and node.metadata:
+            # This is a translation block with metadata
+            # We need to extract the messages from this node
+            # The node is a `nodes.Call` to `gettext` or `ngettext`
+            # The messages are in `node.args`
+            messages = []
+            # ... (extract messages)
+            # This is getting complicated.
+            # Maybe I can reuse `extract_from_ast`?
+            pass
+    return records
