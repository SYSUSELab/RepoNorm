+call_end = content.find(')', call_start) + 1
+# Replace the call
+new_call = 'node = self._make_node(\n            singular,\n            plural,\n            variables,\n            plural_expr,\n            bool(referenced),\n            num_called_num and have_plural,\n            self.metadata.copy(),\n        )\n        self.metadata = {}'
