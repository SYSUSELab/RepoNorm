+init_end = content.find('self.environment = environment', init_start) + len('self.environment = environment')
+content = content[:init_end] + '\n        self.metadata = {}' + content[init_end:]
+
+# 2. Update _make_node signature and implementation
+# Find _make_node definition
+def_start = content.find('def _make_node(')
+# Find the end of the signature
+sig_end = content.find('):', def_start) + 2
