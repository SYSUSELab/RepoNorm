diff --git a/update_parse.py b/update_parse.py
new file mode 100644
index 0000000..3a4fafb
--- /dev/null
+++ b/update_parse.py
@@ -0,0 +1,35 @@
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the 'parse' method
+for i, line in enumerate(lines):
+    if 'def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:' in line:
+        # Find the loop that parses the variables
+        for j in range(i + 1, len(lines)):
+            if 'while parser.stream.current.type != "block_end":' in lines[j]:
+                # Insert the metadata handling logic
+                # We need to check if the token is 'note', 'created', or 'modified'
+                # and if it's an assignment.
+                lines.insert(j + 1, '''
+            # metadata
+            if token.value in ("note", "created", "modified"):
+                if parser.stream.current.type != "assign":
+                    parser.fail(f"metadata {token.value!r} requires an assignment.", token.lineno)
+                next(parser.stream)
+                value = parser.parse_expression()
+                if not isinstance(value, nodes.Const):
+                    parser.fail(f"metadata {token.value!r} must be a string literal.", token.lineno)
+                # We need to store this metadata somewhere.
+                # Let's add a 'metadata' attribute to the node.
+                # But we don't have the node yet.
+                # Let's store it in a temporary dictionary.
+                if not hasattr(self, '_temp_metadata'):
+                    self._temp_metadata = {}
+                self._temp_metadata[token.value] = value.value
+                continue
+''')
+                break
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
