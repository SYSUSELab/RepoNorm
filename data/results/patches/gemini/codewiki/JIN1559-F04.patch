--- /dev/null
+++ b/final_apply.py
@@ -0,0 +1,51 @@
+import re
+
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# 1. Add `self.metadata = {}` to `__init__`
+content = content.replace(
+    '    def __init__(self, environment: Environment) -> None:\n        super().__init__(environment)',
+    '    def __init__(self, environment: Environment) -> None:\n        super().__init__(environment)\n        self.metadata = {}'
+)
+
+# 2. Add `extract_translations_with_metadata` to `environment.extend`
+content = content.replace(
+    '            extract_translations=self._extract,',
+    '            extract_translations=self._extract,\n            extract_translations_with_metadata=self._extract_with_metadata,'
+)
+
+# 3. Add `_extract_with_metadata` method
+content = content.replace(
+    '        return extract_from_ast(source, gettext_functions)',
+    '        return extract_from_ast(source, gettext_functions)\n\n    def _extract_with_metadata(\n        self,\n        source: t.Union[str, nodes.Template],\n    ) -> t.Iterator[t.Dict[str, t.Any]]:\n        if isinstance(source, str):\n            source = self.environment.parse(source)\n        return extract_from_ast_with_metadata(source)'
+)
+
+# 4. Add metadata parsing to `parse`
+# Find the `parse` method and insert the metadata parsing logic
+parse_pattern = r'(def parse\(self, parser: "Parser"\) -> t.Union\[nodes.Node, t.List\[nodes.Node\]\]:.*?while parser.stream.current.type != "block_end":)'
+def parse_repl(match):
+    return match.group(0) + '\n            # metadata\n            if parser.stream.current.value in ("note", "created", "modified"):\n                key = next(parser.stream).value\n                parser.stream.expect("assign")\n                value = parser.parse_expression()\n                if not isinstance(value, nodes.Const):\n                    parser.fail("metadata values must be string literals", value.lineno)\n                self.metadata[key] = value.value\n                parser.stream.skip_if("comma")\n                continue'
+
+content = re.sub(parse_pattern, parse_repl, content, flags=re.DOTALL)
+
+# 5. Add `metadata` to `_make_node`
+content = content.replace(
+    '            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)',
+    '            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)\n            node.metadata = self.metadata.copy()'
+)
+content = content.replace(
+    '                None,\n                None,\n            )',
+    '                None,\n                None,\n            )\n            node.metadata = self.metadata.copy()'
+)
+# Reset `self.metadata`
+content = content.replace(
+    '        return node',
+    '        self.metadata = {}\n        return node'
+)
+
+# 6. Add `extract_from_ast_with_metadata` at the end
+content += '\n\ndef extract_from_ast_with_metadata(ast):\n    for node in ast.find_all(nodes.Output):\n        for call in node.find_all(nodes.Call):\n            if hasattr(call, "metadata") and call.metadata:\n                messages = []\n                func_name = call.node.name\n                if func_name == "gettext":\n                    msg = call.args[0].value\n                    messages.append({"lineno": call.lineno, "function": func_name, "message": msg})\n                elif func_name == "ngettext":\n                    msg = (call.args[0].value, call.args[1].value)\n                    messages.append({"lineno": call.lineno, "function": func_name, "message": msg})\n                \n                yield {\n                    "source": "",\n                    "lineno": node.lineno,\n                    "metadata": call.metadata,\n                    "messages": messages\n                }\n'
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
