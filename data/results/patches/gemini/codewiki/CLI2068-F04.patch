--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,28 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+def test_edit_editor_args(runner):
+    import os
+    
+    editor_script = os.path.abspath("test_editor.py")
+    with open(editor_script, "w") as f:
+        f.write("""
+import sys
+# sys.argv[1] is the first editor_arg, sys.argv[2] is the second, etc.
+# The last argument is the filename.
+with open(sys.argv[-1], 'a') as f:
+    f.write(f" {sys.argv[1]} {sys.argv[2]}")
+""")
+    
+    editor_cmd = f"python3 {editor_script}"
+    
+    # click.edit adds a newline to the text if it doesn't have one.
+    # So "initial" becomes "initial\n".
+    # Then the editor appends " --foo --bar".
+    # So the result is "initial\n --foo --bar".
+    
+    result = click.edit("initial", editor=editor_cmd, editor_args=["--foo", "--bar"])
+    assert result == "initial\n --foo --bar"
+    
+    os.remove(editor_script)
