index 0000000..caf68f9
--- /dev/null
+++ b/fix_encode_batch.py
@@ -0,0 +1,57 @@
+with open('tiktoken/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the start of the encode_batch method
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def encode_batch(' in line:
+        start_line = i
+        break
+
+# Find the end of the encode_batch method
+end_line = 0
+for i in range(start_line + 1, len(lines)):
+    if '    def ' in lines[i]:
+        end_line = i
+        break
+
+# Reconstruct the encode_batch method
+new_encode_batch_method = [
+    '    def encode_batch(\n',
+    '        self,\n',
+    '        text: list[str],\n',
+    '        *,\n',
+    '        num_threads: int = 8,\n',
+    '        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006\n',
+    '        disallowed_special: Literal["all"] | Collection[str] = "all",\n',
+    '        validators: list[callable] | None = None,\n',
+    '    ) -> list[list[int]]:\n',
+    '        """Encodes a list of strings into tokens, in parallel.\n',
+    '\n',
+    '        See `encode` for more details on `allowed_special` and `disallowed_special`.\n',
+    '\n',
+    '        ```\n',
+    '        >>> enc.encode_batch(["hello world", "goodbye world"])\n',
+    '        [[31373, 995], [11274, 16390, 995]]\n',
+    '        ```\n',
+    '        """\n',
+    '        if allowed_special == "all":\n',
+    '            allowed_special = self.special_tokens_set\n',
+    '        if disallowed_special == "all":\n',
+    '            disallowed_special = self.special_tokens_set - allowed_special\n',
+    '        if not isinstance(disallowed_special, frozenset):\n',
+    '            disallowed_special = frozenset(disallowed_special)\n',
+    '\n',
+    '        encoder = functools.partial(\n',
+    '            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special, validators=validators\n',
+    '        )\n',
+    '        with ThreadPoolExecutor(num_threads) as e:\n',
+    '            return list(e.map(encoder, text))\n',
+    '\n'
+]
+
+# Replace the old method with the new one
+lines[start_line:end_line] = new_encode_batch_method
+
+with open('tiktoken/core.py', 'w') as f:
+    f.writelines(lines)
