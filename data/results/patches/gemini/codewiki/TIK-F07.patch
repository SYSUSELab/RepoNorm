+++ b/update_encode.py
@@ -0,0 +1,41 @@
+import sys
+
+with open('tiktoken/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the definition of encode
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def encode(' in line:
+        start_line = i
+        break
+
+# Find the end of the arguments
+end_args_line = 0
+for i in range(start_line, len(lines)):
+    if '    ) -> list[int]:' in lines[i]:
+        end_args_line = i
+        break
+
+# Insert validators argument
+lines.insert(end_args_line, '        validators: list[callable] | None = None,\n')
+
+# Find the body of encode
+body_start = end_args_line + 2
+# Find where the actual encoding happens
+for i in range(body_start, len(lines)):
+    if 'return self._core_bpe.encode(text, allowed_special)' in lines[i]:
+        # Insert validation logic
+        lines.insert(i + 1, '''
+        if validators:
+            for validator in validators:
+                # Pass a copy to the validator
+                if not validator(tokens.copy()):
+                    raise ValueError("Token validation failed")
+        ''')
+        # Need to capture tokens first
+        lines[i] = '        tokens = self._core_bpe.encode(text, allowed_special)\n'
+        break
+
+with open('tiktoken/core.py', 'w') as f:
+    f.writelines(lines)
diff --git a/update_encode_batch.py b/update_encode_batch.py
new file mode 100644
index 0000000..134ec1a
--- /dev/null
+++ b/update_encode_batch.py
@@ -0,0 +1,43 @@
+with open('tiktoken/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the start of the encode_batch method
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def encode_batch(' in line:
+        start_line = i
+        break
+
+# Find the end of the arguments
+end_args_line = 0
+for i in range(start_line, len(lines)):
+    if '    ) -> list[list[int]]:' in lines[i]:
+        end_args_line = i
+        break
+
+# Insert validators argument
+lines.insert(end_args_line, '        validators: list[callable] | None = None,\n')
+
+# Find the body of encode_batch
+# It uses ThreadPoolExecutor
+# We need to modify the function that is passed to the executor.
+# The current implementation:
+#        encoder = functools.partial(
+#            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special
+#        )
+#        with ThreadPoolExecutor(num_threads) as e:
+#            return list(e.map(encoder, text))
+
+# Let's find this part
+for i in range(end_args_line, len(lines)):
+    if 'encoder = functools.partial(' in lines[i]:
+        # Update the partial to include validators
+        lines[i] = '        encoder = functools.partial(\n'
+        lines.insert(i + 1, '            self.encode, allowed_special=allowed_special, disallowed_special=disallowed_special, validators=validators\n')
+        lines.insert(i + 2, '        )\n')
+        # Remove the old lines
+        del lines[i+3:i+6]
+        break
+
+with open('tiktoken/core.py', 'w') as f:
+    f.writelines(lines)
