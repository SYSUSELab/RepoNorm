+import tiktoken
+import pytest
+
+def test_encode_batch_validator():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Define a validator that rejects if tokens are too long
+    def validator(tokens):
+        return len(tokens) < 2
+    
+    # This should work
+    tokens = enc.encode_batch(["hello", "world"], validators=[validator])
+    assert len(tokens) == 2
+    
+    # This should fail
+    # "hello world" is 2 tokens, validator requires < 2
+    with pytest.raises(ValueError):
+        enc.encode_batch(["hello world", "world"], validators=[validator])
+
+if __name__ == "__main__":
+    try:
+        test_encode_batch_validator()
+        print("test_encode_batch_validator passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
diff --git a/test_validator_implementation.py b/test_validator_implementation.py
new file mode 100644
index 0000000..96a8e47
--- /dev/null
+++ b/test_validator_implementation.py
@@ -0,0 +1,53 @@
+import tiktoken
+import pytest
+
+def test_validator_acceptance():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Define a validator that accepts
+    def validator(tokens):
+        return True
+    
+    # This should work once implemented
+    tokens = enc.encode("hello world", validators=[validator])
+    assert tokens == enc.encode("hello world")
+
+def test_validator_rejection():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Define a validator that rejects
+    def validator(tokens):
+        return False
+    
+    # This should raise ValueError
+    with pytest.raises(ValueError):
+        enc.encode("hello world", validators=[validator])
+
+def test_validator_mutation_protection():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Define a validator that tries to mutate
+    def validator(tokens):
+        tokens.append(99999)
+        return True
+    
+    original_tokens = enc.encode("hello world")
+    tokens = enc.encode("hello world", validators=[validator])
+    
+    assert tokens == original_tokens
+
+if __name__ == "__main__":
+    # Run tests manually since pytest might not be installed or configured
+    try:
+        test_validator_acceptance()
+        print("test_validator_acceptance passed")
+        
+        test_validator_rejection()
+        print("test_validator_rejection passed")
+        
+        test_validator_mutation_protection()
+        print("test_validator_mutation_protection passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
