diff --git a/tests/test_edit_timeout.py b/tests/test_edit_timeout.py
new file mode 100644
index 0000000..de59554
--- /dev/null
+++ b/tests/test_edit_timeout.py
@@ -0,0 +1,45 @@
+import click
+import pytest
+import os
+import subprocess
+import time
+
+def test_edit_timeout():
+    # Create a slow editor script
+    editor_script = "slow_editor.sh"
+    with open(editor_script, "w") as f:
+        f.write("#!/bin/bash\n")
+        f.write("sleep 5\n")
+        f.write("exit 0\n")
+    os.chmod(editor_script, 0o755)
+    
+    try:
+        # This should raise a ClickException
+        with pytest.raises(click.ClickException) as excinfo:
+            click.edit("hello", editor=f"./{editor_script}", timeout=1)
+        assert "Editing timed out after 1 seconds" in str(excinfo.value)
+    finally:
+        if os.path.exists(editor_script):
+            os.remove(editor_script)
+
+def test_edit_no_timeout():
+    # Create a fast editor script that modifies the file
+    editor_script = "fast_editor.sh"
+    with open(editor_script, "w") as f:
+        f.write("#!/bin/bash\n")
+        f.write("echo 'modified' > \"$1\"\n")
+        f.write("exit 0\n")
+    os.chmod(editor_script, 0o755)
+    
+    try:
+        # This should work
+        result = click.edit("hello", editor=f"./{editor_script}", timeout=5)
+        assert result == "modified\n"
+    finally:
+        if os.path.exists(editor_script):
+            os.remove(editor_script)
+
+def test_invalid_timeout():
+    for invalid_timeout in [0, -1, True, False, 1.5, "2"]:
+        with pytest.raises(ValueError):
+            click.edit("hello", timeout=invalid_timeout)
