diff --git a/tests/test_edit_isolation.py b/tests/test_edit_isolation.py
new file mode 100644
index 0000000..d1a61a7
--- /dev/null
+++ b/tests/test_edit_isolation.py
@@ -0,0 +1,44 @@
+import os
+import unittest.mock as mock
+import click
+import pytest
+
+@pytest.mark.skipif(os.name == "nt", reason="This test is for Unix-like systems.")
+def test_edit_isolation():
+    # Set some environment variables
+    os.environ["SECRET_VAR"] = "secret_value"
+    os.environ["PATH"] = "/usr/bin"
+    
+    with mock.patch("subprocess.Popen") as mocked_popen:
+        mocked_popen.return_value.wait.return_value = 0
+        
+        # Test with isolate_env=True
+        click.edit("test", editor="echo", isolate_env=True)
+        
+        args, kwargs = mocked_popen.call_args
+        env = kwargs.get("env")
+        
+        assert env is not None
+        assert "SECRET_VAR" not in env
+        assert env["PATH"] == "/usr/bin"
+        
+        # Test with isolate_env=False (default)
+        mocked_popen.reset_mock()
+        mocked_popen.return_value.wait.return_value = 0
+        click.edit("test", editor="echo", isolate_env=False)
+        
+        args, kwargs = mocked_popen.call_args
+        env = kwargs.get("env")
+        
+        assert env is None
+
+        # Test with isolate_env=True and custom env
+        mocked_popen.reset_mock()
+        mocked_popen.return_value.wait.return_value = 0
+        click.edit("test", editor="echo", isolate_env=True, env={"CUSTOM_VAR": "custom_value"})
+        
+        args, kwargs = mocked_popen.call_args
+        env = kwargs.get("env")
+        
+        assert env.get("CUSTOM_VAR") == "custom_value"
+        assert "SECRET_VAR" not in env
