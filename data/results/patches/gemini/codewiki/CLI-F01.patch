+import click
+import os
+import sys
+import tempfile
+from click.shell_completion import _resolve_context, _resolve_incomplete
+
+# Create a temporary file to test file completion
+with tempfile.NamedTemporaryFile(delete=False) as f:
+    f.write(b"test")
+    temp_file_path = f.name
+
+@click.group()
+def cli():
+    pass
+
+@cli.command()
+@click.option('--input', type=click.File('r'))
+def cmd(input):
+    pass
+
+# Simulate the completion process
+args = ["cmd", "--input"]
+incomplete = temp_file_path
+
+# 1. Resolve context
+ctx = _resolve_context(cli, {}, "reproduce_issue.py", args)
+
+# 2. Resolve incomplete
+obj, incomplete = _resolve_incomplete(ctx, args, incomplete)
+
+# 3. Get completions
+completions = obj.shell_complete(ctx, incomplete)
+
+# Check if the file is open.
+import os
+open_fds = os.listdir('/proc/self/fd')
+is_open = False
+for fd in open_fds:
+    try:
+        if os.readlink(f'/proc/self/fd/{fd}') == temp_file_path:
+            is_open = True
+            break
+    except OSError:
+        pass
+
+if is_open:
+    print("File is open")
+else:
+    print("File is not open")
+
+# Now, if we don't close the context, it should remain open.
+# The issue is that the context is not closed automatically.
+
+# Cleanup
+os.remove(temp_file_path)
