+
+# 3. Get completions
+completions = obj.shell_complete(ctx, incomplete)
+
+# Check if the file is open.
+import os
+open_fds = os.listdir('/proc/self/fd')
+is_open = False
+for fd in open_fds:
+    try:
+        if os.readlink(f'/proc/self/fd/{fd}') == temp_file_path:
