+import click
+import os
+import sys
+import tempfile
+from click.shell_completion import ShellComplete
+
+# Create a temporary file to test file completion
+with tempfile.NamedTemporaryFile(delete=False) as f:
+    f.write(b"test")
+    temp_file_path = f.name
+
+@click.group()
+def cli():
+    pass
+
+@cli.command()
+@click.option('--input', type=click.File('r'))
+def cmd(input):
+    pass
+
+# We want to simulate the completion process and ensure that the context is closed.
+# The issue is that the context created in _resolve_context is not closed.
+
+# Let's try to reproduce the issue by manually calling _resolve_context
+# and checking if the file is closed.
+
+from click.shell_completion import _resolve_context
+ctx = _resolve_context(cli, {}, "reproduce_issue.py", ["cmd", "--input", temp_file_path])
+
+# Now check if the file is open.
+import os
+open_fds = os.listdir('/proc/self/fd')
+is_open = False
+for fd in open_fds:
+    try:
+        if os.readlink(f'/proc/self/fd/{fd}') == temp_file_path:
+            is_open = True
+            break
+    except OSError:
+        pass
+
+if is_open:
+    print("File is open")
+else:
+    print("File is not open")
+
+# Now close the context
+ctx.close()
+
+# Check again
+open_fds = os.listdir('/proc/self/fd')
+is_open = False
+for fd in open_fds:
+    try:
+        if os.readlink(f'/proc/self/fd/{fd}') == temp_file_path:
+            is_open = True
+            break
+    except OSError:
+        pass
+
+if is_open:
+    print("File is still open after close()")
+else:
+    print("File is closed after close()")
+
+# Cleanup
+os.remove(temp_file_path)
