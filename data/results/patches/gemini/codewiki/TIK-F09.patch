+++ b/test_compress.py
@@ -0,0 +1,29 @@
+import tiktoken
+
+def test_compress():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "The dog dog dog ran ran quickly"
+    
+    # Normal encoding
+    encoded = enc.encode(text)
+    print(f"Normal: {encoded}")
+    
+    # Compressed encoding
+    compressed = enc.encode(text, compress=True)
+    print(f"Compressed: {compressed}")
+    
+    # Verify compression
+    # "dog" is token 3290, " " is 220
+    # "The dog dog dog ran ran quickly"
+    # The tokens for "dog" are 3290.
+    # Let's check the tokens
+    
+    # The test should ensure that consecutive identical tokens are collapsed.
+    # Let's check if the compressed output has no consecutive identical tokens.
+    for i in range(len(compressed) - 1):
+        assert compressed[i] != compressed[i+1], f"Found consecutive identical tokens at {i}: {compressed[i]}"
+
+    print("Compression test passed!")
+
+if __name__ == "__main__":
+    test_compress()
