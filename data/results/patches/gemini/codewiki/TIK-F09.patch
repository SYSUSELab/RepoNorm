diff --git a/fix_methods.py b/fix_methods.py
new file mode 100644
index 0000000..6ca4514
--- /dev/null
+++ b/fix_methods.py
@@ -0,0 +1,45 @@
+import re
+
+with open('tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# Fix `encode_single_token`
+# It should handle both str and bytes.
+# The original `encode_single_token` in `src/py.rs` takes `piece: &[u8]`.
+# So it should be `text_or_bytes: str | bytes`.
+
+new_methods = """
+    def encode_single_token(self, text_or_bytes: str | bytes) -> int:
+        \"\"\"Encodes a single token.
+
+        Raises KeyError if the token is not in the vocabulary.
+        \"\"\"
+        if isinstance(text_or_bytes, str):
+            text_or_bytes = text_or_bytes.encode("utf-8")
+        return self._core_bpe.encode_single_token(text_or_bytes)
+
+    def encode_batch(
+        self,
+        texts: Sequence[str],
+        *,
+        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006
+        disallowed_special: Literal["all"] | Collection[str] = "all",
+        num_threads: int = 8,
+    ) -> list[list[int]]:
+        \"\"\"Encodes a batch of strings into tokens.\"\"\"
+        encoder = functools.partial(
+            self.encode,
+            allowed_special=allowed_special,
+            disallowed_special=disallowed_special,
+        )
+        with ThreadPoolExecutor(num_threads) as e:
+            return list(e.map(encoder, texts))
+"""
+
+# Replace the old `encode_single_token` and `encode_batch`
+# They are currently between `def encode_single_token` and `def _encode_single_piece`
+pattern = re.compile(r'    def encode_single_token.*?    def _encode_single_piece', re.DOTALL)
+new_content = pattern.sub(new_methods + '\n    def _encode_single_piece', content)
+
+with open('tiktoken/core.py', 'w') as f:
+    f.write(new_content)
