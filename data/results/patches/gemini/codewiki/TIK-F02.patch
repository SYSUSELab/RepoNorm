@@ -544,3 +544,34 @@ mod tests {
         assert_eq!(res, vec![b"ab", b"ab"]);
     }
 }
+
+impl CoreBPE {
+    pub fn encode_with_positions(&self, text: &str, allowed_special: &HashSet<&str>) -> (Vec<Rank>, Vec<usize>) {
+        let (tokens, _) = self.encode(text, allowed_special);
+        let mut positions = Vec::with_capacity(tokens.len());
+        let mut text_len = 0;
+        
+        for &token in &tokens {
+            let token_bytes = self.decoder.get(&token).unwrap_or_else(|| {
+                self.special_tokens_decoder.get(&token).unwrap()
+            });
+            
+            let is_continuation = !token_bytes.is_empty() && (0x80 <= token_bytes[0] && token_bytes[0] < 0xC0);
+            let position = if text_len > 0 {
+                if is_continuation {
+                    text_len - 1
+                } else {
+                    text_len
+                }
+            } else {
+                0
+            };
+            positions.push(position);
