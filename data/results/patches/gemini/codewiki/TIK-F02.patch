+++ b/reproduce_issue.py
@@ -0,0 +1,16 @@
+import tiktoken
+
+def test_positions():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello world"
+    
+    # This should fail because return_positions is not supported yet
+    try:
+        tokens, positions = enc.encode(text, return_positions=True)
+        print(f"Tokens: {tokens}")
+        print(f"Positions: {positions}")
+    except TypeError as e:
+        print(f"Caught expected error: {e}")
+
+if __name__ == "__main__":
+    test_positions()
diff --git a/src/lib.rs b/src/lib.rs
index 64dc6a1..dc0c9c5 100644
--- a/src/lib.rs
