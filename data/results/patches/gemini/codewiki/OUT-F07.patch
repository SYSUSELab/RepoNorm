+import torch
+import logging
+from unittest.mock import MagicMock
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+
+# Setup logging to capture warnings
+logging.basicConfig(level=logging.WARNING)
+logger = logging.getLogger()
+
+class MockXGrammarLogitsProcessor:
+    def __init__(self, compiled_grammar):
+        self.compiled_grammar = compiled_grammar
+        self.call_count = 0
+    
+    def __call__(self, input_ids, logits):
+        self.call_count += 1
+        if self.call_count == 1:
+            raise Exception("Primary processor failed")
+        return logits
+
+class FallbackProcessor:
+    def process_logits(self, input_ids, logits):
+        return logits + 1.0
+
+def test_fallback_implementation():
+    # Mocking xgrammar module
+    mock_xgr = MagicMock()
+    
+    class MockFactory:
+        def __init__(self):
+            self.instances = []
+        def __call__(self, compiled_grammar):
+            instance = MockXGrammarLogitsProcessor(compiled_grammar)
+            self.instances.append(instance)
+            return instance
+            
+    mock_factory = MockFactory()
+    mock_xgr.contrib.hf.LogitsProcessor = mock_factory
+    
+    # Create processor with fallback
+    class NewXGrammarLogitsProcessor(XGrammarLogitsProcessor):
+        def __init__(self, compiled_grammar, fallback_processor=None):
+            super().__init__(compiled_grammar)
+            self.fallback_processor = fallback_processor
+            self.use_fallback = False
+            
+        def process_logits(self, input_ids, logits):
+            if self.use_fallback:
+                return self.fallback_processor.process_logits(input_ids, logits)
+            
+            if self.xgrammar_logits_processor is None:
+                self.xgrammar_logits_processor = self.xgr.contrib.hf.LogitsProcessor(
+                    self.compiled_grammar
+                )
+            
+            try:
+                return self.xgrammar_logits_processor(input_ids, logits)
+            except Exception as e:
+                if self.fallback_processor:
+                    logger.warning(f"Primary processor failed, switching to fallback: {e}")
+                    self.use_fallback = True
+                    return self.fallback_processor.process_logits(input_ids, logits)
+                else:
+                    raise e
+        
+        def reset(self):
+            super().reset()
+            self.use_fallback = False
+
+    processor = NewXGrammarLogitsProcessor("compiled_grammar", fallback_processor=FallbackProcessor())
+    processor.xgr = mock_xgr
+    
+    input_ids = torch.tensor([[1]])
+    logits = torch.tensor([[1.0]])
+    
+    # First call: should fail and switch to fallback
+    result1 = processor.process_logits(input_ids, logits)
+    print(f"Result 1: {result1}")
+    
+    # Second call: should use fallback directly
+    result2 = processor.process_logits(input_ids, logits)
+    print(f"Result 2: {result2}")
+    
+    # Reset: should use primary again
+    processor.reset()
+    
+    # First call after reset: should fail again and switch to fallback
+    result3 = processor.process_logits(input_ids, logits)
+    print(f"Result 3: {result3}")
+    
+    # Check if it failed
+    print(f"Number of instances: {len(mock_factory.instances)}")
+    print(f"Instance 0 call count: {mock_factory.instances[0].call_count}")
+    print(f"Instance 1 call count: {mock_factory.instances[1].call_count}")
+
+if __name__ == "__main__":
+    test_fallback_implementation()
