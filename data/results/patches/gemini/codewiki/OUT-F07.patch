+import pytest
+import torch
+from unittest.mock import MagicMock
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+
+class MockXGrammarLogitsProcessor:
+    def __init__(self, compiled_grammar):
+        self.compiled_grammar = compiled_grammar
+        self.call_count = 0
+    
+    def __call__(self, input_ids, logits):
+        self.call_count += 1
+        if self.call_count == 1:
+            raise Exception("Primary processor failed")
+        return logits
+
+class FallbackProcessor:
+    def process_logits(self, input_ids, logits):
+        return logits + 1.0
+
+def test_xgrammar_logits_processor_fallback():
+    # Mocking xgrammar module
+    mock_xgr = MagicMock()
+    mock_xgr.contrib.hf.LogitsProcessor = MockXGrammarLogitsProcessor
+    
+    # Create processor with fallback
+    processor = XGrammarLogitsProcessor("compiled_grammar", fallback_processor=FallbackProcessor())
+    processor.xgr = mock_xgr
+    
+    input_ids = torch.tensor([[1]])
+    logits = torch.tensor([[1.0]])
+    
+    # First call: should fail and switch to fallback
+    result1 = processor.process_logits(input_ids, logits)
+    assert torch.equal(result1, torch.tensor([[2.0]]))
+    
+    # Second call: should use fallback directly
+    result2 = processor.process_logits(input_ids, logits)
+    assert torch.equal(result2, torch.tensor([[2.0]]))
+    
+    # Reset: should use primary again
+    processor.reset()
+    
+    # First call after reset: should fail again and switch to fallback
+    result3 = processor.process_logits(input_ids, logits)
+    assert torch.equal(result3, torch.tensor([[2.0]]))
+
+def test_xgrammar_logits_processor_no_fallback():
+    # Mocking xgrammar module
+    mock_xgr = MagicMock()
+    mock_xgr.contrib.hf.LogitsProcessor = MockXGrammarLogitsProcessor
+    
+    # Create processor without fallback
+    processor = XGrammarLogitsProcessor("compiled_grammar")
+    processor.xgr = mock_xgr
+    
+    input_ids = torch.tensor([[1]])
+    logits = torch.tensor([[1.0]])
+    
+    # First call: should fail
+    with pytest.raises(Exception, match="Primary processor failed"):
+        processor.process_logits(input_ids, logits)
