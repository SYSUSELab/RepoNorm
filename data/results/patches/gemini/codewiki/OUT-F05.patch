@@ -0,0 +1,28 @@
+import pytest
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+from outlines.processors.tensor_adapters.base import TensorAdapter
+
+class CustomAdapter(TensorAdapter):
+    def shape(self, tensor):
+        return tensor.shape
+    def unsqueeze(self, tensor):
+        import torch
+        return tensor.unsqueeze(0)
+    def squeeze(self, tensor):
+        import torch
+        return tensor.squeeze(0)
+
+def test_custom_adapter_injection():
+    # This should fail currently as XGrammarLogitsProcessor doesn't support custom adapter
+    try:
+        processor = XGrammarLogitsProcessor(
+            compiled_grammar="root ::= 'a'",
+            tensor_library_name="custom",
+            custom_adapter=CustomAdapter()
+        )
+        print("Successfully created processor with custom adapter")
+    except Exception as e:
+        print(f"Failed to create processor: {e}")
+
+if __name__ == "__main__":
+    test_custom_adapter_injection()
