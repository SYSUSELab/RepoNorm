@@ -0,0 +1,21 @@
+import torch
+from outlines.processors.tensor_adapters.torch import TorchTensorAdapter
+
+def test_torch_adapter():
+    adapter = TorchTensorAdapter()
+    t = torch.tensor([1, 2, 3])
+    print(f"Shape: {adapter.shape(t)}")
+    print(f"Unsqueeze: {adapter.unsqueeze(t)}")
+    print(f"Squeeze: {adapter.squeeze(adapter.unsqueeze(t))}")
+    print(f"To list: {adapter.to_list(t)}")
+    print(f"To scalar: {adapter.to_scalar(torch.tensor([1]))}")
+    print(f"Full like: {adapter.full_like(t, 0)}")
+    print(f"Concatenate: {adapter.concatenate([t, t])}")
+    print(f"Device: {adapter.get_device(t)}")
+    print(f"To device: {adapter.to_device(t, 'cpu')}")
+    print(f"Boolean ones like: {adapter.boolean_ones_like(t)}")
+    print(f"Apply mask: {adapter.apply_mask(t, torch.tensor([True, False, True]), -1e9)}")
+    print(f"Argsort descending: {adapter.argsort_descending(t)}")
+
+if __name__ == "__main__":
+    test_torch_adapter()
diff --git a/test_fix.py b/test_fix.py
new file mode 100644
index 0000000..08e0446
--- /dev/null
+++ b/test_fix.py
@@ -0,0 +1,58 @@
+import pytest
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+from outlines.processors.tensor_adapters.base import TensorAdapter
+from typing import Any, Union
+
+class CustomAdapter(TensorAdapter):
+    library_name = "custom"
+    def shape(self, tensor): return tensor.shape
+    def unsqueeze(self, tensor): return tensor.unsqueeze(0)
+    def squeeze(self, tensor): return tensor.squeeze(0)
+    def to_list(self, tensor): return tensor.tolist()
+    def to_scalar(self, tensor): return tensor.item()
+    def full_like(self, tensor, fill_value): return tensor.new_full(tensor.shape, fill_value)
+    def concatenate(self, tensors): import torch; return torch.cat(tensors, dim=0)
+    def get_device(self, tensor): return tensor.device
+    def to_device(self, tensor, device): return tensor.to(device)
+    def boolean_ones_like(self, tensor): return tensor.new_ones(tensor.shape, dtype=bool)
+    def apply_mask(self, tensor, mask, value): return tensor.masked_fill(mask, value)
+    def argsort_descending(self, tensor): return tensor.argsort(descending=True)
+
+def test_custom_adapter_injection():
+    # Test valid custom adapter
+    try:
+        processor = XGrammarLogitsProcessor(
+            compiled_grammar="root ::= 'a'",
+            tensor_library_name="custom",
+            custom_adapter=CustomAdapter()
+        )
+        assert processor.tensor_adapter.library_name == "custom"
+        print("Successfully created processor with custom adapter")
+    except Exception as e:
+        print(f"Failed to create processor: {e}")
+        raise
+
+    # Test invalid combination: custom library without adapter
+    try:
+        XGrammarLogitsProcessor(
+            compiled_grammar="root ::= 'a'",
+            tensor_library_name="custom",
+            custom_adapter=None
+        )
+        print("Failed to raise ValueError for missing custom adapter")
+    except ValueError:
+        print("Successfully raised ValueError for missing custom adapter")
+
+    # Test invalid combination: adapter with non-custom library
+    try:
+        XGrammarLogitsProcessor(
+            compiled_grammar="root ::= 'a'",
+            tensor_library_name="torch",
+            custom_adapter=CustomAdapter()
+        )
+        print("Failed to raise ValueError for adapter with non-custom library")
+    except ValueError:
+        print("Successfully raised ValueError for adapter with non-custom library")
+
+if __name__ == "__main__":
+    test_custom_adapter_injection()
