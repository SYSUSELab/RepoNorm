+with open("outlines/backends/xgrammar.py", "r") as f:
+    lines = f.readlines()
+
+# Fix imports
+new_lines = []
+for line in lines:
+    if "from outlines.processors.base_logits_processor import (" in line:
+        new_lines.append("from outlines.processors.base_logits_processor import (\n")
+        new_lines.append("    OutlinesLogitsProcessor,\n")
+        new_lines.append("    TensorType,\n")
+        new_lines.append(")\n")
+        new_lines.append("from outlines.processors.tensor_adapters.base import TensorAdapter\n")
+    elif "    OutlinesLogitsProcessor," in line or "    TensorType" in line or ")" in line and "from outlines.processors.base_logits_processor import" in "".join(lines[lines.index(line)-3:lines.index(line)+1]):
+        continue
+    else:
+        new_lines.append(line)
+
+# Fix factory methods
+final_lines = []
+for line in new_lines:
+    if "def get_json_schema_logits_processor(" in line:
+        final_lines.append(line.replace("    def get_json_schema_logits_processor(\n        self, json_schema: str\n    ) -> \"LogitsProcessor\":", 
+                                        "    def get_json_schema_logits_processor(\n        self,\n        json_schema: str,\n        tensor_library_name: str = \"torch\",\n        custom_adapter: Optional[\"TensorAdapter\"] = None,\n    ) -> \"LogitsProcessor\":\n"))
+    elif "def get_regex_logits_processor(" in line:
+        final_lines.append(line.replace("    def get_regex_logits_processor(self, regex: str) -> \"LogitsProcessor\":",
+                                        "    def get_regex_logits_processor(\n        self,\n        regex: str,\n        tensor_library_name: str = \"torch\",\n        custom_adapter: Optional[\"TensorAdapter\"] = None,\n    ) -> \"LogitsProcessor\":\n"))
+    elif "def get_cfg_logits_processor(" in line:
+        final_lines.append(line.replace("    def get_cfg_logits_processor(self, grammar: str) -> \"LogitsProcessor\":",
+                                        "    def get_cfg_logits_processor(\n        self,\n        grammar: str,\n        tensor_library_name: str = \"torch\",\n        custom_adapter: Optional[\"TensorAdapter\"] = None,\n    ) -> \"LogitsProcessor\":\n"))
+    else:
+        final_lines.append(line)
+
+with open("outlines/backends/xgrammar.py", "w") as f:
+    f.writelines(final_lines)
