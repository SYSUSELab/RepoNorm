diff --git a/tests/backends/test_xgrammar_validation.py b/tests/backends/test_xgrammar_validation.py
new file mode 100644
index 0000000..523b21c
--- /dev/null
+++ b/tests/backends/test_xgrammar_validation.py
@@ -0,0 +1,61 @@
+import pytest
+from unittest.mock import MagicMock, patch
+from outlines.backends.xgrammar import XGrammarBackend
+from outlines.models.transformers import Transformers
+
+@pytest.fixture
+def mock_model():
+    model = MagicMock(spec=Transformers)
+    model.model = MagicMock()
+    model.model.config = MagicMock()
+    model.model.config._name_or_path = "gpt2"
+    model.hf_tokenizer = MagicMock()
+    return model
+
+def test_xgrammar_validation_callback(mock_model):
+    # Mock xgrammar
+    import sys
+    from unittest.mock import MagicMock
+    mock_xgrammar = MagicMock()
+    sys.modules["xgrammar"] = mock_xgrammar
+    
+    # Mock transformers.AutoConfig
+    import transformers
+    mock_auto_config = MagicMock()
+    mock_auto_config.from_pretrained.return_value.vocab_size = 50257
+    
+    with patch("transformers.AutoConfig", mock_auto_config):
+        
+        # 1. Test default validation
+        validation_called = False
+        def validator(grammar):
+            nonlocal validation_called
+            validation_called = True
+            if grammar == "invalid":
+                raise ValueError("Invalid grammar")
+
+        backend = XGrammarBackend(mock_model, validate_grammar=validator)
+        
+        # Test valid grammar
+        backend.get_regex_logits_processor("valid")
+        assert validation_called is True
+        
+        # Test invalid grammar
+        validation_called = False
+        with pytest.raises(ValueError, match="Invalid grammar"):
+            backend.get_regex_logits_processor("invalid")
+        assert validation_called is True
+        
+        # 2. Test override validation
+        validation_called = False
+        def override_validator(grammar):
+            nonlocal validation_called
+            validation_called = True
+            
+        backend.get_regex_logits_processor("valid", validate_grammar=override_validator)
+        assert validation_called is True
+        
+        # 3. Test disable validation
+        validation_called = False
+        backend.get_regex_logits_processor("valid", validate_grammar=None)
+        assert validation_called is False
