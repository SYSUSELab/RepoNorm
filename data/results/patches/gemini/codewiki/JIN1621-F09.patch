+import os
+import threading
+import time
+from jinja2 import Environment, FileSystemLoader
+
+# Create a temporary directory for templates
+os.makedirs("templates", exist_ok=True)
+with open("templates/test.html", "w") as f:
+    f.write("Hello World")
+
+# Create an environment with FileSystemLoader
+try:
+    loader = FileSystemLoader("templates", auto_reload=True)
+    env = Environment(loader=loader)
+    
+    # Load the template
+    template = env.get_template("test.html")
+    print(f"Initial content: {template.render()}")
+    
+    # Modify the template
+    with open("templates/test.html", "w") as f:
+        f.write("Hello Updated World")
+    
+    # Wait for the monitor to pick up the change (0.5s interval + some buffer)
+    time.sleep(1.5)
+    
+    # Load the template again
+    template = env.get_template("test.html")
+    print(f"Updated content: {template.render()}")
+    
+    loader.close()
+except Exception as e:
+    import traceback
+    traceback.print_exc()
+finally:
+    # Cleanup
+    import shutil
+    shutil.rmtree("templates")
