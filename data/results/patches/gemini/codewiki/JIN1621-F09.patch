+import os
+
+file_path = 'src/jinja2/loaders.py'
+with open(file_path, 'r') as f:
+    content = f.read()
+
+# Add imports
+new_imports = """import threading
+import time
+"""
+content = new_imports + content
+
+# Update __init__
+old_init = """    def __init__(
+        self,
+        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        self.searchpath = [os.fspath(p) for p in searchpath]
+        self.encoding = encoding
+        self.followlinks = followlinks"""
+
+new_init = """    def __init__(
+        self,
+        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+        auto_reload: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        self.searchpath = [os.fspath(p) for p in searchpath]
+        self.encoding = encoding
+        self.followlinks = followlinks
+        self.auto_reload = auto_reload
+        self._monitor = None
+        self._environments = weakref.WeakSet()
+        if auto_reload:
+            self.start_monitoring()"""
+
+content = content.replace(old_init, new_init)
+
+# Add new methods
+new_methods = """
+    def start_monitoring(self) -> None:
+        if self._monitor is not None:
+            return
+        self._monitor = _TemplateMonitor(self)
+        self._monitor.start()
+
+    def close(self) -> None:
+        if self._monitor is None:
+            return
+        self._monitor.stop()
+        self._monitor = None
+
+    def __enter__(self) -> "FileSystemLoader":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+    def invalidate_changed(self, paths: t.Iterable[str]) -> t.List[str]:
+        paths = {os.path.abspath(p) for p in paths}
+        invalidated = []
+        for env in self._environments:
+            for name, template in env.cache.items():
+                if template.filename and os.path.abspath(template.filename) in paths:
+                    env.cache.pop(name, None)
+                    invalidated.append(name)
+        return invalidated
+"""
+
+# Insert new methods after __init__
+# Find the end of __init__
+import re
+match = re.search(r'self.followlinks = followlinks\n', content)
+if match:
+    pos = match.end()
+    content = content[:pos] + new_methods + content[pos:]
+
+# Add _TemplateMonitor class
+monitor_class = """
+class _TemplateMonitor(threading.Thread):
+    def __init__(self, loader: "FileSystemLoader") -> None:
+        super().__init__(daemon=True)
+        self.loader = loader
+        self._stop_event = threading.Event()
+        self._last_mtimes = {}
+
+    def run(self) -> None:
+        while not self._stop_event.is_set():
+            self._scan()
+            time.sleep(0.5)
+
+    def stop(self) -> None:
+        self._stop_event.set()
+        self.join()
+
+    def _scan(self) -> None:
