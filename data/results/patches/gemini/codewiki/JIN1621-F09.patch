+import os
+import time
+from jinja2 import Environment, FileSystemLoader
+
+# Create a temporary directory for templates
+os.makedirs("templates", exist_ok=True)
+with open("templates/test.html", "w") as f:
+    f.write("Hello World")
+
+# Create an environment with FileSystemLoader
+loader = FileSystemLoader("templates")
+env = Environment(loader=loader)
+
+# Load the template
+template = env.get_template("test.html")
+print(f"Initial content: {template.render()}")
+
+# Modify the template
+with open("templates/test.html", "w") as f:
+    f.write("Hello Updated World")
+
+# The current FileSystemLoader does not proactively invalidate the cache.
+# We expect the template to still show "Hello World" if we don't use auto_reload=True
+# But the task is to implement proactive invalidation.
+
+# Let's see if we can trigger the new functionality.
+# The task says: FileSystemLoader(..., auto_reload=True)
+# Let's try to use it.
+
+try:
+    loader = FileSystemLoader("templates", auto_reload=True)
+    print("Successfully initialized FileSystemLoader with auto_reload=True")
+except TypeError as e:
+    print(f"Failed to initialize FileSystemLoader with auto_reload=True: {e}")
+
+# Cleanup
+import shutil
+shutil.rmtree("templates")
