+import os
+
+file_path = 'src/jinja2/loaders.py'
+with open(file_path, 'r') as f:
+    content = f.read()
+
+# Fix invalidate_changed to use del env.cache[name] instead of env.cache.pop(name, None)
+# because LRUCache doesn't have pop()
+old_invalidate = """    def invalidate_changed(self, paths: t.Iterable[str]) -> t.List[str]:
+        paths = {os.path.abspath(p) for p in paths}
+        invalidated = []
+        for env in self._environments:
+            for name, template in env.cache.items():
+                if template.filename and os.path.abspath(template.filename) in paths:
+                    env.cache.pop(name, None)
+                    invalidated.append(name)
+        return invalidated"""
+
+new_invalidate = """    def invalidate_changed(self, paths: t.Iterable[str]) -> t.List[str]:
+        paths = {os.path.abspath(p) for p in paths}
+        invalidated = []
+        for env in self._environments:
+            if env.cache is None:
+                continue
+            for name, template in list(env.cache.items()):
+                if template.filename and os.path.abspath(template.filename) in paths:
+                    try:
+                        del env.cache[name]
+                    except KeyError:
+                        continue
+                    invalidated.append(name)
+        return invalidated"""
+
+content = content.replace(old_invalidate, new_invalidate)
+
+with open(file_path, 'w') as f:
+    f.write(content)
