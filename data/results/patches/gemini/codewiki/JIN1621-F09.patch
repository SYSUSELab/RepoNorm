+++ b/tests/test_auto_reload.py
@@ -0,0 +1,47 @@
+import os
+import time
+import pytest
+from jinja2 import Environment, FileSystemLoader
+
+def test_auto_reload(tmp_path):
+    templates_dir = tmp_path / "templates"
+    templates_dir.mkdir()
+    template_file = templates_dir / "test.html"
+    template_file.write_text("Hello World")
+
+    loader = FileSystemLoader(str(templates_dir), auto_reload=True)
+    env = Environment(loader=loader, cache_size=10)
+    
+    template = env.get_template("test.html")
+    assert template.render() == "Hello World"
+    
+    template_file.write_text("Hello Updated World")
+    
+    # Wait for the monitor to pick up the change
+    time.sleep(1)
+    
+    template = env.get_template("test.html")
+    assert template.render() == "Hello Updated World"
+    
+    loader.close()
+
+def test_auto_reload_disabled(tmp_path):
+    templates_dir = tmp_path / "templates"
+    templates_dir.mkdir()
+    template_file = templates_dir / "test.html"
+    template_file.write_text("Hello World")
+
+    loader = FileSystemLoader(str(templates_dir), auto_reload=False)
+    env = Environment(loader=loader, cache_size=10)
+    
+    template = env.get_template("test.html")
+    assert template.render() == "Hello World"
+    
+    template_file.write_text("Hello Updated World")
+    
+    # Wait for the monitor to pick up the change
+    time.sleep(1)
+    
+    template = env.get_template("test.html")
+    # Should still be "Hello World" because auto_reload is False
+    assert template.render() == "Hello World"
