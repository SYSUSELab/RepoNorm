+import os
+
+file_path = 'src/jinja2/loaders.py'
+with open(file_path, 'r') as f:
+    lines = f.readlines()
+
+# Find the __init__ method and fix it
+# The current __init__ is broken because the assignments are after the methods
+# Let's rewrite the whole FileSystemLoader class to be sure.
+
+# Actually, let's just read the file and reconstruct it properly.
+# The previous attempt to use sed/replace was not robust enough.
+
+# Let's read the file and find the FileSystemLoader class
+start_line = -1
+for i, line in enumerate(lines):
+    if line.startswith('class FileSystemLoader(BaseLoader):'):
+        start_line = i
+        break
+
+# Find the end of the class
+end_line = -1
+for i in range(start_line, len(lines)):
+    if lines[i].startswith('class PackageLoader(BaseLoader):'):
+        end_line = i
+        break
+
+# Reconstruct the class
+new_class = """class FileSystemLoader(BaseLoader):
+    \"\"\"Load templates from a directory in the file system.
+
+    The path can be relative or absolute. Relative paths are relative to
+    the current working directory.
+
+    .. code-block:: python
+
+        loader = FileSystemLoader("templates")
+
+    A list of paths can be given. The directories will be searched in
+    order, stopping at the first matching template.
+
+    .. code-block:: python
+
+        loader = FileSystemLoader(["/override/templates", "/default/templates"])
+
+    :param searchpath: A path, or list of paths, to the directory that
+        contains the templates.
+    :param encoding: Use this encoding to read the text from template
+        files.
+    :param followlinks: Follow symbolic links in the path.
+
+    .. versionchanged:: 2.8
+        Added the ``followlinks`` parameter.
+    \"\"\"
+
+    def __init__(
+        self,
+        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+        auto_reload: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        self.searchpath = [os.fspath(p) for p in searchpath]
+        self.encoding = encoding
+        self.followlinks = followlinks
+        self.auto_reload = auto_reload
+        self._monitor = None
+        self._environments = weakref.WeakSet()
+        if auto_reload:
+            self.start_monitoring()
+
+    def start_monitoring(self) -> None:
+        if self._monitor is not None:
+            return
+        self._monitor = _TemplateMonitor(self)
+        self._monitor.start()
+
+    def close(self) -> None:
+        if self._monitor is None:
+            return
+        self._monitor.stop()
+        self._monitor = None
+
+    def __enter__(self) -> "FileSystemLoader":
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback) -> None:
+        self.close()
+
+    def invalidate_changed(self, paths: t.Iterable[str]) -> t.List[str]:
+        paths = {os.path.abspath(p) for p in paths}
+        invalidated = []
+        for env in self._environments:
+            for name, template in env.cache.items():
+                if template.filename and os.path.abspath(template.filename) in paths:
+                    env.cache.pop(name, None)
+                    invalidated.append(name)
+        return invalidated
+
+    def get_source(
+        self, environment: "Environment", template: str
+    ) -> t.Tuple[str, str, t.Callable[[], bool]]:
+        self._environments.add(environment)
+        pieces = split_template_path(template)
+        for searchpath in self.searchpath:
+            filename = os.path.join(searchpath, *pieces)
+            f = open_if_exists(filename)
+            if f is None:
+                continue
+            try:
+                contents = f.read().decode(self.encoding)
+            finally:
+                f.close()
+
+            mtime = os.path.getmtime(filename)
+
+            def uptodate() -> bool:
+                try:
+                    return os.path.getmtime(filename) == mtime
+                except OSError:
+                    return False
+
+            return contents, filename, uptodate
+        raise TemplateNotFound(template)
+
+    def list_templates(self) -> t.List[str]:
+        found = set()
+        for searchpath in self.searchpath:
+            walk_dir = os.walk(searchpath, followlinks=self.followlinks)
+            for dirpath, _, filenames in walk_dir:
+                for filename in filenames:
+                    template = (
+                        os.path.join(dirpath, filename)[len(searchpath) :]
+                        .strip(os.path.sep)
+                        .replace(os.path.sep, "/")
+                    )
+                    if template[:2] == "./":
+                        template = template[2:]
+                    if template not in found:
+                        found.add(template)
+        return sorted(found)
+"""
+
+lines[start_line:end_line] = [new_class + "\n"]
+
+with open(file_path, 'w') as f:
+    f.writelines(lines)
