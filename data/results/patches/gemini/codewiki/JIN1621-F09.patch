@@ -0,0 +1,41 @@
+import os
+import time
+from jinja2 import Environment, FileSystemLoader
+
+# Create a temporary directory for templates
+os.makedirs("templates", exist_ok=True)
+with open("templates/test.html", "w") as f:
+    f.write("Hello World")
+
+# Test 1: auto_reload=False
+# We need to disable the cache to see the change if auto_reload is False
+# But the task is about invalidating the cache.
+# If we don't disable the cache, it will return the cached template.
+# Let's disable the cache for this test.
+loader = FileSystemLoader("templates", auto_reload=False)
+env = Environment(loader=loader, cache_size=0)
+template = env.get_template("test.html")
+print(f"Initial content: {template.render()}")
+with open("templates/test.html", "w") as f:
+    f.write("Hello Updated World")
+time.sleep(1)
+template = env.get_template("test.html")
+print(f"Content with auto_reload=False: {template.render()}")
+# Should be "Hello Updated World" because cache is disabled
+
+# Test 2: auto_reload=True
+# Here we want to see the cache being invalidated.
+loader2 = FileSystemLoader("templates", auto_reload=True)
+env2 = Environment(loader=loader2, cache_size=10)
+template2 = env2.get_template("test.html")
+print(f"Initial content 2: {template2.render()}")
+with open("templates/test.html", "w") as f:
+    f.write("Hello Updated World 2")
+time.sleep(1)
+template2 = env2.get_template("test.html")
+print(f"Content 2 after wait: {template2.render()}")
+loader2.close()
+
+# Cleanup
+import shutil
+shutil.rmtree("templates")
