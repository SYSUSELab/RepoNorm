+import sys
+
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# 1. Add validate_nesting to __init__ signature
+# Find the __init__ method
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def __init__(' in line:
+        start_line = i
+        break
+
+# Find the end of the __init__ signature
+end_signature = 0
+for i in range(start_line, len(lines)):
+    if '    ) -> None:' in lines[i]:
+        end_signature = i
+        break
+
+lines.insert(end_signature, '        validate_nesting: bool = False,\n')
+
+# 2. Initialize self.validate_nesting and self.children
+# Find where to initialize self.parent = parent
+for i in range(end_signature + 1, len(lines)):
+    if 'self.parent = parent' in lines[i]:
+        lines.insert(i + 1, '        self.validate_nesting = validate_nesting\n')
+        lines.insert(i + 2, '        if self.parent is not None:\n')
+        lines.insert(i + 3, '            self.validate_nesting = self.parent.validate_nesting\n')
+        lines.insert(i + 4, '        self.children: list[Context] = []\n')
+        lines.insert(i + 5, '        if self.parent is not None:\n')
+        lines.insert(i + 6, '            self.parent.children.append(self)\n')
+        break
+
+# 3. Update close()
+# Find the close method
+start_line = 0
+for i, line in enumerate(lines):
+    if '    def close(self) -> None:' in line:
+        start_line = i
+        break
+
+# Find the end of the docstring
+docstring_end = 0
+for i in range(start_line, len(lines)):
+    if '        """' in lines[i]:
+        docstring_end = i
+        break
+
+# Insert the validation logic after the docstring
+lines.insert(docstring_end + 1, '        if self.validate_nesting and self.children:\n')
+lines.insert(docstring_end + 2, '            raise RuntimeError(f"The context {self.info_name!r} cannot be closed because it has open children: {self.children!r}")\n')
+
+# Find where to remove from parent's children
+for i in range(docstring_end + 3, len(lines)):
+    if 'self._exit_stack.close()' in lines[i]:
+        lines.insert(i + 1, '        if self.parent is not None:\n')
+        lines.insert(i + 2, '            try:\n')
+        lines.insert(i + 3, '                self.parent.children.remove(self)\n')
+        lines.insert(i + 4, '            except ValueError:\n')
+        lines.insert(i + 5, '                pass\n')
+        break
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(lines)
