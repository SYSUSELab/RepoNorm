new file mode 100644
index 0000000..f8f9c81
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,24 @@
+import click
+from click.core import Context
+
+def test_nesting_validation():
+    # Create a parent context
+    parent = Context(click.Command("parent"), validate_nesting=True)
+    
+    # Create a child context
+    child = Context(click.Command("child"), parent=parent)
+    
+    # Try to close the parent while the child is still open
+    try:
+        parent.close()
+        print("Parent closed successfully (unexpected)")
+    except RuntimeError as e:
+        print(f"Caught expected error: {e}")
+    except Exception as e:
+        print(f"Caught unexpected error: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    try:
+        test_nesting_validation()
+    except TypeError as e:
+        print(f"Caught expected TypeError during initialization: {e}")
