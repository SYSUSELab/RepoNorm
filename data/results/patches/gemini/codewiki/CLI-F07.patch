+import sys
+
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the close method
+start_line = 0
+for i, line in enumerate(lines):
+    if '    def close(self) -> None:' in line:
+        start_line = i
+        break
+
+# Find the end of the docstring
+docstring_end = 0
+for i in range(start_line, len(lines)):
+    if '        """' in lines[i]:
+        docstring_end = i
+        break
+
+# Remove the old body of the close method
+# The body starts after the docstring
+# Let's find the end of the body
+body_end = 0
+for i in range(docstring_end + 1, len(lines)):
+    if '    @property' in lines[i]:
+        body_end = i
+        break
+
+# Remove the old body
+del lines[docstring_end + 1 : body_end]
+
+# Insert the new body
+new_body = [
+    '        if self.validate_nesting and self.children:\n',
+    '            raise RuntimeError(f"The context {self.info_name!r} cannot be closed because it has open children: {self.children!r}")\n',
+    '        self._exit_stack.close()\n',
+    '        if self.parent is not None:\n',
+    '            try:\n',
+    '                self.parent.children.remove(self)\n',
+    '            except ValueError:\n',
+    '                pass\n',
+    '        # In case the context is reused, create a new exit stack.\n',
+    '        self._exit_stack = ExitStack()\n'
+]
+lines[docstring_end + 1 : docstring_end + 1] = new_body
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(lines)
