+# 1. Add validate_nesting to __init__ signature
+# Find the __init__ method
+init_def = '    def __init__(\n'
+init_end = '    ) -> None:\n'
+init_start_idx = content.find(init_def)
+init_end_idx = content.find(init_end, init_start_idx)
+
+# Insert validate_nesting
+new_content = content[:init_end_idx] + '        validate_nesting: bool = False,\n' + content[init_end_idx:]
+
+# 2. Initialize self.validate_nesting and self.children
+# Find where to initialize self.parent = parent
+parent_init = '        self.parent = parent\n'
+parent_init_idx = new_content.find(parent_init)
+parent_init_end_idx = parent_init_idx + len(parent_init)
+
+new_content = (
+    new_content[:parent_init_end_idx] +
+    '        self.validate_nesting = validate_nesting\n' +
+    '        if self.parent is not None:\n' +
+    '            self.validate_nesting = self.parent.validate_nesting\n' +
+    '        self.children: list[Context] = []\n' +
+    '        if self.parent is not None:\n' +
+    '            self.parent.children.append(self)\n' +
+    new_content[parent_init_end_idx:]
+)
+
+# 3. Update close()
+# Find the close method
+close_def = '    def close(self) -> None:\n'
+close_start_idx = new_content.find(close_def)
+docstring_start_idx = new_content.find('"""', close_start_idx)
+docstring_end_idx = new_content.find('"""', docstring_start_idx + 3) + 3
+
+# Insert the validation logic after the docstring
+new_content = (
+    new_content[:docstring_end_idx] +
+    '\n        if self.validate_nesting and self.children:\n' +
+    '            raise RuntimeError(f"The context {self.info_name!r} cannot be closed because it has open children: {self.children!r}")\n' +
+    new_content[docstring_end_idx:]
+)
+
+# Find where to remove from parent's children
+exit_stack_close = '        self._exit_stack.close()\n'
+exit_stack_close_idx = new_content.find(exit_stack_close, docstring_end_idx)
+exit_stack_close_end_idx = exit_stack_close_idx + len(exit_stack_close)
+
+new_content = (
+    new_content[:exit_stack_close_end_idx] +
+    '        if self.parent is not None:\n' +
+    '            try:\n' +
+    '                self.parent.children.remove(self)\n' +
+    '            except ValueError:\n' +
+    '                pass\n' +
+    new_content[exit_stack_close_end_idx:]
+)
+
+with open('src/click/core.py', 'w') as f:
+    f.write(new_content)
