diff --git a/test_nesting.py b/test_nesting.py
new file mode 100644
index 0000000..4095841
--- /dev/null
+++ b/test_nesting.py
@@ -0,0 +1,40 @@
+import click
+from click.core import Context
+
+def test_default_disabled():
+    parent = Context(click.Command("parent"))
+    child = Context(click.Command("child"), parent=parent)
+    parent.close()
+    print("Default disabled: passed")
+
+def test_inheritance():
+    parent = Context(click.Command("parent"), validate_nesting=True)
+    child = Context(click.Command("child"), parent=parent)
+    assert child.validate_nesting is True
+    print("Inheritance: passed")
+
+def test_child_removal():
+    parent = Context(click.Command("parent"), validate_nesting=True)
+    child = Context(click.Command("child"), parent=parent)
+    child.close()
+    parent.close()
+    print("Child removal: passed")
+
+def test_multiple_children():
+    parent = Context(click.Command("parent"), validate_nesting=True)
+    child1 = Context(click.Command("child1"), parent=parent)
+    child2 = Context(click.Command("child2"), parent=parent)
+    try:
+        parent.close()
+    except RuntimeError as e:
+        print(f"Multiple children: caught expected error: {e}")
+    child1.close()
+    child2.close()
+    parent.close()
+    print("Multiple children: passed")
+
+if __name__ == "__main__":
+    test_default_disabled()
+    test_inheritance()
+    test_child_removal()
+    test_multiple_children()
