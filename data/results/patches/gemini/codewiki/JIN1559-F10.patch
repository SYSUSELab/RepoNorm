+from jinja2 import Environment
+
+class MyEnv(Environment):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.my_dict = {}
+
+    def overlay(self, *args, **kwargs):
+        rv = super().overlay(*args, **kwargs)
+        rv.my_dict = self.my_dict.copy()
+        return rv
+
+def test_env_overlay_init():
+    env = MyEnv()
+    env.my_dict["a"] = 1
+    
+    overlay = env.overlay()
+    assert overlay.my_dict == {"a": 1}
