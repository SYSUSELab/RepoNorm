+++ b/test_env_extend.py
@@ -0,0 +1,25 @@
+from jinja2 import Environment
+
+def test_env_extend():
+    env = Environment()
+    
+    def my_func():
+        return "hello"
+        
+    env.extend(my_func=my_func)
+    assert env.my_func() == "hello"
+    
+    overlay = env.overlay()
+    assert overlay.my_func() == "hello"
+    
+    def my_func_new():
+        return "world"
+        
+    overlay.extend(my_func=my_func_new)
+    assert overlay.my_func() == "world"
+    assert env.my_func() == "hello"
+    
+    print("Test passed")
+
+if __name__ == "__main__":
+    test_env_extend()
