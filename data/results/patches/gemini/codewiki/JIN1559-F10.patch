+import sys
+
+# Read the file
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the InternationalizationExtension class
+# and add the methods
+# We need to add the methods to the class or to the environment in __init__
+# Let's add them as methods to InternationalizationExtension and then extend the environment
+
+new_methods = """
+    def _set_translation_version(self, message, version):
+        self.environment.translation_versions[message] = version
+
+    def _get_translation_version(self, message):
+        return self.environment.translation_versions.get(message)
+
+    def _compare_translation_versions(self, message1, message2):
+        v1 = self.environment.translation_versions.get(message1)
+        v2 = self.environment.translation_versions.get(message2)
+        return v1 is not None and v2 is not None and v1 == v2
+
+    def _remove_translation_version(self, message):
+        self.environment.translation_versions.pop(message, None)
+
+    def _clear_translation_versions(self):
+        self.environment.translation_versions.clear()
+"""
+
+# Find where to insert these methods in InternationalizationExtension
+# Let's insert them after __init__
+insert_pos = 0
+for i, line in enumerate(lines):
+    if 'def __init__(self, environment: Environment) -> None:' in line:
+        # Find the end of __init__
+        for j in range(i, len(lines)):
+            if '        )' in lines[j]:
+                insert_pos = j + 1
+                break
+        break
+
+lines.insert(insert_pos, new_methods)
+
+# Now update __init__ to initialize translation_versions and extend the environment
+# Actually, we need to make sure translation_versions is initialized on the environment
+# Let's modify __init__ to initialize translation_versions if it doesn't exist
+# Wait, the environment is passed to __init__.
+# Let's modify __init__ to add the methods to the environment.
+
+# Let's find __init__ again and modify it
+for i, line in enumerate(lines):
+    if 'def __init__(self, environment: Environment) -> None:' in line:
+        # Add initialization of translation_versions
+        lines.insert(i + 2, '        environment.translation_versions = {}\n')
+        # Add the methods to environment.extend
+        for j in range(i, i + 15):
+            if 'newstyle_gettext=False,' in lines[j]:
+                lines.insert(j + 1, '            set_translation_version=self._set_translation_version,\n')
+                lines.insert(j + 2, '            get_translation_version=self._get_translation_version,\n')
+                lines.insert(j + 3, '            compare_translation_versions=self._compare_translation_versions,\n')
+                lines.insert(j + 4, '            remove_translation_version=self._remove_translation_version,\n')
+                lines.insert(j + 5, '            clear_translation_versions=self._clear_translation_versions,\n')
+                break
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
