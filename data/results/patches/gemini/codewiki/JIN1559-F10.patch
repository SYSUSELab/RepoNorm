+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_env():
+    env = Environment(extensions=[InternationalizationExtension])
+    env.set_translation_version("hello", "1.0")
+    
+    overlay = env.overlay()
+    
+    # Let's check the extension bound to the overlay
+    ext = overlay.extensions[InternationalizationExtension.identifier]
+    print(f"ext.environment: {ext.environment}")
+    print(f"overlay: {overlay}")
+    print(f"ext.environment is overlay: {ext.environment is overlay}")
+    
+    overlay.set_translation_version("hello", "2.0")
+    print(f"env.translation_versions: {env.translation_versions}")
+    print(f"overlay.translation_versions: {overlay.translation_versions}")
+
+if __name__ == "__main__":
+    test_env()
