+from jinja2 import Environment
+
+def test_env_overlay_dict():
+    env = Environment()
+    env.my_dict = {"a": 1}
+    
+    overlay = env.overlay()
+    assert overlay.my_dict == {"a": 1}
+    
+    # If I modify the dict in the overlay, it modifies the original dict because it's a reference
+    overlay.my_dict["a"] = 2
+    assert env.my_dict == {"a": 2}
+    
+    # If I want to isolate it, I need to copy it
+    overlay.my_dict = env.my_dict.copy()
+    overlay.my_dict["a"] = 3
+    assert env.my_dict == {"a": 2}
+    assert overlay.my_dict == {"a": 3}
+    
+    print("Test passed")
+
+if __name__ == "__main__":
+    test_env_overlay_dict()
