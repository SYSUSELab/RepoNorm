+++ b/fix_indentation.py
@@ -0,0 +1,22 @@
+file_path = 'dspy/streaming/streaming_listener.py'
+with open(file_path, 'r') as f:
+    lines = f.readlines()
+
+# Find the line where `receive` ends and `flush` starts.
+# The `receive` method ends at line 172.
+# The `flush` method starts at line 173.
+# I need to unindent the `flush` method.
+
+new_lines = []
+for i, line in enumerate(lines):
+    if i >= 172:
+        # Unindent by 4 spaces
+        if line.startswith('    '):
+            new_lines.append(line[4:])
+        else:
+            new_lines.append(line)
+    else:
+        new_lines.append(line)
+
+with open(file_path, 'w') as f:
+    f.writelines(new_lines)
