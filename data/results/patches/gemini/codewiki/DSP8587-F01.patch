diff --git a/fix_flush.py b/fix_flush.py
new file mode 100644
index 00000000..1f9443fe
--- /dev/null
+++ b/fix_flush.py
@@ -0,0 +1,21 @@
+file_path = 'dspy/streaming/streaming_listener.py'
+with open(file_path, 'r') as f:
+    lines = f.readlines()
+
+# Find the line 172, which is the start of the docstring for flush.
+# I need to insert `    def flush(self) -> str:` before it.
+# And then fix the indentation of the rest of the method.
+
+new_lines = []
+for i, line in enumerate(lines):
+    if i == 171: # Line 172 is index 171
+        new_lines.append('    def flush(self) -> str:\n')
+        new_lines.append(line)
+    elif i > 171:
+        # Indent by 4 spaces
+        new_lines.append('    ' + line)
+    else:
+        new_lines.append(line)
+
+with open(file_path, 'w') as f:
+    f.writelines(new_lines)
