diff --git a/tests/test_context_on_exit.py b/tests/test_context_on_exit.py
new file mode 100644
index 0000000..a7db7a1
--- /dev/null
+++ b/tests/test_context_on_exit.py
@@ -0,0 +1,56 @@
+import click
+import pytest
+
+def test_on_exit_callback():
+    exit_called = False
+
+    def on_exit(ctx):
+        nonlocal exit_called
+        exit_called = True
+        assert ctx.info_name == "test"
+
+    @click.command()
+    def cli():
+        pass
+
+    ctx = click.Context(cli, info_name="test", on_exit=on_exit)
+    ctx.close()
+    assert exit_called
+
+def test_on_exit_callback_exception():
+    # Ordinary exceptions should be ignored
+    def on_exit(ctx):
+        raise ValueError("Ignore me")
+
+    @click.command()
+    def cli():
+        pass
+
+    ctx = click.Context(cli, on_exit=on_exit)
+    ctx.close()  # Should not raise
+
+def test_on_exit_callback_system_exit():
+    # SystemExit should propagate
+    def on_exit(ctx):
+        raise SystemExit()
+
+    @click.command()
+    def cli():
+        pass
+
+    ctx = click.Context(cli, on_exit=on_exit)
+    with pytest.raises(SystemExit):
+        ctx.close()
+
+def test_on_exit_callback_keyboard_interrupt():
+    # KeyboardInterrupt should propagate
+    def on_exit(ctx):
+        raise KeyboardInterrupt()
+
+    @click.command()
+    def cli():
+        pass
+
+    ctx = click.Context(cli, on_exit=on_exit)
+    with pytest.raises(KeyboardInterrupt):
+        ctx.close()
