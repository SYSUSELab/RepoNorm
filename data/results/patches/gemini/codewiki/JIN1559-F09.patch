+    def extract_marked_translations(self, source, source_name=None):
+        from .ext import TranslationExtractorExtension
+        from .nodes import CallBlock, Call, Name, ExtensionAttribute, Const
+        
+        if isinstance(source, str):
+            node = self.parse(source, source_name)
+        else:
+            node = source
+        records = []
+        
+        def _extract(node):
+            if isinstance(node, CallBlock) and isinstance(node.call.node, ExtensionAttribute) and node.call.node.name == "_extract_marker":
+                metadata = node.call.args[0].value
+                lineno = node.call.args[1].value
+                messages = []
+                
+                def _find_gettext(node):
+                    if isinstance(node, Call) and isinstance(node.node, Name) and node.node.name in ("gettext", "_", "ngettext", "pgettext", "npgettext"):
+                        messages.append({
+                            "lineno": node.lineno,
+                            "function": node.node.name,
+                            "message": node.args[0].value if isinstance(node.args[0], Const) else None
+                        })
+                    for child in node.iter_child_nodes():
+                        _find_gettext(child)
+                
+                for child in node.body:
+                    _find_gettext(child)
+                
+                records.append({
+                    "source": source_name,
+                    "lineno": lineno,
+                    "metadata": metadata,
+                    "messages": messages
+                })
+            for child in node.iter_child_nodes():
+                _extract(child)
+        
+        _extract(node)
+        return records
+
+    def extract_marked_translations_from_templates(self, names=None):
+        if names is None:
+            names = self.loader.list_templates()
+        
+        for name in names:
+            source, _, _ = self.loader.get_source(self, name)
+            yield from self.extract_marked_translations(source, name)
