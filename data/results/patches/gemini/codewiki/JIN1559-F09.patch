diff --git a/append_extension.py b/append_extension.py
new file mode 100644
index 0000000..ea363a5
--- /dev/null
+++ b/append_extension.py
@@ -0,0 +1,37 @@
+with open("src/jinja2/ext.py", "a") as f:
+    f.write("""
+class TranslationExtractorExtension(Extension):
+    tags = {"extract"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        lineno = next(parser.stream).lineno
+        metadata = {}
+        
+        while parser.stream.current.type != "block_end":
+            if metadata:
+                parser.stream.expect("comma")
+            
+            key_token = parser.stream.expect("name")
+            parser.stream.expect("assign")
+            value = parser.parse_expression()
+            
+            if not isinstance(value, nodes.Const):
+                parser.fail(f"Metadata value for {key_token.value!r} must be a constant.", value.lineno)
+            
+            if key_token.value in metadata:
+                parser.fail(f"Duplicate key {key_token.value!r}.", key_token.lineno)
+                
+            metadata[key_token.value] = value.value
+            
+        body = parser.parse_statements(["name:endextract"], drop_needle=True)
+        
+        return nodes.CallBlock(
+            self.call_method("_extract_marker", [nodes.Const(metadata), nodes.Const(lineno)]),
+            [],
+            [],
+            body
+        ).set_lineno(lineno)
+
+    def _extract_marker(self, metadata, lineno, caller):
+        return caller()
+""")
