+
+    def extract_marked_translations(self, source: t.Union[str, nodes.Template], source_name: t.Optional[str] = None) -> t.Iterator[t.Dict[str, t.Any]]:
+        if isinstance(source, str):
+            source = self.parse(source)
+        
+        from .ext import TranslationExtractorExtension
+        
+        # We need to find the TranslationExtractorExtension in the environment
+        # or create a temporary one if it's not there.
+        # Actually, the prompt says:
+        # "Extraction retains no records between calls or template compilations, so recompiling a source cannot accumulate stale markers."
+        # "Environment.extract_marked_translations(source, source_name=None) parses a string or accepts a parsed template and yields independent record mappings."
+        
+        # This means I need to traverse the AST and find the CallBlock nodes
+        # that correspond to the TranslationExtractorExtension.
+        
+        # Let's implement a visitor to find these nodes.
+        from .visitor import NodeVisitor
+        from .ext import GETTEXT_FUNCTIONS
+        
+        class ExtractionVisitor(NodeVisitor):
+            def __init__(self, source_name):
+                self.source_name = source_name
+                self.records = []
+                
+            def visit_CallBlock(self, node):
+                # Check if the call is to _extract_marker
+                if isinstance(node.call, nodes.Call) and isinstance(node.call.node, nodes.ExtensionAttribute) and node.call.node.attr == "_extract_marker":
+                    # This is a marker
+                    metadata = node.call.args[0].value
+                    lineno = node.call.args[1].value
+                    
+                    # Now extract gettext calls from the body
+                    messages = []
+                    
+                    class GettextVisitor(NodeVisitor):
+                        def visit_Call(self, node):
+                            if isinstance(node.node, nodes.Name) and node.node.name in GETTEXT_FUNCTIONS:
+                                # Found a gettext call
+                                # We need to extract the message
+                                # Assuming the first argument is the message
+                                if node.args and isinstance(node.args[0], nodes.Const):
+                                    messages.append({
+                                        'lineno': node.lineno,
+                                        'function': node.node.name,
+                                        'message': node.args[0].value
+                                    })
+                            self.generic_visit(node)
+                            
+                    gettext_visitor = GettextVisitor()
+                    gettext_visitor.visit(node)
+                    
+                    self.records.append({
+                        'source': self.source_name,
+                        'lineno': lineno,
+                        'metadata': metadata,
+                        'messages': messages
+                    })
+                self.generic_visit(node)
+                
+        visitor = ExtractionVisitor(source_name)
+        visitor.visit(source)
+        return iter(visitor.records)
+
+    def extract_marked_translations_from_templates(self, names: t.Optional[t.Iterable[str]] = None) -> t.Iterator[t.Dict[str, t.Any]]:
+        if names is None:
+            names = self.list_templates()
+            
+        for name in names:
+            source, filename, uptodate = self.loader.get_source(self, name)
+            yield from self.extract_marked_translations(source, source_name=name)
