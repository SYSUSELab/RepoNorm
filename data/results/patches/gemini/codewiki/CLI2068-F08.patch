diff --git a/update_termui_impl_v2.py b/update_termui_impl_v2.py
new file mode 100644
index 0000000..5c5478b
--- /dev/null
+++ b/update_termui_impl_v2.py
@@ -0,0 +1,15 @@
+import re
+
+with open("src/click/_termui_impl.py", "r") as f:
+    content = f.read()
+
+pattern = r'c = subprocess.Popen\(f\'{editor} "{filename}"\', env=environ, shell=True\)'
+replacement = """kwargs = {"env": environ, "shell": True}
+        if self.process_group:
+            kwargs["process_group"] = 0
+        c = subprocess.Popen(f'{editor} "{filename}"', **kwargs)"""
+
+new_content = re.sub(pattern, replacement, content)
+
+with open("src/click/_termui_impl.py", "w") as f:
+    f.write(new_content)
