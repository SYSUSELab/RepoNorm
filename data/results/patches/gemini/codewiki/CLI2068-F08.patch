@@ -0,0 +1,23 @@
+import click
+import os
+import subprocess
+from unittest.mock import patch, MagicMock
+import click._termui_impl
+
+# We need to mock subprocess.Popen to verify that process_group=0 is passed.
+with patch("subprocess.Popen") as mock_popen:
+    # Configure the mock to return a mock process object
+    mock_process = MagicMock()
+    mock_process.wait.return_value = 0
+    mock_popen.return_value = mock_process
+    
+    # We need to make sure the editor is set to something, otherwise it might fail
+    # if it can't find an editor.
+    with patch("click._termui_impl.Editor.get_editor", return_value="vim"):
+        click.edit("hello", process_group=True)
+        
+        # Check if Popen was called with process_group=0
+        args, kwargs = mock_popen.call_args
+        print(f"kwargs: {kwargs}")
+        assert kwargs.get("process_group") == 0
+        print("Test passed!")
