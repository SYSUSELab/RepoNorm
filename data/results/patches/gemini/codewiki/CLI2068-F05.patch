diff --git a/tests/test_lock_files.py b/tests/test_lock_files.py
new file mode 100644
index 0000000..3e50a8b
--- /dev/null
+++ b/tests/test_lock_files.py
@@ -0,0 +1,42 @@
+import os
+import click
+import pytest
+import time
+import threading
+from click.exceptions import ClickException
+
+def test_lock_files(runner):
+    filename = "test_file.txt"
+    with open(filename, "w") as f:
+        f.write("initial content")
+    
+    # Use a slow editor
+    with open("slow_editor.sh", "w") as f:
+        f.write("#!/bin/sh\nsleep 1\n")
+    os.chmod("slow_editor.sh", 0o755)
+    editor = os.path.abspath("slow_editor.sh")
+    
+    def edit_file():
+        try:
+            click.edit(filename=filename, lock_files=True, editor=editor)
+        except Exception:
+            pass
+
+    t = threading.Thread(target=edit_file)
+    t.start()
+    
+    time.sleep(0.2)
+    
+    # Try to edit again
+    with pytest.raises(ClickException) as excinfo:
+        click.edit(filename=filename, lock_files=True, editor=editor)
+    
+    assert "Lock exists at" in str(excinfo.value)
+    
+    t.join()
+    
+    # Cleanup
+    if os.path.exists(f".{os.path.basename(filename)}.lock"):
+        os.remove(f".{os.path.basename(filename)}.lock")
+    os.remove(filename)
+    os.remove("slow_editor.sh")
