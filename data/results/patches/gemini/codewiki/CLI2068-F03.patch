diff --git a/tests/test_edit_backup.py b/tests/test_edit_backup.py
new file mode 100644
index 0000000..6e98591
--- /dev/null
+++ b/tests/test_edit_backup.py
@@ -0,0 +1,54 @@
+import os
+import pytest
+import click
+from unittest.mock import patch
+
+def test_edit_auto_backup(tmp_path):
+    filename = tmp_path / "test.txt"
+    filename.write_text("hello")
+    
+    with patch("click._termui_impl.Editor.edit_file") as mock_edit:
+        click.edit(filename=str(filename), auto_backup=True)
+        
+        # Check if backup exists
+        backups = [f for f in os.listdir(tmp_path) if f.startswith("test.txt.backup.")]
+        assert len(backups) == 1
+        
+        # Check content
+        backup_path = tmp_path / backups[0]
+        assert backup_path.read_text() == "hello"
+
+def test_edit_no_auto_backup(tmp_path):
+    filename = tmp_path / "test.txt"
+    filename.write_text("hello")
+    
+    with patch("click._termui_impl.Editor.edit_file") as mock_edit:
+        click.edit(filename=str(filename), auto_backup=False)
+        
+        # Check if backup exists
+        backups = [f for f in os.listdir(tmp_path) if f.startswith("test.txt.backup.")]
+        assert len(backups) == 0
+
+def test_edit_auto_backup_non_existent_file(tmp_path):
+    filename = tmp_path / "non_existent.txt"
+    
+    with patch("click._termui_impl.Editor.edit_file") as mock_edit:
+        click.edit(filename=str(filename), auto_backup=True)
+        
+        # Check if backup exists
+        backups = [f for f in os.listdir(tmp_path) if f.startswith("non_existent.txt.backup.")]
+        assert len(backups) == 0
+
+def test_edit_auto_backup_failure(tmp_path):
+    filename = tmp_path / "test.txt"
+    filename.write_text("hello")
+    
+    # Make the file read-only to force OSError during copy
+    os.chmod(filename, 0o444)
+    
+    with patch("shutil.copy2", side_effect=OSError("Permission denied")):
+        with pytest.raises(click.ClickException, match="Failed to create backup file"):
+            click.edit(filename=str(filename), auto_backup=True)
+    
+    # Cleanup
+    os.chmod(filename, 0o644)
