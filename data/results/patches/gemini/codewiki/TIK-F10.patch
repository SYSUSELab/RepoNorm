+import pickle
+import tiktoken
+from collections import OrderedDict
+import threading
+
+class ThreadSafeLRUCache:
+    def __init__(self, capacity=128):
+        self.cache = OrderedDict()
+        self.capacity = capacity
+        self.lock = threading.Lock()
+
+    def get(self, key):
+        with self.lock:
+            if key not in self.cache:
+                return None
+            self.cache.move_to_end(key)
+            return self.cache[key]
+
+    def put(self, key, value):
+        with self.lock:
+            self.cache[key] = value
+            self.cache.move_to_end(key)
+            if len(self.cache) > self.capacity:
+                self.cache.popitem(last=False)
+
+    def __getstate__(self):
+        # Return state without the lock and cache
+        return {}
+
+    def __setstate__(self, state):
+        self.__dict__.update(state)
+        self.cache = OrderedDict()
+        self.capacity = 128
+        self.lock = threading.Lock()
+
+# Let's check how Encoding is pickled.
+# It has a __getstate__ method.
+enc = tiktoken.get_encoding("cl100k_base")
+enc._cache = ThreadSafeLRUCache()
+enc._cache.put("a", [1, 2, 3])
+
+# The Encoding class's __getstate__ returns a dict or a string.
+# If it returns a dict, it's passed to __setstate__.
+# If it returns a string, it's passed to __setstate__.
+
+# My test_pickle_cache_v3.py failed because I was adding _cache to the instance,
+# but the Encoding class's __getstate__ doesn't know about _cache.
+# So when it's unpickled, the __setstate__ of Encoding is called, not my ThreadSafeLRUCache's __setstate__.
+
+# I need to make sure _cache is handled correctly.
+# Actually, if I add _cache to the Encoding instance, it will be part of __dict__.
+# But Encoding.__getstate__ explicitly returns a dict of specific fields.
+# So _cache will be lost during pickling, which is fine!
+# But I need to make sure it's re-initialized after unpickling.
+
+# If I add _cache to the Encoding instance, it will be lost.
+# So when I unpickle, I will have an Encoding instance without _cache.
+# I can add a property to access _cache, which initializes it if it's missing.
+
+class EncodingWithCache(tiktoken.core.Encoding):
+    @property
+    def cache(self):
+        if not hasattr(self, "_cache"):
+            self._cache = ThreadSafeLRUCache()
+        return self._cache
+
+enc = EncodingWithCache("cl100k_base", pat_str="", mergeable_ranks={}, special_tokens={})
+enc.cache.put("a", [1, 2, 3])
+pickled = pickle.dumps(enc)
+unpickled = pickle.loads(pickled)
+print(hasattr(unpickled, "_cache"))
+print(unpickled.cache.get("a"))
