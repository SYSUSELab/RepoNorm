+with open("tiktoken/core.py", "r") as f:
+    lines = f.readlines()
+
+# Find the `encode` method and remove the extra lines
+start_line = -1
+end_line = -1
+for i, line in enumerate(lines):
+    if line.strip() == "def encode(" and lines[i-1].strip() == "":
+        start_line = i
+    if start_line != -1 and line.strip() == "def encode_to_numpy(":
+        # The `encode` method ends before `encode_to_numpy`
+        # Let's find the last line of `encode`
+        for j in range(i-1, start_line, -1):
+            if lines[j].strip() == "return res":
+                end_line = j
+                break
+        break
+
+# The lines after `return res` should be removed until `def encode_to_numpy(`
+# Let's find the line number of `def encode_to_numpy(`
+for i, line in enumerate(lines):
+    if line.strip() == "def encode_to_numpy(":
+        numpy_line = i
+        break
+
+# Remove the lines between `end_line` and `numpy_line`
+lines[end_line+1:numpy_line] = []
+
+with open("tiktoken/core.py", "w") as f:
