diff --git a/tests/test_resource_limits.py b/tests/test_resource_limits.py
new file mode 100644
index 0000000..0faf12d
--- /dev/null
+++ b/tests/test_resource_limits.py
@@ -0,0 +1,87 @@
+import click
+import pytest
+from contextlib import contextmanager
+
+@contextmanager
+def resource(name):
+    yield name
+
+def test_max_resources():
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(resource("res1"))
+        ctx.with_resource(resource("res2"))
+
+    # Limit 1 should fail
+    ctx = click.Context(cli, max_resources=1)
+    with pytest.raises(RuntimeError, match="Too many resources"):
+        cli.invoke(ctx)
+
+    # Limit 2 should pass
+    ctx = click.Context(cli, max_resources=2)
+    cli.invoke(ctx)
+
+def test_max_resources_parent_child():
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.pass_context
+    def sub(ctx):
+        ctx.with_resource(resource("parent_res"))
+        ctx.with_resource(resource("child_res"))
+
+    # Parent limit 1, child limit 1.
+    # Total resources: 2.
+    # Should fail.
+    ctx = click.Context(cli, max_resources=1)
+    with pytest.raises(RuntimeError, match="Too many resources"):
+        cli.main(args=['sub'], obj=None, parent=ctx)
+
+def test_max_resources_zero():
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(resource("res1"))
+
+    # Zero should reject the first registration.
+    ctx = click.Context(cli, max_resources=0)
+    with pytest.raises(RuntimeError, match="Too many resources"):
+        cli.invoke(ctx)
+
+def test_max_resources_failed_entry():
+    @contextmanager
+    def failing_resource():
+        raise Exception("Failed to enter")
+        yield
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        try:
+            ctx.with_resource(failing_resource())
+        except Exception:
+            pass
+        # Now try to add a resource.
+        # If the reservation was returned, this should work.
+        ctx.with_resource(resource("res1"))
+
+    # Limit 1.
+    ctx = click.Context(cli, max_resources=1)
+    cli.invoke(ctx)
+
+def test_max_resources_close():
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.with_resource(resource("res1"))
+        # Close the context
+        ctx.close()
+        # Now we should be able to add another resource
+        ctx.with_resource(resource("res2"))
+
+    # Limit 1.
+    ctx = click.Context(cli, max_resources=1)
+    cli.invoke(ctx)
