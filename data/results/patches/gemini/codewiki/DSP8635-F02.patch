+    '            raise ValueError("max_instruct_history must be an integer")\n',
+    '        self.max_instruct_history = max(0, min(max_instruct_history, 20))\n'
+]
+
+lines[start_line:end_args_line+1] = new_init
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.writelines(lines)
