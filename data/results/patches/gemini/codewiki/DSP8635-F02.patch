diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..ff502031
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,46 @@
+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+
+# Mocking necessary components
+class MockProgram:
+    def predictors(self):
+        return []
+
+def test_max_instruct_history():
+    # Test default
+    proposer = GroundedProposer(prompt_model=None, program=MockProgram(), trainset=[])
+    # We can't easily check the internal state of MAX_INSTRUCT_IN_HISTORY because it's a module-level constant.
+    # Wait, the requirement is to add max_instruct_history=5 to GroundedProposer.
+    # So I should be able to pass it in the constructor.
+    
+    try:
+        proposer = GroundedProposer(prompt_model=None, program=MockProgram(), trainset=[], max_instruct_history=10)
+        print("Successfully initialized with max_instruct_history=10")
+    except TypeError as e:
+        print(f"Failed to initialize with max_instruct_history: {e}")
+
+    # Test clamping
+    try:
+        proposer = GroundedProposer(prompt_model=None, program=MockProgram(), trainset=[], max_instruct_history=25)
+        # If it works, check if it was clamped
+        if proposer.max_instruct_history == 20:
+            print("Successfully clamped to 20")
+        else:
+            print(f"Failed to clamp, got {proposer.max_instruct_history}")
+    except Exception as e:
+        print(f"Error during clamping test: {e}")
+
+    # Test validation
+    try:
+        proposer = GroundedProposer(prompt_model=None, program=MockProgram(), trainset=[], max_instruct_history="5")
+        print("Failed to reject string")
+    except ValueError:
+        print("Successfully rejected string")
+
+    try:
+        proposer = GroundedProposer(prompt_model=None, program=MockProgram(), trainset=[], max_instruct_history=True)
+        print("Failed to reject boolean")
+    except ValueError:
+        print("Successfully rejected boolean")
+
+test_max_instruct_history()
