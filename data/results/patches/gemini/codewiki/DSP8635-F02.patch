+        break
+
+# Reconstruct the arguments
+# Let's just replace the whole __init__ definition
+new_init = [
+    '    def __init__(\n',
+    '        self,\n',
+    '        prompt_model,\n',
+    '        program,\n',
+    '        trainset,\n',
