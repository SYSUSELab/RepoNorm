+    '        set_history_randomly=True,\n',
+    '        verbose=False,\n',
+    '        rng=None,\n',
+    '        max_instruct_history=5,\n',
+    '    ):\n',
+    '        super().__init__()\n',
+    '        self.program_aware = program_aware\n',
+    '        self.use_dataset_summary = use_dataset_summary\n',
+    '        self.use_task_demos = use_task_demos\n',
+    '        self.num_demos_in_context = num_demos_in_context\n',
+    '        self.use_instruct_history = use_instruct_history\n',
+    '        self.use_tip = use_tip\n',
+    '        self.set_tip_randomly=set_tip_randomly\n',
+    '        self.set_history_randomly=set_history_randomly\n',
