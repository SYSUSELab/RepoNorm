+import sys
+
+with open('dspy/propose/grounded_proposer.py', 'r') as f:
+    lines = f.readlines()
+
+# Find __init__
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def __init__(' in line:
+        start_line = i
+        break
+
+# Insert max_instruct_history into __init__ arguments
+# We need to find the end of the arguments list
+end_args_line = 0
+for i in range(start_line, len(lines)):
+    if '):' in lines[i]:
+        end_args_line = i
+        break
+
+# Insert max_instruct_history=5 before '):'
+lines.insert(end_args_line, '        max_instruct_history=5,\n')
+
+# Now find where to add the validation and assignment
+# We can add it after self.rng = rng or random
+for i in range(end_args_line, len(lines)):
+    if 'self.rng = rng or random' in lines[i]:
+        insertion_point = i + 1
+        break
+
+validation_code = [
+    '\n',
+    '        if not isinstance(max_instruct_history, int) or isinstance(max_instruct_history, bool):\n',
+    '            raise ValueError("max_instruct_history must be an integer")\n',
+    '        self.max_instruct_history = max(0, min(max_instruct_history, 20))\n'
+]
+lines[insertion_point:insertion_point] = validation_code
+
+# Now update propose_instruction_for_predictor to use self.max_instruct_history
+# Find propose_instruction_for_predictor
+for i, line in enumerate(lines):
+    if 'def propose_instruction_for_predictor(' in line:
+        # Find the call to create_predictor_level_history_string
+        for j in range(i, i + 20):
+            if 'create_predictor_level_history_string(' in lines[j]:
+                # Replace MAX_INSTRUCT_IN_HISTORY with self.max_instruct_history
+                lines[j] = lines[j].replace('MAX_INSTRUCT_IN_HISTORY', 'self.max_instruct_history')
+                break
+        break
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.writelines(lines)
