diff --git a/tests/test_groupby_stable.py b/tests/test_groupby_stable.py
new file mode 100644
index 0000000..4bbe940
--- /dev/null
+++ b/tests/test_groupby_stable.py
@@ -0,0 +1,58 @@
+import asyncio
+import pytest
+from jinja2.environment import Environment
+from jinja2.filters import sync_do_groupby, do_groupby
+
+class Item:
+    def __init__(self, name, key):
+        self.name = name
+        self.key = key
+    def __repr__(self):
+        return f"Item({self.name}, {self.key})"
+
+class Unorderable:
+    def __init__(self, val):
+        self.val = val
+    def __eq__(self, other):
+        return self.val == other.val
+    def __repr__(self):
+        return f"U({self.val})"
+
+def test_stable_groupby():
+    env = Environment()
+    items = [
+        Item("a", Unorderable(1)),
+        Item("b", Unorderable(2)),
+        Item("c", Unorderable(1)),
+    ]
+
+    # Test stable=True
+    result = sync_do_groupby(env, items, "key", stable=True)
+    assert len(result) == 2
+    assert result[0].grouper == Unorderable(1)
+    assert result[0].list == [items[0], items[2]]
+    assert result[1].grouper == Unorderable(2)
+    assert result[1].list == [items[1]]
+
+    # Test stable=False (default)
+    with pytest.raises(TypeError):
+        sync_do_groupby(env, items, "key", stable=False)
+
+def test_stable_groupby_async():
+    async def run():
+        env = Environment()
+        env.is_async = True
+        items = [
+            Item("a", Unorderable(1)),
+            Item("b", Unorderable(2)),
+            Item("c", Unorderable(1)),
+        ]
+        
+        result = await do_groupby(env, items, "key", stable=True)
+        assert len(result) == 2
+        assert result[0].grouper == Unorderable(1)
+        assert result[0].list == [items[0], items[2]]
+        assert result[1].grouper == Unorderable(2)
+        assert result[1].list == [items[1]]
+    
+    asyncio.run(run())
