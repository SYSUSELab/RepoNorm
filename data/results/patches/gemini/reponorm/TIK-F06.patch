@@ -0,0 +1,42 @@
+import pytest
+import tiktoken
+import string
+
+def test_transformers():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    def remove_punctuation(text):
+        return text.translate(str.maketrans("", "", string.punctuation))
+    
+    text = "Hello, World!"
+    
+    # Test single transformer
+    tokens1 = enc.encode(text, transformers=lowercase)
+    assert enc.decode(tokens1) == "hello, world!"
+    
+    # Test list of transformers
+    tokens2 = enc.encode(text, transformers=[lowercase, remove_punctuation])
+    assert enc.decode(tokens2) == "hello world"
+    
+    # Test TypeError for non-string return
+    def bad_transformer(text):
+        return 123
+    
+    with pytest.raises(TypeError):
+        enc.encode(text, transformers=bad_transformer)
+
+def test_transformers_batch():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    texts = ["Hello", "WORLD"]
+    
+    # Test batch
+    tokens = enc.encode_batch(texts, transformers=lowercase)
+    assert [enc.decode(t) for t in tokens] == ["hello", "world"]
+
