new file mode 100644
index 0000000..fd2c38f
--- /dev/null
+++ b/tests/test_custom_filters.py
@@ -0,0 +1,72 @@
+import pytest
+import outlines
+from outlines.prompts import Prompt
+
+def test_custom_filters_decorator():
+    def surround(value, left, right):
+        return f"{left}{value}{right}"
+
+    @outlines.prompt(filters={"surround": surround})
+    def tagged_prompt(text):
+        '''{{ text | surround("<", ">") }}'''
+
+    assert tagged_prompt("hello") == "<hello>"
+
+def test_custom_filters_from_str():
+    def upper(value):
+        return value.upper()
+
+    prompt = Prompt.from_str("{{ text | upper }}", filters={"upper": upper})
+    assert prompt(text="hello") == "HELLO"
+
+def test_custom_filters_precedence():
+    # Built-in filter 'name' should be overridden
+    def fake_name(fn):
+        return "fake"
+
+    @outlines.prompt(filters={"name": fake_name})
+    def name_prompt(fn):
+        '''{{ fn | name }}'''
+
+    def my_func():
+        pass
+
+    assert name_prompt(my_func) == "fake"
+
+def test_with_filters():
+    def add_exclamation(value):
+        return f"{value}!"
+
+    def dummy(value):
+        return value
+
+    # Define base_prompt with a dummy filter
+    @outlines.prompt(filters={"add_exclamation": dummy})
+    def base_prompt(text):
+        '''{{ text | add_exclamation }}'''
+
+    assert base_prompt("hello") == "hello"
+
+    # Add real filter
+    new_prompt = base_prompt.with_filters({"add_exclamation": add_exclamation})
+    assert new_prompt("hello") == "hello!"
+
+def test_with_filters_from_file(tmp_path):
+    d = tmp_path / "templates"
+    d.mkdir()
+    p = d / "hello.txt"
+    p.write_text("{{ text | add_exclamation }}")
+
+    def add_exclamation(value):
+        return f"{value}!"
+
+    def dummy(value):
+        return value
+
+    # Define prompt from file with dummy filter
+    prompt = Prompt.from_file(p, filters={"add_exclamation": dummy})
+    assert prompt(text="hello") == "hello"
+
+    # Add real filter
+    new_prompt = prompt.with_filters({"add_exclamation": add_exclamation})
+    assert new_prompt(text="hello") == "hello!"
