--- /dev/null
+++ b/tests/caching/test_cache_bypass.py
@@ -0,0 +1,58 @@
+import dspy
+import pytest
+import asyncio
+
+def test_sync_bypass():
+    cache = dspy.cache
+    cache.reset_memory_cache()
+    
+    @dspy.request_cache()
+    def my_func(x):
+        return x * 2
+        
+    # First call: cache miss
+    res1 = my_func(x=10)
+    assert res1 == 20
+    
+    # Second call: cache hit
+    res2 = my_func(x=10)
+    assert res2 == 20
+    
+    # Bypass
+    with cache.bypass():
+        # Should be a cache miss
+        res3 = my_func(x=10)
+        assert res3 == 20
+        
+        # Should write to cache
+        res4 = my_func(x=10)
+        assert res4 == 20
+        
+    # After bypass: should be a cache hit
+    res5 = my_func(x=10)
+    assert res5 == 20
+
+def test_async_bypass():
+    cache = dspy.cache
+    cache.reset_memory_cache()
+    
+    @dspy.request_cache()
+    async def my_async_func(x):
+        await asyncio.sleep(0.01)
+        return x * 2
+        
+    async def run():
+        # First call: cache miss
+        res1 = await my_async_func(x=10)
+        assert res1 == 20
+        
+        # Bypass
+        with cache.bypass():
+            res2 = await my_async_func(x=10)
+            assert res2 == 20
+            
+        # After bypass: cache hit
+        res3 = await my_async_func(x=10)
+        assert res3 == 20
+        
+    asyncio.run(run())
