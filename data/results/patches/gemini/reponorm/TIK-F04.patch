diff --git a/tests/test_chunking.py b/tests/test_chunking.py
new file mode 100644
index 0000000..63060fc
--- /dev/null
+++ b/tests/test_chunking.py
@@ -0,0 +1,53 @@
+import pytest
+import tiktoken
+
+def test_chunking_basic():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "abcde"
+    expected = [enc.encode('abc'), enc.encode('cde')]
+    assert enc.encode(text, chunk_size=3, chunk_overlap=1) == expected
+
+def test_chunking_empty():
+    enc = tiktoken.get_encoding("gpt2")
+    assert enc.encode("", chunk_size=3, chunk_overlap=1) == [[]]
+
+def test_chunking_invalid_params():
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError, match="chunk_size must be positive"):
+        enc.encode("abc", chunk_size=0)
+    with pytest.raises(ValueError, match="chunk_overlap must be 0 <= chunk_overlap < chunk_size"):
+        enc.encode("abc", chunk_size=3, chunk_overlap=3)
+    with pytest.raises(ValueError, match="chunk_overlap must be 0 <= chunk_overlap < chunk_size"):
+        enc.encode("abc", chunk_size=3, chunk_overlap=-1)
+    with pytest.raises(ValueError, match="chunk_overlap must be 0 if chunk_size is None"):
+        enc.encode("abc", chunk_size=None, chunk_overlap=1)
+
+def test_chunking_no_overlap():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "abcdef"
+    expected = [enc.encode('abc'), enc.encode('def')]
+    assert enc.encode(text, chunk_size=3, chunk_overlap=0) == expected
+
+def test_chunking_exact_fit():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "abcdef"
+    expected = [enc.encode('abc'), enc.encode('cde'), enc.encode('ef')]
+    assert enc.encode(text, chunk_size=3, chunk_overlap=1) == expected
+
+def test_chunking_special_tokens():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "abc<|endoftext|>def"
+    
+    # Test ValueError
+    with pytest.raises(ValueError):
+        enc.encode(text, chunk_size=5, chunk_overlap=0)
+        
+    # Test disallowed_special=()
+    encoded = enc.encode(text, chunk_size=5, chunk_overlap=0, disallowed_special=())
+    assert len(encoded) == 4
+    
+    # Test with allowed_special
+    text = "abc <|endoftext|> def"
+    # size 22, overlap 0
+    encoded = enc.encode(text, chunk_size=22, chunk_overlap=0, allowed_special={"<|endoftext|>"})
+    assert encoded[0] == [39305, 220, 50256, 825]
