+++ b/tests/test_loader_auto_reload.py
@@ -0,0 +1,47 @@
+import os
+import time
+import unittest
+import weakref
+from jinja2 import Environment, FileSystemLoader
+import tempfile
+import shutil
+
+class TestFileSystemLoaderAutoReload(unittest.TestCase):
+    def setUp(self):
+        self.tmpdir = tempfile.mkdtemp()
+        self.template_file = os.path.join(self.tmpdir, "test.html")
+        with open(self.template_file, "w") as f:
+            f.write("hello")
+        self.loader = FileSystemLoader(self.tmpdir, auto_reload=True)
+        self.env = Environment(loader=self.loader)
+
+    def tearDown(self):
+        self.loader.close()
+        shutil.rmtree(self.tmpdir)
+
+    def test_auto_reload_invalidates_cache(self):
+        # Load template
+        template = self.env.get_template("test.html")
+        self.assertEqual(template.render(), "hello")
+        
+        # The cache key is (weakref.ref(self.loader), "test.html")
+        cache_key = (weakref.ref(self.loader), "test.html")
+        self.assertIn(cache_key, self.env.cache)
+
+        # Modify template
+        with open(self.template_file, "w") as f:
+            f.write("world")
+
+        # Wait for monitor to pick up change (0.5s interval)
+        time.sleep(1.0)
+
+        # Template should be reloaded
+        # The cache should have been invalidated
+        self.assertNotIn(cache_key, self.env.cache)
+        
+        template = self.env.get_template("test.html")
+        self.assertEqual(template.render(), "world")
+        self.assertIn(cache_key, self.env.cache)
+
+if __name__ == "__main__":
+    unittest.main()
