+class _FileSystemMonitor(threading.Thread):
+    def __init__(self, loader: FileSystemLoader) -> None:
+        super().__init__(daemon=True)
+        self.loader = weakref.proxy(loader)
+        self._stop_event = threading.Event()
+        self._last_mtimes = {}
+
+    def run(self) -> None:
+        while not self._stop_event.is_set():
+            self.scan_once()
+            time.sleep(0.5)
+
+    def stop(self) -> None:
+        self._stop_event.set()
+        self.join()
+
+    def scan_once(self) -> t.List[str]:
+        changed = []
+        current_mtimes = {}
+        for searchpath in self.loader.searchpath:
+            for dirpath, _, filenames in os.walk(searchpath, followlinks=self.loader.followlinks):
+                for filename in filenames:
+                    path = os.path.join(dirpath, filename)
+                    try:
+                        mtime = os.path.getmtime(path)
+                    except OSError:
+                        continue
+                    current_mtimes[path] = mtime
+                    if path in self._last_mtimes and self._last_mtimes[path] != mtime:
+                        changed.append(path)
+                    elif path not in self._last_mtimes:
+                        changed.append(path)
+        
+        # Check for deleted files
+        for path in self._last_mtimes:
+            if path not in current_mtimes:
+                changed.append(path)
+        
+        self._last_mtimes = current_mtimes
+        return self.invalidate_changed(changed)
+
+    def invalidate_changed(self, paths: t.List[str]) -> t.List[str]:
+        invalidated = []
+        for path in paths:
+            for env in self.loader._environments:
+                for name, template in list(env.cache.items()):
+                    if template.filename == path:
+                        try:
+                            del env.cache[name]
+                        except KeyError:
+                            pass
+                        invalidated.append(name)
+        return invalidated
