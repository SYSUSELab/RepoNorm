diff --git a/dspy/utils/cache_usage_tracker.py b/dspy/utils/cache_usage_tracker.py
new file mode 100644
index 00000000..baa2526a
--- /dev/null
+++ b/dspy/utils/cache_usage_tracker.py
@@ -0,0 +1,43 @@
+from collections import defaultdict
+from contextlib import contextmanager
+from typing import Any, Optional
+from dspy.dsp.utils.settings import settings
+
+class CacheUsageTracker:
+    def __init__(self):
+        self.usage = {
+            "hits": 0,
+            "mem_hits": 0,
+            "disk_hits": 0,
+            "misses": 0,
+        }
+        self._lock = threading.Lock()
+
+    def record_mem_hit(self):
+        with self._lock:
+            self.usage["hits"] += 1
+            self.usage["mem_hits"] += 1
+
+    def record_disk_hit(self):
+        with self._lock:
+            self.usage["hits"] += 1
+            self.usage["disk_hits"] += 1
+
+    def record_miss(self):
+        with self._lock:
+            self.usage["misses"] += 1
+
+    def get_usage(self):
+        with self._lock:
+            return self.usage.copy()
+
+import threading
+# We need a way to store the tracker in the context.
+# The existing usage_tracker uses settings.context(usage_tracker=tracker)
+# We can add a cache_usage_tracker to the settings context.
+
+@contextmanager
+def track_cache_usage():
+    tracker = CacheUsageTracker()
+    with settings.context(cache_usage_tracker=tracker):
+        yield tracker
diff --git a/tests/caching/test_cache_stats.py b/tests/caching/test_cache_stats.py
new file mode 100644
index 00000000..b0a1064c
--- /dev/null
+++ b/tests/caching/test_cache_stats.py
@@ -0,0 +1,63 @@
+import dspy
+from dspy.clients.cache import Cache
+import pytest
+import os
+import shutil
+
+def test_cache_stats():
+    cache_dir = ".test_cache"
+    if os.path.exists(cache_dir):
+        shutil.rmtree(cache_dir)
+    
+    cache = Cache(enable_disk_cache=True, enable_memory_cache=True, disk_cache_dir=cache_dir)
+    
+    # Initial stats
+    assert cache.stats() == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+    
+    request = {"prompt": "hello"}
+    
+    # Miss
+    cache.get(request)
+    assert cache.stats()["misses"] == 1
+    
+    # Put
+    cache.put(request, "world")
+    
+    # Mem hit
+    cache.get(request)
+    assert cache.stats()["hits"] == 1
+    assert cache.stats()["mem_hits"] == 1
+    assert cache.stats()["disk_hits"] == 0
+    
+    # Reset
+    cache.reset_stats()
+    assert cache.stats() == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+    
+    if os.path.exists(cache_dir):
+        shutil.rmtree(cache_dir)
+
+def test_cache_usage_tracking():
+    # Need to mock dspy.cache
+    class MockCache:
+        def __init__(self):
+            self.cache = {}
+        def get(self, request, ignored_args=None):
+            return self.cache.get(str(request))
+        def put(self, request, value, ignored_args=None, enable_memory_cache=True):
+            self.cache[str(request)] = value
+    
+    # This is tricky because dspy.cache is a global.
+    # Let's just test the usage tracker directly.
+    from dspy.utils.cache_usage_tracker import CacheUsageTracker
+    
+    tracker = CacheUsageTracker()
+    tracker.record_mem_hit()
+    tracker.record_disk_hit()
+    tracker.record_miss()
+    
+    usage = tracker.get_usage()
+    assert usage["hits"] == 2
+    assert usage["mem_hits"] == 1
+    assert usage["disk_hits"] == 1
+    assert usage["misses"] == 1
+
