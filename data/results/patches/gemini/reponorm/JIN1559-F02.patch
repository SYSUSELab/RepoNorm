diff --git a/add_dgettext_helpers.py b/add_dgettext_helpers.py
new file mode 100644
index 0000000..ae88db4
--- /dev/null
+++ b/add_dgettext_helpers.py
@@ -0,0 +1,30 @@
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+helpers = """
+def _make_new_dgettext(func: t.Callable[[str, str], str]) -> t.Callable[..., str]:
+    @pass_context
+    def dgettext(__context: Context, __domain: str, __string: str, **variables: t.Any) -> str:
+        rv = __context.call(func, __domain, __string)
+        if __context.eval_ctx.autoescape:
+            rv = Markup(rv)
+        return rv % variables  # type: ignore
+    return dgettext
+
+
+def _make_new_dngettext(func: t.Callable[[str, str, str, int], str]) -> t.Callable[..., str]:
+    @pass_context
+    def dngettext(__context: Context, __domain: str, __singular: str, __plural: str, __num: int, **variables: t.Any) -> str:
+        variables.setdefault("num", __num)
+        rv = __context.call(func, __domain, __singular, __plural, __num)
+        if __context.eval_ctx.autoescape:
+            rv = Markup(rv)
+        return rv % variables  # type: ignore
+    return dngettext
+"""
+
+# Insert before InternationalizationExtension
+content = content.replace('class InternationalizationExtension(Extension):', helpers + '\n\nclass InternationalizationExtension(Extension):')
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
