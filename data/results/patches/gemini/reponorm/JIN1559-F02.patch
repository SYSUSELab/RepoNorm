+# Find `_make_node`
+make_node_start = 0
+for i in range(len(lines)):
+    if 'def _make_node(' in lines[i]:
+        make_node_start = i
+        break
+
+# Find `if plural_expr is None:`
+for i in range(make_node_start, len(lines)):
+    if 'if plural_expr is None:' in lines[i]:
+        # Replace the body of `if plural_expr is None:`
+        lines[i+1] = '            if domain is None:\n'
+        lines[i+2] = '                gettext = nodes.Name("gettext", "load")\n'
+        lines[i+3] = '                node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)\n'
+        lines.insert(i+4, '            else:\n')
+        lines.insert(i+5, '                gettext = nodes.Name("dgettext", "load")\n')
+        lines.insert(i+6, '                node = nodes.Call(gettext, [nodes.Const(domain), nodes.Const(singular)], [], None, None)\n')
+        break
+
+# Find `else:` for `if plural_expr is None:`
+for i in range(make_node_start, len(lines)):
+    if 'else:' in lines[i] and 'if plural_expr is None:' in lines[i-10:i]:
+        # Replace the body of `else:`
+        lines[i+1] = '            if domain is None:\n'
+        lines[i+2] = '                ngettext = nodes.Name("ngettext", "load")\n'
