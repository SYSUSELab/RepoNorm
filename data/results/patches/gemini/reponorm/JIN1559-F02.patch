+content = content.replace(
+    'class InternationalizationExtension(Extension):',
+    'class InternationalizationExtension(Extension):\n    def _gettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n    def _ngettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n    def _pgettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n    def _npgettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")'
+)
+
+# 2. Update uninstall_gettext_translations
+pattern = re.compile(r'    def uninstall_gettext_translations\(self\) -> None:.*?self.environment.globals.pop\(key, None\)', re.DOTALL)
+new_uninstall = """    def uninstall_gettext_translations(self) -> None:
+        self.environment.globals.update(
+            gettext=self._gettext_alias, ngettext=self._ngettext_alias, pgettext=self._pgettext_alias, npgettext=self._npgettext_alias, dgettext=self._gettext_alias, dngettext=self._ngettext_alias
+        )"""
+content = pattern.sub(new_uninstall, content)
+
+# 3. Update parse
+pattern = re.compile(r'    def parse\(self, parser: "Parser"\) -> t.Union\[nodes.Node, t.List\[nodes.Node\]\]:.*?parser.stream.expect\("block_end"\)', re.DOTALL)
+new_parse = """    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        \"\"\"Parse a translatable tag.\"\"\"
+        lineno = next(parser.stream).lineno
+        domain = None
+        num_called_num = False
+
+        # find all the variables referenced.  Additionally a variable can be
+        # defined in the body of the trans block too, but this is checked at
+        # a later state.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            if parser.stream.skip_if("comma"):
+                pass
+
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+
+            token = parser.stream.expect("name")
+            if token.value == "domain":
+                if domain is not None:
+                    parser.fail("domain defined twice", token.lineno, exc=TemplateAssertionError)
+                parser.stream.expect("assign")
+                value = parser.parse_expression()
+                if not isinstance(value, nodes.Const) or not isinstance(value.value, str):
+                    parser.fail("domain must be a string literal", token.lineno, exc=TemplateAssertionError)
+                domain = value.value
+                continue
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")"""
+content = pattern.sub(new_parse, content)
+
+# 4. Update _make_node signature
+content = content.replace(
+    '    def _make_node(\n        self,\n        singular: str,\n        plural: t.Optional[str],\n        variables: t.Dict[str, nodes.Expr],\n        plural_expr: t.Optional[nodes.Expr],\n        vars_referenced: bool,\n        num_called_num: bool,',
+    '    def _make_node(\n        self,\n        singular: str,\n        plural: t.Optional[str],\n        variables: t.Dict[str, nodes.Expr],\n        plural_expr: t.Optional[nodes.Expr],\n        vars_referenced: bool,\n        num_called_num: bool,\n        domain: t.Optional[str] = None,'
+)
+
+# 5. Update _make_node body
+pattern = re.compile(r'        # singular only:\n        if plural_expr is None:.*?node = nodes.Call\(ngettext, args, \[\], None, None\)', re.DOTALL)
+new_make_node_body = """        # singular only:
+        if plural_expr is None:
+            if domain is None:
+                gettext = nodes.Name("gettext", "load")
+                node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+            else:
+                gettext = nodes.Name("dgettext", "load")
+                node = nodes.Call(gettext, [nodes.Const(domain), nodes.Const(singular)], [], None, None)
+        # singular and plural
+        else:
+            if domain is None:
+                ngettext = nodes.Name("ngettext", "load")
+                args = [nodes.Const(singular), nodes.Const(plural), plural_expr]
+            else:
+                ngettext = nodes.Name("dngettext", "load")
+                args = [nodes.Const(domain), nodes.Const(singular), nodes.Const(plural), plural_expr]
+            node = nodes.Call(ngettext, args, [], None, None)"""
+content = pattern.sub(new_make_node_body, content)
+
+# 6. Update call to _make_node
+content = content.replace(
+    '            num_called_num and have_plural,\n        )',
+    '            num_called_num and have_plural,\n            domain=domain,\n        )'
+)
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
