new file mode 100644
index 0000000..9b00417
--- /dev/null
+++ b/tests/test_i18n_domain.py
@@ -0,0 +1,64 @@
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+import pytest
+
+def test_domain_support():
+    def dgettext(domain, message):
+        return f"[{domain}] {message}"
+
+    def dngettext(domain, singular, plural, n):
+        return f"[{domain}] {singular if n == 1 else plural}"
+
+    env = Environment(extensions=[InternationalizationExtension])
+    env.install_gettext_callables(
+        gettext=lambda x: x,
+        ngettext=lambda s, p, n: s if n == 1 else p,
+        dgettext=dgettext,
+        dngettext=dngettext,
+    )
+
+    # Test simple domain
+    tmpl = env.from_string('{% trans domain="admin" %}Hello{% endtrans %}')
+    assert tmpl.render() == "[admin] Hello"
+
+    # Test plural domain
+    tmpl = env.from_string('{% trans domain="admin", count=n %}Hello{% pluralize %}Hellos{% endtrans %}')
+    assert tmpl.render(n=1) == "[admin] Hello"
+    assert tmpl.render(n=2) == "[admin] Hellos"
+
+def test_domain_newstyle():
+    def dgettext(domain, message, **kwargs):
+        return f"[{domain}] {message % kwargs}"
+
+    env = Environment(extensions=[InternationalizationExtension])
+    env.newstyle_gettext = True
+    env.install_gettext_callables(
+        gettext=lambda x: x,
+        ngettext=lambda s, p, n: s if n == 1 else p,
+        dgettext=dgettext,
+        dngettext=lambda d, s, p, n, **kwargs: f"[{d}] {(s if n == 1 else p) % kwargs}",
+    )
+
+    tmpl = env.from_string('{% trans domain="admin", name="World" %}Hello %(name)s{% endtrans %}')
+    assert tmpl.render() == "[admin] Hello World"
+
+def test_uninstall_domain():
+    env = Environment(extensions=[InternationalizationExtension])
+    env.install_gettext_callables(
+        gettext=lambda x: x,
+        ngettext=lambda s, p, n: s if n == 1 else p,
+        dgettext=lambda d, m: m,
+        dngettext=lambda d, s, p, n: s if n == 1 else p,
+    )
+    ext = None
+    for e in env.extensions.values():
+        if isinstance(e, InternationalizationExtension):
+            ext = e
+            break
+    
+    ext.uninstall_gettext_translations()
+    
+    with pytest.raises(RuntimeError, match="gettext not installed"):
+        env.globals["dgettext"]("admin", "Hello")
+    with pytest.raises(RuntimeError, match="gettext not installed"):
+        env.globals["dngettext"]("admin", "Hello", "Hellos", 1)
