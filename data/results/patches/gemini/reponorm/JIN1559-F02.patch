+    r'def _make_new_npgettext(func: t.Callable[[str, str, str, int], str]) -> t.Callable[..., str]:\n    @pass_context\n    def npgettext(__context: Context, __context_string: str, __singular: str, __plural: str, __num: int, **variables: t.Any) -> str:\n        rv = __context.call(func, __context_string, __singular, __plural, __num)\n        if __context.eval_ctx.autoescape:\n            rv = Markup(rv)\n        return rv % variables  # type: ignore\n\n\ndef _make_new_dgettext(func: t.Callable[[str, str], str]) -> t.Callable[..., str]:\n    @pass_context\n    def dgettext(__context: Context, __domain: str, __string: str, **variables: t.Any) -> str:\n        rv = __context.call(func, __domain, __string)\n        if __context.eval_ctx.autoescape:\n            rv = Markup(rv)\n        return rv % variables  # type: ignore\n\n\ndef _make_new_dngettext(func: t.Callable[[str, str, str, int], str]) -> t.Callable[..., str]:\n    @pass_context\n    def dngettext(__context: Context, __domain: str, __singular: str, __plural: str, __num: int, **variables: t.Any) -> str:\n        rv = __context.call(func, __domain, __singular, __plural, __num)\n        if __context.eval_ctx.autoescape:\n            rv = Markup(rv)\n        return rv % variables  # type: ignore',
+    content
+)
+
+# Update _install_callables
+content = re.sub(
+    r'if npgettext is not None:\n\s+npgettext = _make_new_npgettext\(npgettext\)',
+    r'if npgettext is not None:\n                npgettext = _make_new_npgettext(npgettext)\n\n            if dgettext is not None:\n                dgettext = _make_new_dgettext(dgettext)\n\n            if dngettext is not None:\n                dngettext = _make_new_dngettext(dngettext)',
