+        lines.insert(i+1, '    def _gettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n')
+        lines.insert(i+3, '    def _ngettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n')
+        lines.insert(i+5, '    def _pgettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n')
+        lines.insert(i+7, '    def _npgettext_alias(self, *args, **kwargs):\n        raise RuntimeError("gettext not installed")\n')
+        break
+
+# 2. Update uninstall_gettext_translations
+for i in range(len(lines)):
+    if 'def uninstall_gettext_translations(self) -> None:' in lines[i]:
+        lines[i+1] = '        self.environment.globals.update(\n'
+        lines.insert(i+2, '            gettext=self._gettext_alias, ngettext=self._ngettext_alias, pgettext=self._pgettext_alias, npgettext=self._npgettext_alias, dgettext=self._gettext_alias, dngettext=self._ngettext_alias\n')
+        lines.insert(i+3, '        )\n')
+        # Remove the old implementation
+        del lines[i+4:i+6]
+        break
+
+# 3. Update parse
+# I will just replace the whole parse method.
+# This is too complex. I will just edit the file manually.
