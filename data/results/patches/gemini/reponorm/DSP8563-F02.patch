@@ -0,0 +1,29 @@
+import pytest
+from dspy.adapters.types.tool import ToolCalls
+
+def test_parse_python_calls():
+    text = "foo(a=1, b='bar'); baz(c=True)"
+    tool_calls = ToolCalls.validate_input(text)
+    assert len(tool_calls.tool_calls) == 2
+    assert tool_calls.tool_calls[0].name == "foo"
+    assert tool_calls.tool_calls[0].args == {"a": 1, "b": "bar"}
+    assert tool_calls.tool_calls[1].name == "baz"
+    assert tool_calls.tool_calls[1].args == {"c": True}
+
+def test_parse_python_calls_invalid():
+    with pytest.raises(ValueError):
+        ToolCalls.validate_input("foo(a=1, a=2)")
+    with pytest.raises(ValueError):
+        ToolCalls.validate_input("foo(1)")
+
+def test_parse_python_calls_comment():
+    text = "foo(a=1) # comment"
+    tool_calls = ToolCalls.validate_input(text)
+    assert len(tool_calls.tool_calls) == 1
+    assert tool_calls.tool_calls[0].name == "foo"
+    assert tool_calls.tool_calls[0].args == {"a": 1}
+
+def test_parse_python_calls_nested():
+    text = "foo(a=[1, 2], b={'c': 3})"
+    tool_calls = ToolCalls.validate_input(text)
+    assert tool_calls.tool_calls[0].args == {"a": [1, 2], "b": {"c": 3}}
