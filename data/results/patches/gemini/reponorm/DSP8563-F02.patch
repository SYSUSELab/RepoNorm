+import ast
+from typing import Any
+
+def parse_python_calls(text: str) -> dict:
+    if not text.strip():
+        raise ValueError("Empty input")
+    
+    try:
+        tree = ast.parse(text)
+    except SyntaxError:
+        raise ValueError("Malformed syntax")
+        
+    tool_calls = []
+    
+    for node in tree.body:
+        if not isinstance(node, ast.Expr) or not isinstance(node.value, ast.Call):
+            raise ValueError("Only calls are allowed")
+            
+        call = node.value
+        
+        def get_name(node):
+            if isinstance(node, ast.Name):
+                return node.id
+            elif isinstance(node, ast.Attribute):
+                return get_name(node.value) + "." + node.attr
+            else:
+                raise ValueError("Invalid function name")
+        
+        func_name = get_name(call.func)
+        tool_name = func_name.split('.')[-1]
+        
+        if call.args:
+            raise ValueError("Positional arguments not allowed")
+            
+        args = {}
+        for keyword in call.keywords:
+            if keyword.arg is None:
+                raise ValueError("Argument unpacking not allowed")
+            if keyword.arg in args:
+                raise ValueError(f"Duplicate keyword argument: {keyword.arg}")
+            args[keyword.arg] = _parse_value(keyword.value)
+            
+        tool_calls.append({"name": tool_name, "args": args})
+        
+    return {"tool_calls": tool_calls}
+
+def _parse_value(node: Any) -> Any:
+    if isinstance(node, ast.Constant):
+        if isinstance(node.value, (str, int, float, bool)) or node.value is None:
+            if isinstance(node.value, float) and not (float('-inf') < node.value < float('inf')):
+                raise ValueError(f"Non-finite number: {node.value}")
+            return node.value
+        else:
+            raise ValueError(f"Unsupported constant type: {type(node.value)}")
+    elif isinstance(node, ast.List):
+        return [_parse_value(elt) for elt in node.elts]
+    elif isinstance(node, ast.Tuple):
+        return [_parse_value(elt) for elt in node.elts]
+    elif isinstance(node, ast.Dict):
+        keys = []
+        values = []
+        for k, v in zip(node.keys, node.values):
+            if k is None:
+                raise ValueError("Dictionary unpacking not allowed")
+            if not isinstance(k, ast.Constant) or not isinstance(k.value, str):
+                raise ValueError("Dictionary keys must be strings")
+            if k.value in keys:
+                raise ValueError(f"Duplicate dictionary key: {k.value}")
+            keys.append(k.value)
+            values.append(_parse_value(v))
+        return dict(zip(keys, values))
+    elif isinstance(node, ast.UnaryOp):
+        if isinstance(node.op, (ast.UAdd, ast.USub)):
+            val = _parse_value(node.operand)
+            if not isinstance(val, (int, float)):
+                raise ValueError("Unary operator only allowed on numbers")
+            return +val if isinstance(node.op, ast.UAdd) else -val
+        else:
+            raise ValueError("Unsupported unary operator")
+    else:
+        raise ValueError(f"Unsupported node type: {type(node)}")
