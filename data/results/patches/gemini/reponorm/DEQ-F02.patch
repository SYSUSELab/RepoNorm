diff --git a/dirty_equals/_mac.py b/dirty_equals/_mac.py
new file mode 100644
index 0000000..1ca6490
--- /dev/null
+++ b/dirty_equals/_mac.py
@@ -0,0 +1,39 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit
+
+__all__ = 'IsMac',
+
+MAC_REGEXES = {
+    'colon': re.compile(r'^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'),
+    'hyphen': re.compile(r'^([0-9a-fA-F]{2}-){5}[0-9a-fA-F]{2}$'),
+    'dot': re.compile(r'^([0-9a-fA-F]{4}\.){2}[0-9a-fA-F]{4}$'),
+    'compact': re.compile(r'^[0-9a-fA-F]{12}$'),
+}
+
+class IsMac(DirtyEquals[str]):
+    """
+    Checks if the value is a valid MAC address.
+    """
+
+    def __init__(self, format: Optional[str] = None):
+        """
+        Args:
+            format: The format of the MAC address ('colon', 'hyphen', 'dot', 'compact').
+        """
+        self.format = format
+        super().__init__(format=format if format else Omit)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format:
+            regex = MAC_REGEXES.get(self.format)
+            if not regex:
+                raise ValueError(f'Invalid format: {self.format}')
+            return bool(regex.fullmatch(other))
+        else:
+            return any(regex.fullmatch(other) for regex in MAC_REGEXES.values())
diff --git a/tests/test_mac.py b/tests/test_mac.py
new file mode 100644
index 0000000..c4a3f70
--- /dev/null
+++ b/tests/test_mac.py
@@ -0,0 +1,41 @@
+import pytest
+from dirty_equals import IsMac
+
+def test_is_mac_colon():
+    assert '00:11:22:33:44:55' == IsMac()
+    assert '00:11:22:33:44:55' == IsMac(format='colon')
+    assert '00:11:22:33:44:55' != IsMac(format='hyphen')
+    assert '00:11:22:33:44:55' != IsMac(format='dot')
+    assert '00:11:22:33:44:55' != IsMac(format='compact')
+
+def test_is_mac_hyphen():
+    assert '00-11-22-33-44-55' == IsMac()
+    assert '00-11-22-33-44-55' == IsMac(format='hyphen')
+    assert '00-11-22-33-44-55' != IsMac(format='colon')
+
+def test_is_mac_dot():
+    assert '0011.2233.4455' == IsMac()
+    assert '0011.2233.4455' == IsMac(format='dot')
+    assert '0011.2233.4455' != IsMac(format='colon')
+
+def test_is_mac_compact():
+    assert '001122334455' == IsMac()
+    assert '001122334455' == IsMac(format='compact')
+    assert '001122334455' != IsMac(format='colon')
+
+def test_is_mac_invalid():
+    assert '00:11:22:33:44:5' != IsMac()
+    assert '00:11:22:33:44:555' != IsMac()
+    assert '00:11:22:33:44:5g' != IsMac()
+    assert '00:11:22:33:44:55 ' != IsMac()
+    assert ' 00:11:22:33:44:55' != IsMac()
+    assert 123 != IsMac()
+
+def test_is_mac_repr():
+    assert repr(IsMac()) == 'IsMac()'
+    assert repr(IsMac(format='colon')) == "IsMac(format='colon')"
+
+def test_is_mac_case_insensitive():
+    assert '00:11:22:33:44:55' == IsMac()
+    assert '00:11:22:33:44:55'.upper() == IsMac()
+    assert '00:11:22:33:44:55'.upper() == IsMac(format='colon')
