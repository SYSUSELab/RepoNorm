+    def validate_input(cls, data: Any) -> Any:
+        """Validate and parse input data, supporting JSON and Markdown code fences."""
+        if isinstance(data, str):
+            # 1. Try parsing as plain JSON
+            try:
+                return json.loads(data)
+            except json.JSONDecodeError:
+                pass
+
+            # 2. Try parsing as Markdown code fence
+            # Regex to find the first triple-backtick block
+            # Opening fence: ```[optional_label]\n
+            # Closing fence: ```
+            match = re.search(r"```(?:[^\n]*)\n(.*?)\n```", data, re.DOTALL)
+            if match:
+                try:
+                    return json.loads(match.group(1))
+                except json.JSONDecodeError:
+                    pass
+        
+        return data
+
+    @classmethod
+    def model_validate(cls, data: Any, **kwargs) -> "ToolCalls":
+        parsed_data = cls.validate_input(data)
+        
+        # Handle bare list
+        if isinstance(parsed_data, list):
+            parsed_data = {"tool_calls": parsed_data}
+        
+        # Handle single name/args object
+        elif isinstance(parsed_data, dict) and "name" in parsed_data and "args" in parsed_data:
+            parsed_data = {"tool_calls": [parsed_data]}
+            
+        return super().model_validate(parsed_data, **kwargs)
+
