diff --git a/tests/streaming/test_idle_timeout.py b/tests/streaming/test_idle_timeout.py
new file mode 100644
index 00000000..2bd59b83
--- /dev/null
+++ b/tests/streaming/test_idle_timeout.py
@@ -0,0 +1,51 @@
+import time
+import pytest
+from dspy.streaming.streaming_listener import StreamListener
+from dspy.streaming.messages import StreamResponse
+
+def test_idle_timeout():
+    # Mock clock
+    current_time = 0.0
+    def clock():
+        return current_time
+
+    listener = StreamListener("a", idle_timeout_s=1.0, clock=clock)
+    
+    # Initial tick, no timeout
+    assert listener.tick() is None
+    
+    # Advance time
+    current_time = 0.5
+    assert listener.tick() is None
+    
+    # Advance time to timeout
+    current_time = 1.0
+    response = listener.tick()
+    assert isinstance(response, StreamResponse)
+    assert response.chunk == ""
+    
+    # Subsequent tick should be None
+    assert listener.tick() is None
+
+def test_activity_refreshes_timeout():
+    # Mock clock
+    current_time = 0.0
+    def clock():
+        return current_time
+
+    listener = StreamListener("a", idle_timeout_s=1.0, clock=clock)
+    
+    # Advance time
+    current_time = 0.5
+    # Simulate activity
+    listener.receive(None) # This should refresh last_activity
+    
+    # Advance time to 1.0, should not timeout because of activity at 0.5
+    current_time = 1.0
+    assert listener.tick() is None
+    
+    # Advance time to 1.5, should timeout
+    current_time = 1.5
+    response = listener.tick()
+    assert isinstance(response, StreamResponse)
+    assert response.chunk == ""
diff --git a/tests/streaming/test_streamify_timeout.py b/tests/streaming/test_streamify_timeout.py
new file mode 100644
index 00000000..749db011
--- /dev/null
+++ b/tests/streaming/test_streamify_timeout.py
@@ -0,0 +1,40 @@
+import asyncio
+import pytest
+import dspy
+from dspy.streaming.streaming_listener import StreamListener
+from dspy.streaming.streamify import streamify
+from dspy.streaming.messages import StreamResponse
+
+class SlowLM(dspy.LM):
+    def __init__(self):
+        super().__init__("test/model")
+    def __call__(self, prompt, **kwargs):
+        # Simulate a slow response
+        import time
+        time.sleep(0.5)
+        return {"choices": [{"message": {"content": "answer"}}]}
+
+@pytest.mark.asyncio
+async def test_streamify_idle_timeout():
+    # Use the slow LM
+    lm = SlowLM()
+    dspy.settings.configure(lm=lm)
+
+    # The listener needs to be configured with a short timeout
+    listener = StreamListener("a", idle_timeout_s=0.1)
+
+    # Wrap the program
+    predict = dspy.Predict("q->a")
+    wrapped_program = streamify(predict, stream_listeners=[listener], is_async_program=False, async_streaming=False)
+
+    # Run the program
+    # Since it's a sync generator, we can iterate over it
+    output = wrapped_program(q="test")
+
+    results = []
+    for value in output:
+        results.append(value)
+
+    # Check if we got the timeout response
+    timeout_responses = [r for r in results if isinstance(r, StreamResponse) and r.chunk == ""]
+    assert len(timeout_responses) > 0
