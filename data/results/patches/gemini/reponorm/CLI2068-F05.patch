diff --git a/tests/test_lock.py b/tests/test_lock.py
new file mode 100644
index 0000000..6e80912
--- /dev/null
+++ b/tests/test_lock.py
@@ -0,0 +1,41 @@
+import os
+import pytest
+from click import edit, ClickException
+import subprocess
+import time
+import multiprocessing
+
+def test_lock_file_behavior():
+    filename = "test.txt"
+    with open(filename, "w") as f:
+        f.write("hello")
+    
+    # Use a command that ignores arguments and sleeps
+    os.environ["EDITOR"] = "sh -c 'sleep 1'"
+    
+    def run_edit():
+        edit(filename=filename, lock_files=True)
+        
+    p = multiprocessing.Process(target=run_edit)
+    p.start()
+    
+    # Wait for the lock file to be created
+    lock_filename = f".{filename}.lock"
+    for _ in range(20):
+        if os.path.exists(lock_filename):
+            break
+        time.sleep(0.1)
+    
+    assert os.path.exists(lock_filename), "Lock file should exist"
+    
+    # Second edit should fail
+    with pytest.raises(ClickException) as excinfo:
+        edit(filename=filename, lock_files=True)
+    assert "already locked" in str(excinfo.value).lower()
+    
+    p.join()
+    
+    assert not os.path.exists(lock_filename), "Lock file should be removed"
+    
+    if os.path.exists(filename):
+        os.remove(filename)
