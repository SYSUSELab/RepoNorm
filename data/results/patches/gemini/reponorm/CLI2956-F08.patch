diff --git a/test_history.py b/test_history.py
new file mode 100644
index 0000000..451166a
--- /dev/null
+++ b/test_history.py
@@ -0,0 +1,38 @@
+import click
+import time
+from click.core import ParameterSource
+
+def test_option_history():
+    @click.command(track_changes=True)
+    @click.option("--count", "-c", default=1)
+    def cli(count):
+        pass
+
+    ctx = cli.make_context("cli", ["--count", "2"])
+    
+    history = ctx.get_option_history("count")
+    print(f"History for count: {history}")
+    assert history is not None
+    assert len(history) == 1
+    assert history[0]["value"] == 2
+    assert history[0]["source"] == ParameterSource.COMMANDLINE
+    assert "timestamp" in history[0]
+
+    # Test manual assignment
+    ctx.params["count"] = 3
+    
+    history = ctx.get_option_history("count")
+    print(f"History for count after manual assignment: {history}")
+    assert len(history) == 2
+    assert history[1]["value"] == 3
+    assert history[1]["source"] is None
+    assert "timestamp" in history[1]
+
+if __name__ == "__main__":
+    try:
+        test_option_history()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
