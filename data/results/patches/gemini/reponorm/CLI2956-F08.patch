@@ -0,0 +1,35 @@
+import re
+
+with open('src/click/core.py', 'r') as f:
+    content = f.read()
+
+# Define a custom class for params
+params_class = """
+class _ParamsDict(dict):
+    def __init__(self, ctx, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._ctx = ctx
+
+    def __setitem__(self, key, value):
+        if self._ctx.command.track_changes:
+            self._ctx.set_parameter(key, value, source=None)
+        else:
+            super().__setitem__(key, value)
+"""
+
+# Insert this class before Context.__init__
+pattern = r'(class Context\()'
+content = re.sub(pattern, params_class + r'\n\1', content, count=1)
+
+# Update Context.__init__ to use _ParamsDict
+pattern = r'(self.params: dict\[str, t.Any\] = {})'
+replacement = r'self.params = _ParamsDict(self)'
+content = re.sub(pattern, replacement, content, count=1)
+
+# Update set_parameter to use super().__setitem__
+pattern = r'(self.params\[name\] = value)'
+replacement = r'super(type(self.params), self.params).__setitem__(name, value)'
+content = re.sub(pattern, replacement, content, count=1)
+
+with open('src/click/core.py', 'w') as f:
+    f.write(content)
