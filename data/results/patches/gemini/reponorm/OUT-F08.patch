new file mode 100644
index 0000000..33148a9
--- /dev/null
+++ b/test_xgrammar_memory.py
@@ -0,0 +1,68 @@
+import pytest
+import torch
+from unittest.mock import MagicMock
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+
+def test_memory_tracking():
+    # Mock the xgrammar processor
+    class MockXGrammarProcessor:
+        def __call__(self, input_ids, logits):
+            return logits
+
+    # Mock xgrammar module
+    import sys
+    from types import ModuleType
+    xgr = ModuleType("xgrammar")
+    xgr.contrib = ModuleType("contrib")
+    xgr.contrib.hf = ModuleType("hf")
+    xgr.contrib.hf.LogitsProcessor = MagicMock(return_value=MockXGrammarProcessor())
+    sys.modules["xgrammar"] = xgr
+
+    # Test with tracking enabled
+    processor = XGrammarLogitsProcessor(
+        "compiled_grammar",
+        track_memory_usage=True,
+        memory_history_limit=2
+    )
+    
+    input_ids = torch.tensor([[1]])
+    logits = torch.tensor([[1.0, 2.0]])
+    
+    # Call 1
+    processor.process_logits(input_ids, logits)
+    stats = processor.get_memory_stats()
+    assert stats["total_calls"] == 1
+    assert len(stats["memory_history"]) == 1
+    
+    # Call 2
+    processor.process_logits(input_ids, logits)
+    stats = processor.get_memory_stats()
+    assert stats["total_calls"] == 2
+    assert len(stats["memory_history"]) == 2
+    
+    # Call 3 (should trigger limit)
+    processor.process_logits(input_ids, logits)
+    stats = processor.get_memory_stats()
+    assert stats["total_calls"] == 3
+    assert len(stats["memory_history"]) == 2
+    
+    # Reset
+    processor.reset()
+    stats = processor.get_memory_stats()
+    assert stats["total_calls"] == 0
+    assert len(stats["memory_history"]) == 0
+    assert stats["peak_memory_mb"] == 0.0
+
+    # Test invalid limit
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor("grammar", track_memory_usage=True, memory_history_limit=-1)
+
+    # Test tracking disabled
+    processor = XGrammarLogitsProcessor("grammar", track_memory_usage=False)
+    processor.process_logits(input_ids, logits)
+    stats = processor.get_memory_stats()
+    assert stats["total_calls"] == 0
+
+if __name__ == "__main__":
+    test_memory_tracking()
+    print("Tests passed!")
