+import pytest
+from unittest.mock import MagicMock, patch
+import sys
+
+# Mock OutlinesLogitsProcessor before importing XGrammarLogitsProcessor
+class MockOutlinesLogitsProcessor:
+    def __init__(self, *args, **kwargs):
+        pass
+
+sys.modules["outlines.processors.base_logits_processor"] = MagicMock()
+sys.modules["outlines.processors.base_logits_processor"].OutlinesLogitsProcessor = MockOutlinesLogitsProcessor
+sys.modules["outlines.processors.base_logits_processor"].TensorType = object
+
+# Mock Transformers
+class MockTransformers:
+    pass
+
+sys.modules["outlines.models.transformers"] = MagicMock()
+sys.modules["outlines.models.transformers"].Transformers = MockTransformers
+
+from outlines.backends.xgrammar import XGrammarLogitsProcessor, XGrammarBackend
+
+def test_xgrammar_logits_processor_memory_tracking():
+    # Mock the xgrammar processor
+    class MockXGrammarProcessor:
+        def __call__(self, input_ids, logits):
+            return logits
+
+    # Mock xgrammar module
+    with patch.dict("sys.modules", {"xgrammar": MagicMock()}):
+        import xgrammar as xgr
+        xgr.contrib.hf.LogitsProcessor = MagicMock(return_value=MockXGrammarProcessor())
+
+        # Test with tracking enabled
+        processor = XGrammarLogitsProcessor(
+            "compiled_grammar",
+            track_memory_usage=True,
+            memory_history_limit=2
+        )
+        
+        # Mock process_logits to not call super()
+        processor.xgrammar_logits_processor = MockXGrammarProcessor()
+        
+        # Mock _get_rss_mb
+        processor._get_rss_mb = MagicMock(side_effect=[10.0, 20.0, 10.0, 30.0, 10.0, 40.0])
+        
+        input_ids = MagicMock()
+        logits = MagicMock()
+        
+        # Call 1
+        processor.process_logits(input_ids, logits)
+        stats = processor.get_memory_stats()
+        assert stats["total_calls"] == 1
+        assert stats["memory_history"] == [10.0]
+        
+        # Call 2
+        processor.process_logits(input_ids, logits)
+        stats = processor.get_memory_stats()
+        assert stats["total_calls"] == 2
+        assert stats["memory_history"] == [10.0, 20.0]
+        
+        # Call 3 (should trigger limit)
+        processor.process_logits(input_ids, logits)
+        stats = processor.get_memory_stats()
+        assert stats["total_calls"] == 3
+        assert stats["memory_history"] == [20.0, 30.0]
+        
+        # Reset
+        processor.reset()
+        stats = processor.get_memory_stats()
+        assert stats["total_calls"] == 0
+        assert len(stats["memory_history"]) == 0
+        assert stats["peak_memory_mb"] == 0.0
+
+        # Test invalid limit
+        with pytest.raises(ValueError):
+            XGrammarLogitsProcessor("grammar", track_memory_usage=True, memory_history_limit=-1)
+
+        # Test tracking disabled
+        processor = XGrammarLogitsProcessor("grammar", track_memory_usage=False)
+        processor.process_logits(input_ids, logits)
+        stats = processor.get_memory_stats()
+        assert stats["total_calls"] == 0
+
+def test_xgrammar_backend_memory_tracking_forwarding():
+    # Mock xgrammar module
+    with patch.dict("sys.modules", {"xgrammar": MagicMock()}):
+        import xgrammar as xgr
+        
+        # Mock model
+        model = MagicMock(spec=MockTransformers)
+        model.model = MagicMock()
+        model.model.config = MagicMock()
+        model.model.config._name_or_path = "test"
+        model.hf_tokenizer = MagicMock()
+        
+        # Mock AutoConfig
+        with patch("transformers.AutoConfig.from_pretrained") as mock_config:
+            mock_config.return_value.vocab_size = 100
+            
+            backend = XGrammarBackend(
+                model,
+                track_memory_usage=True,
+                memory_history_limit=5
+            )
+            
+            processor = backend.get_json_schema_logits_processor("{}")
+            assert processor.track_memory_usage is True
+            assert processor.memory_history_limit == 5
