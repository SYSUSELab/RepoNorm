+import os
+import psutil
+import threading
+import time
+
+def get_rss_mb():
+    try:
+        process = psutil.Process(os.getpid())
+        return process.memory_info().rss / (1024 * 1024)
+    except Exception:
+        return None
+
+def track_memory():
+    before = get_rss_mb()
+    # Simulate some work
+    a = [i for i in range(1000000)]
+    after = get_rss_mb()
+    
+    if before is not None and after is not None:
+        delta = max(after - before, 0)
+        print(f"Delta: {delta} MB")
+    else:
+        print("Failed to get RSS")
+
+track_memory()
