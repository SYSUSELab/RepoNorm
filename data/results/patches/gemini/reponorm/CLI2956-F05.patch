diff --git a/test_cache_option.py b/test_cache_option.py
new file mode 100644
index 0000000..e576f4e
--- /dev/null
+++ b/test_cache_option.py
@@ -0,0 +1,66 @@
+import click
+import pytest
+
+def test_option_cache():
+    call_count = 0
+    
+    def custom_type_convert(value, param, ctx):
+        nonlocal call_count
+        call_count += 1
+        return value.upper()
+
+    custom_type = click.ParamType()
+    custom_type.convert = custom_type_convert
+
+    # Create an option with cache=True
+    option = click.Option(['--test'], type=custom_type, cache=True)
+    
+    ctx = click.Context(click.Command('test'))
+    
+    # First call
+    assert option.type_cast_value(ctx, 'foo') == 'FOO'
+    assert call_count == 1
+    
+    # Second call with same value
+    assert option.type_cast_value(ctx, 'foo') == 'FOO'
+    assert call_count == 1
+    
+    # Third call with different value
+    assert option.type_cast_value(ctx, 'bar') == 'BAR'
+    assert call_count == 2
+    
+    # Clear cache
+    option.clear_value_cache()
+    
+    # Fourth call with same value as first
+    assert option.type_cast_value(ctx, 'foo') == 'FOO'
+    assert call_count == 3
+
+def test_option_no_cache():
+    call_count = 0
+    
+    def custom_type_convert(value, param, ctx):
+        nonlocal call_count
+        call_count += 1
+        return value.upper()
+
+    custom_type = click.ParamType()
+    custom_type.convert = custom_type_convert
+
+    # Create an option with cache=False
+    option = click.Option(['--test'], type=custom_type, cache=False)
+    
+    ctx = click.Context(click.Command('test'))
+    
+    # First call
+    assert option.type_cast_value(ctx, 'foo') == 'FOO'
+    assert call_count == 1
+    
+    # Second call with same value
+    assert option.type_cast_value(ctx, 'foo') == 'FOO'
+    assert call_count == 2
+
+if __name__ == '__main__':
+    test_option_cache()
+    test_option_no_cache()
+    print("All tests passed!")
