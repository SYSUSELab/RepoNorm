@@ -403,3 +403,35 @@ def test_template_from_str_with_extra_linebreaks():
     """
     template = Prompt._template_from_str(content)
     assert template.render(name="World") == "Hello, World!\n"
+
+def test_global_filter_registry():
+    import outlines.prompts as prompts
+    import jinja2
+
+    # Test registration
+    def my_filter(x):
+        return f"filtered_{x}"
+    
+    prompts.register_filter("my_filter", my_filter)
+    
+    # Test that it's available in new prompts
+    p1 = prompts.Prompt.from_str("{{ 'hello' | my_filter }}")
+    assert p1() == "filtered_hello"
+    
+    # Test that existing prompts are NOT affected
+    prompts.unregister_filter("my_filter")
+    
+    # p1 should still work
+    assert p1() == "filtered_hello"
+    
+    # New prompt should fail
+    with pytest.raises(jinja2.exceptions.TemplateAssertionError):
+        p2 = prompts.Prompt.from_str("{{ 'hello' | my_filter }}")
+        p2()
+
+    # Test that we cannot override protected filters
+    def my_name_filter(fn):
+        return "hacked"
+    
+    with pytest.raises(ValueError, match="protected"):
+        prompts.register_filter("name", my_name_filter)
