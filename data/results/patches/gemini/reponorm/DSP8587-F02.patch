+import pytest
+from dspy.streaming.streaming_listener import StreamListener
+
+def test_end_buffer_size_validation():
+    # Valid values
+    StreamListener(signature_field_name="answer", end_buffer_size=3)
+    StreamListener(signature_field_name="answer", end_buffer_size=10)
+    StreamListener(signature_field_name="answer", end_buffer_size=64)
+
+    # Non-integer
+    with pytest.raises(ValueError, match="end_buffer_size must be an integer"):
+        StreamListener(signature_field_name="answer", end_buffer_size="10")
+    with pytest.raises(ValueError, match="end_buffer_size must be an integer"):
+        StreamListener(signature_field_name="answer", end_buffer_size=True)
+
+    # Below 3
+    with pytest.raises(ValueError, match="end_buffer_size must be at least 3"):
+        StreamListener(signature_field_name="answer", end_buffer_size=2)
+
+    # Above 64
+    with pytest.raises(ValueError, match="end_buffer_size must be at most 64"):
+        StreamListener(signature_field_name="answer", end_buffer_size=65)
