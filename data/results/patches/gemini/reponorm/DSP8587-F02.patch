+import re
+
+with open('dspy/streaming/streaming_listener.py', 'r') as f:
+    content = f.read()
+
+# Update the `if not self.stream_start` block to strip the `\n`.
+# The original block:
+#                     if start_identifier in chunk_message:
+#                         chunk_message = chunk_message[chunk_message.find(start_identifier) + len(start_identifier) :]
+#                     else:
+#                         self.field_start_queue.append(chunk_message)
+#                         return
+
+# I will change it to:
+#                     if start_identifier in chunk_message:
+#                         chunk_message = chunk_message[chunk_message.find(start_identifier) + len(start_identifier) :].lstrip()
+#                     else:
+#                         self.field_start_queue.append(chunk_message)
+#                         return
+
+pattern = r'''                    if start_identifier in chunk_message:
+                        chunk_message = chunk_message\[chunk_message.find\(start_identifier\) \+ len\(start_identifier\) :\]
+                    else:
+                        self.field_start_queue.append\(chunk_message\)
+                        return'''
+
+replacement = r'''                    if start_identifier in chunk_message:
+                        chunk_message = chunk_message[chunk_message.find(start_identifier) + len(start_identifier) :].lstrip()
+                    else:
+                        self.field_start_queue.append(chunk_message)
+                        return'''
+
+content = re.sub(pattern, replacement, content)
+
+with open('dspy/streaming/streaming_listener.py', 'w') as f:
+    f.write(content)
