diff --git a/apply_changes.py b/apply_changes.py
new file mode 100644
index 00000000..c21130d9
--- /dev/null
+++ b/apply_changes.py
@@ -0,0 +1,73 @@
+import re
+
+with open('dspy/streaming/streaming_listener.py', 'r') as f:
+    content = f.read()
+
+# Add end_buffer_size to __init__
+init_pattern = r'(allow_reuse: bool = False,)'
+init_replacement = r'\1\n        end_buffer_size: int = 10,'
+content = re.sub(init_pattern, init_replacement, content)
+
+# Add validation to __init__
+validation_code = """
+        if not isinstance(end_buffer_size, int) or isinstance(end_buffer_size, bool):
+            raise ValueError("end_buffer_size must be an integer")
+        if end_buffer_size < 3:
+            raise ValueError("end_buffer_size must be at least 3")
+        if end_buffer_size > 64:
+            raise ValueError("end_buffer_size must be at most 64")
+        self.end_buffer_size = end_buffer_size
+"""
+# Insert after __init__ signature
+content = re.sub(r'(\s+allow_reuse: bool = False,\n        end_buffer_size: int = 10,\n    \):)', r'\1' + validation_code, content)
+
+# Update receive to use self.end_buffer_size and report watermark
+# Find the part where it uses 10 and replace it with self.end_buffer_size
+# The original code had:
+#                 # We keep the last 10 tokens in the buffer to check if they form a valid identifier for end_identifier,
+#                 # i.e., "[[ ## {next_field_name} ## ]]" for ChatAdapter to identify the end of the current field.
+#                 # In most cases 10 tokens are enough to cover the end_identifier for all adapters.
+#                 token = self.field_end_queue.get()
+
+# I will replace the logic in `receive`
+receive_pattern = r'''        if self.stream_start:
+            self.field_end_queue.put(chunk_message)
+            token = None
+            if self.field_end_queue.qsize() > 10:
+                token = self.field_end_queue.get()
+            concat_message = "".join(self.field_end_queue.queue).strip()
+            if re.search(end_identifier, concat_message):
+                # The next field is identified, we can end the stream and flush out all tokens in the buffer.
+                self.stream_end = True
+                last_token = self.flush()
+                token = token + last_token if token else last_token
+                token = token.rstrip()  # Remove the trailing \n\n
+
+            if token:
+                return StreamResponse(self.predict_name, self.signature_field_name, token)'''
+
+receive_replacement = r'''        if self.stream_start:
+            self.field_end_queue.put(chunk_message)
+            
+            # Capture current queue size BEFORE dequeuing
+            current_queue_size = self.field_end_queue.qsize()
+            watermark = min(current_queue_size, self.end_buffer_size)
+            
+            token = None
+            if current_queue_size > self.end_buffer_size:
+                token = self.field_end_queue.get()
+            
+            concat_message = "".join(self.field_end_queue.queue).strip()
+            if re.search(end_identifier, concat_message):
+                self.stream_end = True
+                last_token = self.flush()
+                token = token + last_token if token else last_token
+                token = token.rstrip()
+
+            if token or self.stream_end:
+                return StreamResponse(self.predict_name, self.signature_field_name, token or "", watermark)'''
+
+content = content.replace(receive_pattern, receive_replacement)
+
+with open('dspy/streaming/streaming_listener.py', 'w') as f:
+    f.write(content)
