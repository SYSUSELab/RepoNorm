diff --git a/tests/test_edit_working_dir.py b/tests/test_edit_working_dir.py
new file mode 100644
index 0000000..3369c32
--- /dev/null
+++ b/tests/test_edit_working_dir.py
@@ -0,0 +1,36 @@
+import os
+import click
+import pytest
+import subprocess
+
+def test_edit_working_dir(tmp_path):
+    working_dir = tmp_path / "working_dir"
+    working_dir.mkdir()
+    
+    test_file = working_dir / "test.txt"
+    test_file.write_text("hello")
+    
+    editor_cmd = "sh -c 'pwd > pwd.txt'"
+    
+    click.edit(filename="test.txt", editor=editor_cmd, working_dir=str(working_dir))
+        
+    assert (working_dir / "pwd.txt").exists()
+    assert (working_dir / "pwd.txt").read_text().strip() == str(working_dir)
+
+def test_edit_text_working_dir(tmp_path):
+    working_dir = tmp_path / "working_dir_text"
+    working_dir.mkdir()
+    
+    editor_script = tmp_path / "editor_text.sh"
+    editor_script.write_text("#!/bin/sh\necho 'modified' > \"$1\"\n")
+    os.chmod(editor_script, 0o755)
+    
+    text = "hello world"
+    # Use 'sh' to run the script
+    editor_cmd = f"sh {editor_script}"
+    
+    result = click.edit(text=text, editor=editor_cmd, working_dir=str(working_dir))
+    assert result == "modified\n"
+    
+    files = list(working_dir.glob("editor-*"))
+    assert len(files) == 0
