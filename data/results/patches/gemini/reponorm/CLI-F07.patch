diff --git a/tests/test_context_nesting.py b/tests/test_context_nesting.py
new file mode 100644
index 0000000..8708ddb
--- /dev/null
+++ b/tests/test_context_nesting.py
@@ -0,0 +1,62 @@
+import pytest
+import click
+from click.core import Context
+
+def test_context_nesting_validation():
+    # Test that validation is disabled by default
+    ctx = Context(click.Command("test"))
+    assert ctx.validate_nesting is False
+
+    # Test that validation can be enabled
+    ctx = Context(click.Command("test"), validate_nesting=True)
+    assert ctx.validate_nesting is True
+
+    # Test that validation is inherited
+    parent = Context(click.Command("parent"), validate_nesting=True)
+    child = Context(click.Command("child"), parent=parent)
+    assert child.validate_nesting is True
+
+    # Test that validation can be disabled in child
+    child2 = Context(click.Command("child2"), parent=parent, validate_nesting=False)
+    assert child2.validate_nesting is False
+
+def test_context_nesting_enforcement():
+    parent = Context(click.Command("parent"), validate_nesting=True, info_name="parent")
+    child = Context(click.Command("child"), parent=parent, info_name="child")
+    
+    # Closing parent while child is open should raise RuntimeError
+    with pytest.raises(RuntimeError, match=r"Cannot close context 'parent' because children are still open: \['child'\]"):
+        parent.close()
+    
+    # Closing child should allow parent to close
+    child.close()
+    parent.close()
+
+def test_context_nesting_multiple_children():
+    parent = Context(click.Command("parent"), validate_nesting=True, info_name="parent")
+    child1 = Context(click.Command("child1"), parent=parent, info_name="child1")
+    child2 = Context(click.Command("child2"), parent=parent, info_name="child2")
+    
+    with pytest.raises(RuntimeError, match=r"Cannot close context 'parent' because children are still open: \['child1', 'child2'\]"):
+        parent.close()
+        
+    child1.close()
+    with pytest.raises(RuntimeError, match=r"Cannot close context 'parent' because children are still open: \['child2'\]"):
+        parent.close()
+        
+    child2.close()
+    parent.close()
+
+def test_context_nesting_reopen():
+    parent = Context(click.Command("parent"), validate_nesting=True, info_name="parent")
+    child = Context(click.Command("child"), parent=parent, info_name="child")
+    
+    child.close()
+    parent.close()
+    
+    # Re-opening child
+    child2 = Context(click.Command("child"), parent=parent, info_name="child")
+    with pytest.raises(RuntimeError, match=r"Cannot close context 'parent' because children are still open: \['child'\]"):
+        parent.close()
+    child2.close()
+    parent.close()
