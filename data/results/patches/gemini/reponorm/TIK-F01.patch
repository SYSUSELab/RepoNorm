@@ -0,0 +1,52 @@
+import tiktoken
+import pytest
+
+def test_budget_implementation():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test max_tokens
+    # "hello world" -> [31373, 995] (2 tokens)
+    
+    # Should work
+    enc.encode("hello world", max_tokens=2)
+    enc.encode("hello world", max_tokens=3)
+    
+    # Should raise ValueError
+    with pytest.raises(ValueError, match="max_tokens exceeded"):
+        enc.encode("hello world", max_tokens=1)
+        
+    # Should raise ValueError for invalid max_tokens
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello world", max_tokens=0)
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello world", max_tokens=-1)
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode("hello world", max_tokens=True) # bool is not int
+
+    # Test encode_batch
+    # ["hello", "world"] -> [[31373], [995]]
+    
+    # Should work
+    enc.encode_batch(["hello", "world"], max_tokens=1, max_total_tokens=2)
+    
+    # Should raise ValueError for per-document budget
+    with pytest.raises(ValueError, match="max_tokens must be a positive integer"):
+        enc.encode_batch(["hello", "world"], max_tokens=0)
+        
+    # Should raise ValueError for total budget
+    with pytest.raises(ValueError, match="max_total_tokens exceeded"):
+        enc.encode_batch(["hello", "world"], max_total_tokens=1)
+        
+    # Should raise ValueError for invalid max_total_tokens
+    with pytest.raises(ValueError, match="max_total_tokens must be a positive integer"):
+        enc.encode_batch(["hello", "world"], max_total_tokens=0)
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    try:
+        test_budget_implementation()
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
