diff --git a/tests/test_resource_limits.py b/tests/test_resource_limits.py
new file mode 100644
index 0000000..cf026fc
--- /dev/null
+++ b/tests/test_resource_limits.py
@@ -0,0 +1,96 @@
+import pytest
+import click
+from contextlib import contextmanager
+
+@contextmanager
+def dummy_resource():
+    yield "resource"
+
+def test_resource_limits_enforced():
+    @click.group(context_settings={"max_resources": 1})
+    def cli():
+        pass
+
+    @cli.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.with_resource(dummy_resource())
+        ctx.with_resource(dummy_resource())
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["cmd"])
+    assert result.exit_code != 0
+    assert isinstance(result.exception, RuntimeError)
+
+def test_resource_limits_inherited():
+    @click.group(context_settings={"max_resources": 1})
+    def cli():
+        pass
+
+    @cli.group()
+    @click.pass_context
+    def sub(ctx):
+        pass
+
+    @sub.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.with_resource(dummy_resource())
+        ctx.with_resource(dummy_resource())
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["sub", "cmd"])
+    assert result.exit_code != 0
+    assert isinstance(result.exception, RuntimeError)
+
+def test_resource_limits_child_override_stricter():
+    @click.group(context_settings={"max_resources": 2})
+    def cli():
+        pass
+
+    @cli.group(context_settings={"max_resources": 1})
+    @click.pass_context
+    def sub(ctx):
+        pass
+
+    @sub.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.with_resource(dummy_resource())
+        ctx.with_resource(dummy_resource())
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["sub", "cmd"])
+    assert result.exit_code != 0
+    assert isinstance(result.exception, RuntimeError)
+
+def test_resource_limits_zero():
+    @click.group(context_settings={"max_resources": 0})
+    def cli():
+        pass
+
+    @cli.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.with_resource(dummy_resource())
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["cmd"])
+    assert result.exit_code != 0
+    assert isinstance(result.exception, RuntimeError)
+
+def test_resource_limits_release():
+    @click.group(context_settings={"max_resources": 1})
+    def cli():
+        pass
+
+    @cli.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.with_resource(dummy_resource())
+        ctx.close()
+        ctx.with_resource(dummy_resource())
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, ["cmd"])
+    assert result.exit_code == 0
