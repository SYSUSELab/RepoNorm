+
+def test_i18n_context():
+    from jinja2.ext import InternationalizationExtension
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    def pgettext(context, message):
+        return f"[{context}] {message}"
+    
+    env.globals['pgettext'] = pgettext
+    
+    tmpl = env.from_string("{% trans 'foo' %}bar{% endtrans %}")
+    assert tmpl.render() == "[foo] bar"
+
+def test_i18n_context_plural():
+    from jinja2.ext import InternationalizationExtension
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    def npgettext(context, singular, plural, n):
+        return f"[{context}] {singular if n == 1 else plural}"
+    
+    env.globals['npgettext'] = npgettext
+    env.globals['ngettext'] = lambda s, p, n: s if n == 1 else p
+    
+    tmpl = env.from_string("{% trans 'foo' count=count %}{{ count }} bar{% pluralize %}{{ count }} bars{% endtrans %}")
+    assert tmpl.render(count=1) == "[foo] 1 bar"
+    assert tmpl.render(count=2) == "[foo] 2 bars"
