+++ b/add_conflict_check.py
@@ -0,0 +1,37 @@
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find Command.invoke
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def invoke(self, ctx: Context) -> t.Any:' in line and 'class Command' in lines[i-50:i]:
+        start_line = i
+        break
+
+# Find where to insert
+for i in range(start_line, start_line + 30):
+    if 'if self.callback is not None:' in lines[i]:
+        # Insert before this line
+        lines.insert(i, '''        for param in self.get_params(ctx):
+            if isinstance(param, Option) and param.conflicts_with:
+                conflicts = param.conflicts_with
+                if isinstance(conflicts, str):
+                    conflicts = [conflicts]
+                
+                for conflict in conflicts:
+                    if not isinstance(conflict, str):
+                        raise TypeError(f"conflicts_with must be a string or sequence of strings, not {type(conflict).__name__}")
+                    
+                    # Check if both are provided
+                    source1 = ctx.get_parameter_source(param.name)
+                    source2 = ctx.get_parameter_source(conflict)
+                    
+                    if source1 in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT) and \
+                       source2 in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):
+                        from click.exceptions import UsageError
+                        raise UsageError(f"Option '--{param.name.replace('_', '-')}' cannot be used together with '--{conflict.replace('_', '-')}'.")
+''')
+        break
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(lines)
