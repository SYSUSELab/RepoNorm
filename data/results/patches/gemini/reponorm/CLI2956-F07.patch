+
+def validate_conflicts(conflicts_with):
+    if conflicts_with is None:
+        return []
+    if isinstance(conflicts_with, str):
+        conflicts_with = [conflicts_with]
+    
+    if not isinstance(conflicts_with, (list, tuple)):
+        raise TypeError("conflicts_with must be a string or a sequence of strings.")
+    
+    validated = []
+    for name in conflicts_with:
+        if not isinstance(name, str):
+            raise TypeError("conflicts_with must contain only strings.")
+        if name.startswith("-"):
+            raise TypeError(f"conflicts_with name '{name}' should not have option prefixes.")
+        validated.append(name)
+    return validated
