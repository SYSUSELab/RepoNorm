@@ -0,0 +1,60 @@
+import os
+import pytest
+import shutil
+from click.termui import edit
+from click.exceptions import ClickException
+
+def test_auto_backup(tmp_path):
+    # Create a file
+    file_path = tmp_path / "test.txt"
+    file_path.write_text("hello")
+    
+    # Edit the file with auto_backup=True
+    # We need to mock the editor, but `click.edit` uses `EDITOR` env var.
+    # Let's set `EDITOR` to `true` (which does nothing and exits with 0).
+    os.environ["EDITOR"] = "true"
+    
+    edit(filename=str(file_path), auto_backup=True)
+    
+    # Check if backup file exists
+    backups = list(tmp_path.glob("test.txt.backup.*"))
+    assert len(backups) == 1
+    assert backups[0].read_text() == "hello"
+
+def test_auto_backup_collision(tmp_path):
+    # Create a file
+    file_path = tmp_path / "test.txt"
+    file_path.write_text("hello")
+    
+    # Create a backup file manually to force collision
+    # The timestamp format is YYYYMMDD_HHMMSS
+    # We need to make sure the timestamp is the same.
+    # Actually, the code uses `datetime.datetime.now()`.
+    # So we can't easily control the timestamp.
+    # But we can create a file with the same name.
+    
+    # Let's just run it twice and see if it creates a collision file.
+    os.environ["EDITOR"] = "true"
+    
+    edit(filename=str(file_path), auto_backup=True)
+    edit(filename=str(file_path), auto_backup=True)
+    
+    backups = list(tmp_path.glob("test.txt.backup.*"))
+    assert len(backups) >= 2
+
+def test_auto_backup_failure(tmp_path):
+    # Create a file
+    file_path = tmp_path / "test.txt"
+    file_path.write_text("hello")
+    
+    # Make the directory read-only to force OSError
+    os.chmod(tmp_path, 0o555)
+    
+    os.environ["EDITOR"] = "true"
+    
+    with pytest.raises(ClickException, match="Failed to create backup file"):
+        edit(filename=str(file_path), auto_backup=True)
+    
+    # Restore permissions
+    os.chmod(tmp_path, 0o777)
+
