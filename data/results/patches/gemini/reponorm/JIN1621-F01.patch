+class TestFileSystemLoaderFallback:
+    def test_fallback_searchpath(self, tmp_path):
+        primary = tmp_path / "primary"
+        primary.mkdir()
+        fallback = tmp_path / "fallback"
+        fallback.mkdir()
+
+        (primary / "test.txt").write_text("primary")
+        (fallback / "test.txt").write_text("fallback")
+        (fallback / "only_fallback.txt").write_text("only_fallback")
+
+        loader = loaders.FileSystemLoader(
+            searchpath=[str(primary)],
+            fallback_searchpath=[str(fallback)]
+        )
+
+        # Should find primary
+        source, filename, uptodate = loader.get_source(None, "test.txt")
+        assert source == "primary"
+
+        # Should find fallback
+        source, filename, uptodate = loader.get_source(None, "only_fallback.txt")
+        assert source == "only_fallback"
+
+        # Test list_templates
+        templates = loader.list_templates()
+        assert "test.txt" in templates
+        assert "only_fallback.txt" in templates
+        assert len(templates) == 2
+
+    def test_fallback_searchpath_none(self, tmp_path):
+        primary = tmp_path / "primary"
+        primary.mkdir()
+        (primary / "test.txt").write_text("primary")
+
+        loader = loaders.FileSystemLoader(
+            searchpath=[str(primary)],
+            fallback_searchpath=None
+        )
+        assert loader.fallback_searchpath == []
+        
+        with pytest.raises(TemplateNotFound):
+            loader.get_source(None, "not_found.txt")
+
+    def test_fallback_searchpath_order(self, tmp_path):
+        # Test that primary is searched before fallback
+        primary = tmp_path / "primary"
+        primary.mkdir()
+        fallback = tmp_path / "fallback"
+        fallback.mkdir()
+
+        (primary / "test.txt").write_text("primary")
+        (fallback / "test.txt").write_text("fallback")
+
+        loader = loaders.FileSystemLoader(
+            searchpath=[str(primary)],
+            fallback_searchpath=[str(fallback)]
+        )
+
+        source, filename, uptodate = loader.get_source(None, "test.txt")
+        assert source == "primary"
+
+    def test_fallback_searchpath_multiple(self, tmp_path):
+        # Test multiple fallback paths
+        fallback1 = tmp_path / "fallback1"
+        fallback1.mkdir()
+        fallback2 = tmp_path / "fallback2"
+        fallback2.mkdir()
+
+        (fallback1 / "f1.txt").write_text("f1")
+        (fallback2 / "f2.txt").write_text("f2")
+
+        loader = loaders.FileSystemLoader(
+            searchpath=[],
+            fallback_searchpath=[str(fallback1), str(fallback2)]
+        )
+
+        source, _, _ = loader.get_source(None, "f1.txt")
+        assert source == "f1"
+        source, _, _ = loader.get_source(None, "f2.txt")
+        assert source == "f2"
+
+    def test_list_templates_deduplication(self, tmp_path):
+        # Test that list_templates removes duplicates
+        primary = tmp_path / "primary"
+        primary.mkdir()
+        fallback = tmp_path / "fallback"
+        fallback.mkdir()
+
+        (primary / "shared.txt").write_text("primary")
+        (fallback / "shared.txt").write_text("fallback")
+        (primary / "p.txt").write_text("p")
+        (fallback / "f.txt").write_text("f")
+
+        loader = loaders.FileSystemLoader(
+            searchpath=[str(primary)],
+            fallback_searchpath=[str(fallback)]
+        )
+
+        templates = loader.list_templates()
+        assert "shared.txt" in templates
+        assert "p.txt" in templates
+        assert "f.txt" in templates
+        assert len(templates) == 3
