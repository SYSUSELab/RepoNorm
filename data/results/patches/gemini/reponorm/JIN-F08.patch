diff --git a/tests/test_groupby_counts.py b/tests/test_groupby_counts.py
new file mode 100644
index 0000000..f2d68e6
--- /dev/null
+++ b/tests/test_groupby_counts.py
@@ -0,0 +1,47 @@
+import pytest
+import asyncio
+from jinja2 import Environment
+
+def test_groupby_counts():
+    env = Environment()
+    items = [{"city": "NY", "name": "a"}, {"city": "NY", "name": "b"}, {"city": "LA", "name": "c"}]
+    
+    # Test with_counts=True
+    # Pass env as the first argument because of @pass_environment
+    result = env.filters["groupby"](env, items, "city", with_counts=True)
+    assert len(result) == 2
+    assert result[0].grouper == "LA"
+    assert result[0].count == 1
+    assert result[1].grouper == "NY"
+    assert result[1].count == 2
+    
+    # Test unpacking
+    for grouper, items_list, count in result:
+        assert len(items_list) == count
+        
+    # Test with_counts=False (default)
+    result = env.filters["groupby"](env, items, "city", with_counts=False)
+    assert len(result) == 2
+    for grouper, items_list in result:
+        assert isinstance(items_list, list)
+        
+    # Test default
+    result = env.filters["groupby"](env, items, "city")
+    assert len(result) == 2
+    for grouper, items_list in result:
+        assert isinstance(items_list, list)
+
+def test_groupby_counts_async():
+    async def run():
+        env = Environment(enable_async=True)
+        items = [{"city": "NY", "name": "a"}, {"city": "NY", "name": "b"}, {"city": "LA", "name": "c"}]
+        
+        # Test with_counts=True
+        result = await env.filters["groupby"](env, items, "city", with_counts=True)
+        assert len(result) == 2
+        assert result[0].grouper == "LA"
+        assert result[0].count == 1
+        assert result[1].grouper == "NY"
+        assert result[1].count == 2
+    
+    asyncio.run(run())
