@@ -0,0 +1,23 @@
+import logging
+from dspy.streaming.streaming_listener import StreamListener
+from unittest.mock import MagicMock
+
+def test_logging_initialization():
+    logger = MagicMock(spec=logging.Logger)
+    logger.isEnabledFor.return_value = True
+    listener = StreamListener(signature_field_name="answer", debug=True, debug_logger=logger)
+    assert listener.debug is True
+    assert listener.debug_logger == logger
+    
+    # Test _log_debug
+    listener._log_debug("test message")
+    logger.debug.assert_called_with("test message")
+
+if __name__ == "__main__":
+    try:
+        test_logging_initialization()
+        print("Test passed!")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"Test failed: {e}")
