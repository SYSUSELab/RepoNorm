+import logging
+from dspy.streaming.streaming_listener import StreamListener
+
+def test_logging_initialization():
+    logger = logging.getLogger("test_logger")
+    listener = StreamListener(signature_field_name="answer", debug=True, debug_logger=logger)
+    assert listener.debug is True
+    assert listener.debug_logger == logger
+
+if __name__ == "__main__":
+    try:
+        test_logging_initialization()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
