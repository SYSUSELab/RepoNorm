diff --git a/tests/streaming/test_streaming_metrics.py b/tests/streaming/test_streaming_metrics.py
new file mode 100644
index 00000000..84812dd5
--- /dev/null
+++ b/tests/streaming/test_streaming_metrics.py
@@ -0,0 +1,62 @@
+import time
+import pytest
+from unittest.mock import MagicMock
+from dspy.streaming.streaming_listener import StreamListener
+from dspy.streaming.messages import StreamResponse
+
+def test_stream_listener_stats():
+    listener = StreamListener(signature_field_name="answer", predict_name="my_predictor")
+    
+    # Initial state
+    stats = listener.stats()
+    assert stats["predict_name"] == "my_predictor"
+    assert stats["field"] == "answer"
+    assert stats["chunk_count"] == 0
+    assert stats["char_count"] == 0
+    assert stats["first_ts"] is None
+    assert stats["last_ts"] is None
+    assert stats["duration_s"] is None
+    assert stats["avg_chunk_chars"] == 0
+
+    # Simulate receiving chunks
+    chunk1 = MagicMock()
+    chunk1.choices = [MagicMock()]
+    chunk1.choices[0].delta.content = "Hello"
+    
+    listener.receive(chunk1)
+    
+    # After first chunk
+    stats = listener.stats()
+    assert stats["chunk_count"] == 1
+    assert stats["char_count"] == 5
+    assert stats["first_ts"] is not None
+    assert stats["last_ts"] is not None
+    assert stats["duration_s"] >= 0
+    assert stats["avg_chunk_chars"] == 5.0
+
+    # Simulate second chunk
+    chunk2 = MagicMock()
+    chunk2.choices = [MagicMock()]
+    chunk2.choices[0].delta.content = " world"
+    
+    time.sleep(0.1)
+    listener.receive(chunk2)
+    
+    stats = listener.stats()
+    assert stats["chunk_count"] == 2
+    assert stats["char_count"] == 11
+    assert stats["duration_s"] >= 0.1
+    assert stats["avg_chunk_chars"] == 5.5
+
+    # Simulate end of stream
+    # The listener logic for end is complex, let's just set stream_end manually to test reset
+    listener.stream_end = True
+    
+    # After stream_end, stats should be reset
+    stats = listener.stats()
+    assert stats["chunk_count"] == 0
+    assert stats["char_count"] == 0
+    assert stats["first_ts"] is None
+    assert stats["last_ts"] is None
+    assert stats["duration_s"] is None
+    assert stats["avg_chunk_chars"] == 0
