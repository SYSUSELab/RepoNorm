+++ b/tests/types/test_mac_address.py
@@ -0,0 +1,27 @@
+import pytest
+from outlines import types
+from outlines.types.dsl import Regex
+
+def test_mac_address_type():
+    mac = types.mac_address
+    assert isinstance(mac, Regex)
+    
+    # Test valid MAC addresses
+    assert mac.validate("00:11:22:33:44:55") == "00:11:22:33:44:55"
+    assert mac.validate("00-11-22-33-44-55") == "00-11-22-33-44-55"
+    assert mac.validate("AA:BB:CC:DD:EE:FF") == "AA:BB:CC:DD:EE:FF"
+    assert mac.validate("aa:bb:cc:dd:ee:ff") == "aa:bb:cc:dd:ee:ff"
+    
+    # Test invalid MAC addresses
+    with pytest.raises(ValueError):
+        mac.validate("00:11-22:33-44:55")
+    with pytest.raises(ValueError):
+        mac.validate("00:11:22:33:44:5")
+    with pytest.raises(ValueError):
+        mac.validate("00:11:22:33:44:555")
+    with pytest.raises(ValueError):
+        mac.validate("00:11:22:33:44:55:66")
+    with pytest.raises(ValueError):
+        mac.validate("00:11:22:33:44")
+    with pytest.raises(ValueError):
+        mac.validate("GG:HH:II:JJ:KK:LL")
