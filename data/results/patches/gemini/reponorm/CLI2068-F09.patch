diff --git a/tests/test_env_isolation.py b/tests/test_env_isolation.py
new file mode 100644
index 0000000..eac921e
--- /dev/null
+++ b/tests/test_env_isolation.py
@@ -0,0 +1,42 @@
+from unittest.mock import patch, MagicMock
+import os
+import pytest
+from click import edit
+from click.exceptions import ClickException
+
+def test_env_isolation(monkeypatch):
+    monkeypatch.setenv("MY_VAR", "my_value")
+    monkeypatch.setenv("PATH", "/usr/bin")
+    
+    # Mock subprocess.Popen to return a mock object that simulates success
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        edit("test", isolate_env=True, env={"NEW_VAR": "new_value"})
+        
+        # Check the env argument passed to Popen
+        args, kwargs = mock_popen.call_args
+        env = kwargs["env"]
+        
+        assert "MY_VAR" not in env
+        assert env["PATH"] == "/usr/bin"
+        assert env["NEW_VAR"] == "new_value"
+        assert "NEW_VAR" in env
+
+def test_env_no_isolation(monkeypatch):
+    monkeypatch.setenv("MY_VAR", "my_value")
+    
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        edit("test", isolate_env=False)
+        
+        args, kwargs = mock_popen.call_args
+        env = kwargs["env"]
+        
+        # With isolate_env=False, env should be None
+        assert env is None
