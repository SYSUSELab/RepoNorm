diff --git a/dspy/propose/utils.py b/dspy/propose/utils.py
index 8bd720a2..3a13ed24 100644
--- a/dspy/propose/utils.py
+++ b/dspy/propose/utils.py
@@ -187,3 +187,45 @@ def get_dspy_source_code(module):
             completed_set.add(item)
 
     return "\n\n".join(header) + "\n\n" + base_code
+
+def truncate_description(text, cap):
+    if cap is None:
+        return text
+    if not isinstance(cap, int) or cap <= 0:
+        raise ValueError("cap must be a positive integer or None")
+    
+    if len(text) <= cap:
+        return text
+    
+    if cap == 1:
+        return "…"
+    
+    # The requirement: "retain the last complete sentence ending (. ! or ?, followed by whitespace or the end) that fits."
+    # "that fits" means the length of the retained part + 1 (for ellipsis) <= cap.
+    # Actually, the ellipsis is 1 character. So the retained part must be <= cap-1.
+    
+    # Let's find all sentence endings.
+    # A sentence ends with [.!?] followed by whitespace or end of string.
+    # The regex [\.!\?](?:\s+|$) matches . ! or ? followed by whitespace or end.
+    
+    # We want the last match where the end of the match is <= cap-1.
+    
+    # Let's find all matches.
+    matches = list(re.finditer(r'[.!?](?:\s+|$)', text))
+    
+    # We want the last match whose end position is <= cap-1.
+    
+    best_match = None
+    for match in matches:
+        if match.end() <= cap - 1:
+            best_match = match
+        else:
+            break
+            
+    if best_match:
+        # "Remove trailing whitespace from that prefix and append …"
+        return text[:best_match.end()].rstrip() + "…"
+    
+    # If no sentence fits, take a hard prefix of cap-1 characters.
+    # "Remove trailing whitespace from that prefix and append …"
+    return text[:cap-1].rstrip() + "…"
