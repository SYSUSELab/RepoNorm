+def test_grounded_proposer_max_description_chars():
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    
+    # Test valid max_description_chars
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], max_description_chars=100)
+    assert proposer.max_description_chars == 100
+    
+    # Test invalid max_description_chars
+    with pytest.raises(ValueError):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], max_description_chars=-1)
+    
+    with pytest.raises(ValueError):
+        GroundedProposer(prompt_model=prompt_model, program=program, trainset=[], max_description_chars="invalid")
diff --git a/tests/propose/test_propose_utils.py b/tests/propose/test_propose_utils.py
new file mode 100644
index 00000000..0390c99a
--- /dev/null
+++ b/tests/propose/test_propose_utils.py
@@ -0,0 +1,14 @@
+import pytest
+from dspy.propose.utils import truncate_description
+
+def test_truncate_description():
+    assert truncate_description("Hello world. This is a test.", 20) == "Hello world.…"
+    assert truncate_description("Hello world. This is a test.", 10) == "Hello wor…"
+    assert truncate_description("Hello world. This is a test.", 1) == "…"
+    assert truncate_description("A" * 20, 10) == "AAAAAAAAA…"
+    assert truncate_description("Hello world", 10) == "Hello wor…"
+    assert truncate_description("Hello world", None) == "Hello world"
+    with pytest.raises(ValueError):
+        truncate_description("Hello world", -1)
+    with pytest.raises(ValueError):
+        truncate_description("Hello world", "invalid")
