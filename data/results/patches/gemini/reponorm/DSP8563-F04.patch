new file mode 100644
index 00000000..c910476a
--- /dev/null
+++ b/tests/adapters/test_tool_fingerprint.py
@@ -0,0 +1,39 @@
+import pytest
+from dspy.adapters.types.tool import ToolCalls
+
+def test_tool_calls_fingerprint_and_id():
+    """Test that ToolCalls.ToolCall has fingerprint and id."""
+    tool_calls_dicts = [
+        {"name": "search", "args": {"query": "  hello  "}},
+        {"name": "translate", "args": {"text": "world", "lang": "en"}}
+    ]
+    tool_calls = ToolCalls.from_dict_list(tool_calls_dicts)
+    
+    assert len(tool_calls.tool_calls) == 2
+    
+    # Check fingerprint and id
+    tc1 = tool_calls.tool_calls[0]
+    assert tc1.name == "search"
+    assert tc1.args == {"query": "  hello  "} # Original args preserved
+    assert tc1.fingerprint is not None
+    assert len(tc1.fingerprint) == 64
+    assert len(tc1.id) == 8
+    
+    # Check immutability
+    with pytest.raises(AttributeError):
+        tc1.fingerprint = "new"
+    with pytest.raises(AttributeError):
+        tc1.id = "new"
+
+    # Check that fingerprint is consistent
+    tc2 = tool_calls.tool_calls[1]
+    # Expected canonical JSON:
+    # {"args":{"lang":"en","text":"world"},"name":"translate"}
+    import hashlib
+    import json
+    expected_obj = {"args": {"lang": "en", "text": "world"}, "name": "translate"}
+    expected_json = json.dumps(expected_obj, sort_keys=True, separators=(',', ':'), ensure_ascii=True)
+    expected_fingerprint = hashlib.sha256(expected_json.encode('utf-8')).hexdigest()
+    
+    assert tc2.fingerprint == expected_fingerprint
+    assert tc2.id == expected_fingerprint[:8]
