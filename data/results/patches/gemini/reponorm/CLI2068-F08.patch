diff --git a/tests/test_process_group.py b/tests/test_process_group.py
new file mode 100644
index 0000000..aa74e78
--- /dev/null
+++ b/tests/test_process_group.py
@@ -0,0 +1,43 @@
+import click
+import os
+import subprocess
+import sys
+import pytest
+
+def test_process_group_edit():
+    # This test is a bit tricky because we can't easily verify the process group
+    # without actually running an editor.
+    # We can mock the subprocess.Popen to check if the arguments are passed correctly.
+    
+    from unittest.mock import patch, MagicMock
+    
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        click.edit("hello", process_group=True)
+        
+        # Check if Popen was called with the correct arguments
+        args, kwargs = mock_popen.call_args
+        
+        if os.name == "nt":
+            assert kwargs["creationflags"] == 0x00000200
+        else:
+            assert kwargs["start_new_session"] is True
+
+def test_process_group_edit_false():
+    from unittest.mock import patch, MagicMock
+    
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        click.edit("hello", process_group=False)
+        
+        # Check if Popen was called without process group arguments
+        args, kwargs = mock_popen.call_args
+        
+        assert "creationflags" not in kwargs
+        assert "start_new_session" not in kwargs
