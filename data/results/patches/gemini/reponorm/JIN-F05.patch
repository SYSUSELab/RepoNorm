@@ -0,0 +1,67 @@
+import pytest
+from jinja2 import Environment, Undefined
+
+def test_groupby_include_empty_true():
+    env = Environment()
+    # The task says:
+    # For example keys [missing, None, '', 'z', missing, None]
+    # produce groups ['', 'z', None, missing] of sizes [1, 1, 2, 2].
+    
+    # Let's construct a test case that matches this.
+    # We need a way to represent "missing".
+    # If we use a list of dicts, some have the key, some don't.
+    
+    data = [
+        {"val": None},
+        {"val": ""},
+        {"val": "z"},
+        {"val": None},
+        {}, # missing
+        {}  # missing
+    ]
+    
+    # We need to use include_empty=True.
+    # The filter is called as: data|groupby('val', include_empty=True)
+    
+    result = env.from_string("{{ data|groupby('val', include_empty=True) }}").render(data=data)
+    print(f"\nResult: {result}")
+    
+    # Check the result.
+    # It should be a list of tuples.
+    # The grouper should be: '', 'z', None, Undefined
+    
+    # Let's parse the result.
+    # The result is a string representation of the list of tuples.
+    # This is not ideal for testing.
+    # Let's use a python test instead.
+
+def test_groupby_include_empty_true_python():
+    from jinja2.filters import sync_do_groupby
+    from jinja2 import Environment
+    
+    env = Environment()
+    data = [
+        {"val": None},
+        {"val": ""},
+        {"val": "z"},
+        {"val": None},
+        {}, # missing
+        {}  # missing
+    ]
+    
+    result = sync_do_groupby(env, data, 'val', include_empty=True)
+    print(f"\nResult: {result}")
+    
+    assert len(result) == 4
+    assert result[0].grouper == ''
+    assert result[1].grouper == 'z'
+    assert result[2].grouper is None
+    assert isinstance(result[3].grouper, Undefined)
+    
+    assert len(result[0].list) == 1
+    assert len(result[1].list) == 1
+    assert len(result[2].list) == 2
+    assert len(result[3].list) == 2
+
+if __name__ == "__main__":
+    test_groupby_include_empty_true_python()
diff --git a/tests/test_groupby_strict_undefined.py b/tests/test_groupby_strict_undefined.py
new file mode 100644
index 0000000..b1e2a7f
--- /dev/null
+++ b/tests/test_groupby_strict_undefined.py
@@ -0,0 +1,19 @@
+from jinja2.filters import sync_do_groupby
+from jinja2 import Environment, StrictUndefined
+
+def test_groupby_strict_undefined():
+    env = Environment(undefined=StrictUndefined)
+    data = [
+        {"val": "z"},
+        {}, # missing
+    ]
+    
+    # This should raise an error because StrictUndefined is used.
+    try:
+        sync_do_groupby(env, data, 'val', include_empty=True)
+        print("Should have raised an error")
+    except Exception as e:
+        print(f"Caught expected error: {e}")
+
+if __name__ == "__main__":
+    test_groupby_strict_undefined()
