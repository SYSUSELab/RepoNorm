diff --git a/tests/test_groupby_include_empty_false.py b/tests/test_groupby_include_empty_false.py
new file mode 100644
index 0000000..d273517
--- /dev/null
+++ b/tests/test_groupby_include_empty_false.py
@@ -0,0 +1,31 @@
+from jinja2.filters import sync_do_groupby
+from jinja2 import Environment
+
+def test_groupby_include_empty_false_python():
+    env = Environment()
+    data = [
+        {"val": None},
+        {"val": ""},
+        {"val": "z"},
+        {"val": None},
+        {}, # missing
+        {}  # missing
+    ]
+    
+    # include_empty=False (default)
+    result = sync_do_groupby(env, data, 'val', include_empty=False)
+    print(f"\nResult: {result}")
+    
+    # It should only contain 'z'.
+    # Wait, what about ''?
+    # The task says: "False removes items whose resolved grouping key is falsy"
+    # '' is falsy.
+    # None is falsy.
+    # Undefined is falsy.
+    
+    # So it should only contain 'z'.
+    assert len(result) == 1
+    assert result[0].grouper == 'z'
+
+if __name__ == "__main__":
+    test_groupby_include_empty_false_python()
