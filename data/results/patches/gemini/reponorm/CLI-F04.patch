+++ b/tests/test_cleanup_timeout.py
@@ -0,0 +1,116 @@
+import click
+import time
+import threading
+import pytest
+from contextlib import ExitStack
+
+def test_cleanup_timeout_basic():
+    # Test that cleanup_timeout is accepted
+    ctx = click.Context(click.Command("test"), cleanup_timeout=1.0)
+    assert ctx.cleanup_timeout == 1.0
+    
+    # Test that it inherits from parent
+    parent = click.Context(click.Command("parent"), cleanup_timeout=2.0)
+    child = click.Context(click.Command("child"), parent=parent)
+    assert child.cleanup_timeout == 2.0
+    
+    # Test that it overrides parent
+    child2 = click.Context(click.Command("child2"), parent=parent, cleanup_timeout=0.5)
+    assert child2.cleanup_timeout == 0.5
+
+    # Test that it raises ValueError for non-positive timeout
+    with pytest.raises(ValueError):
+        click.Context(click.Command("test"), cleanup_timeout=0)
+    with pytest.raises(ValueError):
+        click.Context(click.Command("test"), cleanup_timeout=-1.0)
+
+def test_cleanup_timeout_execution():
+    # Test that it actually waits
+    ctx = click.Context(click.Command("test"), cleanup_timeout=1.0)
+    
+    def slow_cleanup():
+        time.sleep(0.5)
+        
+    ctx.call_on_close(slow_cleanup)
+    
+    start = time.time()
+    ctx.close()
+    end = time.time()
+    
+    assert end - start >= 0.5
+    
+def test_cleanup_timeout_timeout():
+    # Test that it times out
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    
+    def slow_cleanup():
+        time.sleep(0.5)
+        
+    ctx.call_on_close(slow_cleanup)
+    
+    start = time.time()
+    with pytest.warns(RuntimeWarning, match="Cleanup timed out"):
+        ctx.close()
+    end = time.time()
+    
+    assert end - start < 0.5
+    
+def test_cleanup_timeout_background():
+    # Test that cleanup finishes in the background
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    
+    finished = threading.Event()
+    
+    def slow_cleanup():
+        time.sleep(0.5)
+        finished.set()
+        
+    ctx.call_on_close(slow_cleanup)
+    
+    with pytest.warns(RuntimeWarning, match="Cleanup timed out"):
+        ctx.close()
+        
+    assert not finished.is_set()
+    finished.wait(timeout=1.0)
+    assert finished.is_set()
+
+def test_cleanup_timeout_registrations():
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    
+    def cleanup1():
+        # Register another cleanup
+        ctx.call_on_close(cleanup2)
+        time.sleep(0.5)
+        
+    def cleanup2():
+        pass
+        
+    ctx.call_on_close(cleanup1)
+    
+    with pytest.warns(RuntimeWarning, match="Cleanup timed out"):
+        ctx.close()
+        
+    # cleanup1 should have been called, but cleanup2 should be in the new exit stack
+    assert len(ctx._exit_stack._exit_callbacks) == 1
+    
+def test_cleanup_timeout_repeated_close():
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+    
+    count = 0
+    def cleanup():
+        nonlocal count
+        count += 1
+        time.sleep(0.5)
+        
+    ctx.call_on_close(cleanup)
+    
+    with pytest.warns(RuntimeWarning, match="Cleanup timed out"):
+        ctx.close()
+        
+    # Call close again
+    ctx.close()
+    
+    # Wait for the first cleanup to finish
+    time.sleep(1.0)
+    
+    assert count == 1
