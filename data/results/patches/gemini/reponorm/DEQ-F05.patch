+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+
+__all__ = 'IsPhoneNumber',
+
+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    Validator for international phone numbers.
+    """
+
+    def __init__(self, country: Optional[str] = None):
+        self.country = country.upper() if country else None
+        super().__init__(country=self.country if self.country else '*')
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # 1. Validate characters: only ASCII digits, spaces/tabs, dashes, dots, balanced non-nested parentheses
+        # Newlines and other characters are invalid.
+        # At most one plus is allowed, at the start of the input.
+        
+        # Check for invalid characters
+        if re.search(r'[^\d\s\t\-\.\+\(\)]', other):
+            return False
+        
+        # Check for plus sign
+        if other.count('+') > 1:
+            return False
+        if '+' in other and not other.startswith('+'):
+            return False
+        
+        # Check for balanced non-nested parentheses
+        if not self._check_parentheses(other):
+            return False
+
+        # Extract digits
+        digits = re.sub(r'[^\d]', '', other)
+        
+        if self.country == 'US':
+            # US: 10-digit national (e.g., 555-123-4567) or +1 followed by 10 digits
+            if other.startswith('+'):
+                if not other.startswith('+1'):
+                    return False
+                return len(digits) == 11
+            else:
+                return len(digits) == 10
+        
+        elif self.country == 'GB':
+            # GB: national starting with 0 (e.g., 020 7946 0958) or +44 followed by 10-11 digits
+            if other.startswith('+'):
+                if not other.startswith('+44'):
+                    return False
+                return 12 <= len(digits) <= 13
+            else:
+                if not other.startswith('0'):
+                    return False
+                return 10 <= len(digits) <= 11
+        
+        else:
+            # Generic: + followed by 8–19 digits
+            if other.startswith('+'):
+                return 8 <= len(digits) <= 19
+            else:
+                # National 7–15 digit strings
+                return 7 <= len(digits) <= 15
+
+    def _check_parentheses(self, s: str) -> bool:
+        # Check for balanced non-nested parentheses
+        # Also check that parentheses only contain digits
+        
+        # Check for nested parentheses
+        if re.search(r'\(.*\)', s):
+            # This is a simple check for nested, but let's be more robust
+            # Actually, the requirement says "balanced, non-nested parentheses containing digits"
+            # Let's use a stack-based approach or a regex that ensures no nested
+            pass
+            
+        # Let's use a simple stack-based approach
+        depth = 0
+        for i, char in enumerate(s):
+            if char == '(':
+                depth += 1
+                if depth > 1: return False # Nested
+            elif char == ')':
+                depth -= 1
+                if depth < 0: return False # Unbalanced
+            
+        if depth != 0:
+            return False
+            
+        # Find all content inside parentheses
+        matches = re.findall(r'\((.*?)\)', s)
+        for match in matches:
+            if not match.isdigit():
+                return False
+            
+        # Check if parentheses are properly placed
+        # The requirement says "balanced, non-nested parentheses containing digits"
+        # It doesn't explicitly say they must be at the start, but usually they are.
+        # Let's check if there's any character other than digits, spaces, dashes, dots, +, (, )
+        # Wait, the regex already checks for invalid characters.
+        
+        # Let's check if the parentheses are "balanced, non-nested parentheses containing digits"
+        # The current implementation seems to allow '555(123)4567'.
+        # Is that allowed? The requirement says "balanced, non-nested parentheses containing digits".
+        # It doesn't say they must be at the start.
+        # Wait, the test says:
+        # assert '555(123)4567' != IsPhoneNumber('US') # Nested/invalid position
+        # So it must be invalid.
+        
+        # Let's check if the parentheses are at the start.
+        # Actually, for US numbers, (555) is at the start.
+        # Let's check if the parentheses are only allowed at the start.
+        
+        # Let's re-read: "balanced, non-nested parentheses containing digits"
+        # Maybe the issue is that '555(123)4567' is not a valid format.
+        # Let's check if the parentheses are only allowed at the start.
+        
+        # Let's try to enforce that if there are parentheses, they must be at the start.
+        if '(' in s:
+            if not s.startswith('('):
+                return False
+            # Also check if the closing parenthesis is at the correct position
+            # For (555) 123-4567, the closing parenthesis is at index 4.
+            # Let's check if the closing parenthesis is followed by a space or a digit.
+            # Actually, let's just check if the parentheses are at the start.
+            
+        return True
+
+    def _repr_ne(self) -> str:
+        if self.country:
+            return f"IsPhoneNumber('{self.country}')"
+        else:
+            return "IsPhoneNumber('*')"
diff --git a/tests/test_phone.py b/tests/test_phone.py
new file mode 100644
index 0000000..e4be5e2
--- /dev/null
