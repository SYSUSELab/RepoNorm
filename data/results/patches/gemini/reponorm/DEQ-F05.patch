@@ -0,0 +1,53 @@
+import pytest
+from dirty_equals import IsPhoneNumber
+
+def test_generic_phone():
+    assert '+123456789' == IsPhoneNumber()
+    assert '+1234567890123456789' == IsPhoneNumber()
+    assert '1234567' == IsPhoneNumber()
+    assert '123456789012345' == IsPhoneNumber()
+    assert '+1234567' != IsPhoneNumber() # Too short for international
+    assert '123456' != IsPhoneNumber() # Too short for national
+    assert '1234567890123456' != IsPhoneNumber() # Too long for national
+    assert '+12345678901234567890' != IsPhoneNumber() # Too long for international
+
+def test_us_phone():
+    assert '555-123-4567' == IsPhoneNumber('US')
+    assert '+1-555-123-4567' == IsPhoneNumber('US')
+    assert '5551234567' == IsPhoneNumber('US')
+    assert '+15551234567' == IsPhoneNumber('US')
+    assert '020 7946 0958' != IsPhoneNumber('US')
+    assert '+44 20 7946 0958' != IsPhoneNumber('US')
+    assert '123456789' != IsPhoneNumber('US') # Too short
+
+def test_gb_phone():
+    assert '020 7946 0958' == IsPhoneNumber('GB')
+    assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+    assert '02079460958' == IsPhoneNumber('GB')
+    assert '+442079460958' == IsPhoneNumber('GB')
+    assert '555-123-4567' != IsPhoneNumber('GB')
+    assert '+1-555-123-4567' != IsPhoneNumber('GB')
+
+def test_invalid_chars():
+    assert '123-456-789a' != IsPhoneNumber()
+    assert '123-456-789!' != IsPhoneNumber()
+    assert '123\n456' != IsPhoneNumber()
+
+def test_plus_sign():
+    assert '+123456789' == IsPhoneNumber()
+    assert '123+456789' != IsPhoneNumber()
+    assert '++123456789' != IsPhoneNumber()
+
+def test_parentheses():
+    assert '(555) 123-4567' == IsPhoneNumber('US')
+    assert '555(123)4567' != IsPhoneNumber('US') # Nested/invalid position
+    assert '(555)123-4567' == IsPhoneNumber('US')
+    assert '((555))' != IsPhoneNumber()
+
+def test_non_string():
+    assert 123 != IsPhoneNumber()
+    assert None != IsPhoneNumber()
+
+def test_repr():
+    assert repr(IsPhoneNumber()) == "IsPhoneNumber('*')"
+    assert repr(IsPhoneNumber('US')) == "IsPhoneNumber('US')"
