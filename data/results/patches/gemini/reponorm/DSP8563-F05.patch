+            if tool_call.comment is not None: metadata["comment"] = tool_call.comment
+            if tool_call.annotation is not None: metadata["annotation"] = tool_call.annotation
+            if tool_call.tags is not None: metadata["tags"] = tool_call.tags
+            if tool_call.priority is not None: metadata["priority"] = tool_call.priority
+            if tool_call.meta is not None: metadata["meta"] = tool_call.meta
+            
+            if metadata:
+                call_dict.update(metadata)
+                
+            result.append(call_dict)
+            
+        return [
+            {
+                "type": "tool_calls",
