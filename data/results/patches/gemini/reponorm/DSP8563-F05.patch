index 18571453..f0c7df43 100644
--- a/tests/adapters/test_tool.py
+++ b/tests/adapters/test_tool.py
@@ -457,3 +457,55 @@ def test_tool_calls_format_from_dict_list():
     assert len(result[0]["tool_calls"]) == 2
     assert result[0]["tool_calls"][0]["function"]["name"] == "search"
     assert result[0]["tool_calls"][1]["function"]["name"] == "translate"
+
+def test_tool_calls_metadata_and_comments():
+    # Test metadata
+    tool_calls_dicts = [
+        {"name": "search", "args": {"query": "hello"}, "note": "my note", "tags": ["a", "b"]}
+    ]
+    tool_calls = ToolCalls.from_dict_list(tool_calls_dicts)
+    formatted = tool_calls.format_with_metadata()
+    
+    assert formatted[0]["tool_calls"][0]["note"] == "my note"
+    assert formatted[0]["tool_calls"][0]["tags"] == ["a", "b"]
+    
+    # Test comments
+    json_str = '{"tool_calls": [{"name": "search", "args": {"query": "hello"}}]} # my comment'
+    tool_calls = ToolCalls.from_string(json_str)
+    assert tool_calls.tool_calls[0].comment == "my comment"
+    
+    # Test comments override
+    json_str = '{"tool_calls": [{"name": "search", "args": {"query": "hello"}, "comment": "explicit"}]} # document comment'
+    tool_calls = ToolCalls.from_string(json_str)
+    assert tool_calls.tool_calls[0].comment == "document comment"
+
+def test_tool_calls_metadata_and_comments():
+    # Test metadata
+    tool_calls_dicts = [
+        {"name": "search", "args": {"query": "hello"}, "note": "my note", "tags": ["a", "b"]}
+    ]
+    tool_calls = ToolCalls.from_dict_list(tool_calls_dicts)
+    formatted = tool_calls.format_with_metadata()
+    assert formatted[0]["tool_calls"][0]["note"] == "my note"
+    assert formatted[0]["tool_calls"][0]["tags"] == ["a", "b"]
+    assert "comment" not in formatted[0]["tool_calls"][0]
+
+    # Test comments
+    json_str = '{"name": "search", "args": {"query": "hello"}} # my comment'
+    tool_calls = ToolCalls.from_string(json_str)
+    formatted = tool_calls.format_with_metadata()
+    assert formatted[0]["tool_calls"][0]["comment"] == "my comment"
+
+    # Test combined comments
+    json_str = """
+    [
+        {"name": "search", "args": {"query": "hello"}},
+        {"name": "translate", "args": {"text": "world"}}
+    ]
+    # comment 1
+    # comment 2
+    """
+    tool_calls = ToolCalls.from_string(json_str)
+    formatted = tool_calls.format_with_metadata()
+    assert formatted[0]["tool_calls"][0]["comment"] == "comment 1\ncomment 2"
+    assert formatted[0]["tool_calls"][1]["comment"] == "comment 1\ncomment 2"
