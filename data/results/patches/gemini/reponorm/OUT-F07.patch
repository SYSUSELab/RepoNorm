@@ -0,0 +1,102 @@
+import pytest
+import torch
+import warnings
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+from unittest.mock import MagicMock, patch
+import sys
+
+def test_xgrammar_logits_processor_fallback():
+    # Mock the primary processor to raise an exception
+    class FailingProcessor:
+        def __init__(self, *args, **kwargs):
+            pass
+        def __call__(self, input_ids, logits):
+            raise RuntimeError("Primary failed")
+
+    # Mock the fallback processor
+    class FallbackProcessor:
+        def __init__(self, *args, **kwargs):
+            pass
+        def __call__(self, input_ids, logits):
+            return logits + 1.0
+
+    # Mock xgrammar
+    mock_xgr = MagicMock()
+    mock_logits_processor_class = MagicMock(side_effect=[FailingProcessor(), FallbackProcessor()])
+    mock_xgr.contrib.hf.LogitsProcessor = mock_logits_processor_class
+    
+    # Patch sys.modules to return our mock when 'xgrammar' is imported
+    with patch.dict(sys.modules, {"xgrammar": mock_xgr}):
+        processor = XGrammarLogitsProcessor("compiled_grammar")
+        
+        # Set the fallback
+        fallback = XGrammarLogitsProcessor("fallback_grammar")
+        processor.fallback_processor = fallback
+        
+        input_ids = torch.tensor([[1, 2]])
+        logits = torch.tensor([[0.0, 0.0]])
+        
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            result = processor.process_logits(input_ids, logits)
+            
+            assert len(w) == 1
+            assert issubclass(w[-1].category, UserWarning)
+            assert "Primary XGrammar processor failed" in str(w[-1].message)
+            
+        assert torch.equal(result, logits + 1.0)
+        
+        # Second call should use fallback directly
+        result2 = processor.process_logits(input_ids, logits)
+        assert torch.equal(result2, logits + 1.0)
+        
+        # Reset should reset both
+        processor.reset()
+        assert processor.xgrammar_logits_processor is None
+        assert processor.use_fallback is False
+        # The fallback processor's xgrammar_logits_processor should be reset too
+        assert processor.fallback_processor.xgrammar_logits_processor is None
+
+def test_xgrammar_backend_fallback():
+    from outlines.backends.xgrammar import XGrammarBackend
+    from outlines.models.transformers import Transformers
+    from unittest.mock import MagicMock, patch
+    import sys
+    
+    mock_xgr = MagicMock()
+    mock_grammar_compiler = MagicMock()
+    mock_xgr.GrammarCompiler.return_value = mock_grammar_compiler
+    
+    with patch.dict(sys.modules, {"xgrammar": mock_xgr}):
+        # Create a mock that inherits from Transformers
+        class MockTransformers(Transformers):
+            def __init__(self):
+                pass
+        
+        mock_model = MockTransformers()
+        mock_model.model = MagicMock()
+        mock_model.model.config = MagicMock()
+        mock_model.model.config._name_or_path = "test"
+        mock_model.hf_tokenizer = MagicMock()
+        
+        # We also need to mock AutoConfig.from_pretrained
+        with patch("transformers.AutoConfig.from_pretrained") as mock_config:
+            mock_config.return_value.vocab_size = 100
+            backend = XGrammarBackend(mock_model)
+            
+            # Mock XGrammarLogitsProcessor to avoid torch import issues
+            with patch("outlines.backends.xgrammar.XGrammarLogitsProcessor") as MockProcessor:
+                fallback = MagicMock()
+                
+                # Test get_json_schema_logits_processor
+                backend.get_json_schema_logits_processor("{}", fallback_processor=fallback)
+                # Check if MockProcessor was called with the correct fallback_processor
+                assert MockProcessor.call_args[1]['fallback_processor'] == fallback
+                
+                # Test get_regex_logits_processor
+                backend.get_regex_logits_processor(".*", fallback_processor=fallback)
+                assert MockProcessor.call_args[1]['fallback_processor'] == fallback
+                
+                # Test get_cfg_logits_processor
+                backend.get_cfg_logits_processor("grammar", fallback_processor=fallback)
+                assert MockProcessor.call_args[1]['fallback_processor'] == fallback
