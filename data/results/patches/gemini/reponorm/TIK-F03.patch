diff --git a/tests/test_token_frequency.py b/tests/test_token_frequency.py
new file mode 100644
index 0000000..5fb3c1f
--- /dev/null
+++ b/tests/test_token_frequency.py
@@ -0,0 +1,40 @@
+import tiktoken
+import pytest
+from collections import Counter
+
+def test_encode_frequency():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello world"
+    tokens, freq = enc.encode(text, analyze_frequency=True)
+    assert tokens == enc.encode(text)
+    assert freq == dict(Counter(tokens))
+
+def test_encode_batch_frequency():
+    enc = tiktoken.get_encoding("cl100k_base")
+    batch = ["hello world", "hello"]
+    tokens_list, corpus_freq = enc.encode_batch(batch, analyze_frequency=True)
+    assert tokens_list == enc.encode_batch(batch)
+    expected_freq = Counter()
+    for tokens in tokens_list:
+        expected_freq.update(tokens)
+    assert corpus_freq == dict(expected_freq)
+
+def test_empty_batch_frequency():
+    enc = tiktoken.get_encoding("cl100k_base")
+    tokens_list, corpus_freq = enc.encode_batch([], analyze_frequency=True)
+    assert tokens_list == []
+    assert corpus_freq == {}
+
+def test_encode_no_frequency():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello world"
+    tokens = enc.encode(text, analyze_frequency=False)
+    assert tokens == enc.encode(text)
+    assert isinstance(tokens, list)
+
+def test_encode_batch_no_frequency():
+    enc = tiktoken.get_encoding("cl100k_base")
+    batch = ["hello world", "hello"]
+    tokens_list = enc.encode_batch(batch, analyze_frequency=False)
+    assert tokens_list == enc.encode_batch(batch)
+    assert isinstance(tokens_list, list)
