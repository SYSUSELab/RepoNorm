diff --git a/dspy/propose/instruction_utils.py b/dspy/propose/instruction_utils.py
new file mode 100644
index 00000000..468f5e80
--- /dev/null
+++ b/dspy/propose/instruction_utils.py
@@ -0,0 +1,80 @@
+import re
+import dspy
+from dspy.propose.shorten_instruction import ShortenInstruction
+
+def process_instruction(
+    instruction,
+    min_instr_chars,
+    max_instr_chars,
+    rephrase_when_too_long,
+    basic_instruction,
+    verbose=False,
+    prompt_model=None
+):
+    # Measure length
+    length = len(instruction)
+    
+    # If shorter than min, use canonical signature instructions
+    if length < min_instr_chars:
+        if verbose:
+            print(f"Instruction too short ({length} < {min_instr_chars}). Using basic instruction.")
+        return basic_instruction
+    
+    # If longer than max
+    if length > max_instr_chars:
+        if not rephrase_when_too_long:
+            # Retain last sentence boundary
+            # Look for . ! or ? followed by whitespace or end
+            matches = list(re.finditer(r'[.!?](\s+|$)', instruction))
+            
+            # We need to fit in max_instr_chars - 1 (for ...)
+            limit = max_instr_chars - 1
+            
+            # Find the last match that fits
+            best_match = None
+            for match in reversed(matches):
+                if match.end() <= limit:
+                    best_match = match
+                    break
+            
+            if best_match:
+                trimmed = instruction[:best_match.end()] + "…"
+                if verbose:
+                    print(f"Instruction too long ({length} > {max_instr_chars}). Trimmed at sentence boundary to {len(trimmed)}.")
+                return trimmed
+            else:
+                # Hard truncate
+                trimmed = instruction[:max_instr_chars - 1] + "…"
+                if verbose:
+                    print(f"Instruction too long ({length} > {max_instr_chars}). Hard truncated to {len(trimmed)}.")
+                return trimmed
+        else:
+            # Rephrase
+            if verbose:
+                print(f"Instruction too long ({length} > {max_instr_chars}). Rephrasing.")
+            
+            shortener = dspy.Predict(ShortenInstruction)
+            try:
+                with dspy.settings.context(lm=prompt_model):
+                    result = shortener(long_instruction=instruction, max_chars=max_instr_chars)
+                    proposed = result.proposed_instruction
+                    # Strip prefix "PROPOSED INSTRUCTION:"
+                    if proposed.startswith("PROPOSED INSTRUCTION:"):
+                        proposed = proposed[len("PROPOSED INSTRUCTION:"):].strip()
+                    
+                    if not proposed or len(proposed) < min_instr_chars:
+                        if verbose:
+                            print("Rephrasing failed or too short. Falling back to basic instruction.")
+                        return basic_instruction
+                    
+                    # Hard truncate if still too long
+                    if len(proposed) > max_instr_chars:
+                        proposed = proposed[:max_instr_chars]
+                    
+                    return proposed
+            except Exception as e:
+                if verbose:
+                    print(f"Rephrasing error: {e}. Falling back to basic instruction.")
+                return basic_instruction
+                
+    return instruction
diff --git a/dspy/propose/shorten_instruction.py b/dspy/propose/shorten_instruction.py
new file mode 100644
index 00000000..01eeba16
--- /dev/null
+++ b/dspy/propose/shorten_instruction.py
@@ -0,0 +1,18 @@
+import dspy
+
+class ShortenInstruction(dspy.Signature):
+    """Shorten the given instruction to be within the specified character limit."""
+    long_instruction = dspy.InputField(
+        format=str,
+        desc="The instruction to be shortened.",
+        prefix="LONG INSTRUCTION:",
+    )
+    max_chars = dspy.InputField(
+        format=int,
+        desc="The maximum number of characters allowed.",
+        prefix="MAX CHARS:",
+    )
+    proposed_instruction = dspy.OutputField(
+        desc="The shortened instruction.",
+        prefix="PROPOSED INSTRUCTION:",
+    )
