@@ -0,0 +1,71 @@
+import click
+from click.testing import CliRunner
+import pytest
+
+def test_required_if_mapping():
+    @click.command()
+    @click.option("--auth-mode")
+    @click.option("--password", required_if={"auth_mode": "password"})
+    def cli(auth_mode, password):
+        click.echo(f"auth_mode={auth_mode}, password={password}")
+
+    runner = CliRunner()
+    
+    # Should fail if auth_mode is password but password is missing
+    result = runner.invoke(cli, ["--auth-mode", "password"])
+    assert result.exit_code != 0
+    assert "Missing option" in result.output
+
+    # Should succeed if auth_mode is not password and password is missing
+    result = runner.invoke(cli, ["--auth-mode", "token"])
+    assert result.exit_code == 0
+    assert "auth_mode=token, password=None" in result.output
+
+    # Should succeed if auth_mode is password and password is provided
+    result = runner.invoke(cli, ["--auth-mode", "password", "--password", "secret"])
+    assert result.exit_code == 0
+    assert "auth_mode=password, password=secret" in result.output
+
+def test_required_if_callable():
+    @click.command()
+    @click.option("--count", type=int)
+    @click.option("--value", required_if=lambda ctx, param: ctx.params.get("count", 0) > 5)
+    def cli(count, value):
+        click.echo(f"count={count}, value={value}")
+
+    runner = CliRunner()
+    
+    # Should fail if count > 5 and value is missing
+    result = runner.invoke(cli, ["--count", "6"])
+    assert result.exit_code != 0
+    assert "Missing option" in result.output
+
+    # Should succeed if count <= 5 and value is missing
+    result = runner.invoke(cli, ["--count", "5"])
+    assert result.exit_code == 0
+    assert "count=5, value=None" in result.output
+
+    # Should succeed if count > 5 and value is provided
+    result = runner.invoke(cli, ["--count", "6", "--value", "foo"])
+    assert result.exit_code == 0
+    assert "count=6, value=foo" in result.output
+
+def test_required_if_invalid_type():
+    with pytest.raises(TypeError, match="required_if must be a dict or callable."):
+        @click.command()
+        @click.option("--foo", required_if="invalid")
+        def cli(foo):
+            pass
+
+def test_required_if_invalid_param_name():
+    @click.command()
+    @click.option("--password", required_if={"invalid_param": "value"})
+    def cli(password):
+        pass
+
+    runner = CliRunner()
+    result = runner.invoke(cli, [])
+    # This should probably raise a UsageError or something similar.
+    assert result.exit_code != 0
+    assert "Parameter" in result.output and "not found in context" in result.output
+    # Let's see what happens.
