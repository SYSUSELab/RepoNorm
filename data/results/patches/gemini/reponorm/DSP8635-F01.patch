diff --git a/tests/propose/test_grounded_proposer_salt.py b/tests/propose/test_grounded_proposer_salt.py
new file mode 100644
index 00000000..7622442b
--- /dev/null
+++ b/tests/propose/test_grounded_proposer_salt.py
@@ -0,0 +1,70 @@
+import pytest
+import dspy
+from dspy.predict import Predict
+from dspy.propose.grounded_proposer import GroundedProposer
+import json
+import re
+
+def test_propose_instruction_salt_generation():
+    class SaltCheckingLM(dspy.LM):
+        def __init__(self):
+            super().__init__(model="dummy")
+            self.history = []
+
+        def __call__(self, prompt=None, messages=None, **kwargs):
+            content = prompt if prompt is not None else messages
+            
+            if "DescribeProgram" in str(content):
+                response = {"program_description": "desc"}
+            elif "DescribeModule" in str(content):
+                response = {"module_description": "desc"}
+            elif "GenerateSingleModuleInstruction" in str(content):
+                response = {"proposed_instruction": "instruction"}
+            else:
+                response = {"program_description": "desc", "module_description": "desc", "proposed_instruction": "instruction"}
+                
+            self.history.append((content, response))
+            return [json.dumps(response)]
+
+    prompt_model = SaltCheckingLM()
+    program = Predict("question -> answer")
+    
+    proposer = GroundedProposer(
+        prompt_model=prompt_model, 
+        program=program, 
+        trainset=[], 
+        verbose=False,
+        program_aware=True,
+        use_dataset_summary=False
+    )
+    
+    result = proposer.propose_instruction_for_predictor(
+        program=program,
+        predictor=program,
+        pred_i=0,
+        T=0.5,
+        demo_candidates=None,
+        demo_set_i=0,
+        trial_logs={},
+        tip=None,
+    )
+    
+    assert result == "instruction"
+    
+    assert len(prompt_model.history) > 0
+    
+    salts = []
+    for prompt, _ in prompt_model.history:
+        prompt_str = str(prompt)
+        # Use a more flexible regex
+        match = re.search(r"cache_salt\s*##\s*\]\]\s*\\n\s*(\w+)", prompt_str)
+        if match is None:
+            # Try without the backslash for newline
+            match = re.search(r"cache_salt\s*##\s*\]\]\s*\n\s*(\w+)", prompt_str)
+        
+        assert match is not None, f"Salt not found in prompt: {prompt_str}"
+        salts.append(match.group(1))
+        
+    assert len(set(salts)) == 1, f"Multiple different salts found: {set(salts)}"
+    assert len(salts[0]) == 16
+
