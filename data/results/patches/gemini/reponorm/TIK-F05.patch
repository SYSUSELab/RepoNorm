+import tiktoken
+import numpy as np
+
+enc = tiktoken.get_encoding("gpt2")
+text = "hello world"
+tokens = enc.encode(text)
+filter_tokens = {tokens[0]}
+
+# The requirement says:
+# "A list, tuple or set of token IDs removes all occurrences of those IDs after encoding; duplicates have no extra effect. Preserve remaining token order."
+
+# My manual implementation:
+filtered = [t for t in tokens if t not in filter_tokens]
+print(f"Filtered: {filtered}")
+
+# The requirement says:
+# "NumPy results remain one-dimensional uint32 arrays, including when all tokens are removed."
+
+# My manual implementation:
+arr = enc.encode_to_numpy(text)
+filtered_arr = arr[~np.isin(arr, list(filter_tokens))]
+print(f"Filtered Numpy: {filtered_arr}")
+
+# What if all tokens are removed?
+filter_tokens_all = set(tokens)
+filtered_all = [t for t in tokens if t not in filter_tokens_all]
+print(f"Filtered All: {filtered_all}")
+
+filtered_arr_all = arr[~np.isin(arr, list(filter_tokens_all))]
+print(f"Filtered Numpy All: {filtered_arr_all}")
+print(f"Filtered Numpy All shape: {filtered_arr_all.shape}")
+print(f"Filtered Numpy All dtype: {filtered_arr_all.dtype}")
