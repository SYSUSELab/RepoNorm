+++ b/test_edge_cases.py
@@ -0,0 +1,60 @@
+import tiktoken
+import numpy as np
+import pytest
+
+def test_filter_tokens_types():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello world"
+    tokens = enc.encode(text)
+    
+    # Test list
+    assert enc.encode(text, filter_tokens=[tokens[0]]) == [tokens[1]]
+    # Test tuple
+    assert enc.encode(text, filter_tokens=(tokens[0],)) == [tokens[1]]
+    # Test set
+    assert enc.encode(text, filter_tokens={tokens[0]}) == [tokens[1]]
+    
+    # Test numpy with list
+    arr = enc.encode_to_numpy(text, filter_tokens=[tokens[0]])
+    assert np.array_equal(arr, np.array([tokens[1]], dtype=np.uint32))
+    
+    # Test numpy with tuple
+    arr = enc.encode_to_numpy(text, filter_tokens=(tokens[0],))
+    assert np.array_equal(arr, np.array([tokens[1]], dtype=np.uint32))
+
+def test_disallowed_special_behavior():
+    enc = tiktoken.get_encoding("gpt2")
+    # Prohibited special literal still raises before filtering
+    with pytest.raises(ValueError):
+        enc.encode("<|endoftext|>", filter_tokens={50256})
+    
+    # Even if its token ID would be removed.
+    # Wait, the requirement says:
+    # "A prohibited special literal still raises before filtering, even if its token ID would be removed."
+    # Let's verify this.
+    
+    # The current implementation:
+    # if disallowed_special:
+    #     ...
+    #     if match := _special_token_regex(disallowed_special).search(text):
+    #         raise_disallowed_special_token(match.group())
+    #
+    # try:
+    #     tokens = self._core_bpe.encode(text, allowed_special)
+    #     ...
+    
+    # Yes, it raises before calling _core_bpe.encode, so it raises before filtering.
+    
+    # What if disallowed_special=()?
+    # Then it should not raise.
+    tokens = enc.encode("<|endoftext|>", disallowed_special=(), filter_tokens={50256})
+    # The token ID for <|endoftext|> is 50256.
+    # If we filter it, it should be removed.
+    # Let's check what tokens it encodes to without filtering.
+    tokens_no_filter = enc.encode("<|endoftext|>", disallowed_special=())
+    assert 50256 in tokens_no_filter
+    
+    # With filtering:
+    assert 50256 not in tokens
+
+print("Edge cases tests passed!")
