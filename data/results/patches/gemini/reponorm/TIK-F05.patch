+import tiktoken
+import numpy as np
+
+def test_filter_tokens_types():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello world"
+    tokens = enc.encode(text)
+    
+    # Test list
+    assert enc.encode(text, filter_tokens=[tokens[0]]) == [tokens[1]]
+    # Test tuple
+    assert enc.encode(text, filter_tokens=(tokens[0],)) == [tokens[1]]
+    # Test set
+    assert enc.encode(text, filter_tokens={tokens[0]}) == [tokens[1]]
+    
+    # Test numpy with list
+    arr = enc.encode_to_numpy(text, filter_tokens=[tokens[0]])
+    assert np.array_equal(arr, np.array([tokens[1]], dtype=np.uint32))
+    
+    # Test numpy with tuple
+    arr = enc.encode_to_numpy(text, filter_tokens=(tokens[0],))
+    assert np.array_equal(arr, np.array([tokens[1]], dtype=np.uint32))
+
+def test_disallowed_special_behavior():
+    enc = tiktoken.get_encoding("gpt2")
+    # Prohibited special literal still raises before filtering
+    try:
+        enc.encode("<|endoftext|>", filter_tokens={50256})
+    except ValueError:
+        print("Caught expected ValueError")
+    else:
+        assert False, "Should have raised ValueError"
+    
+    # With disallowed_special=()
+    # The token ID for <|endoftext|> is 50256.
+    # If we allow it, it should be 50256.
+    tokens = enc.encode("<|endoftext|>", allowed_special={"<|endoftext|>"}, filter_tokens={50256})
+    assert tokens == []
+    print("Disallowed special behavior test passed")
+
+test_filter_tokens_types()
+test_disallowed_special_behavior()
