+import tiktoken
+import numpy as np
+
+enc = tiktoken.get_encoding("gpt2")
+text = "hello world"
+tokens = enc.encode(text)
+filter_tokens = {tokens[0]}
+
+# Test encode with filter_tokens
+filtered = enc.encode(text, filter_tokens=filter_tokens)
+print(f"Filtered: {filtered}")
+assert filtered == [tokens[1]]
+
+# Test encode_to_numpy with filter_tokens
+filtered_arr = enc.encode_to_numpy(text, filter_tokens=filter_tokens)
+print(f"Filtered Numpy: {filtered_arr}")
+assert np.array_equal(filtered_arr, np.array([tokens[1]], dtype=np.uint32))
+
+# Test with empty filter_tokens
+filtered_empty = enc.encode(text, filter_tokens=[])
+print(f"Filtered Empty: {filtered_empty}")
+assert filtered_empty == tokens
+
+# Test with None filter_tokens
+filtered_none = enc.encode(text, filter_tokens=None)
+print(f"Filtered None: {filtered_none}")
+assert filtered_none == tokens
+
+# Test with all tokens removed
+filtered_all = enc.encode(text, filter_tokens=set(tokens))
+print(f"Filtered All: {filtered_all}")
+assert filtered_all == []
+
+filtered_arr_all = enc.encode_to_numpy(text, filter_tokens=set(tokens))
+print(f"Filtered Numpy All: {filtered_arr_all}")
+assert filtered_arr_all.size == 0
+assert filtered_arr_all.dtype == np.uint32
+
+print("All tests passed!")
