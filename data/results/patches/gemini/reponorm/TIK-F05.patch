+import re
+
+with open('tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# Update encode signature
+content = re.sub(
+    r'def encode\(\n\s+self,\n\s+text: str,\n\s+\*,\n\s+allowed_special: Literal\["all"\] \| AbstractSet\[str\] = set\(\),  # noqa: B006\n\s+disallowed_special: Literal\["all"\] \| Collection\[str\] = "all",\n\s+\) -> list\[int\]:',
+    r'def encode(\n        self,\n        text: str,\n        *,\n        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006\n        disallowed_special: Literal["all"] | Collection[str] = "all",\n        filter_tokens: Collection[int] | None = None,\n    ) -> list[int]:',
+    content
+)
+
+# Update encode implementation
+# We need to insert the filtering logic after the call to self._core_bpe.encode
+# The current implementation has a try-except block.
+# Let's find the return statement and modify it.
+
+# Actually, it's easier to just replace the whole encode method or parts of it.
+# Let's look at the structure again.
+
+# The current encode method:
+# ...
+#         try:
+#             return self._core_bpe.encode(text, allowed_special)
+#         except UnicodeEncodeError:
+# ...
+#             return self._core_bpe.encode(text, allowed_special)
+
+# This is tricky because it returns in two places.
+
+# Let's rewrite the encode method.
