@@ -0,0 +1,46 @@
+import re
+
+with open('tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# Update encode signature
+# Find the signature
+pattern = r'(def encode\(\n\s+self,\n\s+text: str,\n\s+\*,\n\s+allowed_special: Literal\["all"\] \| AbstractSet\[str\] = set\(\),  # noqa: B006\n\s+disallowed_special: Literal\["all"\] \| Collection\[str\] = "all",\n\s+\) -> list\[int\]:)'
+replacement = r'def encode(\n        self,\n        text: str,\n        *,\n        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006\n        disallowed_special: Literal["all"] | Collection[str] = "all",\n        filter_tokens: Collection[int] | None = None,\n    ) -> list[int]:'
+content = re.sub(pattern, replacement, content)
+
+# Update encode implementation
+# Find the return statement in encode
+# The return statement is:
+#             return self._core_bpe.encode(text, allowed_special)
+# We need to replace it with:
+#             tokens = self._core_bpe.encode(text, allowed_special)
+#             if filter_tokens:
+#                 tokens = [t for t in tokens if t not in filter_tokens]
+#             return tokens
+
+# There are two such return statements.
+content = content.replace(
+    '            return self._core_bpe.encode(text, allowed_special)',
+    '            tokens = self._core_bpe.encode(text, allowed_special)\n            if filter_tokens:\n                tokens = [t for t in tokens if t not in filter_tokens]\n            return tokens'
+)
+
+# Update encode_to_numpy signature
+pattern = r'(def encode_to_numpy\(\n\s+self,\n\s+text: str,\n\s+\*,\n\s+allowed_special: Literal\["all"\] \| AbstractSet\[str\] = set\(\),  # noqa: B006\n\s+disallowed_special: Literal\["all"\] \| Collection\[str\] = "all",\n\s+\) -> npt.NDArray\[np.uint32\]:)'
+replacement = r'def encode_to_numpy(\n        self,\n        text: str,\n        *,\n        allowed_special: Literal["all"] | AbstractSet[str] = set(),  # noqa: B006\n        disallowed_special: Literal["all"] | Collection[str] = "all",\n        filter_tokens: Collection[int] | None = None,\n    ) -> npt.NDArray[np.uint32]:'
+content = re.sub(pattern, replacement, content)
+
+# Update encode_to_numpy implementation
+# Find the return statement:
+#         return np.frombuffer(buffer, dtype=np.uint32)
+# Replace with:
+#         tokens = np.frombuffer(buffer, dtype=np.uint32)
+#         if filter_tokens:\n            if not isinstance(filter_tokens, (set, frozenset)):\n                filter_tokens = set(filter_tokens)\n            tokens = tokens[~np.isin(tokens, list(filter_tokens))]\n        return tokens
+
+content = content.replace(
+    '        return np.frombuffer(buffer, dtype=np.uint32)',
+    '        tokens = np.frombuffer(buffer, dtype=np.uint32)\n        if filter_tokens:\n            if not isinstance(filter_tokens, (set, frozenset)):\n                filter_tokens = set(filter_tokens)\n            tokens = tokens[~np.isin(tokens, list(filter_tokens))]\n        return tokens'
+)
+
+with open('tiktoken/core.py', 'w') as f:
+    f.write(content)
