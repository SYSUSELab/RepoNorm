+import sys
+
+with open('tiktoken/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find encode method
+start_encode = 0
+for i, line in enumerate(lines):
+    if 'def encode(' in line:
+        start_encode = i
+        break
+
+# Update signature
+lines[start_encode+4] = '        disallowed_special: Literal["all"] | Collection[str] = "all",\n'
+lines.insert(start_encode+5, '        filter_tokens: Collection[int] | None = None,\n')
+
+# Update encode implementation
+# Find the return statements
+for i in range(start_encode, len(lines)):
+    if 'return self._core_bpe.encode(text, allowed_special)' in lines[i]:
+        lines[i] = '            tokens = self._core_bpe.encode(text, allowed_special)\n'
+        lines.insert(i+1, '            if filter_tokens:\n')
+        lines.insert(i+2, '                tokens = [t for t in tokens if t not in filter_tokens]\n')
+        lines.insert(i+3, '            return tokens\n')
+
+# Find encode_to_numpy method
+start_numpy = 0
+for i, line in enumerate(lines):
+    if 'def encode_to_numpy(' in line:
+        start_numpy = i
+        break
+
+# Update signature
+lines[start_numpy+4] = '        disallowed_special: Literal["all"] | Collection[str] = "all",\n'
+lines.insert(start_numpy+5, '        filter_tokens: Collection[int] | None = None,\n')
+
+# Update encode_to_numpy implementation
+# Find the return statement
+for i in range(start_numpy, len(lines)):
+    if 'return np.frombuffer(buffer, dtype=np.uint32)' in lines[i]:
+        lines[i] = '        tokens = np.frombuffer(buffer, dtype=np.uint32)\n'
+        lines.insert(i+1, '        if filter_tokens:\n')
+        lines.insert(i+2, '            if not isinstance(filter_tokens, (set, frozenset)):\n')
+        lines.insert(i+3, '                filter_tokens = set(filter_tokens)\n')
+        lines.insert(i+4, '            tokens = tokens[~np.isin(tokens, list(filter_tokens))]\n')
+        lines.insert(i+5, '        return tokens\n')
+        break
+
+with open('tiktoken/core.py', 'w') as f:
+    f.writelines(lines)
