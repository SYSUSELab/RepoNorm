@@ -0,0 +1,17 @@
+from outlines.types import octal_str
+
+def test_octal_str():
+    assert octal_str.matches("0o0")
+    assert octal_str.matches("0o7")
+    assert octal_str.matches("0o01234567")
+    assert octal_str.matches("0o007")
+    
+    assert not octal_str.matches("0O7")
+    assert not octal_str.matches("0o8")
+    assert not octal_str.matches("0o9")
+    assert not octal_str.matches("0o")
+    assert not octal_str.matches("o7")
+    assert not octal_str.matches("0o 7")
+    assert not octal_str.matches("0o_7")
+    assert not octal_str.matches("+0o7")
+    assert not octal_str.matches("-0o7")
