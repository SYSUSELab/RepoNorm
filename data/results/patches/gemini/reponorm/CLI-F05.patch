diff --git a/tests/test_retry_cleanup.py b/tests/test_retry_cleanup.py
new file mode 100644
index 0000000..56ebd7c
--- /dev/null
+++ b/tests/test_retry_cleanup.py
@@ -0,0 +1,71 @@
+import click
+import pytest
+import time
+from click.core import Context
+
+def test_retry_cleanup_feature():
+    attempts = 0
+    def callback():
+        nonlocal attempts
+        attempts += 1
+        if attempts < 2:
+            raise ValueError("transient error")
+        return "ok"
+
+    # Mock time.sleep
+    original_sleep = time.sleep
+    time.sleep = lambda x: None
+    
+    try:
+        ctx = Context(click.Command("test"), retry_cleanup=2)
+        ctx.call_on_close(callback)
+        ctx.close()
+        assert attempts == 2
+    finally:
+        time.sleep = original_sleep
+
+def test_retry_cleanup_exhaustion():
+    attempts = 0
+    def callback():
+        nonlocal attempts
+        attempts += 1
+        raise ValueError("persistent error")
+
+    # Mock time.sleep
+    original_sleep = time.sleep
+    time.sleep = lambda x: None
+    
+    try:
+        ctx = Context(click.Command("test"), retry_cleanup=2)
+        ctx.call_on_close(callback)
+        with pytest.raises(ValueError, match="persistent error"):
+            ctx.close()
+        assert attempts == 3 # 1 initial + 2 retries
+    finally:
+        time.sleep = original_sleep
+
+def test_retry_cleanup_inheritance():
+    parent = Context(click.Command("parent"), retry_cleanup=3)
+    child = Context(click.Command("child"), parent=parent)
+    assert child.retry_cleanup == 3
+    
+    child2 = Context(click.Command("child2"), parent=parent, retry_cleanup=0)
+    assert child2.retry_cleanup == 0
+
+def test_retry_cleanup_backoff_validation():
+    with pytest.raises(ValueError, match="retry_cleanup_backoff must be a positive number"):
+        Context(click.Command("test"), retry_cleanup_backoff=-1)
+    
+    with pytest.raises(ValueError, match="retry_cleanup_backoff must be a positive number"):
+        Context(click.Command("test"), retry_cleanup_backoff=0)
+
+    with pytest.raises(ValueError, match="retry_cleanup_backoff must be a positive number"):
+        Context(click.Command("test"), retry_cleanup_backoff="invalid")
+
+def test_retry_cleanup_backoff_inheritance():
+    parent = Context(click.Command("parent"), retry_cleanup_backoff=0.5)
+    child = Context(click.Command("child"), parent=parent)
+    assert child.retry_cleanup_backoff == 0.5
+    
+    child2 = Context(click.Command("child2"), parent=parent, retry_cleanup_backoff=0.2)
+    assert child2.retry_cleanup_backoff == 0.2
