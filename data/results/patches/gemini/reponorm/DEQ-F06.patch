+import pytest
+from dirty_equals import IsCreditCard
+
+def test_is_credit_card_basic():
+    assert '4539785901234565' == IsCreditCard()
+    assert 4539785901234565 == IsCreditCard()
+    assert '4539-7859-0123-4565' == IsCreditCard()
+
+def test_is_credit_card_visa():
+    assert '4539785901234565' == IsCreditCard(issuer='Visa')
+    assert '4539785901234565' != IsCreditCard(issuer='Mastercard')
+
+def test_is_credit_card_mastercard():
+    assert '5105105105105100' == IsCreditCard(issuer='Mastercard')
+    assert '5105105105105100' != IsCreditCard(issuer='Visa')
+
+def test_is_credit_card_amex():
+    assert '341234567890127' == IsCreditCard(issuer='AmericanExpress')
+    assert '341234567890127' != IsCreditCard(issuer='Visa')
+
+def test_is_credit_card_invalid():
+    assert '123' != IsCreditCard()
+    assert '4539785901234568' != IsCreditCard() # Invalid Luhn
