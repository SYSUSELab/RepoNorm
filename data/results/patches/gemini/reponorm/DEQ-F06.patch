@@ -0,0 +1,73 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit
+
+__all__ = 'IsCreditCard',
+
+class IsCreditCard(DirtyEquals[str]):
+    """
+    Checks if the value is a valid credit card number.
+    """
+
+    def __init__(self, issuer: Optional[str] = None):
+        """
+        Args:
+            issuer: Optional issuer to restrict to ('Visa', 'Mastercard', 'AmericanExpress').
+        """
+        self.issuer = issuer
+        super().__init__(issuer=issuer if issuer is not None else Omit)
+
+    def equals(self, other: Any) -> bool:
+        if isinstance(other, int):
+            other = str(other)
+        elif not isinstance(other, str):
+            return False
+
+        # Remove spaces and hyphens
+        cleaned = re.sub(r'[\s-]', '', other)
+
+        # Check if it's only digits
+        if not cleaned.isdigit():
+            return False
+
+        # Luhn algorithm
+        if not self._luhn_check(cleaned):
+            return False
+
+        # Issuer check
+        if self.issuer:
+            if self.issuer == 'Visa':
+                if not (len(cleaned) in (13, 16, 19) and cleaned.startswith('4')):
+                    return False
+            elif self.issuer == 'Mastercard':
+                if len(cleaned) != 16:
+                    return False
+                prefix = int(cleaned[:4])
+                if not ((51 <= int(cleaned[:2]) <= 55) or (2221 <= prefix <= 2720)):
+                    return False
+            elif self.issuer == 'AmericanExpress':
+                if not (len(cleaned) == 15 and (cleaned.startswith('34') or cleaned.startswith('37'))):
+                    return False
+            else:
+                # Unknown issuer
+                return False
+        else:
+            # General check: 12-19 digits
+            if not (12 <= len(cleaned) <= 19):
+                return False
+
+        return True
+
+    def _luhn_check(self, card_number: str) -> bool:
+        digits = [int(d) for d in card_number]
+        checksum = 0
+        reverse_digits = digits[::-1]
+        for i, digit in enumerate(reverse_digits):
+            if i % 2 == 1:
+                digit *= 2
+                if digit > 9:
+                    digit -= 9
+            checksum += digit
+        return checksum % 10 == 0
