+def luhn_check(card_number: str) -> bool:
+    digits = [int(d) for d in card_number]
+    checksum = 0
+    # The Luhn algorithm:
+    # 1. From the rightmost digit, which is the check digit, and moving left, double the value of every second digit.
+    # 2. If the result of this doubling operation is greater than 9, then add the digits of the product (e.g., 16: 1+6=7, 18: 1+8=9) or, alternatively, subtract 9 from the product (e.g., 16: 16-9=7, 18: 18-9=9).
+    # 3. Take the sum of all the digits.
+    # 4. If the total modulo 10 is equal to 0, then the number is valid.
+    
+    # My previous implementation:
+    # reverse_digits = digits[::-1]
+    # for i, digit in enumerate(reverse_digits):
+    #     if i % 2 == 1: # This doubles the 2nd, 4th, 6th... digits from the right. Correct.
+    #         digit *= 2
+    #         if digit > 9:
+    #             digit -= 9
+    #     checksum += digit
+    
+    # Let's re-check the algorithm.
+    # Example: 79927398713
+    # Digits: 7 9 9 2 7 3 9 8 7 1 3
+    # Reverse: 3 1 7 8 9 3 7 2 9 9 7
+    # Double every second: 3 (1*2=2) 7 (8*2=16->7) 9 (3*2=6) 7 (2*2=4) 9 (9*2=18->9) 7
+    # Sum: 3+2+7+7+9+6+7+4+9+9+7 = 70. 70%10=0. Valid.
+    
+    # Let's check my code with this example.
+    digits = [7, 9, 9, 2, 7, 3, 9, 8, 7, 1, 3]
+    checksum = 0
+    reverse_digits = digits[::-1]
+    for i, digit in enumerate(reverse_digits):
+        if i % 2 == 1:
+            digit *= 2
+            if digit > 9:
+                digit -= 9
+        checksum += digit
+    print(f"Checksum: {checksum}")
+    return checksum % 10 == 0
+
+print(luhn_check("79927398713"))
