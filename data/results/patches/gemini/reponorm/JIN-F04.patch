diff --git a/tests/test_filters.py b/tests/test_filters.py
index 43ddf59..3c96492 100644
--- a/tests/test_filters.py
+++ b/tests/test_filters.py
@@ -852,3 +852,45 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+def test_groupby_limit():
+    from jinja2 import Environment
+    from jinja2.exceptions import FilterArgumentError
+    env = Environment()
+    data = [
+        {"name": "a", "city": "NY"},
+        {"name": "b", "city": "NY"},
+        {"name": "c", "city": "LA"},
+        {"name": "d", "city": "LA"},
+        {"name": "e", "city": "SF"},
+        {"name": "f", "city": "SF"},
+    ]
+    
+    # Test no limit
+    result = env.filters["groupby"](env, data, "city")
+    assert len(result) == 3
+    
+    # Test limit 1
+    result = env.filters["groupby"](env, data, "city", max_groups=1)
+    assert len(result) == 1
+    assert result[0][0] == "LA" # Sorted order: LA, NY, SF
+    
+    # Test limit 2
+    result = env.filters["groupby"](env, data, "city", max_groups=2)
+    assert len(result) == 2
+    assert result[0][0] == "LA"
+    assert result[1][0] == "NY"
+    
+    # Test limit 0
+    result = env.filters["groupby"](env, data, "city", max_groups=0)
+    assert len(result) == 0
+    
+    # Test invalid limits
+    with pytest.raises(FilterArgumentError):
+        env.filters["groupby"](env, data, "city", max_groups=-1)
+    
+    with pytest.raises(FilterArgumentError):
+        env.filters["groupby"](env, data, "city", max_groups=1.5)
+        
+    with pytest.raises(FilterArgumentError):
+        env.filters["groupby"](env, data, "city", max_groups=True)
