+import re
+
+with open('src/jinja2/loaders.py', 'r') as f:
+    content = f.read()
+
+# Add imports
+content = content.replace(
+    'import fnmatch', '', 1 # Just in case it was already there, but it's not
+)
+content = re.sub(
+    r'import os',
+    'import os\nimport fnmatch\nfrom contextlib import contextmanager',
+    content
+)
+
+# Add BaseLoader methods
+base_loader_methods = """
+    def add_filter(self, filter_pattern: t.Union[str, t.Pattern, t.Callable[[str], bool]]) -> None:
+        if not hasattr(self, "_filters"):
+            self._filters = []
+        self._filters.append(filter_pattern)
+
+    def clear_filters(self) -> None:
+        if hasattr(self, "_filters"):
+            self._filters = []
+
+    @contextmanager
+    def filter_scope(self, *patterns: t.Union[str, t.Pattern, t.Callable[[str], bool]]):
+        if not hasattr(self, "_filters"):
+            self._filters = []
+        old_filters = list(self._filters)
+        for p in patterns:
+            self.add_filter(p)
+        try:
+            yield
+        finally:
+            self._filters = old_filters
+
+    def _is_filtered(self, name: str) -> bool:
+        if not hasattr(self, "_filters"):
+            return False
+        for f in self._filters:
+            if isinstance(f, str):
+                if fnmatch.fnmatch(name, f):
+                    return True
+            elif hasattr(f, "search"):
+                if f.search(name):
+                    return True
+            elif callable(f):
+                if f(name):
+                    return True
+            else:
+                raise TypeError(f"Unsupported filter type: {type(f)}")
+        return False
+"""
+
+# Insert methods into BaseLoader
+content = re.sub(
+    r'(class BaseLoader:.*?)(\n\s+def get_source)',
+    r'\1' + base_loader_methods + r'\2',
+    content,
+    flags=re.DOTALL
+)
+
+# Update list_templates in BaseLoader (it currently raises TypeError)
+# Actually, the task says: "The feature applies to loaders that already implement list_templates"
+# So I should probably not change BaseLoader.list_templates to return [], but keep it raising TypeError.
+# Wait, the task says: "A registered filter excludes a canonical /-separated template name from list_templates when any filter matches."
+# This implies that if a loader implements list_templates, it should use the filters.
+
+# Let's look at FileSystemLoader or other loaders that implement list_templates.
+# I need to find where list_templates is implemented and add the filtering logic.
+
+with open('src/jinja2/loaders.py', 'w') as f:
+    f.write(content)
