@@ -0,0 +1,49 @@
+import unittest
+import fnmatch
+import re
+from jinja2 import BaseLoader, TemplateNotFound
+
+class FilteredLoader(BaseLoader):
+    def __init__(self, templates):
+        self.templates = templates
+        self.filters = []
+
+    def list_templates(self):
+        templates = self.templates
+        for f in self.filters:
+            if isinstance(f, str):
+                templates = [t for t in templates if not fnmatch.fnmatch(t, f)]
+            elif hasattr(f, 'search'):
+                templates = [t for t in templates if not f.search(t)]
+            elif callable(f):
+                templates = [t for t in templates if not f(t)]
+            else:
+                raise TypeError(f"Unsupported filter type: {type(f)}")
+        return templates
+
+    def add_filter(self, filter_pattern):
+        self.filters.append(filter_pattern)
+
+    def clear_filters(self):
+        self.filters = []
+
+class TestLoaderFilters(unittest.TestCase):
+    def test_filter_persistence(self):
+        loader = FilteredLoader(["a.html", "b.html", "c.txt"])
+        loader.add_filter("*.txt")
+        self.assertEqual(loader.list_templates(), ["a.html", "b.html"])
+        loader.clear_filters()
+        self.assertEqual(loader.list_templates(), ["a.html", "b.html", "c.txt"])
+
+    def test_regex_filter(self):
+        loader = FilteredLoader(["a.html", "b.html", "c.txt"])
+        loader.add_filter(re.compile(r"\.html$"))
+        self.assertEqual(loader.list_templates(), ["c.txt"])
+
+    def test_callable_filter(self):
+        loader = FilteredLoader(["a.html", "b.html", "c.txt"])
+        loader.add_filter(lambda t: t.startswith("a"))
+        self.assertEqual(loader.list_templates(), ["b.html", "c.txt"])
+
+if __name__ == "__main__":
+    unittest.main()
