+import unittest
+import fnmatch
+from jinja2 import BaseLoader
+from contextlib import contextmanager
+
+class FilteredLoader(BaseLoader):
+    def __init__(self, templates):
+        self.templates = templates
+        self.filters = []
+
+    def list_templates(self):
+        templates = self.templates
+        for f in self.filters:
+            if isinstance(f, str):
+                templates = [t for t in templates if not fnmatch.fnmatch(t, f)]
+            else:
+                raise TypeError("Unsupported filter")
+        return templates
+
+    def add_filter(self, filter_pattern):
+        self.filters.append(filter_pattern)
+
+    def clear_filters(self):
+        self.filters = []
+
+    @contextmanager
+    def filter_scope(self, *patterns):
+        old_filters = list(self.filters)
+        for p in patterns:
+            self.add_filter(p)
+        try:
+            yield
+        finally:
+            self.filters = old_filters
+
+class TestLoaderScope(unittest.TestCase):
+    def test_filter_scope(self):
+        loader = FilteredLoader(["a.html", "b.html", "c.txt"])
+        with loader.filter_scope("*.txt"):
+            self.assertEqual(loader.list_templates(), ["a.html", "b.html"])
+            with loader.filter_scope("*.html"):
+                self.assertEqual(loader.list_templates(), [])
+            self.assertEqual(loader.list_templates(), ["a.html", "b.html"])
+        self.assertEqual(loader.list_templates(), ["a.html", "b.html", "c.txt"])
+
+if __name__ == "__main__":
+    unittest.main()
