diff --git a/dirty_equals/_email.py b/dirty_equals/_email.py
new file mode 100644
index 0000000..2962658
--- /dev/null
+++ b/dirty_equals/_email.py
@@ -0,0 +1,45 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+
+__all__ = ('IsEmail',)
+
+# Local part: ASCII letters/digits and _ % + -
+# Dots only between nonempty runs (no leading, trailing or consecutive dots)
+# Domain labels: ASCII letters/digits and internal hyphens
+# Labels are nonempty and cannot start or end with a hyphen
+# At least two labels, final label consists of at least two ASCII letters
+EMAIL_REGEX = re.compile(
+    r"^[a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*"  # Local part
+    r"@"
+    r"([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+"  # Domain labels (at least one)
+    r"[a-zA-Z]{2,}$"  # Final label (at least two letters)
+)
+
+class IsEmail(DirtyEquals[str]):
+    """
+    Checks if the value is a valid email address.
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        self.domain = domain
+        super().__init__(domain=domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if not EMAIL_REGEX.fullmatch(other):
+            return False
+
+        if self.domain is not None:
+            if not other.endswith('@' + self.domain):
+                return False
+
+        return True
+
+    def __repr__(self) -> str:
+        if self.domain:
+            return f'IsEmail({self.domain!r})'
+        return 'IsEmail()'
diff --git a/tests/test_email.py b/tests/test_email.py
new file mode 100644
index 0000000..f0004da
--- /dev/null
+++ b/tests/test_email.py
@@ -0,0 +1,29 @@
+import pytest
+from dirty_equals import IsEmail
+
+def test_is_email_valid():
+    assert 'test@example.com' == IsEmail()
+    assert 'test.email+tag@domain.co.uk' == IsEmail()
+    assert 'user_name@sub.domain.com' == IsEmail()
+    assert 'user%name@domain.com' == IsEmail()
+
+def test_is_email_invalid():
+    assert 'test@example' != IsEmail()
+    assert 'test@.com' != IsEmail()
+    assert '@example.com' != IsEmail()
+    assert 'test@example..com' != IsEmail()
+    assert 'test@example.c' != IsEmail() # Final label must be at least 2 letters
+    assert 'test@example.12' != IsEmail() # Final label must be letters
+    assert 'test@example.com-' != IsEmail()
+    assert 'test@-example.com' != IsEmail()
+    assert 123 != IsEmail()
+
+def test_is_email_with_domain():
+    assert 'test@example.com' == IsEmail(domain='example.com')
+    assert 'test@sub.example.com' != IsEmail(domain='example.com')
+    assert 'test@other.com' != IsEmail(domain='example.com')
+    assert 'test@example.com' != IsEmail(domain='Example.com') # Case sensitive
+
+def test_is_email_repr():
+    assert repr(IsEmail()) == 'IsEmail()'
+    assert repr(IsEmail(domain='example.com')) == "IsEmail('example.com')"
