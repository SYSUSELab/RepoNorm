+            token = parser.stream.expect("name")
+            if token.value == "context":
+                parser.stream.expect("assign")
+                context = parser.parse_expression()
+                if not isinstance(context, nodes.Const):
+                    parser.fail("context must be a string literal", context.lineno)
+        parser.stream.expect("block_end")
+
+        # Parse true branch
+        referenced, singular = self._parse_ctrans_block(parser, True)
+        
+        # Consume {% fallback %}
+        parser.stream.expect("block_begin")
+        parser.stream.expect("name:fallback")
+        parser.stream.expect("block_end")
+        
+        # Parse fallback branch
+        fallback_body = []
+        while not parser.stream.current.test("name:endctrans"):
+            fallback_body.append(parser.parse_statement())
+        
+        parser.stream.expect("block_begin")
+        parser.stream.expect("name:endctrans")
+        parser.stream.expect("block_end")
+        
+        # Create node
+        # For now, I'll just return a simple node to test if it parses.
+        return nodes.Output([nodes.Const("ctrans node")])
+
+    def _parse_ctrans_block(
+        self, parser: "Parser", allow_pluralize: bool
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next block tag with a given name."""
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:fallback"):
+                    break
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
