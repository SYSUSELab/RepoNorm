+# I will use a regex that matches the entire `_parse_ctrans` and `_parse_ctrans_block` methods.
+
+# Let's find the start and end of the methods.
+# I will search for `def _parse_ctrans` and the end of `_parse_ctrans_block`.
+
+# Actually, I will just replace the entire `_parse_ctrans` and `_parse_ctrans_block` methods.
+# I will use a regex that matches `def _parse_ctrans` up to the end of `_parse_ctrans_block`.
+
+# Let's find the start of `_parse_ctrans`.
+start_match = re.search(r'    def _parse_ctrans', content)
+if start_match:
+    start = start_match.start()
+    # Find the end of `_parse_ctrans_block`.
+    # It ends with `return referenced, concat(buf)` or similar.
+    # I will search for the next `def` or the end of the class.
+    end_match = re.search(r'    def _make_node', content[start:])
+    if end_match:
+        end = start + end_match.start()
+        content = content[:start] + new_methods + content[end:]
+    else:
+        # If `_make_node` is not found, I will just append the new methods.
+        content = content[:start] + new_methods
+else:
+    # If `_parse_ctrans` is not found, I will just append the new methods.
+    content += new_methods
