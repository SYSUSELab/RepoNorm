+        # This is a simplified version of _parse_block for the true branch
+        # It should only handle the trans content.
+        # For now, let's just reuse _parse_block if possible, but it's not exposed.
+        # Actually, _parse_block is a method of InternationalizationExtension.
+        # Let's just call it.
+        return self._parse_block(parser, is_singular)
