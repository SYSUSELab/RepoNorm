+# Find where to insert the new methods.
+# I'll insert them after `_parse_block`.
+insert_pos = 0
+for i, line in enumerate(lines):
+    if "def _parse_block" in line:
+        # Find the end of `_parse_block`.
+        # It ends when the next method starts.
+        for j in range(i + 1, len(lines)):
+            if lines[j].startswith("    def "):
+                insert_pos = j
+                break
+        break
+
+new_methods = [
+    "\n",
+    "    def _parse_ctrans(self, parser: \"Parser\", lineno: int) -> nodes.Node:\n",
+    "        condition = parser.parse_expression()\n",
+    "        context = None\n",
+    "        if parser.stream.skip_if(\"comma\"):\n",
+    "            token = parser.stream.expect(\"name\")\n",
+    "            if token.value == \"context\":\n",
+    "                parser.stream.expect(\"assign\")\n",
+    "                context = parser.parse_expression()\n",
+    "                if not isinstance(context, nodes.Const):\n",
+    "                    parser.fail(\"context must be a string literal\", context.lineno)\n",
+    "        parser.stream.expect(\"block_end\")\n",
+    "\n",
+    "        # Parse true branch\n",
+    "        referenced, singular = self._parse_ctrans_block(parser, True)\n",
+    "        parser.stream.expect(\"name:fallback\")\n",
+    "        parser.stream.expect(\"block_end\")\n",
+    "\n",
+    "        # Parse fallback branch\n",
+    "        fallback_body = parser.parse_statements([\"name:endctrans\"], drop_needle=True)\n",
+    "\n",
+    "        # Create trans node\n",
+    "        variables = {name: nodes.Name(name, \"load\") for name in referenced}\n",
+    "        trans_node = self._make_node(singular, None, variables, None, bool(referenced), False)\n",
+    "\n",
+    "        return nodes.If(condition, [trans_node], [], fallback_body, lineno=lineno)\n",
+    "\n",
+    "    def _parse_ctrans_block(\n",
+    "        self, parser: \"Parser\", allow_pluralize: bool\n",
+    "    ) -> t.Tuple[t.List[str], str]:\n",
+    "        \"\"\"Parse until the next block tag with a given name.\"\"\"\n",
+    "        referenced = []\n",
+    "        buf = []\n",
+    "\n",
+    "        while True:\n",
+    "            if parser.stream.current.type == \"data\":\n",
+    "                buf.append(parser.stream.current.value.replace(\"%\", \"%%\"))\n",
+    "                next(parser.stream)\n",
+    "            elif parser.stream.current.type == \"variable_begin\":\n",
+    "                next(parser.stream)\n",
+    "                name = parser.stream.expect(\"name\").value\n",
+    "                referenced.append(name)\n",
+    "                buf.append(f\"%({name})s\")\n",
+    "                parser.stream.expect(\"variable_end\")\n",
+    "            elif parser.stream.current.type == \"block_begin\":\n",
+    "                next(parser.stream)\n",
+    "                if parser.stream.current.test(\"name:fallback\"):\n",
+    "                    break\n",
+    "                elif parser.stream.current.test(\"name:pluralize\"):\n",
+    "                    if allow_pluralize:\n",
+    "                        break\n",
+    "                    parser.fail(\n",
+    "                        \"a translatable section can have only one pluralize section\"\n",
+    "                    )\n",
+    "                parser.fail(\n",
+    "                    \"control structures in translatable sections are not allowed\"\n",
+    "                )\n",
+    "            elif parser.stream.eos:\n",
+    "                parser.fail(\"unclosed translation block\")\n",
+    "            else:\n",
+    "                buf.append(parser.stream.current.value)\n",
+    "                next(parser.stream)\n",
+    "        return referenced, \"\".join(buf)\n"
+]
+
+new_lines = lines[:insert_pos] + new_methods + lines[insert_pos:]
+with open("src/jinja2/ext.py", "w") as f:
+    f.writelines(new_lines)
