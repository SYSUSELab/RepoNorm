@@ -0,0 +1,69 @@
+import pytest
+import tiktoken
+
+def test_validator_basic():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    def validator(tokens):
+        if len(tokens) > 5:
+            raise ValueError("Too long")
+        return True
+    
+    # Should pass
+    enc.encode("hello", validators=[validator])
+    
+    # Should fail
+    with pytest.raises(ValueError, match="Too long"):
+        enc.encode("hello world this is too long", validators=[validator])
+
+def test_validator_mutation():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    def validator(tokens):
+        tokens.append(123)
+        return True
+    
+    tokens = enc.encode("hello", validators=[validator])
+    # The mutation should not affect the returned tokens
+    assert 123 not in tokens
+
+def test_validator_batch():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    def validator(tokens):
+        if 123 in tokens:
+            raise ValueError("Forbidden token")
+        return True
+    
+    # Should pass
+    enc.encode_batch(["hello", "world"], validators=[validator])
+    
+    # Should fail
+    # The input "forbidden token 123" will be encoded into tokens.
+    # Let's see what tokens it produces.
+    tokens = enc.encode("forbidden token 123")
+    print(f"Tokens for 'forbidden token 123': {tokens}")
+    
+    # Wait, does "forbidden token 123" actually contain 123?
+    # 123 is a token ID, not a string.
+    # Ah, the validator receives token IDs.
+    # Let's find a token ID that is in "forbidden token 123".
+    
+    # Let's just use a validator that fails for a specific token ID.
+    def validator_fail(tokens):
+        if 123 in tokens:
+            raise ValueError("Forbidden token")
+        return True
+    
+    # Let's find a token that is in "hello"
+    tokens_hello = enc.encode("hello")
+    token_to_forbid = tokens_hello[0]
+    
+    def validator_forbid_hello(tokens):
+        if token_to_forbid in tokens:
+            raise ValueError("Forbidden token")
+        return True
+        
+    with pytest.raises(ValueError, match="Forbidden token"):
+        enc.encode_batch(["hello", "world"], validators=[validator_forbid_hello])
+
