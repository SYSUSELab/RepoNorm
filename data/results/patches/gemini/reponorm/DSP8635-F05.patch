+
+def test_propose_instructions_for_program_verbose():
+    import io
+    import contextlib
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    # We need to make sure set_tip_randomly is True
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=True)
+    proposer.set_tip_randomly = True
+    
+    f = io.StringIO()
+    with contextlib.redirect_stdout(f):
+        proposer.propose_instructions_for_program(
+            trainset=trainset, program=program, demo_candidates=None, trial_logs={}, N=1, T=0.5
+        )
+    
+    output = f.getvalue()
+    assert "Selected tip:" in output
+    assert "Chosen tip:" in output
+    assert "tip_key=" in output
+
+def test_propose_instructions_for_program_not_verbose():
+    import io
+    import contextlib
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False)
+    proposer.set_tip_randomly = True
+    
+    f = io.StringIO()
+    with contextlib.redirect_stdout(f):
+        proposer.propose_instructions_for_program(
+            trainset=trainset, program=program, demo_candidates=None, trial_logs={}, N=1, T=0.5
+        )
+    
+    output = f.getvalue()
+    assert "Selected tip:" not in output
+    assert "Chosen tip:" not in output
