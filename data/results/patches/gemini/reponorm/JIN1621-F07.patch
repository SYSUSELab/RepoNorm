+import sys
+
+with open("src/jinja2/loaders.py", "r") as f:
+    lines = f.readlines()
+
+# Find FileSystemLoader.__init__
+start_line = 0
+for i, line in enumerate(lines):
+    if "class FileSystemLoader(BaseLoader):" in line:
+        start_line = i
+        break
+
+# Find __init__
+init_line = 0
+for i in range(start_line, len(lines)):
+    if "def __init__(" in lines[i]:
+        init_line = i
+        break
+
+# We need to be very careful with the replacement.
+# Let's find the end of the __init__ signature.
+end_init_sig = 0
+for i in range(init_line, len(lines)):
+    if ") -> None:" in lines[i]:
+        end_init_sig = i
+        break
+
+# Replace the signature
+new_lines = lines[:init_line]
+new_lines.append("    def __init__(\n")
+new_lines.append("        self,\n")
+new_lines.append("        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],\n")
+new_lines.append("        encoding: str = \"utf-8\",\n")
+new_lines.append("        followlinks: bool = False,\n")
+new_lines.append("        expand_searchpath: bool = False,\n")
+new_lines.append("    ) -> None:\n")
+
+# Replace the body
+# The original body starts after end_init_sig
+# Let's find where the body ends (before get_source)
+body_end = 0
+for i in range(end_init_sig + 1, len(lines)):
+    if "def get_source(" in lines[i]:
+        body_end = i
+        break
+
+new_lines.append("        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):\n")
+new_lines.append("            searchpath = [searchpath]\n")
+new_lines.append("\n")
+new_lines.append("        if expand_searchpath:\n")
+new_lines.append("            searchpath = [\n")
+new_lines.append("                os.path.expanduser(os.path.expandvars(os.fspath(p)))\n")
+new_lines.append("                for p in searchpath\n")
+new_lines.append("            ]\n")
+new_lines.append("\n")
+new_lines.append("        self.searchpath = [os.fspath(p) for p in searchpath]\n")
+new_lines.append("        self.encoding = encoding\n")
+new_lines.append("        self.followlinks = followlinks\n")
+new_lines.append("\n")
+
+new_lines.extend(lines[body_end:])
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.writelines(new_lines)
