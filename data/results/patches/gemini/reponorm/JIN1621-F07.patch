@@ -0,0 +1,40 @@
+import os
+from jinja2 import FileSystemLoader
+import unittest
+
+class TestExpandSearchPath(unittest.TestCase):
+    def test_expand_searchpath(self):
+        os.environ["MY_PATH"] = "/absolute/path"
+        
+        # Test expansion
+        loader = FileSystemLoader(
+            ["$MY_PATH/templates"], 
+            expand_searchpath=True
+        )
+        
+        # Wait, $MY_PATH in python string is just $MY_PATH.
+        # If I want to test environment variable expansion, I should use "".
+        
+        loader = FileSystemLoader(
+            ["/templates"], 
+            expand_searchpath=True
+        )
+        
+        print(f"Search path: {loader.searchpath}")
+        # On Linux, os.path.expandvars("") should expand to /absolute/path
+        self.assertEqual(loader.searchpath[0], "/absolute/path/templates")
+
+    def test_no_expand_searchpath(self):
+        os.environ["MY_PATH"] = "/absolute/path"
+        
+        # Test no expansion
+        loader = FileSystemLoader(
+            ["/templates"], 
+            expand_searchpath=False
+        )
+        
+        print(f"Search path: {loader.searchpath}")
+        self.assertEqual(loader.searchpath[0], "/templates")
+
+if __name__ == "__main__":
+    unittest.main()
