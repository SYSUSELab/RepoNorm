diff --git a/test_ipv6_regex.py b/test_ipv6_regex.py
new file mode 100644
index 0000000..4568dd4
--- /dev/null
+++ b/test_ipv6_regex.py
@@ -0,0 +1,37 @@
+import re
+
+# Full-form IPv6: exactly eight colon-separated groups, each containing one to four ASCII hexadecimal digits.
+# Hex letters may be upper- or lowercase.
+# Empty groups, :: compression, zone identifiers, IPv4 tails, and groups longer than four digits are invalid.
+
+# Group: [0-9a-fA-F]{1,4}
+# Eight groups: group(:group){7}
+# Total: [0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4}){7}
+
+pattern = r"[0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4}){7}"
+regex = re.compile(pattern)
+
+def test_ipv6():
+    valid = [
+        "2001:0db8:85a3:0000:0000:8a2e:0370:7334",
+        "2001:db8:85a3:0:0:8a2e:370:7334",
+        "ABCD:EF01:2345:6789:ABCD:EF01:2345:6789",
+        "abcd:ef01:2345:6789:abcd:ef01:2345:6789",
+    ]
+    invalid = [
+        "2001:db8:85a3::8a2e:370:7334", # compression
+        "2001:db8:85a3:0:0:8a2e:370:7334:1234", # too many
+        "2001:db8:85a3:0:0:8a2e:370", # too few
+        "2001:db8:85a3:0:0:8a2e:370:73345", # too long group
+        "2001:db8:85a3:0:0:8a2e:370:733g", # invalid hex
+        "2001:db8:85a3:0:0:8a2e:370:7334%eth0", # zone identifier
+        "2001:db8:85a3:0:0:8a2e:370:192.168.0.1", # ipv4 tail
+    ]
+    
+    for v in valid:
+        assert regex.fullmatch(v), f"Should be valid: {v}"
+    for i in invalid:
+        assert not regex.fullmatch(i), f"Should be invalid: {i}"
+
+test_ipv6()
+print("Tests passed!")
diff --git a/tests/types/test_ipv6.py b/tests/types/test_ipv6.py
new file mode 100644
index 0000000..08ce1e1
--- /dev/null
+++ b/tests/types/test_ipv6.py
@@ -0,0 +1,23 @@
+from outlines.types import ipv6
+
+def test_ipv6_type():
+    assert ipv6.matches("2001:0db8:85a3:0000:0000:8a2e:0370:7334")
+    assert ipv6.matches("2001:db8:85a3:0:0:8a2e:370:7334")
+    assert ipv6.matches("ABCD:EF01:2345:6789:ABCD:EF01:2345:6789")
+    assert ipv6.matches("abcd:ef01:2345:6789:abcd:ef01:2345:6789")
+    
+    assert not ipv6.matches("2001:db8:85a3::8a2e:370:7334")
+    assert not ipv6.matches("2001:db8:85a3:0:0:8a2e:370:7334:1234")
+    assert not ipv6.matches("2001:db8:85a3:0:0:8a2e:370")
+    assert not ipv6.matches("2001:db8:85a3:0:0:8a2e:370:73345")
+    assert not ipv6.matches("2001:db8:85a3:0:0:8a2e:370:733g")
+    assert not ipv6.matches("2001:db8:85a3:0:0:8a2e:370:7334%eth0")
+    assert not ipv6.matches("2001:db8:85a3:0:0:8a2e:370:192.168.0.1")
+
+def test_ipv6_validation():
+    ipv6.validate("2001:0db8:85a3:0000:0000:8a2e:0370:7334")
+    try:
+        ipv6.validate("invalid")
+        assert False, "Should have raised ValueError"
+    except ValueError:
+        pass
