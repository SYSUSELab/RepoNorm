diff --git a/tests/test_edit_escape.py b/tests/test_edit_escape.py
new file mode 100644
index 0000000..ca7e91a
--- /dev/null
+++ b/tests/test_edit_escape.py
@@ -0,0 +1,32 @@
+import click
+import subprocess
+from unittest.mock import patch, MagicMock
+import pytest
+
+def test_edit_escape_shell_true():
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        with patch("click._termui_impl.Editor.get_editor", return_value="vim"):
+            click.edit("hello", editor="vim", escape_shell=True)
+            
+            args, kwargs = mock_popen.call_args
+            assert isinstance(args[0], list)
+            assert args[0][0] == "vim"
+            assert len(args[0]) == 2
+            assert kwargs["shell"] is False
+
+def test_edit_escape_shell_false():
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        with patch("click._termui_impl.Editor.get_editor", return_value="vim"):
+            click.edit("hello", editor="vim", escape_shell=False)
+            
+            args, kwargs = mock_popen.call_args
+            assert isinstance(args[0], str)
+            assert kwargs["shell"] is True
