diff --git a/tests/test_groupby_transform.py b/tests/test_groupby_transform.py
new file mode 100644
index 0000000..ce9f67b
--- /dev/null
+++ b/tests/test_groupby_transform.py
@@ -0,0 +1,99 @@
+import pytest
+from jinja2 import Environment
+
+def test_groupby_transform():
+    env = Environment()
+    users = [
+        {"name": "Alice", "city": "NY"},
+        {"name": "Bob", "city": "NY"},
+        {"name": "Charlie", "city": "LA"},
+    ]
+    
+    # Test with key_transform
+    def transform(key):
+        return key.upper()
+    
+    result = env.from_string(
+        "{% for city, items in users|groupby('city', key_transform=transform) %}"
+        "{{ city }}: {{ items|map(attribute='name')|join(', ') }};"
+        "{% endfor %}"
+    ).render(users=users, transform=transform)
+    
+    assert result == "LA: Charlie;NY: Alice, Bob;"
+
+def test_groupby_transform_async():
+    import asyncio
+    env = Environment(enable_async=True)
+    users = [
+        {"name": "Alice", "city": "NY"},
+        {"name": "Bob", "city": "NY"},
+        {"name": "Charlie", "city": "LA"},
+    ]
+    
+    async def transform(key):
+        await asyncio.sleep(0.01)
+        return key.upper()
+    
+    result = asyncio.run(env.from_string(
+        "{% for city, items in users|groupby('city', key_transform=transform) %}"
+        "{{ city }}: {{ items|map(attribute='name')|join(', ') }};"
+        "{% endfor %}"
+    ).render_async(users=users, transform=transform))
+    
+    assert result == "LA: Charlie;NY: Alice, Bob;"
+
+def test_groupby_transform_none():
+    env = Environment()
+    users = [
+        {"name": "Alice", "city": "NY"},
+        {"name": "Bob", "city": "NY"},
+    ]
+    result = env.from_string(
+        "{% for city, items in users|groupby('city', key_transform=None) %}"
+        "{{ city }}: {{ items|map(attribute='name')|join(', ') }};"
+        "{% endfor %}"
+    ).render(users=users)
+    assert result == "NY: Alice, Bob;"
+
+def test_groupby_transform_exception():
+    env = Environment()
+    users = [{"city": "NY"}]
+    def transform(key):
+        raise ValueError("oops")
+    with pytest.raises(ValueError, match="oops"):
+        env.from_string(
+            "{% for city, items in users|groupby('city', key_transform=transform) %}"
+            "{{ city }}"
+            "{% endfor %}"
+        ).render(users=users, transform=transform)
+
+def test_groupby_transform_markup():
+    from markupsafe import Markup
+    env = Environment()
+    users = [{"city": "NY"}]
+    def transform(key):
+        return Markup("<b>NY</b>")
+    result = env.from_string(
+        "{% for city, items in users|groupby('city', key_transform=transform) %}"
+        "{{ city }}"
+        "{% endfor %}"
+    ).render(users=users, transform=transform)
+    assert result == "<b>NY</b>"
+
+from jinja2 import pass_environment
+
+def test_groupby_transform_pass_environment():
+    env = Environment()
+    users = [{"city": "NY"}]
+    
+    @pass_environment
+    def transform(environment, key):
+        assert environment is env
+        return key.upper()
+    
+    result = env.from_string(
+        "{% for city, items in users|groupby('city', key_transform=transform) %}"
+        "{{ city }}"
+        "{% endfor %}"
+    ).render(users=users, transform=transform)
+    assert result == "NY"
