diff --git a/tests/test_positions.py b/tests/test_positions.py
new file mode 100644
index 0000000..cbda052
--- /dev/null
+++ b/tests/test_positions.py
@@ -0,0 +1,58 @@
+import tiktoken
+import pytest
+
+def test_basic_positions():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello world"
+    tokens, positions = enc.encode(text, return_positions=True)
+    assert tokens == enc.encode(text)
+    # "hello" -> 0
+    # " world" -> 5
+    assert positions == [0, 5]
+
+def test_batch_positions():
+    enc = tiktoken.get_encoding("cl100k_base")
+    texts = ["hello", "world 🌍"]
+    results = enc.encode_batch(texts, return_positions=True)
+
+    assert len(results) == 2
+
+    tokens1, positions1 = results[0]
+    assert tokens1 == enc.encode("hello")
+    assert positions1 == [0]
+
+    tokens2, positions2 = results[1]
+    assert tokens2 == enc.encode("world 🌍")
+    # "world" is 0, " 🌍" is 5
+    # The tokens for "world 🌍" are [14957, 11410, 234, 235]
+    # 14957: 'world' (0)
+    # 11410: ' 🌍' (5)
+    # 234: '🌍' (6)
+    # 235: '🌍' (6)
+    assert positions2 == [0, 5, 6, 6]
+
+def test_special_tokens():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello <|endoftext|>"
+    tokens, positions = enc.encode(text, allowed_special={"<|endoftext|>"}, return_positions=True)
+
+    assert tokens == enc.encode(text, allowed_special={"<|endoftext|>"})
+    # "hello " -> 0
+    # "<|endoftext|>" -> 6
+    # Wait, "hello <|endoftext|>"
+    # "hello " -> 0
+    # "<|endoftext|>" -> 6
+    # Let's check the tokens
+    # tokens = enc.encode("hello <|endoftext|>", allowed_special={"<|endoftext|>"})
+    # print(tokens)
+    # The tokens are [15339, 220, 100257]
+    # 15339: 'hello' (0)
+    # 220: ' ' (5)
+    # 100257: '<|endoftext|>' (6)
+    assert positions == [0, 5, 6]
+
+def test_empty_input():
+    enc = tiktoken.get_encoding("cl100k_base")
+    tokens, positions = enc.encode("", return_positions=True)
+    assert tokens == []
+    assert positions == []
