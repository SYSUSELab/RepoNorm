@@ -0,0 +1,66 @@
+import pytest
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_fallback_chain_full():
+    env = Environment(extensions=[InternationalizationExtension])
+    i18n = env.extensions['jinja2.ext.InternationalizationExtension']
+    
+    def primary_gettext(s):
+        return s # miss
+        
+    def fallback_gettext_1(s):
+        return "fallback1"
+        
+    def fallback_gettext_2(s):
+        return "fallback2"
+        
+    i18n.install_gettext_callables_with_fallback(
+        primary_gettext,
+        lambda s, p, n: s if n == 1 else p,
+        fallback_gettext_funcs=[fallback_gettext_1, fallback_gettext_2]
+    )
+    
+    assert env.globals['gettext']('hello') == 'fallback1'
+    
+    # Test ngettext
+    def primary_ngettext(s, p, n):
+        return s if n == 1 else p # miss
+        
+    def fallback_ngettext_1(s, p, n):
+        return "fallback_n1"
+        
+    i18n.install_gettext_callables_with_fallback(
+        primary_gettext,
+        primary_ngettext,
+        fallback_ngettext_funcs=[fallback_ngettext_1]
+    )
+    
+    assert env.globals['ngettext']('singular', 'plural', 2) == 'fallback_n1'
+
+    # Test pgettext
+    def primary_pgettext(c, s):
+        return s # miss
+        
+    def fallback_pgettext_1(c, s):
+        return "fallback_p1"
+        
+    i18n.install_gettext_callables_with_fallback(
+        primary_gettext,
+        primary_ngettext,
+        pgettext=primary_pgettext,
+        fallback_pgettext_funcs=[fallback_pgettext_1]
+    )
+    
+    assert env.globals['pgettext']('context', 'message') == 'fallback_p1'
+
+def test_fallback_missing_primary_raises():
+    env = Environment(extensions=[InternationalizationExtension])
+    i18n = env.extensions['jinja2.ext.InternationalizationExtension']
+    
+    with pytest.raises(ValueError, match="pgettext is required"):
+        i18n.install_gettext_callables_with_fallback(
+            lambda s: s,
+            lambda s, p, n: s,
+            fallback_pgettext_funcs=[lambda c, s: s]
+        )
