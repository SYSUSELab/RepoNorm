+def _make_fallback_gettext(gettext, fallback_funcs):
+    def gettext_with_fallback(message):
+        result = gettext(message)
+        if result == message:
+            for func in fallback_funcs:
+                result = func(message)
+                if result != message:
+                    return result
+            return message
+        return result
+    return gettext_with_fallback
+
+def _make_fallback_ngettext(ngettext, fallback_funcs):
+    def ngettext_with_fallback(singular, plural, n):
+        result = ngettext(singular, plural, n)
+        expected = singular if n == 1 else plural
+        if result == expected:
+            for func in fallback_funcs:
+                result = func(singular, plural, n)
+                if result != expected:
+                    return result
+            return expected
+        return result
+    return ngettext_with_fallback
+
+def _make_fallback_pgettext(pgettext, fallback_funcs):
+    def pgettext_with_fallback(context, message):
+        result = pgettext(context, message)
+        if result == message:
+            for func in fallback_funcs:
+                result = func(context, message)
+                if result != message:
+                    return result
+            return message
+        return result
+    return pgettext_with_fallback
+
+def _make_fallback_npgettext(npgettext, fallback_funcs):
+    def npgettext_with_fallback(context, singular, plural, n):
+        result = npgettext(context, singular, plural, n)
+        expected = singular if n == 1 else plural
+        if result == expected:
+            for func in fallback_funcs:
+                result = func(context, singular, plural, n)
+                if result != expected:
+                    return result
+            return expected
+        return result
