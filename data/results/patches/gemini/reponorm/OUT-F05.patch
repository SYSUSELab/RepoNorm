diff --git a/tests/test_xgrammar_custom_adapter.py b/tests/test_xgrammar_custom_adapter.py
new file mode 100644
index 0000000..60f97e8
--- /dev/null
+++ b/tests/test_xgrammar_custom_adapter.py
@@ -0,0 +1,70 @@
+import pytest
+import torch
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+from outlines.processors.tensor_adapters.base import TensorAdapter
+from typing import Any, Union, Optional
+
+class MockTensorAdapter(TensorAdapter):
+    library_name = "custom"
+
+    def shape(self, tensor: Any) -> list[int]:
+        return list(tensor.shape)
+
+    def unsqueeze(self, tensor: Any) -> Any:
+        return tensor.unsqueeze(0)
+
+    def squeeze(self, tensor: Any) -> Any:
+        return tensor.squeeze(0)
+
+    def to_list(self, tensor: Any) -> list:
+        return tensor.tolist()
+
+    def to_scalar(self, tensor: Any) -> Any:
+        return tensor.item()
+
+    def full_like(self, tensor: torch.Tensor, fill_value: Any) -> Any:
+        return torch.full_like(tensor, fill_value)
+
+    def concatenate(self, tensors: list[Union[torch.Tensor, Any]]) -> Any:
+        return torch.cat(tensors, dim=0)
+
+    def get_device(self, tensor: Any) -> str:
+        return "cpu"
+
+    def to_device(self, tensor: Any, device: str) -> Any:
+        return tensor.to(device)
+
+    def boolean_ones_like(self, tensor: Any) -> Any:
+        return torch.ones_like(tensor, dtype=torch.bool)
+
+    def apply_mask(self, tensor: Any, mask: Any, value: Any) -> Any:
+        tensor[mask] = value
+        return tensor
+
+    def argsort_descending(self, tensor: Any) -> Any:
+        return torch.argsort(tensor, descending=True)
+
+def test_xgrammar_custom_adapter_injection():
+    # Test successful injection
+    adapter = MockTensorAdapter()
+    processor = XGrammarLogitsProcessor(
+        compiled_grammar="root ::= 'a'",
+        tensor_library_name="custom",
+        custom_adapter=adapter
+    )
+    assert processor.tensor_adapter == adapter
+
+    # Test invalid combinations
+    with pytest.raises(ValueError, match="A custom_adapter must be provided"):
+        XGrammarLogitsProcessor(
+            compiled_grammar="root ::= 'a'",
+            tensor_library_name="custom",
+            custom_adapter=None
+        )
+
+    with pytest.raises(ValueError, match="A custom_adapter can only be provided"):
+        XGrammarLogitsProcessor(
+            compiled_grammar="root ::= 'a'",
+            tensor_library_name="torch",
+            custom_adapter=adapter
+        )
