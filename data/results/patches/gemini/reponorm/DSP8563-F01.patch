+def test_tool_calls_normalization():
+    from dspy.adapters.types.tool import ToolCalls
+    import json
+    # 1. Existing format
+    data1 = {"tool_calls": [{"name": "foo", "args": {"a": 1}}]}
+    normalized1 = ToolCalls.validate_input(data1)
+    assert normalized1 == {"tool_calls": [{"name": "foo", "args": {"a": 1}}]}
+
+    # 2. Single object
+    data2 = {"name": "foo", "args": {"a": 1}}
+    normalized2 = ToolCalls.validate_input(data2)
+    assert normalized2 == {"tool_calls": [{"name": "foo", "args": {"a": 1}}]}
+
+    # 3. Bare list
+    data3 = [{"name": "foo", "args": {"a": 1}}, {"name": "bar", "args": {"b": 2}}]
+    normalized3 = ToolCalls.validate_input(data3)
+    assert normalized3 == {"tool_calls": [{"name": "foo", "args": {"a": 1}}, {"name": "bar", "args": {"b": 2}}]}
+
+    # 4. Empty list
+    data4 = []
+    normalized4 = ToolCalls.validate_input(data4)
+    assert normalized4 == {"tool_calls": []}
+
+    # 5. JSON strings
+    data5 = json.dumps({"name": "foo", "args": {"a": 1}})
+    normalized5 = ToolCalls.validate_input(data5)
+    assert normalized5 == {"tool_calls": [{"name": "foo", "args": {"a": 1}}]}
+
+    # 6. Already normalized
+    data6 = {"tool_calls": [{"name": "foo", "args": {"a": 1}}]}
+    normalized6 = ToolCalls.validate_input(data6)
+    assert normalized6 == data6
+
+    # 7. Non-JSON string (should be returned as is)
+    data7 = "not a json"
+    normalized7 = ToolCalls.validate_input(data7)
+    assert normalized7 == "not a json"
+
+def test_tool_calls_model_validate():
+    from dspy.adapters.types.tool import ToolCalls
+    import json
+    # 1. Existing format
+    data1 = {"tool_calls": [{"name": "foo", "args": {"a": 1}}]}
+    model1 = ToolCalls.model_validate(data1)
+    assert model1.tool_calls[0].name == "foo"
+    assert model1.tool_calls[0].args == {"a": 1}
+
+    # 2. Single object
+    data2 = {"name": "foo", "args": {"a": 1}}
+    model2 = ToolCalls.model_validate(data2)
+    assert model2.tool_calls[0].name == "foo"
+    assert model2.tool_calls[0].args == {"a": 1}
+
+    # 3. Bare list
+    data3 = [{"name": "foo", "args": {"a": 1}}, {"name": "bar", "args": {"b": 2}}]
+    model3 = ToolCalls.model_validate(data3)
+    assert len(model3.tool_calls) == 2
+    assert model3.tool_calls[0].name == "foo"
+    assert model3.tool_calls[1].name == "bar"
+
+    # 4. JSON string
+    data4 = json.dumps({"name": "foo", "args": {"a": 1}})
+    model4 = ToolCalls.model_validate_json(data4)
+    assert model4.tool_calls[0].name == "foo"
+    assert model4.tool_calls[0].args == {"a": 1}
