diff --git a/tests/test_filesystem_loader_cache.py b/tests/test_filesystem_loader_cache.py
new file mode 100644
index 0000000..1a38265
--- /dev/null
+++ b/tests/test_filesystem_loader_cache.py
@@ -0,0 +1,71 @@
+import os
+import pytest
+from jinja2 import FileSystemLoader, TemplateNotFound
+
+class TestFileSystemLoaderCache:
+    @pytest.fixture
+    def tmp_templates(self, tmp_path):
+        d1 = tmp_path / "d1"
+        d1.mkdir()
+        d2 = tmp_path / "d2"
+        d2.mkdir()
+        (d1 / "test.html").write_text("d1")
+        (d2 / "test.html").write_text("d2")
+        return d1, d2
+
+    def test_cache_init(self, tmp_templates):
+        d1, d2 = tmp_templates
+        loader = FileSystemLoader([str(d1), str(d2)], path_cache_size=10)
+        assert loader.path_cache_size == 10
+
+    def test_cache_disabled_by_default(self, tmp_templates):
+        d1, d2 = tmp_templates
+        loader = FileSystemLoader([str(d1), str(d2)])
+        assert loader.path_cache_size == 0
+
+    def test_cache_priority(self, tmp_templates):
+        d1, d2 = tmp_templates
+        loader = FileSystemLoader([str(d1), str(d2)], path_cache_size=10)
+        
+        # First load, should be from d1
+        _, filename, _ = loader.get_source(None, "test.html")
+        assert filename == str(d1 / "test.html")
+        
+        # Remove d1/test.html, should be from d2
+        (d1 / "test.html").unlink()
+        
+        # Should re-resolve
+        _, filename, _ = loader.get_source(None, "test.html")
+        assert filename == str(d2 / "test.html")
+
+    def test_cache_eviction(self, tmp_templates):
+        d1, _ = tmp_templates
+        loader = FileSystemLoader([str(d1)], path_cache_size=1)
+        
+        # Fill cache
+        loader.get_source(None, "test.html")
+        assert len(loader._path_cache) == 1
+        
+        # Add another template
+        (d1 / "other.html").write_text("other")
+        loader.get_source(None, "other.html")
+        
+        assert len(loader._path_cache) == 1
+        assert "other.html" in loader._path_cache
+        assert "test.html" not in loader._path_cache
+
+    def test_resize_cache(self, tmp_templates):
+        d1, _ = tmp_templates
+        loader = FileSystemLoader([str(d1)], path_cache_size=2)
+        (d1 / "a.html").write_text("a")
+        (d1 / "b.html").write_text("b")
+        
+        loader.get_source(None, "a.html")
+        loader.get_source(None, "b.html")
+        assert len(loader._path_cache) == 2
+        
+        loader.resize_path_cache(1)
+        assert len(loader._path_cache) == 1
+        
+        loader.resize_path_cache(0)
+        assert len(loader._path_cache) == 0
