@@ -0,0 +1,54 @@
+import re
+from typing import Any, Pattern, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+__all__ = 'IsRegex',
+
+class IsRegex(DirtyEquals[str]):
+    """
+    Checks if the value is a string and matches the given regular expression.
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, Pattern[str]],
+        flags: int = 0,
+        *,
+        mode: str = 'match',
+    ):
+        """
+        Args:
+            pattern: The regular expression pattern (string or compiled).
+            flags: Optional flags for the regular expression.
+            mode: The matching mode: 'match', 'search', or 'fullmatch'.
+        """
+        if mode not in ('match', 'search', 'fullmatch'):
+            raise ValueError(f"Invalid mode: {mode!r}. Must be 'match', 'search', or 'fullmatch'.")
+
+        if isinstance(pattern, re.Pattern):
+            if flags != 0:
+                raise ValueError("Cannot pass flags when pattern is already compiled.")
+            self.pattern = pattern
+            self.flags = pattern.flags
+        else:
+            self.pattern = re.compile(pattern, flags)
+            self.flags = flags
+
+        self.mode = mode
+        
+        repr_kwargs = {}
+        if mode != 'match':
+            repr_kwargs['mode'] = mode
+        if flags != 0:
+            repr_kwargs['flags'] = plain_repr(repr(re.RegexFlag(flags)))
+            
+        super().__init__(pattern, **repr_kwargs)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        func = getattr(re, self.mode)
+        return bool(func(self.pattern, other))
diff --git a/tests/test_regex.py b/tests/test_regex.py
new file mode 100644
index 0000000..525f337
--- /dev/null
+++ b/tests/test_regex.py
@@ -0,0 +1,43 @@
+import re
+import pytest
+from dirty_equals import IsRegex
+
+def test_is_regex_match():
+    assert 'foobar' == IsRegex('foo')
+    assert 'foobar' == IsRegex('foo.*')
+    assert 'foobar' != IsRegex('bar$')
+    assert 123 != IsRegex('foo')
+
+def test_is_regex_search():
+    assert 'foobar' == IsRegex('oob', mode='search')
+    assert 'foobar' != IsRegex('oob', mode='match')
+
+def test_is_regex_fullmatch():
+    assert 'foobar' == IsRegex('foobar', mode='fullmatch')
+    assert 'foobar' != IsRegex('foo', mode='fullmatch')
+
+def test_is_regex_flags():
+    assert 'FOOBAR' == IsRegex('foobar', flags=re.IGNORECASE)
+    assert 'FOOBAR' != IsRegex('foobar')
+
+def test_is_regex_compiled():
+    pattern = re.compile('foo')
+    assert 'foobar' == IsRegex(pattern)
+    with pytest.raises(ValueError, match="Cannot pass flags when pattern is already compiled."):
+        IsRegex(pattern, flags=re.IGNORECASE)
+
+def test_is_regex_invalid_mode():
+    with pytest.raises(ValueError, match="Invalid mode"):
+        IsRegex('foo', mode='invalid')
+
+def test_is_regex_invalid_pattern():
+    with pytest.raises(re.error):
+        IsRegex('(')
+
+def test_is_regex_repr():
+    assert repr(IsRegex('foo')) == "IsRegex('foo')"
+    assert repr(IsRegex('foo', mode='search')) == "IsRegex('foo', mode='search')"
+    # The repr of flags might vary depending on python version, let's check it
+    r = repr(IsRegex('foo', flags=re.IGNORECASE))
+    assert "IsRegex('foo', flags=" in r
+    assert "IGNORECASE" in r
