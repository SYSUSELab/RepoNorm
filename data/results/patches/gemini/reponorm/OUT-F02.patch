diff --git a/tests/backends/test_xgrammar_caching.py b/tests/backends/test_xgrammar_caching.py
new file mode 100644
index 0000000..3cf35a1
--- /dev/null
+++ b/tests/backends/test_xgrammar_caching.py
@@ -0,0 +1,55 @@
+import pytest
+from unittest.mock import MagicMock, patch
+import sys
+
+# Mock xgrammar before importing XGrammarBackend
+mock_xgr = MagicMock()
+sys.modules["xgrammar"] = mock_xgr
+sys.modules["xgrammar.contrib"] = MagicMock()
+sys.modules["xgrammar.contrib.hf"] = MagicMock()
+
+from outlines.backends.xgrammar import XGrammarBackend
+
+@patch("transformers.AutoConfig.from_pretrained")
+def test_xgrammar_caching_enabled(mock_config):
+    mock_config.return_value.vocab_size = 100
+    model = MagicMock()
+    from outlines.models.transformers import Transformers
+    model.__class__ = Transformers
+    model.model.config._name_or_path = "test-model"
+    model.hf_tokenizer = MagicMock()
+    
+    # Reset mock_xgr.GrammarCompiler
+    mock_xgr.GrammarCompiler = MagicMock()
+    
+    backend = XGrammarBackend(model, cache_compiled_grammars=True)
+    
+    # First call
+    backend.get_json_schema_logits_processor("schema1")
+    # Second call
+    backend.get_json_schema_logits_processor("schema1")
+    
+    assert mock_xgr.GrammarCompiler.return_value.compile_json_schema.call_count == 1
+
+@patch("transformers.AutoConfig.from_pretrained")
+def test_xgrammar_caching_limit(mock_config):
+    mock_config.return_value.vocab_size = 100
+    model = MagicMock()
+    from outlines.models.transformers import Transformers
+    model.__class__ = Transformers
+    model.model.config._name_or_path = "test-model"
+    model.hf_tokenizer = MagicMock()
+    
+    # Reset mock_xgr.GrammarCompiler
+    mock_xgr.GrammarCompiler = MagicMock()
+    
+    backend = XGrammarBackend(model, cache_compiled_grammars=True, max_cached_grammars=1)
+    
+    # First call
+    backend.get_json_schema_logits_processor("schema1")
+    # Second call
+    backend.get_json_schema_logits_processor("schema2")
+    # Third call
+    backend.get_json_schema_logits_processor("schema1")
+    
+    assert mock_xgr.GrammarCompiler.return_value.compile_json_schema.call_count == 3
