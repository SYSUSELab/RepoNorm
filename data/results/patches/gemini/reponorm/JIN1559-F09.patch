new file mode 100644
index 0000000..c523e77
--- /dev/null
+++ b/tests/test_translation_extractor.py
@@ -0,0 +1,13 @@
+from jinja2.exceptions import TemplateSyntaxError
+import pytest
+from jinja2 import Environment, DictLoader
+from jinja2.ext import TranslationExtractorExtension
+
+    print(f"DEBUG: Environment: {Environment}")
+def test_invalid_metadata():
+    env = Environment(extensions=[TranslationExtractorExtension])
+    template = '{% extract key=dynamic_var %}{% endextract %}'
+    # Print tokens
+    print(f"DEBUG: tokens: {list(env.lex(template))}")
+    with pytest.raises(TemplateSyntaxError):
+        env.extract_marked_translations(template)
