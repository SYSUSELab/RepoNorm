diff --git a/src/jinja2/ext.py b/src/jinja2/ext.py
index d21b83a..00e6c31 100644
--- a/src/jinja2/ext.py
+++ b/src/jinja2/ext.py
@@ -852,3 +852,38 @@ i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+
+class TranslationExtractorExtension(Extension):
+    tags = {"extract"}
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        print("DEBUG: TranslationExtractorExtension.parse called")
+        lineno = next(parser.stream).lineno
+        metadata = {}
+        while parser.stream.current.type != "block_end":
+            key = parser.stream.expect("name").value
+            parser.stream.expect("assign")
+            value = parser.parse_expression()
+            if not isinstance(value, nodes.Const):
+                parser.fail(f"Metadata value for {key!r} must be a constant.", value.lineno)
+            metadata[key] = value.value
+            if parser.stream.current.type == "comma":
+                next(parser.stream)
+        body = parser.parse_statements(("name:endextract",), drop_needle=True)
+        return nodes.CallBlock(
+            self.call_method("_render_extract", [nodes.Const(metadata), nodes.Const(lineno)]),
+            [], [], body,
+        ).set_lineno(lineno)
+    def _render_extract(self, metadata: t.Dict[str, t.Any], lineno: int, caller: t.Callable) -> str:
+        return caller()
+
+def extract_from_ast(ast: nodes.Template, gettext_functions: t.Sequence[str] = ("_", "gettext", "ngettext", "pgettext", "npgettext"), babel_style: bool = True) -> t.Iterator[t.Tuple[int, str, t.Union[t.Optional[str], t.Tuple[t.Optional[str], ...]]]]:
+    for node in ast.find_all(nodes.Call):
+        if not isinstance(node.node, nodes.Name) or node.node.name not in gettext_functions: continue
+        strings: t.List[t.Optional[str]] = []
+        for arg in node.args:
+            if isinstance(arg, nodes.Const) and isinstance(arg.value, str): strings.append(arg.value)
+            else: strings.append(None)
+        if not strings: out = None
+        elif len(strings) == 1: out = strings[0]
+        else: out = tuple(strings)
+        yield node.lineno, node.node.name, out
