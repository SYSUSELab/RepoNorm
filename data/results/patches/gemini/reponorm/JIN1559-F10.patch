--- /dev/null
+++ b/tests/test_i18n_versions.py
@@ -0,0 +1,53 @@
+import pytest
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_i18n_version_tracking():
+    env = Environment(extensions=[InternationalizationExtension])
+    i18n = env.extensions[InternationalizationExtension.identifier]
+    
+    # Test set and get
+    i18n.set_translation_version("hello", "1.0")
+    assert i18n.get_translation_version("hello") == "1.0"
+    assert i18n.get_translation_version("world") is None
+    
+    # Test comparison
+    i18n.set_translation_version("world", "1.0")
+    assert i18n.compare_translation_versions("hello", "world") is True
+    i18n.set_translation_version("world", "2.0")
+    assert i18n.compare_translation_versions("hello", "world") is False
+    
+    # Test missing
+    assert i18n.compare_translation_versions("hello", "missing") is False
+    
+    # Test remove
+    i18n.remove_translation_version("hello")
+    assert i18n.get_translation_version("hello") is None
+    
+    # Test clear
+    i18n.set_translation_version("a", "1")
+    i18n.set_translation_version("b", "1")
+    i18n.clear_translation_versions()
+    assert i18n.get_translation_version("a") is None
+    assert i18n.get_translation_version("b") is None
+
+def test_i18n_version_overlay():
+    env = Environment(extensions=[InternationalizationExtension])
+    i18n = env.extensions[InternationalizationExtension.identifier]
+    i18n.set_translation_version("hello", "1.0")
+    
+    overlay = env.overlay()
+    i18n_overlay = overlay.extensions[InternationalizationExtension.identifier]
+    
+    assert i18n_overlay.get_translation_version("hello") == "1.0"
+    
+    i18n_overlay.set_translation_version("hello", "2.0")
+    assert i18n.get_translation_version("hello") == "1.0"
+    assert i18n_overlay.get_translation_version("hello") == "2.0"
+    
+    i18n_overlay.set_translation_version("world", "1.0")
+    assert i18n.get_translation_version("world") is None
+    
+    i18n_overlay.remove_translation_version("hello")
+    assert i18n.get_translation_version("hello") == "1.0"
+    assert i18n_overlay.get_translation_version("hello") is None
