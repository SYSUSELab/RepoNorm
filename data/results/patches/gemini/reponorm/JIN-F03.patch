diff --git a/tests/test_attribute_separator.py b/tests/test_attribute_separator.py
new file mode 100644
index 0000000..7c9539d
--- /dev/null
+++ b/tests/test_attribute_separator.py
@@ -0,0 +1,41 @@
+import pytest
+from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
+
+def test_groupby_custom_separator():
+    env = Environment()
+    users = [
+        {'a.b': 1, 'name': 'u1'},
+        {'a.b': 2, 'name': 'u2'},
+    ]
+    
+    # Test with custom separator
+    result = env.from_string(
+        "{% for key, items in users|groupby('a.b', separator='__') %}"
+        "{{ key }}: {{ items|map(attribute='name')|join(',') }}\n"
+        "{% endfor %}"
+    ).render(users=users)
+    assert "1: u1" in result
+    assert "2: u2" in result
+
+def test_map_custom_separator():
+    env = Environment()
+    users = [
+        {'a.b': 1, 'name': 'u1'},
+        {'a.b': 2, 'name': 'u2'},
+    ]
+    
+    # Test with custom separator
+    result = env.from_string(
+        "{{ users|map(attribute='a.b', separator='__')|join(',') }}"
+    ).render(users=users)
+    assert result == "1,2"
+
+def test_empty_separator():
+    env = Environment()
+    users = [{'a': 1}]
+    with pytest.raises(FilterArgumentError):
+        env.from_string("{{ users|map(attribute='a', separator='')|list }}").render(users=users)
+
+if __name__ == "__main__":
+    pytest.main([__file__])
