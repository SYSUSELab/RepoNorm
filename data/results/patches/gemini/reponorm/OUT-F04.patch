diff --git a/tests/backends/test_xgrammar_batch_limit.py b/tests/backends/test_xgrammar_batch_limit.py
new file mode 100644
index 0000000..b28ca1f
--- /dev/null
+++ b/tests/backends/test_xgrammar_batch_limit.py
@@ -0,0 +1,65 @@
+import pytest
+import torch
+from unittest.mock import MagicMock, patch
+from outlines.backends.xgrammar import XGrammarLogitsProcessor, XGrammarBackend
+from outlines.models.transformers import Transformers
+
+def test_xgrammar_batch_limit_validation():
+    # Test valid inputs
+    XGrammarLogitsProcessor("compiled_grammar", max_batch_size=None)
+    XGrammarLogitsProcessor("compiled_grammar", max_batch_size=0)
+    XGrammarLogitsProcessor("compiled_grammar", max_batch_size=1)
+    
+    # Test invalid inputs
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor("compiled_grammar", max_batch_size=-1)
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor("compiled_grammar", max_batch_size=True) # type: ignore
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor("compiled_grammar", max_batch_size="1") # type: ignore
+
+def test_xgrammar_batch_limit_enforcement():
+    processor = XGrammarLogitsProcessor("compiled_grammar", max_batch_size=1)
+    
+    # Mock the xgrammar_logits_processor
+    class MockXGRProcessor:
+        def __call__(self, input_ids, logits):
+            return logits
+    
+    processor.xgrammar_logits_processor = MockXGRProcessor()
+    
+    # Batch size 2 should fail
+    input_ids = torch.zeros((2, 10), dtype=torch.long)
+    logits = torch.zeros((2, 100), dtype=torch.float)
+    
+    with pytest.raises(ValueError, match="Batch size 2 exceeds maximum allowed batch size 1"):
+        processor(input_ids, logits)
+
+    # Batch size 1 should pass
+    input_ids = torch.zeros((1, 10), dtype=torch.long)
+    logits = torch.zeros((1, 100), dtype=torch.float)
+    processor(input_ids, logits)
+
+def test_xgrammar_reset_preserves_limit():
+    processor = XGrammarLogitsProcessor("compiled_grammar", max_batch_size=1)
+    assert processor.max_batch_size == 1
+    processor.reset()
+    assert processor.max_batch_size == 1
+
+def test_xgrammar_backend_max_batch_size():
+    mock_model = MagicMock(spec=Transformers)
+    mock_model.model = MagicMock()
+    mock_model.model.config = MagicMock()
+    mock_model.model.config._name_or_path = "test"
+    mock_model.hf_tokenizer = MagicMock()
+    
+    with patch("xgrammar.TokenizerInfo.from_huggingface"),          patch("xgrammar.GrammarCompiler"),          patch("transformers.AutoConfig.from_pretrained") as mock_config:
+        mock_config.return_value.vocab_size = 100
+        
+        # Test valid
+        backend = XGrammarBackend(mock_model, max_batch_size=10)
+        assert backend.max_batch_size == 10
+        
+        # Test invalid
+        with pytest.raises(ValueError):
+            XGrammarBackend(mock_model, max_batch_size=-1)
