diff --git a/tests/test_batch_option.py b/tests/test_batch_option.py
new file mode 100644
index 0000000..e53d2bd
--- /dev/null
+++ b/tests/test_batch_option.py
@@ -0,0 +1,39 @@
+import click
+from click.testing import CliRunner
+import pytest
+
+def test_batch_size_basic():
+    @click.command()
+    @click.option("--foo", multiple=True, batch_size=2)
+    def cli(foo):
+        click.echo(repr(foo))
+
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--foo", "a", "--foo", "b", "--foo", "c", "--foo", "d"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "(('a', 'b'), ('c', 'd'))"
+
+    result = runner.invoke(cli, ["--foo", "a", "--foo", "b", "--foo", "c"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "(('a', 'b'), ('c',))"
+
+def test_batch_size_invalid_type():
+    with pytest.raises(TypeError, match='batch_size must be an integer.'):
+        @click.command()
+        @click.option("--foo", multiple=True, batch_size="2")
+        def cli(foo):
+            pass
+
+def test_batch_size_invalid_value():
+    with pytest.raises(ValueError, match='batch_size must be a positive integer.'):
+        @click.command()
+        @click.option("--foo", multiple=True, batch_size=0)
+        def cli(foo):
+            pass
+
+def test_batch_size_without_multiple():
+    with pytest.raises(TypeError, match='batch_size is only valid with multiple=True.'):
+        @click.command()
+        @click.option("--foo", batch_size=2)
+        def cli(foo):
+            pass
