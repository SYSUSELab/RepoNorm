diff --git a/tests/test_builtin_filters.py b/tests/test_builtin_filters.py
new file mode 100644
index 0000000..36d6f0b
--- /dev/null
+++ b/tests/test_builtin_filters.py
@@ -0,0 +1,51 @@
+import pytest
+from outlines.prompts import Prompt, prompt
+import os
+from pathlib import Path
+
+def test_builtin_filters():
+    # Test string filters
+    p = Prompt.from_str("{{ 'hello' | upper }}", builtin_filters=["string"])
+    assert p() == "HELLO"
+
+    # Test math filters
+    p = Prompt.from_str("{{ 1 | add(2) }}", builtin_filters=["math"])
+    assert p() == "3"
+
+    # Test format filters
+    p = Prompt.from_str("{{ {'a': 1} | json }}", builtin_filters=["format"])
+    assert p() == '{"a": 1}'
+
+    # Test multiple categories
+    p = Prompt.from_str("{{ 'hello' | upper }} {{ 1 | add(2) }}", builtin_filters=["string", "math"])
+    assert p() == "HELLO 3"
+
+    # Test unknown category
+    with pytest.raises(ValueError, match="Unknown builtin filter category: unknown"):
+        Prompt.from_str("{{ 'hello' }}", builtin_filters=["unknown"])
+
+    # Test decorator
+    @prompt(builtin_filters=["string"])
+    def my_prompt():
+        "{{ 'hello' | upper }}"
+    assert my_prompt() == "HELLO"
+
+    # Test decorator with no filters
+    @prompt
+    def my_prompt2():
+        "{{ 'hello' }}"
+    assert my_prompt2() == "hello"
+
+    # Test decorator with empty list
+    @prompt(builtin_filters=[])
+    def my_prompt3():
+        "{{ 'hello' }}"
+    assert my_prompt3() == "hello"
+
+def test_from_file_builtin_filters():
+    with open("test.jinja", "w") as f:
+        f.write("{{ 'hello' | upper }}")
+
+    p = Prompt.from_file(Path("test.jinja"), builtin_filters=["string"])
+    assert p() == "HELLO"
+    os.remove("test.jinja")
