@@ -0,0 +1,74 @@
+import json
+import csv
+import io
+import textwrap
+import html
+from typing import Any, Callable, Dict
+
+def upper(s: Any) -> str: return str(s).upper()
+def lower(s: Any) -> str: return str(s).lower()
+def title(s: Any) -> str: return str(s).title()
+def reverse(s: Any) -> str: return str(s)[::-1]
+def truncate(value: Any, length: int, end: str = "...") -> str:
+    if length < 0: raise ValueError("Length cannot be negative")
+    s = str(value)
+    if len(s) <= length: return s
+    return s[:length - len(end)] + end
+def pad_left(value: Any, width: int, fill: str = " ") -> str:
+    if len(fill) != 1: raise ValueError("Fill must be one character")
+    return str(value).rjust(width, fill)
+def pad_right(value: Any, width: int, fill: str = " ") -> str:
+    if len(fill) != 1: raise ValueError("Fill must be one character")
+    return str(value).ljust(width, fill)
+
+def add(a: float, b: float) -> float: return a + b
+def subtract(a: float, b: float) -> float: return a - b
+def multiply(a: float, b: float) -> float: return a * b
+def divide(a: float, b: float) -> float: return a / b
+def round_val(value: float, ndigits: int = None) -> float: return round(value, ndigits)
+def abs_val(value: float) -> float: return abs(value)
+def min_val(value: float, *others: float) -> float: return min(value, *others)
+def max_val(value: float, *others: float) -> float: return max(value, *others)
+
+def json_filter(value: Any) -> str: return json.dumps(value)
+def csv_filter(value: Any) -> str:
+    output = io.StringIO()
+    writer = csv.writer(output, quoting=csv.QUOTE_MINIMAL)
+    writer.writerow(value if isinstance(value, (list, tuple)) else [value])
+    return output.getvalue().strip()
+def indent(value: Any, width: int = 4) -> str:
+    return textwrap.indent(str(value), " " * width, predicate=lambda line: line.strip() != "")
+def wrap(value: Any, width: int = 70) -> str:
+    return textwrap.fill(str(value), width=width)
+def escape(value: Any) -> str: return html.escape(str(value), quote=True)
+def unescape(value: Any) -> str: return html.unescape(str(value))
+
+BUILTIN_FILTERS = {
+    "string": {
+        "upper": upper,
+        "lower": lower,
+        "title": title,
+        "reverse": reverse,
+        "truncate": truncate,
+        "pad_left": pad_left,
+        "pad_right": pad_right,
+    },
+    "math": {
+        "add": add,
+        "subtract": subtract,
+        "multiply": multiply,
+        "divide": divide,
+        "round": round_val,
+        "abs": abs_val,
+        "min": min_val,
+        "max": max_val,
+    },
+    "format": {
+        "json": json_filter,
+        "csv": csv_filter,
+        "indent": indent,
+        "wrap": wrap,
+        "escape": escape,
+        "unescape": unescape,
+    }
+}
