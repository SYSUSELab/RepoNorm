diff --git a/tests/clients/test_cache_compression.py b/tests/clients/test_cache_compression.py
new file mode 100644
index 00000000..1c6fe28c
--- /dev/null
+++ b/tests/clients/test_cache_compression.py
@@ -0,0 +1,55 @@
+import pytest
+import os
+import shutil
+import tempfile
+from dspy.clients.cache import Cache
+
+def test_cache_compression():
+    cache_dir = tempfile.mkdtemp()
+    try:
+        # Test gzip
+        cache = Cache(enable_disk_cache=True, enable_memory_cache=False, disk_cache_dir=cache_dir, compress="gzip")
+        data = {"a": 1, "b": [1, 2, 3]}
+        cache.put({"req": 1}, data)
+        
+        # Verify it's compressed
+        assert cache.disk_cache.get(cache.cache_key({"req": 1})).startswith(b"DSPC\x01")
+        assert cache.get({"req": 1}) == data
+        
+        # Test zlib
+        cache.set_compression("zlib")
+        cache.put({"req": 2}, data)
+        assert cache.disk_cache.get(cache.cache_key({"req": 2})).startswith(b"DSPC\x02")
+        assert cache.get({"req": 2}) == data
+        
+        # Test None
+        cache.set_compression(None)
+        cache.put({"req": 3}, data)
+        # Should not have header
+        # When compress is None, _serialize returns the value directly, so it's not bytes.
+        # The disk cache stores it as is.
+        assert not isinstance(cache.disk_cache.get(cache.cache_key({"req": 3})), bytes)
+        assert cache.get({"req": 3}) == data
+        
+        # Test invalid
+        with pytest.raises(ValueError):
+            cache.set_compression("invalid")
+            
+    finally:
+        shutil.rmtree(cache_dir)
+
+def test_cache_backward_compatibility():
+    cache_dir = tempfile.mkdtemp()
+    try:
+        cache = Cache(enable_disk_cache=True, enable_memory_cache=False, disk_cache_dir=cache_dir)
+        data = {"a": 1}
+        
+        # Manually put uncompressed data
+        key = cache.cache_key({"req": 1})
+        cache.disk_cache[key] = data
+        
+        # Should be readable
+        assert cache.get({"req": 1}) == data
+        
+    finally:
+        shutil.rmtree(cache_dir)
