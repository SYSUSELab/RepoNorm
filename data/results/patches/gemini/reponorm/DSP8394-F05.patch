new file mode 100644
index 00000000..6df160ce
--- /dev/null
+++ b/tests/clients/test_cache_cull.py
@@ -0,0 +1,22 @@
+import pytest
+import shutil
+import tempfile
+from dspy.clients.cache import Cache
+
+def test_cache_cull_and_eviction():
+    cache_dir = tempfile.mkdtemp()
+    try:
+        # Test cull_limit and eviction_policy
+        cache = Cache(
+            enable_disk_cache=True, 
+            enable_memory_cache=False, 
+            disk_cache_dir=cache_dir, 
+            cull_limit=10, 
+            eviction_policy="least-recently-used"
+        )
+        
+        assert cache.disk_cache.cull_limit == 10
+        assert cache.disk_cache.eviction_policy == "least-recently-used"
+        
+    finally:
+        shutil.rmtree(cache_dir)
