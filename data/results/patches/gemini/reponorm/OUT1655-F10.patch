+++ b/tests/types/test_sha256.py
@@ -0,0 +1,27 @@
+from outlines.types import hash_sha256
+from pydantic import BaseModel
+
+def test_sha256_type():
+    # Test regex matching
+    assert hash_sha256.matches("a" * 64)
+    assert hash_sha256.matches("A" * 64)
+    assert not hash_sha256.matches("a" * 63)
+    assert not hash_sha256.matches("a" * 65)
+    assert not hash_sha256.matches("g" * 64)
+
+    # Test Pydantic integration
+    class Model(BaseModel):
+        h: hash_sha256
+
+    # This should work
+    m = Model(h="a" * 64)
+    assert m.h == "a" * 64
+
+    # This should fail
+    try:
+        Model(h="a" * 63)
+    except ValueError:
+        pass
+    else:
+        assert False, "Should have raised ValueError"
+
