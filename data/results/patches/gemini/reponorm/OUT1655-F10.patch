diff --git a/test_sha256.py b/test_sha256.py
new file mode 100644
index 0000000..e087fdf
--- /dev/null
+++ b/test_sha256.py
@@ -0,0 +1,31 @@
+import re
+from outlines.types import Regex
+
+def test_sha256_regex():
+    pattern = r"[a-fA-F0-9]{64}"
+    regex = Regex(pattern)
+    
+    # Valid cases
+    valid_hash = "a" * 64
+    assert regex.matches(valid_hash)
+    
+    valid_hash_upper = "A" * 64
+    assert regex.matches(valid_hash_upper)
+    
+    valid_hash_mixed = "a" * 32 + "A" * 32
+    assert regex.matches(valid_hash_mixed)
+    
+    # Invalid cases
+    invalid_short = "a" * 63
+    assert not regex.matches(invalid_short)
+    
+    invalid_long = "a" * 65
+    assert not regex.matches(invalid_long)
+    
+    invalid_chars = "g" * 64
+    assert not regex.matches(invalid_chars)
+    
+    print("Tests passed!")
+
+if __name__ == "__main__":
+    test_sha256_regex()
diff --git a/tests/types/test_sha256.py b/tests/types/test_sha256.py
