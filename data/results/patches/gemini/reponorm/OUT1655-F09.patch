+from outlines.types import guid
+import pytest
+
+def test_guid_matches():
+    assert guid.matches("{12345678-1234-1234-1234-1234567890AB}")
+    assert guid.matches("{12345678-1234-1234-1234-1234567890ab}")
+    assert guid.matches("{12345678-1234-1234-1234-1234567890Ab}")
+
+def test_guid_no_matches():
+    assert not guid.matches("12345678-1234-1234-1234-1234567890AB")
+    assert not guid.matches("{12345678-1234-1234-1234-1234567890A}")
+    assert not guid.matches("{12345678-1234-1234-1234-1234567890ABC}")
+    assert not guid.matches(" {12345678-1234-1234-1234-1234567890AB}")
+    assert not guid.matches("{12345678-1234-1234-1234-1234567890AB} ")
