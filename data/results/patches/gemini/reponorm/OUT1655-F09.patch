+import re
+from outlines.types import Regex
+
+# Braced GUID: {8-4-4-4-12} hex
+# Example: {12345678-1234-1234-1234-1234567890AB}
+guid_pattern = r"\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}"
+guid = Regex(guid_pattern)
+
+def test_guid():
+    valid_guid = "{12345678-1234-1234-1234-1234567890AB}"
+    assert guid.matches(valid_guid)
+    
+    invalid_guid_no_braces = "12345678-1234-1234-1234-1234567890AB"
+    assert not guid.matches(invalid_guid_no_braces)
+    
+    invalid_guid_wrong_length = "{1234567-1234-1234-1234-1234567890AB}"
+    assert not guid.matches(invalid_guid_wrong_length)
+    
+    invalid_guid_whitespace = " {12345678-1234-1234-1234-1234567890AB}"
+    assert not guid.matches(invalid_guid_whitespace)
+
+test_guid()
+print("Test passed")
