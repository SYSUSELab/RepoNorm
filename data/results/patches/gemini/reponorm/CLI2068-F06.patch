+
+import pytest
+import click
+import subprocess
+from unittest.mock import MagicMock
+
+def test_edit_process_priority_validation():
+    with pytest.raises(ValueError, match="Invalid process priority: invalid"):
+        click.edit("test", process_priority="invalid")
+
+def test_edit_process_priority_valid(monkeypatch):
+    mock_popen = MagicMock()
+    mock_popen.return_value.wait.return_value = 0
+    monkeypatch.setattr(subprocess, "Popen", mock_popen)
+    
+    # We need to mock the editor to avoid it trying to run 'vi'
+    monkeypatch.setattr(click._termui_impl.Editor, "get_editor", lambda self: "my-editor")
+    
+    click.edit("test", process_priority="low")
+    
+    # Check if Popen was called with the expected command
+    # The command should be 'nice -n 19 my-editor "/tmp/editor-..." 2>/dev/null'
+    args, kwargs = mock_popen.call_args
+    cmd = args[0]
+    assert "nice -n 19" in cmd
+    assert "my-editor" in cmd
