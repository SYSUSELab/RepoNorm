diff --git a/tests/test_context_exit_callback.py b/tests/test_context_exit_callback.py
new file mode 100644
index 0000000..b827ac5
--- /dev/null
+++ b/tests/test_context_exit_callback.py
@@ -0,0 +1,86 @@
+import click
+import pytest
+
+def test_exit_callback():
+    exit_called = False
+    def on_exit(ctx):
+        nonlocal exit_called
+        exit_called = True
+        assert ctx.command.name == 'test'
+
+    @click.command()
+    @click.pass_context
+    def test(ctx):
+        pass
+
+    ctx = click.Context(test, on_exit=on_exit)
+    with ctx:
+        assert not exit_called
+    assert exit_called
+
+def test_exit_callback_nested():
+    exit_calls = []
+    def on_exit_outer(ctx):
+        exit_calls.append('outer')
+    def on_exit_inner(ctx):
+        exit_calls.append('inner')
+
+    @click.command()
+    @click.pass_context
+    def test(ctx):
+        pass
+
+    ctx_outer = click.Context(test, on_exit=on_exit_outer)
+    with ctx_outer:
+        ctx_inner = click.Context(test, parent=ctx_outer, on_exit=on_exit_inner)
+        with ctx_inner:
+            pass
+        assert exit_calls == ['inner']
+    assert exit_calls == ['inner', 'outer']
+
+def test_exit_callback_exception():
+    def on_exit(ctx):
+        raise ValueError("Should be ignored")
+
+    @click.command()
+    def test():
+        pass
+
+    ctx = click.Context(test, on_exit=on_exit)
+    with ctx:
+        pass
+    # Should not raise
+
+def test_exit_callback_scope_cleanup_false():
+    exit_called = False
+    def on_exit(ctx):
+        nonlocal exit_called
+        exit_called = True
+
+    @click.command()
+    def test():
+        pass
+
+    ctx = click.Context(test, on_exit=on_exit)
+    with ctx.scope(cleanup=False):
+        pass
+    assert not exit_called
+
+def test_exit_callback_ctx_exit():
+    exit_called = False
+    def on_exit(ctx):
+        nonlocal exit_called
+        exit_called = True
+
+    @click.command()
+    @click.pass_context
+    def test(ctx):
+        ctx.exit()
+
+    ctx = click.Context(test, on_exit=on_exit)
+    try:
+        with ctx:
+            test.invoke(ctx)
+    except click.exceptions.Exit:
+        pass
+    assert exit_called
