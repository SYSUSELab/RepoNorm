diff --git a/tests/test_validators.py b/tests/test_validators.py
new file mode 100644
index 0000000..47e164f
--- /dev/null
+++ b/tests/test_validators.py
@@ -0,0 +1,67 @@
+import click
+from click.testing import CliRunner
+import pytest
+
+def test_validators():
+    def validator1(ctx, param, value):
+        return value + 1
+
+    def validator2(ctx, param, value):
+        return value * 2
+
+    @click.command()
+    @click.option("--val", type=int, validators=[validator1, validator2])
+    def cli(val):
+        click.echo(val)
+
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--val", "10"])
+    assert result.exit_code == 0
+    # (10 + 1) * 2 = 22
+    assert result.output.strip() == "22"
+
+def test_validators_invalid_type():
+    with pytest.raises(TypeError):
+        @click.command()
+        @click.option("--val", validators="not-a-callable")
+        def cli(val):
+            pass
+
+def test_validators_invalid_list_content():
+    with pytest.raises(TypeError):
+        @click.command()
+        @click.option("--val", validators=[lambda c, p, v: v, "not-a-callable"])
+        def cli(val):
+            pass
+
+def test_validators_none_or_empty():
+    @click.command()
+    @click.option("--val", type=int, validators=None)
+    def cli1(val):
+        click.echo(val)
+
+    @click.command()
+    @click.option("--val", type=int, validators=[])
+    def cli2(val):
+        click.echo(val)
+
+    runner = CliRunner()
+    assert runner.invoke(cli1, ["--val", "10"]).output.strip() == "10"
+    assert runner.invoke(cli2, ["--val", "10"]).output.strip() == "10"
+
+
+def test_validators_bad_parameter():
+    def validator(ctx, param, value):
+        if value < 0:
+            raise click.BadParameter("Value must be positive")
+        return value
+
+    @click.command()
+    @click.option("--val", type=int, validators=[validator])
+    def cli(val):
+        click.echo(val)
+
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--val", "-1"])
+    assert result.exit_code != 0
+    assert "Value must be positive" in result.output
