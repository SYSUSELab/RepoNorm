diff --git a/tests/test_edit_multiple.py b/tests/test_edit_multiple.py
new file mode 100644
index 0000000..7ec455e
--- /dev/null
+++ b/tests/test_edit_multiple.py
@@ -0,0 +1,30 @@
+import pytest
+from unittest.mock import patch, MagicMock
+import click
+import os
+
+def test_edit_multiple_files():
+    with patch("subprocess.Popen") as mock_popen:
+        mock_process = MagicMock()
+        mock_process.wait.return_value = 0
+        mock_popen.return_value = mock_process
+        
+        # Test with multiple files
+        click.edit(filename=["file 1.txt", "file'2.txt"])
+        
+        # Verify that Popen was called with the correct arguments
+        args, kwargs = mock_popen.call_args
+        cmd = args[0]
+        
+        # Check that the command contains the quoted filenames
+        assert "'file 1.txt'" in cmd
+        assert "'file'\"'\"'2.txt'" in cmd
+        assert kwargs['shell'] is True
+
+def test_edit_empty_iterable():
+    with pytest.raises(ValueError, match="No files to edit"):
+        click.edit(filename=[])
+
+def test_edit_invalid_item():
+    with pytest.raises(TypeError, match="Filename must be a string"):
+        click.edit(filename=["file1.txt", 123])
