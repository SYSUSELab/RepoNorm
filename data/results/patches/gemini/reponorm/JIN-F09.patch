--- /dev/null
+++ b/tests/test_groupby_levels.py
@@ -0,0 +1,129 @@
+import pytest
+from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
+
+def test_groupby_levels_basic():
+    env = Environment(enable_async=True)
+    data = [
+        {'dept': 'A', 'role': 'dev', 'name': 'x'},
+        {'dept': 'A', 'role': 'dev', 'name': 'y'},
+        {'dept': 'A', 'role': 'qa', 'name': 'z'},
+        {'dept': 'B', 'role': 'dev', 'name': 'w'},
+    ]
+    
+    # Test hierarchical groupby
+    # groupby(['dept', 'role'], levels=2)
+    # Expected:
+    # [
+    #   ('A', [
+    #     ('dev', [{'dept': 'A', 'role': 'dev', 'name': 'x'}, {'dept': 'A', 'role': 'dev', 'name': 'y'}]),
+    #     ('qa', [{'dept': 'A', 'role': 'qa', 'name': 'z'}])
+    #   ]),
+    #   ('B', [
+    #     ('dev', [{'dept': 'B', 'role': 'dev', 'name': 'w'}])
+    #   ])
+    # ]
+    
+    # We need to check the structure.
+    # Since the result is a list of _GroupTuple, we can't easily compare it to a list of tuples.
+    # Let's convert it to a list of tuples for comparison.
+    
+    def to_tuple(item):
+        if isinstance(item, list):
+            return [to_tuple(i) for i in item]
+        if hasattr(item, 'grouper'):
+            return (item.grouper, to_tuple(item.list))
+        return item
+
+    result = env.from_string("{{ data|groupby(['dept', 'role'], levels=2) }}").render(data=data)
+    # The result is a string representation of the list of _GroupTuple.
+    # This is not what we want. We want to test the actual object structure.
+    # We can use a custom filter to return the object itself.
+    
+    env.filters['to_tuple'] = to_tuple
+    result = env.from_string("{{ data|groupby(['dept', 'role'], levels=2)|to_tuple }}").render(data=data)
+    
+    # The result is a string representation of the list of tuples.
+    # This is still not ideal. Let's use a test that runs in python.
+    
+    from jinja2.filters import sync_do_groupby
+    
+    # We need to pass the environment to sync_do_groupby
+    result = sync_do_groupby(env, data, ['dept', 'role'], levels=2)
+    
+    expected = [
+        ('A', [
+            ('dev', [{'dept': 'A', 'role': 'dev', 'name': 'x'}, {'dept': 'A', 'role': 'dev', 'name': 'y'}]),
+            ('qa', [{'dept': 'A', 'role': 'qa', 'name': 'z'}])
+        ]),
+        ('B', [
+            ('dev', [{'dept': 'B', 'role': 'dev', 'name': 'w'}])
+        ])
+    ]
+    
+    assert to_tuple(result) == expected
+
+def test_groupby_levels_validation():
+    env = Environment(enable_async=True)
+    
+    # Nonpositive levels
+    with pytest.raises(FilterArgumentError):
+        env.from_string("{{ data|groupby('a', levels=0) }}").render(data=[])
+        
+    # Mismatched attribute counts
+    with pytest.raises(FilterArgumentError):
+        env.from_string("{{ data|groupby(['a'], levels=2) }}").render(data=[])
+        
+    # Multiple attributes without levels
+    with pytest.raises(FilterArgumentError):
+        env.from_string("{{ data|groupby(['a', 'b']) }}").render(data=[])
+
+
+def test_groupby_levels_comma_separated():
+    from jinja2.filters import sync_do_groupby
+    from jinja2 import Environment
+    env = Environment(enable_async=True)
+    data = [
+        {'dept': 'A', 'role': 'dev', 'name': 'x'},
+    ]
+    
+    result = sync_do_groupby(env, data, "dept, role", levels=2)
+    
+    def to_tuple(item):
+        if isinstance(item, list):
+            return [to_tuple(i) for i in item]
+        if hasattr(item, 'grouper'):
+            return (item.grouper, to_tuple(item.list))
+        return item
+        
+    expected = [
+        ('A', [
+            ('dev', [{'dept': 'A', 'role': 'dev', 'name': 'x'}])
+        ])
+    ]
+    assert to_tuple(result) == expected
+
+def test_groupby_levels_async():
+    from jinja2.filters import do_groupby
+    from jinja2 import Environment
+    env = Environment(enable_async=True)
+    data = [
+        {'dept': 'A', 'role': 'dev', 'name': 'x'},
+    ]
+    
+    import asyncio
+    result = asyncio.run(do_groupby(env, data, "dept, role", levels=2))
+    
+    def to_tuple(item):
+        if isinstance(item, list):
+            return [to_tuple(i) for i in item]
+        if hasattr(item, 'grouper'):
+            return (item.grouper, to_tuple(item.list))
+        return item
+        
+    expected = [
+        ('A', [
+            ('dev', [{'dept': 'A', 'role': 'dev', 'name': 'x'}])
+        ])
+    ]
+    assert to_tuple(result) == expected
