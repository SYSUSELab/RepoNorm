diff --git a/dirty_equals/_hash.py b/dirty_equals/_hash.py
new file mode 100644
index 0000000..97d0860
--- /dev/null
+++ b/dirty_equals/_hash.py
@@ -0,0 +1,46 @@
+from typing import Any
+import re
+from ._base import DirtyEquals
+
+__all__ = 'IsHash',
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hash string of a specific algorithm.
+    """
+
+    _HASH_LENGTHS = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm to check (md5, sha1, sha224, sha256, sha384, sha512).
+        """
+        self.algorithm_name = algorithm
+        self.algorithm = algorithm.lower()
+        if self.algorithm not in self._HASH_LENGTHS:
+            raise ValueError(f'Unsupported hash algorithm: {algorithm}')
+        self.length = self._HASH_LENGTHS[self.algorithm]
+        super().__init__(algorithm=algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        if len(other) != self.length:
+            return False
+        
+        if not re.fullmatch(r'[0-9a-fA-F]+', other):
+            return False
+            
+        return True
+
+    def _repr_ne(self) -> str:
+        return f'IsHash({self.algorithm_name!r})'
diff --git a/tests/test_hash.py b/tests/test_hash.py
new file mode 100644
index 0000000..63697b0
--- /dev/null
+++ b/tests/test_hash.py
@@ -0,0 +1,21 @@
+import pytest
+from dirty_equals import IsHash
+
+def test_is_hash_md5():
+    assert '098f6bcd4621d373cade4e832627b4f6' == IsHash('md5')
+    assert '098F6BCD4621D373CADE4E832627B4F6' == IsHash('md5')
+    assert '098f6bcd4621d373cade4e832627b4f' != IsHash('md5')
+    assert '098f6bcd4621d373cade4e832627b4f6a' != IsHash('md5')
+    assert 123 != IsHash('md5')
+
+def test_is_hash_sha256():
+    assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == IsHash('SHA256')
+    assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == IsHash('sha256')
+
+def test_is_hash_invalid_algorithm():
+    with pytest.raises(ValueError, match='Unsupported hash algorithm: sha123'):
+        IsHash('sha123')
+
+def test_is_hash_repr():
+    assert repr(IsHash('md5')) == "IsHash('md5')"
+    assert repr(IsHash('SHA256')) == "IsHash('SHA256')"
