diff --git a/tests/propose/test_grounded_proposer_weights.py b/tests/propose/test_grounded_proposer_weights.py
new file mode 100644
index 00000000..4f1262b0
--- /dev/null
+++ b/tests/propose/test_grounded_proposer_weights.py
@@ -0,0 +1,50 @@
+import pytest
+import random
+from dspy.propose.grounded_proposer import GroundedProposer, TIPS
+
+def test_select_tip():
+    rng = random.Random(42)
+    
+    # Test weighted selection
+    tip_weights = {"none": 0, "creative": 100, "simple": 0}
+    proposer = GroundedProposer(
+        prompt_model=None, 
+        program=None, 
+        trainset=[], 
+        set_tip_randomly=True,
+        tip_weights=tip_weights,
+        rng=rng
+    )
+    
+    results = [proposer._select_tip() for _ in range(10)]
+    assert all(tip == "creative" for tip in results)
+    
+    # Test uniform selection with all zero weights
+    tip_weights = {"none": 0, "creative": 0, "simple": 0}
+    proposer = GroundedProposer(
+        prompt_model=None, 
+        program=None, 
+        trainset=[], 
+        set_tip_randomly=True,
+        tip_weights=tip_weights,
+        rng=rng
+    )
+    
+    results = [proposer._select_tip() for _ in range(100)]
+    assert len(set(results)) > 1
+    
+    # Test invalid weights
+    tip_weights = {"none": -1, "creative": "invalid"}
+    proposer = GroundedProposer(
+        prompt_model=None, 
+        program=None, 
+        trainset=[], 
+        set_tip_randomly=True,
+        tip_weights=tip_weights,
+        rng=rng
+    )
+    
+    # Should not raise error and should work
+    tip = proposer._select_tip()
+    assert tip in TIPS.keys()
+
