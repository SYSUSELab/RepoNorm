diff --git a/tests/test_groupby/test_groupby_reverse.py b/tests/test_groupby/test_groupby_reverse.py
new file mode 100644
index 0000000..82b6df8
--- /dev/null
+++ b/tests/test_groupby/test_groupby_reverse.py
@@ -0,0 +1,32 @@
+import pytest
+from jinja2 import Environment
+
+def test_groupby_reverse():
+    env = Environment()
+    tmpl = env.from_string(
+        """
+    {%- for grouper, list in [{'foo': 1, 'bar': 2},
+                              {'foo': 2, 'bar': 3},
+                              {'foo': 1, 'bar': 1},
+                              {'foo': 3, 'bar': 4}]|groupby('foo', reverse=True) -%}
+        {{ grouper }}{% for x in list %}: {{ x.foo }}, {{ x.bar }}{% endfor %}|
+    {%- endfor %}"""
+    )
+    # Expected order: 3, 2, 1
+    # 3: 3, 4
+    # 2: 2, 3
+    # 1: 1, 2: 1, 1
+    assert tmpl.render().split("|") == ["3: 3, 4", "2: 2, 3", "1: 1, 2: 1, 1", ""]
+
+def test_groupby_reverse_false():
+    env = Environment()
+    tmpl = env.from_string(
+        """
+    {%- for grouper, list in [{'foo': 1, 'bar': 2},
+                              {'foo': 2, 'bar': 3},
+                              {'foo': 1, 'bar': 1},
+                              {'foo': 3, 'bar': 4}]|groupby('foo', reverse=False) -%}
+        {{ grouper }}{% for x in list %}: {{ x.foo }}, {{ x.bar }}{% endfor %}|
+    {%- endfor %}"""
+    )
+    assert tmpl.render().split("|") == ["1: 1, 2: 1, 1", "2: 2, 3", "3: 3, 4", ""]
diff --git a/tests/test_groupby/test_groupby_reverse_async.py b/tests/test_groupby/test_groupby_reverse_async.py
new file mode 100644
index 0000000..ff259e8
--- /dev/null
+++ b/tests/test_groupby/test_groupby_reverse_async.py
@@ -0,0 +1,20 @@
+import asyncio
+import pytest
+from jinja2 import Environment
+
+def test_groupby_reverse_async():
+    env = Environment(enable_async=True)
+    tmpl = env.from_string(
+        """
+    {%- for grouper, list in [{'foo': 1, 'bar': 2},
+                              {'foo': 2, 'bar': 3},
+                              {'foo': 1, 'bar': 1},
+                              {'foo': 3, 'bar': 4}]|groupby('foo', reverse=True) -%}
+        {{ grouper }}{% for x in list %}: {{ x.foo }}, {{ x.bar }}{% endfor %}|
+    {%- endfor %}"""
+    )
+    
+    async def func():
+        return await tmpl.render_async()
+    
+    assert asyncio.run(func()).split("|") == ["3: 3, 4", "2: 2, 3", "1: 1, 2: 1, 1", ""]
