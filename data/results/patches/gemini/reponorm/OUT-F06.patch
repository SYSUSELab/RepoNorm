diff --git a/tests/backends/test_xgrammar_validation.py b/tests/backends/test_xgrammar_validation.py
new file mode 100644
index 0000000..bb1c1ea
--- /dev/null
+++ b/tests/backends/test_xgrammar_validation.py
@@ -0,0 +1,49 @@
+import pytest
+import transformers
+import outlines
+from outlines.backends.xgrammar import XGrammarBackend
+
+@pytest.fixture
+def model_transformers():
+    return outlines.from_transformers(
+        transformers.AutoModelForCausalLM.from_pretrained("erwanf/gpt2-mini"),
+        transformers.AutoTokenizer.from_pretrained("erwanf/gpt2-mini"),
+    )
+
+def test_xgrammar_backend_validation_policy(model_transformers):
+    # Test default validation
+    validation_called = False
+    def validator(grammar):
+        nonlocal validation_called
+        validation_called = True
+        return True
+    
+    backend = XGrammarBackend(model_transformers, validate_grammar=validator)
+    
+    # Test default validation
+    validation_called = False
+    backend.get_regex_logits_processor(".*")
+    assert validation_called, "Validator should have been called"
+    
+    # Test override with None
+    validation_called = False
+    backend.get_regex_logits_processor(".*", validate_grammar=None)
+    assert not validation_called, "Validator should not have been called"
+    
+    # Test override with new validator
+    new_validation_called = False
+    def new_validator(grammar):
+        nonlocal new_validation_called
+        new_validation_called = True
+        return True
+        
+    backend.get_regex_logits_processor(".*", validate_grammar=new_validator)
+    assert new_validation_called, "New validator should have been called"
+    assert not validation_called, "Old validator should not have been called"
+
+    # Test exception propagation
+    def failing_validator(grammar):
+        raise ValueError("Validation failed")
+        
+    with pytest.raises(ValueError, match="Validation failed"):
+        backend.get_regex_logits_processor(".*", validate_grammar=failing_validator)
