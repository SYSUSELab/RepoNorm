+import click
+from click.shell_completion import BashComplete
+import pytest
+from contextlib import contextmanager
+import os
+
+def test_resource_cleanup():
+    class Tracker:
+        closed = False
+    
+    tracker = Tracker()
+    
+    @contextmanager
+    def resource():
+        try:
+            yield
+        finally:
+            tracker.closed = True
+    
+    class CustomParamType(click.ParamType):
+        def shell_complete(self, ctx, param, incomplete):
+            ctx.with_resource(resource())
+            return []
+
+    @click.command()
+    @click.argument("arg", type=CustomParamType())
+    def cli():
+        pass
+        
+    # Set up environment variables for BashComplete
+    os.environ["_CLICK_COMPLETE"] = "bash"
+    os.environ["COMP_WORDS"] = "cli"
+    os.environ["COMP_CWORD"] = "1"
+    
+    comp = BashComplete(cli, {}, "cli", "_CLICK_COMPLETE")
+    comp.complete()
+    
+    assert tracker.closed is True
