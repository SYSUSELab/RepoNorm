index 0000000..1b0d28b
--- /dev/null
+++ b/tests/backends/test_xgrammar_processor_logic.py
@@ -0,0 +1,39 @@
+import torch
+import pytest
+from unittest.mock import MagicMock
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+
+def test_xgrammar_logits_processor_temperature():
+    # Mock the xgrammar_logits_processor
+    mock_processor = MagicMock()
+    mock_processor.return_value = torch.tensor([1.0, 2.0])
+    
+    processor = XGrammarLogitsProcessor("compiled_grammar", temperature=0.5)
+    processor.xgrammar_logits_processor = mock_processor
+    
+    input_ids = torch.tensor([[1]])
+    logits = torch.tensor([[1.0, 2.0]])
+    
+    processor.process_logits(input_ids, logits)
+    
+    # Check if the logits were divided by 0.5 (multiplied by 2.0)
+    # The mock_processor should have been called with logits / 0.5 = logits * 2.0
+    args, kwargs = mock_processor.call_args
+    assert torch.allclose(args[1], torch.tensor([[2.0, 4.0]]))
+
+def test_xgrammar_logits_processor_no_temperature():
+    # Mock the xgrammar_logits_processor
+    mock_processor = MagicMock()
+    mock_processor.return_value = torch.tensor([1.0, 2.0])
+    
+    processor = XGrammarLogitsProcessor("compiled_grammar", temperature=1.0)
+    processor.xgrammar_logits_processor = mock_processor
+    
+    input_ids = torch.tensor([[1]])
+    logits = torch.tensor([[1.0, 2.0]])
+    
+    processor.process_logits(input_ids, logits)
+    
+    # Check if the logits were NOT divided
+    args, kwargs = mock_processor.call_args
+    assert torch.allclose(args[1], torch.tensor([[1.0, 2.0]]))
diff --git a/tests/backends/test_xgrammar_temperature.py b/tests/backends/test_xgrammar_temperature.py
new file mode 100644
index 0000000..33ed333
--- /dev/null
+++ b/tests/backends/test_xgrammar_temperature.py
@@ -0,0 +1,35 @@
+import pytest
+import transformers
+import outlines
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+
+@pytest.fixture
+def model_transformers():
+    return outlines.from_transformers(
+        transformers.AutoModelForCausalLM.from_pretrained("erwanf/gpt2-mini"),
+        transformers.AutoTokenizer.from_pretrained("erwanf/gpt2-mini"),
+    )
+
+def test_xgrammar_temperature_parameter(model_transformers):
+    backend = XGrammarBackend(model_transformers)
+    
+    # Test JSON schema with temperature
+    processor = backend.get_json_schema_logits_processor('{"type": "string"}', temperature=0.5)
+    assert processor.temperature == 0.5
+    
+    # Test regex with temperature
+    processor = backend.get_regex_logits_processor(r"[0-9]", temperature=0.8)
+    assert processor.temperature == 0.8
+    
+    # Test CFG with temperature
+    processor = backend.get_cfg_logits_processor('root ::= "a"', temperature=1.2)
+    assert processor.temperature == 1.2
+    
+    # Test invalid temperature
+    with pytest.raises(ValueError):
+        backend.get_json_schema_logits_processor('{"type": "string"}', temperature=0.0)
+
+def test_xgrammar_temperature_default(model_transformers):
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor('{"type": "string"}')
+    assert processor.temperature == 1.0
