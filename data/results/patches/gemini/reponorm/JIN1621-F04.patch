index 0000000..e811c8d
--- /dev/null
+++ b/test_loader_priority.py
@@ -0,0 +1,46 @@
+import os
+import pytest
+from jinja2 import FileSystemLoader
+
+def test_priority_sorting():
+    # Test that paths are sorted by priority
+    loader = FileSystemLoader([
+        ("/path/a", 1),
+        ("/path/b", 2),
+        ("/path/c", 0),
+    ])
+    # Expected order: /path/b (2), /path/a (1), /path/c (0)
+    assert loader.searchpath == [
+        ("/path/b", 2),
+        ("/path/a", 1),
+        ("/path/c", 0),
+    ]
+
+def test_priority_stable_sorting():
+    # Test that entries with same priority retain input order
+    loader = FileSystemLoader([
+        ("/path/a", 1),
+        ("/path/b", 1),
+        ("/path/c", 0),
+    ])
+    # Expected order: /path/a (1), /path/b (1), /path/c (0)
+    assert loader.searchpath == [
+        ("/path/a", 1),
+        ("/path/b", 1),
+        ("/path/c", 0),
+    ]
+
+def test_invalid_tuple():
+    with pytest.raises(TypeError, match=r"Tuple must be \(path, priority\)"):
+        FileSystemLoader([("/path/a", 1, 2)])
+
+def test_invalid_priority_type():
+    with pytest.raises(TypeError, match="Priority must be an integer"):
+        FileSystemLoader([("/path/a", "high")])
+
+def test_boolean_priority():
+    with pytest.raises(TypeError, match="Priority must be an integer"):
+        FileSystemLoader([("/path/a", True)])
+
+if __name__ == "__main__":
+    pytest.main([__file__])
