+    """Split a path into segments and perform a sanity check.
+    
+    The same rules apply on every operating system: both `/` and `\\` are
+    logical separators; empty segments and `.` are removed; an internal
+    `..` removes the preceding ordinary segment.
+    
+    Rejects:
+    - Leading `..`
+    - `..` that would pop beyond the logical root
+    - Names beginning with `/` or `\\`
+    - UNC forms
+    - Names beginning with an ASCII drive prefix (e.g., `C:`)
     """
+    # Normalize separators
+    template = template.replace("\\", "/")
+    
+    # Reject leading separators or drive prefixes
+    if template.startswith("/") or (len(template) >= 2 and template[1] == ":"):
+        raise TemplateNotFound(template)
+        
     pieces = []
     for piece in template.split("/"):
-        if (
-            os.path.sep in piece
-            or (os.path.altsep and os.path.altsep in piece)
-            or piece == os.path.pardir
-        ):
-            raise TemplateNotFound(template)
-        elif piece and piece != ".":
+        if piece in ("", "."):
+            continue
+        if piece == "..":
+            if not pieces:
+                raise TemplateNotFound(template)
+            pieces.pop()
+        else:
             pieces.append(piece)
+            
     return pieces
 
 
