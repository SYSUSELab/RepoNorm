+++ b/tests/types/test_credit_card.py
@@ -0,0 +1,19 @@
+import pytest
+import re
+from outlines.types import credit_card
+
+def test_credit_card_regex():
+    pattern = credit_card.pattern
+    
+    # Valid cases
+    assert re.fullmatch(pattern, "1234567812345678")
+    assert re.fullmatch(pattern, "1234-5678-1234-5678")
+    assert re.fullmatch(pattern, "1234 5678 1234 5678")
+    
+    # Invalid cases
+    assert not re.fullmatch(pattern, "1234-5678 1234-5678")
+    assert not re.fullmatch(pattern, "123456781234567")
+    assert not re.fullmatch(pattern, "12345678123456789")
+    assert not re.fullmatch(pattern, "1234--5678-1234-5678")
+    assert not re.fullmatch(pattern, "1234  5678 1234 5678")
+    assert not re.fullmatch(pattern, "abcd567812345678")
