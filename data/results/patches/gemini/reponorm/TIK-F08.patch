@@ -0,0 +1,50 @@
+import tiktoken
+import pytest
+
+def test_pattern_tracking():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello hello hello world"
+    
+    # Test default behavior
+    tokens = enc.encode(text)
+    assert isinstance(tokens, list)
+    
+    # Test new behavior
+    tokens, patterns = enc.encode(text, return_repeated_pattern=True)
+    assert isinstance(tokens, list)
+    assert isinstance(patterns, dict)
+    
+    # Verify patterns
+    # "hello hello hello world" -> [15339, 24748, 24748, 1917]
+    # Pairs: (15339, 24748), (24748, 24748), (24748, 1917)
+    assert len(patterns) == 3
+    assert patterns[(15339, 24748)] == 1
+    assert patterns[(24748, 24748)] == 1
+    assert patterns[(24748, 1917)] == 1
+
+def test_pattern_tracking_empty():
+    enc = tiktoken.get_encoding("cl100k_base")
+    tokens, patterns = enc.encode("", return_repeated_pattern=True)
+    assert tokens == []
+    assert patterns == {}
+
+def test_pattern_tracking_single():
+    enc = tiktoken.get_encoding("cl100k_base")
+    tokens, patterns = enc.encode("hello", return_repeated_pattern=True)
+    assert len(tokens) == 1
+    assert patterns == {}
+
+def test_pattern_tracking_overlap():
+    # "hello hello hello" -> [15339, 24748, 24748]
+    # Pairs: (15339, 24748), (24748, 24748)
+    # Wait, (15339, 24748) is 1, (24748, 24748) is 1.
+    # Let's try to get (A, A) with count 2.
+    # We need [A, A, A]
+    # Maybe "hello hello hello hello" -> [15339, 24748, 24748, 24748]
+    # Pairs: (15339, 24748), (24748, 24748), (24748, 24748)
+    # (24748, 24748) count is 2.
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello hello hello hello"
+    tokens, patterns = enc.encode(text, return_repeated_pattern=True)
+    assert len(tokens) == 4
+    assert patterns[(24748, 24748)] == 2
