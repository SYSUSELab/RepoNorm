diff --git a/dirty_equals/_color.py b/dirty_equals/_color.py
new file mode 100644
index 0000000..39a767a
--- /dev/null
+++ b/dirty_equals/_color.py
@@ -0,0 +1,91 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit
+
+__all__ = 'IsColor',
+
+# Regex patterns
+# Hex: #?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})
+# RGB: rgb\(\s*(\d{1,3}%?)\s*,\s*(\d{1,3}%?)\s*,\s*(\d{1,3}%?)\s*\)
+# HSL: hsl\(\s*(\d{1,3}(?:deg)?)\s*,\s*(\d{1,3}%)\s*,\s*(\d{1,3}%)\s*\)
+
+HEX_RE = re.compile(r'#?[0-9a-fA-F]{3}([0-9a-fA-F]{3})?')
+
+def _is_valid_rgb_comp(s: str) -> bool:
+    if s.endswith('%'):
+        try:
+            val = int(s[:-1])
+            return 0 <= val <= 100
+        except ValueError:
+            return False
+    else:
+        try:
+            val = int(s)
+            return 0 <= val <= 255
+        except ValueError:
+            return False
+
+def _is_valid_hsl_hue(s: str) -> bool:
+    try:
+        if s.lower().endswith('deg'):
+            val = int(s[:-3])
+        else:
+            val = int(s)
+        return 0 <= val <= 360
+    except ValueError:
+        return False
+
+def _is_valid_hsl_comp(s: str) -> bool:
+    if s.endswith('%'):
+        try:
+            val = int(s[:-1])
+            return 0 <= val <= 100
+        except ValueError:
+            return False
+    return False
+
+RGB_RE = re.compile(r'rgb\(\s*(\d{1,3}%?)\s*,\s*(\d{1,3}%?)\s*,\s*(\d{1,3}%?)\s*\)', re.IGNORECASE)
+HSL_RE = re.compile(r'hsl\(\s*(\d{1,3}(?:deg)?)\s*,\s*(\d{1,3}%)\s*,\s*(\d{1,3}%)\s*\)', re.IGNORECASE)
+
+class IsColor(DirtyEquals[str]):
+    def __init__(self, format: Optional[str] = None):
+        self.format = format
+        super().__init__(format=format if format is not None else Omit)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        other = other.strip()
+        
+        if self.format == 'hex' or self.format is None:
+            if HEX_RE.fullmatch(other):
+                return True
+            if self.format == 'hex':
+                return False
+        
+        if self.format == 'rgb' or self.format is None:
+            m = RGB_RE.fullmatch(other)
+            if m:
+                if all(_is_valid_rgb_comp(g) for g in m.groups()):
+                    return True
+            if self.format == 'rgb':
+                return False
+                
+        if self.format == 'hsl' or self.format is None:
+            m = HSL_RE.fullmatch(other)
+            if m:
+                hue, sat, light = m.groups()
+                if _is_valid_hsl_hue(hue) and _is_valid_hsl_comp(sat) and _is_valid_hsl_comp(light):
+                    return True
+            if self.format == 'hsl':
+                return False
+                
+        return False
+
+    def _repr_ne(self) -> str:
+        if self.format:
+            return f"IsColor(format='{self.format}')"
+        return 'IsColor()'
diff --git a/tests/test_color.py b/tests/test_color.py
new file mode 100644
index 0000000..e182532
--- /dev/null
+++ b/tests/test_color.py
@@ -0,0 +1,44 @@
+import pytest
+from dirty_equals import IsColor
+
+def test_is_color_hex():
+    assert '#FF5733' == IsColor(format='hex')
+    assert '#f57' == IsColor(format='hex')
+    assert 'FF5733' == IsColor(format='hex')
+    assert 'f57' == IsColor(format='hex')
+    assert '#FF5733' != IsColor(format='rgb')
+    assert '#FF5733' != IsColor(format='hsl')
+    assert '#GGGGGG' != IsColor(format='hex')
+    assert '#1234' != IsColor(format='hex')
+    assert '  #FF5733  ' == IsColor(format='hex')
+
+def test_is_color_rgb():
+    assert 'rgb(255, 87, 51)' == IsColor(format='rgb')
+    assert 'rgb(100%, 0%, 0%)' == IsColor(format='rgb')
+    assert 'rgb(255, 87, 51)' != IsColor(format='hex')
+    assert 'rgb(256, 0, 0)' != IsColor(format='rgb')
+    assert 'rgb(101%, 0%, 0%)' != IsColor(format='rgb')
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'RGB(255, 87, 51)' == IsColor(format='rgb')
+    assert 'rgb(255,  87, 51)' == IsColor(format='rgb')
+
+def test_is_color_hsl():
+    assert 'hsl(14, 100%, 60%)' == IsColor(format='hsl')
+    assert 'hsl(14deg, 100%, 60%)' == IsColor(format='hsl')
+    assert 'hsl(360, 100%, 100%)' == IsColor(format='hsl')
+    assert 'hsl(361, 100%, 100%)' != IsColor(format='hsl')
+    assert 'hsl(14, 101%, 60%)' != IsColor(format='hsl')
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'HSL(14deg, 100%, 60%)' == IsColor(format='hsl')
+
+def test_is_color_any():
+    assert '#FF5733' == IsColor()
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'not a color' != IsColor()
+
+def test_is_color_repr():
+    assert repr(IsColor()) == 'IsColor()'
+    assert repr(IsColor(format='hex')) == "IsColor(format='hex')"
+    assert repr(IsColor(format='rgb')) == "IsColor(format='rgb')"
+    assert repr(IsColor(format='hsl')) == "IsColor(format='hsl')"
