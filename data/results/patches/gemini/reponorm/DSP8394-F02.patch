diff --git a/dspy/clients/namespace.py b/dspy/clients/namespace.py
new file mode 100644
index 00000000..f61e3c06
--- /dev/null
+++ b/dspy/clients/namespace.py
@@ -0,0 +1,48 @@
+import contextvars
+from typing import Optional, Union
+
+# Context variable to store the namespace.
+_namespace_context = contextvars.ContextVar("dspy_cache_namespace", default=None)
+
+class NamespaceAccessor:
+    @property
+    def value(self) -> Optional[str]:
+        return _namespace_context.get()
+
+    @value.setter
+    def value(self, val: Optional[str]):
+        if val is not None and not isinstance(val, str):
+            raise ValueError("Namespace must be a string or None.")
+        _namespace_context.set(val)
+
+    def __eq__(self, other: Union[str, None]) -> bool:
+        return self.value == other
+
+    def __call__(self, value: Optional[str]):
+        return NamespaceContextManager(value)
+
+class NamespaceContextManager:
+    def __init__(self, value: Optional[str]):
+        if value is not None and not isinstance(value, str):
+            raise ValueError("Namespace must be a string or None.")
+        self.value = value
+        self.token = None
+
+    def __enter__(self):
+        self.token = _namespace_context.set(self.value)
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        _namespace_context.reset(self.token)
+
+    async def __aenter__(self):
+        self.token = _namespace_context.set(self.value)
+        return self
+
+    async def __aexit__(self, exc_type, exc_val, exc_tb):
+        _namespace_context.reset(self.token)
+
+def set_namespace(value: Optional[str]):
+    if value is not None and not isinstance(value, str):
+        raise ValueError("Namespace must be a string or None.")
+    _namespace_context.set(value)
