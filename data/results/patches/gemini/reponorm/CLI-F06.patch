+import click
+from click.core import Context, ParameterSource
+import pytest
+
+def test_context_snapshot_restore():
+    @click.command()
+    def cli():
+        pass
+
+    ctx = Context(cli, obj={"a": 1})
+    ctx.params = {"foo": "bar"}
+    ctx.args = ["arg1"]
+    ctx._protected_args = ["p1"]
+    ctx._opt_prefixes = {"-": "dash"}
+    ctx.meta["m"] = 1
+    ctx.default_map = {"d": 1}
+    ctx.invoked_subcommand = "sub"
+    ctx.terminal_width = 100
+    ctx.max_content_width = 80
+    ctx.resilient_parsing = True
+    ctx.help_option_names = ["--help"]
+    ctx.token_normalize_func = lambda x: x
+    ctx.auto_envvar_prefix = "PRE"
+    ctx.color = True
+    ctx.show_default = True
+    ctx.set_parameter_source("p", ParameterSource.COMMANDLINE)
+
+    snapshot = ctx.save_state()
+    
+    # Modify context
+    ctx.params = {"foo": "baz"}
+    ctx.args = ["arg2"]
+    ctx.meta["m"] = 2
+    
+    # Restore
+    ctx.restore_state(snapshot)
+    
+    assert ctx.params == {"foo": "bar"}
+    assert ctx.args == ["arg1"]
+    assert ctx.meta["m"] == 1
+    assert ctx.get_parameter_source("p") == ParameterSource.COMMANDLINE
+
+def test_context_meta_shared():
+    @click.command()
+    def cli():
+        pass
+
+    parent = Context(cli)
+    child = Context(cli, parent=parent)
+    
+    # Meta is shared
+    parent.meta["shared"] = "value"
+    assert child.meta["shared"] == "value"
+    
+    snapshot = child.save_state()
+    
+    # Modify child meta
+    child.meta["child_only"] = "new"
+    
+    # Restore
+    child.restore_state(snapshot)
+    
+    # Check if meta is still shared
+    assert "child_only" not in child.meta
+    assert child.meta["shared"] == "value"
+    assert parent.meta["shared"] == "value"
+    
+    # Modify parent meta, check if child sees it
+    parent.meta["shared"] = "updated"
+    assert child.meta["shared"] == "updated"
+
+def test_context_restore_transactional():
+    @click.command()
+    def cli():
+        pass
+
+    ctx = Context(cli)
+    ctx.params = {"foo": "bar"}
+    
+    snapshot = ctx.save_state()
+    
+    # Remove a key to simulate invalid snapshot
+    del snapshot["params"]
+    
+    with pytest.raises(KeyError):
+        ctx.restore_state(snapshot)
+        
+    # Verify context was not partially changed (params should still be {"foo": "bar"})
+    assert ctx.params == {"foo": "bar"}
