+import re
+from typing import Any
+
+def coerce_value(value: Any, schema: dict[str, Any]) -> Any:
+    if not isinstance(value, str):
+        return value
+    
+    value = value.strip()
+    schema_type = schema.get("type")
+    
+    # Boolean
+    if schema_type == "boolean":
+        if value.lower() == "true":
+            return True
+        if value.lower() == "false":
+            return False
+        return value
+        
+    # Integer / Number
+    if schema_type in ["integer", "number"]:
+        # Try to parse as number
+        
+        # 1. Try to parse as a number with optional exponent
+        # "For integer and number fields, accept finite decimal numeric strings, with optional sign, decimal point and exponent."
+        # "Numeric fields also accept nonnegative decimal durations with suffix ms, s, m or h and sizes with suffix KB, MB or GB."
+        # "Unit magnitudes do not use exponent notation."
+        
+        # Regex for unit case:
+        # ^\s*(\d*\.?\d+)\s*([a-zA-Z]+)\s*$
+        # "nonnegative decimal durations". So no sign for units.
+        
+        match_unit = re.match(r"^(\d*\.?\d+)\s*([a-zA-Z]+)$", value)
+        if match_unit:
+            magnitude_str, unit = match_unit.groups()
+            magnitude = float(magnitude_str)
+            
+            if unit == "ms": val = magnitude / 1000.0
+            elif unit == "s": val = magnitude
+            elif unit == "m": val = magnitude * 60.0
+            elif unit == "h": val = magnitude * 3600.0
+            elif unit == "KB": val = int(magnitude * 1000)
+            elif unit == "MB": val = int(magnitude * 1000000)
+            elif unit == "GB": val = int(magnitude * 1000000000)
+            else: return value # Unknown unit
+            
+            if schema_type == "integer": return int(val)
+            return val
+        
+        # If no unit, try to parse as a number (with exponent)
+        try:
+            if schema_type == "integer":
+                # If it has a decimal point, it's not an integer.
+                if "." in value:
+                    return value
+                
+                # If it has an exponent, it might be an integer.
+                if "e" in value.lower():
+                    f = float(value)
+                    if f.is_integer():
+                        return int(f)
+                    return value
+                
+                return int(value)
+            else:
+                return float(value)
+        except ValueError:
+            return value
+            
+    return value
