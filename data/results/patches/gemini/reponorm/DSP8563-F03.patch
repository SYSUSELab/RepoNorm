diff --git a/tests/test_tool_coercion.py b/tests/test_tool_coercion.py
new file mode 100644
index 00000000..3013cf3e
--- /dev/null
+++ b/tests/test_tool_coercion.py
@@ -0,0 +1,21 @@
+import pytest
+from dspy.adapters.types.tool import Tool
+
+def test_tool_coercion():
+    def my_tool(x: int, y: bool, z: float):
+        return x, y, z
+
+    tool = Tool(my_tool)
+    
+    # Test coercion
+    result = tool(x="1s", y="true", z="1KB")
+    assert result == (1, True, 1000.0)
+
+def test_tool_coercion_invalid():
+    def my_tool(x: int):
+        return x
+    
+    tool = Tool(my_tool)
+    # "10.5" for integer should fail validation
+    with pytest.raises(ValueError, match="Arg x is invalid"):
+        tool(x="10.5")
