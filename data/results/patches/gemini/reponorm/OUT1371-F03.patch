+def get_active_condition():
+    # 1. OUTLINES_DEBUG=true activates debug.
+    # 2. ENVIRONMENT=production activates production.
+    # 3. ENV=testing, OUTLINES_TESTING=true, or TESTING_MODE=on activates testing.
+    
+    # Priority: debug, then production, then testing.
+    
+    debug = os.environ.get("OUTLINES_DEBUG", "").lower() == "true"
+    production = os.environ.get("ENVIRONMENT", "").lower() == "production"
+    testing = (
+        os.environ.get("ENV", "").lower() == "testing" or
+        os.environ.get("OUTLINES_TESTING", "").lower() == "true" or
+        os.environ.get("TESTING_MODE", "").lower() == "on"
+    )
+    
+    if debug:
+        return "debug"
+    if production:
+        return "production"
+    if testing:
+        return "testing"
+    return None
+
+
+def select_condition(conditional_filters, active_condition):
+    if not conditional_filters:
+        return None
+    
+    if active_condition in conditional_filters:
+        return active_condition
+    
+    # If none of those conditions both matches and exists, select the alphabetically first supplied condition key.
+    sorted_keys = sorted(conditional_filters.keys())
+    return sorted_keys[0]
+
+
+def _setup_env(env: jinja2.Environment, conditional_filters: Optional[Dict[str, Dict[str, Callable]]] = None):
+    env.filters["name"] = get_fn_name
+    env.filters["description"] = get_fn_description
+    env.filters["source"] = get_fn_source
+    env.filters["signature"] = get_fn_signature
+    env.filters["schema"] = get_schema
+    env.filters["args"] = get_fn_args
+    
+    active_condition = get_active_condition()
+    selected_condition = select_condition(conditional_filters, active_condition)
+    
+    if selected_condition and conditional_filters:
+        env.filters.update(conditional_filters[selected_condition])
+
