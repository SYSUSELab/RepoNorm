@@ -0,0 +1,20 @@
+from outlines.types import binary_str
+from outlines.types.dsl import Regex
+
+def test_binary_str_definition():
+    assert isinstance(binary_str, Regex)
+    assert binary_str.pattern == "0b[01]+"
+
+def test_binary_str_matches():
+    assert binary_str.matches("0b0")
+    assert binary_str.matches("0b1")
+    assert binary_str.matches("0b010101")
+    
+    assert not binary_str.matches("0B0")
+    assert not binary_str.matches("0b")
+    assert not binary_str.matches("0b2")
+    assert not binary_str.matches("0b010101a")
+    assert not binary_str.matches(" 0b0")
+    assert not binary_str.matches("0b0 ")
+    assert not binary_str.matches("+0b0")
+    assert not binary_str.matches("0b_0")
