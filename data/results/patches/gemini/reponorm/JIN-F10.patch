+import sys
+
+with open('src/jinja2/filters.py', 'r') as f:
+    lines = f.readlines()
+
+# Find sync_do_groupby
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def sync_do_groupby(' in line:
+        start_line = i
+        break
+
+# Update sync_do_groupby signature
+lines[start_line+4] = '    default: t.Optional[t.Any] = None,\n'
+lines.insert(start_line+5, '    filter_groups: t.Optional[t.Callable[[t.List[V]], bool]] = None,\n')
+
+# Update sync_do_groupby body
+# Find the end of the function
+end_line = 0
+for i in range(start_line, len(lines)):
+    if lines[i].strip() == 'return [':
+        # Find the closing bracket
+        for j in range(i, len(lines)):
+            if lines[j].strip() == ']':
+                end_line = j
+                break
+        break
+
+# Replace the list comprehension
+lines[i:end_line+1] = [
+    '    groups = []\n',
+    '    for key, values in groupby(sorted(value, key=expr), expr):\n',
+    '        items = list(values)\n',
+    '        if filter_groups is None or filter_groups(items):\n',
+    '            groups.append(_GroupTuple(key, items))\n',
+    '    return groups\n'
+]
+
+# Find do_groupby
+start_line = 0
+for i, line in enumerate(lines):
+    if 'async def do_groupby(' in line:
+        start_line = i
+        break
+
+# Update do_groupby signature
+lines[start_line+4] = '    default: t.Optional[t.Any] = None,\n'
+lines.insert(start_line+5, '    filter_groups: t.Optional[t.Callable[[t.List[V]], t.Union[bool, t.Awaitable[bool]]]] = None,\n')
+
+# Update do_groupby body
+# Find the end of the function
+for i in range(start_line, len(lines)):
+    if lines[i].strip() == 'return [':
+        # Find the closing bracket
+        for j in range(i, len(lines)):
+            if lines[j].strip() == ']':
+                end_line = j
+                break
+        break
+
+# Replace the list comprehension
+lines[i:end_line+1] = [
+    '    groups = []\n',
+    '    for key, values in groupby(sorted(await auto_to_list(value), key=expr), expr):\n',
+    '        items = await auto_to_list(values)\n',
+    '        if filter_groups is None:\n',
+    '            groups.append(_GroupTuple(key, items))\n',
+    '        else:\n',
+    '            if getattr(filter_groups, "jinja_pass_arg", None) == _PassArg.environment:\n',
+    '                res = filter_groups(environment, items)\n',
+    '            else:\n',
+    '                res = filter_groups(items)\n',
+    '            if await auto_await(res):\n',
+    '                groups.append(_GroupTuple(key, items))\n',
+    '    return groups\n'
+]
+
+# Add _PassArg import
+for i, line in enumerate(lines):
+    if 'from .utils import pass_environment' in line:
+        lines.insert(i+1, 'from .utils import _PassArg\n')
+        break
+
+with open('src/jinja2/filters.py', 'w') as f:
+    f.writelines(lines)
