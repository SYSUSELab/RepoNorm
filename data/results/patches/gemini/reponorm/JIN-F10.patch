diff --git a/tests/test_groupby_filter.py b/tests/test_groupby_filter.py
new file mode 100644
index 0000000..fad3a31
--- /dev/null
+++ b/tests/test_groupby_filter.py
@@ -0,0 +1,100 @@
+import pytest
+import asyncio
+from jinja2 import Environment, pass_environment
+
+def test_groupby_filter_predicate():
+    env = Environment()
+    data = [
+        {"name": "a", "group": 1},
+        {"name": "b", "group": 1},
+        {"name": "c", "group": 2},
+        {"name": "d", "group": 2},
+    ]
+    
+    # Test with predicate
+    def predicate(items):
+        return len(items) > 2
+    
+    # This should filter out both groups because both have 2 items
+    result = env.from_string("{% for g in data|groupby('group', filter_groups=predicate) %}{{ g.grouper }}{% endfor %}").render(data=data, predicate=predicate)
+    assert result == ""
+
+    def predicate2(items):
+        return len(items) == 2
+    
+    # This should keep both groups
+    result = env.from_string("{% for g in data|groupby('group', filter_groups=predicate2) %}{{ g.grouper }}{% endfor %}").render(data=data, predicate2=predicate2)
+    assert result == "12"
+
+def test_groupby_filter_async_predicate():
+    env = Environment(enable_async=True)
+    data = [
+        {"name": "a", "group": 1},
+        {"name": "b", "group": 1},
+        {"name": "c", "group": 2},
+        {"name": "d", "group": 2},
+    ]
+    
+    async def predicate(items):
+        await asyncio.sleep(0.01)
+        return len(items) > 2
+    
+    # This should filter out both groups because both have 2 items
+    result = asyncio.run(env.from_string("{% for g in data|groupby('group', filter_groups=predicate) %}{{ g.grouper }}{% endfor %}").render_async(data=data, predicate=predicate))
+    assert result == ""
+
+    async def predicate2(items):
+        await asyncio.sleep(0.01)
+        return len(items) == 2
+    
+    # This should keep both groups
+    result = asyncio.run(env.from_string("{% for g in data|groupby('group', filter_groups=predicate2) %}{{ g.grouper }}{% endfor %}").render_async(data=data, predicate2=predicate2))
+    assert result == "12"
+
+def test_groupby_filter_pass_environment():
+    env = Environment(enable_async=True)
+    data = [
+        {"name": "a", "group": 1},
+        {"name": "b", "group": 1},
+    ]
+    
+    @pass_environment
+    def predicate(env, items):
+        return env is not None and len(items) > 0
+    
+    result = asyncio.run(env.from_string("{% for g in data|groupby('group', filter_groups=predicate) %}{{ g.grouper }}{% endfor %}").render_async(data=data, predicate=predicate))
+    assert result == "1"
+
+def test_groupby_filter_sync_pass_environment():
+    env = Environment()
+    data = [
+        {"name": "a", "group": 1},
+        {"name": "b", "group": 1},
+    ]
+    
+    @pass_environment
+    def predicate(env, items):
+        return env is not None and len(items) > 0
+    
+    result = env.from_string("{% for g in data|groupby('group', filter_groups=predicate) %}{{ g.grouper }}{% endfor %}").render(data=data, predicate=predicate)
+    assert result == "1"
+
+def test_groupby_filter_empty_input():
+    env = Environment()
+    data = []
+    
+    def predicate(items):
+        return False
+    
+    result = env.from_string("{% for g in data|groupby('group', filter_groups=predicate) %}{{ g.grouper }}{% endfor %}").render(data=data, predicate=predicate)
+    assert result == ""
+
+def test_groupby_filter_async_empty_input():
+    env = Environment(enable_async=True)
+    data = []
+    
+    async def predicate(items):
+        return False
+    
+    result = asyncio.run(env.from_string("{% for g in data|groupby('group', filter_groups=predicate) %}{{ g.grouper }}{% endfor %}").render_async(data=data, predicate=predicate))
+    assert result == ""
