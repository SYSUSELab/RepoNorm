diff --git a/tests/test_compression_feature.py b/tests/test_compression_feature.py
new file mode 100644
index 0000000..944cbfb
--- /dev/null
+++ b/tests/test_compression_feature.py
@@ -0,0 +1,50 @@
+import tiktoken
+import pytest
+
+def test_compression_feature():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "The dog dog dog ran ran quickly"
+    
+    # Standard encoding
+    encoded = enc.encode(text)
+    assert encoded == [464, 3290, 3290, 3290, 4966, 4966, 2952]
+    
+    # Compressed encoding
+    compressed = enc.encode(text, compress=True)
+    assert compressed == [464, 3290, 4966, 2952]
+
+def test_no_compression_by_default():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "The dog dog dog ran ran quickly"
+    
+    # Standard encoding
+    encoded = enc.encode(text)
+    encoded_default = enc.encode(text, compress=False)
+    assert encoded == encoded_default
+
+def test_compression_with_special_tokens():
+    enc = tiktoken.get_encoding("gpt2")
+    # Need to allow special tokens
+    # The spaces between tokens are encoded as 220
+    text = "<|endoftext|><|endoftext|><|endoftext|>"
+    
+    # Standard encoding
+    encoded = enc.encode(text, allowed_special={"<|endoftext|>"})
+    assert encoded == [50256, 50256, 50256]
+    
+    # Compressed encoding
+    compressed = enc.encode(text, allowed_special={"<|endoftext|>"}, compress=True)
+    assert compressed == [50256]
+
+
+def test_encode_ordinary_compression():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "The dog dog dog ran ran quickly"
+    
+    # Standard encoding
+    encoded = enc.encode_ordinary(text)
+    assert encoded == [464, 3290, 3290, 3290, 4966, 4966, 2952]
+    
+    # Compressed encoding
+    compressed = enc.encode_ordinary(text, compress=True)
+    assert compressed == [464, 3290, 4966, 2952]
