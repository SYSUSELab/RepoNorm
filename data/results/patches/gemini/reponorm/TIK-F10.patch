diff --git a/tests/test_cache.py b/tests/test_cache.py
new file mode 100644
index 0000000..0fb69a8
--- /dev/null
+++ b/tests/test_cache.py
@@ -0,0 +1,64 @@
+import tiktoken
+import pytest
+
+def test_cache_basic():
+    enc = tiktoken.get_encoding("cl100k_base"); enc._cache.clear()
+    text = "hello world"
+    
+    # First call, no cache
+    tokens1 = enc.encode(text, use_cache=True)
+    
+    # Second call, should be cached
+    tokens2 = enc.encode(text, use_cache=True)
+    
+    assert tokens1 == tokens2
+    assert tokens1 == enc.encode(text)
+
+def test_cache_batch():
+    enc = tiktoken.get_encoding("cl100k_base"); enc._cache.clear()
+    texts = ["hello world", "goodbye world"]
+    
+    tokens1 = enc.encode_batch(texts, use_cache=True)
+    tokens2 = enc.encode_batch(texts, use_cache=True)
+    
+    assert tokens1 == tokens2
+    assert tokens1 == enc.encode_batch(texts)
+
+def test_cache_isolation():
+    enc1 = tiktoken.get_encoding("cl100k_base")
+    enc2 = tiktoken.get_encoding("cl100k_base")
+    text = "hello world"
+    
+    enc1.encode(text, use_cache=True)
+    
+    # enc2 cache should be empty
+    # We can't easily check cache size, but we can check if it works
+    tokens2 = enc2.encode(text, use_cache=True)
+    assert tokens2 == enc1.encode(text)
+
+def test_cache_mutation():
+    enc = tiktoken.get_encoding("cl100k_base"); enc._cache.clear()
+    text = "hello world"
+    
+    tokens1 = enc.encode(text, use_cache=True)
+    tokens1.append(999999)
+    
+    tokens2 = enc.encode(text, use_cache=True)
+    assert 999999 not in tokens2
+
+def test_cache_special_tokens():
+    enc = tiktoken.get_encoding("cl100k_base"); enc._cache.clear()
+    text = "<|endoftext|>"
+    
+    # This should raise ValueError
+    with pytest.raises(ValueError):
+        enc.encode(text, use_cache=True)
+        
+    # This should work
+    tokens = enc.encode(text, allowed_special={"<|endoftext|>"}, use_cache=True)
+    assert tokens == [100257]
+    
+    # This should be cached
+    tokens2 = enc.encode(text, allowed_special={"<|endoftext|>"}, use_cache=True)
+    assert tokens == tokens2
+
diff --git a/tests/test_pickle_cache.py b/tests/test_pickle_cache.py
new file mode 100644
index 0000000..c0b2c55
--- /dev/null
+++ b/tests/test_pickle_cache.py
@@ -0,0 +1,18 @@
+import tiktoken
+import pickle
+
+def test_pickle_cache():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello world"
+    enc.encode(text, use_cache=True)
+    
+    # Pickle and unpickle
+    enc_pickled = pickle.dumps(enc)
+    enc_unpickled = pickle.loads(enc_pickled)
+    
+    print(f"enc_unpickled._cache: {enc_unpickled._cache}")
+    
+    # Check if it has the cache attribute
+    assert hasattr(enc_unpickled, "_cache")
+    assert len(enc_unpickled._cache) == 0
+
