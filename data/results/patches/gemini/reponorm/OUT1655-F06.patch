+ipv4 = rf"{ipv4_octet}(\.{ipv4_octet}){{3}}"
+dns_name = rf"(?!(\d+\.){{3}}\d+$){dns_label}(\.{dns_label})+"
+host = rf"(localhost|{ipv4}|{dns_name})"
+port = r"(:\d{1,5})?"
+path = r"(?:\/[a-zA-Z0-9\-._~!$&'()*+,;=:@\[\]]*)*"
+query = r"(?:\?[a-zA-Z0-9\-._~!$&'()*+,;=:@\[\]/?]+)?"
+fragment = r"(?:#[a-zA-Z0-9\-._~!$&'()*+,;=:@\[\]/?]+)?"
+
+url = Regex(rf"https?://{host}{port}{path}{query}{fragment}")
