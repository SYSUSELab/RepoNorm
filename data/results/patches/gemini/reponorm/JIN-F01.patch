diff --git a/tests/test_groupby_case.py b/tests/test_groupby_case.py
new file mode 100644
index 0000000..e76509e
--- /dev/null
+++ b/tests/test_groupby_case.py
@@ -0,0 +1,43 @@
+import pytest
+import asyncio
+from jinja2 import Environment
+from jinja2.filters import sync_do_groupby, do_groupby
+
+def test_groupby_case_sensitive_sync():
+    env = Environment()
+    data = [{"name": "a"}, {"name": "A"}, {"name": "b"}]
+
+    # Case insensitive (default)
+    result = sync_do_groupby(env, data, "name", case_sensitive=False)
+    assert len(result) == 2
+    assert result[0][0] == "a"
+    assert len(result[0][1]) == 2
+    assert result[1][0] == "b"
+
+    # Case sensitive
+    result = sync_do_groupby(env, data, "name", case_sensitive=True)
+    assert len(result) == 3
+    assert result[0][0] == "A"
+    assert result[1][0] == "a"
+    assert result[2][0] == "b"
+
+def test_groupby_case_sensitive_async():
+    async def run():
+        env = Environment(enable_async=True)
+        data = [{"name": "a"}, {"name": "A"}, {"name": "b"}]
+
+        # Case insensitive (default)
+        result = await do_groupby(env, data, "name", case_sensitive=False)
+        assert len(result) == 2
+        assert result[0][0] == "a"
+        assert len(result[0][1]) == 2
+        assert result[1][0] == "b"
+
+        # Case sensitive
+        result = await do_groupby(env, data, "name", case_sensitive=True)
+        assert len(result) == 3
+        assert result[0][0] == "A"
+        assert result[1][0] == "a"
+        assert result[2][0] == "b"
+
+    asyncio.run(run())
