@@ -0,0 +1,35 @@
+from dirty_equals import IsURL
+import pytest
+
+def test_is_url_basic():
+    assert 'https://example.com' == IsURL()
+    assert 'http://example.com' == IsURL()
+    assert 'ftp://example.com' == IsURL()
+    assert 'not-a-url' != IsURL()
+    assert 123 != IsURL()
+
+def test_is_url_protocol():
+    assert 'https://example.com' == IsURL('https')
+    assert 'http://example.com' == IsURL('http')
+    assert 'https://example.com' != IsURL('http')
+    assert 'https://example.com' == IsURL(['https', 'http'])
+    assert 'http://example.com' == IsURL({'https', 'http'})
+    assert 'ftp://example.com' != IsURL(['https', 'http'])
+
+def test_is_url_domain():
+    assert 'https://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'https://example.com:8080' != IsURL(domain='example.com')
+    assert 'https://example.com' != IsURL(domain='example.com:8080')
+
+def test_is_url_protocol_and_domain():
+    assert 'https://example.com:8080' == IsURL('https', 'example.com:8080')
+    assert 'https://example.com' == IsURL('https', 'example.com')
+    assert 'http://example.com' != IsURL('https', 'example.com')
+    assert 'https://other.com' != IsURL('https', 'example.com')
+
+def test_is_url_repr():
+    assert repr(IsURL()) == 'IsURL()'
+    assert repr(IsURL('https')) == "IsURL('https')"
+    assert repr(IsURL(domain='example.com')) == "IsURL('example.com')"
+    assert repr(IsURL('https', 'example.com')) == "IsURL('https', 'example.com')"
