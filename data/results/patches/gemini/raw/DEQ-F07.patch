+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hash of a given algorithm.
+    """
+
+    _lengths = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The algorithm to check, one of md5, sha1, sha224, sha256, sha384, sha512.
+        """
+        self.algorithm = algorithm.lower()
+        if self.algorithm not in self._lengths:
+            raise ValueError(f'Unsupported hash algorithm: {algorithm}')
+        self.length = self._lengths[self.algorithm]
+        super().__init__(plain_repr(algorithm))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        if len(other) != self.length:
+            return False
+        return bool(re.fullmatch(r'[0-9a-fA-F]+', other))
+
+
 AnyJson = object
 JsonType = TypeVar('JsonType', AnyJson, Any)
 
