+import re
+
+with open('src/click/termui.py', 'r') as f:
+    content = f.read()
+
+# Add process_priority to edit function signature
+pattern = r'(def edit\(\n\s+text: t\.AnyStr \| None = None,\n\s+editor: str \| None = None,\n\s+env: cabc\.Mapping\[str, str\] \| None = None,\n\s+require_save: bool = True,\n\s+extension: str = "\.txt",\n\s+filename: str \| None = None,\n\))'
+replacement = r'\1\n    process_priority: str | None = None,'
+content = re.sub(pattern, replacement, content)
+
+# Add validation and pass it to Editor
+# Find the call to Editor
+pattern = r'(ed = Editor\(editor=editor, env=env, require_save=require_save, extension=extension\))'
+replacement = r'\1\n    ed.process_priority = process_priority'
+content = re.sub(pattern, replacement, content)
+
+# Add validation logic before Editor call
+validation_code = """
+    if process_priority is not None:
+        if process_priority not in ("low", "below_normal", "normal", "above_normal", "high"):
+            raise ValueError(f"Invalid process_priority: {process_priority}")
+"""
+content = content.replace('    ed = Editor(editor=editor, env=env, require_save=require_save, extension=extension)', validation_code + '\n    ed = Editor(editor=editor, env=env, require_save=require_save, extension=extension)')
+
+with open('src/click/termui.py', 'w') as f:
+    f.write(content)
