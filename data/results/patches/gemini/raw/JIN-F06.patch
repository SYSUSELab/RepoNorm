     assert out == "0,1,2 .. 3,4,5"
+
+async def test_groupby_key_transform_async(env_async):
+    users = [
+        {'name': 'Alice', 'city': 'NY'},
+        {'name': 'Bob', 'city': 'LA'},
+    ]
+    
+    async def transform(key):
+        return key.lower()
+        
+    tmpl = env_async.from_string(
+        "{% for city, items in users|groupby('city', key_transform=transform) %}"
+        "{{ city }}: {{ items|map(attribute='name')|join(', ') }}|"
+        "{% endfor %}"
+    )
+    assert await tmpl.render_async(users=users, transform=transform) == "la: Bob|ny: Alice|"
+
+def test_groupby_key_transform_async():
+    import asyncio
+    from jinja2 import Environment
+    env = Environment(enable_async=True)
+    users = [
+        {'name': 'Alice', 'city': 'NY'},
+        {'name': 'Bob', 'city': 'LA'},
+    ]
+    
+    async def transform(key):
+        return key.lower()
+        
+    async def run_test():
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', key_transform=transform) %}"
+            "{{ city }}: {{ items|map(attribute='name')|join(', ') }}|"
+            "{% endfor %}"
+        )
+        return await tmpl.render_async(users=users, transform=transform)
+        
+    assert asyncio.run(run_test()) == "la: Bob|ny: Alice|"
diff --git a/tests/test_filters.py b/tests/test_filters.py
