@@ -852,3 +852,38 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+    def test_groupby_key_transform(self, env):
+        users = [
+            {'name': 'Alice', 'city': 'NY'},
+            {'name': 'Bob', 'city': 'LA'},
+            {'name': 'Charlie', 'city': 'NY'},
+        ]
+        
+        def transform(key):
+            return key.lower()
+            
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', key_transform=transform) %}"
+            "{{ city }}: {{ items|map(attribute='name')|join(', ') }}|"
+            "{% endfor %}"
+        )
+        assert tmpl.render(users=users, transform=transform) == "la: Bob|ny: Alice, Charlie|"
+
+    def test_groupby_key_transform_pass_env(self, env):
+        users = [
+            {'name': 'Alice', 'city': 'NY'},
+        ]
+        
+        from jinja2.utils import pass_environment
+        @pass_environment
+        def transform(env, key):
+            return f"{key.lower()}_{env.name}"
+            
+        env.name = "test"
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', key_transform=transform) %}"
+            "{{ city }}"
+            "{% endfor %}"
+        )
+        assert tmpl.render(users=users, transform=transform) == "ny_test"
