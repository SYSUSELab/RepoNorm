         tip=None,
     )
     assert result == "instruction"
+
+def test_max_instruct_history_validation():
+    from dspy.predict import Predict
+    program = Predict("question -> answer")
+    
+    # Test valid
+    GroundedProposer(prompt_model=None, program=program, trainset=[], max_instruct_history=5)
+    
+    # Test clamping
+    proposer = GroundedProposer(prompt_model=None, program=program, trainset=[], max_instruct_history=25)
+    assert proposer.max_instruct_history == 20
+    
+    proposer = GroundedProposer(prompt_model=None, program=program, trainset=[], max_instruct_history=-5)
+    assert proposer.max_instruct_history == 0
+    
+    # Test invalid
+    with pytest.raises(ValueError):
+        GroundedProposer(prompt_model=None, program=program, trainset=[], max_instruct_history="5")
+    
+    with pytest.raises(ValueError):
+        GroundedProposer(prompt_model=None, program=program, trainset=[], max_instruct_history=True)
