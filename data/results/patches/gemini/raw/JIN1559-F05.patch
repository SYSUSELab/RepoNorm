+++ b/test_edge_cases.py
@@ -0,0 +1,33 @@
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+from jinja2.exceptions import TemplateSyntaxError
+
+env = Environment(extensions=[InternationalizationExtension])
+
+# Test 3: Valid expression
+try:
+    env.from_string("{% trans x=a.b.c %}bar{% endtrans %}")
+    print("Test 3 passed")
+except Exception as e:
+    print(f"Test 3 failed: {e}")
+
+# Test 4: Valid call
+try:
+    env.from_string("{% trans x=f(a, b=c) %}bar{% endtrans %}")
+    print("Test 4 passed")
+except Exception as e:
+    print(f"Test 4 failed: {e}")
+
+# Test 5: Invalid call (nested expression)
+try:
+    env.from_string("{% trans x=f(a+b) %}bar{% endtrans %}")
+    print("Test 5 failed: No error raised")
+except TemplateSyntaxError as e:
+    print(f"Caught expected error: {e}")
+
+# Test 6: Invalid call (dynamic args)
+try:
+    env.from_string("{% trans x=f(*args) %}bar{% endtrans %}")
+    print("Test 6 failed: No error raised")
+except TemplateSyntaxError as e:
+    print(f"Caught expected error: {e}")
