+from jinja2 import nodes
+from jinja2.exceptions import TemplateSyntaxError
+
+def validate_expression(expr):
+    if isinstance(expr, (nodes.Const, nodes.Name)):
+        return
+    if isinstance(expr, nodes.Getattr):
+        validate_expression(expr.node)
+        return
+    if isinstance(expr, nodes.Filter):
+        validate_expression(expr.node)
+        for arg in expr.args:
+            validate_expression(arg)
+        for kw in expr.kwargs:
+            validate_expression(kw.value)
+        return
+    if isinstance(expr, nodes.Test):
+        validate_expression(expr.node)
+        for arg in expr.args:
+            validate_expression(arg)
+        for kw in expr.kwargs:
+            validate_expression(kw.value)
+        return
+    if isinstance(expr, nodes.Call):
+        if not isinstance(expr.node, nodes.Name):
+            raise TemplateSyntaxError("Only simple names allowed as callees", expr.lineno)
+        for arg in expr.args:
+            validate_expression(arg)
+        for kw in expr.kwargs:
+            validate_expression(kw.value)
+        if expr.dyn_args or expr.dyn_kwargs:
+            raise TemplateSyntaxError("Dynamic args/kwargs not allowed", expr.lineno)
+        return
+    raise TemplateSyntaxError(f"Invalid expression type: {type(expr).__name__}", expr.lineno)
+
+# Test cases
+try:
+    validate_expression(nodes.Call(nodes.Name("f", "load"), [nodes.Name("x", "load")], [], nodes.Name("args", "load"), None))
+    print("Starargs: Failed (should have raised)")
+except TemplateSyntaxError as e:
+    print(f"Caught expected error: {e}")
diff --git a/tests/test_trans_validation.py b/tests/test_trans_validation.py
new file mode 100644
index 0000000..6e064a1
--- /dev/null
+++ b/tests/test_trans_validation.py
@@ -0,0 +1,28 @@
+import pytest
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+from jinja2.exceptions import TemplateSyntaxError
+
+@pytest.fixture
+def env():
+    return Environment(extensions=[InternationalizationExtension])
+
+def test_reserved_names(env):
+    with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names"):
+        env.from_string("{% trans gettext='foo' %}bar{% endtrans %}")
+    with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names"):
+        env.from_string("{% trans _='foo' %}bar{% endtrans %}")
+    with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names"):
+        env.from_string("{% trans gettext %}bar{% endtrans %}")
+
+def test_invalid_expressions(env):
+    with pytest.raises(TemplateSyntaxError, match="Invalid expression type"):
+        env.from_string("{% trans x=a[0] %}bar{% endtrans %}")
+    with pytest.raises(TemplateSyntaxError, match="Invalid expression type"):
+        env.from_string("{% trans x=a+b %}bar{% endtrans %}")
+    with pytest.raises(TemplateSyntaxError, match="Dynamic args/kwargs not allowed"):
+        env.from_string("{% trans x=f(*args) %}bar{% endtrans %}")
+
+def test_valid_expressions(env):
+    env.from_string("{% trans x=a.b.c %}bar{% endtrans %}")
+    env.from_string("{% trans x=f(a, b=c) %}bar{% endtrans %}")
