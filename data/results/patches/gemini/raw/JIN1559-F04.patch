+    if 'return Parser(self, source, name, filename).parse()' in lines[i]:
+        end_index = i + 1
+        break
+
+new_method = """
+    def extract_translations_with_metadata(
+        self, source: t.Union[str, nodes.Template], source_name: t.Optional[str] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        \"\"\"Extract localizable strings with metadata from the given template.\"\"\"
+        if isinstance(source, str):
+            source = self.parse(source, name=source_name)
+        
+        # Find the InternationalizationExtension
+        for ext in self.extensions.values():
+            if hasattr(ext, "extract_translations_with_metadata"):
