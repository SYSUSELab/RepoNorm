+import re
+
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# 1. Update __init__ to register extract_translations_with_metadata
+content = content.replace(
+    'extract_translations=self._extract,',
+    'extract_translations=self._extract,\n            extract_translations_with_metadata=self._extract_with_metadata,'
+)
+
+# 2. Add _extract_with_metadata method
+new_method = """
+    def _extract_with_metadata(
+        self,
+        source: t.Union[str, nodes.Template],
+        gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        if isinstance(source, str):
