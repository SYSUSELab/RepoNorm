+# Now fix the `parse` to pass `metadata` to `_make_node`.
+# I already did this, but let me double check.
+for i in range(len(lines)):
+    if 'node = self._make_node(' in lines[i]:
+        if 'metadata)' not in lines[i]:
+            lines[i] = lines[i].replace('bool(referenced), num_called_num and have_plural)', 'bool(referenced), num_called_num and have_plural, metadata)')
