diff --git a/update_parse_v2.py b/update_parse_v2.py
new file mode 100644
index 0000000..b886348
--- /dev/null
+++ b/update_parse_v2.py
@@ -0,0 +1,121 @@
+import re
+
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# I will replace the `parse` method again.
+# I need to catch `TemplateSyntaxError` when `parser.stream.expect("assign")` fails.
+
+# Actually, `parser.stream.expect` raises `TemplateSyntaxError`.
+# I can catch it and raise `TemplateAssertionError`.
+
+# Let's modify the `parse` method.
+# I'll use a try-except block.
+
+new_parse = """    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        \"\"\"Parse a translatable tag.\"\"\"
+        lineno = next(parser.stream).lineno
+        num_called_num = False
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        metadata: t.Dict[str, str] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            if variables or metadata:
+                parser.stream.expect("comma")
+            if parser.stream.skip_if("colon"):
+                break
+            token = parser.stream.expect("name")
+            if token.value in ("note", "created", "modified"):
+                try:
+                    parser.stream.expect("assign")
+                except TemplateSyntaxError:
+                    parser.fail(f"metadata {token.value!r} must be assigned a value", token.lineno, exc=TemplateAssertionError)
+                value = parser.parse_expression()
+                if not isinstance(value, nodes.Const) or not isinstance(value.value, str):
+                    parser.fail(f"metadata {token.value!r} must be a string", token.lineno, exc=TemplateAssertionError)
+                if token.value in metadata:
+                    parser.fail(f"metadata {token.value!r} defined twice.", token.lineno, exc=TemplateAssertionError)
+                metadata[token.value] = value.value
+                continue
+            if token.value in variables:
+                parser.fail(f"translatable variable {token.value!r} defined twice.", token.lineno, exc=TemplateAssertionError)
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(nodes.Name("_trans", "store"), var)
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+        parser.stream.expect("block_end")
+        plural = None
+        have_plural = False
+        referenced = set()
+        singular_names, singular = self._parse_block(parser, True)
+        if singular_names:
+            referenced.update(singular_names)
+            if plural_expr is None:
+                plural_expr = nodes.Name(singular_names[0], "load")
+                num_called_num = singular_names[0] == "num"
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(f"unknown variable {token.value!r} for pluralization", token.lineno, exc=TemplateAssertionError)
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+            next(parser.stream)
+            referenced.update(plural_names)
+        else:
+            next(parser.stream)
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+        if trimmed is None:
+            trimmed = self.environment.policies["ext.i18n.trimmed"]
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+        node = self._make_node(singular, plural, variables, plural_expr, bool(referenced), num_called_num and have_plural)
+        node.set_lineno(lineno)
+        node.metadata = metadata
+        if plural_expr_assignment is not None:
+            return [plural_expr_assignment, node]
+        else:
+            return node
+"""
+
+# I need to find the start and end of `parse` again.
+# I'll use the same logic as before.
+lines = content.splitlines()
+start_index = -1
+end_index = -1
+for i, line in enumerate(lines):
+    if 'def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:' in line:
+        start_index = i
+    if start_index != -1 and 'return node' in line and 'else:' in lines[i-1]:
+        end_index = i
+        break
+
+new_lines = lines[:start_index] + [new_parse + "\n"] + lines[end_index+1:]
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(new_lines)
