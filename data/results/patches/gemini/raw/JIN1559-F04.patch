+    '        vars_referenced: bool,\n',
+    '        num_called_num: bool,\n',
+    '        metadata: t.Optional[t.Dict[str, str]],\n',
+    '    ) -> nodes.Output:\n'
+]
+lines[start_index:end_index] = new_signature
+
+# Now fix the `nodes.Call` constructor calls.
+# I need to make sure I don't break anything else.
+# I will search for `node = nodes.Call(` and add `metadata=metadata`.
+for i in range(len(lines)):
+    if 'node = nodes.Call(' in lines[i]:
+        # Check if it already has `metadata=metadata`
+        if 'metadata=metadata' not in lines[i]:
+            lines[i] = lines[i].replace('None, None)', 'None, None, metadata=metadata)')
