+start_index = -1
+for i, line in enumerate(lines):
+    if 'def _make_node(' in line:
+        start_index = i
+        break
+
+# The current `_make_node` is broken.
+# Let me replace it with the correct one.
+# I will find the end of the `_make_node` signature.
+# It seems I have a lot of lines that are part of the signature.
+# I will replace from `start_index` to the line before `"""Generates a useful node..."""`.
+end_index = -1
+for i in range(start_index, len(lines)):
+    if '"""Generates a useful node' in lines[i]:
+        end_index = i
+        break
+
+# Replace the broken signature
+new_signature = [
+    '    def _make_node(\n',
+    '        self,\n',
+    '        singular: str,\n',
+    '        plural: t.Optional[str],\n',
+    '        variables: t.Dict[str, nodes.Expr],\n',
