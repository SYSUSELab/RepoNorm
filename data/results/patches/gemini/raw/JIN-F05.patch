+from jinja2.runtime import Undefined
+from itertools import groupby
+
+class GroupKey:
+    def __init__(self, key):
+        self.key = key
+    
+    def __lt__(self, other):
+        return self._sort_key() < other._sort_key()
+    
+    def __eq__(self, other):
+        # For groupby, we need to define equality.
+        # If both are Undefined, they should be equal.
+        if isinstance(self.key, Undefined) and isinstance(other.key, Undefined):
+            return True
+        return self.key == other.key
+    
+    def _sort_key(self):
+        if isinstance(self.key, Undefined):
+            return (2, 0)
+        elif self.key is None:
+            return (1, 0)
+        else:
+            return (0, self.key)
+            
+    def __repr__(self):
+        return f"GroupKey({self.key!r})"
+
+# Test
+items = [None, '', 'z', Undefined(), None]
+# Wrap keys
+wrapped_items = [(GroupKey(k), k) for k in items]
+
+# Sort
+sorted_items = sorted(wrapped_items, key=lambda x: x[0])
+print(f"Sorted items: {sorted_items}")
+
+# Group
+groups = []
+for key, group in groupby(sorted_items, key=lambda x: x[0]):
+    # The key in the group tuple should be the original key.
+    # But we have GroupKey objects.
+    # We need to extract the original key.
+    
+    # If it's Undefined, we should probably return Undefined.
+    # If it's None, return None.
+    
+    original_key = key.key
+    groups.append((original_key, [item[1] for item in group]))
