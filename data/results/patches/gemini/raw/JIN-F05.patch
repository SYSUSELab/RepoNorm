+class GroupKey:
+    def __init__(self, key):
+        self.key = key
+    
+    def __lt__(self, other):
+        self_sort = self._sort_key()
+        other_sort = other._sort_key()
+        
+        if self_sort[0] != other_sort[0]:
+            return self_sort[0] < other_sort[0]
+        
+        if type(self_sort[1]) != type(other_sort[1]):
+            return False
+            
+        return self_sort[1] < other_sort[1]
+    
+    def __eq__(self, other):
+        if isinstance(self.key, Undefined) and isinstance(other.key, Undefined):
+            return True
+        return self.key == other.key
+    
+    def _sort_key(self):
+        if isinstance(self.key, Undefined):
+            return (2, 0)
+        elif self.key is None:
+            return (1, 0)
+        else:
+            return (0, self.key)
+
+def sync_do_groupby(
+    environment: "Environment",
+    value: "t.Iterable[V]",
+    attribute: t.Union[str, int],
+    default: t.Optional[t.Any] = None,
+    include_empty: bool = False,
+) -> "t.List[t.Tuple[t.Any, t.List[V]]]":
+    expr = make_attrgetter(environment, attribute, default=default)
+    
+    # 1. Resolve keys
+    items = []
+    for item in value:
+        key = expr(item)
+        if not include_empty and not key:
+            continue
+        items.append((GroupKey(key), item))
+    
+    # 2. Sort
+    items.sort(key=lambda x: x[0])
+    
+    # 3. Group
+    return [
+        _GroupTuple(key.key, [item[1] for item in group])
+        for key, group in groupby(items, key=lambda x: x[0])
+    ]
