+class IsCreditCard(DirtyEquals[str]):
+    """
+    Checks if the value is a valid credit card number using the Luhn algorithm.
+    """
+    def __init__(self, issuer: Optional[str] = None):
+        self.issuer = issuer
+        super().__init__(issuer=issuer)
+
+    def equals(self, other: Any) -> bool:
+        if isinstance(other, int):
+            other = str(other)
+        elif not isinstance(other, str):
+            return False
+        
+        # Remove spaces and hyphens
+        card_number = other.replace(' ', '').replace('-', '')
+        
+        # Check if it contains only digits
+        if not card_number.isdigit():
+            return False
+        
+        # Check length
+        if not (12 <= len(card_number) <= 19):
+            return False
+        
+        # Luhn algorithm
+        digits = [int(d) for d in card_number]
+        checksum = 0
+        reverse_digits = digits[::-1]
+        for i, digit in enumerate(reverse_digits):
+            if i % 2 == 1:
+                digit *= 2
+                if digit > 9:
+                    digit -= 9
+            checksum += digit
+        
+        if checksum % 10 != 0:
+            return False
+        
+        # Issuer check
+        if self.issuer:
+            if self.issuer == 'Visa':
+                if not (card_number.startswith('4') and len(card_number) in [13, 16, 19]):
+                    return False
+            elif self.issuer == 'Mastercard':
+                if len(card_number) != 16:
+                    return False
+                prefix = int(card_number[:2])
+                prefix4 = int(card_number[:4])
+                if not (51 <= prefix <= 55 or 2221 <= prefix4 <= 2720):
+                    return False
+            elif self.issuer == 'AmericanExpress':
+                if not (len(card_number) == 15 and (card_number.startswith('34') or card_number.startswith('37'))):
+                    return False
+            else:
+                # Unknown issuer
+                return False
+        
+        return True
diff --git a/tests/test_credit_card.py b/tests/test_credit_card.py
new file mode 100644
index 0000000..86c423d
--- /dev/null
+++ b/tests/test_credit_card.py
@@ -0,0 +1,15 @@
+from dirty_equals import IsCreditCard
+import pytest
+
+def test_credit_card_valid():
+    assert '4000000000000002' == IsCreditCard(issuer='Visa')
+    assert '5105105105105100' == IsCreditCard(issuer='Mastercard')
+    assert '340000000000009' == IsCreditCard(issuer='AmericanExpress')
+    assert '4000000000000002' == IsCreditCard()
+
+def test_credit_card_invalid():
+    assert '4000000000000001' != IsCreditCard()
+    assert '4000000000000002' != IsCreditCard(issuer='Mastercard')
+    assert '4000' != IsCreditCard()
+    assert '4000000000000002a' != IsCreditCard()
+    assert 123 != IsCreditCard()
