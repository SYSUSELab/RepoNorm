--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,47 @@
+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+import random
+
+# Mocking a program and predictor
+class SimpleModule(dspy.Module):
+    def __init__(self):
+        super().__init__()
+        self.predictor = dspy.Predict("input -> output")
+    def forward(self, input):
+        return self.predictor(input=input)
+
+class MockLM(dspy.LM):
+    def __init__(self):
+        super().__init__(model="mock")
+        self.kwargs = {"temperature": 0.7}
+    def __call__(self, prompt=None, messages=None, **kwargs):
+        print(f"LM called with temperature: {kwargs.get('temperature')}")
+        return {"completions": [{"text": '{"proposed_instruction": "new instruction"}'}]}
+
+# Setup
+lm = MockLM()
+dspy.settings.configure(lm=lm)
+program = SimpleModule()
+# Need to provide dummy trainset
+trainset = []
+proposer = GroundedProposer(prompt_model=lm, program=program, trainset=trainset)
+proposer.program_code_string = "code"
+proposer.data_summary = "summary"
+proposer.program_aware = False # Disable to avoid complex calls
+proposer.use_dataset_summary = False
+proposer.use_instruct_history = False
+proposer.use_tip = False
+proposer.verbose = True
+
+# Run proposal
+print("Running proposal...")
+proposer.propose_instruction_for_predictor(
+    program=program,
+    predictor=program.predictor,
+    pred_i=0,
+    T=0.7,
+    demo_candidates=[],
+    demo_set_i=0,
+    trial_logs={},
+)
+print("Final temperature:", lm.kwargs["temperature"])
