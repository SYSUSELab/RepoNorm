+    r'# Generate a new instruction for our predictor\n        cache_salt = "".join(self.rng.choices("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", k=16))\n        proposed_instruction = instruction_generator(\n            demo_candidates=demo_candidates,\n            pred_i=pred_i,\n            demo_set_i=demo_set_i,\n            program=program,\n            data_summary=self.data_summary,\n            previous_instructions=instruction_history,\n            num_demos_in_context = self.num_demos_in_context,\n            tip=tip,\n            cache_salt=cache_salt,\n        ).proposed_instruction',
+    content
