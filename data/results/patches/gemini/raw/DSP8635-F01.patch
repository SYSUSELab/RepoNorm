+import re
+
+with open('dspy/propose/grounded_proposer.py', 'r') as f:
+    content = f.read()
+
+# Update forward signature
+content = re.sub(
+    r'def forward\(\n\s+self,\n\s+demo_candidates,\n\s+pred_i,\n\s+demo_set_i,\n\s+program,\n\s+previous_instructions,\n\s+data_summary,\n\s+num_demos_in_context=3,\n\s+tip=None,\n\s+\):',
+    r'def forward(\n        self,\n        demo_candidates,\n        pred_i,\n        demo_set_i,\n        program,\n        previous_instructions,\n        data_summary,\n        num_demos_in_context=3,\n        tip=None,\n        cache_salt=None,\n    ):',
+    content
+)
+
+# Add cache_salt generation in forward
+content = re.sub(
+    r'# Summarize the program\n\s+program_description = "Not available"',
+    r'# Summarize the program\n        if cache_salt is None:\n            cache_salt = "".join(self.rng.choices("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", k=16))\n        program_description = "Not available"',
+    content
+)
+
+# Update describe_program call
+content = re.sub(
+    r'self.describe_program\(\n\s+program_code=self.program_code_string, program_example=task_demos,\n\s+\)',
+    r'self.describe_program(\n                        program_code=self.program_code_string, program_example=task_demos, cache_salt=cache_salt,\n                    )',
+    content
+)
+
+# Update describe_module call
+content = re.sub(
+    r'module_description = self.describe_module\(\n\s+program_code=self.program_code_string,\n\s+program_description=program_description,\n\s+program_example=task_demos,\n\s+module=module_code,\n\s+max_depth=10,\n\s+\)',
+    r'module_description = self.describe_module(\n                    program_code=self.program_code_string,\n                    program_description=program_description,\n                    program_example=task_demos,\n                    module=module_code,\n                    max_depth=10,\n                    cache_salt=cache_salt,\n                )',
+    content
+)
+
+# Update generate_module_instruction call
+content = re.sub(
+    r'instruct = self.generate_module_instruction\(\n\s+dataset_description=data_summary,\n\s+program_code=self.program_code_string,\n\s+module=module_code,\n\s+program_description=program_description,\n\s+module_description=module_description,\n\s+task_demos=task_demos,\n\s+tip=tip,\n\s+basic_instruction=basic_instruction,\n\s+previous_instructions=previous_instructions,\n\s+\)',
+    r'instruct = self.generate_module_instruction(\n            dataset_description=data_summary,\n            program_code=self.program_code_string,\n            module=module_code,\n            program_description=program_description,\n            module_description=module_description,\n            task_demos=task_demos,\n            tip=tip,\n            basic_instruction=basic_instruction,\n            previous_instructions=previous_instructions,\n            cache_salt=cache_salt,\n        )',
+    content
+)
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.write(content)
