+import sys
+
+with open('dspy/streaming/streamify.py', 'r') as f:
+    lines = f.readlines()
+
+# Add import
+lines.insert(0, "from anyio import EndOfStream\n")
+
+# Find the `async_streamer` function
+start_line = 0
+for i, line in enumerate(lines):
+    if "async def async_streamer(*args, **kwargs):" in line:
+        start_line = i
+        break
+
+# Find the end of `async_streamer`
+end_line = 0
+for i in range(start_line, len(lines)):
+    if "if async_streaming:" in lines[i]:
+        end_line = i
+        break
+
+# Replace the `async_streamer` function
+new_async_streamer = [
+    "    async def async_streamer(*args, **kwargs):\n",
+    "        send_stream, receive_stream = create_memory_object_stream(16)\n",
+    "        async with create_task_group() as tg, send_stream, receive_stream:\n",
+    "            tg.start_soon(generator, args, kwargs, send_stream)\n",
+    "\n",
+    "            min_timeout = None\n",
+    "            if stream_listeners:\n",
+    "                timeouts = [l.idle_timeout_s for l in stream_listeners if l.idle_timeout_s is not None]\n",
+    "                if timeouts:\n",
+    "                    min_timeout = min(timeouts)\n",
+    "\n",
+    "            while True:\n",
+    "                try:\n",
+    "                    if min_timeout:\n",
+    "                        value = await asyncio.wait_for(receive_stream.receive(), timeout=min_timeout)\n",
+    "                    else:\n",
+    "                        value = await receive_stream.receive()\n",
+    "                except asyncio.TimeoutError:\n",
+    "                    for listener in stream_listeners:\n",
+    "                        if listener.idle_timeout_s:\n",
+    "                            timeout_response = listener.tick()\n",
+    "                            if timeout_response:\n",
+    "                                yield timeout_response\n",
+    "                                tg.cancel_scope.cancel()\n",
+    "                                return\n",
+    "                    continue\n",
+    "                except EndOfStream:\n",
+    "                    break\n",
+    "\n",
+    "                if isinstance(value, ModelResponseStream):\n",
+    "                    if len(predict_id_to_listener) == 0:\n",
+    "                        yield value\n",
+    "                    else:\n",
+    "                        output = None\n",
+    "                        for listener in predict_id_to_listener[value.predict_id]:\n",
+    "                            output = listener.receive(value) or output\n",
+    "                        if output:\n",
+    "                            yield output\n",
+    "                elif isinstance(value, StatusMessage):\n",
+    "                    yield value\n",
+    "                elif isinstance(value, Prediction):\n",
+    "                    if include_final_prediction_in_output_stream:\n",
+    "                        yield value\n",
+    "                    elif (\n",
+    "                        len(stream_listeners) == 0\n",
+    "                        or any(listener.cache_hit for listener in stream_listeners)\n",
+    "                        or not any(listener.stream_start for listener in stream_listeners)\n",
+    "                    ):\n",
+    "                        yield value\n",
+    "                    return\n"
+]
+
+new_lines = lines[:start_line] + new_async_streamer + lines[end_line:]
+with open('dspy/streaming/streamify.py', 'w') as f:
+    f.writelines(new_lines)
