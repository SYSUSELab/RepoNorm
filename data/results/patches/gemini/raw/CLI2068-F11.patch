diff --git a/tests/test_monitor_process.py b/tests/test_monitor_process.py
new file mode 100644
index 0000000..288e95d
--- /dev/null
+++ b/tests/test_monitor_process.py
@@ -0,0 +1,24 @@
+import click
+import pytest
+import os
+import sys
+import time
+
+def test_monitor_process_callback():
+    events = []
+    def monitor_callback(event_type, process_id, editor_command, timestamp):
+        events.append((event_type, process_id, editor_command, timestamp))
+
+    # Use a simple command that exits immediately
+    os.environ["EDITOR"] = "true"
+    
+    click.edit("hello", monitor_process=monitor_callback)
+    
+    assert len(events) >= 2
+    assert events[0][0] == 'start'
+    assert events[-1][0] == 'terminate'
+    assert events[0][1] == events[-1][1]
+
+def test_monitor_process_invalid_callback():
+    with pytest.raises(TypeError):
+        click.edit("hello", monitor_process="not a callable")
