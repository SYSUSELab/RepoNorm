+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_cache():
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    # Mock translation functions
+    call_count = 0
+    def gettext(s):
+        nonlocal call_count
+        call_count += 1
+        return s.upper()
+    
+    def ngettext(s, p, n):
+        return s if n == 1 else p
+        
+    env.install_gettext_callables(gettext, ngettext, cache_size=10)
+    
+    # Test caching
+    assert env.globals['gettext']("hello") == "HELLO"
+    assert call_count == 1
+    assert env.globals['gettext']("hello") == "HELLO"
+    assert call_count == 1 # Should be cached
+    
+    # Test partition
+    env.set_translation_cache_partition("en")
+    assert env.globals['gettext']("hello") == "HELLO"
+    assert call_count == 2 # Partition change should clear cache
+    
+    # Test resize
+    env.resize_translation_cache(0)
+    assert env.globals['gettext']("hello") == "HELLO"
+    assert call_count == 3 # Cache disabled
+    
+    print("Cache tests passed!")
+
+test_cache()
