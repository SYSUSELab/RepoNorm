+    '        self.partition = partition\n',
+    '\n',
+    '    def set_partition(self, value: t.Any) -> None:\n',
+    '        self.partition = value\n',
+    '        if self.cache is not None:\n',
+    '            self.cache.clear()\n',
+    '\n',
+    '    def clear(self) -> None:\n',
+    '        if self.cache is not None:\n',
