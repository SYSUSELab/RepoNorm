+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_cache():
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    # Mock translations
+    call_count = 0
+    class Translations:
+        def gettext(self, message):
+            nonlocal call_count
+            call_count += 1
+            return "translated " + message
+        def ngettext(self, singular, plural, n):
+            return singular if n == 1 else plural
+        def pgettext(self, context, message):
+            return message
+        def npgettext(self, context, singular, plural, n):
+            return singular if n == 1 else plural
+
+    translations = Translations()
+    
+    # Install with cache
+    env.install_gettext_callables(
+        translations.gettext,
+        translations.ngettext,
+        pgettext=translations.pgettext,
+        npgettext=translations.npgettext,
+        cache_size=10
+    )
+    
+    # Test caching
+    gettext = env.globals["gettext"]
+    print(gettext("hello"))
+    print(gettext("hello"))
+    print(f"Call count: {call_count}")
+    assert call_count == 1
+    
+    # Test partition
+    env.set_translation_cache_partition("p1")
+    print(gettext("hello"))
+    assert call_count == 2
+    
+    # Test clear
+    env.clear_translation_cache()
+    print(gettext("hello"))
+    assert call_count == 3
+    
+    # Test resize
+    env.resize_translation_cache(0)
+    print(gettext("hello"))
+    assert call_count == 4
+    print(gettext("hello"))
+    assert call_count == 5
+
+if __name__ == "__main__":
+    test_cache()
