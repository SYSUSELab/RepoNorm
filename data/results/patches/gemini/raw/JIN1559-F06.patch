+class TranslationCache:
+    def __init__(self, size: int, partition: t.Any = None):
+        self.cache = LRUCache(size) if size > 0 else None
+        self.partition = partition
+
+    def set_partition(self, value: t.Any) -> None:
+        self.partition = value
+        if self.cache is not None:
+            self.cache.clear()
+
+    def clear(self) -> None:
+        if self.cache is not None:
+            self.cache.clear()
+
+    def resize(self, capacity: int) -> None:
+        if capacity < 0:
+            raise ValueError("Capacity must be non-negative")
+        if capacity == 0:
+            self.cache = None
+        else:
+            self.cache = LRUCache(capacity)
+
+    def get(self, kind: str, context: t.Optional[str], singular: str, plural: t.Optional[str], count: t.Optional[int]) -> t.Any:
+        if self.cache is None:
+            return None
+        key = (kind, context, singular, plural, count, self.partition)
+        return self.cache.get(key)
+
+    def set(self, kind: str, context: t.Optional[str], singular: str, plural: t.Optional[str], count: t.Optional[int], value: str) -> None:
+        if self.cache is not None:
+            key = (kind, context, singular, plural, count, self.partition)
+            self.cache[key] = value
+
+def wrap_gettext(func, cache: TranslationCache):
+    def wrapper(message):
+        cached = cache.get("gettext", None, message, None, None)
+        if cached is not None:
+            return cached
+        result = func(message)
+        cache.set("gettext", None, message, None, None, result)
+        return result
+    return wrapper
+
+def wrap_ngettext(func, cache: TranslationCache):
+    def wrapper(singular, plural, n):
+        cached = cache.get("ngettext", None, singular, plural, n)
+        if cached is not None:
+            return cached
+        result = func(singular, plural, n)
+        cache.set("ngettext", None, singular, plural, n, result)
+        return result
+    return wrapper
+
+# Test
+def real_gettext(m): return "translated " + m
+cache = TranslationCache(10)
+wrapped = wrap_gettext(real_gettext, cache)
+print(wrapped("hello"))
+print(wrapped("hello"))
