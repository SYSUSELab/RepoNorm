+from jinja2.utils import LRUCache
+
+# Keys include the function kind, context where applicable, singular and plural messages, plural count, and the caller-supplied hashable partition.
+# kind: gettext, ngettext, pgettext, npgettext
+# context: optional
+# singular: str
+# plural: str (for ngettext/npgettext)
+# count: int (for ngettext/npgettext)
+# partition: hashable
+
+def get_key(kind, context, singular, plural, count, partition):
+    return (kind, context, singular, plural, count, partition)
+
+cache = LRUCache(10)
+cache[get_key("gettext", None, "hello", None, None, "part1")] = "bonjour"
+print(cache.get(get_key("gettext", None, "hello", None, None, "part1")))
