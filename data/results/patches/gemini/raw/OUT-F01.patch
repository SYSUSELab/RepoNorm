+tokenizer_info = xgr.TokenizerInfo.from_huggingface(tokenizer, vocab_size=vocab_size)
+compiler = xgr.GrammarCompiler(tokenizer_info)
+compiled_grammar = compiler.compile_regex(r"\d+")
