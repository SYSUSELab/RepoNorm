+import json
+import re
+
+def parse_json_with_comments(text):
+    # Split by lines, remove comments, join back
+    lines = text.splitlines()
+    cleaned_lines = []
+    comments = []
+    
+    for line in lines:
+        # Find the first # that is not in a string
+        in_string = False
+        escaped = False
+        comment_start = -1
+        
+        for i, char in enumerate(line):
+            if char == '"' and not escaped:
+                in_string = not in_string
+            elif char == '\\' and not escaped:
+                escaped = True
+            elif char == '#' and not in_string:
+                comment_start = i
+                break
+            else:
+                escaped = False
+        
+        if comment_start != -1:
+            cleaned_lines.append(line[:comment_start])
+            comments.append(line[comment_start+1:].strip())
+        else:
+            cleaned_lines.append(line)
+            
+    cleaned_text = "\n".join(cleaned_lines)
+    # Need to handle the case where the JSON might be a list or a dict
+    # The requirement says: "Accept a single call, a bare list or the canonical tool_calls container."
+    # The canonical container is {"type": "tool_calls", "tool_calls": [...]}
+    
+    data = json.loads(cleaned_text)
+    return data, "\n".join(c for c in comments if c)
+
+# Test
+text1 = '{"name": "test", "args": {"a": 1}} # comment 1'
+text2 = '[{"name": "test", "args": {"a": 1}}] # comment 2'
+text3 = '{"type": "tool_calls", "tool_calls": [{"name": "test", "args": {"a": 1}}]} # comment 3'
+
+for t in [text1, text2, text3]:
+    data, comment = parse_json_with_comments(t)
+    print(f"Data: {data}, Comment: {comment}")
