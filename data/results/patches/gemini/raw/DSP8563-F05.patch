+import json
+import re
+
+def parse_json_with_comments(text):
+    # Split by lines, remove comments, join back
+    lines = text.splitlines()
+    cleaned_lines = []
+    comments = []
+    
+    for line in lines:
+        # Find the first # that is not in a string
+        in_string = False
+        escaped = False
+        comment_start = -1
+        
+        for i, char in enumerate(line):
+            if char == '"' and not escaped:
+                in_string = not in_string
+            elif char == '\\' and not escaped:
+                escaped = True
+            elif char == '#' and not in_string:
+                comment_start = i
+                break
+            else:
+                escaped = False
+        
+        if comment_start != -1:
+            cleaned_lines.append(line[:comment_start])
+            comments.append(line[comment_start+1:].strip())
+        else:
+            cleaned_lines.append(line)
+            
+    cleaned_text = "\n".join(cleaned_lines)
+    return json.loads(cleaned_text), "\n".join(c for c in comments if c)
+
+# Test
+text = '''
+{
+    "name": "test", # comment 1
+    "args": {"a": 1} # comment 2
+}
+# comment 3
+'''
+data, comment = parse_json_with_comments(text)
+print(f"Data: {data}")
+print(f"Comment: {comment}")
