+++ b/test_json_comments.py
@@ -0,0 +1,40 @@
+import json
+import re
+
+def parse_json_with_comments(text):
+    # Remove Python-style # comments
+    # This regex handles # comments, but we need to be careful about # inside strings
+    # A better approach is to iterate through the string
+    
+    result = []
+    in_string = False
+    escaped = False
+    
+    cleaned_text = ""
+    comment_text = ""
+    
+    i = 0
+    while i < len(text):
+        char = text[i]
+        
+        if char == '"' and not escaped:
+            in_string = not in_string
+            cleaned_text += char
+        elif char == '\\' and not escaped:
+            escaped = True
+            cleaned_text += char
+        elif char == '#' and not in_string:
+            # Start of a comment
+            comment_text += text[i+1:]
+            break
+        else:
+            if escaped:
+                escaped = False
+            cleaned_text += char
+        i += 1
+        
+    return json.loads(cleaned_text), comment_text
+
+# Test
+text = '{"name": "test", "args": {"a": 1}} # This is a comment'
+print(parse_json_with_comments(text))
