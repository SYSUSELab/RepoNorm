+# Global registry for filters
+_GLOBAL_FILTERS: Dict[str, Callable] = {}
+_PROTECTED_FILTERS = {"name", "description", "source", "signature", "schema", "args"}
+
+def register_filter(name: str, callable: Callable):
+    """Register a global filter."""
+    if name in _PROTECTED_FILTERS:
+        raise ValueError(f"Filter '{name}' is protected and cannot be overridden.")
+    _GLOBAL_FILTERS[name] = callable
+
+def unregister_filter(name: str):
+    """Unregister a global filter."""
+    if name in _GLOBAL_FILTERS:
+        del _GLOBAL_FILTERS[name]
+
+def _get_default_filters():
+    return {
+        "name": get_fn_name,
+        "description": get_fn_description,
+        "source": get_fn_source,
+        "signature": get_fn_signature,
+        "schema": get_schema,
+        "args": get_fn_args,
+    }
 
