+    lines = f.readlines()
+
+# Find the docstring
+for i, line in enumerate(lines):
+    if 'Args:' in line:
+        # Insert the compress parameter description
+        lines.insert(i + 1, '        compress: Whether to collapse adjacent repeated token IDs.\n')
+        break
+
+with open('tiktoken/core.py', 'w') as f:
+    f.writelines(lines)
