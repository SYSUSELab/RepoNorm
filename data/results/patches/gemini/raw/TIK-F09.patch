+import sys
+
+with open('tiktoken/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Define the compression function
+compression_func = """
+        if compress:
+            if not tokens:
+                return []
+            compressed = [tokens[0]]
+            for token in tokens[1:]:
+                if token != compressed[-1]:
+                    compressed.append(token)
+            return compressed
+        return tokens
+"""
+
+# We need to replace the return statements.
+# The first return is at line 123: return self._core_bpe.encode(text, allowed_special)
+# The second return is at line 133: return self._core_bpe.encode(text, allowed_special)
+
+# Let's find the lines again to be sure.
+# Actually, I can just replace the return statements with a call to a helper or just inline the logic.
+# Let's inline the logic for simplicity.
+
+new_lines = []
+for line in lines:
+    if 'return self._core_bpe.encode(text, allowed_special)' in line:
+        indent = line[:line.find('return')]
+        new_lines.append(f'{indent}tokens = self._core_bpe.encode(text, allowed_special)\n')
+        new_lines.append(f'{indent}if compress:\n')
+        new_lines.append(f'{indent}    if not tokens:\n')
+        new_lines.append(f'{indent}        return []\n')
+        new_lines.append(f'{indent}    compressed = [tokens[0]]\n')
+        new_lines.append(f'{indent}    for token in tokens[1:]:\n')
+        new_lines.append(f'{indent}        if token != compressed[-1]:\n')
+        new_lines.append(f'{indent}            compressed.append(token)\n')
+        new_lines.append(f'{indent}    return compressed\n')
+        new_lines.append(f'{indent}return tokens\n')
+    else:
+        new_lines.append(line)
+
+with open('tiktoken/core.py', 'w') as f:
+    f.writelines(new_lines)
