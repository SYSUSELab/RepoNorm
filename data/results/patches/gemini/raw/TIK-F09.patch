+import tiktoken
+
+enc = tiktoken.get_encoding("gpt2")
+text = "The dog dog dog ran ran quickly"
+encoded = enc.encode(text)
+print(f"Original: {encoded}")
+
+# This is what we want to implement
+def compress_tokens(tokens):
+    if not tokens:
+        return []
+    compressed = [tokens[0]]
+    for token in tokens[1:]:
+        if token != compressed[-1]:
+            compressed.append(token)
+    return compressed
+
+# We expect the user to be able to do:
+# encoded_compressed = enc.encode(text, compress=True)
+# For now, let's just simulate it
+compressed = compress_tokens(encoded)
+print(f"Compressed: {compressed}")
