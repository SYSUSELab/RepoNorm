diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 0000000..912203e
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,27 @@
+import tiktoken
+
+enc = tiktoken.get_encoding("gpt2")
+text = "The dog dog dog ran ran quickly"
+
+# Test without compression
+encoded = enc.encode(text)
+print(f"Original: {encoded}")
+
+# Test with compression
+encoded_compressed = enc.encode(text, compress=True)
+print(f"Compressed: {encoded_compressed}")
+
+# Verify compression
+expected = [464, 3290, 4966, 2952]
+assert encoded_compressed == expected, f"Expected {expected}, but got {encoded_compressed}"
+
+# Test empty string
+assert enc.encode("", compress=True) == []
+
+# Test no repetition
+text2 = "The dog ran"
+encoded2 = enc.encode(text2)
+encoded2_compressed = enc.encode(text2, compress=True)
+assert encoded2 == encoded2_compressed
+
+print("All tests passed!")
