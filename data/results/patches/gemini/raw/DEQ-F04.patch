@@ -0,0 +1,27 @@
+from dirty_equals import IsURL
+
+def test_isurl_v2():
+    # Test positional arguments
+    assert 'https://example.com' == IsURL('https')
+    assert 'https://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com' == IsURL('https', 'example.com')
+    
+    # Test representation
+    assert repr(IsURL()) == 'IsURL()'
+    assert repr(IsURL('https')) == "IsURL('https')"
+    assert repr(IsURL(domain='example.com')) == "IsURL('example.com')"
+    assert repr(IsURL('https', 'example.com')) == "IsURL('https', 'example.com')"
+    
+    # Test domain matching with port
+    assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'https://example.com:8080' != IsURL(domain='example.com')
+    
+    # Test protocol collections
+    assert 'https://example.com' == IsURL(['http', 'https'])
+    assert 'http://example.com' == IsURL({'http', 'https'})
+    assert 'ftp://example.com' != IsURL(['http', 'https'])
+    
+    print("All tests passed!")
+
+if __name__ == '__main__':
+    test_isurl_v2()
