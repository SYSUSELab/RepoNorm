+    # Both / and \ are logical separators
+    template = template.replace("\\", "/")
+    
+    # Reject names beginning with / or \
+    if template.startswith("/"):
+        raise TemplateNotFound(template)
+    
+    # Reject UNC forms (e.g., //server/share)
+    if template.startswith("//"):
+        raise TemplateNotFound(template)
+    
+    # Reject names beginning with an ASCII drive prefix such as C:
+    if len(template) >= 2 and template[1] == ":" and template[0].isalpha():
+        raise TemplateNotFound(template)
+    
+    # Split into segments
+    parts = template.split("/")
+    
+    # Normalize segments
+    normalized_parts = []
+    for part in parts:
+        if part == "" or part == ".":
+            continue
+        if part == "..":
+            if not normalized_parts:
+                # Reject .. that would pop beyond the logical root
+                raise TemplateNotFound(template)
+            normalized_parts.pop()
+        else:
+            normalized_parts.append(part)
+            
+    return normalized_parts
+
 
 
