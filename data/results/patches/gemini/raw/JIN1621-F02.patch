+def test_template_path_normalization():
+    from jinja2 import FileSystemLoader, TemplateNotFound
+    import os
+    
+    # Create a temporary directory for templates
+    os.makedirs("templates", exist_ok=True)
+    with open("templates/test.html", "w") as f:
+        f.write("hello")
+    
+    loader = FileSystemLoader("templates")
+    
+    # Test cases
+    assert loader.get_source(None, "foo/../test.html")[1].endswith("test.html")
+    assert loader.get_source(None, "foo\\..\\test.html")[1].endswith("test.html")
+    
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(None, "../test.html")
+    
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(None, "a/../../test.html")
+        
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(None, "/test.html")
+        
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(None, "C:/test.html")
+        
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(None, "//server/share")
