@@ -0,0 +1,25 @@
+def check_required_if(ctx, param, value):
+    if param.required_if is None:
+        return
+
+    # If the target already has a non-missing value, validation succeeds.
+    if not param.value_is_missing(value):
+        return
+
+    required = False
+    if callable(param.required_if):
+        required = param.required_if(ctx, param)
+    elif isinstance(param.required_if, dict):
+        required = True
+        for key, expected_value in param.required_if.items():
+            # Get the value of the parameter from the context
+            # The key is the normalized Python parameter name
+            if ctx.params.get(key) != expected_value:
+                required = False
+                break
+    else:
+        raise TypeError(f"required_if must be a mapping or a callable, not {type(param.required_if)}")
+
+    if required:
+        from click.exceptions import MissingParameter
+        raise MissingParameter(ctx=ctx, param=param)
