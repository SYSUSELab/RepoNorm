+
+def test_edit_editor_args(tmp_path):
+    import click
+    import os
+    import json
+    
+    # Create a mock editor script
+    mock_editor = tmp_path / "mock_editor.py"
+    mock_editor.write_text("""
+import sys
+import json
+with open("args.json", "w") as f:
+    json.dump(sys.argv, f)
+""")
+    
+    # Use click.edit with editor_args
+    args_file = tmp_path / "args.json"
+    # We need to make sure the mock editor writes to the right place.
+    # Let's change the mock editor to write to a specific file.
+    mock_editor.write_text(f"""
+import sys
+import json
+with open("{args_file}", "w") as f:
+    json.dump(sys.argv, f)
+""")
+    
+    click.edit("hello", editor=f"python3 {mock_editor}", editor_args=["--arg1", "--arg2"])
+    
+    with open(args_file, "r") as f:
+        args = json.load(f)
+    
+    assert args[0] == str(mock_editor)
+    assert args[1] == "--arg1"
+    assert args[2] == "--arg2"
+    assert args[3].endswith(".txt")
