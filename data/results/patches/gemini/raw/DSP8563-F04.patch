+import json
+from dspy.adapters.types.tool import ToolCalls
+from pydantic import BaseModel
+
+def test_fingerprint():
+    # Test case 1: Basic ToolCall
+    tool_call_dict = {"name": "test_tool", "args": {"a": 1, "b": "hello"}}
+    tool_calls = ToolCalls.from_dict_list([tool_call_dict])
+    
+    # Check if fingerprint and id exist
+    try:
+        print(f"Fingerprint: {tool_calls.tool_calls[0].fingerprint}")
+        print(f"ID: {tool_calls.tool_calls[0].id}")
+    except AttributeError:
+        print("Fingerprint or ID not found")
+
+    # Test case 2: Check immutability
+    tool_call = tool_calls.tool_calls[0]
+    original_fingerprint = tool_call.fingerprint
+    
+    # Try to modify args
+    tool_call.args = {"a": 2}
+    
+    if tool_call.fingerprint == original_fingerprint:
+        print("Fingerprint is immutable")
+    else:
+        print("Fingerprint changed!")
+
+if __name__ == "__main__":
+    test_fingerprint()
