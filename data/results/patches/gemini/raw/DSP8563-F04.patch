+import json
+import hashlib
+from typing import Any
+
+def get_fingerprint(name: str, args: dict[str, Any]) -> str:
+    def prepare_args(args: Any) -> Any:
+        if isinstance(args, dict):
+            return {k: prepare_args(v) for k, v in sorted(args.items())}
+        elif isinstance(args, (list, tuple)):
+            return [prepare_args(i) for i in args]
+        elif isinstance(args, str):
+            return args.strip()
+        return args
+
+    canonical_args = prepare_args(args)
+    
+    # The object to hash is {"name": name, "args": canonical_args}
+    # Keys must be sorted.
+    obj_to_hash = {"args": canonical_args, "name": name}
+    
+    # Compact JSON
+    json_str = json.dumps(obj_to_hash, sort_keys=True, separators=(',', ':'))
+    
+    return hashlib.sha256(json_str.encode('utf-8')).hexdigest()
+
+# Test
+name = "test_tool"
+args = {"b": " hello ", "a": 1}
+fingerprint = get_fingerprint(name, args)
+print(f"Fingerprint: {fingerprint}")
+print(f"ID: {fingerprint[:8]}")
