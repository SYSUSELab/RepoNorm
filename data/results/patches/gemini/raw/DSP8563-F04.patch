+import pytest
+from dspy.adapters.types.tool import ToolCalls
+
+def test_edge_cases():
+    # Test tuple as list
+    tool_call_dict = {"name": "test_tool", "args": {"a": (1, 2)}}
+    tool_calls = ToolCalls.from_dict_list([tool_call_dict])
+    f1 = tool_calls.tool_calls[0].fingerprint
+    
+    # Test list
+    tool_call_dict2 = {"name": "test_tool", "args": {"a": [1, 2]}}
+    tool_calls2 = ToolCalls.from_dict_list([tool_call_dict2])
+    f2 = tool_calls2.tool_calls[0].fingerprint
+    
+    assert f1 == f2
+    print("Tuple/List equivalence passed")
+
+    # Test non-finite number
+    try:
+        ToolCalls.from_dict_list([{"name": "test", "args": {"a": float('inf')}}])
+        assert False, "Should have raised ValueError"
+    except ValueError:
+        print("Non-finite number check passed")
+
+    # Test non-string key
+    try:
+        ToolCalls.from_dict_list([{"name": "test", "args": {1: "a"}}])
+        assert False, "Should have raised ValueError"
+    except ValueError:
+        print("Non-string key check passed")
+
+if __name__ == "__main__":
+    test_edge_cases()
