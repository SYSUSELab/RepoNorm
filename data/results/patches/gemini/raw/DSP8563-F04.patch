+++ b/test_fingerprint_logic.py
@@ -0,0 +1,51 @@
+import json
+import hashlib
+from typing import Any
+
+def canonical_json(obj: Any) -> str:
+    def sort_dict(d: Any) -> Any:
+        if isinstance(d, dict):
+            return {k: sort_dict(v) for k, v in sorted(d.items())}
+        elif isinstance(d, list):
+            return [sort_dict(i) for i in d]
+        elif isinstance(d, tuple):
+            return [sort_dict(i) for i in d]
+        elif isinstance(d, str):
+            return d.strip()
+        return d
+
+    # The requirement says:
+    # "The fingerprint is the 64-character hexadecimal SHA-256 of the UTF-8 canonical JSON object
+    # {"name": name, "args": canonical_args}, using sorted keys and compact comma/colon separators
+    # with ordinary JSON ASCII escaping."
+    
+    # "In arguments, recursively sort dictionary keys, treat tuples as lists and trim surrounding
+    # whitespace from string values."
+    
+    # "Do not trim dictionary keys or the tool name."
+    
+    # Let's implement this.
+    
+    def prepare_args(args: Any) -> Any:
+        if isinstance(args, dict):
+            return {k: prepare_args(v) for k, v in sorted(args.items())}
+        elif isinstance(args, (list, tuple)):
+            return [prepare_args(i) for i in args]
+        elif isinstance(args, str):
+            return args.strip()
+        return args
+
+    canonical_args = prepare_args(obj["args"])
+    
+    # The object to hash is {"name": name, "args": canonical_args}
+    # Keys must be sorted.
+    obj_to_hash = {"args": canonical_args, "name": obj["name"]}
+    
+    # Compact JSON
+    json_str = json.dumps(obj_to_hash, sort_keys=True, separators=(',', ':'))
+    
+    return hashlib.sha256(json_str.encode('utf-8')).hexdigest()
+
+# Test
+tool_call = {"name": "test_tool", "args": {"b": " hello ", "a": 1}}
+print(canonical_json(tool_call))
