+++ b/test_fingerprint.py
@@ -0,0 +1,21 @@
+from dspy.adapters.types.tool import ToolCalls
+
+def test_fingerprint():
+    # The requirement says: "In arguments, recursively sort dictionary keys, treat tuples as lists and trim surrounding whitespace from string values."
+    # So {"a": 1, "b": "  hello  "} should be the same as {"a": 1, "b": "hello"}
+    
+    tool_call1 = ToolCalls.ToolCall(name="my_tool", args={"a": 1, "b": "  hello  "})
+    tool_call2 = ToolCalls.ToolCall(name="my_tool", args={"a": 1, "b": "hello"})
+    
+    # They SHOULD be the same
+    assert tool_call1.fingerprint == tool_call2.fingerprint
+    
+    # Now let's test something that SHOULD be different
+    tool_call3 = ToolCalls.ToolCall(name="my_tool", args={"a": 1, "b": "hello"})
+    tool_call4 = ToolCalls.ToolCall(name="my_tool", args={"a": 2, "b": "hello"})
+    assert tool_call3.fingerprint != tool_call4.fingerprint
+    
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_fingerprint()
diff --git a/test_fingerprint_logic.py b/test_fingerprint_logic.py
