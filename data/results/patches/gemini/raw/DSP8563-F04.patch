+import pytest
+from dspy.adapters.types.tool import ToolCalls
+from pydantic import ValidationError
+
+def test_validation():
+    # Test non-finite number
+    with pytest.raises(ValueError, match="Non-finite number"):
+        ToolCalls.ToolCall(name="my_tool", args={"a": float('inf')})
+    
+    # Test non-string dictionary key (Pydantic will catch this first)
+    with pytest.raises(ValidationError):
+        ToolCalls.ToolCall(name="my_tool", args={1: "value"})
+        
+    # Test unsupported type
+    with pytest.raises(ValueError, match="Unsupported type"):
+        ToolCalls.ToolCall(name="my_tool", args={"a": set([1, 2])})
+
+    print("Validation tests passed!")
+
+if __name__ == "__main__":
+    test_validation()
