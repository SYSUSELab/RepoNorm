+assert '001122334455' == IsMac()
+assert '00:11:22:33:44:55' == IsMac('colon')
+assert '00:11:22:33:44:55' != IsMac('hyphen')
+assert '00-11-22-33-44-55' == IsMac('hyphen')
+assert '0011.2233.4455' == IsMac('dot')
+assert '001122334455' == IsMac('compact')
+assert '00:11:22:33:44:55' != IsMac('compact')
+assert '00:11:22:33:44:5' != IsMac() # malformed length
+assert '00:11:22:33:44:555' != IsMac() # malformed length
+assert '00:11:22:33:44:gg' != IsMac() # non-hex
+assert '00:11:22:33:44:55 ' != IsMac() # trailing space
+assert ' 00:11:22:33:44:55' != IsMac() # leading space
+assert 123 != IsMac() # non-string
+
+print("All tests passed!")
