+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address.
+    """
+
+    _regexes = {
+        'colon': r'([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}',
+        'hyphen': r'([0-9a-fA-F]{2}-){5}[0-9a-fA-F]{2}',
+        'dot': r'[0-9a-fA-F]{4}\.[0-9a-fA-F]{4}\.[0-9a-fA-F]{4}',
+        'compact': r'[0-9a-fA-F]{12}',
+    }
+
+    def __init__(self, format: Optional[Literal['colon', 'hyphen', 'dot', 'compact']] = None):
+        """
+        Args:
+            format: The format of the MAC address to check. If omitted, all formats are accepted.
+        """
+        self.format = format
+        if format:
+            super().__init__(format)
+        else:
+            super().__init__(plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format:
+            pattern = f'^{self._regexes[self.format]}$'
+            return bool(re.fullmatch(pattern, other))
+        else:
+            for regex in self._regexes.values():
+                pattern = f'^{regex}$'
+                if re.fullmatch(pattern, other):
+                    return True
+            return False
diff --git a/reproduce_mac_validator.py b/reproduce_mac_validator.py
new file mode 100644
index 0000000..0c66788
--- /dev/null
+++ b/reproduce_mac_validator.py
@@ -0,0 +1,61 @@
+import re
+from dirty_equals import IsStr
+
+# MAC address regexes
+# colon: 00:11:22:33:44:55
+# hyphen: 00-11-22-33-44-55
+# dot: 0011.2233.4455
+# compact: 001122334455
+
+# The requirement says:
+# - With no format argument, accept six-octet hexadecimal MAC addresses in
+#   colon-separated, hyphen-separated, three-group dotted, and compact forms.
+# - Matching hexadecimal digits is case-insensitive, but malformed lengths,
+#   non-hexadecimal characters, mixed separators, and non-string values compare
+#   unequal.
+# - The optional format is one of `colon`, `hyphen`, `dot`, or `compact`; when
+#   supplied, otherwise valid addresses in a different form compare unequal.
+
+# Let's define the regexes
+MAC_REGEXES = {
+    'colon': r'([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}',
+    'hyphen': r'([0-9a-fA-F]{2}-){5}[0-9a-fA-F]{2}',
+    'dot': r'[0-9a-fA-F]{4}\.[0-9a-fA-F]{4}\.[0-9a-fA-F]{4}',
+    'compact': r'[0-9a-fA-F]{12}',
+}
+
+def is_mac(value, format=None):
+    if not isinstance(value, str):
+        return False
+    
+    if format:
+        if format not in MAC_REGEXES:
+            raise ValueError(f"Invalid format: {format}")
+        pattern = f'^{MAC_REGEXES[format]}$'
+        return bool(re.fullmatch(pattern, value))
+    else:
+        for fmt, regex in MAC_REGEXES.items():
+            pattern = f'^{regex}$'
+            if re.fullmatch(pattern, value):
+                return True
+        return False
+
+# Test cases
+assert is_mac('00:11:22:33:44:55') == True
+assert is_mac('00-11-22-33-44-55') == True
+assert is_mac('0011.2233.4455') == True
+assert is_mac('001122334455') == True
+assert is_mac('00:11:22:33:44:55', format='colon') == True
+assert is_mac('00:11:22:33:44:55', format='hyphen') == False
+assert is_mac('00-11-22-33-44-55', format='hyphen') == True
+assert is_mac('0011.2233.4455', format='dot') == True
+assert is_mac('001122334455', format='compact') == True
+assert is_mac('00:11:22:33:44:55', format='compact') == False
+assert is_mac('00:11:22:33:44:5') == False # malformed length
+assert is_mac('00:11:22:33:44:555') == False # malformed length
+assert is_mac('00:11:22:33:44:gg') == False # non-hex
+assert is_mac('00:11:22:33:44:55 ') == False # trailing space
+assert is_mac(' 00:11:22:33:44:55') == False # leading space
+assert is_mac(123) == False # non-string
+
+print("All tests passed!")
