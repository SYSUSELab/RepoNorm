diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..0ed2b07 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -543,3 +543,42 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+def test_context_cleanup_timeout():
+    import time
+    import warnings
+    
+    @click.command()
+    def cmd():
+        pass
+        
+    # Test that cleanup_timeout is passed correctly
+    ctx = click.Context(cmd, cleanup_timeout=0.5)
+    assert ctx.cleanup_timeout == 0.5
+    
+    # Test that it inherits from parent
+    child_ctx = click.Context(cmd, parent=ctx)
+    assert child_ctx.cleanup_timeout == 0.5
+    
+    # Test that it can be overridden
+    child_ctx_override = click.Context(cmd, parent=ctx, cleanup_timeout=0.2)
+    assert child_ctx_override.cleanup_timeout == 0.2
+    
+    # Test that it raises ValueError for non-positive timeout
+    try:
+        click.Context(cmd, cleanup_timeout=0)
+    except ValueError:
+        pass
+    else:
+        assert False, "Should have raised ValueError"
+
+    # Test that it times out
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        ctx = click.Context(cmd, cleanup_timeout=0.01)
+        @ctx.call_on_close
+        def slow():
+            time.sleep(0.1)
+        ctx.close()
+        assert len(w) > 0
+        assert "Cleanup timed out" in str(w[-1].message)
