diff --git a/tests/test_loader_aliases.py b/tests/test_loader_aliases.py
new file mode 100644
index 0000000..cfc501f
--- /dev/null
+++ b/tests/test_loader_aliases.py
@@ -0,0 +1,39 @@
+import pytest
+from jinja2 import DictLoader, Environment, TemplateNotFound
+
+def test_alias_basic():
+    loader = DictLoader({'foo.html': 'Hello, World!'})
+    loader.add_alias('bar.html', 'foo.html')
+    env = Environment(loader=loader)
+    assert env.get_template('bar.html').render() == 'Hello, World!'
+
+def test_alias_invalidation():
+    loader = DictLoader({'foo.html': 'Hello, World!', 'baz.html': 'Hi, Baz!'})
+    loader.add_alias('bar.html', 'foo.html')
+    env = Environment(loader=loader)
+    assert env.get_template('bar.html').render() == 'Hello, World!'
+    
+    loader.add_alias('bar.html', 'baz.html')
+    assert env.get_template('bar.html').render() == 'Hi, Baz!'
+
+def test_alias_remove():
+    loader = DictLoader({'foo.html': 'Hello, World!'})
+    loader.add_alias('bar.html', 'foo.html')
+    loader.remove_alias('bar.html')
+    env = Environment(loader=loader)
+    with pytest.raises(TemplateNotFound):
+        env.get_template('bar.html')
+
+def test_list_templates():
+    loader = DictLoader({'foo.html': 'Hello, World!'})
+    loader.add_alias('bar.html', 'foo.html')
+    loader.add_alias('broken.html', 'nonexistent.html')
+    assert sorted(loader.list_templates()) == ['bar.html', 'foo.html']
+
+def test_alias_chaining():
+    loader = DictLoader({'foo.html': 'Hello, World!'})
+    loader.add_alias('bar.html', 'foo.html')
+    loader.add_alias('baz.html', 'bar.html')
+    env = Environment(loader=loader)
+    with pytest.raises(TemplateNotFound):
+        env.get_template('baz.html')
