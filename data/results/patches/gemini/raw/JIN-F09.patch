+def sync_do_groupby(
+    environment,
+    value,
+    attribute,
+    default=None,
+    levels=None,
+):
+    if levels is not None:
+        if not isinstance(levels, int) or levels <= 0:
+            raise ValueError("levels must be a positive integer")
+        
+        if isinstance(attribute, str):
+            attributes = [attr.strip() for attr in attribute.split(',')]
+        elif isinstance(attribute, (list, tuple)):
+            attributes = list(attribute)
+        else:
+            raise ValueError("attribute must be a list or comma-separated string")
+        
+        if len(attributes) != levels:
+            raise ValueError("attribute count must equal levels")
+    else:
+        if isinstance(attribute, (list, tuple)):
+            if len(attribute) > 1:
+                raise ValueError("Multiple attributes without levels")
+            attributes = [attribute[0]]
+        else:
+            attributes = [attribute]
+
+    def _group(data, attrs):
+        if not attrs:
+            return data
+        
+        attr = attrs[0]
+        expr = make_attrgetter(environment, attr, default=default)
+        
+        # Sort by the attribute
