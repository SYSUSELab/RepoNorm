+from itertools import groupby
+
+def hierarchical_groupby(data, attributes):
+    if not attributes:
+        return data
+    
+    attr = attributes[0]
+    # Sort by the attribute
+    data = sorted(data, key=lambda x: x.get(attr))
+    
+    result = []
+    for key, group in groupby(data, key=lambda x: x.get(attr)):
+        group_list = list(group)
+        if len(attributes) > 1:
+            result.append((key, hierarchical_groupby(group_list, attributes[1:])))
+        else:
+            result.append((key, group_list))
+    return result
+
+data = [
+    {'department': 'Engineering', 'role': 'Dev'},
+    {'department': 'Engineering', 'role': 'QA'},
+    {'department': 'Sales', 'role': 'Sales'},
+]
+
+result = hierarchical_groupby(data, ['department', 'role'])
+print(result)
