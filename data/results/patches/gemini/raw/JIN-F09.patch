+            raise ValueError("levels must be a positive integer")
+        
+        if isinstance(attributes, str):
+            attributes = [attr.strip() for attr in attributes.split(',')]
+        
+        if len(attributes) != levels:
+            raise ValueError("attribute count must equal levels")
+    else:
+        if isinstance(attributes, str):
+            attributes = [attributes]
+        elif not isinstance(attributes, (list, tuple)):
+            attributes = [attributes]
+            
+    def _group(data, attrs):
+        if not attrs:
+            return data
