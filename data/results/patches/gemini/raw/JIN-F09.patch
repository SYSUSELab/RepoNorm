@@ -0,0 +1,24 @@
+from jinja2 import Environment
+from jinja2.filters import sync_do_groupby
+
+# Mocking Environment for make_attrgetter
+class MockEnvironment:
+    def getitem(self, obj, argument):
+        return obj[argument]
+
+env = MockEnvironment()
+
+# Test data
+data = [
+    {'department': 'Engineering', 'role': 'Dev'},
+    {'department': 'Engineering', 'role': 'QA'},
+    {'department': 'Sales', 'role': 'Sales'},
+]
+
+# Current behavior
+try:
+    result = sync_do_groupby(env, data, ['department', 'role'], levels=2)
+    print(result)
+except Exception as e:
+    print(f"Caught expected error: {e}")
+
