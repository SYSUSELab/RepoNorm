diff --git a/edit_cache_v2.py b/edit_cache_v2.py
new file mode 100644
index 00000000..c31e7cb1
--- /dev/null
+++ b/edit_cache_v2.py
@@ -0,0 +1,30 @@
+with open("dspy/clients/cache.py", "r") as f:
+    lines = f.readlines()
+
+new_lines = []
+i = 0
+while i < len(lines):
+    line = lines[i]
+    
+    # Modify put
+    if "self.disk_cache.set(key, value, expire=self.ttl)" in line:
+        new_lines.append("                # Store (value, creation_time) in disk cache to preserve TTL\n")
+        new_lines.append("                self.disk_cache.set(key, (value, time.time()), expire=self.ttl)\n")
+        i += 1
+        continue
+        
+    # Modify get
+    if "response = self.disk_cache[key]" in line:
+        new_lines.append("            # Found on disk but not in memory cache, add to memory cache\n")
+        new_lines.append("            response, creation_time = self.disk_cache[key]\n")
+        new_lines.append("            if self.enable_memory_cache:\n")
+        new_lines.append("                with self._lock:\n")
+        new_lines.append("                    self.memory_cache[key] = (response, creation_time)\n")
+        i += 5 # skip original lines
+        continue
+        
+    new_lines.append(line)
+    i += 1
+
+with open("dspy/clients/cache.py", "w") as f:
+    f.writelines(new_lines)
