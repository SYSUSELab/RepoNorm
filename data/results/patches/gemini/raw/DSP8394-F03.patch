+def set_ttl(seconds: Optional[float]):
+    """Set the TTL for the active global DSPy cache.
+
+    Args:
+        seconds: The time-to-live for cache entries in seconds.
+    """
+    import math
+    if seconds is not None:
+        if not isinstance(seconds, (int, float)) or isinstance(seconds, bool) or seconds <= 0 or not math.isfinite(seconds):
+            raise ValueError("TTL must be a positive finite number or None")
+    
+    import dspy
+    if hasattr(dspy, "cache"):
+        dspy.cache.ttl = seconds
