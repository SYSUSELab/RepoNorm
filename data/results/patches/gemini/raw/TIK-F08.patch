diff --git a/apply_changes.py b/apply_changes.py
new file mode 100644
index 0000000..f666443
--- /dev/null
+++ b/apply_changes.py
@@ -0,0 +1,46 @@
+import re
+
+with open('tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# Update signature
+old_signature = """    def encode(
+        self,
+        text: str,
+        *,
+        allowed_special: Literal["all"] | AbstractSet[str] = set(),
+        disallowed_special: Literal["all"] | Collection[str] = "all",
+    ) -> list[int]:"""
+
+new_signature = """    def encode(
+        self,
+        text: str,
+        *,
+        allowed_special: Literal["all"] | AbstractSet[str] = set(),
+        disallowed_special: Literal["all"] | Collection[str] = "all",
+        return_repeated_pattern: bool = False,
+    ) -> list[int] | tuple[list[int], dict[tuple[int, int], int]]:"""
+
+content = content.replace(old_signature, new_signature)
+
+# Update implementation
+old_impl = """        try:
+            return self._core_bpe.encode(text, allowed_special)
+        except UnicodeEncodeError:"""
+
+new_impl = """        try:
+            tokens = self._core_bpe.encode(text, allowed_special)
+            if not return_repeated_pattern:
+                return tokens
+            if len(tokens) < 2:
+                return tokens, {}
+            from collections import Counter
+            pairs = [(tokens[i], tokens[i+1]) for i in range(len(tokens) - 1)]
+            counts = Counter(pairs)
+            return tokens, dict(counts.most_common(3))
+        except UnicodeEncodeError:"""
+
+content = content.replace(old_impl, new_impl)
+
+with open('tiktoken/core.py', 'w') as f:
+    f.write(content)
