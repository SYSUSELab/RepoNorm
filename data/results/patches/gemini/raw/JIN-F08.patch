diff --git a/tests/test_groupby_counts.py b/tests/test_groupby_counts.py
new file mode 100644
index 0000000..19b5e98
--- /dev/null
+++ b/tests/test_groupby_counts.py
@@ -0,0 +1,54 @@
+import pytest
+import asyncio
+from jinja2 import Environment
+
+def test_groupby_counts():
+    env = Environment()
+    users = [
+        {"name": "Alice", "city": "NY"},
+        {"name": "Bob", "city": "LA"},
+        {"name": "Charlie", "city": "NY"},
+    ]
+    
+    # Test with_counts=True
+    result = env.filters["groupby"](env, users, "city", with_counts=True)
+    assert len(result) == 2
+    assert result[0].grouper == "LA"
+    assert result[0].count == 1
+    assert result[1].grouper == "NY"
+    assert result[1].count == 2
+    
+    # Test unpacking
+    grouper, items, count = result[0]
+    assert grouper == "LA"
+    assert count == 1
+    
+    # Test with_counts=False (default)
+    result = env.filters["groupby"](env, users, "city")
+    assert len(result) == 2
+    assert result[0].grouper == "LA"
+    # Should not have count attribute or it should be None
+    assert not hasattr(result[0], "count") or result[0].count is None
+    
+    # Test unpacking
+    grouper, items = result[0]
+    assert grouper == "LA"
+
+def test_async_groupby_counts():
+    async def run_test():
+        env = Environment(enable_async=True)
+        users = [
+            {"name": "Alice", "city": "NY"},
+            {"name": "Bob", "city": "LA"},
+            {"name": "Charlie", "city": "NY"},
+        ]
+        
+        # Test with_counts=True
+        result = await env.filters["groupby"](env, users, "city", with_counts=True)
+        assert len(result) == 2
+        assert result[0].grouper == "LA"
+        assert result[0].count == 1
+        assert result[1].grouper == "NY"
+        assert result[1].count == 2
+    
+    asyncio.run(run_test())
