+import re
+
+with open('src/jinja2/filters.py', 'r') as f:
+    content = f.read()
+
+doc_pattern = r'(You can specify a ``default`` value to use if an object in the list\n    does not have the given attribute\.)'
+doc_replacement = r'\1\n\n    You can specify a ``max_groups`` value to limit the number of groups\n    returned. If ``max_groups`` is a non-negative integer, only that many\n    groups are returned.'
+
+content = re.sub(doc_pattern, doc_replacement, content)
+
+with open('src/jinja2/filters.py', 'w') as f:
+    f.write(content)
diff --git a/update_filters.py b/update_filters.py
new file mode 100644
