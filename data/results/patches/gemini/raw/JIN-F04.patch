--- /dev/null
+++ b/update_filters.py
@@ -0,0 +1,21 @@
+import re
+
+with open('src/jinja2/filters.py', 'r') as f:
+    content = f.read()
+
+# Update sync_do_groupby
+sync_pattern = r'(def sync_do_groupby\(.*?\) -> "t\.List\[t\.Tuple\[t\.Any, t\.List\[V\]\]\]":.*?    expr = make_attrgetter\(environment, attribute, default=default\)\n    )return \[.*?_GroupTuple\(key, list\(values\)\)\n        for key, values in groupby\(sorted\(value, key=expr\), expr\)\n    \]'
+
+sync_replacement = r'\1groups = groupby(sorted(value, key=expr), expr)\n    if max_groups is not None:\n        if not isinstance(max_groups, int) or isinstance(max_groups, bool) or max_groups < 0:\n            raise FilterArgumentError("max_groups must be a non-negative integer")\n        groups = list(groups)[:max_groups]\n    return [_GroupTuple(key, list(values)) for key, values in groups]'
+
+content = re.sub(sync_pattern, sync_replacement, content, flags=re.DOTALL)
+
+# Update do_groupby
+async_pattern = r'(async def do_groupby\(.*?\) -> "t\.List\[t\.Tuple\[t\.Any, t\.List\[V\]\]\]":.*?    expr = make_attrgetter\(environment, attribute, default=default\)\n    )return \[.*?_GroupTuple\(key, await auto_to_list\(values\)\)\n        for key, values in groupby\(sorted\(await auto_to_list\(value\), key=expr\), expr\)\n    \]'
+
+async_replacement = r'\1groups = groupby(sorted(await auto_to_list(value), key=expr), expr)\n    if max_groups is not None:\n        if not isinstance(max_groups, int) or isinstance(max_groups, bool) or max_groups < 0:\n            raise FilterArgumentError("max_groups must be a non-negative integer")\n        groups = list(groups)[:max_groups]\n    return [_GroupTuple(key, await auto_to_list(values)) for key, values in groups]'
+
+content = re.sub(async_pattern, async_replacement, content, flags=re.DOTALL)
+
+with open('src/jinja2/filters.py', 'w') as f:
+    f.write(content)
