index 00000000..ef27d147
--- /dev/null
+++ b/dspy/clients/cache_bypass.py
@@ -0,0 +1,22 @@
+import contextlib
+import threading
+from typing import Generator
+
+class CacheBypass:
+    def __init__(self, cache):
+        self.cache = cache
+        self._local = threading.local()
+
+    @contextlib.contextmanager
+    def bypass(self) -> Generator[None, None, None]:
+        if not hasattr(self._local, "bypass_count"):
+            self._local.bypass_count = 0
+        
+        self._local.bypass_count += 1
+        try:
+            yield
+        finally:
+            self._local.bypass_count -= 1
+
+    def is_bypassed(self) -> bool:
+        return getattr(self._local, "bypass_count", 0) > 0
