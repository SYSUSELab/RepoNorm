@@ -0,0 +1,44 @@
+import dspy
+from dspy.clients.cache import Cache, request_cache
+import threading
+import time
+
+# Mocking dspy.cache
+dspy.cache = Cache(
+    enable_disk_cache=False,
+    enable_memory_cache=True,
+    disk_cache_dir="/tmp/dspy_cache_test",
+    memory_max_entries=1000,
+)
+
+@request_cache()
+def my_function(x):
+    print(f"Computing for {x}")
+    time.sleep(0.1)
+    return x * 2
+
+def thread_task(thread_id, use_bypass):
+    if use_bypass:
+        with dspy.cache.bypass():
+            my_function(x=10)
+    else:
+        my_function(x=10)
+
+def test_thread_safety():
+    # 1. Normal call
+    my_function(x=10)
+    
+    # 2. Run threads
+    t1 = threading.Thread(target=thread_task, args=(1, True)) # Bypass
+    t2 = threading.Thread(target=thread_task, args=(2, False)) # No bypass
+    
+    t1.start()
+    t2.start()
+    
+    t1.join()
+    t2.join()
+    
+    print("Thread safety test finished.")
+
+if __name__ == "__main__":
+    test_thread_safety()
