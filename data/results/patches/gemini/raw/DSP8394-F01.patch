@@ -0,0 +1,54 @@
+import pytest
+import dspy
+from dspy.clients.cache import Cache, request_cache
+
+@pytest.fixture
+def fresh_cache():
+    return Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="/tmp/dspy_cache_test",
+        memory_max_entries=1000,
+    )
+
+def test_cache_bypass(fresh_cache):
+    # Temporarily replace dspy.cache
+    original_cache = dspy.cache
+    dspy.cache = fresh_cache
+    
+    @request_cache()
+    def my_function(x):
+        return x * 2
+    
+    # 1. Normal call
+    assert my_function(x=10) == 20
+    
+    # 2. Bypass call
+    with dspy.cache.bypass():
+        # We need to verify it recomputes.
+        # Since we can't easily mock the function to check call count,
+        # we can use a side effect.
+        class Counter:
+            count = 0
+        
+        counter = Counter()
+        
+        @request_cache()
+        def counted_function(x):
+            counter.count += 1
+            return x * 2
+            
+        assert counted_function(x=10) == 20
+        assert counter.count == 1
+        
+        with dspy.cache.bypass():
+            assert counted_function(x=10) == 20
+            assert counter.count == 2
+            
+    # 3. After bypass, should hit cache
+    assert counted_function(x=10) == 20
+    assert counter.count == 2
+    
+    # Restore original cache
+    dspy.cache = original_cache
+
