@@ -0,0 +1,31 @@
+import outlines
+from outlines import prompts
+import pytest
+
+def test_edge_cases():
+    # Test empty list
+    @outlines.prompt(builtin_filters=[])
+    def my_prompt_empty(text):
+        "{{ text }}"
+    assert my_prompt_empty("hello") == "hello"
+
+    # Test None
+    @outlines.prompt(builtin_filters=None)
+    def my_prompt_none(text):
+        "{{ text }}"
+    assert my_prompt_none("hello") == "hello"
+
+    # Test repeating category
+    @outlines.prompt(builtin_filters=["upper", "upper"])
+    def my_prompt_repeat(text):
+        "{{ text | upper }}"
+    assert my_prompt_repeat("hello") == "HELLO"
+
+    # Test from_str with empty list
+    p = prompts.Prompt.from_str("{{ text }}", builtin_filters=[])
+    assert p(text="hello") == "hello"
+
+    print("All edge cases passed")
+
+if __name__ == "__main__":
+    test_edge_cases()
