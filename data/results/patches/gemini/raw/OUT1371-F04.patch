+import outlines
+from outlines import prompts
+import pytest
+
+def test_builtin_filters():
+    # Test decorator
+    @outlines.prompt(builtin_filters=["upper"])
+    def my_prompt(text):
+        "{{ text | upper }}"
+    
+    rendered = my_prompt("hello")
+    print(f"Rendered: {rendered}")
+    assert rendered == "HELLO"
+
+    # Test from_str
+    p = prompts.Prompt.from_str("{{ text | lower }}", builtin_filters=["lower"])
+    rendered = p(text="HELLO")
+    print(f"Rendered from_str: {rendered}")
+    assert rendered == "hello"
+
+    # Test unknown filter
+    try:
+        @outlines.prompt(builtin_filters=["unknown"])
+        def my_prompt_fail(text):
+            "{{ text }}"
+    except ValueError as e:
+        print(f"Caught expected ValueError: {e}")
+    
+    # Test multiple filters
+    @outlines.prompt(builtin_filters=["upper", "reverse"])
+    def my_prompt_multi(text):
+        "{{ text | upper | reverse }}"
+    
+    rendered = my_prompt_multi("hello")
+    print(f"Rendered multi: {rendered}")
+    assert rendered == "OLLEH"
+
+if __name__ == "__main__":
+    test_builtin_filters()
