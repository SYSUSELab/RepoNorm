+import sys
+
+with open("outlines/prompts.py", "r") as f:
+    lines = f.readlines()
+
+# Add import
+lines.insert(10, "from outlines.filters import BUILTIN_FILTERS\n")
+
+# Modify _template_from_str to accept builtin_filters
+# Find the method definition
+for i, line in enumerate(lines):
+    if "_template_from_str(_, content: str) -> jinja2.Template:" in line:
+        lines[i] = "_template_from_str(_, content: str, builtin_filters: Optional[list] = None) -> jinja2.Template:\n"
+        # Insert filter registration
+        insert_pos = i + 1
+        lines.insert(insert_pos, "        if builtin_filters:\n")
+        lines.insert(insert_pos + 1, "            for filter_name in builtin_filters:\n")
+        lines.insert(insert_pos + 2, "                if filter_name not in BUILTIN_FILTERS:\n")
+        lines.insert(insert_pos + 3, "                    raise ValueError(f'Unknown builtin filter category: {filter_name}')\n")
+        break
+
+# Find where env.filters are added and add the loop
+for i, line in enumerate(lines):
+    if "env.filters[\"args\"] = get_fn_args" in line:
+        lines.insert(i + 1, "        if builtin_filters:\n")
+        lines.insert(i + 2, "            for filter_name in builtin_filters:\n")
+        lines.insert(i + 3, "                env.filters[filter_name] = BUILTIN_FILTERS[filter_name]\n")
+        break
+
+# Modify prompt decorator
+for i, line in enumerate(lines):
+    if "def prompt(fn: Callable) -> Prompt:" in line:
+        lines[i] = "def prompt(fn: Callable = None, *, builtin_filters: Optional[list] = None) -> Prompt:\n"
+        lines.insert(i + 1, "    if fn is None:\n")
+        lines.insert(i + 2, "        return functools.partial(prompt, builtin_filters=builtin_filters)\n")
+        break
+
+# Modify template creation in prompt
+for i, line in enumerate(lines):
+    if "template = Prompt._template_from_str(cast(str, docstring))" in line:
+        lines[i] = "    template = Prompt._template_from_str(cast(str, docstring), builtin_filters=builtin_filters)\n"
+        break
+
+# Modify Prompt.from_str
+for i, line in enumerate(lines):
+    if "def from_str(cls, content: str):" in line:
+        lines[i] = "def from_str(cls, content: str, builtin_filters: Optional[list] = None):\n"
+        break
+    if "return cls(cls._template_from_str(content), None)" in line:
+        lines[i] = "        return cls(cls._template_from_str(content, builtin_filters=builtin_filters), None)\n"
+        break
+
+# Modify Prompt.from_file
+for i, line in enumerate(lines):
+    if "def from_file(cls, path: Path):" in line:
+        lines[i] = "def from_file(cls, path: Path, builtin_filters: Optional[list] = None):\n"
+        break
+    if "return cls(cls._template_from_file(path), None)" in line:
+        lines[i] = "        return cls(cls._template_from_file(path, builtin_filters=builtin_filters), None)\n"
+        break
+
+# Modify _template_from_file
+for i, line in enumerate(lines):
+    if "_template_from_file(_, path: Path) -> jinja2.Template:" in line:
+        lines[i] = "_template_from_file(_, path: Path, builtin_filters: Optional[list] = None) -> jinja2.Template:\n"
+        insert_pos = i + 1
+        lines.insert(insert_pos, "        if builtin_filters:\n")
+        lines.insert(insert_pos + 1, "            for filter_name in builtin_filters:\n")
+        lines.insert(insert_pos + 2, "                if filter_name not in BUILTIN_FILTERS:\n")
+        lines.insert(insert_pos + 3, "                    raise ValueError(f'Unknown builtin filter category: {filter_name}')\n")
+        break
+
+# Find where env is created in _template_from_file and add filters
+for i, line in enumerate(lines):
+    if "return env.get_template(os.path.basename(path))" in line:
+        lines.insert(i, "        env.filters[\"name\"] = get_fn_name\n")
+        lines.insert(i + 1, "        env.filters[\"description\"] = get_fn_description\n")
+        lines.insert(i + 2, "        env.filters[\"source\"] = get_fn_source\n")
+        lines.insert(i + 3, "        env.filters[\"signature\"] = get_fn_signature\n")
+        lines.insert(i + 4, "        env.filters[\"schema\"] = get_schema\n")
+        lines.insert(i + 5, "        env.filters[\"args\"] = get_fn_args\n")
+        lines.insert(i + 6, "        if builtin_filters:\n")
+        lines.insert(i + 7, "            for filter_name in builtin_filters:\n")
+        lines.insert(i + 8, "                env.filters[filter_name] = BUILTIN_FILTERS[filter_name]\n")
+        break
+
+with open("outlines/prompts.py", "w") as f:
+    f.writelines(lines)
