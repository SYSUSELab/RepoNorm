+    try:
+        @outlines.prompt(builtin_filters=["upper"])
+        def my_prompt(text):
+            "{{ text | upper }}"
+        
+        print("Successfully created prompt with builtin_filters")
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
