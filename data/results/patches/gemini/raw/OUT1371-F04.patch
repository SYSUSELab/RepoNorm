+++ b/outlines/filters.py
@@ -0,0 +1,69 @@
+import json
+import textwrap
+import html
+import csv
+import io
+
+def upper(value): return str(value).upper()
+def lower(value): return str(value).lower()
+def title(value): return str(value).title()
+def reverse(value): return str(value)[::-1]
+def truncate(value, length, end="..."):
+    if length < 0: raise ValueError("Length must be non-negative")
+    s = str(value)
+    if len(s) <= length: return s
+    return s[:length - len(end)] + end
+def pad_left(value, width, fill=" "):
+    if len(fill) != 1: raise ValueError("Fill must be one character")
+    return str(value).rjust(width, fill)
+def pad_right(value, width, fill=" "):
+    if len(fill) != 1: raise ValueError("Fill must be one character")
+    return str(value).ljust(width, fill)
+
+def add(a, b): return a + b
+def subtract(a, b): return a - b
+def multiply(a, b): return a * b
+def divide(a, b): return a / b
+def round_val(value, ndigits=None): return round(value, ndigits)
+def abs_val(value): return abs(value)
+def min_val(value, *others): return min(value, *others)
+def max_val(value, *others): return max(value, *others)
+
+def json_filter(value): return json.dumps(value)
+def csv_filter(value):
+    output = io.StringIO()
+    writer = csv.writer(output)
+    writer.writerow(value)
+    return output.getvalue().strip()
+def indent(value, width=4):
+    return textwrap.indent(str(value), " " * width)
+def wrap(value, width=70):
+    return textwrap.fill(str(value), width=width)
+def escape(value):
+    return html.escape(str(value), quote=True)
+def unescape(value):
+    return html.unescape(str(value))
+
+BUILTIN_FILTERS = {
+    "upper": upper,
+    "lower": lower,
+    "title": title,
+    "reverse": reverse,
+    "truncate": truncate,
+    "pad_left": pad_left,
+    "pad_right": pad_right,
+    "add": add,
+    "subtract": subtract,
+    "multiply": multiply,
+    "divide": divide,
+    "round": round_val,
+    "abs": abs_val,
+    "min": min_val,
+    "max": max_val,
+    "json": json_filter,
+    "csv": csv_filter,
+    "indent": indent,
+    "wrap": wrap,
+    "escape": escape,
+    "unescape": unescape,
+}
