+    if len(fill) != 1: raise ValueError("Fill must be one character")
+    return str(value).rjust(width, fill)
+def pad_right(value, width, fill=" "):
+    if len(fill) != 1: raise ValueError("Fill must be one character")
+    return str(value).ljust(width, fill)
