+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_fallback_installer():
+    env = Environment(extensions=[InternationalizationExtension])
+    # The extension is stored in env.extensions by its name or class?
+    # Let's check env.extensions
+    print(f"Extensions: {env.extensions}")
+    
+    # Try to find it
+    i18n = None
+    for ext in env.extensions.values():
+        if isinstance(ext, InternationalizationExtension):
+            i18n = ext
+            break
+            
+    if not i18n:
+        print("Extension not found")
+        return
+
+    print("Method found!")
+    
+    # Test the functionality
+    i18n.install_gettext_callables_with_fallback(
+        lambda s: s,
+        lambda s, p, n: s if n == 1 else p,
+        fallback_gettext_funcs=[lambda s: "fallback"],
+    )
+    
+    assert env.globals['gettext']("hello") == "fallback"
+    print("Functionality test passed")
+
+test_fallback_installer()
