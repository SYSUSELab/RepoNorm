+import pytest
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_fallback_implementation():
+    # Define the fallback logic
+    def gettext(s): return s
+    def ngettext(s, p, n): return s if n == 1 else p
+    
+    def fallback1(s): return "fallback1"
+    def fallback2(s): return "fallback2"
+    
+    def gettext_with_fallback(s, fallbacks):
+        res = gettext(s)
+        if res != s:
+            return res
+        for f in fallbacks:
+            res = f(s)
+            if res != s:
+                return res
+        return s
+
+    assert gettext_with_fallback("hello", [fallback1, fallback2]) == "fallback1"
+    
+    def gettext_miss(s): return s
+    def fallback_miss(s): return s
+    assert gettext_with_fallback("hello", [fallback_miss]) == "hello"
+    
+    print("Implementation test passed")
+
+test_fallback_implementation()
