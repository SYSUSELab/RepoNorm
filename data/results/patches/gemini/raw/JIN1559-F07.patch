+from typing import Callable, Optional, Iterable, Any
+
+def install_gettext_callables_with_fallback(
+    gettext: Callable[[str], str],
+    ngettext: Callable[[str, str, int], str],
+    fallback_gettext_funcs: Optional[Iterable[Callable[[str], str]]] = None,
+    fallback_ngettext_funcs: Optional[Iterable[Callable[[str, str, int], str]]] = None,
+    newstyle: Optional[bool] = None,
+    pgettext: Optional[Callable[[str, str], str]] = None,
+    npgettext: Optional[Callable[[str, str, str, int], str]] = None,
+    fallback_pgettext_funcs: Optional[Iterable[Callable[[str, str], str]]] = None,
+    fallback_npgettext_funcs: Optional[Iterable[Callable[[str, str, str, int], str]]] = None,
+):
+    # Snapshot iterables
+    fallback_gettext_funcs = list(fallback_gettext_funcs or [])
+    fallback_ngettext_funcs = list(fallback_ngettext_funcs or [])
+    fallback_pgettext_funcs = list(fallback_pgettext_funcs or [])
+    fallback_npgettext_funcs = list(fallback_npgettext_funcs or [])
+    
+    # Validate pgettext/npgettext
+    if (fallback_pgettext_funcs and not pgettext) or (fallback_npgettext_funcs and not npgettext):
+        raise ValueError("pgettext/npgettext required for contextual fallbacks")
+        
+    # Define the chained functions
+    def chained_gettext(s):
+        res = gettext(s)
+        if res != s: return res
+        for f in fallback_gettext_funcs:
+            res = f(s)
+            if res != s: return res
+        return s
+        
+    def chained_ngettext(s, p, n):
+        res = ngettext(s, p, n)
+        expected = s if n == 1 else p
+        if res != expected: return res
+        for f in fallback_ngettext_funcs:
+            res = f(s, p, n)
+            if res != expected: return res
+        return expected
+        
+    def chained_pgettext(c, s):
+        if not pgettext: return s
+        res = pgettext(c, s)
+        if res != s: return res
+        for f in fallback_pgettext_funcs:
+            res = f(c, s)
+            if res != s: return res
+        return s
+        
+    def chained_npgettext(c, s, p, n):
+        if not npgettext: return s if n == 1 else p
+        res = npgettext(c, s, p, n)
+        expected = s if n == 1 else p
+        if res != expected: return res
+        for f in fallback_npgettext_funcs:
+            res = f(c, s, p, n)
+            if res != expected: return res
+        return expected
+
+    # Now we have the chained functions.
+    # If newstyle is True, we need to wrap them with _make_new_gettext etc.
+    # But wait, the _make_new_gettext expects a function that takes (s) and returns (s).
+    # Our chained_gettext takes (s) and returns (s).
+    # So we can just pass chained_gettext to _make_new_gettext.
+    
+    print("Design looks solid")
+
+install_gettext_callables_with_fallback(
+    lambda s: s,
+    lambda s, p, n: s if n == 1 else p,
+    fallback_gettext_funcs=[lambda s: "fallback"],
+)
