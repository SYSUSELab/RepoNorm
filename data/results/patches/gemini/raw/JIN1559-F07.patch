@@ -0,0 +1,27 @@
+def ngettext_with_fallback(ngettext, fallbacks, s, p, n):
+    res = ngettext(s, p, n)
+    # ngettext result is missing when it equals the selected source form:
+    # singular for n == 1, plural otherwise.
+    expected_source = s if n == 1 else p
+    if res != expected_source:
+        return res
+    
+    for f in fallbacks:
+        res = f(s, p, n)
+        if res != expected_source:
+            return res
+    return expected_source
+
+def test_ngettext_fallback():
+    def ngettext(s, p, n): return s if n == 1 else p
+    def fallback(s, p, n): return "fallback"
+    
+    assert ngettext_with_fallback(ngettext, [fallback], "s", "p", 1) == "fallback"
+    assert ngettext_with_fallback(ngettext, [fallback], "s", "p", 2) == "fallback"
+    
+    def fallback_miss(s, p, n): return s if n == 1 else p
+    assert ngettext_with_fallback(ngettext, [fallback_miss], "s", "p", 1) == "s"
+    
+    print("Ngettext fallback test passed")
+
+test_ngettext_fallback()
