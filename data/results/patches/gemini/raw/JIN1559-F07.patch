@@ -0,0 +1,50 @@
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+def test_edge_cases():
+    env = Environment(extensions=[InternationalizationExtension])
+    i18n = None
+    for ext in env.extensions.values():
+        if isinstance(ext, InternationalizationExtension):
+            i18n = ext
+            break
+            
+    # 1. Missing/empty iterable behaves like install_gettext_callables
+    i18n.install_gettext_callables_with_fallback(
+        lambda s: "primary",
+        lambda s, p, n: "primary",
+        fallback_gettext_funcs=[],
+    )
+    assert env.globals['gettext']("hello") == "primary"
+    
+    # 2. Contextual fallback without primary raises ValueError
+    try:
+        i18n.install_gettext_callables_with_fallback(
+            lambda s: s,
+            lambda s, p, n: s,
+            fallback_pgettext_funcs=[lambda c, s: "fallback"],
+        )
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+    else:
+        print("Failed to catch expected error")
+        
+    # 3. Provider exceptions propagate
+    def failing_fallback(s):
+        raise Exception("Boom")
+        
+    i18n.install_gettext_callables_with_fallback(
+        lambda s: s,
+        lambda s, p, n: s,
+        fallback_gettext_funcs=[failing_fallback],
+    )
+    try:
+        env.globals['gettext']("hello")
+    except Exception as e:
+        print(f"Caught expected exception: {e}")
+    else:
+        print("Failed to catch expected exception")
+
+    print("Edge cases test passed")
+
+test_edge_cases()
