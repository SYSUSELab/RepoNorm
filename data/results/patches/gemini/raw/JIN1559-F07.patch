+def pgettext_with_fallback(pgettext, fallbacks, c, s):
+    res = pgettext(c, s)
+    if res != s:
+        return res
+    for f in fallbacks:
+        res = f(c, s)
+        if res != s:
+            return res
+    return s
+
+def test_pgettext_fallback():
+    def pgettext(c, s): return s
+    def fallback(c, s): return "fallback"
+    
+    assert pgettext_with_fallback(pgettext, [fallback], "ctx", "s") == "fallback"
+    
+    def fallback_miss(c, s): return s
+    assert pgettext_with_fallback(pgettext, [fallback_miss], "ctx", "s") == "s"
+    
+    print("Pgettext fallback test passed")
+
+test_pgettext_fallback()
