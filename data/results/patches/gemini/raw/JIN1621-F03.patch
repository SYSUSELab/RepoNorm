+from jinja2.loaders import validate_template_path
+from jinja2.exceptions import TemplateNotFound
+import pytest
+
+def test_validate_template_path():
+    # Valid paths
+    validate_template_path("test.html")
+    validate_template_path("foo/bar.html")
+    
+    # Invalid paths
+    with pytest.raises(TemplateNotFound):
+        validate_template_path(None)
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("")
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("foo\0bar.html")
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("/foo.html")
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("\\foo.html")
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("C:\\foo.html")
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("C:/foo.html")
+    with pytest.raises(TemplateNotFound):
+        validate_template_path("foo\x01bar.html")
+
+test_validate_template_path()
+print("All tests passed!")
