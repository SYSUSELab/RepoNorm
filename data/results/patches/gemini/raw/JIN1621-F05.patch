+++ b/reproduce_issue.py
@@ -0,0 +1,37 @@
+import os
+import tempfile
+from jinja2 import Environment, FileSystemLoader, TemplateNotFound
+
+with tempfile.TemporaryDirectory() as tmpdir:
+    os.makedirs(os.path.join(tmpdir, "dir1"))
+    with open(os.path.join(tmpdir, "dir1", "test.html"), "w") as f:
+        f.write("dir1")
+        
+    loader = FileSystemLoader([os.path.join(tmpdir, "dir1")], path_cache_size=10)
+    env = Environment(loader=loader)
+    
+    # First load
+    assert env.get_template("test.html").render() == "dir1"
+    
+    # Modify
+    with open(os.path.join(tmpdir, "dir1", "test.html"), "w") as f:
+        f.write("dir1_modified")
+    
+    # Second load - should be modified because uptodate() returns False
+    assert env.get_template("test.html").render() == "dir1_modified"
+    
+    # Now, let's test the cache by not modifying the file
+    # The path should be cached.
+    # If I remove the file, it should be resolved again (and fail).
+    os.remove(os.path.join(tmpdir, "dir1", "test.html"))
+    
+    # The cache still has the old path.
+    # The get_source() method checks if the file exists.
+    # If it doesn't exist, it should call resolve_template_path() again.
+    # Let's see if it does.
+    try:
+        env.get_template("test.html")
+    except TemplateNotFound:
+        print("Caught expected TemplateNotFound")
+    
+    print("All tests passed!")
