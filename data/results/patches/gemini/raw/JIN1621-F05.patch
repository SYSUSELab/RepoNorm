+import os
+import tempfile
+from jinja2 import Environment, FileSystemLoader, TemplateNotFound
+
+with tempfile.TemporaryDirectory() as tmpdir:
+    os.makedirs(os.path.join(tmpdir, "dir1"))
+    with open(os.path.join(tmpdir, "dir1", "test.html"), "w") as f:
+        f.write("dir1")
+        
+    loader = FileSystemLoader([os.path.join(tmpdir, "dir1")], path_cache_size=10)
+    env = Environment(loader=loader)
+    
+    # First load
+    print(f"First load: {env.get_template('test.html').render()}")
+    
+    # Modify
+    with open(os.path.join(tmpdir, "dir1", "test.html"), "w") as f:
+        f.write("dir1_modified")
+        
+    # Second load
+    print(f"Second load: {env.get_template('test.html').render()}")
+    
+    # Check cache
+    print(f"Cache: {loader._path_cache}")
