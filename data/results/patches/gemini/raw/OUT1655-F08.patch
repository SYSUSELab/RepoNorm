+from outlines.types import ssn
+import re
+
+def test_ssn_regex():
+    pattern = ssn.pattern
+    assert re.fullmatch(pattern, "123-45-6789") is not None
+    assert re.fullmatch(pattern, "000-00-0000") is not None
+    assert re.fullmatch(pattern, "999-99-9999") is not None
+    assert re.fullmatch(pattern, "12-345-6789") is None
+    assert re.fullmatch(pattern, "1234-56-789") is None
+    assert re.fullmatch(pattern, "123-456-789") is None
+    assert re.fullmatch(pattern, "123-45-678") is None
+    assert re.fullmatch(pattern, "abc-de-fghi") is None
