+++ b/test_description_limit.py
@@ -0,0 +1,29 @@
+import unittest
+from dspy.propose.grounded_proposer import GroundedProposer
+from dspy.propose.utils import truncate_description
+
+class TestDescriptionLimit(unittest.TestCase):
+    def test_invalid_limit(self):
+        with self.assertRaises(ValueError):
+            GroundedProposer(prompt_model=None, program=None, trainset=None, max_description_chars="invalid")
+        with self.assertRaises(ValueError):
+            GroundedProposer(prompt_model=None, program=None, trainset=None, max_description_chars=-1)
+        with self.assertRaises(ValueError):
+            GroundedProposer(prompt_model=None, program=None, trainset=None, max_description_chars=0)
+        with self.assertRaises(ValueError):
+            GroundedProposer(prompt_model=None, program=None, trainset=None, max_description_chars=True)
+
+    def test_valid_limit(self):
+        # Should not raise
+        GroundedProposer(prompt_model=None, program=None, trainset=None, max_description_chars=2000)
+        GroundedProposer(prompt_model=None, program=None, trainset=None, max_description_chars=None)
+
+    def test_truncate_description(self):
+        self.assertEqual(truncate_description("This is a sentence. This is another sentence.", 30), "This is a sentence.…")
+        self.assertEqual(truncate_description("This is a sentence. This is another sentence.", 20), "This is a sentence.…")
+        self.assertEqual(truncate_description("This is a sentence. This is another sentence.", 5), "This…")
+        self.assertEqual(truncate_description("Short.", 10), "Short.")
+        self.assertEqual(truncate_description("A" * 20, 10), "AAAAAAAAA…")
+
+if __name__ == '__main__':
+    unittest.main()
