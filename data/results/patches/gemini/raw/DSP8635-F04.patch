+def truncate_description(text, cap):
+    if cap is None or len(text) <= cap:
+        return text
+    
+    if cap == 1:
+        return "…"
+    
+    # Find all sentence endings
+    matches = list(re.finditer(r'[.!?](\s|$)', text))
+    
+    # We want the last match that fits in cap-1 characters
+    for match in reversed(matches):
+        if match.end() <= cap - 1:
+            return text[:match.end()].rstrip() + "…"
+            
+    # If no sentence fits, take a hard prefix of cap-1 characters
+    return text[:cap-1].rstrip() + "…"
