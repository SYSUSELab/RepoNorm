@@ -0,0 +1,17 @@
+import re
+
+with open('dspy/propose/grounded_proposer.py', 'r') as f:
+    content = f.read()
+
+# Apply to program_description
+pattern = r'(program_description = strip_prefix\(\s*self\.describe_program\(\s*program_code=self\.program_code_string,\s*program_example=task_demos,\s*\)\.program_description,\s*\))'
+replacement = r'\1\n                if self.max_description_chars:\n                    program_description = truncate_description(program_description, self.max_description_chars)'
+content = re.sub(pattern, replacement, content)
+
+# Apply to module_description
+pattern = r'(module_description = self\.describe_module\(\s*program_code=self\.program_code_string,\s*program_description=program_description,\s*program_example=task_demos,\s*module=module_code,\s*max_depth=10,\s*\)\.module_description)'
+replacement = r'\1\n                if self.max_description_chars:\n                    module_description = truncate_description(module_description, self.max_description_chars)'
+content = re.sub(pattern, replacement, content)
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.write(content)
