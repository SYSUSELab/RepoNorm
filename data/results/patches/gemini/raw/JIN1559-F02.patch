+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+from jinja2.exceptions import TemplateAssertionError
+
+env = Environment(extensions=[InternationalizationExtension])
+env.install_gettext_callables(
+    lambda x: x, 
+    lambda s, p, n: s if n == 1 else p,
+    dgettext=lambda d, m: f"domain={d}, msg={m}",
+    dngettext=lambda d, s, p, n: f"domain={d}, msg={s if n == 1 else p}"
+)
+
+# Test pluralization with domain
+try:
+    template = env.from_string("{% trans domain='admin', count=1 %}{{ count }} item{% pluralize %}{{ count }} items{% endtrans %}")
+    print(f"Rendered (count=1): {template.render(count=1)}")
+    print(f"Rendered (count=2): {template.render(count=2)}")
+except Exception as e:
+    print(f"Caught error: {e}")
+    import traceback
+    traceback.print_exc()
