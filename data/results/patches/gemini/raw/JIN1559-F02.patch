+import sys
+
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find _install_callables
+for i, line in enumerate(lines):
+    if 'def _install_callables(' in line:
+        # Update arguments
+        lines[i+1] = '        self,\n'
+        lines[i+2] = '        gettext: t.Callable[[str], str],\n'
+        lines[i+3] = '        ngettext: t.Callable[[str, str, int], str],\n'
+        lines[i+4] = '        newstyle: t.Optional[bool] = None,\n'
+        lines[i+5] = '        pgettext: t.Optional[t.Callable[[str, str], str]] = None,\n'
+        lines[i+6] = '        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,\n'
+        lines[i+7] = '        dgettext: t.Optional[t.Callable[[str, str], str]] = None,\n'
+        lines[i+8] = '        dngettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,\n'
+        lines[i+9] = '    ) -> None:\n'
+        
+        # Update body
+        # Find where globals are updated
+        for j in range(i, len(lines)):
+            if 'self.environment.globals.update(' in lines[j]:
+                lines[j] = '        self.environment.globals.update(\n'
+                lines[j+1] = '            gettext=gettext, ngettext=ngettext, pgettext=pgettext, npgettext=npgettext, dgettext=dgettext, dngettext=dngettext\n'
+                lines[j+2] = '        )\n'
+                break
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
