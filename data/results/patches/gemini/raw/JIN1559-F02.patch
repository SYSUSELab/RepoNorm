+import sys
+
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the _make_node method
+for i, line in enumerate(lines):
+    if 'def _make_node(' in line:
+        # Find the end of the arguments
+        j = i
+        while ')' not in lines[j]:
+            j += 1
+        # Insert domain argument
+        lines[j] = lines[j].replace(')', ', domain: t.Optional[str] = None)')
+        
+        # Find the body of _make_node
+        # We need to update the call to gettext/ngettext
+        # Find the "singular only" block
+        for k in range(j, len(lines)):
+            if '# singular only:' in lines[k]:
+                # Find the end of the block
+                l = k
+                while 'node.kwargs.append' not in lines[l]:
+                    l += 1
+                
+                # Replace the whole block from # singular only: to the end of the block
+                new_lines = [
+                    '        # singular only:\n',
+                    '        if domain is None:\n',
+                    '            gettext = nodes.Name("gettext", "load")\n',
+                    '            args = [nodes.Const(singular)]\n',
+                    '        else:\n',
+                    '            gettext = nodes.Name("dgettext", "load")\n',
+                    '            args = [nodes.Const(domain), nodes.Const(singular)]\n',
+                    '        node = nodes.Call(gettext, args, [], None, None)\n',
+                    '\n',
+                    '        # singular and plural\n',
+                    '        if plural_expr is not None:\n',
+                    '            if domain is None:\n',
+                    '                ngettext = nodes.Name("ngettext", "load")\n',
+                    '                args = [nodes.Const(singular), nodes.Const(plural), plural_expr]\n',
+                    '            else:\n',
+                    '                ngettext = nodes.Name("dngettext", "load")\n',
+                    '                args = [nodes.Const(domain), nodes.Const(singular), nodes.Const(plural), plural_expr]\n',
+                    '            node = nodes.Call(ngettext, args, [], None, None)\n',
+                    '\n',
+                    '        # in case newstyle gettext is used, the method is powerful\n',
+                    '        # enough to handle the variable expansion and autoescape\n',
+                    '        # handling itself\n',
+                    '        if newstyle:\n',
+                    '            node = nodes.Call(\n',
+                    '                node.node,\n',
+                    '                node.args,\n',
+                    '                [\n',
+                    '                    nodes.Keyword(key, value)\n',
+                    '                    for key, value in variables.items()\n',
+                    '                ],\n',
+                    '                None,\n',
+                    '                None,\n',
+                    '            )\n',
+                ]
+                
+                lines[k:l+1] = new_lines
+                break
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
