+++ b/edit_ext.py
@@ -0,0 +1,30 @@
+import sys
+
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the line where variables is defined
+for i, line in enumerate(lines):
+    if 'variables: t.Dict[str, nodes.Expr] = {}' in line:
+        lines.insert(i + 1, '        domain = None\n')
+        break
+
+# Find the loop
+for i, line in enumerate(lines):
+    if '            # expressions' in line:
+        # Insert the domain check before the expressions check
+        lines.insert(i + 1, '            if token.value == "domain":\n')
+        lines.insert(i + 2, '                if domain is not None:\n')
+        lines.insert(i + 3, '                    parser.fail("domain defined twice", token.lineno, exc=TemplateAssertionError)\n')
+        lines.insert(i + 4, '                if parser.stream.current.type != "assign":\n')
+        lines.insert(i + 5, '                    parser.fail("domain must be a string literal", token.lineno, exc=TemplateAssertionError)\n')
+        lines.insert(i + 6, '                next(parser.stream)\n')
+        lines.insert(i + 7, '                domain_node = parser.parse_expression()\n')
+        lines.insert(i + 8, '                if not isinstance(domain_node, nodes.Const) or not isinstance(domain_node.value, str):\n')
+        lines.insert(i + 9, '                    parser.fail("domain must be a string literal", token.lineno, exc=TemplateAssertionError)\n')
+        lines.insert(i + 10, '                domain = domain_node.value\n')
+        lines.insert(i + 11, '                continue\n')
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
