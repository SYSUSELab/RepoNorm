+import sys
+
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the _make_node method
+for i, line in enumerate(lines):
+    if 'def _make_node(' in line:
+        # Find the end of the arguments
+        j = i
+        while ')' not in lines[j]:
+            j += 1
+        # Insert domain argument
+        lines[j] = lines[j].replace(')', ', domain: t.Optional[str] = None)')
+        
+        # Find the body of _make_node
+        # We need to update the call to gettext/ngettext
+        # Find the "singular only" block
+        for k in range(j, len(lines)):
+            if '# singular only:' in lines[k]:
+                # Replace the call
+                # The current code is:
+                # gettext = nodes.Name("gettext", "load")
+                # node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+                
+                # We need to change it to:
+                # if domain is None:
+                #     gettext = nodes.Name("gettext", "load")
+                #     args = [nodes.Const(singular)]
+                # else:
+                #     gettext = nodes.Name("dgettext", "load")
+                #     args = [nodes.Const(domain), nodes.Const(singular)]
+                # node = nodes.Call(gettext, args, [], None, None)
+                
+                lines[k+1] = '        if domain is None:\n'
+                lines[k+2] = '            gettext = nodes.Name("gettext", "load")\n'
+                lines[k+3] = '            args = [nodes.Const(singular)]\n'
+                lines[k+4] = '        else:\n'
+                lines[k+5] = '            gettext = nodes.Name("dgettext", "load")\n'
+                lines[k+6] = '            args = [nodes.Const(domain), nodes.Const(singular)]\n'
+                lines[k+7] = '        node = nodes.Call(gettext, args, [], None, None)\n'
+                lines[k+8] = '        # singular and plural\n'
+                lines[k+9] = '        if plural_expr is not None:\n'
+                lines[k+10] = '            if domain is None:\n'
+                lines[k+11] = '                ngettext = nodes.Name("ngettext", "load")\n'
+                lines[k+12] = '                args = [nodes.Const(singular), nodes.Const(plural), plural_expr]\n'
+                lines[k+13] = '            else:\n'
+                lines[k+14] = '                ngettext = nodes.Name("dngettext", "load")\n'
+                lines[k+15] = '                args = [nodes.Const(domain), nodes.Const(singular), nodes.Const(plural), plural_expr]\n'
+                lines[k+16] = '            node = nodes.Call(ngettext, args, [], None, None)\n'
+                
+                # Remove the old code
+                for l in range(k+17, k+25):
+                    if l < len(lines):
+                        lines[l] = ''
+                break
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
