diff --git a/test_domain.py b/test_domain.py
new file mode 100644
index 0000000..d935b99
--- /dev/null
+++ b/test_domain.py
@@ -0,0 +1,33 @@
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+from jinja2.nodes import Const
+
+def test_domain_translation():
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    # Mock dgettext and dngettext
+    def dgettext(domain, message):
+        return f"[{domain}] {message}"
+    
+    def dngettext(domain, singular, plural, n):
+        return f"[{domain}] {singular if n == 1 else plural}"
+    
+    env.install_gettext_callables(
+        gettext=lambda x: x,
+        ngettext=lambda s, p, n: s if n == 1 else p,
+        dgettext=dgettext,
+        dngettext=dngettext
+    )
+    
+    # Test singular
+    tmpl = env.from_string('{% trans domain="admin" %}Hello{% endtrans %}')
+    assert tmpl.render() == "[admin] Hello"
+    
+    # Test plural
+    tmpl = env.from_string('{% trans domain="admin", count=n %}Hello{% pluralize %}Hellos{% endtrans %}')
+    assert tmpl.render(n=1) == "[admin] Hello"
+    assert tmpl.render(n=2) == "[admin] Hellos"
+    
+    print("All tests passed!")
+
+test_domain_translation()
diff --git a/test_domain_errors.py b/test_domain_errors.py
new file mode 100644
index 0000000..d60fd09
--- /dev/null
+++ b/test_domain_errors.py
@@ -0,0 +1,25 @@
+from jinja2 import Environment, TemplateAssertionError
+from jinja2.ext import InternationalizationExtension
+import pytest
+
+def test_duplicate_domain():
+    env = Environment(extensions=[InternationalizationExtension])
+    try:
+        env.from_string('{% trans domain="admin", domain="user" %}Hello{% endtrans %}')
+    except TemplateAssertionError as e:
+        assert "domain defined twice" in str(e)
+    else:
+        assert False, "Should have raised TemplateAssertionError"
+
+def test_invalid_domain():
+    env = Environment(extensions=[InternationalizationExtension])
+    try:
+        env.from_string('{% trans domain=variable %}Hello{% endtrans %}')
+    except TemplateAssertionError as e:
+        assert "domain" in str(e) and "string" in str(e) and "literal" in str(e)
+    else:
+        assert False, "Should have raised TemplateAssertionError"
+
+test_duplicate_domain()
+test_invalid_domain()
+print("Error tests passed!")
