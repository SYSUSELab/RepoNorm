+++ b/reproduce_issue.py
@@ -0,0 +1,27 @@
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+import gettext
+
+# Setup environment
+env = Environment(extensions=[InternationalizationExtension])
+
+# Define a simple translation function
+def my_gettext(message):
+    return f"translated: {message}"
+
+def my_ngettext(singular, plural, n):
+    return f"translated: {singular}" if n == 1 else f"translated: {plural}"
+
+# Install translations
+env.install_gettext_callables(my_gettext, my_ngettext)
+
+# Test normal trans
+template = env.from_string("{% trans %}hello{% endtrans %}")
+print(template.render())
+
+# Test domain trans (should fail or not work as expected currently)
+try:
+    template = env.from_string("{% trans domain='admin' %}hello{% endtrans %}")
+    print(template.render())
+except Exception as e:
+    print(f"Caught expected error: {e}")
