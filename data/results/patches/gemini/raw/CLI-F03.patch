+import sys
+
+with open("src/click/core.py", "r") as f:
+    lines = f.readlines()
+
+# Find `def with_resource`
+for i, line in enumerate(lines):
+    if "def with_resource(self, context_manager: AbstractContextManager[V]) -> V:" in line:
+        start_line = i
+        break
+
+# Find the end of `with_resource`
+# It ends with `return self._exit_stack.enter_context(context_manager)`
+for i in range(start_line, len(lines)):
+    if "return self._exit_stack.enter_context(context_manager)" in lines[i]:
+        end_line = i
+        break
+
+# Replace `with_resource`
+new_with_resource = [
+    "    def with_resource(self, context_manager: AbstractContextManager[V]) -> V:\n",
+    "        # Check limits\n",
+    "        ctx = self\n",
+    "        while ctx is not None:\n",
+    "            if ctx.max_resources is not None and ctx._active_resources >= ctx.max_resources:\n",
+    "                raise RuntimeError('Maximum number of resources reached')\n",
+    "            ctx = ctx.parent\n",
+    "\n",
+    "        # Increment counts\n",
+    "        ctx = self\n",
+    "        while ctx is not None:\n",
+    "            ctx._active_resources += 1\n",
+    "            ctx = ctx.parent\n",
+    "\n",
+    "        try:\n",
+    "            res = self._exit_stack.enter_context(context_manager)\n",
+    "        except Exception:\n",
+    "            # Decrement counts if entry fails\n",
+    "            ctx = self\n",
+    "            while ctx is not None:\n",
+    "                ctx._active_resources -= 1\n",
+    "                ctx = ctx.parent\n",
+    "            raise\n",
+    "\n",
+    "        # Register a callback to decrement counts when the resource is closed\n",
+    "        def _decrement():\n",
+    "            ctx = self\n",
+    "            while ctx is not None:\n",
+    "                ctx._active_resources -= 1\n",
+    "                ctx = ctx.parent\n",
+    "\n",
+    "        self.call_on_close(_decrement)\n",
+    "        return res\n"
+]
+
+lines[start_line:end_line+1] = new_with_resource
+
+with open("src/click/core.py", "w") as f:
+    f.writelines(lines)
