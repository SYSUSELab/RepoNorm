new file mode 100644
index 0000000..ba61610
--- /dev/null
+++ b/apply_fix.py
@@ -0,0 +1,98 @@
+import sys
+
+with open("src/click/core.py", "r") as f:
+    lines = f.readlines()
+
+# Find the `Context` class
+context_start = 0
+for i, line in enumerate(lines):
+    if "class Context:" in line:
+        context_start = i
+        break
+
+# Find the `__init__` method of `Context`
+init_start = 0
+for i in range(context_start, len(lines)):
+    if "def __init__(" in lines[i]:
+        init_start = i
+        break
+
+# Find the end of `__init__`
+init_end = 0
+for i in range(init_start, len(lines)):
+    if "def " in lines[i] and i > init_start:
+        init_end = i
+        break
+
+# Update `__init__` signature
+# Find the closing parenthesis of `__init__`
+for i in range(init_start, init_end):
+    if ")" in lines[i]:
+        # Insert `max_resources: int | None = None,` before `) -> None:`
+        lines[i] = lines[i].replace(") -> None:", ", max_resources: int | None = None) -> None:")
+        break
+
+# Add `self.max_resources = max_resources` and `self._active_resources = 0`
+# Find where to insert it.
+# I'll insert it after `self.show_default = show_default`
+for i in range(init_start, init_end):
+    if "self.show_default = show_default" in lines[i]:
+        lines.insert(i + 1, "        self.max_resources = max_resources\n")
+        lines.insert(i + 2, "        self._active_resources = 0\n")
+        break
+
+# Update `with_resource`
+with_resource_start = 0
+for i, line in enumerate(lines):
+    if "def with_resource(self, context_manager: AbstractContextManager[V]) -> V:" in line:
+        with_resource_start = i
+        break
+
+# Find the end of `with_resource`
+with_resource_end = 0
+for i in range(with_resource_start, len(lines)):
+    if "return self._exit_stack.enter_context(context_manager)" in lines[i]:
+        with_resource_end = i
+        break
+
+# Replace `with_resource`
+new_with_resource = [
+    "    def with_resource(self, context_manager: AbstractContextManager[V]) -> V:\n",
+    "        # Check limits\n",
+    "        ctx = self\n",
+    "        while ctx is not None:\n",
+    "            if ctx.max_resources is not None and ctx._active_resources >= ctx.max_resources:\n",
+    "                raise RuntimeError('Maximum number of resources reached')\n",
+    "            ctx = ctx.parent\n",
+    "\n",
+    "        # Increment counts\n",
+    "        ctx = self\n",
+    "        while ctx is not None:\n",
+    "            ctx._active_resources += 1\n",
+    "            ctx = ctx.parent\n",
+    "\n",
+    "        try:\n",
+    "            res = self._exit_stack.enter_context(context_manager)\n",
+    "        except Exception:\n",
+    "            # Decrement counts if entry fails\n",
+    "            ctx = self\n",
+    "            while ctx is not None:\n",
+    "                ctx._active_resources -= 1\n",
+    "                ctx = ctx.parent\n",
+    "            raise\n",
+    "\n",
+    "        # Register a callback to decrement counts when the resource is closed\n",
+    "        def _decrement():\n",
+    "            ctx = self\n",
+    "            while ctx is not None:\n",
+    "                ctx._active_resources -= 1\n",
+    "                ctx = ctx.parent\n",
+    "\n",
+    "        self.call_on_close(_decrement)\n",
+    "        return res\n"
+]
+
+lines[with_resource_start:with_resource_end+1] = new_with_resource
+
+with open("src/click/core.py", "w") as f:
+    f.writelines(lines)
