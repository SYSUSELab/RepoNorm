diff --git a/test_fix.py b/test_fix.py
new file mode 100644
index 0000000..f3a96a6
--- /dev/null
+++ b/test_fix.py
@@ -0,0 +1,44 @@
+import click
+from contextlib import contextmanager
+
+@contextmanager
+def resource(name):
+    print(f"Entering {name}")
+    yield name
+    print(f"Exiting {name}")
+
+def test_max_resources():
+    # Test 1: Limit 1, register 2 resources. Should fail.
+    print("Test 1: Limit 1, register 2 resources")
+    try:
+        with click.Context(click.Command("test"), max_resources=1) as ctx:
+            ctx.with_resource(resource("r1"))
+            ctx.with_resource(resource("r2"))
+    except RuntimeError as e:
+        print(f"Caught expected RuntimeError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+    # Test 2: Limit 1, register 1 resource. Should succeed.
+    print("\nTest 2: Limit 1, register 1 resource")
+    try:
+        with click.Context(click.Command("test"), max_resources=1) as ctx:
+            ctx.with_resource(resource("r1"))
+            print("Successfully registered 1 resource")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+    # Test 3: Parent limit 1, child limit 1. Register 1 in parent, 1 in child. Should fail.
+    print("\nTest 3: Parent limit 1, child limit 1. Register 1 in parent, 1 in child")
+    try:
+        with click.Context(click.Command("parent"), max_resources=1) as parent_ctx:
+            parent_ctx.with_resource(resource("p1"))
+            child_ctx = click.Context(click.Command("child"), parent=parent_ctx)
+            child_ctx.with_resource(resource("c1"))
+    except RuntimeError as e:
+        print(f"Caught expected RuntimeError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_max_resources()
