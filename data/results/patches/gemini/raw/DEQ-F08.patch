new file mode 100644
index 0000000..faa46ec
--- /dev/null
+++ b/dirty_equals/_regex.py
@@ -0,0 +1,42 @@
+import re
+from typing import Any, Pattern, Union
+
+from ._base import DirtyEquals
+
+__all__ = ('IsRegex',)
+
+class IsRegex(DirtyEquals[str]):
+    def __init__(self, pattern: Union[str, Pattern[str]], flags: int = 0, *, mode: str = 'match'):
+        if mode not in ('match', 'search', 'fullmatch'):
+            raise ValueError(f"Invalid mode: {mode}. Must be one of 'match', 'search', 'fullmatch'")
+        
+        if isinstance(pattern, re.Pattern):
+            if flags != 0:
+                raise ValueError("Cannot pass flags when pattern is a compiled regex")
+            self.pattern = pattern
+            self.flags = pattern.flags
+        else:
+            self.pattern = re.compile(pattern, flags)
+            self.flags = flags
+            
+        self.mode = mode
+        
+        # Prepare repr
+        args = [repr(pattern)]
+        if flags != 0:
+            args.append(f"flags={flags}")
+        if mode != 'match':
+            args.append(f"mode={repr(mode)}")
+        
+        super().__init__(*args)
+        self._repr_args = args
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        func = getattr(re, self.mode)
+        return bool(func(self.pattern, other))
+
+    def _repr_ne(self) -> str:
+        return f"IsRegex({', '.join(self._repr_args)})"
diff --git a/reproduce_isregex.py b/reproduce_isregex.py
