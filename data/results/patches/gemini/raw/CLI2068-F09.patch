+import os
+import click
+from click._termui_impl import Editor
+
+# Set some environment variables
+os.environ["MY_SECRET_VAR"] = "secret_value"
+os.environ["PATH"] = "/usr/bin"
+
+# Mocking subprocess.Popen to check the environment
+import subprocess
+from unittest.mock import patch
+
+def mock_popen(cmd, env=None, shell=True):
+    print(f"Environment passed to editor: {env}")
+    class MockProcess:
+        def wait(self):
+            return 0
