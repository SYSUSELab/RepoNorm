diff --git a/test_isolation.py b/test_isolation.py
new file mode 100644
index 0000000..8153c12
--- /dev/null
+++ b/test_isolation.py
@@ -0,0 +1,57 @@
+import os
+from click._termui_impl import Editor
+from unittest.mock import patch
+
+# Define the allowlist
+ALLOWLIST = {
+    "PATH", "HOME", "USER", "USERNAME", "LOGNAME", "SHELL", "TERM", "DISPLAY",
+    "XAUTHORITY", "WAYLAND_DISPLAY", "LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE",
+    "LC_MESSAGES", "TMPDIR", "TMP", "TEMP", "SYSTEMROOT", "COMSPEC", "PATHEXT"
+}
+
+def test_isolation():
+    # Set some environment variables
+    os.environ["MY_SECRET_VAR"] = "secret_value"
+    os.environ["PATH"] = "/usr/bin"
+    os.environ["HOME"] = "/home/user"
+    os.environ["LANG"] = "en_US.UTF-8"
+
+    # Mock subprocess.Popen
+    captured_env = None
+    def mock_popen(cmd, env=None, shell=True):
+        nonlocal captured_env
+        captured_env = env
+        class MockProcess:
+            def wait(self):
+                return 0
+        return MockProcess()
+
+    with patch("subprocess.Popen", side_effect=mock_popen):
+        # Test with isolate_env=True
+        # We need to update Editor.__init__ first, but let's just simulate the logic
+        # for now to verify the filtering logic.
+        
+        # Simulate the logic that will be in Editor.edit_file
+        env_to_pass = {}
+        
+        # 1. Start with allowlist
+        for key in os.environ:
+            if key.upper() in ALLOWLIST:
+                env_to_pass[key] = os.environ[key]
+        
+        # 2. Apply caller's env
+        caller_env = {"NEW_VAR": "new_value", "MY_SECRET_VAR": "overridden_secret"}
+        env_to_pass.update(caller_env)
+        
+        print(f"Captured env: {env_to_pass}")
+        
+        # Verify
+        assert "MY_SECRET_VAR" in env_to_pass
+        assert env_to_pass["MY_SECRET_VAR"] == "overridden_secret"
+        assert "NEW_VAR" in env_to_pass
+        assert "PATH" in env_to_pass
+        assert "HOME" in env_to_pass
+        assert "LANG" in env_to_pass
+        assert "PYTHON_VERSION" not in env_to_pass # Should be filtered out
+
+test_isolation()
