@@ -0,0 +1,75 @@
+import tiktoken
+import pytest
+import string
+
+def test_transformers():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test single transformer
+    def lowercase_transform(text):
+        return text.lower()
+    
+    tokens = enc.encode("Hello World", transformers=lowercase_transform)
+    assert tokens == enc.encode("hello world")
+    
+    # Test chain of transformers
+    def remove_punctuation(text):
+        return text.translate(str.maketrans("", "", string.punctuation))
+    
+    tokens = enc.encode("Hello, World!", 
+                        transformers=[lowercase_transform, remove_punctuation])
+    assert tokens == enc.encode("hello world")
+
+def test_transformers_batch():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test single transformer
+    def lowercase_transform(text):
+        return text.lower()
+    
+    texts = ["Hello World", "GoodBye World"]
+    tokens = enc.encode_batch(texts, transformers=lowercase_transform)
+    assert tokens == [enc.encode("hello world"), enc.encode("goodbye world")]
+    
+    # Test chain of transformers
+    def remove_punctuation(text):
+        return text.translate(str.maketrans("", "", string.punctuation))
+    
+    texts = ["Hello, World!", "GoodBye, World!"]
+    tokens = enc.encode_batch(texts, 
+                              transformers=[lowercase_transform, remove_punctuation])
+    assert tokens == [enc.encode("hello world"), enc.encode("goodbye world")]
+
+def test_transformers_type_error():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def bad_transform(text):
+        return 123
+    
+    with pytest.raises(TypeError):
+        enc.encode("Hello World", transformers=bad_transform)
+        
+    with pytest.raises(TypeError):
+        enc.encode_batch(["Hello World"], transformers=bad_transform)
+
+def test_empty_batch():
+    enc = tiktoken.get_encoding("gpt2")
+    assert enc.encode_batch([]) == []
+    assert enc.encode_batch([], transformers=lambda x: x.lower()) == []
+
+def test_callback_exception():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def raise_exception(text):
+        raise ValueError("Callback failed")
+    
+    called = False
+    def ok_transform_with_side_effect(text):
+        nonlocal called
+        called = True
+        return text
+        
+    with pytest.raises(ValueError, match="Callback failed"):
+        enc.encode("Hello", transformers=[raise_exception, ok_transform_with_side_effect])
+    
+    assert not called
