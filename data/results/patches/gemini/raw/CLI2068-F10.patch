+import click
+import os
+import tempfile
+import shutil
+
+def test_edit_text_working_dir():
+    tmp_dir = tempfile.mkdtemp()
+    try:
+        # Use a script as the editor that checks the current working directory
+        editor_script = os.path.join(tmp_dir, "editor.py")
+        with open(editor_script, "w") as f:
+            f.write(f"""
+import os
+import sys
+print(f"CWD: {{os.getcwd()}}")
+# Check if the file is in the working directory
+if not os.path.abspath(sys.argv[1]).startswith(os.path.abspath(os.getcwd())):
+    print("File not in working directory!")
+    sys.exit(1)
+with open(sys.argv[1], 'w') as f:
+    f.write('edited')
+""")
+        os.chmod(editor_script, 0o755)
+        
+        # Set EDITOR to the script
+        os.environ["EDITOR"] = f"python3 {editor_script}"
+        
+        # Call click.edit
+        result = click.edit(text="hello", working_dir=tmp_dir)
+        
+        print(f"Result: {result}")
+        assert result == b'edited'
+            
+        print("Successfully verified text working_dir")
+            
+    finally:
+        shutil.rmtree(tmp_dir)
+
+if __name__ == "__main__":
+    test_edit_text_working_dir()
