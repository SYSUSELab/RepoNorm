+import sys
+
+with open("src/click/termui.py", "r") as f:
+    lines = f.readlines()
+
+# Find the definition of edit
+start_line = 0
+for i, line in enumerate(lines):
+    if line.startswith("def edit("):
+        start_line = i
+        break
+
+# Insert working_dir into the signature
+lines.insert(start_line + 6, "    working_dir: str | os.PathLike[str] | None = None,\n")
+
+# Update the docstring
+# Find the end of the docstring
+docstring_end = 0
+for i in range(start_line, len(lines)):
+    if lines[i].strip() == '"""':
+        docstring_end = i
+        break
+
+# Insert the new parameter description
+lines.insert(docstring_end, "    :param working_dir: an optional working directory to run the editor in.\n")
+
+# Update the Editor instantiation
+for i in range(docstring_end, len(lines)):
+    if "ed = Editor(" in lines[i]:
+        lines[i] = lines[i].replace("extension=extension)", "extension=extension, working_dir=working_dir)")
+        break
+
+with open("src/click/termui.py", "w") as f:
+    f.writelines(lines)
diff --git a/edit_termui_impl.py b/edit_termui_impl.py
