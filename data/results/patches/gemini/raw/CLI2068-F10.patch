diff --git a/test_default_working_dir.py b/test_default_working_dir.py
new file mode 100644
index 0000000..96033a2
--- /dev/null
+++ b/test_default_working_dir.py
@@ -0,0 +1,48 @@
+import click
+import os
+import tempfile
+import shutil
+
+def test_edit_default_working_dir():
+    # Create a temporary directory
+    tmp_dir = tempfile.mkdtemp()
+    cwd = os.getcwd()
+    try:
+        # Create a file in the current directory
+        file_path = os.path.join(cwd, "test_default.txt")
+        with open(file_path, "w") as f:
+            f.write("hello world")
+        
+        # Use a script as the editor that checks the current working directory
+        editor_script = os.path.join(tmp_dir, "editor.py")
+        with open(editor_script, "w") as f:
+            f.write(f"""
+import os
+import sys
+print(f"CWD: {{os.getcwd()}}")
+with open(sys.argv[1], 'w') as f:
+    f.write('edited')
+""")
+        os.chmod(editor_script, 0o755)
+        
+        # Set EDITOR to the script
+        os.environ["EDITOR"] = f"python3 {editor_script}"
+        
+        # Call click.edit
+        click.edit(filename="test_default.txt")
+        
+        # Check if the file was edited
+        with open(file_path, "r") as f:
+            content = f.read()
+            print(f"File content: {content}")
+            assert content == 'edited'
+            
+        print("Successfully verified default working_dir")
+            
+    finally:
+        if os.path.exists(file_path):
+            os.remove(file_path)
+        shutil.rmtree(tmp_dir)
+
+if __name__ == "__main__":
+    test_edit_default_working_dir()
