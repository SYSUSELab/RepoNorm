index 0000000..dcd7135
--- /dev/null
+++ b/rewrite_editor.py
@@ -0,0 +1,131 @@
+with open("src/click/_termui_impl.py", "r") as f:
+    lines = f.readlines()
+
+# Find the start of the Editor class
+start_line = 0
+for i, line in enumerate(lines):
+    if line.startswith("class Editor:"):
+        start_line = i
+        break
+
+# Find the end of the Editor class
+end_line = 0
+for i in range(start_line, len(lines)):
+    if lines[i].startswith("    def edit("):
+        # Find the end of the edit method
+        # This is a bit tricky, but let's just find the next class or end of file
+        # Actually, let's just replace the whole class
+        pass
+
+# Let's just replace the whole class with the new version
+new_class = """class Editor:
+    def __init__(
+        self,
+        editor: str | None = None,
+        env: cabc.Mapping[str, str] | None = None,
+        require_save: bool = True,
+        extension: str = ".txt",
+        working_dir: str | os.PathLike[str] | None = None,
+    ) -> None:
+        self.editor = editor
+        self.env = env
+        self.require_save = require_save
+        self.extension = extension
+        self.working_dir = working_dir
+
+    def get_editor(self) -> str:
+        if self.editor is not None:
+            return self.editor
+        for key in "VISUAL", "EDITOR":
+            rv = os.environ.get(key)
+            if rv:
+                return rv
+        if WIN:
+            return "notepad"
+        for editor in "sensible-editor", "vim", "nano":
+            if os.system(f"which {editor} >/dev/null 2>&1") == 0:
+                return editor
+        return "vi"
+
+    def edit_file(self, filename: str) -> None:
+        import subprocess
+
+        editor = self.get_editor()
+        environ: dict[str, str] | None = None
+
+        if self.env:
+            environ = os.environ.copy()
+            environ.update(self.env)
+
+        try:
+            c = subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True, cwd=self.working_dir)
+            exit_code = c.wait()
+            if exit_code != 0:
+                raise ClickException(
+                    _("{editor}: Editing failed").format(editor=editor)
+                )
+        except OSError as e:
+            raise ClickException(
+                _("{editor}: Editing failed: {e}").format(editor=editor, e=e)
+            ) from e
+
+    def edit(self, text: t.AnyStr | None) -> t.AnyStr | None:
+        import tempfile
+
+        if not text:
+            data = b""
+        elif isinstance(text, (bytes, bytearray)):
+            data = text
+        else:
+            if text and not text.endswith("\\n"):
+                text += "\\n"
+
+            if WIN:
+                data = text.replace("\\n", "\\r\\n").encode("utf-8-sig")
+            else:
+                data = text.encode("utf-8")
+
+        fd, name = tempfile.mkstemp(prefix="editor-", suffix=self.extension, dir=self.working_dir)
+        f: t.BinaryIO
+
+        try:
+            with os.fdopen(fd, "wb") as f:
+                f.write(data)
+
+            # If the filesystem resolution is 1 second, like Mac OS
+            # 10.12 Extended, or 2 seconds, like FAT32, and the editor
+            # closes very fast, require_save can fail. Set the modified
+            # time to be 2 seconds in the past to work around this.
+            os.utime(name, (os.path.getatime(name), os.path.getmtime(name) - 2))
+            # Depending on the resolution, the exact value might not be
+            # exactly 2 seconds, but it should be enough to be older than
+            # the current time.
+            mtime = os.path.getmtime(name)
+
+            self.edit_file(name)
+
+            if self.require_save and os.path.getmtime(name) == mtime:
+                return None
+
+            with open(name, "rb") as f:
+                return f.read()  # type: ignore
+        finally:
+            try:
+                os.remove(name)
+            except OSError:
+                pass
+"""
+
+# Find the end of the class
+# The class ends before `def edit(` in termui.py? No, it's in _termui_impl.py
+# Let's find the next class or function
+end_line = 0
+for i in range(start_line + 1, len(lines)):
+    if lines[i].startswith("def ") or lines[i].startswith("class "):
+        end_line = i
+        break
+
+lines[start_line:end_line] = [new_class]
+
+with open("src/click/_termui_impl.py", "w") as f:
+    f.writelines(lines)
