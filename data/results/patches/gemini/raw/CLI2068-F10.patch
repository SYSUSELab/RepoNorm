index 0000000..6f3fc5d
--- /dev/null
+++ b/edit_termui_impl.py
@@ -0,0 +1,42 @@
+import sys
+
+with open("src/click/_termui_impl.py", "r") as f:
+    lines = f.readlines()
+
+# Update __init__
+for i, line in enumerate(lines):
+    if "def __init__(" in line:
+        # Find the end of __init__ arguments
+        j = i
+        while ")" not in lines[j]:
+            j += 1
+        lines.insert(j, "        working_dir: str | os.PathLike[str] | None = None,\n")
+        lines.insert(j + 2, "        self.working_dir = working_dir\n")
+        break
+
+# Update edit_file
+for i, line in enumerate(lines):
+    if "def edit_file(self, filename: str) -> None:" in line:
+        # Find the Popen call
+        for k in range(i, i + 20):
+            if "c = subprocess.Popen(" in lines[k]:
+                # Add cwd=self.working_dir
+                lines[k] = lines[k].replace("env=environ, shell=True)", "env=environ, shell=True, cwd=self.working_dir)")
+                break
+        break
+
+# Update edit
+for i, line in enumerate(lines):
+    if "def edit(self, text: t.AnyStr | None) -> t.AnyStr | None:" in line:
+        # Find the tempfile.mkstemp call
+        for k in range(i, i + 20):
+            if "fd, name = tempfile.mkstemp(" in lines[k]:
+                # We need to make sure the temp file is created in the working directory if provided
+                # Actually, the requirement says: "the temporary file created for the text form must remain usable from that directory."
+                # So we should use dir=self.working_dir in mkstemp
+                lines[k] = lines[k].replace("prefix=\"editor-\", suffix=self.extension)", "prefix=\"editor-\", suffix=self.extension, dir=self.working_dir)")
+                break
+        break
+
+with open("src/click/_termui_impl.py", "w") as f:
+    f.writelines(lines)
