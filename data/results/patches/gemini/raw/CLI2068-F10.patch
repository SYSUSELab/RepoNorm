diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..66f4635
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,29 @@
+import click
+import os
+import tempfile
+import shutil
+
+def test_edit_working_dir():
+    # Create a temporary directory
+    tmp_dir = tempfile.mkdtemp()
+    try:
+        # Create a file in that directory
+        file_path = os.path.join(tmp_dir, "test.txt")
+        with open(file_path, "w") as f:
+            f.write("hello world")
+        
+        # Try to edit it with a working directory
+        # We need to mock the editor to avoid actually opening an editor
+        # We can set EDITOR=cat
+        os.environ["EDITOR"] = "cat"
+        
+        # This should now work
+        print("Calling click.edit with working_dir...")
+        click.edit(filename="test.txt", working_dir=tmp_dir)
+        print("Successfully called click.edit with working_dir")
+            
+    finally:
+        shutil.rmtree(tmp_dir)
+
+if __name__ == "__main__":
+    test_edit_working_dir()
