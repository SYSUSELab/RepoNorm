+import unittest
+from jinja2 import DictLoader, FileSystemLoader, FunctionLoader, PrefixLoader, ChoiceLoader, ModuleLoader, PackageLoader, TemplateNotFound, Environment
+import os
+
+class TestAllLoaders(unittest.TestCase):
+    def test_filesystem_loader(self):
+        os.makedirs("templates", exist_ok=True)
+        with open("templates/foo.html", "w") as f:
+            f.write("hello")
+        
+        def transform(name):
+            return name.replace("bar", "foo")
+        
+        loader = FileSystemLoader("templates", path_transform=transform)
+        env = Environment(loader=loader)
+        
+        template = env.get_template('bar.html')
+        self.assertEqual(template.render(), 'hello')
+        
+    def test_choice_loader(self):
+        loader1 = DictLoader({'foo.html': 'hello'})
+        loader2 = DictLoader({'bar.html': 'world'})
+        
+        def transform(name):
+            return name.replace("baz", "bar")
+            
+        loader = ChoiceLoader([loader1, loader2], path_transform=transform)
+        env = Environment(loader=loader)
+        
+        template = env.get_template('baz.html')
+        self.assertEqual(template.render(), 'world')
+
+if __name__ == '__main__':
+    unittest.main()
