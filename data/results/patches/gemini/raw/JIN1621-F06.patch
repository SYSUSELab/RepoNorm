@@ -0,0 +1,21 @@
+import unittest
+from jinja2 import DictLoader, ChoiceLoader, Environment, TemplateNotFound
+
+def test_debug():
+    loader1 = DictLoader({'foo.html': 'hello'})
+    loader2 = DictLoader({'bar.html': 'world'})
+    
+    def transform(name):
+        return name.replace("baz", "bar")
+        
+    loader = ChoiceLoader([loader1, loader2], path_transform=transform)
+    env = Environment(loader=loader)
+    
+    # Manually call get_source to debug
+    try:
+        source, filename, uptodate = loader.get_source(env, 'baz.html')
+        print(f"Source: {source}")
+    except TemplateNotFound as e:
+        print(f"TemplateNotFound: {e.name}")
+
+test_debug()
