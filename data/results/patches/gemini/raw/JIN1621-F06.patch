+import unittest
+from jinja2 import DictLoader, TemplateNotFound, Environment
+
+class TestPathTransform(unittest.TestCase):
+    def test_dict_loader_transform(self):
+        def transform(name):
+            return name.replace("foo", "bar")
+        
+        loader = DictLoader({'bar.html': 'hello'}, path_transform=transform)
+        env = Environment(loader=loader)
+        
+        template = env.get_template('foo.html')
+        self.assertEqual(template.render(), 'hello')
+        
+    def test_transform_type_error(self):
+        def transform(name):
+            return 123
+        
+        loader = DictLoader({'bar.html': 'hello'}, path_transform=transform)
+        env = Environment(loader=loader)
+        
+        with self.assertRaises(TypeError) as cm:
+            env.get_template('foo.html')
+        self.assertEqual(str(cm.exception), 'path_transform must return a string')
+
+    def test_template_not_found_original_name(self):
+        def transform(name):
+            return "nonexistent.html"
+        
+        loader = DictLoader({'bar.html': 'hello'}, path_transform=transform)
+        env = Environment(loader=loader)
+        
+        with self.assertRaises(TemplateNotFound) as cm:
+            env.get_template('foo.html')
+        self.assertEqual(cm.exception.name, 'foo.html')
+
+if __name__ == '__main__':
+    unittest.main()
