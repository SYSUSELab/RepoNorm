+from jinja2 import Environment, FileSystemLoader, TemplateNotFound
+import os
+
+# Create a dummy template
+os.makedirs("templates", exist_ok=True)
+with open("templates/test.html", "w") as f:
+    f.write("Hello {{ name }}!")
+
+# Define a transform
+def my_transform(name):
+    print(f"Transforming {name}")
+    return "test.html"
+
+# This is what I want to implement
+class MyFileSystemLoader(FileSystemLoader):
+    def __init__(self, searchpath, path_transform=None, **kwargs):
+        super().__init__(searchpath, **kwargs)
+        self.path_transform = path_transform
+
+    def get_source(self, environment, template):
+        original_template = template
+        if self.path_transform:
+            template = self.path_transform(template)
+            if not isinstance(template, str):
+                raise TypeError("path_transform must return a string")
+        
+        try:
+            return super().get_source(environment, template)
+        except TemplateNotFound as e:
+            # The requirement says:
+            # "When lookup of a transformed name fails, TemplateNotFound.name is the original name passed to that loader."
+            raise TemplateNotFound(original_template) from e
+
+loader = MyFileSystemLoader("templates", path_transform=my_transform)
+env = Environment(loader=loader)
+# The template name passed to get_template is "something_else.html"
+# but the transform will change it to "test.html"
+try:
+    template = env.get_template("nonexistent.html")
+except TemplateNotFound as e:
+    print(f"Caught expected error: {e.name}")
