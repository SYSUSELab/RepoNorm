@@ -0,0 +1,17 @@
+import pytest
+from outlines import types
+from outlines.types.dsl import Regex
+
+def test_sha256_type():
+    assert isinstance(types.hash_sha256, Regex)
+    assert types.hash_sha256.pattern == r"[a-fA-F0-9]{64}"
+
+    # Test against some values
+    import re
+    regex = re.compile(f"^{types.hash_sha256.pattern}$")
+    
+    assert regex.fullmatch("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
+    assert regex.fullmatch("E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855")
+    assert not regex.fullmatch("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85")
+    assert not regex.fullmatch("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b8555")
+    assert not regex.fullmatch("g3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
