+import click
+from click.testing import CliRunner
+
+@click.command()
+@click.option("--foo")
+@click.option("--bar", default={"--foo": {"a": "1", "b": "2"}})
+def cli(foo, bar):
+    click.echo(f"foo={foo}, bar={bar}")
+    ctx = click.get_current_context()
+    for param in ctx.command.get_params(ctx):
+        source = ctx.get_parameter_source(param.name)
+        click.echo(f"param={param.name}, source={source}")
+
+runner = CliRunner()
+result = runner.invoke(cli, ["--bar", "a"])
+print(result.output)
