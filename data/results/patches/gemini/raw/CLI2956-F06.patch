+import click
+from click.testing import CliRunner
+
+@click.command()
+@click.option("--foo")
+@click.option("--bar", default="a")
+@click.option("--baz", default={"--foo": {"a": "1", "b": "2"}})
+def cli(foo, bar, baz):
+    click.echo(f"foo={foo}, bar={bar}, baz={baz}")
+
+runner = CliRunner()
+# If I run `cli --bar a`, foo should be '1'.
+# If I run `cli --bar b`, foo should be '2'.
+# If I run `cli --foo x --bar a`, foo should be 'x'.
+
+result = runner.invoke(cli, ["--bar", "a"])
+print(f"Output for --bar a: {result.output.strip()}")
+
+result = runner.invoke(cli, ["--bar", "b"])
