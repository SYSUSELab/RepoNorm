diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..7cb0158 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,33 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+def test_edit_timeout():
+    import subprocess
+    import click
+    import os
+
+    # Create a slow editor script
+    editor_script = """#!/bin/bash
+    sleep 2
+    exit 0
+    """
+    with open("slow_editor.sh", "w") as f:
+        f.write(editor_script)
+    os.chmod("slow_editor.sh", 0o755)
+
+    # Test timeout
+    with pytest.raises(click.ClickException) as excinfo:
+        click.edit("hello", editor="./slow_editor.sh", timeout=1)
+    assert "Editing timed out after 1 seconds" in str(excinfo.value)
+
+    # Test no timeout
+    click.edit("hello", editor="true", timeout=None)
+
+    # Test invalid timeout
+    with pytest.raises(ValueError) as excinfo:
+        click.edit("hello", editor="true", timeout=-1)
+    assert "timeout must be a positive integer" in str(excinfo.value)
+    
+    # Cleanup
+    os.remove("slow_editor.sh")
