+
+class IsColor(DirtyEquals[str]):
+    """
+    Checks if a value is a valid color code (hex, rgb, or hsl).
+    """
+
+    def __init__(self, format: Optional[Literal['hex', 'rgb', 'hsl']] = None):
+        """
+        Args:
+            format: The expected color format, if omitted, any supported format is accepted.
+        """
+        self.format = format
+        if format:
+            super().__init__(format)
+        else:
+            super().__init__(plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        value = other.strip()
+        
+        # Hex
+        if self.format in (None, 'hex'):
+            if re.fullmatch(r'#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})', value):
+                return True
+                
+        # RGB
+        if self.format in (None, 'rgb'):
+            match = re.fullmatch(r'(?i)rgb\(\s*(\d{1,3}%?)\s*,\s*(\d{1,3}%?)\s*,\s*(\d{1,3}%?)\s*\)', value)
+            if match:
+                components = match.groups()
+                valid = True
+                for comp in components:
+                    if comp.endswith('%'):
+                        val = int(comp[:-1])
+                        if not (0 <= val <= 100):
+                            valid = False
+                    else:
+                        val = int(comp)
+                        if not (0 <= val <= 255):
+                            valid = False
+                if valid:
+                    return True
+
+        # HSL
+        if self.format in (None, 'hsl'):
+            match = re.fullmatch(r'(?i)hsl\(\s*(\d{1,3})(deg)?\s*,\s*(\d{1,3}%)\s*,\s*(\d{1,3}%)\s*\)', value)
+            if match:
+                h, deg, s, l = match.groups()
+                
+                h_val = int(h)
+                if not (0 <= h_val <= 360):
+                    return False
+                    
+                # Saturation/Lightness
+                for comp in [s, l]:
+                    val = int(comp[:-1])
+                    if not (0 <= val <= 100):
+                        return False
+                return True
+                
+        return False
diff --git a/tests/test_color.py b/tests/test_color.py
new file mode 100644
index 0000000..4f8f02c
--- /dev/null
+++ b/tests/test_color.py
@@ -0,0 +1,35 @@
+from dirty_equals import IsColor
+import pytest
+
+def test_is_color_hex():
+    assert '#FF5733' == IsColor('hex')
+    assert '#f57' == IsColor('hex')
+    assert 'FF5733' == IsColor('hex')
+    assert '#FF5733' == IsColor()
+    assert 'invalid' != IsColor('hex')
+
+def test_is_color_rgb():
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'rgb(100%, 0%, 0%)' == IsColor('rgb')
+    assert 'rgb(0, 0, 0)' == IsColor('rgb')
+    assert 'rgb(255, 255, 255)' == IsColor('rgb')
+    assert 'rgb(256, 0, 0)' != IsColor('rgb')
+    assert 'rgb(101%, 0%, 0%)' != IsColor('rgb')
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'invalid' != IsColor('rgb')
+
+def test_is_color_hsl():
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(14deg, 100%, 60%)' == IsColor('hsl')
+    assert 'hsl(360, 100%, 100%)' == IsColor('hsl')
+    assert 'hsl(361, 100%, 100%)' != IsColor('hsl')
+    assert 'hsl(14, 101%, 60%)' != IsColor('hsl')
+    assert 'hsl(14, 100%, 101%)' != IsColor('hsl')
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'invalid' != IsColor('hsl')
+
+def test_is_color_repr():
+    assert repr(IsColor()) == "IsColor(*)"
+    assert repr(IsColor('hex')) == "IsColor('hex')"
+    assert repr(IsColor('rgb')) == "IsColor('rgb')"
+    assert repr(IsColor('hsl')) == "IsColor('hsl')"
