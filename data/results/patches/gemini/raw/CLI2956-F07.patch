+import sys
+
+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+new_lines = []
+in_invoke = False
+for line in lines:
+    if 'def invoke(self, ctx: Context) -> t.Any:' in line and 'class Command' in lines[lines.index(line)-5:lines.index(line)]:
+        in_invoke = True
+        new_lines.append(line)
+        new_lines.append('        for param in self.get_params(ctx):\n')
+        new_lines.append('            if isinstance(param, Option) and param.conflicts_with:\n')
+        new_lines.append('                for conflict in param.conflicts_with:\n')
+        new_lines.append('                    if not isinstance(conflict, str):\n')
+        new_lines.append('                        raise TypeError(f"Conflict name must be a string, got {type(conflict).__name__}")\n')
+        new_lines.append('                    if conflict.startswith("-"):\n')
+        new_lines.append('                        raise TypeError(f"Conflict name must not have option prefixes, got {conflict}")\n')
+        new_lines.append('                    if conflict == param.name:\n')
+        new_lines.append('                        raise UsageError(f"Option \'{param.name}\' cannot conflict with itself.")\n')
+        new_lines.append('                    found = False\n')
+        new_lines.append('                    for p in self.get_params(ctx):\n')
+        new_lines.append('                        if p.name == conflict:\n')
+        new_lines.append('                            found = True\n')
+        new_lines.append('                            break\n')
+        new_lines.append('                    if not found:\n')
+        new_lines.append('                        raise UsageError(f"Option \'{param.name}\' conflicts with unknown option \'{conflict}\'.")\n')
+        new_lines.append('                    source = ctx.get_parameter_source(param.name)\n')
+        new_lines.append('                    if source in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):\n')
+        new_lines.append('                        conflict_source = ctx.get_parameter_source(conflict)\n')
+        new_lines.append('                        if conflict_source in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):\n')
+        new_lines.append('                            raise UsageError(f"Option \'--{param.name.replace("_", "-")}\' cannot be used together with \'--{conflict.replace("_", "-")}\'.")\n')
+    elif in_invoke and 'return ctx.invoke(self.callback, **ctx.params)' in line:
+        new_lines.append(line)
+        in_invoke = False
+    else:
+        new_lines.append(line)
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(new_lines)
