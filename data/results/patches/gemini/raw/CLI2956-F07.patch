--- /dev/null
+++ b/test_edge_cases.py
@@ -0,0 +1,85 @@
+import click
+from click.testing import CliRunner
+import pytest
+
+def test_defaults_no_conflict():
+    @click.command()
+    @click.option("--foo", conflicts_with=["bar"], default="1")
+    @click.option("--bar", default="2")
+    def cli(foo, bar):
+        click.echo(f"foo={foo}, bar={bar}")
+
+    runner = CliRunner()
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert "foo=1, bar=2" in result.output
+
+def test_envvar_no_conflict():
+    import os
+    os.environ["FOO"] = "1"
+    os.environ["BAR"] = "2"
+    @click.command()
+    @click.option("--foo", conflicts_with=["bar"], envvar="FOO")
+    @click.option("--bar", envvar="BAR")
+    def cli(foo, bar):
+        click.echo(f"foo={foo}, bar={bar}")
+
+    runner = CliRunner()
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert "foo=1, bar=2" in result.output
+    del os.environ["FOO"]
+    del os.environ["BAR"]
+
+def test_invalid_conflict_name_type():
+    try:
+        @click.command()
+        @click.option("--foo", conflicts_with=[123])
+        def cli(foo):
+            pass
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
+    else:
+        print("Failed to catch TypeError")
+
+def test_invalid_conflict_name_prefix():
+    try:
+        @click.command()
+        @click.option("--foo", conflicts_with=["--bar"])
+        def cli(foo):
+            pass
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
+    else:
+        print("Failed to catch TypeError")
+
+def test_unknown_conflict_name():
+    @click.command()
+    @click.option("--foo", conflicts_with=["baz"])
+    def cli(foo):
+        pass
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--foo", "1"])
+    assert result.exit_code != 0
+    assert "conflicts with unknown option 'baz'" in result.output
+
+def test_self_conflict():
+    @click.command()
+    @click.option("--foo", conflicts_with=["foo"])
+    def cli(foo):
+        pass
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--foo", "1"])
+    assert result.exit_code != 0
+    assert "cannot conflict with itself" in result.output
+
+if __name__ == "__main__":
+    test_defaults_no_conflict()
+    test_envvar_no_conflict()
+    test_invalid_conflict_name_type()
+    test_invalid_conflict_name_prefix()
+    test_unknown_conflict_name()
+    test_self_conflict()
+    print("All tests passed!")
