diff --git a/tests/test_edit_multiple.py b/tests/test_edit_multiple.py
new file mode 100644
index 0000000..b0b0c5c
--- /dev/null
+++ b/tests/test_edit_multiple.py
@@ -0,0 +1,26 @@
+import click
+import pytest
+import subprocess
+from unittest.mock import patch
+
+def test_edit_multiple_files():
+    with patch("subprocess.Popen") as mock_popen:
+        mock_popen.return_value.wait.return_value = 0
+        
+        # Test with a list of files
+        click.edit(filename=["file1.txt", "file 2.txt"])
+        
+        # Verify Popen was called with the correct arguments
+        # The editor defaults to 'vi' if not set
+        args, kwargs = mock_popen.call_args
+        assert args[0][0] == "vi"
+        assert args[0][1] == "file1.txt"
+        assert args[0][2] == "file 2.txt"
+
+def test_edit_empty_files():
+    with pytest.raises(ValueError, match="filenames cannot be empty"):
+        click.edit(filename=[])
+
+def test_edit_non_string_files():
+    with pytest.raises(TypeError, match="All items in filenames must be strings"):
+        click.edit(filename=["file1.txt", 123])
