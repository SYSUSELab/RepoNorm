+import tiktoken
+import time
+
+def test_caching():
+    encoding = tiktoken.get_encoding("cl100k_base")
+    text = "Hello world" * 100
+    
+    # Warm up
+    encoding.encode(text)
+    
+    # Measure without caching
+    start = time.perf_counter()
+    for _ in range(1000):
+        encoding.encode(text)
+    end = time.perf_counter()
+    print(f"Time without caching: {end - start:.4f}s")
+    
+    # Measure with caching (if it were implemented)
+    # This should fail with TypeError or AttributeError currently
+    try:
+        start = time.perf_counter()
+        for _ in range(1000):
+            encoding.encode(text, use_cache=True)
+        end = time.perf_counter()
+        print(f"Time with caching: {end - start:.4f}s")
+    except Exception as e:
+        print(f"Caught expected error: {e}")
+
+if __name__ == "__main__":
+    test_caching()
