index 0000000..2832ce2
--- /dev/null
+++ b/tests/test_nesting.py
@@ -0,0 +1,105 @@
+import click
+import pytest
+from click.globals import get_current_context
+
+def test_nested_context_validation_success():
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def child():
+        pass
+
+    # Test that it works when closed in correct order
+    with click.Context(cli, validate_nesting=True) as ctx:
+        with click.Context(cli.commands['child'], parent=ctx) as child_ctx:
+            pass
+
+def test_nested_context_validation_failure():
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def child():
+        pass
+
+    # Test that it fails when closed in incorrect order
+    ctx = click.Context(cli, validate_nesting=True)
+    child_ctx = click.Context(cli.commands['child'], parent=ctx)
+    
+    with pytest.raises(RuntimeError, match="has outstanding children"):
+        ctx.close()
+    
+    # Cleanup
+    child_ctx.close()
+    ctx.close()
+
+def test_make_context_nesting():
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def child():
+        pass
+
+    parent_ctx = click.Context(cli, validate_nesting=True)
+    child_ctx = cli.commands['child'].make_context('child', [], parent=parent_ctx)
+    
+    with pytest.raises(RuntimeError, match="has outstanding children"):
+        parent_ctx.close()
+    
+    child_ctx.close()
+    parent_ctx.close()
+
+def test_multiple_levels():
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def child1():
+        pass
+
+    @cli.command()
+    def child2():
+        pass
+
+    parent_ctx = click.Context(cli, validate_nesting=True)
+    c1 = click.Context(cli.commands['child1'], parent=parent_ctx)
+    c2 = click.Context(cli.commands['child2'], parent=parent_ctx)
+    
+    with pytest.raises(RuntimeError, match="has outstanding children"):
+        parent_ctx.close()
+    
+    c1.close()
+    with pytest.raises(RuntimeError, match="has outstanding children"):
+        parent_ctx.close()
+        
+    c2.close()
+    parent_ctx.close()
+
+def test_exit_pop():
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def child():
+        pass
+
+    parent_ctx = click.Context(cli, validate_nesting=True)
+    child_ctx = click.Context(cli.commands['child'], parent=parent_ctx)
+    
+    # Use parent_ctx as a context manager
+    with pytest.raises(RuntimeError, match="has outstanding children"):
+        with parent_ctx:
+            pass
+            
+    # Check if parent_ctx is still in the stack
+    with pytest.raises(RuntimeError):
+        get_current_context()
+        
+    child_ctx.close()
