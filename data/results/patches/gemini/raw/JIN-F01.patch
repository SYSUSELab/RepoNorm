@@ -0,0 +1,47 @@
+from itertools import groupby
+from collections import namedtuple
+
+_GroupTuple = namedtuple("_GroupTuple", ["grouper", "list"])
+
+def sync_do_groupby(
+    value,
+    attribute,
+    default=None,
+    case_sensitive=False,
+):
+    # Mocking make_attrgetter
+    def expr(item):
+        return getattr(item, attribute)
+
+    def key_func(item):
+        val = expr(item)
+        if case_sensitive:
+            return val
+        if isinstance(val, str):
+            return val.lower()
+        return val
+
+    # Sort
+    sorted_items = sorted(value, key=key_func)
+    
+    # Group
+    result = []
+    for _, group in groupby(sorted_items, key=key_func):
+        group_list = list(group)
+        # The key should be the first encountered key in the original list.
+        # Since we used a stable sort, the first item in group_list is the one that appeared first in the original list.
+        # So we can just use expr(group_list[0]) as the key.
+        
+        actual_key = expr(group_list[0])
+        result.append(_GroupTuple(actual_key, group_list))
+    return result
+
+class Item:
+    def __init__(self, name):
+        self.name = name
+    def __repr__(self):
+        return f"Item({self.name})"
+
+items = [Item("apple"), Item("Apple"), Item("banana")]
+print(sync_do_groupby(items, "name", case_sensitive=False))
+print(sync_do_groupby(items, "name", case_sensitive=True))
