+from itertools import groupby
+
+# What if the attribute is not a string?
+# The requirement says: "Non-string comparable keys retain normal grouping behavior."
+
+class Item:
+    def __init__(self, val):
+        self.val = val
+    def __repr__(self):
+        return f"Item({self.val})"
+
+items = [Item(1), Item(1), Item(2)]
+
+def get_key(item):
+    return item.val
+
+# If we use the same logic:
+def case_insensitive_key(item):
+    val = get_key(item)
+    if isinstance(val, str):
+        return val.lower()
+    return val
+
+# Sort
+sorted_items = sorted(items, key=case_insensitive_key)
+print(f"Sorted: {sorted_items}")
+
+# Group
+grouped = []
+for key, group in groupby(sorted_items, key=case_insensitive_key):
+    group_list = list(group)
+    # The key in the groupby result is the lowercased string or the original value.
+    # We want the original value as the key.
+    
+    # If it's a string, we want the first encountered key.
+    # If it's not a string, we want the key itself.
+    
+    # The first item in group_list is the one that appeared first in the original list (due to stable sort).
+    # So we can just use get_key(group_list[0]) as the key.
+    
+    actual_key = get_key(group_list[0])
+    grouped.append((actual_key, group_list))
+
+print(f"Grouped: {grouped}")
