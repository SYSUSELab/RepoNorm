+from itertools import groupby
+
+items = ["Apple", "apple", "banana"]
+
+# We want to group by lowercased key, but use the first encountered key as the group key.
+
+# 1. Sort by lowercased key.
+# 2. Group by lowercased key.
+# 3. For each group, find the first key.
+
+def get_key(item):
+    return item.lower()
+
+# Sort
+sorted_items = sorted(items, key=get_key)
+print(f"Sorted: {sorted_items}")
+
+# Group
+grouped = []
+for key, group in groupby(sorted_items, key=get_key):
+    group_list = list(group)
+    # Find the first key in the original list that matches this group
+    # Actually, we can just find the first item in the group_list that matches the key?
+    # No, the group_list is already sorted by the key function.
+    # The first item in group_list is the one that appeared first in the sorted list.
+    # But we want the one that appeared first in the *original* list.
+    
+    # Let's keep track of the original order.
+    # We can use a stable sort.
+    
+    # If we use a stable sort, the first item in group_list is the one that appeared first in the original list.
+    # Let's verify.
+    
+    first_key = group_list[0]
+    grouped.append((first_key, group_list))
+
+print(f"Grouped: {grouped}")
+
+# Test with ["apple", "Apple"]
+items2 = ["apple", "Apple"]
+sorted_items2 = sorted(items2, key=get_key)
+print(f"Sorted2: {sorted_items2}")
+grouped2 = []
+for key, group in groupby(sorted_items2, key=get_key):
+    group_list = list(group)
+    first_key = group_list[0]
+    grouped2.append((first_key, group_list))
+print(f"Grouped2: {grouped2}")
