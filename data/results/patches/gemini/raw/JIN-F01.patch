+with open('tests/test_filters.py', 'a') as f:
+    f.write('''
+    def test_groupby_case_sensitive(self, env):
+        tmpl = env.from_string(
+            "{% for key, items in users|groupby('name', case_sensitive=False) %}"
+            "{{ key }}: {{ items|map(attribute='name')|join(', ') }}\n"
+            "{% endfor %}"
+            "---"
+            "{% for key, items in users|groupby('name', case_sensitive=True) %}"
+            "{{ key }}: {{ items|map(attribute='name')|join(', ') }}\n"
+            "{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "apple"},
+                {"name": "Apple"},
+                {"name": "banana"},
+            ]
+        )
+        assert out == "apple: apple, Apple\\nbanana: banana\\n---\\nApple: Apple\\napple: apple\\nbanana: banana\\n"
+''')
