+# 2. Add escape_shell to Editor.__init__
+# Find Editor.__init__
+editor_init_pattern = r'(class Editor:.*?def __init__\(self,.*?extension: str = ".txt",)'
+def add_escape_shell(match):
+    return match.group(1) + '\n        escape_shell: bool = False,'
+
+content = re.sub(editor_init_pattern, add_escape_shell, content, flags=re.DOTALL)
+
+# 3. Add self.escape_shell = escape_shell to Editor.__init__
+editor_init_body_pattern = r'(def __init__\(self,.*?self.extension = extension)'
+def add_self_escape_shell(match):
+    return match.group(1) + '\n        self.escape_shell = escape_shell'
+
+content = re.sub(editor_init_body_pattern, add_self_escape_shell, content, flags=re.DOTALL)
+
+with open('src/click/_termui_impl.py', 'w') as f:
+    f.write(content)
