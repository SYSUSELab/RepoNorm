@@ -0,0 +1,42 @@
+import re
+
+with open('src/click/_termui_impl.py', 'r') as f:
+    content = f.read()
+
+# Add escape_shell to Editor.__init__
+# The pattern needs to be more specific to avoid matching other things
+# Let's use a more robust way to find the __init__ method
+pattern = r'(class Editor:.*?def __init__\(self,.*?extension: str = ".txt",)'
+def add_escape_shell(match):
+    return match.group(1) + '\n        escape_shell: bool = False,'
+
+# This regex might not work if the file has already been modified in a way that breaks the pattern.
+# Let's just manually replace the lines.
+
+lines = content.splitlines()
+for i, line in enumerate(lines):
+    if 'class Editor:' in line:
+        # Find __init__
+        for j in range(i, i + 10):
+            if 'def __init__(' in lines[j]:
+                # Find extension
+                for k in range(j, j + 10):
+                    if 'extension: str = ".txt",' in lines[k]:
+                        lines.insert(k + 1, '        escape_shell: bool = False,')
+                        break
+                # Find self.extension
+                for k in range(j, j + 20):
+                    if 'self.extension = extension' in lines[k]:
+                        lines.insert(k + 1, '        self.escape_shell = escape_shell')
+                        break
+                break
+        break
+
+content = '\n'.join(lines)
+
+# Fix edit_file
+# The previous attempt to fix edit_file worked, but the __init__ didn't.
+# Let's keep the edit_file fix.
+
+with open('src/click/_termui_impl.py', 'w') as f:
+    f.write(content)
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..5789c44
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,35 @@
+import click
+import os
+import subprocess
+import sys
+
+# What if the filename contains a quote?
+# The command becomes: editor "file"with"quotes; touch pwned.txt"
+# This is:
+# 1. editor "file"
+# 2. with"quotes; touch pwned.txt"
+# This might execute `touch pwned.txt` if `with"quotes` is not a valid command.
+# Wait, `with"quotes` is not a command.
+# But what if the filename is: `"; touch pwned.txt; "`
+# The command becomes: editor ""; touch pwned.txt; ""
+# This will execute `editor ""` then `touch pwned.txt` then `""`
+
+filename = '"; touch pwned.txt; "'
+with open(filename, 'w') as f:
+    f.write('hello')
+
+try:
+    os.environ['EDITOR'] = 'true'
+    click.edit(filename=filename)
+except Exception as e:
+    print(f"Caught expected error: {e}")
+
+if os.path.exists('pwned.txt'):
+    print("VULNERABLE: pwned.txt was created!")
+    os.remove('pwned.txt')
+else:
+    print("NOT VULNERABLE: pwned.txt was not created.")
+
+# Clean up
+if os.path.exists(filename):
+    os.remove(filename)
