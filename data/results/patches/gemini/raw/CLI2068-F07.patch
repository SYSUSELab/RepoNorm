+import sys
+
+with open('src/click/_termui_impl.py', 'r') as f:
+    lines = f.readlines()
+
+# Update __init__
+for i, line in enumerate(lines):
+    if 'def __init__(' in line and 'self,' in lines[i+1]:
+        # Find the end of __init__ arguments
+        j = i
+        while ')' not in lines[j]:
+            j += 1
+        lines.insert(j, '        escape_shell: bool = False,\n')
+        lines.insert(j+2, '        self.escape_shell = escape_shell\n')
+        break
+
+# Update edit_file
+for i, line in enumerate(lines):
+    if 'def edit_file(self, filename: str) -> None:' in line:
+        # Find the Popen call
+        j = i
+        while 'subprocess.Popen' not in lines[j]:
+            j += 1
+        
+        # Replace the Popen call
+        lines[j] = """        if self.escape_shell:
+            import shlex
+            args = shlex.split(editor)
+            args.append(filename)
+            c = subprocess.Popen(args, env=environ)
+        else:
+            c = subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True)
+"""
+        break
+
+with open('src/click/_termui_impl.py', 'w') as f:
+    f.writelines(lines)
