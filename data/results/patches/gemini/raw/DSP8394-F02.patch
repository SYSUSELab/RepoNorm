diff --git a/dspy/clients/namespace.py b/dspy/clients/namespace.py
new file mode 100644
index 00000000..57a5825f
--- /dev/null
+++ b/dspy/clients/namespace.py
@@ -0,0 +1,35 @@
+import threading
+import contextlib
+from typing import Optional
+
+class NamespaceAccessor:
+    def __init__(self):
+        self._local = threading.local()
+
+    @property
+    def value(self) -> Optional[str]:
+        return getattr(self._local, "value", None)
+
+    @value.setter
+    def value(self, val: Optional[str]):
+        if val is not None and not isinstance(val, str):
+            raise ValueError("Namespace must be a string or None")
+        self._local.value = val
+
+    def set(self, val: Optional[str]):
+        self.value = val
+
+    @contextlib.contextmanager
+    def __call__(self, val: Optional[str]):
+        old_val = self.value
+        self.value = val
+        try:
+            yield
+        finally:
+            self.value = old_val
+
+    def __eq__(self, other):
+        return self.value == other
+
+    def __repr__(self):
+        return f"NamespaceAccessor(value={self.value})"
