+from jinja2 import Environment, DictLoader
+from jinja2.ext import Extension
+from jinja2 import nodes
+import sys
+
+class ConditionalI18nExtension(Extension):
+    tags = {"ctrans", "fallback", "endctrans"}
+
+    def parse(self, parser):
+        token = next(parser.stream)
+        tag = token.value
+        lineno = token.lineno
+        if tag == "ctrans":
+            condition = parser.parse_expression()
+            
+            # Parse true branch
+            body = parser.parse_statements(["name:fallback", "name:endctrans"], drop_needle=True)
+            
+            # Check if we hit fallback
+            if parser.stream.current.value == "fallback":
+                # Consume fallback tag
+                next(parser.stream)
+                fallback = parser.parse_statements(["name:endctrans"], drop_needle=True)
+            else:
+                fallback = []
+            
+            print(f"DEBUG: body={body}")
+            print(f"DEBUG: fallback={fallback}")
+            
+            return nodes.If(condition, body, [], fallback, lineno=lineno)
+        elif tag == "fallback":
+            return None
+        elif tag == "endctrans":
+            return None
+
+env = Environment(extensions=[ConditionalI18nExtension])
+template = "{% ctrans user.is_authenticated %}Hello{% endctrans %}"
+try:
+    tmpl = env.from_string(template)
+except Exception as e:
+    import traceback
+    traceback.print_exc()
