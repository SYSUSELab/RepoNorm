+    def _coerce_value(self, value: Any, schema: dict[str, Any]) -> Any:
+        if not isinstance(value, str):
+            return value
+
+        value = value.strip()
+        type_str = schema.get("type")
+
+        # Boolean
+        if type_str == "boolean":
+            if value.lower() == "true":
+                return True
+            if value.lower() == "false":
+                return False
+
+        # Integer
+        if type_str == "integer":
+            # Check for units (KB, MB, GB)
+            match = re.match(r"^(-?\d+)\s*(KB|MB|GB)$", value)
+            if match:
+                magnitude = int(match.group(1))
+                unit = match.group(2)
+                factors = {"KB": 1000, "MB": 1000000, "GB": 1000000000}
+                return magnitude * factors[unit]
+
+            # Plain integer
+            if re.match(r"^-?\d+$", value):
+                return int(value)
+
+        # Number
+        if type_str == "number":
+            # Check for units (ms, s, m, h)
+            match = re.match(r"^(-?\d+(?:\.\d+)?)\s*(ms|s|m|h)$", value)
+            if match:
+                magnitude = float(match.group(1))
+                unit = match.group(2)
+                factors = {"ms": 0.001, "s": 1, "m": 60, "h": 3600}
+                return magnitude * factors[unit]
+
+            # Plain number
+            if re.match(r"^-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?$", value):
+                return float(value)
+
+        return value
+
