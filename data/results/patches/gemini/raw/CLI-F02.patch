diff --git a/tests/test_context_on_exit.py b/tests/test_context_on_exit.py
new file mode 100644
index 0000000..34127ae
--- /dev/null
+++ b/tests/test_context_on_exit.py
@@ -0,0 +1,72 @@
+import click
+from click.core import Context
+import pytest
+
+def test_on_exit_callback():
+    callback_called = False
+    def on_exit(ctx):
+        nonlocal callback_called
+        callback_called = True
+        assert ctx.command.name == "test"
+        assert ctx.params["foo"] == "bar"
+
+    cmd = click.Command("test", callback=lambda: None)
+    cmd.params = [click.Option(["--foo"])]
+    
+    ctx = Context(cmd, on_exit=on_exit)
+    ctx.params["foo"] = "bar"
+    
+    with ctx:
+        pass
+    
+    assert callback_called
+
+def test_on_exit_callback_nested():
+    callback_called = 0
+    def on_exit(ctx):
+        nonlocal callback_called
+        callback_called += 1
+
+    cmd = click.Command("test", callback=lambda: None)
+    
+    ctx = Context(cmd, on_exit=on_exit)
+    
+    with ctx:
+        with ctx:
+            pass
+        assert callback_called == 0
+    
+    assert callback_called == 1
+
+def test_on_exit_callback_exception_handling():
+    callback_called = False
+    def on_exit(ctx):
+        nonlocal callback_called
+        callback_called = True
+        raise Exception("Should be ignored")
+
+    cmd = click.Command("test", callback=lambda: None)
+    
+    ctx = Context(cmd, on_exit=on_exit)
+    
+    with ctx:
+        pass
+    
+    assert callback_called
+
+def test_on_exit_callback_system_exit():
+    callback_called = False
+    def on_exit(ctx):
+        nonlocal callback_called
+        callback_called = True
+        raise SystemExit(1)
+
+    cmd = click.Command("test", callback=lambda: None)
+    
+    ctx = Context(cmd, on_exit=on_exit)
+    
+    with pytest.raises(SystemExit):
+        with ctx:
+            pass
+    
+    assert callback_called
