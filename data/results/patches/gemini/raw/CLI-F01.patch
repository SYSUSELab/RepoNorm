--- /dev/null
+++ b/test_file_open.py
@@ -0,0 +1,25 @@
+import click
+import warnings
+import gc
+
+# Enable ResourceWarning
+warnings.simplefilter("always", ResourceWarning)
+
+def warn_with_traceback(message, category, filename, lineno, file=None, line=None):
+    if issubclass(category, ResourceWarning):
+        print(f"ResourceWarning: {message}")
+        
+warnings.showwarning = warn_with_traceback
+
+# Create a dummy file
+with open("test_file.txt", "w") as f:
+    f.write("test")
+
+# Use click.File to open it
+f_type = click.File("r")
+f = f_type("test_file.txt")
+print(f"File opened: {f}")
+print(f"File type: {type(f)}")
+del f
+gc.collect()
+print("Garbage collected.")
