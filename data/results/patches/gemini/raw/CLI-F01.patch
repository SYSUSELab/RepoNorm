@@ -0,0 +1,31 @@
+import warnings
+import gc
+import click
+
+def warn_with_traceback(message, category, filename, lineno, file=None, line=None):
+    if issubclass(category, ResourceWarning):
+        print(f"ResourceWarning: {message}")
+        
+warnings.showwarning = warn_with_traceback
+warnings.simplefilter("always", ResourceWarning)
+
+# Create a dummy file
+with open("test_file.txt", "w") as f:
+    f.write("test")
+
+# Use click.File to open it
+f_type = click.File("r")
+f = f_type("test_file.txt")
+print(f"File opened: {f}")
+# We need to make sure the file is actually closed.
+# If we don't close it, it should trigger a ResourceWarning.
+# The fact that it didn't trigger a ResourceWarning in the previous run
+# might be because the file was not actually opened or it was closed by something else.
+
+# Let's try to see if it's open.
+print(f"File is open: {not f.closed}")
+
+# Let's try to delete it and see if it triggers a ResourceWarning.
+del f
+gc.collect()
+print("Garbage collected.")
