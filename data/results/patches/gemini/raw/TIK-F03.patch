new file mode 100644
index 0000000..73425f7
--- /dev/null
+++ b/test_frequency_logic.py
@@ -0,0 +1,20 @@
+from collections import Counter
+
+def get_frequency(tokens):
+    return dict(Counter(tokens))
+
+def test_logic():
+    tokens = [1, 2, 1, 3, 2, 1]
+    freq = get_frequency(tokens)
+    print(f"Tokens: {tokens}")
+    print(f"Frequency: {freq}")
+    
+    # Batch
+    batch_tokens = [[1, 2, 1], [3, 2, 1]]
+    corpus_freq = Counter()
+    for doc in batch_tokens:
+        corpus_freq.update(doc)
+    print(f"Batch tokens: {batch_tokens}")
+    print(f"Corpus frequency: {dict(corpus_freq)}")
+
+test_logic()
