new file mode 100644
index 0000000..d64b6e9
--- /dev/null
+++ b/fix_core_2.py
@@ -0,0 +1,32 @@
+with open("tiktoken/core.py", "r") as f:
+    lines = f.readlines()
+
+new_lines = []
+skip = False
+for i, line in enumerate(lines):
+    if "except UnicodeEncodeError:" in line and i > 120:
+        # This is the second one, skip it and the next few lines
+        skip = True
+        continue
+    if skip:
+        if "return self._core_bpe.encode" in line:
+            skip = False
+            continue
+        if "text = text.encode" in line:
+            continue
+        if "# BPE operates on bytes" in line:
+            continue
+        if "string, but given that this is input we want to support, maybe that's okay." in line:
+            continue
+        if "Also we use errors=\"replace\" to handle weird things like lone surrogates." in line:
+            continue
+        if "Technically, this introduces a place where encode + decode doesn't roundtrip a Python" in line:
+            continue
+        if "invalid UTF-8 to Rust, it will rightfully complain. Here we do a quick and dirty" in line:
+            continue
+        if "fixup for any surrogate pairs that may have sneaked their way into the text." in line:
+            continue
+    new_lines.append(line)
+
+with open("tiktoken/core.py", "w") as f:
+    f.writelines(new_lines)
