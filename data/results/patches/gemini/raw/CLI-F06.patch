+import copy
+import click
+from click.core import Context
+
+def save_state(ctx):
+    return {
+        "params": copy.deepcopy(ctx.params),
+        "args": list(ctx.args),
+        "_protected_args": list(ctx._protected_args),
+        "_opt_prefixes": set(ctx._opt_prefixes),
+        "obj": ctx.obj,
+        "_meta": dict(ctx._meta),
+        "default_map": copy.deepcopy(ctx.default_map),
+        "invoked_subcommand": ctx.invoked_subcommand,
+        "terminal_width": ctx.terminal_width,
+        "max_content_width": ctx.max_content_width,
+        "resilient_parsing": ctx.resilient_parsing,
+        "help_option_names": list(ctx.help_option_names),
+        "token_normalize_func": ctx.token_normalize_func,
+        "auto_envvar_prefix": ctx.auto_envvar_prefix,
+        "color": ctx.color,
+        "show_default": ctx.show_default,
+        "_parameter_source": dict(ctx._parameter_source),
+    }
+
+def restore_state(ctx, snapshot):
+    # Transactional: require a dictionary with all supported keys
+    required_keys = [
+        "params", "args", "_protected_args", "_opt_prefixes", "obj", "_meta",
+        "default_map", "invoked_subcommand", "terminal_width", "max_content_width",
+        "resilient_parsing", "help_option_names", "token_normalize_func",
+        "auto_envvar_prefix", "color", "show_default", "_parameter_source"
+    ]
+    for key in required_keys:
+        if key not in snapshot:
+            raise ValueError(f"Missing key in snapshot: {key}")
+
+    # Apply changes
+    ctx.params = copy.deepcopy(snapshot["params"])
+    ctx.args = list(snapshot["args"])
+    ctx._protected_args = list(snapshot["_protected_args"])
+    ctx._opt_prefixes = set(snapshot["_opt_prefixes"])
+    ctx.obj = snapshot["obj"]
+    
+    # Metadata: restore contents while preserving the dictionary object
+    ctx._meta.clear()
+    ctx._meta.update(snapshot["_meta"])
+    
+    ctx.default_map = copy.deepcopy(snapshot["default_map"])
+    ctx.invoked_subcommand = snapshot["invoked_subcommand"]
+    ctx.terminal_width = snapshot["terminal_width"]
+    ctx.max_content_width = snapshot["max_content_width"]
+    ctx.resilient_parsing = snapshot["resilient_parsing"]
+    ctx.help_option_names = list(snapshot["help_option_names"])
+    ctx.token_normalize_func = snapshot["token_normalize_func"]
+    ctx.auto_envvar_prefix = snapshot["auto_envvar_prefix"]
+    ctx.color = snapshot["color"]
+    ctx.show_default = snapshot["show_default"]
+    
+    ctx._parameter_source.clear()
+    ctx._parameter_source.update(snapshot["_parameter_source"])
+
+# Test
+@click.command()
+def cli():
+    pass
+
+ctx = Context(cli, info_name="test")
+ctx.params = {"a": 1}
+ctx._meta["m"] = 1
+snapshot = save_state(ctx)
+
+ctx.params = {"a": 2}
+ctx._meta["m"] = 2
+
+restore_state(ctx, snapshot)
+assert ctx.params == {"a": 1}
+assert ctx._meta["m"] == 1
+print("Success")
