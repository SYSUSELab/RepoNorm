@@ -0,0 +1,33 @@
+import click
+from click.core import Context
+
+def test_metadata_sharing():
+    @click.command()
+    def cli():
+        pass
+
+    parent = Context(cli, info_name="parent")
+    parent._meta["shared"] = "value"
+    
+    child = Context(cli, info_name="child", parent=parent)
+    
+    # Child should share the same _meta dictionary object
+    assert child._meta is parent._meta
+    
+    snapshot = child.save_state()
+    
+    # Modify child's meta
+    child._meta["shared"] = "changed"
+    
+    # Restore child's state
+    child.restore_state(snapshot)
+    
+    # Child's meta should be restored to original
+    assert child._meta["shared"] == "value"
+    # Parent's meta should also be restored because it's the same object
+    assert parent._meta["shared"] == "value"
+    
+    print("Metadata sharing test passed")
+
+if __name__ == "__main__":
+    test_metadata_sharing()
