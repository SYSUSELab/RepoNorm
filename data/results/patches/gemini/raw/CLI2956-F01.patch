+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        if self.auto_complete:
+            strategy = self.auto_complete if isinstance(self.auto_complete, str) else None
+            if strategy is None:
+                name = self.name.lower()
+                if any(x in name for x in ("user", "username", "owner", "author")):
+                    strategy = "user"
+                elif any(x in name for x in ("branch", "ref", "revision")):
+                    strategy = "branch"
+                elif any(x in name for x in ("env", "environment", "var")):
+                    strategy = "environment"
+                elif any(x in name for x in ("file", "path", "input", "output")):
+                    strategy = "file"
+                elif any(x in name for x in ("dir", "directory")):
+                    strategy = "directory"
+
+            if strategy:
+                from .shell_completion import CompletionItem
+                import os
+                
+                if strategy == "user":
+                    try:
+                        import pwd
+                        users = [u.pw_name for u in pwd.getpwall() if not u.pw_name.startswith("_")]
+                        return [CompletionItem(u) for u in sorted(set(users)) if u.startswith(incomplete)][:20]
+                    except ImportError:
+                        pass
+                elif strategy == "branch":
+                    try:
+                        import subprocess
+                        branches = subprocess.check_output(["git", "branch", "--format=%(refname:short)"], stderr=subprocess.DEVNULL).decode().splitlines()
+                        return [CompletionItem(b) for b in sorted(set(branches)) if b.startswith(incomplete)][:20]
+                    except (subprocess.CalledProcessError, FileNotFoundError):
+                        pass
+                elif strategy == "environment":
+                    import os
+                    return [CompletionItem(k) for k in sorted(os.environ.keys()) if k.startswith(incomplete)][:20]
+                elif strategy == "file":
+                    return [CompletionItem(incomplete, type="file")]
+                elif strategy == "directory":
+                    return [CompletionItem(incomplete, type="dir")]
+
+        return super().shell_complete(ctx, incomplete)
+
