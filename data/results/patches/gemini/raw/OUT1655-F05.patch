diff --git a/tests/types/test_ipv6.py b/tests/types/test_ipv6.py
new file mode 100644
index 0000000..fa68268
--- /dev/null
+++ b/tests/types/test_ipv6.py
@@ -0,0 +1,12 @@
+from outlines.types import ipv6
+
+def test_ipv6_type():
+    assert ipv6.matches("2001:0db8:85a3:0000:0000:8a2e:0370:7334") is True
+    assert ipv6.matches("ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff") is True
+    assert ipv6.matches("0000:0000:0000:0000:0000:0000:0000:0000") is True
+    
+    assert ipv6.matches("2001:db8::1") is False
+    assert ipv6.matches("2001:db8:1") is False
+    assert ipv6.matches("2001:0db88:85a3:0000:0000:8a2e:0370:7334") is False
+    assert ipv6.matches("2001:0db8:85a3:0000:0000:8a2e:0370:7334:1234") is False
+    assert ipv6.matches("2001:0db8:85a3:0000:0000:8a2e:0370:733g") is False
