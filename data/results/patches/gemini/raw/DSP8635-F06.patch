+import re
+
+def truncate_instruction(instruction, min_chars, max_chars, rephrase_when_too_long):
+    # Measure the generated instruction after its existing prefix stripping.
+    # (Assuming it's already stripped)
+    length = len(instruction)
+    
+    if length < min_chars:
+        # If shorter than min, use the predictor's canonical signature instructions.
+        # (This logic will be implemented in the class)
+        return "FALLBACK"
+    
+    if length > max_chars:
+        if not rephrase_when_too_long:
+            # Retain the last sentence boundary (. ! or ? followed by whitespace/end) 
+            # that fits with one character reserved for …; 
+            # otherwise retain a hard prefix of max-1 characters and append ….
+            
+            # Find last sentence boundary
+            # Regex for sentence boundary: [.!?]\s+|$
+            # We need to find the last one that fits in max_chars - 1
+            
+            # Let's try to find the last sentence boundary
+            # The instruction is `instruction`
+            # We want to find a split point `i` such that `i <= max_chars - 1`
+            # and `instruction[:i]` ends with a sentence boundary.
+            
+            # Actually, the requirement says:
+            # "retain the last sentence boundary (. ! or ? followed by whitespace/end) that fits with one character reserved for …"
+            
+            # Let's look for all sentence boundaries
+            # A sentence boundary is [.!?] followed by whitespace or end of string.
+            
+            # Let's find all matches of [.!?](\s+|$)
+            matches = list(re.finditer(r'[.!?](\s+|$)', instruction))
+            
+            # Filter matches that fit in max_chars - 1
+            valid_matches = [m for m in matches if m.end() <= max_chars - 1]
+            
+            if valid_matches:
+                # Take the last one
+                last_match = valid_matches[-1]
+                return instruction[:last_match.end()] + "…"
+            else:
+                # Otherwise retain a hard prefix of max-1 characters and append …
+                return instruction[:max_chars-1] + "…"
+        else:
+            # Rephrasing logic
+            return "REPHRASE"
+            
+    return instruction
+
+# Test cases
+print(truncate_instruction("This is a short sentence.", 30, 600, False)) # Should be FALLBACK
+print(truncate_instruction("This is a very long sentence that should be truncated because it is definitely longer than the max characters allowed for this test case.", 10, 50, False)) # Should be truncated
+print(truncate_instruction("This is a sentence. This is another sentence. This is a third sentence.", 10, 40, False)) # Should be truncated at the last sentence boundary
diff --git a/test_logic_v2.py b/test_logic_v2.py
new file mode 100644
index 00000000..fa4097c6
--- /dev/null
+++ b/test_logic_v2.py
@@ -0,0 +1,33 @@
+import re
+
+def truncate_instruction(instruction, min_chars, max_chars):
+    # "retain the last sentence boundary (. ! or ? followed by whitespace/end) that fits with one character reserved for …"
+    # "otherwise retain a hard prefix of max-1 characters and append …"
+    
+    # Let's refine the regex for sentence boundary.
+    # The requirement says: "(. ! or ? followed by whitespace/end)"
+    # So it's [.!?] followed by (\s+|$)
+    
+    # Let's test with "This is a sentence. This is another sentence."
+    # If max_chars is 30.
+    # "This is a sentence. " is 20 chars.
+    # "This is a sentence. This is another sentence." is 45 chars.
+    
+    # The regex should be `[.!?](?:\s+|$)`
+    
+    matches = list(re.finditer(r'[.!?](?:\s+|$)', instruction))
+    
+    # We need to find the last match such that the length of the result is <= max_chars
+    # The result is instruction[:match.end()] + "…"
+    # So len(instruction[:match.end()]) + 1 <= max_chars
+    # len(instruction[:match.end()]) <= max_chars - 1
+    
+    valid_matches = [m for m in matches if m.end() <= max_chars - 1]
+    
+    if valid_matches:
+        last_match = valid_matches[-1]
+        return instruction[:last_match.end()] + "…"
+    else:
+        return instruction[:max_chars-1] + "…"
+
+print(truncate_instruction("This is a sentence. This is another sentence.", 10, 30))
