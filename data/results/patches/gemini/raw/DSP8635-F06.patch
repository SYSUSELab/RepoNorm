+import re
+
+with open('dspy/propose/grounded_proposer.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the `propose_instruction_for_predictor` method
+method_start = 0
+for i, line in enumerate(lines):
+    if 'def propose_instruction_for_predictor(' in line:
+        method_start = i
+        break
+
+# Find the end of the method
+method_end = 0
+for i, line in enumerate(lines[method_start+1:]):
+    if line.startswith('    def '):
+        method_end = method_start + i + 1
+        break
+
+# Find the `proposed_instruction = ...` line
+# It's inside the `with dspy.settings.context(lm=self.prompt_model):` block
+# Let's find the `proposed_instruction = instruction_generator(...)`
+# and the following lines.
+
+# The block is:
+#         with dspy.settings.context(lm=self.prompt_model):
+#             self.prompt_model.kwargs["temperature"] = modified_temp
+#             proposed_instruction = instruction_generator(
+#                 ...
+#             ).proposed_instruction
+#         self.prompt_model.kwargs["temperature"] = original_temp
+#
+#         # Log the trace used to generate the new instruction, along with the new instruction itself
+#         if self.verbose:
+#             self.prompt_model.inspect_history(n=1)
+#             print(f"PROPOSED INSTRUCTION: {proposed_instruction}")
+#
+#         return strip_prefix(proposed_instruction)
+
+# I need to replace this with the new logic.
+
+# Let's find the line `return strip_prefix(proposed_instruction)`
+return_line = 0
+for i, line in enumerate(lines[method_start:method_end]):
+    if 'return strip_prefix(proposed_instruction)' in line:
+        return_line = method_start + i
+        break
+
+# Let's replace the return line and the lines before it.
+# Actually, I need to get the `basic_instruction` to use as a fallback.
+# The `instruction_generator` is an instance of `GenerateModuleInstruction`.
+# It doesn't seem to store `basic_instruction`.
+# But `GenerateModuleInstruction` has a `forward` method that calculates `basic_instruction`.
+# Wait, `GenerateModuleInstruction` is a `dspy.Module`.
+# When I call `instruction_generator(...)`, it calls `forward`.
+# So I can't easily get `basic_instruction` from `instruction_generator` instance.
+
+# Wait, `GenerateModuleInstruction` is a `dspy.Module`.
+# The `forward` method calculates `basic_instruction`.
+# I can't easily access it from outside.
+
+# Let's look at `GenerateModuleInstruction` again.
+# It's defined in `generate_instruction_class`.
+# It's a `dspy.Predict(GenerateSingleModuleInstruction)`.
+# Wait, `generate_instruction_class` returns `dspy.Predict(GenerateSingleModuleInstruction)`.
+# So `instruction_generator` is a `dspy.Predict` object.
+# It doesn't have a `forward` method.
+# It has a `__call__` method.
+
+# This is tricky.
+# Maybe I can get the `basic_instruction` from the predictor itself?
+# `predictor` is passed to `propose_instruction_for_predictor`.
+# `basic_instruction = get_signature(predictor).instructions`
+# Yes!
+
+# So I can get `basic_instruction` using `get_signature(predictor).instructions`.
+
+# Let's implement the logic.
+
+new_logic = [
+    '        self.prompt_model.kwargs["temperature"] = original_temp\n',
+    '\n',
+    '        # Process the proposed instruction\n',
+    '        proposed_instruction = strip_prefix(proposed_instruction)\n',
+    '        length = len(proposed_instruction)\n',
+    '        basic_instruction = get_signature(predictor).instructions\n',
+    '\n',
+    '        if length < self.min_instr_chars:\n',
+    '            if self.verbose:\n',
+    '                print(f"Instruction too short ({length} < {self.min_instr_chars}). Falling back to basic instruction.")\n',
+    '            proposed_instruction = basic_instruction\n',
+    '        elif length > self.max_instr_chars:\n',
+    '            if self.rephrase_when_too_long:\n',
+    '                # Rephrase logic\n',
+    '                # "make exactly one ShortenInstruction call"\n',
+    '                # I need to define ShortenInstruction signature.\n',
+    '                # Let\'s define it in `dspy/propose/grounded_proposer.py`.\n',
+    '                pass\n',
+    '            else:\n',
+    '                # Truncate logic\n',
+    '                matches = list(re.finditer(r\'[.!?](?:\\s+|$)\', proposed_instruction))\n',
+    '                valid_matches = [m for m in matches if m.end() <= self.max_instr_chars - 1]\n',
+    '                if valid_matches:\n',
+    '                    proposed_instruction = proposed_instruction[:valid_matches[-1].end()] + "…"\n',
+    '                else:\n',
+    '                    proposed_instruction = proposed_instruction[:self.max_instr_chars-1] + "…"\n',
+    '                if self.verbose:\n',
+    '                    print(f"Instruction too long ({length} > {self.max_instr_chars}). Truncated to {len(proposed_instruction)}.")\n',
+    '\n',
+    '        # Log the trace used to generate the new instruction, along with the new instruction itself\n',
+    '        if self.verbose:\n',
+    '            self.prompt_model.inspect_history(n=1)\n',
+    '            print(f"PROPOSED INSTRUCTION: {proposed_instruction}")\n',
+    '\n',
+    '        return proposed_instruction\n'
+]
+
+# Replace the lines
+# The lines to replace are from `self.prompt_model.kwargs["temperature"] = original_temp` to the end of the method.
+# Let's find the start of this block.
+start_block = 0
+for i, line in enumerate(lines[method_start:method_end]):
+    if 'self.prompt_model.kwargs["temperature"] = original_temp' in line:
+        start_block = method_start + i
+        break
+
+lines[start_block:method_end] = new_logic
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.writelines(lines)
