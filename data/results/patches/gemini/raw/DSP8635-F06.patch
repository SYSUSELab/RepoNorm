+import re
+
+with open('dspy/propose/grounded_proposer.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the `propose_instruction_for_predictor` method
+method_start = 0
+for i, line in enumerate(lines):
+    if 'def propose_instruction_for_predictor(' in line:
+        method_start = i
+        break
+
+# Find the `elif length > self.max_instr_chars:` block
+block_start = 0
+for i, line in enumerate(lines[method_start:]):
+    if 'elif length > self.max_instr_chars:' in line:
+        block_start = method_start + i
+        break
+
+# Find the end of the `elif` block
+# The block ends before `        # Log the trace used to generate the new instruction, along with the new instruction itself`
+block_end = 0
+for i, line in enumerate(lines[block_start:]):
+    if '# Log the trace used to generate the new instruction' in line:
+        block_end = block_start + i
+        break
+
+# Replace the `elif` block
+new_elif_block = [
+    '        elif length > self.max_instr_chars:\n',
+    '            if self.rephrase_when_too_long:\n',
+    '                shorten_instruction = dspy.Predict(ShortenInstruction)\n',
+    '                proposed_instruction = shorten_instruction(\n',
+    '                    long_instruction=proposed_instruction,\n',
+    '                    max_chars=self.max_instr_chars\n',
+    '                ).proposed_instruction\n',
+    '                proposed_instruction = strip_prefix(proposed_instruction)\n',
+    '                if not proposed_instruction or len(proposed_instruction) < self.min_instr_chars:\n',
+    '                    proposed_instruction = basic_instruction\n',
+    '                if len(proposed_instruction) > self.max_instr_chars:\n',
+    '                    proposed_instruction = proposed_instruction[:self.max_instr_chars]\n',
+    '                if self.verbose:\n',
+    '                    print(f"Instruction too long ({length} > {self.max_instr_chars}). Rephrased to {len(proposed_instruction)}.")\n',
+    '            else:\n',
+    '                # Truncate logic\n',
+    '                matches = list(re.finditer(r\'[.!?](?:\\s+|$)\', proposed_instruction))\n',
+    '                valid_matches = [m for m in matches if m.end() <= self.max_instr_chars - 1]\n',
+    '                if valid_matches:\n',
+    '                    proposed_instruction = proposed_instruction[:valid_matches[-1].end()] + "…"\n',
+    '                else:\n',
+    '                    proposed_instruction = proposed_instruction[:self.max_instr_chars-1] + "…"\n',
+    '                if self.verbose:\n',
+    '                    print(f"Instruction too long ({length} > {self.max_instr_chars}). Truncated to {len(proposed_instruction)}.")\n'
+]
+
+lines[block_start:block_end] = new_elif_block
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.writelines(lines)
