+import re
+
+# Mocking ShortenInstruction
+class ShortenInstruction(dspy.Signature):
+    long_instruction = dspy.InputField(prefix="LONG INSTRUCTION:")
+    max_chars = dspy.InputField(prefix="MAX CHARS:")
+    proposed_instruction = dspy.OutputField(prefix="PROPOSED INSTRUCTION:")
+
+# The logic for rephrasing:
+# "When rephrasing is enabled for an overlong generated instruction, make exactly one ShortenInstruction call with long_instruction and max_chars inputs and a proposed_instruction output using prefix "PROPOSED INSTRUCTION:". Strip its output prefix; if it is empty or still shorter than min, fall back to the canonical basic instruction. Hard-truncate a still-overlong rephrase or its fallback to max."
+
+# This seems straightforward.
