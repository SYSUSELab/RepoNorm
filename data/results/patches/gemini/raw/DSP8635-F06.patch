+import re
+
+with open('dspy/propose/grounded_proposer.py', 'r') as f:
+    content = f.read()
+
+# 1. Update GroundedProposer.__init__ signature
+pattern_init = r'(class GroundedProposer\(Proposer\):\n    def __init__\(\n        self,\n        prompt_model,\n        program,\n        trainset,\n        view_data_batch_size=10,\n        use_dataset_summary=True,\n        program_aware=True,\n        use_task_demos=True,\n        num_demos_in_context = 3,\n        use_instruct_history=True,\n        use_tip=True,\n        set_tip_randomly=True,\n        set_history_randomly=True,\n        verbose=False,\n        rng=None\n    \):)'
+replacement_init = r'\1\n        min_instr_chars=30,\n        max_instr_chars=600,\n        rephrase_when_too_long=False\n    ):'
+content = re.sub(pattern_init, replacement_init, content)
+
+# 2. Add attributes and validation to GroundedProposer.__init__
+pattern_body = r'(self.rng = rng or random)'
+replacement_body = r'\1\n        if not isinstance(min_instr_chars, int) or not isinstance(max_instr_chars, int) or min_instr_chars < 0 or max_instr_chars < 0 or min_instr_chars > max_instr_chars:\n            raise ValueError("Invalid min_instr_chars or max_instr_chars. Must be non-negative integers with min <= max.")\n        self.min_instr_chars = min_instr_chars\n        self.max_instr_chars = max_instr_chars\n        self.rephrase_when_too_long = rephrase_when_too_long'
+content = re.sub(pattern_body, replacement_body, content)
+
+# 3. Update propose_instruction_for_predictor
+pattern_method = r'(# Process the proposed instruction\n        proposed_instruction = strip_prefix\(proposed_instruction\))'
+replacement_method = r'\1\n        length = len(proposed_instruction)\n        basic_instruction = get_signature(predictor).instructions\n\n        if length < self.min_instr_chars:\n            if self.verbose:\n                print(f"Instruction too short ({length} < {self.min_instr_chars}). Falling back to basic instruction.")\n            proposed_instruction = basic_instruction\n        elif length > self.max_instr_chars:\n            if self.rephrase_when_too_long:\n                shorten_instruction = dspy.Predict(ShortenInstruction)\n                proposed_instruction = shorten_instruction(\n                    long_instruction=proposed_instruction,\n                    max_chars=self.max_instr_chars\n                ).proposed_instruction\n                proposed_instruction = strip_prefix(proposed_instruction)\n                if not proposed_instruction or len(proposed_instruction) < self.min_instr_chars:\n                    proposed_instruction = basic_instruction\n                if len(proposed_instruction) > self.max_instr_chars:\n                    proposed_instruction = proposed_instruction[:self.max_instr_chars]\n                if self.verbose:\n                    print(f"Instruction too long ({length} > {self.max_instr_chars}). Rephrased to {len(proposed_instruction)}.")\n            else:\n                # Truncate logic\n                matches = list(re.finditer(r\'[.!?](?:\\s+|$)\', proposed_instruction))\n                valid_matches = [m for m in matches if m.end() <= self.max_instr_chars - 1]\n                if valid_matches:\n                    proposed_instruction = proposed_instruction[:valid_matches[-1].end()] + "…"\n                else:\n                    proposed_instruction = proposed_instruction[:self.max_instr_chars-1] + "…"\n                if self.verbose:\n                    print(f"Instruction too long ({length} > {self.max_instr_chars}). Truncated to {len(proposed_instruction)}.")'
+content = re.sub(pattern_method, replacement_method, content)
+
+with open('dspy/propose/grounded_proposer.py', 'w') as f:
+    f.write(content)
