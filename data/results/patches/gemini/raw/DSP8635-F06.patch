+import re
+
+def test_truncation(proposed_instruction, max_chars):
+    matches = list(re.finditer(r'[.!?](?:\s+|$)', proposed_instruction))
+    valid_matches = [m for m in matches if m.end() <= max_chars - 1]
+    if valid_matches:
+        return proposed_instruction[:valid_matches[-1].end()] + "…"
+    else:
+        return proposed_instruction[:max_chars-1] + "…"
+
+# Test case 1: Truncate at sentence boundary
+instr1 = "This is a long instruction. It has multiple sentences. It should be truncated."
+max_chars1 = 30
+result1 = test_truncation(instr1, max_chars1)
+print(f"Result 1: '{result1}' (len: {len(result1)})")
+assert len(result1) <= max_chars1
+
+# Test case 2: No sentence boundary, hard truncate
+instr2 = "ThisIsAVeryLongInstructionWithoutAnySentenceBoundariesThatNeedsToBeTruncated"
+max_chars2 = 20
+result2 = test_truncation(instr2, max_chars2)
+print(f"Result 2: '{result2}' (len: {len(result2)})")
+assert len(result2) <= max_chars2
+
+print("Tests passed!")
