+++ b/tests/types/test_mac_address.py
@@ -0,0 +1,20 @@
+import re
+from outlines import types
+
+def test_mac_address_regex():
+    mac_address = types.mac_address
+    pattern = mac_address.pattern
+    
+    # Test cases
+    assert re.fullmatch(pattern, "00:11:22:33:44:55") is not None
+    assert re.fullmatch(pattern, "00-11-22-33-44-55") is not None
+    assert re.fullmatch(pattern, "AA:BB:CC:DD:EE:FF") is not None
+    assert re.fullmatch(pattern, "aa:bb:cc:dd:ee:ff") is not None
+    
+    # Invalid cases
+    assert re.fullmatch(pattern, "00:11-22:33:44:55") is None
+    assert re.fullmatch(pattern, "00:11:22:33:44:5") is None
+    assert re.fullmatch(pattern, "00:11:22:33:44:555") is None
+    assert re.fullmatch(pattern, "00:11:22:33:44:55:") is None
+    assert re.fullmatch(pattern, "00:11:22:33:44:55-") is None
+    assert re.fullmatch(pattern, "00:11:22:33:44:55:66") is None
