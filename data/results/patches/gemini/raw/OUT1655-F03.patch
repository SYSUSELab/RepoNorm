@@ -0,0 +1,22 @@
+from outlines import types
+import re
+
+def test_octal_str_type():
+    assert hasattr(types, "octal_str")
+    pattern = types.octal_str.pattern
+    assert pattern == r"0o[0-7]+"
+    
+    regex = re.compile(pattern)
+    assert regex.fullmatch("0o0") is not None
+    assert regex.fullmatch("0o7") is not None
+    assert regex.fullmatch("0o01234567") is not None
+    assert regex.fullmatch("0o007") is not None
+    
+    assert regex.fullmatch("0O0") is None
+    assert regex.fullmatch("0o") is None
+    assert regex.fullmatch("0o8") is None
+    assert regex.fullmatch("0o9") is None
+    assert regex.fullmatch("0o 7") is None
+    assert regex.fullmatch("0o_7") is None
+    assert regex.fullmatch("+0o7") is None
+    assert regex.fullmatch("0o7 ") is None
