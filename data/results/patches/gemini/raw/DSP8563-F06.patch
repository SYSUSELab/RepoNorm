@@ -0,0 +1,29 @@
+import json
+from dspy.adapters.types.tool import ToolCalls
+from pydantic import ValidationError
+
+def test_tool_calls_parsing():
+    # Test case 1: Valid plain JSON
+    data = [{"name": "search", "args": {"query": "hello"}}]
+    try:
+        tool_calls = ToolCalls.from_dict_list(data)
+        print("Plain JSON success")
+    except Exception as e:
+        print(f"Plain JSON failed: {e}")
+
+    # Test case 2: JSON wrapped in markdown fence
+    markdown_data = """
+```json
+[
+    {"name": "search", "args": {"query": "hello"}}
+]
+```
+"""
+    try:
+        # This is expected to fail currently
+        tool_calls = ToolCalls.from_dict_list(json.loads(markdown_data))
+        print("Markdown JSON success")
+    except Exception as e:
+        print(f"Markdown JSON failed as expected: {e}")
+
+test_tool_calls_parsing()
