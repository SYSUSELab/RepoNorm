+import re
+import json
+
+def validate_input(data):
+    if isinstance(data, (list, dict)):
+        return data
+    
+    if not isinstance(data, str):
+        return data
+
+    # Try to parse as plain JSON first
+    try:
+        return json.loads(data)
+    except json.JSONDecodeError:
+        pass
+
+    # Look for the first triple-backtick block
+    # The opening fence may have any language label, followed by a newline
+    # The next triple-backtick delimiter closes it.
+    # The regex should be careful not to match inline fences without newline
+    
+    pattern = r"```[^\n]*\n(.*?)```"
+    match = re.search(pattern, data, re.DOTALL)
+    if match:
+        json_str = match.group(1).strip()
+        try:
+            return json.loads(json_str)
+        except json.JSONDecodeError:
+            return data
+    
+    return data
+
+# Test cases
+test_cases = [
+    '[{"name": "search", "args": {"query": "hello"}}]',
+    '```json\n[{"name": "search", "args": {"query": "hello"}}]\n```',
+    '```\n[{"name": "search", "args": {"query": "hello"}}]\n```',
+    'prose\n```json\n[{"name": "search", "args": {"query": "hello"}}]\n```\nprose',
+    '```json\n[{"name": "search", "args": {"query": "hello"}}]\n```\n```json\n[{"name": "other", "args": {}}]\n```',
+    '```inline```', # Should return original
+    'invalid', # Should return original
+    '{"name": "search", "args": {"query": "hello"}}' # Single object
+]
+
+for tc in test_cases:
+    print(f"Input: {tc[:20]}... Result: {validate_input(tc)}")
