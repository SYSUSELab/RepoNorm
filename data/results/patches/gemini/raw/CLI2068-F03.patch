--- /dev/null
+++ b/tests/test_backup.py
@@ -0,0 +1,64 @@
+import os
+import pytest
+import click
+from unittest.mock import patch, MagicMock
+
+def test_edit_auto_backup(tmp_path):
+    filename = tmp_path / "test_file.txt"
+    filename.write_text("initial content")
+    
+    # Mock subprocess.Popen to avoid calling the editor
+    mock_popen = MagicMock()
+    mock_popen.return_value.wait.return_value = 0
+    
+    with patch("subprocess.Popen", side_effect=mock_popen):
+        click.edit(filename=str(filename), auto_backup=True)
+    
+    backups = [f for f in tmp_path.iterdir() if f.name.startswith("test_file.txt.backup.")]
+    assert len(backups) == 1
+    assert backups[0].read_text() == "initial content"
+
+def test_edit_auto_backup_collision(tmp_path):
+    filename = tmp_path / "test_file.txt"
+    filename.write_text("initial content")
+    
+    # Mock subprocess.Popen to avoid calling the editor
+    mock_popen = MagicMock()
+    mock_popen.return_value.wait.return_value = 0
+    
+    with patch("subprocess.Popen", side_effect=mock_popen):
+        click.edit(filename=str(filename), auto_backup=True)
+        click.edit(filename=str(filename), auto_backup=True)
+    
+    backups = [f for f in tmp_path.iterdir() if f.name.startswith("test_file.txt.backup.")]
+    assert len(backups) == 2
+
+def test_edit_auto_backup_failure(tmp_path):
+    filename = tmp_path / "test_file.txt"
+    filename.write_text("initial content")
+    
+    with patch("shutil.copy2", side_effect=OSError("Permission denied")):
+        with pytest.raises(click.ClickException, match="Failed to create backup file"):
+            click.edit(filename=str(filename), auto_backup=True)
+
+def test_edit_no_backup_for_text():
+    # Mock subprocess.Popen to avoid calling the editor
+    mock_popen = MagicMock()
+    mock_popen.return_value.wait.return_value = 0
+    
+    with patch("shutil.copy2") as mock_copy2:
+        with patch("subprocess.Popen", side_effect=mock_popen):
+            click.edit("some text", auto_backup=True)
+            assert not mock_copy2.called
+
+def test_edit_no_backup_for_nonexistent_file():
+    filename = "nonexistent_file.txt"
+    
+    with patch("shutil.copy2") as mock_copy2:
+        # We don't need to mock Popen because it shouldn't reach there if it doesn't exist
+        # Wait, edit_file calls Popen regardless of whether the file exists or not.
+        # Actually, edit_file calls Popen.
+        # Let's mock Popen just in case.
+        with patch("subprocess.Popen", return_value=MagicMock(wait=lambda: 0)):
+            click.edit(filename=filename, auto_backup=True)
+            assert not mock_copy2.called
