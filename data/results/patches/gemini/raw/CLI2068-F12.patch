diff --git a/tests/test_edit_exit_codes.py b/tests/test_edit_exit_codes.py
new file mode 100644
index 0000000..a56a251
--- /dev/null
+++ b/tests/test_edit_exit_codes.py
@@ -0,0 +1,44 @@
+import click
+import os
+import pytest
+from click.exceptions import ClickException
+
+def test_edit_exit_codes():
+    # Create a temporary editor script
+    editor_script = "editor_test.sh"
+    with open(editor_script, "w") as f:
+        f.write("#!/bin/sh\n")
+        f.write("exit 1\n")
+    os.chmod(editor_script, 0o755)
+
+    # Set the editor environment variable
+    os.environ["EDITOR"] = f"./{editor_script}"
+
+    # Test with handler
+    handler_called = False
+    def handler(code):
+        nonlocal handler_called
+        handler_called = True
+        assert code == 1
+
+    click.edit("hello", handle_exit_codes={1: handler})
+    assert handler_called
+
+    # Test without handler (should raise ClickException)
+    with pytest.raises(ClickException):
+        click.edit("hello")
+
+    # Test with failing handler
+    def failing_handler(code):
+        raise ValueError("Handler failed")
+
+    with pytest.raises(ClickException) as excinfo:
+        click.edit("hello", handle_exit_codes={1: failing_handler})
+    assert "Handler failed" in str(excinfo.value)
+    assert isinstance(excinfo.value.__cause__, ValueError)
+
+    # Cleanup
+    os.remove(editor_script)
+    if "EDITOR" in os.environ:
+        del os.environ["EDITOR"]
+
