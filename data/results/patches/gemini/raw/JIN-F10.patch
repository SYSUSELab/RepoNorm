+    {'name': 'b', 'group': 1},
+    {'name': 'c', 'group': 2},
+    {'name': 'd', 'group': 2},
+    {'name': 'e', 'group': 2},
+]
+
+def sync_do_groupby_new(
+    environment,
+    value,
+    attribute,
+    default=None,
+    filter_groups=None,
+):
+    expr = make_attrgetter(environment, attribute, default=default)
+    
+    # The requirement says: "A predicate receives the complete member list of each group once"
+    # "Ordinary callbacks and @pass_environment callbacks are supported"
+    # "the latter receive the active Environment before the member list."
+    
+    # How to detect if it's a @pass_environment callback?
+    # Jinja2 has a way to check this.
+    
+    # Let's just implement the filtering logic first.
+    
+    groups = []
+    for key, values in groupby(sorted(value, key=expr), expr):
+        items = list(values)
+        if filter_groups is not None:
+            # Check if filter_groups is a @pass_environment callback
+            if getattr(filter_groups, "pass_environment", False):
+                if not filter_groups(environment, items):
+                    continue
+            else:
+                if not filter_groups(items):
+                    continue
+        groups.append((key, items))
+    return groups
+
+# We need make_attrgetter, let's import it or mock it.
+from jinja2.filters import make_attrgetter
+
+# Test
+result = sync_do_groupby_new(env, data, 'group', filter_groups=lambda items: len(items) > 2)
+print("Result with filter_groups:")
+for key, items in result:
+    print(f"{key}: {[i['name'] for i in items]}")
+
+# Test with pass_environment
+def pass_env_predicate(env, items):
+    return len(items) > 2
+pass_env_predicate.pass_environment = True
+
+result = sync_do_groupby_new(env, data, 'group', filter_groups=pass_env_predicate)
+print("Result with pass_environment filter_groups:")
+for key, items in result:
+    print(f"{key}: {[i['name'] for i in items]}")
