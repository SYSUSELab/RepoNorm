+++ b/tests/test_lock_feature.py
@@ -0,0 +1,48 @@
+import os
+import pytest
+import click
+from click.exceptions import ClickException
+
+def test_lock_file_creation(tmp_path):
+    d = tmp_path / "sub"
+    d.mkdir()
+    filename = d / "test.txt"
+    filename.write_text("hello")
+    lockfile = d / ".test.txt.lock"
+    
+    # Use a dummy editor that does nothing
+    click.edit(filename=str(filename), lock_files=True, editor="true")
+    
+    assert not lockfile.exists()
+
+def test_lock_file_prevents_edit(tmp_path):
+    d = tmp_path / "sub"
+    d.mkdir()
+    filename = d / "test.txt"
+    filename.write_text("hello")
+    lockfile = d / ".test.txt.lock"
+    
+    # Create lock file
+    lockfile.write_text("PID: 1234\nTime: 2025-01-01T00:00:00\n")
+    
+    with pytest.raises(ClickException) as excinfo:
+        click.edit(filename=str(filename), lock_files=True, editor="true")
+    
+    assert "exists" in str(excinfo.value)
+    assert lockfile.exists()
+    
+    # Cleanup
+    os.remove(lockfile)
+
+def test_lock_file_cleanup_on_failure(tmp_path):
+    d = tmp_path / "sub"
+    d.mkdir()
+    filename = d / "test.txt"
+    filename.write_text("hello")
+    lockfile = d / ".test.txt.lock"
+    
+    # Use a dummy editor that fails
+    with pytest.raises(ClickException):
+        click.edit(filename=str(filename), lock_files=True, editor="false")
+        
+    assert not lockfile.exists()
