@@ -0,0 +1,33 @@
+import os
+import time
+import click
+from click.exceptions import ClickException
+
+def test_locking():
+    filename = "test_file.txt"
+    lockfile = ".test_file.txt.lock"
+    
+    # Create a dummy file
+    with open(filename, "w") as f:
+        f.write("hello")
+        
+    # Simulate an existing lock
+    with open(lockfile, "w") as f:
+        f.write(f"PID: 1234\nTime: {time.strftime('%Y-%m-%dT%H:%M:%S')}\n")
+        
+    # Try to edit with lock_files=True
+    try:
+        # We need to mock the editor to avoid actually opening it
+        # But for now, let's just see if it raises ClickException
+        click.edit(filename=filename, lock_files=True, editor="true")
+    except ClickException as e:
+        print(f"Caught expected ClickException: {e}")
+    except Exception as e:
+        print(f"Caught unexpected error: {type(e).__name__}: {e}")
+    finally:
+        if os.path.exists(lockfile):
+            os.remove(lockfile)
+        if os.path.exists(filename):
+            os.remove(filename)
+
+test_locking()
