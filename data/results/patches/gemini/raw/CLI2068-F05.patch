@@ -0,0 +1,30 @@
+import os
+import time
+import click
+from click.exceptions import ClickException
+
+def test_locking_success():
+    filename = "test_file_success.txt"
+    lockfile = ".test_file_success.txt.lock"
+    
+    # Create a dummy file
+    with open(filename, "w") as f:
+        f.write("hello")
+        
+    # Try to edit with lock_files=True
+    try:
+        # Use 'true' as editor, which exits with 0
+        click.edit(filename=filename, lock_files=True, editor="true")
+        print("Successfully edited with lock")
+    except Exception as e:
+        print(f"Caught unexpected error: {type(e).__name__}: {e}")
+    finally:
+        if os.path.exists(lockfile):
+            print("Lock file still exists!")
+            os.remove(lockfile)
+        else:
+            print("Lock file removed successfully")
+        if os.path.exists(filename):
+            os.remove(filename)
+
+test_locking_success()
