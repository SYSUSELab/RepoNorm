+def test_i18n_translation_versions():
+    from jinja2 import Environment
+    from jinja2.ext import InternationalizationExtension
+    
+    env = Environment(extensions=[InternationalizationExtension])
+    
+    # Test basic functionality
+    env.set_translation_version("hello", "1.0")
+    assert env.get_translation_version("hello") == "1.0"
+    
+    env.set_translation_version("hello", "2.0")
+    assert env.get_translation_version("hello") == "2.0"
+    
+    assert env.compare_translation_versions("hello", "hello") is True
+    
+    env.set_translation_version("world", "1.0")
+    assert env.compare_translation_versions("hello", "world") is False
+    
+    env.remove_translation_version("hello")
+    assert env.get_translation_version("hello") is None
+    
+    env.clear_translation_versions()
+    assert env.get_translation_version("world") is None
+
+    # Test environment isolation
+    env2 = env.overlay()
+    env2.set_translation_version("hello", "3.0")
+    assert env.get_translation_version("hello") is None
+    assert env2.get_translation_version("hello") == "3.0"
