+import sys
+
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the parse method
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:' in line:
+        start_line = i
+        break
+
+# Insert context parsing
+# We want to insert it after lineno = next(parser.stream).lineno
+insert_pos = start_line + 2
+lines.insert(insert_pos, '        context = None\n')
+lines.insert(insert_pos + 1, '        if parser.stream.current.type == "string":\n')
+lines.insert(insert_pos + 2, '            context = next(parser.stream).value\n')
+
+# Now we need to update _make_node to accept context
+# Find _make_node
+make_node_line = 0
+for i, line in enumerate(lines):
+    if 'def _make_node(' in line:
+        make_node_line = i
+        break
+
+# Update _make_node signature
+# def _make_node(
+#     self,
+#     singular: str,
+#     plural: t.Optional[str],
+#     variables: t.Dict[str, nodes.Expr],
+#     plural_expr: t.Optional[nodes.Expr],
+#     vars_referenced: bool,
+#     num_called_num: bool,
+# ) -> nodes.Output:
+
+# Let's find the end of the signature
+end_sig = 0
+for i in range(make_node_line, len(lines)):
+    if '    ) -> nodes.Output:' in lines[i]:
+        end_sig = i
+        break
+
+lines.insert(end_sig, '        context: t.Optional[str] = None,\n')
+
+# Update _make_node body to use context
+# Find where gettext/ngettext are called
+for i in range(end_sig, len(lines)):
+    if '        # singular only:' in lines[i]:
+        # Insert context handling
+        lines.insert(i + 2, '        if context is not None:\n')
+        lines.insert(i + 3, '            gettext = nodes.Name("pgettext", "load")\n')
+        lines.insert(i + 4, '            node = nodes.Call(gettext, [nodes.Const(context), nodes.Const(singular)], [], None, None)\n')
+        lines.insert(i + 5, '        else:\n')
+        # Indent the existing code
+        for j in range(i + 6, i + 9):
+            lines[j] = '    ' + lines[j]
+        break
+
+# Find where ngettext is called
+for i in range(end_sig, len(lines)):
+    if '        # singular and plural' in lines[i]:
+        # Insert context handling
+        lines.insert(i + 2, '        if context is not None:\n')
+        lines.insert(i + 3, '            ngettext = nodes.Name("npgettext", "load")\n')
+        lines.insert(i + 4, '            node = nodes.Call(\n')
+        lines.insert(i + 5, '                ngettext,\n')
+        lines.insert(i + 6, '                [nodes.Const(context), nodes.Const(singular), nodes.Const(plural), plural_expr],\n')
+        lines.insert(i + 7, '                [],\n')
+        lines.insert(i + 8, '                None,\n')
+        lines.insert(i + 9, '                None,\n')
+        lines.insert(i + 10, '            )\n')
+        lines.insert(i + 11, '        else:\n')
+        # Indent the existing code
+        for j in range(i + 12, i + 20):
+            lines[j] = '    ' + lines[j]
+        break
+
+# Update the call to _make_node in parse
+# Find the call to _make_node
+for i in range(start_line, len(lines)):
+    if '        node = self._make_node(' in lines[i]:
+        # We need to find the end of the call
+        for j in range(i, i + 10):
+            if '        )' in lines[j]:
+                lines.insert(j, '            context=context,\n')
+                break
+        break
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
