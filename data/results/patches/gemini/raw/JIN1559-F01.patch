diff --git a/fix_make_node.py b/fix_make_node.py
new file mode 100644
index 0000000..df42e57
--- /dev/null
+++ b/fix_make_node.py
@@ -0,0 +1,76 @@
+with open('src/jinja2/ext.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the start of _make_node
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def _make_node(' in line:
+        start_line = i
+        break
+
+# Find the end of _make_node
+end_line = 0
+for i in range(start_line, len(lines)):
+    if '        # in case newstyle gettext is used' in lines[i]:
+        end_line = i
+        break
+
+# Replace the body of _make_node
+new_body = [
+    '    def _make_node(\n',
+    '        self,\n',
+    '        singular: str,\n',
+    '        plural: t.Optional[str],\n',
+    '        variables: t.Dict[str, nodes.Expr],\n',
+    '        plural_expr: t.Optional[nodes.Expr],\n',
+    '        vars_referenced: bool,\n',
+    '        num_called_num: bool,\n',
+    '        context: t.Optional[str] = None,\n',
+    '    ) -> nodes.Output:\n',
+    '        """Generates a useful node from the data provided."""\n',
+    '        newstyle = self.environment.newstyle_gettext  # type: ignore\n',
+    '        node: nodes.Expr\n',
+    '\n',
+    '        # no variables referenced?  no need to escape for old style\n',
+    '        # gettext invocations only if there are vars.\n',
+    '        if not vars_referenced and not newstyle:\n',
+    '            singular = singular.replace("%%", "%")\n',
+    '            if plural:\n',
+    '                plural = plural.replace("%%", "%")\n',
+    '\n',
+    '        # singular only:\n',
+    '        if plural_expr is None:\n',
+    '            if context is not None:\n',
+    '                gettext = nodes.Name("pgettext", "load")\n',
+    '                node = nodes.Call(gettext, [nodes.Const(context), nodes.Const(singular)], [], None, None)\n',
+    '            else:\n',
+    '                gettext = nodes.Name("gettext", "load")\n',
+    '                node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)\n',
+    '\n',
+    '        # singular and plural\n',
+    '        else:\n',
+    '            if context is not None:\n',
+    '                ngettext = nodes.Name("npgettext", "load")\n',
+    '                node = nodes.Call(\n',
+    '                    ngettext,\n',
+    '                    [nodes.Const(context), nodes.Const(singular), nodes.Const(plural), plural_expr],\n',
+    '                    [],\n',
+    '                    None,\n',
+    '                    None,\n',
+    '                )\n',
+    '            else:\n',
+    '                ngettext = nodes.Name("ngettext", "load")\n',
+    '                node = nodes.Call(\n',
+    '                    ngettext,\n',
+    '                    [nodes.Const(singular), nodes.Const(plural), plural_expr],\n',
+    '                    [],\n',
+    '                    None,\n',
+    '                    None,\n',
+    '                )\n',
+    '\n'
+]
+
+lines[start_line:end_line] = new_body
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(lines)
