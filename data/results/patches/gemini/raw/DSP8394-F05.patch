diff --git a/reproduce_cache.py b/reproduce_cache.py
new file mode 100644
index 00000000..3cb948c8
--- /dev/null
+++ b/reproduce_cache.py
@@ -0,0 +1,29 @@
+import os
+import shutil
+import tempfile
+from dspy.clients.cache import Cache
+
+# Setup
+cache_dir = tempfile.mkdtemp()
+try:
+    # Test initialization
+    cache = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=True,
+        disk_cache_dir=cache_dir,
+        disk_size_limit_bytes=1024 * 1024,
+        memory_max_entries=100,
+    )
+    
+    # Test put/get
+    request = {"prompt": "hello"}
+    value = {"response": "world"}
+    cache.put(request, value)
+    
+    retrieved = cache.get(request)
+    print(f"Retrieved: {retrieved}")
+    assert retrieved == value
+    
+    print("Basic cache functionality works.")
+finally:
+    shutil.rmtree(cache_dir)
diff --git a/test_compression.py b/test_compression.py
new file mode 100644
index 00000000..c1929ed1
--- /dev/null
+++ b/test_compression.py
@@ -0,0 +1,66 @@
+import os
+import shutil
+import tempfile
+import gzip
+import zlib
+import pickle
+from dspy.clients.cache import Cache
+
+# Setup
+cache_dir = tempfile.mkdtemp()
+try:
+    # Initialize Cache with compression
+    # We need to modify Cache to accept these arguments first.
+    # This script is to verify the *design* of the compression.
+    
+    # The requirement:
+    # The persisted compressed representation is bytes beginning with b"DSPC", 
+    # followed by one codec byte (0x00: uncompressed pickle; 0x01: gzip; 0x02: zlib) 
+    # and the encoded pickle payload.
+    
+    def compress_data(data, codec):
+        payload = pickle.dumps(data)
+        if codec == "gzip":
+            compressed = gzip.compress(payload)
+            return b"DSPC" + b"\x01" + compressed
+        elif codec == "zlib":
+            compressed = zlib.compress(payload)
+            return b"DSPC" + b"\x02" + compressed
+        elif codec is None:
+            return b"DSPC" + b"\x00" + payload
+        else:
+            raise ValueError("Invalid codec")
+
+    def decompress_data(data):
+        if not data.startswith(b"DSPC"):
+            # Legacy support
+            return pickle.loads(data)
+        
+        codec_byte = data[4:5]
+        payload = data[5:]
+        
+        if codec_byte == b"\x00":
+            return pickle.loads(payload)
+        elif codec_byte == b"\x01":
+            return pickle.loads(gzip.decompress(payload))
+        elif codec_byte == b"\x02":
+            return pickle.loads(zlib.decompress(payload))
+        else:
+            raise ValueError("Unknown codec")
+
+    # Test
+    data = {"a": 1, "b": [1, 2, 3]}
+    
+    for codec in [None, "gzip", "zlib"]:
+        compressed = compress_data(data, codec)
+        decompressed = decompress_data(compressed)
+        print(f"Codec {codec}: {decompressed == data}")
+        assert decompressed == data
+        
+    # Test legacy
+    legacy_data = pickle.dumps(data)
+    assert decompress_data(legacy_data) == data
+    print("Compression/Decompression logic works.")
+
+finally:
+    shutil.rmtree(cache_dir)
