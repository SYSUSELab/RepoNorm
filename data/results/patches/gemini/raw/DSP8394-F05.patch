@@ -0,0 +1,39 @@
+import os
+import shutil
+import tempfile
+from dspy.clients.cache import Cache
+
+# Setup
+cache_dir = tempfile.mkdtemp()
+try:
+    # Test initialization with new args
+    cache = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=True,
+        disk_cache_dir=cache_dir,
+        compress="gzip",
+        cull_limit=10,
+        eviction_policy="least-recently-used",
+    )
+    
+    # Test put/get with compression
+    request = {"prompt": "hello"}
+    value = {"response": "world"}
+    cache.put(request, value)
+    
+    retrieved = cache.get(request)
+    print(f"Retrieved: {retrieved}")
+    assert retrieved == value
+    
+    # Test changing compression
+    cache.set_compression("zlib")
+    value2 = {"response": "new"}
+    cache.put({"prompt": "new"}, value2)
+    assert cache.get({"prompt": "new"}) == value2
+    
+    # Verify old entry still readable
+    assert cache.get(request) == value
+    
+    print("New cache functionality works.")
+finally:
+    shutil.rmtree(cache_dir)
