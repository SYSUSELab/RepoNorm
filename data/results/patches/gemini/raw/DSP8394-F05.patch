@@ -0,0 +1,32 @@
+import os
+import shutil
+import tempfile
+import pickle
+from dspy.clients.cache import Cache
+from diskcache import FanoutCache
+
+# Setup
+cache_dir = tempfile.mkdtemp()
+try:
+    # Initialize Cache
+    cache = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=False,
+        disk_cache_dir=cache_dir,
+    )
+    
+    # Manually put a legacy entry (no header) into the disk cache
+    request = {"prompt": "hello"}
+    key = cache.cache_key(request)
+    
+    # Access the underlying disk_cache
+    cache.disk_cache[key] = {"data": "legacy"}
+    
+    # Now get it
+    retrieved = cache.get(request)
+    print(f"Retrieved: {retrieved}")
+    assert retrieved == {"data": "legacy"}
+    
+    print("Legacy compatibility works.")
+finally:
+    shutil.rmtree(cache_dir)
