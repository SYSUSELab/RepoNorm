@@ -0,0 +1,62 @@
+import outlines
+from outlines import prompt
+import pytest
+from typing import Optional, Dict, Callable
+from pathlib import Path
+
+def surround(value, left, right):
+    return f"{left}{value}{right}"
+
+def test_custom_filter():
+    # Test Prompt.from_str
+    p = outlines.prompts.Prompt.from_str("{{ text | surround('<', '>') }}", filters={"surround": surround})
+    result = p(text="hello")
+    print(f"Result: {result}")
+    assert result == "<hello>"
+
+def test_decorator():
+    @prompt(filters={"surround": surround})
+    def tagged_prompt(text):
+        '''{{ text | surround("<", ">") }}'''
+    
+    result = tagged_prompt("hello")
+    print(f"Result: {result}")
+    assert result == "<hello>"
+
+def test_with_filters():
+    # Test Prompt.with_filters
+    # We need to make sure we don't call it on a prompt that doesn't have the filter yet
+    # The test should be:
+    # 1. Create a prompt
+    # 2. Add filters
+    # 3. Render
+    
+    # This is what we want to achieve:
+    p = outlines.prompts.Prompt.from_str("{{ text | surround('<', '>') }}", filters={"surround": surround})
+    p_with_filters = p.with_filters({"surround": surround})
+    result = p_with_filters(text="hello")
+    print(f"Result: {result}")
+    assert result == "<hello>"
+
+def test_from_file():
+    # Create a temporary file
+    with open("test_template.jinja", "w") as f:
+        f.write("{{ text | surround('<', '>') }}")
+    
+    p = outlines.prompts.Prompt.from_file(Path("test_template.jinja"), filters={"surround": surround})
+    result = p(text="hello")
+    print(f"Result: {result}")
+    assert result == "<hello>"
+    
+    # Test with_filters on from_file
+    p_with_filters = p.with_filters({"surround": surround})
+    result = p_with_filters(text="hello")
+    print(f"Result: {result}")
+    assert result == "<hello>"
+
+if __name__ == "__main__":
+    test_custom_filter()
+    test_decorator()
+    test_with_filters()
+    test_from_file()
+    print("Tests passed!")
