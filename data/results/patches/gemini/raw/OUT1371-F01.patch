+def test_prompt_custom_filters():
+    def surround(value, left, right):
+        return f"{left}{value}{right}"
+
+    # Test Prompt.from_str
+    p = Prompt.from_str("{{ text | surround('<', '>') }}", filters={"surround": surround})
+    assert p(text="hello") == "<hello>"
+
+    # Test Prompt.with_filters
+    p_no_filters = Prompt.from_str("{{ text | surround('<', '>') }}", filters={"surround": surround})
+    p_with_filters = p_no_filters.with_filters({"surround": surround})
+    assert p_with_filters(text="hello") == "<hello>"
+
+    # Test decorator
+    @outlines.prompt(filters={"surround": surround})
+    def tagged_prompt(text):
+        '''{{ text | surround("<", ">") }}'''
+    
+    assert tagged_prompt("hello") == "<hello>"
+
+def test_prompt_from_file_with_filters():
+    def surround(value, left, right):
+        return f"{left}{value}{right}"
+
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        f.write("{{ text | surround('<', '>') }}")
+        path = f.name
+    
+    try:
+        p = Prompt.from_file(Path(path), filters={"surround": surround})
+        assert p(text="hello") == "<hello>"
+        
+        p_with_filters = p.with_filters({"surround": surround})
+        assert p_with_filters(text="hello") == "<hello>"
+    finally:
