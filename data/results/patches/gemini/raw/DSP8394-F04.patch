@@ -0,0 +1,37 @@
+import dspy
+from dspy.clients.cache import Cache
+import contextlib
+
+# Mocking a simple module
+class SimpleModule(dspy.Module):
+    def __init__(self, cache):
+        super().__init__()
+        self.cache = cache
+    
+    def forward(self, request):
+        self.cache.get(request)
+        return dspy.Prediction()
+
+def test_cache_usage_integration():
+    # Initialize Cache with required arguments
+    cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+    # Pre-populate cache
+    request = {"key": "value1"}
+    cache.put(request, "value1")
+    
+    module = SimpleModule(cache)
+    
+    with dspy.settings.context(track_usage=True):
+        # This should trigger the new logic in Module.__call__
+        prediction = module(request)
+        
+        usage = prediction.get_cache_usage()
+        print(f"Cache usage: {usage}")
+        
+        assert usage is not None
+        assert usage["hits"] == 1
+        assert usage["mem_hits"] == 1
+        assert usage["misses"] == 0
+
+if __name__ == "__main__":
+    test_cache_usage_integration()
