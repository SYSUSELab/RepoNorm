diff --git a/dspy/utils/cache_usage_tracker.py b/dspy/utils/cache_usage_tracker.py
new file mode 100644
index 00000000..590dca61
--- /dev/null
+++ b/dspy/utils/cache_usage_tracker.py
@@ -0,0 +1,36 @@
+from contextlib import contextmanager
+from typing import Any, Optional
+from dspy.dsp.utils.settings import settings
+
+class CacheUsageTracker:
+    def __init__(self):
+        self.hits = 0
+        self.mem_hits = 0
+        self.disk_hits = 0
+        self.misses = 0
+
+    def record_hit(self, is_mem: bool):
+        self.hits += 1
+        if is_mem:
+            self.mem_hits += 1
+        else:
+            self.disk_hits += 1
+
+    def record_miss(self):
+        self.misses += 1
+
+    def snapshot(self) -> dict[str, int]:
+        return {
+            "hits": self.hits,
+            "mem_hits": self.mem_hits,
+            "disk_hits": self.disk_hits,
+            "misses": self.misses,
+        }
+
+@contextmanager
+def track_cache_usage():
+    tracker = CacheUsageTracker()
+    # We need to add cache_usage_tracker to settings.
+    # Since settings is a singleton, we can just use context to add it.
+    with settings.context(cache_usage_tracker=tracker):
+        yield tracker
diff --git a/reproduce_cache_stats.py b/reproduce_cache_stats.py
new file mode 100644
index 00000000..b5223f89
--- /dev/null
+++ b/reproduce_cache_stats.py
@@ -0,0 +1,34 @@
+import dspy
+from dspy.clients.cache import Cache
+
+# Mocking dspy.cache
+dspy.cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+
+def test_cache_stats():
+    # Test stats
+    stats = dspy.cache.stats()
+    print(f"Initial Stats: {stats}")
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+
+    # Test miss
+    dspy.cache.get({"a": 1})
+    stats = dspy.cache.stats()
+    print(f"Stats after miss: {stats}")
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 1}
+
+    # Test hit
+    dspy.cache.put({"a": 1}, "result")
+    dspy.cache.get({"a": 1})
+    stats = dspy.cache.stats()
+    print(f"Stats after hit: {stats}")
+    assert stats == {"hits": 1, "mem_hits": 1, "disk_hits": 0, "misses": 1}
+
+    # Test reset
+    dspy.cache.reset_stats()
+    stats = dspy.cache.stats()
+    print(f"Stats after reset: {stats}")
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+
+    print("All tests passed!")
+
+test_cache_stats()
