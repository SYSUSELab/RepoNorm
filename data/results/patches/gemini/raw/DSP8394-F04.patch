@@ -0,0 +1,24 @@
+import dspy
+from dspy.clients.cache import Cache
+from dspy.utils.cache_usage_tracker import track_cache_usage
+from dspy.primitives.prediction import Prediction
+
+# Mocking dspy.cache
+dspy.cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir="/tmp/dspy_cache")
+
+def test_cache_usage_tracking():
+    with track_cache_usage() as tracker:
+        # Test miss
+        dspy.cache.get({"a": 1})
+        
+        # Test hit
+        dspy.cache.put({"a": 1}, Prediction(score=1.0))
+        dspy.cache.get({"a": 1})
+        
+        snapshot = tracker.snapshot()
+        print(f"Snapshot: {snapshot}")
+        assert snapshot == {"hits": 1, "mem_hits": 1, "disk_hits": 0, "misses": 1}
+
+    print("Cache usage tracking test passed!")
+
+test_cache_usage_tracking()
