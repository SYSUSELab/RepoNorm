+from jinja2.filters import sync_do_groupby
+from jinja2.environment import Environment
+
+class UnhashableKey:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return self.value == other.value
+    def __repr__(self):
+        return f"UnhashableKey({self.value})"
+    # No __hash__
+
+class MockObject:
+    def __init__(self, name, key):
+        self.name = name
+        self.key = key
+    def __repr__(self):
+        return f"MockObject({self.name}, {self.key})"
+
+env = Environment()
+users = [
+    MockObject("Alice", UnhashableKey("NY")),
+    MockObject("Bob", UnhashableKey("LA")),
+    MockObject("Charlie", UnhashableKey("NY")),
+]
+
+try:
+    # This should fail because sorted() will try to compare UnhashableKey objects
+    # and if they are not comparable, it will raise TypeError.
+    # Wait, the task says "Support equality-comparable keys including lists and dictionaries"
+    # If they are not comparable (no __lt__), sorted() will fail.
+    # The task says "without requiring ordering or hashing".
+    # So we should NOT use sorted().
+    result = sync_do_groupby(env, users, "key")
+    print("Result:", result)
+except Exception as e:
+    print(f"Failed: {e}")
