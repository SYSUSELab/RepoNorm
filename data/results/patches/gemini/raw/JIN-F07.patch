@@ -0,0 +1,60 @@
+from jinja2.filters import sync_do_groupby
+from jinja2.environment import Environment
+
+class MockObject:
+    def __init__(self, name, city):
+        self.name = name
+        self.city = city
+    def __repr__(self):
+        return f"MockObject({self.name}, {self.city})"
+
+env = Environment()
+users = [
+    MockObject("Alice", "NY"),
+    MockObject("Bob", "LA"),
+    MockObject("Charlie", "NY"),
+]
+
+# Current implementation
+def current_groupby(environment, value, attribute, default=None):
+    from itertools import groupby
+    from jinja2.filters import make_attrgetter, _GroupTuple
+    expr = make_attrgetter(environment, attribute, default=default)
+    return [
+        _GroupTuple(key, list(values))
+        for key, values in groupby(sorted(value, key=expr), expr)
+    ]
+
+# New implementation
+def new_groupby(environment, value, attribute, default=None, stable=True):
+    from itertools import groupby
+    from jinja2.filters import make_attrgetter, _GroupTuple
+    expr = make_attrgetter(environment, attribute, default=default)
+    
+    if not stable:
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+    else:
+        groups = []
+        for item in value:
+            key = expr(item)
+            found = False
+            for existing_key, group in groups:
+                if existing_key == key:
+                    group.append(item)
+                    found = True
+                    break
+            if not found:
+                groups.append(_GroupTuple(key, [item]))
+        return groups
+
+# Test
+print("Stable=True:")
+for key, items in new_groupby(env, users, "city", stable=True):
+    print(f"{key}: {items}")
+
+print("\nStable=False:")
+for key, items in new_groupby(env, users, "city", stable=False):
+    print(f"{key}: {items}")
