+    def __eq__(self, other):
+        return self.value == other.value
+    def __repr__(self):
+        return f"UnhashableKey({self.value})"
+
+class MockObject:
+    def __init__(self, name, key):
+        self.name = name
+        self.key = key
+    def __repr__(self):
+        return f"MockObject({self.name}, {self.key})"
+
+env = Environment()
+users = [
+    MockObject("Alice", UnhashableKey("NY")),
+    MockObject("Bob", UnhashableKey("LA")),
+    MockObject("Charlie", UnhashableKey("NY")),
+]
+
+# Test stable=True (default)
+print("Stable=True (default):")
+result = sync_do_groupby(env, users, "key")
+for key, items in result:
+    print(f"{key}: {items}")
