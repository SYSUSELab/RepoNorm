+from collections import defaultdict
+
+def groupby_stable(items, key_func):
+    groups = []
+    seen_keys = []
+    key_to_items = defaultdict(list)
+    
+    for item in items:
+        key = key_func(item)
+        
+        # We need to check if this key has been seen before.
+        # The requirement says: "Equal keys merge even when not adjacent or not the same object; retain the first original key object as grouper."
+        # So we need to compare keys using equality, not identity.
+        
+        found = False
+        for existing_key in seen_keys:
+            if existing_key == key:
+                key_to_items[existing_key].append(item)
+                found = True
+                break
+        
+        if not found:
+            seen_keys.append(key)
+            key_to_items[key].append(item)
+            
+    return [(key, key_to_items[key]) for key in seen_keys]
+
+class UnhashableKey:
+    def __init__(self, value):
+        self.value = value
+    def __eq__(self, other):
+        return self.value == other.value
+    def __repr__(self):
+        return f"UnhashableKey({self.value})"
+
+class MockObject:
+    def __init__(self, name, key):
+        self.name = name
+        self.key = key
+    def __repr__(self):
+        return f"MockObject({self.name}, {self.key})"
+
+items = [
+    MockObject("Alice", UnhashableKey("NY")),
+    MockObject("Bob", UnhashableKey("LA")),
+    MockObject("Charlie", UnhashableKey("NY")),
+]
+
+def key_func(obj):
+    return obj.key
+
