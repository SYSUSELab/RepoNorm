+++ b/test_groupby_fix.py
@@ -0,0 +1,40 @@
+from jinja2.filters import sync_do_groupby
+from jinja2 import Environment
+
+env = Environment()
+
+# Test case 1: Stable grouping (default) with unhashable keys (dicts)
+data = [
+    {"id": 1, "group": "a"},
+    {"id": 2, "group": "b"},
+    {"id": 3, "group": "a"},
+]
+
+result = sync_do_groupby(env, data, "group")
+print("Result:", result)
+
+# Verify the result
+assert len(result) == 2
+assert result[0][0] == "a"
+assert len(result[0][1]) == 2
+assert result[1][0] == "b"
+assert len(result[1][1]) == 1
+
+# Test case 2: Unstable grouping (stable=False) with sortable keys
+data2 = [
+    {"id": 1, "val": 1},
+    {"id": 2, "val": 2},
+    {"id": 3, "val": 1},
+    {"id": 4, "val": 3},
+    {"id": 5, "val": 2},
+]
+result2 = sync_do_groupby(env, data2, "val", stable=False)
+print("Result2:", result2)
+# With stable=False, it should be sorted by "val"
+# So the groups should be: 1, 2, 3
+assert len(result2) == 3
+assert result2[0][0] == 1
+assert result2[1][0] == 2
+assert result2[2][0] == 3
+
+print("All tests passed!")
