+class IsEmail(DirtyEquals[str]):
+    """
+    Checks if the value is a valid email address.
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        self.domain = domain
+        if domain:
+            super().__init__(domain)
+        else:
+            super().__init__()
+
+    def _repr_ne(self) -> str:
+        if self.domain:
+            return f"IsEmail({self.domain!r})"
+        else:
+            return "IsEmail(*)"
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Local part
+        # ASCII letters/digits and `_ % + -`, with dots only between nonempty runs (no leading, trailing or consecutive dots).
+        local_part_regex = r"[a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*"
+        
+        # Domain labels
+        # ASCII letters/digits and internal hyphens; labels are nonempty and cannot start or end with a hyphen.
+        # There are at least two labels and the final label consists of at least two ASCII letters.
+        label_regex = r"[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+        final_label_regex = r"[a-zA-Z]{2,}"
+        
+        domain_regex = rf"{label_regex}(\.{label_regex})*\.{final_label_regex}"
+        full_regex = rf"^{local_part_regex}@{domain_regex}$"
+        
+        if not re.fullmatch(full_regex, other):
+            return False
+        
+        if self.domain:
+            return other.endswith(f"@{self.domain}")
+        
+        return True
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..e53ab8d
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,68 @@
+from dirty_equals import IsStr
+import re
+
+# The requirement for IsEmail:
+# - Without a domain filter, accept conventional string email addresses with a
+#   non-empty local part and a dotted domain; reject malformed and non-string
+#   values.
+# - The usual local-part characters used by addresses such as
+#   `test.email+tag@domain.co.uk` and domains containing hyphens are supported.
+# - A supplied domain must match the complete domain exactly and
+#   case-sensitively; a subdomain is not an implicit match.
+# - Its representations are `IsEmail(*)` without a filter and, for example,
+#   `IsEmail('example.com')` with one.
+
+# Grammar:
+# - Local part: ASCII letters/digits and `_ % + -`, with dots only between nonempty runs (no leading, trailing or consecutive dots).
+# - Domain labels: ASCII letters/digits and internal hyphens; labels are nonempty and cannot start or end with a hyphen.
+# - There are at least two labels and the final label consists of at least two ASCII letters.
+# - Match the entire string without trimming whitespace.
+
+# Let's try to construct a regex for this.
+# Local part: [a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*
+# Domain: [a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}
+# Wait, the domain labels cannot start or end with a hyphen.
+# Label: [a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?
+# Domain: Label(\.Label)*\.[a-zA-Z]{2,}
+
+# Let's test this logic.
+def is_email(email, domain=None):
+    if not isinstance(email, str):
+        return False
+    
+    # Local part
+    # ASCII letters/digits and `_ % + -`, with dots only between nonempty runs (no leading, trailing or consecutive dots).
+    local_part_regex = r"[a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*"
+    
+    # Domain labels
+    # ASCII letters/digits and internal hyphens; labels are nonempty and cannot start or end with a hyphen.
+    # There are at least two labels and the final label consists of at least two ASCII letters.
+    label_regex = r"[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+    domain_regex = rf"{label_regex}(\.{label_regex})*\.[a-zA-Z]{{2,}}"
+    
+    full_regex = rf"^{local_part_regex}@{domain_regex}$"
+    
+    if not re.fullmatch(full_regex, email):
+        return False
+    
+    if domain:
+        return email.endswith(f"@{domain}")
+    
+    return True
+
+# Test cases
+assert is_email("test.email+tag@domain.co.uk") == True
+assert is_email("test@example.com") == True
+assert is_email("test@example.c") == False # Final label must be at least 2 letters
+assert is_email("test@example.co") == True
+assert is_email("test@example-domain.com") == True
+assert is_email("test@-example.com") == False # Label cannot start with hyphen
+assert is_email("test@example-.com") == False # Label cannot end with hyphen
+assert is_email("test@example.com", domain="example.com") == True
+assert is_email("test@sub.example.com", domain="example.com") == False
+assert is_email("test@example.com", domain="other.com") == False
+assert is_email("test..email@example.com") == False # Consecutive dots
+assert is_email(".test@example.com") == False # Leading dot
+assert is_email("test.@example.com") == False # Trailing dot
+
+print("All tests passed!")
diff --git a/test_email.py b/test_email.py
new file mode 100644
index 0000000..4a98ea6
--- /dev/null
+++ b/test_email.py
@@ -0,0 +1,25 @@
+from dirty_equals import IsEmail
+
+def test_is_email():
+    assert "test.email+tag@domain.co.uk" == IsEmail()
+    assert "test@example.com" == IsEmail()
+    assert "test@example.c" != IsEmail()
+    assert "test@example.co" == IsEmail()
+    assert "test@example-domain.com" == IsEmail()
+    assert "test@-example.com" != IsEmail()
+    assert "test@example-.com" != IsEmail()
+    assert "test@example.com" == IsEmail(domain="example.com")
+    assert "test@sub.example.com" != IsEmail(domain="example.com")
+    assert "test@example.com" != IsEmail(domain="other.com")
+    assert "test..email@example.com" != IsEmail()
+    assert ".test@example.com" != IsEmail()
+    assert "test.@example.com" != IsEmail()
+    assert "test@a.b" != IsEmail()
+    assert "test@a.bc" == IsEmail()
+    assert 123 != IsEmail()
+    assert "not-an-email" != IsEmail()
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_is_email()
diff --git a/test_email_regex.py b/test_email_regex.py
new file mode 100644
index 0000000..a18322a
--- /dev/null
+++ b/test_email_regex.py
@@ -0,0 +1,93 @@
+import re
+
+def is_email(email, domain=None):
+    if not isinstance(email, str):
+        return False
+    
+    # Local part
+    # ASCII letters/digits and `_ % + -`, with dots only between nonempty runs (no leading, trailing or consecutive dots).
+    local_part_regex = r"[a-zA-Z0-9_%+-]+(\.[a-zA-Z0-9_%+-]+)*"
+    
+    # Domain labels
+    # ASCII letters/digits and internal hyphens; labels are nonempty and cannot start or end with a hyphen.
+    # There are at least two labels and the final label consists of at least two ASCII letters.
+    # Label: [a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?
+    # Wait, what if the label is a single character?
+    # "labels are nonempty and cannot start or end with a hyphen."
+    # A single character label like 'a' is valid.
+    # "There are at least two labels and the final label consists of at least two ASCII letters."
+    
+    # Let's refine the domain regex.
+    # Domain: label(\.label)*\.final_label
+    # label: [a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?
+    # final_label: [a-zA-Z]{2,}
+    
+    label_regex = r"[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+    final_label_regex = r"[a-zA-Z]{2,}"
+    
+    # Domain: label(\.label)*\.final_label
+    # Wait, the requirement says "There are at least two labels".
+    # Does "label" include the final label?
+    # "There are at least two labels and the final label consists of at least two ASCII letters."
+    # This implies the final label is one of the labels.
+    # So it should be: label(\.label)*\.final_label
+    # Wait, if I have "a.b.com", labels are "a", "b", "com".
+    # "a" matches label_regex.
+    # "b" matches label_regex.
+    # "com" matches final_label_regex.
+    
+    # So domain_regex = rf"{label_regex}(\.{label_regex})*\.{final_label_regex}"
+    # Let's test "test@a.b.com"
+    # label_regex matches 'a'.
+    # (\.{label_regex})* matches '.b'.
+    # \.final_label_regex matches '.com'.
+    # This seems correct.
+    
+    # What about "test@a.com"?
+    # label_regex matches 'a'.
+    # (\.{label_regex})* matches nothing.
+    # \.final_label_regex matches '.com'.
+    # This also seems correct.
+    
+    # What about "test@a.b"?
+    # label_regex matches 'a'.
+    # (\.{label_regex})* matches nothing.
+    # \.final_label_regex matches '.b'.
+    # Wait, final_label_regex is [a-zA-Z]{2,}.
+    # So 'b' does not match final_label_regex.
+    # So "test@a.b" is False. Correct.
+    
+    # What about "test@a.bc"?
+    # label_regex matches 'a'.
+    # (\.{label_regex})* matches nothing.
+    # \.final_label_regex matches '.bc'.
+    # This is True. Correct.
+    
+    domain_regex = rf"{label_regex}(\.{label_regex})*\.{final_label_regex}"
+    full_regex = rf"^{local_part_regex}@{domain_regex}$"
+    
+    if not re.fullmatch(full_regex, email):
+        return False
+    
+    if domain:
+        return email.endswith(f"@{domain}")
+    
+    return True
+
+# Test cases
+assert is_email("test.email+tag@domain.co.uk") == True
+assert is_email("test@example.com") == True
+assert is_email("test@example.c") == False # Final label must be at least 2 letters
+assert is_email("test@example.co") == True
+assert is_email("test@example-domain.com") == True
+assert is_email("test@-example.com") == False # Label cannot start with hyphen
+assert is_email("test@example-.com") == False # Label cannot end with hyphen
+assert is_email("test@example.com", domain="example.com") == True
+assert is_email("test@sub.example.com", domain="example.com") == False
+assert is_email("test@example.com", domain="other.com") == False
+assert is_email("test..email@example.com") == False # Consecutive dots
+assert is_email(".test@example.com") == False # Leading dot
+assert is_email("test.@example.com") == False # Trailing dot
+assert is_email("test@a.b") == False
+assert is_email("test@a.bc") == True
+print("All tests passed!")
