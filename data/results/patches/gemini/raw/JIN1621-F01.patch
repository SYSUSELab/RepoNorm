+
+def test_filesystem_loader_fallback(tmpdir):
+    primary = tmpdir.mkdir("primary")
+    fallback = tmpdir.mkdir("fallback")
+    primary.join("test.html").write("primary")
+    fallback.join("fallback.html").write("fallback")
+    fallback.join("conflict.html").write("fallback")
+    primary.join("conflict.html").write("primary")
+
+    from jinja2 import FileSystemLoader, Environment
+    loader = FileSystemLoader(
+        searchpath=[str(primary)],
+        fallback_searchpath=[str(fallback)]
+    )
+    env = Environment(loader=loader)
+
+    assert env.get_template("test.html").render() == "primary"
+    assert env.get_template("fallback.html").render() == "fallback"
+    assert env.get_template("conflict.html").render() == "primary"
+    
+    templates = loader.list_templates()
+    assert "test.html" in templates
+    assert "fallback.html" in templates
+    assert "conflict.html" in templates
+    assert len(templates) == 3
