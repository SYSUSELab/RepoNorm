+with open('src/click/core.py', 'r') as f:
+    lines = f.readlines()
+
+# Find the first `parse_args` in the file.
+start_line = 0
+for i, line in enumerate(lines):
+    if 'def parse_args(self, ctx: Context, args: list[str]) -> list[str]:' in line:
+        start_line = i
+        break
+
+# Find the `return args` in `parse_args`
+return_line = 0
+for i in range(start_line + 1, start_line + 20):
+    if 'return args' in lines[i]:
+        return_line = i
+        break
+
+# Insert `ctx._is_parsing = True` and `ctx._is_parsing = False`
+# Make sure the indentation is correct (8 spaces).
+lines.insert(start_line + 1, '        ctx._is_parsing = True\n')
+lines.insert(return_line + 1, '        ctx._is_parsing = False\n')
+
+with open('src/click/core.py', 'w') as f:
+    f.writelines(lines)
