+    if '    ) -> None:' in lines[i]:
+        end_line = i + 1
+        break
+
+# Insert get_option_history method
+method = """
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        if not self.command.track_changes:
+            return None
+        
+        # Resolve the option name to the parameter name
+        param = None
+        for p in self.command.get_params(self):
