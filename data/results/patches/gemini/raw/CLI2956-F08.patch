+import re
+
+with open('src/click/core.py', 'r') as f:
+    content = f.read()
+
+# Define the new handle_parse_result method
+new_method = """
+    def handle_parse_result(
+        self, ctx: Context, opts: cabc.Mapping[str, t.Any], args: list[str]
+    ) -> tuple[t.Any, list[str]]:
+        with augment_usage_errors(ctx, param=self):
+            value, source = self.consume_value(ctx, opts)
+
+            if (
+                self.deprecated
+                and value is not None
+                and source
+                not in (
+                    ParameterSource.DEFAULT,
+                    ParameterSource.DEFAULT_MAP,
+                )
+            ):
+                extra_message = (
+                    f" {self.deprecated}" if isinstance(self.deprecated, str) else ""
+                )
+                message = _(
+                    "DeprecationWarning: The {param_type} {name!r} is deprecated."
+                    "{extra_message}"
+                ).format(
+                    param_type=self.param_type_name,
+                    name=self.human_readable_name,
+                    extra_message=extra_message,
+                )
+                echo(style(message, fg="red"), err=True)
+
+            ctx.set_parameter_source(self.name, source)  # type: ignore
+
+            try:
+                value = self.process_value(ctx, value)
+            except Exception:
+                if not ctx.resilient_parsing:
+                    raise
+
+                value = None
+
+            if ctx.command.track_changes:
+                if self.name not in ctx._option_history:
+                    ctx._option_history[self.name] = []
+                ctx._option_history[self.name].append({
+                    "value": value,
+                    "source": source,
+                    "timestamp": time.time(),
+                })
+
+        if self.expose_value:
+            ctx.params[self.name] = value  # type: ignore
+
+        return value, args
+"""
+
+# Replace the old method with the new one
+# Find the start and end of the old method
+start_pattern = r'    def handle_parse_result\(.*?\) -> tuple\[t\.Any, list\[str\]\]:'
+end_pattern = r'        return value, args'
+# This is tricky because of the indentation.
+# Let's just use a simpler approach.
+# I will find the start of the method and the end of the method.
+start_index = content.find('    def handle_parse_result(')
+end_index = content.find('        return value, args', start_index) + len('        return value, args')
+content = content[:start_index] + new_method + content[end_index:]
+
+with open('src/click/core.py', 'w') as f:
+    f.write(content)
