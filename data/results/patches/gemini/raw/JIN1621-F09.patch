+import os
+import threading
+import time
+import weakref
+import gc
+from jinja2 import Environment, FileSystemLoader
+
+class FileSystemLoaderWithAutoReload(FileSystemLoader):
+    def __init__(self, searchpath, encoding="utf-8", followlinks=False, auto_reload=False):
+        super().__init__(searchpath, encoding=encoding, followlinks=followlinks)
+        self.auto_reload = auto_reload
+        self._environments = weakref.WeakSet()
+        self._lock = threading.Lock()
+        self._stop_event = threading.Event()
+        self._thread = None
+
+    def start_monitoring(self):
+        if not self.auto_reload:
+            return
+        with self._lock:
+            if self._thread is None:
+                self._thread = threading.Thread(target=self._monitor, daemon=True)
+                self._thread.start()
+
+    def _monitor(self):
+        while not self._stop_event.is_set():
+            # print("Monitoring...")
+            time.sleep(0.5)
+
+    def load(self, environment, name, globals=None):
+        if self.auto_reload:
+            self._environments.add(environment)
+            self.start_monitoring()
+        return super().load(environment, name, globals)
+
+# Test
+os.makedirs("templates", exist_ok=True)
