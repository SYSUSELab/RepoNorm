+    def process_value(self, ctx: Context, value: t.Any) -> t.Any:
+        value = super().process_value(ctx, value)
+
+        if self.batch_size is not None and value is not None:
+            # Group the final ordered tuple into an outer tuple of non-empty tuple batches
+            # of at most batch_size items.
+            # Preserve every value, including 0, False, the empty string, and None;
+            # preserve input order and include a shorter final batch.
+            # Empty input produces ().
+            if not value:
+                return ()
+            
+            batches = []
+            for i in range(0, len(value), self.batch_size):
+                batches.append(tuple(value[i : i + self.batch_size]))
+            return tuple(batches)
