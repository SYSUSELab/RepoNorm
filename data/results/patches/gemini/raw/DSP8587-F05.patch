index 00000000..17b5e730
--- /dev/null
+++ b/test_logging_functionality_v2.py
@@ -0,0 +1,34 @@
+import logging
+import sys
+from dspy.streaming.streaming_listener import StreamListener
+from unittest.mock import MagicMock
+from dspy.streaming.messages import StreamResponse
+from dspy.dsp.utils.settings import settings
+from dspy.adapters.chat_adapter import ChatAdapter
+
+# Setup logger
+logger = logging.getLogger("dspy.streaming.listener")
+logger.setLevel(logging.DEBUG)
+handler = logging.StreamHandler(sys.stdout)
+handler.setLevel(logging.DEBUG)
+logger.addHandler(handler)
+
+# Test initialization
+listener = StreamListener(
+    signature_field_name="answer",
+    debug=True,
+    debug_logger=logger
+)
+
+# Mock settings.adapter
+settings.adapter = ChatAdapter()
+
+# Mock chunk
+chunk = MagicMock()
+chunk.choices = [MagicMock()]
+chunk.choices[0].delta.content = "[[ ## answer ## ]] hello"
+
+# Receive chunk
+print("Calling receive...")
+listener.receive(chunk)
+print("Receive called.")
