@@ -0,0 +1,11 @@
+import logging
+
+def format_preview(content: str) -> str:
+    if len(content) <= 80:
+        return content
+    return content[:77] + "..."
+
+# Test cases
+print(f"'{format_preview('short')}'")
+print(f"'{format_preview('a' * 80)}'")
+print(f"'{format_preview('a' * 81)}'")
