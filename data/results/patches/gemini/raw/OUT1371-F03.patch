diff --git a/tests/test_conditional_filters.py b/tests/test_conditional_filters.py
new file mode 100644
index 0000000..c469bf5
--- /dev/null
+++ b/tests/test_conditional_filters.py
@@ -0,0 +1,36 @@
+import os
+import pytest
+from outlines import prompt, Prompt
+import jinja2
+
+def test_conditional_filters_debug():
+    os.environ["OUTLINES_DEBUG"] = "true"
+    @prompt(conditional_filters={"debug": {"my_filter": lambda x: x.upper()}, "production": {"my_filter": lambda x: x.lower()}})
+    def my_prompt(name):
+        """Hello {{ name | my_filter }}"""
+    
+    assert my_prompt(name="world") == "Hello WORLD"
+
+def test_conditional_filters_production():
+    os.environ["OUTLINES_DEBUG"] = "false"
+    os.environ["ENVIRONMENT"] = "production"
+    p = Prompt.from_str("Hello {{ name | my_filter }}", conditional_filters={"debug": {"my_filter": lambda x: x.upper()}, "production": {"my_filter": lambda x: x.lower()}})
+    assert p(name="WORLD") == "Hello world"
+
+def test_conditional_filters_priority():
+    os.environ["OUTLINES_DEBUG"] = "true"
+    os.environ["ENVIRONMENT"] = "production"
+    p = Prompt.from_str("Hello {{ name | my_filter }}", conditional_filters={"debug": {"my_filter": lambda x: x.upper()}, "production": {"my_filter": lambda x: x.lower()}})
+    assert p(name="world") == "Hello WORLD"
+
+def test_conditional_filters_alphabetical():
+    os.environ["OUTLINES_DEBUG"] = "false"
+    os.environ["ENVIRONMENT"] = "none"
+    p = Prompt.from_str("Hello {{ name | my_filter }}", conditional_filters={"a": {"my_filter": lambda x: "a"}, "b": {"my_filter": lambda x: "b"}})
+    assert p(name="world") == "Hello a"
+
+def test_conditional_filters_error():
+    os.environ["OUTLINES_DEBUG"] = "true"
+    with pytest.raises(jinja2.exceptions.TemplateAssertionError):
+        Prompt.from_str("Hello {{ name | prod_filter }}", conditional_filters={"debug": {"debug_filter": lambda x: "debug"}, "production": {"prod_filter": lambda x: "prod"}})
+
