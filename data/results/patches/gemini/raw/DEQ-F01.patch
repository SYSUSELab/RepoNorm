+import ipaddress
+from dirty_equals import IsIP
+
+# Test basic functionality
+assert '192.168.1.1' == IsIP()
+assert '2001:db8::1' == IsIP()
+assert 0x7f000001 == IsIP() # 127.0.0.1
+
+# Test version
+assert '192.168.1.1' == IsIP(4)
+assert '2001:db8::1' == IsIP(6)
+assert '192.168.1.1' != IsIP(6)
+assert '2001:db8::1' != IsIP(4)
+
+# Test netmask
+assert '192.168.1.0/24' == IsIP(4, netmask='255.255.255.0')
+assert '192.168.1.0/24' == IsIP(4, netmask=0xffffff00)
+assert '192.168.1.0/25' != IsIP(4, netmask='255.255.255.0')
+
+# Test within
+assert '192.168.1.5' == IsIP(within='192.168.1.0/24')
+assert '192.168.1.5' != IsIP(within='192.168.2.0/24')
+assert '192.168.1.0/25' == IsIP(within='192.168.1.0/24')
+assert '192.168.1.0/24' != IsIP(within='192.168.1.0/25')
+
+# Test repr
+assert repr(IsIP()) == 'IsIP()'
+assert 'version=4' in repr(IsIP(4))
+
+print("All tests passed!")
