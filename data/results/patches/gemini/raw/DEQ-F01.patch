diff --git a/dirty_equals/_ip.py b/dirty_equals/_ip.py
new file mode 100644
index 0000000..54e7a60
--- /dev/null
+++ b/dirty_equals/_ip.py
@@ -0,0 +1,116 @@
+import ipaddress
+from typing import Any, Optional, Union, Tuple, List
+from ._base import DirtyEquals
+
+class IsIP(DirtyEquals[Union[ipaddress.IPv4Address, ipaddress.IPv6Address, ipaddress.IPv4Network, ipaddress.IPv6Network]]):
+    def __init__(self, version: Optional[int] = None, *, netmask: Any = None, within: Any = None):
+        self.version = version
+        self.netmask = netmask
+        self.within = within
+        
+        if self.netmask is not None and self.version is None:
+            raise TypeError('To check the netmask you must specify the IP version')
+            
+        # Validate within configuration
+        self.within_networks = []
+        if self.within is not None:
+            if isinstance(self.within, (str, ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                networks = [self.within]
+            elif isinstance(self.within, (list, tuple)):
+                networks = list(self.within)
+            else:
+                raise ValueError('within must be a string, network object, or list/tuple of these')
+            
+            if not networks:
+                raise ValueError('within cannot be empty')
+                
+            for net in networks:
+                if isinstance(net, str):
+                    try:
+                        net_obj = ipaddress.ip_network(net, strict=True)
+                    except ValueError:
+                        raise ValueError(f'Invalid network: {net}')
+                elif isinstance(net, (ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                    net_obj = net
+                else:
+                    raise ValueError(f'Invalid network type: {type(net)}')
+                self.within_networks.append(net_obj)
+        
+        super().__init__(version=version, netmask=netmask, within=within)
+
+    def equals(self, other: Any) -> bool:
+        # Try to parse as address or network
+        try:
+            if isinstance(other, (int)):
+                if 0 <= other < 2**32:
+                    val = ipaddress.IPv4Address(other)
+                elif 2**32 <= other < 2**128:
+                    val = ipaddress.IPv6Address(other)
+                else:
+                    return False
+            elif isinstance(other, (ipaddress.IPv4Address, ipaddress.IPv6Address, 
+                                    ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                val = other
+            elif isinstance(other, (str, bytes)):
+                try:
+                    val = ipaddress.ip_network(other, strict=False)
+                except ValueError:
+                    val = ipaddress.ip_address(other)
+            else:
+                return False
+        except (ValueError, TypeError):
+            return False
+            
+        # Check version
+        if self.version is not None:
+            if val.version != self.version:
+                return False
+                
+        # Check netmask
+        if self.netmask is not None:
+            if not isinstance(val, (ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                return False
+            
+            # Handle netmask
+            if isinstance(self.netmask, int):
+                mask = self.netmask
+            else:
+                # Try to parse as address
+                try:
+                    mask = int(ipaddress.ip_address(self.netmask))
+                except ValueError:
+                    return False
+            
+            if int(val.netmask) != mask:
+                return False
+                
+        # Check within
+        if self.within_networks:
+            # If it's an address, check if it's in any network
+            # If it's a network, check if it's wholly contained
+            for net in self.within_networks:
+                if net.version != val.version:
+                    continue
+                
+                if isinstance(val, (ipaddress.IPv4Address, ipaddress.IPv6Address)):
+                    if val in net:
+                        return True
+                elif isinstance(val, (ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                    if val.subnet_of(net):
+                        return True
+            return False
+            
+        return True
+
+    def __repr__(self) -> str:
+        args = []
+        if self.version:
+            args.append(f'version={self.version}')
+        if self.netmask:
+            args.append(f'netmask={self.netmask!r}')
+        if self.within:
+            args.append(f'within={self.within!r}')
+        
+        if not args:
+            return 'IsIP()'
+        return f'IsIP({", ".join(args)})'
