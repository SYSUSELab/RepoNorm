+import ipaddress
+from dirty_equals import IsIP
+
+# Test basic functionality
+assert '192.168.1.1' == IsIP()
+assert '2001:db8::1' == IsIP()
+assert 0x7f000001 == IsIP() # 127.0.0.1
+
+# Test version
+assert '192.168.1.1' == IsIP(4)
+assert '2001:db8::1' == IsIP(6)
+assert '192.168.1.1' != IsIP(6)
+assert '2001:db8::1' != IsIP(4)
+
+# Test netmask
+assert '192.168.1.0/24' == IsIP(4, netmask='255.255.255.0')
+try:
+    IsIP(netmask='255.255.255.0')
+except TypeError as e:
+    print(f"Caught expected error: {e}")
+else:
+    print("Failed to catch expected error for netmask without version")
+
+# Test within
+# This will fail until implemented
+try:
+    assert '192.168.1.5' == IsIP(within='192.168.1.0/24')
+except Exception as e:
+    print(f"Caught expected error for within: {e}")
+
+print("Tests finished")
diff --git a/test_isip_edge_cases.py b/test_isip_edge_cases.py
new file mode 100644
index 0000000..c3ad924
--- /dev/null
+++ b/test_isip_edge_cases.py
@@ -0,0 +1,40 @@
+import ipaddress
+import pytest
+from dirty_equals import IsIP
+
+def test_invalid_values():
+    assert 'not-an-ip' != IsIP()
+    assert 1234567890123456789012345678901234567890 != IsIP() # Too large for IPv6
+
+def test_within_configuration():
+    # Invalid within
+    try:
+        IsIP(within='not-a-network')
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("Should have raised ValueError for invalid within")
+
+    # Empty within
+    try:
+        IsIP(within=[])
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("Should have raised ValueError for empty within")
+
+def test_netmask_without_version():
+    try:
+        IsIP(netmask='255.255.255.0')
+    except TypeError as e:
+        assert str(e) == 'To check the netmask you must specify the IP version'
+    else:
+        raise AssertionError("Should have raised TypeError")
+
+def test_within_version_mismatch():
+    # IPv4 address in IPv6 network
+    assert '192.168.1.1' != IsIP(within='2001:db8::/32')
+    # IPv6 address in IPv4 network
+    assert '2001:db8::1' != IsIP(within='192.168.1.0/24')
+
+print("Edge case tests passed!")
