+    assert not re.fullmatch(pattern, "{12345678-1234-1234-1234-1234567890a}") # Too short
+    assert not re.fullmatch(pattern, "{12345678-1234-1234-1234-1234567890abc}") # Too long
+    assert not re.fullmatch(pattern, " {12345678-1234-1234-1234-1234567890ab}") # Whitespace
+    assert not re.fullmatch(pattern, "(12345678-1234-1234-1234-1234567890ab)") # Parentheses
