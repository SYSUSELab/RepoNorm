diff --git a/test_guid.py b/test_guid.py
new file mode 100644
index 0000000..1322671
--- /dev/null
+++ b/test_guid.py
@@ -0,0 +1,33 @@
+import re
+from outlines.types import Regex
+
+# The requirement:
+# - opening brace
+# - five hyphen-separated ASCII hexadecimal segments of lengths 8-4-4-4-12
+# - closing brace
+# - Hex letters may be upper- or lowercase.
+# - Both braces are required.
+
+# Regex pattern:
+# \{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}
+
+guid_pattern = r"\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}"
+
+def test_guid():
+    valid_guid = "{12345678-1234-1234-1234-1234567890ab}"
+    valid_guid_upper = "{12345678-1234-1234-1234-1234567890AB}"
+    
+    assert re.fullmatch(guid_pattern, valid_guid)
+    assert re.fullmatch(guid_pattern, valid_guid_upper)
+    
+    # Invalid cases
+    assert not re.fullmatch(guid_pattern, "12345678-1234-1234-1234-1234567890ab") # No braces
+    assert not re.fullmatch(guid_pattern, "{12345678-1234-1234-1234-1234567890a}") # Too short
+    assert not re.fullmatch(guid_pattern, "{12345678-1234-1234-1234-1234567890abc}") # Too long
+    assert not re.fullmatch(guid_pattern, " {12345678-1234-1234-1234-1234567890ab}") # Whitespace
+    assert not re.fullmatch(guid_pattern, "(12345678-1234-1234-1234-1234567890ab)") # Parentheses
+    
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_guid()
