+        new_lines.append('                node = nodes.Call(ngettext, [nodes.Const(singular), nodes.Const(plural), plural_expr, priority], [], None, None)\n')
+        new_lines.append('            else:\n')
+        new_lines.append('                node = nodes.Call(ngettext, [nodes.Const(singular), nodes.Const(plural), plural_expr], [], None, None)\n')
+        # Skip the original node assignment
+        i += 1
+        # Skip the next few lines that are part of the original node assignment
+        while i < len(lines) and 'nodes.Call(' in lines[i] or ']' in lines[i] or 'None,' in lines[i]:
