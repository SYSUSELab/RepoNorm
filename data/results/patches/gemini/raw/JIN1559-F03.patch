+        new_lines.append(line)
+        new_lines.append('            if priority is not None:\n')
+        new_lines.append('                gettext = nodes.Name("priority_gettext", "load")\n')
+        new_lines.append('                node = nodes.Call(gettext, [nodes.Const(singular), priority], [], None, None)\n')
+        new_lines.append('            else:\n')
+        new_lines.append('                node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)\n')
