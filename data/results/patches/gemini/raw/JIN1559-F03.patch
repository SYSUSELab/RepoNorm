@@ -0,0 +1,22 @@
+import re
+
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# The pattern to match the duplicated blocks
+# It seems like the block is:
+#        if priority is not None:
+#            priority = nodes.Call(nodes.Name("int", "load"), [priority], [], None, None)
+#            priority = nodes.Call(nodes.Name("min", "load"), [priority, nodes.Const(9)], [], None, None)
+#            priority = nodes.Call(nodes.Name("max", "load"), [priority, nodes.Const(0)], [], None, None)
+#
+# Repeated multiple times.
+
+# Let's use a regex to replace all occurrences with a single one.
+pattern = r'(        if priority is not None:.*?nodes\.Const\(0\)], [], None, None\)\n\n)+'
+replacement = r'        if priority is not None:\n            priority = nodes.Call(nodes.Name("int", "load"), [priority], [], None, None)\n            priority = nodes.Call(nodes.Name("min", "load"), [priority, nodes.Const(9)], [], None, None)\n            priority = nodes.Call(nodes.Name("max", "load"), [priority, nodes.Const(0)], [], None, None)\n\n'
+
+new_content = re.sub(pattern, replacement, content, flags=re.DOTALL)
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(new_content)
