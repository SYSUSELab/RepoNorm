+        i += 8 # Skip the old signature
+    elif 'self.environment.globals.update(' in lines[i]:
+        new_lines.append('        self.environment.globals.update(\n')
+        new_lines.append('            gettext=gettext, ngettext=ngettext, pgettext=pgettext, npgettext=npgettext,\n')
+        new_lines.append('            priority_gettext=priority_gettext, priority_ngettext=priority_ngettext\n')
+        new_lines.append('        )\n')
+        i += 2 # Skip the old update
+    elif 'def _uninstall(self, translations: "_SupportedTranslations") -> None:' in lines[i]:
+        new_lines.append(lines[i])
+        new_lines.append('        for key in ("gettext", "ngettext", "pgettext", "npgettext", "priority_gettext", "priority_ngettext"):\n')
+        i += 2 # Skip the old loop
+    else:
+        new_lines.append(lines[i])
+    i += 1
+
+with open('src/jinja2/ext.py', 'w') as f:
+    f.writelines(new_lines)
