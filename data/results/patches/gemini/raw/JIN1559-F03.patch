index 0000000..7e80dc6
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,26 @@
+from jinja2 import Environment, DictLoader
+from jinja2.ext import InternationalizationExtension
+
+# Define a simple translation function that supports priority
+def priority_gettext(message, level):
+    print(f"priority_gettext called with: {message}, {level}")
+    if level == 1:
+        return f"translated_{message}"
+    return message
+
+# Create an environment with the I18n extension
+env = Environment(extensions=[InternationalizationExtension])
+
+# Install the priority gettext callable
+env.install_gettext_callables(
+    gettext=lambda x: x,
+    ngettext=lambda s, p, n: s if n == 1 else p,
+    priority_gettext=priority_gettext,
+)
+
+# Define a template that uses the priority parameter
+template_str = "{% trans priority=1 %}hello{% endtrans %}"
+template = env.from_string(template_str)
+
+# Render the template
+print(template.render())
