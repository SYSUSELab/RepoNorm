+        new_lines.append('        self,\n')
+        new_lines.append('        gettext: t.Callable[[str], str],\n')
+        new_lines.append('        ngettext: t.Callable[[str, str, int], str],\n')
+        new_lines.append('        newstyle: t.Optional[bool] = None,\n')
+        new_lines.append('        pgettext: t.Optional[t.Callable[[str, str], str]] = None,\n')
+        new_lines.append('        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,\n')
