@@ -0,0 +1,34 @@
+import tiktoken
+
+def test_bpe_positions():
+    # We need to see how byte_pair_encode works and if we can map it back to positions
+    # The BPE encoding happens on the pieces returned by the regex.
+    # If a piece is split into multiple tokens, we need to know the positions of those tokens.
+    
+    # The requirement says:
+    # "positions are zero-based Python character indices in each original document, not byte indices."
+    # "If a token starts inside a multibyte character, use the index of that containing character; repeated positions are valid."
+    # "Special tokens start at their literal text's starting character."
+    
+    # Let's test with a multibyte character
+    text = "héllo"
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # The regex splits "héllo"
+    # Let's see the pieces
+    # The pattern for cl100k_base is:
+    # r"""(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}{1,3}| ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+"""
+    
+    # Actually, let's just use the encoding to see the tokens
+    tokens = enc.encode(text)
+    print(f"Tokens: {tokens}")
+    
+    # Now we need to map these tokens back to positions.
+    # The tokens are:
+    # h, é, l, l, o (maybe?)
+    
+    # Let's see the byte values
+    for token in tokens:
+        print(f"Token: {token}, Bytes: {enc.decode_bytes([token])}")
+
+test_bpe_positions()
