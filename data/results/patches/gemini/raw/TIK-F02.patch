+    #[pyo3(signature = (text, allowed_special=HashSet::new(), return_positions=false))]
+    fn py_encode(
+        &self,
+        py: Python,
+        text: &str,
+        allowed_special: HashSet<PyBackedStr>,
+        return_positions: bool,
+    ) -> Py<PyAny> {
+        py.allow_threads(|| {
+            let allowed_special: HashSet<&str> =
+                allowed_special.iter().map(|s| s.as_ref()).collect();
+            if return_positions {
+                let (tokens, positions, _) = self.encode_with_positions(text, &allowed_special);
+                (tokens, positions).into_py(py)
+            } else {
+                let (tokens, _) = self.encode(text, &allowed_special);
+                tokens.into_py(py)
+            }
+        })
+    }
