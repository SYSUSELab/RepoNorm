+    pub fn encode_with_positions(&self, text: &str, allowed_special: &HashSet<&str>) -> (Vec<Rank>, Vec<usize>, usize) {
+        let special_regex = self._get_tl_special_regex();
+        let regex = self._get_tl_regex();
+        let mut ret = vec![];
+        let mut positions = vec![];
+        let byte_to_char = get_byte_to_char_map(text);
+
+        let mut start = 0;
+        let mut last_piece_token_len = 0;
+        loop {
+            let mut next_special;
+            let mut start_find = start;
+            loop {
+                next_special = special_regex.find_from_pos(text, start_find).unwrap();
+                match next_special {
+                    Some(m) => {
+                        if allowed_special.contains(&text[m.start()..m.end()]) {
+                            break;
+                        }
+                        start_find = m.start() + 1;
+                    }
+                    None => break,
+                }
+            }
+            let end = next_special.map_or(text.len(), |m| m.start());
+
+            let mut current_byte_pos = start;
+            for mat in regex.find_iter(&text[start..end]) {
+                let m = mat.unwrap();
+                let piece = m.as_str().as_bytes();
+                
+                // The piece starts at m.start() + start
+                // Wait, regex.find_iter is on &text[start..end].
+                // So m.start() is relative to `start`.
+                // The absolute start is `start + m.start()`.
+                
+                let piece_start = start + m.start();
+                
+                if let Some(token) = self.encoder.get(piece) {
+                    last_piece_token_len = 1;
+                    ret.push(*token);
+                    positions.push(byte_to_char[piece_start]);
+                    continue;
+                }
+                let tokens = byte_pair_encode(piece, &self.encoder);
+                last_piece_token_len = tokens.len();
+                
+                let mut piece_byte_pos = piece_start;
+                for token in &tokens {
+                    positions.push(byte_to_char[piece_byte_pos]);
+                    let token_bytes = &self.decoder[token];
+                    piece_byte_pos += token_bytes.len();
+                }
+                ret.extend(&tokens);
+            }
+
+            match next_special {
+                Some(m) => {
+                    let piece = m.as_str();
+                    let token = self.special_tokens_encoder[piece];
+                    ret.push(token);
+                    positions.push(byte_to_char[m.start()]);
+                    start = m.end();
+                    last_piece_token_len = 0;
+                }
+                None => break,
+            }
+        }
+        (ret, positions, last_piece_token_len)
+    }
