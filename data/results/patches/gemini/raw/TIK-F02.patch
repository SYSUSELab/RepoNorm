+import tiktoken
+
+def test_special_tokens():
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello<|endoftext|>world"
+    
+    # The regex splits this into:
+    # "hello", "<|endoftext|>", "world"
+    
+    # Let's see the tokens
+    tokens = enc.encode(text, allowed_special={"<|endoftext|>"})
+    print(f"Tokens: {tokens}")
+    
+    # The special token <|endoftext|> is 100257
+    # "hello" -> [31373]
+    # "<|endoftext|>" -> [100257]
+    # "world" -> [995]
+    
+    # Positions:
+    # "hello" -> 0
+    # "<|endoftext|>" -> 5
+    # "world" -> 17
+    
+    # Let's check the character indices:
+    # h: 0, e: 1, l: 2, l: 3, o: 4
+    # <: 5, |: 6, e: 7, n: 8, d: 9, o: 10, f: 11, t: 12, e: 13, x: 14, t: 15, |: 16
+    # w: 17, o: 18, r: 19, l: 20, d: 21
+    
+    # So the special token starts at index 5.
+    # This matches!
+    
+test_special_tokens()
