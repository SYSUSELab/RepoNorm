diff --git a/test_positions_logic_26.py b/test_positions_logic_26.py
new file mode 100644
index 0000000..8e73fd0
--- /dev/null
+++ b/test_positions_logic_26.py
@@ -0,0 +1,57 @@
+def get_byte_to_char_map(text):
+    byte_to_char = []
+    for i, char in enumerate(text):
+        char_bytes = char.encode('utf-8')
+        for _ in range(len(char_bytes)):
+            byte_to_char.append(i)
+    return byte_to_char
+
+def get_positions(text, tokens, encoder):
+    byte_to_char = get_byte_to_char_map(text)
+    positions = []
+    current_byte_pos = 0
+    
+    # This is tricky because we need to know the byte length of each token.
+    # The tokens are just IDs. We need to map them back to bytes.
+    # The `CoreBPE` struct has a `decoder` map.
+    
+    # Let's simulate the tokenization process.
+    # The regex splits the text into pieces.
+    # Each piece is then BPE encoded.
+    
+    # This is getting complicated. Let's simplify.
+    # The requirement says:
+    # "positions are zero-based Python character indices in each original document, not byte indices."
+    # "If a token starts inside a multibyte character, use the index of that containing character"
+    
+    # So if we have a token that corresponds to bytes [b1, b2, b3],
+    # and these bytes start at byte index `b_idx` in the original text,
+    # the position is `byte_to_char[b_idx]`.
+    
+    # We need to track the current byte index as we tokenize.
+    
+    return positions
+
+# Let's test this logic with a simple example.
+text = "héllo"
+# h: 0, é: 1, l: 2, l: 3, o: 4
+# bytes: h(0), é(1,2), l(3), l(4), o(5)
