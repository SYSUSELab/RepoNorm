@@ -0,0 +1,116 @@
+from typing import Any
+import re
+from dirty_equals import IsStr
+
+class IsPhoneNumber(IsStr):
+    def __init__(self, country: str = None):
+        self.country = country.upper() if country else None
+        super().__init__()
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        # 1. Syntax check
+        # Only ASCII digits, spaces/tabs, dashes, dots and balanced, non-nested parentheses containing digits are accepted
+        # at most one plus is allowed, at the start of the input.
+        # Newlines and other characters are invalid.
+        
+        # Check for invalid characters
+        if re.search(r'[^0-9 \t\-\.\(\)\+]', other):
+            return False
+        
+        # Check for plus at start
+        if other.count('+') > 1 or (other.count('+') == 1 and not other.startswith('+')):
+            return False
+        
+        # Check for balanced, non-nested parentheses
+        # Regex for non-nested parentheses:
+        # It should not contain `(` inside `(...)`
+        # So, `\([^()]*\)` is okay, but `\([^()]*\([^()]*\).*\)` is not.
+        # Actually, `\([^()]*\)` is the only allowed form.
+        # Let's check if there are any `(` that are not followed by `)` without another `(` in between.
+        
+        # A simpler way:
+        # 1. Find all `(` and `)`
+        # 2. Check if they are balanced and non-nested
+        
+        # Let's use a regex to find all `(` and `)`
+        parens = re.findall(r'[\(\)]', other)
+        
+        # Check if balanced
+        if len(parens) % 2 != 0:
+            return False
+        
+        # Check if non-nested
+        # If we have `(`, the next paren must be `)`
+        # If we have `)`, the previous paren must be `(`
+        
+        # Let's iterate through the parens
+        for i in range(0, len(parens), 2):
+            if parens[i] != '(' or parens[i+1] != ')':
+                return False
+        
+        # 2. Logic check
+        # Normalize: remove all separators except digits and plus
+        # Wait, the separators are: spaces/tabs, dashes, dots, parentheses
+        
+        # Let's just remove all non-digit characters except the leading plus
+        # Actually, let's just use a regex to extract digits
+        digits = re.sub(r'[^0-9]', '', other)
+        
+        # Check if it's a valid phone number
+        if self.country == 'US':
+            # US: 10-digit national or +1 + 10 digits
+            if other.startswith('+1'):
+                return len(digits) == 11 and digits.startswith('1')
+            else:
+                return len(digits) == 10
+        elif self.country == 'GB':
+            # GB: 10-11 digit national starting with 0 or +44 + 10-11 digits
+            if other.startswith('+44'):
+                return len(digits) == 12 or len(digits) == 13
+            else:
+                # National format starting with 0
+                # The requirement says "GB national strings have 10–11 digits starting with 0"
+                # So we need to check if the first digit is 0
+                # But we stripped all non-digits.
+                # Let's check the original string for the leading 0
+                
+                # Find the first digit in the string
+                match = re.search(r'\d', other)
+                if not match:
+                    return False
+                
+                return (len(digits) == 10 or len(digits) == 11) and other[match.start()] == '0'
+        else:
+            # Generic: + followed by 8-19 digits
+            if other.startswith('+'):
+                return 8 <= len(digits) <= 19
+            else:
+                return 7 <= len(digits) <= 15
+        
+        return True
+
+    def __repr__(self) -> str:
+        if self.country:
+            return f"IsPhoneNumber('{self.country}')"
+        return "IsPhoneNumber(*)"
+
+# Test cases
+assert IsPhoneNumber('US').equals('555-123-4567') == True
+assert IsPhoneNumber('US').equals('+1-555-123-4567') == True
+assert IsPhoneNumber('GB').equals('020 7946 0958') == True
+assert IsPhoneNumber('GB').equals('+44 20 7946 0958') == True
+assert IsPhoneNumber().equals('+1234567890') == True
+assert IsPhoneNumber().equals('1234567') == True
+assert IsPhoneNumber().equals('123456') == False
+assert IsPhoneNumber('US').equals('123456789') == False
+assert IsPhoneNumber('US').equals('12345678901') == False
+assert IsPhoneNumber('GB').equals('1234567890') == False
+assert IsPhoneNumber('GB').equals('0123456789') == True
+assert IsPhoneNumber('GB').equals('01234567890') == True
+assert IsPhoneNumber('GB').equals('012345678901') == False
+assert IsPhoneNumber('US').equals('(555) 123-4567') == True
+assert IsPhoneNumber('US').equals('((555) 123-4567)') == False
+print("All tests passed!")
