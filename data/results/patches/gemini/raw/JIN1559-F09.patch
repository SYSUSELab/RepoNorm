+    def extract_marked_translations(self, source, source_name=None):
+        """Extract marked translations from a template source."""
+        if isinstance(source, str):
+            source = self.parse(source, source_name)
+        
+        for node in source.find_all(nodes.CallBlock):
+            if isinstance(node.call, nodes.Call) and isinstance(node.call.node, nodes.Name) and node.call.node.name == "_dummy":
+                metadata = {}
+                if node.call.args:
+                    metadata_node = node.call.args[0]
+                    if isinstance(metadata_node, nodes.Dict):
+                        for item in metadata_node.items:
+                            if isinstance(item, nodes.Pair) and isinstance(item.key, nodes.Const):
+                                metadata[item.key.value] = item.value.value
+                
+                messages = list(extract_from_ast(node.body))
+                
+                yield {
+                    "source": source_name,
+                    "lineno": node.lineno,
+                    "metadata": metadata,
+                    "messages": messages,
+                }
+
+    def extract_marked_translations_from_templates(self, names=None):
+        """Extract marked translations from templates supplied by the configured loader."""
+        if names is None:
+            names = self.list_templates()
+        
+        for name in names:
+            source, filename, _ = self.loader.get_source(self, name)
+            yield from self.extract_marked_translations(source, name)
diff --git a/ext_new.py b/ext_new.py
new file mode 100644
index 0000000..0a316fe
--- /dev/null
+++ b/ext_new.py
@@ -0,0 +1,30 @@
+import typing as t
+from jinja2 import nodes
+from jinja2.ext import Extension
+from jinja2.nodes import CallBlock, Const, Dict, Pair
+
+class TranslationExtractorExtension(Extension):
+    tags = {"extract"}
+
+    def parse(self, parser):
+        lineno = next(parser.stream).lineno
+        
+        # Parse metadata: key=constant, ...
+        metadata = []
+        while parser.stream.current.type != "block_end":
+            if metadata:
+                parser.stream.expect("comma")
+            
+            key = parser.stream.expect("name").value
+            parser.stream.expect("assign")
+            value = parser.parse_expression()
+            # In a real implementation, we'd check if value is a constant
+            metadata.append(Pair(Const(key), value))
+            
+        # Parse body until {% endextract %}
+        body = parser.parse_statements(["name:endextract"], drop_needle=True)
+        
+        return CallBlock(self.call_method("_dummy", [Dict(metadata)]), [], [], body).set_lineno(lineno)
+
+    def _dummy(self, metadata):
+        return ""
