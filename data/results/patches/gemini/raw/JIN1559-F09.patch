+from jinja2 import Environment
+from jinja2.ext import Extension
+from jinja2.nodes import CallBlock, Node
+import typing as t
+
+class ExtractExtension(Extension):
+    tags = {"extract"}
+    
+    def parse(self, parser):
+        lineno = next(parser.stream).lineno
+        
+        # Parse metadata: key=constant, ...
+        metadata = {}
+        while parser.stream.current.type != "block_end":
+            if metadata:
+                parser.stream.expect("comma")
+            
+            key = parser.stream.expect("name").value
+            parser.stream.expect("assign")
+            value = parser.parse_expression()
+            # In a real implementation, we'd check if value is a constant
+            metadata[key] = value
+            
+        parser.stream.expect("block_end")
+        
+        # Parse body until {% endextract %}
+        body = parser.parse_statements(["name:endextract"], drop_needle=True)
+        
+        return CallBlock(self.call_method("_dummy"), [], [], body).set_lineno(lineno)
+
+    def _dummy(self):
+        return ""
+
+env = Environment(extensions=[ExtractExtension])
+try:
+    env.parse('{% extract key="value" %}hello{% endextract %}')
+    print("Parsed successfully")
+except Exception as e:
+    print(e)
