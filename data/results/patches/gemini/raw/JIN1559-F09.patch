+from jinja2 import Environment
+from jinja2.ext import Extension
+from jinja2.nodes import CallBlock
+
+class TestExtension(Extension):
+    tags = {"extract"}
+    def parse(self, parser):
+        lineno = next(parser.stream).lineno
+        # Consume the block_end of the extract tag
+        parser.stream.expect("block_end")
+        
+        # Parse the body until `endextract`.
+        # The `parse_statements` function expects a list of end tokens.
+        # The end token for `endextract` is `name:endextract`.
+        # But `parse_statements` will look for `{% endextract %}`.
+        # So the end token should be `name:endextract`.
+        
+        # The issue is that `parse_statements` expects the end token to be a block.
+        # Let's try to parse the body manually.
+        
+        body = []
+        while parser.stream.current.type != "eof":
+            if parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:endextract"):
+                    next(parser.stream)
+                    parser.stream.expect("block_end")
+                    break
+                else:
+                    # It's not endextract, so it's a control structure.
+                    # We should parse it as a statement.
+                    # But wait, the `trans` tag doesn't allow control structures.
+                    # The task says: "Marker bodies are ordinary Jinja bodies and render unchanged. They may contain control structures and any gettext calls supported by normal extraction."
+                    # So I should allow control structures.
+                    # This means I should use `parser.parse_statements` but with a different end token.
+                    # Let's try to use `parser.parse_statements(["name:endextract"], drop_needle=True)`
+                    # and see what happens.
+                    pass
+            
+            # Let's try to use `parser.parse_statements` but I need to handle the block_begin.
+            # Actually, `parser.parse_statements` handles block_begin.
+            # Let's try to use `parser.parse_statements(["name:endextract"], drop_needle=True)`
+            # and see what happens.
+            # Maybe the issue is that I'm not consuming the block_begin of the endextract tag?
+            # Let's try to consume the block_begin.
+            pass
+        
+        return CallBlock(self.call_method("_dummy"), [], [], body).set_lineno(lineno)
+
+    def _dummy(self):
+        return ""
+
+env = Environment(extensions=[TestExtension])
+# The issue might be that `parse_statements` expects the end token to be a block.
+# Let's try to parse the template.
