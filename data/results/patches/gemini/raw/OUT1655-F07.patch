@@ -0,0 +1,16 @@
+import pytest
+from outlines.types import credit_card
+
+def test_credit_card_regex():
+    pattern = credit_card.pattern
+    import re
+    regex = re.compile(pattern)
+    
+    assert regex.fullmatch("1234567812345678")
+    assert regex.fullmatch("1234-5678-1234-5678")
+    assert regex.fullmatch("1234 5678 1234 5678")
+    
+    assert not regex.fullmatch("1234-5678 1234-5678")
+    assert not regex.fullmatch("123-4567-8901-2345")
+    assert not regex.fullmatch("123456781234567")
+    assert not regex.fullmatch("12345678123456789")
