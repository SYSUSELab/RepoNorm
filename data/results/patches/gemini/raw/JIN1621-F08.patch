index 0000000..b40815e
--- /dev/null
+++ b/tests/test_loader_filters.py
@@ -0,0 +1,53 @@
+import pytest
+import re
+from jinja2 import FileSystemLoader, ChoiceLoader, PrefixLoader
+
+def test_loader_filters():
+    loader = FileSystemLoader("tests/res/templates")
+    
+    # Initial
+    templates = loader.list_templates()
+    assert "test.html" in templates
+    assert "foo/test.html" in templates
+    
+    # Add filter
+    loader.add_filter("foo/*")
+    assert "foo/test.html" not in loader.list_templates()
+    assert "test.html" in loader.list_templates()
+    
+    # Clear
+    loader.clear_filters()
+    assert "foo/test.html" in loader.list_templates()
+    
+    # Regex
+    loader.add_filter(re.compile(r"test\.html$"))
+    assert "test.html" not in loader.list_templates()
+    assert "foo/test.html" not in loader.list_templates()
+    
+    # Scope
+    loader.clear_filters()
+    with loader.filter_scope("test.html"):
+        assert "test.html" not in loader.list_templates()
+        assert "foo/test.html" in loader.list_templates()
+    assert "test.html" in loader.list_templates()
+
+def test_choice_loader_filters():
+    loader = ChoiceLoader([
+        FileSystemLoader("tests/res/templates"),
+        FileSystemLoader("tests/res/templates2")
+    ])
+    
+    loader.add_filter("foo/*")
+    templates = loader.list_templates()
+    assert "foo/test.html" not in templates
+    
+def test_prefix_loader_filters():
+    loader = PrefixLoader({
+        "a": FileSystemLoader("tests/res/templates"),
+        "b": FileSystemLoader("tests/res/templates2")
+    })
+    
+    loader.add_filter("a/*")
+    templates = loader.list_templates()
+    assert "a/test.html" not in templates
+    assert "b/foo" in templates
