+import re
+import fnmatch
+from contextlib import contextmanager
+
+# I will replace the methods I added with these:
+
+def _get_filters(self):
+    if not hasattr(self, "_filters"):
+        self._filters = []
+    return self._filters
+
+def add_filter(self, filter_pattern: t.Any) -> None:
+    self._get_filters().append(filter_pattern)
+
+def clear_filters(self) -> None:
+    self._get_filters().clear()
+
+@contextmanager
+def filter_scope(self, *patterns: t.Any) -> t.Iterator[None]:
+    old_filters = list(self._get_filters())
+    for p in patterns:
+        self.add_filter(p)
+    try:
+        yield
+    finally:
+        self._filters = old_filters
+
+def _is_filtered(self, template: str) -> bool:
+    for filter_pattern in self._get_filters():
+        if isinstance(filter_pattern, str):
+            if fnmatch.fnmatch(template, filter_pattern):
+                return True
+        elif isinstance(filter_pattern, re.Pattern):
+            if filter_pattern.search(template):
+                return True
+        elif callable(filter_pattern):
+            if filter_pattern(template):
+                return True
+        else:
+            raise TypeError(f"Unsupported filter type: {type(filter_pattern)}")
+    return False
