@@ -0,0 +1,44 @@
+import os
+import pytest
+from jinja2 import FileSystemLoader
+
+def test_filesystem_loader_priority():
+    # Create some dummy directories
+    os.makedirs("dir1", exist_ok=True)
+    os.makedirs("dir2", exist_ok=True)
+    os.makedirs("dir3", exist_ok=True)
+    os.makedirs("dir4", exist_ok=True)
+    
+    # Test case: (path, priority)
+    # Input: [("dir1", 1), ("dir2", 2), "dir3", ("dir4", 0)]
+    # Expected: ['dir2', 'dir1', 'dir3', 'dir4']
+    
+    loader = FileSystemLoader([("dir1", 1), ("dir2", 2), "dir3", ("dir4", 0)])
+    assert loader.searchpath == ['dir2', 'dir1', 'dir3', 'dir4']
+
+def test_filesystem_loader_priority_errors():
+    # Test invalid tuple length
+    with pytest.raises(TypeError, match="Tuple must have 2 elements"):
+        FileSystemLoader([("dir1", 1, 2)])
+    
+    # Test non-integer priority
+    with pytest.raises(TypeError, match="Priority must be an integer"):
+        FileSystemLoader([("dir1", "high")])
+        
+    # Test boolean priority
+    with pytest.raises(TypeError, match="Priority must be an integer"):
+        FileSystemLoader([("dir1", True)])
+
+def test_filesystem_loader_priority_stable_sort():
+    # Test stable ordering for same priority
+    # Input: [("dir1", 1), ("dir2", 1)]
+    # Expected: ['dir1', 'dir2']
+    loader = FileSystemLoader([("dir1", 1), ("dir2", 1)])
+    assert loader.searchpath == ['dir1', 'dir2']
+
+def test_filesystem_loader_priority_negative():
+    # Test negative priorities
+    # Input: [("dir1", -1), ("dir2", -2)]
+    # Expected: ['dir1', 'dir2']
+    loader = FileSystemLoader([("dir1", -1), ("dir2", -2)])
+    assert loader.searchpath == ['dir1', 'dir2']
