@@ -0,0 +1,32 @@
+def get_chunks(text, chunk_size, chunk_overlap):
+    if chunk_size is None:
+        if chunk_overlap != 0:
+            raise ValueError("chunk_overlap must be 0 if chunk_size is None")
+        return [text]
+    
+    if not isinstance(chunk_size, int) or isinstance(chunk_size, bool):
+        raise ValueError("chunk_size must be an integer")
+    if not isinstance(chunk_overlap, int) or isinstance(chunk_overlap, bool):
+        raise ValueError("chunk_overlap must be an integer")
+    
+    if chunk_size <= 0:
+        raise ValueError("chunk_size must be positive")
+    if chunk_overlap < 0 or chunk_overlap >= chunk_size:
+        raise ValueError("chunk_overlap must be 0 <= chunk_overlap < chunk_size")
+        
+    if not text:
+        return [[]]
+        
+    chunks = []
+    start = 0
+    while start < len(text):
+        end = start + chunk_size
+        chunks.append(text[start:end])
+        if end >= len(text):
+            break
+        start += chunk_size - chunk_overlap
+    return chunks
+
+print(get_chunks('abcde', 3, 1))
+print(get_chunks('abcde', 3, 0))
+print(get_chunks('', 3, 1))
