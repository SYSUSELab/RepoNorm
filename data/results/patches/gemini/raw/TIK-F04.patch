+import tiktoken
+import pytest
+
+def test_chunking():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test case: 'abcde', size 3, overlap 1
+    assert enc.encode('abcde', chunk_size=3, chunk_overlap=1) == [enc.encode('abc'), enc.encode('cde')]
+    
+    # Test case: empty text
+    assert enc.encode('', chunk_size=3, chunk_overlap=1) == [[]]
+    
+    # Test case: no chunk_size
+    assert enc.encode('abcde') == enc.encode('abcde', chunk_size=None, chunk_overlap=0)
+    
+    # Test case: invalid chunk_size
+    with pytest.raises(ValueError):
+        enc.encode('abcde', chunk_size='3')
+    with pytest.raises(ValueError):
+        enc.encode('abcde', chunk_size=0)
+        
+    # Test case: invalid chunk_overlap
+    with pytest.raises(ValueError):
+        enc.encode('abcde', chunk_size=3, chunk_overlap=3)
+    with pytest.raises(ValueError):
+        enc.encode('abcde', chunk_size=3, chunk_overlap=-1)
+    with pytest.raises(ValueError):
+        enc.encode('abcde', chunk_size=None, chunk_overlap=1)
+
+    # Test case: chunk_size > len(text)
+    assert enc.encode('abc', chunk_size=5, chunk_overlap=1) == [enc.encode('abc')]
+    
+    # Test case: chunk_size == len(text)
+    assert enc.encode('abc', chunk_size=3, chunk_overlap=1) == [enc.encode('abc')]
+    
+    # Test case: chunk_size == 1, overlap 0
+    assert enc.encode('abc', chunk_size=1, chunk_overlap=0) == [enc.encode('a'), enc.encode('b'), enc.encode('c')]
+
