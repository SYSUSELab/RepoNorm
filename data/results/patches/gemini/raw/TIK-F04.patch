@@ -0,0 +1,46 @@
+import tiktoken
+
+def test_chunking():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test case: 'abcde', size 3, overlap 1
+    # Expected: ['abc', 'cde']
+    # Wait, the prompt says:
+    # "With a positive integer chunk_size, return independently encoded character windows. 
+    # Adjacent windows overlap by chunk_overlap characters"
+    # 'abcde'
+    # Window 1: 'abc' (indices 0, 1, 2)
+    # Window 2: 'cde' (indices 2, 3, 4) - wait, overlap 1 means 'c' is in both.
+    # 'abc' (0,1,2)
+    # 'cde' (2,3,4)
+    # Yes, that makes sense.
+    
+    # The prompt says: "For example 'abcde', size 3, overlap 1 gives ['abc', 'cde']."
+    # Wait, if I encode 'abc' and 'cde' independently, I get two lists of tokens.
+    # The prompt says "return independently encoded character windows."
+    # Does it mean a list of lists of tokens?
+    # "For example 'abcde', size 3, overlap 1 gives ['abc', 'cde']."
+    # Wait, the example says it gives ['abc', 'cde']. That's a list of strings, not tokens.
+    # Let me re-read.
+    # "With a positive integer chunk_size, return independently encoded character windows."
+    # Ah, maybe it means it returns the *encoded* windows, i.e., a list of lists of tokens.
+    # Let's re-read carefully:
+    # "For example 'abcde', size 3, overlap 1 gives ['abc', 'cde']."
+    # This example seems to be describing the *windows* themselves, not the encoded tokens.
+    # "With a positive integer chunk_size, return independently encoded character windows."
+    # Okay, so it should return a list of lists of tokens.
+    
+    # Let's try to implement a test that expects a list of lists of tokens.
+    
+    text = 'abcde'
+    chunk_size = 3
+    chunk_overlap = 1
+    
+    # This should fail because encode doesn't support chunk_size yet.
+    try:
+        result = enc.encode(text, chunk_size=chunk_size, chunk_overlap=chunk_overlap)
+        print(f"Result: {result}")
+    except TypeError as e:
+        print(f"Caught expected error: {e}")
+
+test_chunking()
