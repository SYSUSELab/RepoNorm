@@ -0,0 +1,37 @@
+import tiktoken
+import pytest
+
+def test_edge_cases():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test case: empty text
+    assert enc.encode('', chunk_size=3, chunk_overlap=1) == [[]]
+    
+    # Test case: chunk_size > len(text)
+    # 'abc', size 5, overlap 1
+    # Window 1: 'abc' (0,1,2)
+    # Window 1 covers the end (index 2). So we stop.
+    # Result: ['abc']
+    assert enc.encode('abc', chunk_size=5, chunk_overlap=1) == [enc.encode('abc')]
+    
+    # Test case: chunk_size == len(text)
+    # 'abc', size 3, overlap 1
+    # Window 1: 'abc' (0,1,2)
+    # Window 1 covers the end (index 2). So we stop.
+    # Result: ['abc']
+    assert enc.encode('abc', chunk_size=3, chunk_overlap=1) == [enc.encode('abc')]
+    
+    # Test case: chunk_size == 1, overlap 0
+    # 'abc', size 1, overlap 0
+    # Window 1: 'a'
+    # Window 2: 'b'
+    # Window 3: 'c'
+    assert enc.encode('abc', chunk_size=1, chunk_overlap=0) == [enc.encode('a'), enc.encode('b'), enc.encode('c')]
+    
+    # Test case: chunk_size == 1, overlap 0, but with special tokens?
+    # The prompt says: "Allowed special literals wholly within a window encode normally; if cut by a boundary, each window's text is encoded independently."
+    # This is handled by the fact that we encode each window independently.
+    
+    print("All edge cases passed!")
+
+test_edge_cases()
