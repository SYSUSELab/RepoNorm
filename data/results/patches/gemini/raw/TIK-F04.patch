+import tiktoken
+
+def test_chunking():
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test case: 'abcde', size 3, overlap 1
+    # Expected: ['abc', 'cde']
+    # The encode method should return a list of lists of tokens.
+    # Let's check the tokens for 'abc' and 'cde'.
+    
+    text = 'abcde'
+    chunk_size = 3
+    chunk_overlap = 1
+    
+    result = enc.encode(text, chunk_size=chunk_size, chunk_overlap=chunk_overlap)
+    print(f"Result: {result}")
+    
+    # Verify the result
+    # 'abc' -> [27480] (Wait, let me check what 'abc' encodes to)
+    # 'cde' -> [27482] (Wait, let me check what 'cde' encodes to)
+    
+    print(f"Tokens for 'abc': {enc.encode('abc')}")
+    print(f"Tokens for 'cde': {enc.encode('cde')}")
+    
+    assert result == [enc.encode('abc'), enc.encode('cde')]
+    
+    # Test case: empty text
+    assert enc.encode('', chunk_size=3, chunk_overlap=1) == [[]]
+    
+    # Test case: no chunk_size
+    assert enc.encode('abcde') == enc.encode('abcde', chunk_size=None, chunk_overlap=0)
+    
+    # Test case: invalid chunk_size
+    try:
+        enc.encode('abcde', chunk_size='3')
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+        
+    # Test case: invalid chunk_overlap
+    try:
+        enc.encode('abcde', chunk_size=3, chunk_overlap=3)
+    except ValueError as e:
+        print(f"Caught expected error: {e}")
+
+test_chunking()
