diff --git a/tests/test_filter_tokens.py b/tests/test_filter_tokens.py
new file mode 100644
index 0000000..84d8903
--- /dev/null
+++ b/tests/test_filter_tokens.py
@@ -0,0 +1,47 @@
+import tiktoken
+import numpy as np
+import pytest
+
+def test_filter_tokens():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello world"
+    
+    # Test list filtering
+    tokens = enc.encode(text)
+    filtered_tokens = enc.encode(text, filter_tokens={31373})
+    assert filtered_tokens == [t for t in tokens if t != 31373]
+    
+    # Test numpy filtering
+    tokens_np = enc.encode_to_numpy(text)
+    filtered_tokens_np = enc.encode_to_numpy(text, filter_tokens={31373})
+    assert np.array_equal(filtered_tokens_np, np.array([t for t in tokens if t != 31373], dtype=np.uint32))
+    
+    # Test empty filter
+    filtered_tokens_empty = enc.encode(text, filter_tokens={})
+    assert filtered_tokens_empty == tokens
+    
+    # Test all filtered
+    filtered_tokens_all = enc.encode(text, filter_tokens={31373, 995})
+    assert filtered_tokens_all == []
+    
+    # Test numpy all filtered
+    filtered_tokens_all_np = enc.encode_to_numpy(text, filter_tokens={31373, 995})
+    assert filtered_tokens_all_np.size == 0
+    assert filtered_tokens_all_np.dtype == np.uint32
+
+def test_filter_tokens_unicode():
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello world 🌍"
+    
+    # Test list filtering
+    tokens = enc.encode(text)
+    # Find a token to filter
+    token_to_filter = tokens[0]
+    filtered_tokens = enc.encode(text, filter_tokens={token_to_filter})
+    assert filtered_tokens == [t for t in tokens if t != token_to_filter]
+    
+    # Test numpy filtering
+    tokens_np = enc.encode_to_numpy(text)
+    filtered_tokens_np = enc.encode_to_numpy(text, filter_tokens={token_to_filter})
+    assert np.array_equal(filtered_tokens_np, np.array([t for t in tokens if t != token_to_filter], dtype=np.uint32))
+
