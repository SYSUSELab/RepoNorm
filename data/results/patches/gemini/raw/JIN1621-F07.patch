diff --git a/test_expansion.py b/test_expansion.py
new file mode 100644
index 0000000..a58e126
--- /dev/null
+++ b/test_expansion.py
@@ -0,0 +1,30 @@
+import os
+from jinja2 import FileSystemLoader
+
+# Test with environment variable
+os.environ["JINJA_TEST_VAR"] = "/tmp/test_dir"
+loader = FileSystemLoader("$JINJA_TEST_VAR", expand_searchpath=True)
+print(f"Expanded env var: {loader.searchpath}")
+assert loader.searchpath == ["/tmp/test_dir"]
+
+# Test with user home
+# Note: os.path.expanduser('~') expands to the current user's home directory.
+# We can't easily mock this without changing HOME, but we can test if it's expanded.
+loader = FileSystemLoader("~", expand_searchpath=True)
+print(f"Expanded user home: {loader.searchpath}")
+assert loader.searchpath == [os.path.expanduser("~")]
+
+# Test with list of paths
+os.environ["JINJA_TEST_VAR1"] = "/tmp/dir1"
+os.environ["JINJA_TEST_VAR2"] = "/tmp/dir2"
+loader = FileSystemLoader(["$JINJA_TEST_VAR1", "$JINJA_TEST_VAR2"], expand_searchpath=True)
+print(f"Expanded list: {loader.searchpath}")
+assert loader.searchpath == ["/tmp/dir1", "/tmp/dir2"]
+
+# Test with PathLike
+from pathlib import Path
+loader = FileSystemLoader(Path("$JINJA_TEST_VAR1"), expand_searchpath=True)
+print(f"Expanded PathLike: {loader.searchpath}")
+assert loader.searchpath == ["/tmp/dir1"]
+
+print("All tests passed!")
