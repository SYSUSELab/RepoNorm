+import os
+from jinja2 import FileSystemLoader, Environment
+
+# Set up environment variables for testing
+os.environ["JINJA_TEMPLATE_DIR"] = "/tmp/templates"
+os.makedirs("/tmp/templates", exist_ok=True)
+with open("/tmp/templates/test.txt", "w") as f:
+    f.write("hello world")
+
+# Test case 1: Without expansion (default)
+loader = FileSystemLoader("$JINJA_TEMPLATE_DIR")
+print(f"Search path without expansion: {loader.searchpath}")
+
+# Test case 2: With expansion (should be implemented)
+try:
+    loader = FileSystemLoader("$JINJA_TEMPLATE_DIR", expand_searchpath=True)
+    print(f"Search path with expansion: {loader.searchpath}")
+except TypeError as e:
+    print(f"Caught expected error: {e}")
+
