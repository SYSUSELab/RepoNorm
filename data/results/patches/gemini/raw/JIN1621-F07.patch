diff --git a/modify_loaders.py b/modify_loaders.py
new file mode 100644
index 0000000..f9b3c60
--- /dev/null
+++ b/modify_loaders.py
@@ -0,0 +1,57 @@
+import re
+
+with open("src/jinja2/loaders.py", "r") as f:
+    content = f.read()
+
+# Update docstring
+old_docstring = """:param followlinks: Follow symbolic links in the path.
+
+    .. versionchanged:: 2.8
+        Added the ``followlinks`` parameter."""
+new_docstring = """:param followlinks: Follow symbolic links in the path.
+    :param expand_searchpath: Expand environment variables and user home
+        in the search path.
+
+    .. versionchanged:: 2.8
+        Added the ``followlinks`` parameter."""
+content = content.replace(old_docstring, new_docstring)
+
+# Update __init__ signature
+old_init = """    def __init__(
+        self,
+        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        self.searchpath = [os.fspath(p) for p in searchpath]
+        self.encoding = encoding
+        self.followlinks = followlinks"""
+
+new_init = """    def __init__(
+        self,
+        searchpath: t.Union[str, os.PathLike, t.Sequence[t.Union[str, os.PathLike]]],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+        expand_searchpath: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        self.searchpath = []
+        for path in searchpath:
+            path = os.fspath(path)
+            if expand_searchpath:
+                path = os.path.expandvars(path)
+                path = os.path.expanduser(path)
+            self.searchpath.append(path)
+
+        self.encoding = encoding
+        self.followlinks = followlinks"""
+
+content = content.replace(old_init, new_init)
+
+with open("src/jinja2/loaders.py", "w") as f:
+    f.write(content)
