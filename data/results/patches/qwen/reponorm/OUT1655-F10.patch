diff --git a/tests/types/test_custom_types.py b/tests/types/test_custom_types.py
index 691b681..56f1a4b 100644
--- a/tests/types/test_custom_types.py
+++ b/tests/types/test_custom_types.py
@@ -108,3 +108,55 @@ def test_type_enum(custom_type, test_string, should_match):
 
     does_match = test_string in custom_type.__members__
     assert does_match is should_match
+
+
+@pytest.mark.parametrize(
+    "test_string,should_match",
+    [
+        # Valid SHA-256 hashes (exactly 64 hex characters)
+        ("a" * 64, True),  # all lowercase
+        ("A" * 64, True),  # all uppercase
+        ("0" * 64, True),  # all zeros
+        ("f" * 64, True),  # all f's
+        ("F" * 64, True),  # all F's
+        ("0123456789abcdefABCDEF" * 2 + "0123456789abcdefABCD", True),  # mixed case
+        ("deadbeef" * 8, True),  # repeated pattern
+        ("cafebabedeadbeef" * 4, True),  # another pattern
+        
+        # Invalid: wrong length
+        ("a" * 63, False),  # too short
+        ("a" * 65, False),  # too long
+        ("a" * 60, False),  # significantly shorter
+        ("a" * 100, False),  # significantly longer
+        
+        # Invalid: non-hexadecimal characters
+        ("g" * 64, False),  # contains 'g'
+        ("ghijklmn" * 8, False),  # only invalid chars
+        ("a" * 32 + "g" * 32, False),  # mixed valid/invalid
+        
+        # Invalid: whitespace or separators
+        ("aa bb cc dd ee ff aa bb cc dd ee ff aa bb cc dd ee ff aa bb cc dd ee ff aa bb cc dd ee ff aa bb", False),  # with spaces
+        ("aa-bb-cc-dd-ee-ff-aa-bb-cc-dd-ee-ff-aa-bb-cc-dd-ee-ff-aa-bb-cc-dd-ee-ff-aa-bb-cc-dd-ee-ff-aa-bb", False),  # with dashes
+        ("\n" + "a" * 64 + "\n", False),  # with newlines
+        
+        # Invalid: empty string
+        ("", False),
+        
+        # Invalid: partial matches
+        ("a" * 64 + "extra", False),  # extra characters at end
+        ("prefix" + "a" * 64, False),  # prefix characters
+    ],
+)
+def test_hash_sha256(test_string, should_match):
+    class Model(BaseModel):
+        attr: types.hash_sha256
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(types.hash_sha256)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
