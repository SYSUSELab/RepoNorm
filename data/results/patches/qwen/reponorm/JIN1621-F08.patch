+class TestFilters:
+    """Test cases for loader filter functionality."""
+
+    def test_add_filter_glob(self):
+        """Test glob pattern filtering."""
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        loader.add_filter("*.html")
+        assert loader.list_templates() == ["c.txt"]
+
+    def test_add_filter_regex(self):
+        """Test regex pattern filtering."""
+        import re
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        loader.add_filter(re.compile(r"\.html$"))
+        assert loader.list_templates() == ["c.txt"]
+
+    def test_add_filter_callable(self):
+        """Test callable filtering."""
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        loader.add_filter(lambda name: name.endswith(".html"))
+        assert loader.list_templates() == ["c.txt"]
+
+    def test_clear_filters(self):
+        """Test clearing all filters."""
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        loader.add_filter("*.html")
+        assert loader.list_templates() == ["c.txt"]
+        loader.clear_filters()
+        assert set(loader.list_templates()) == {"a.html", "b.html", "c.txt"}
+
+    def test_multiple_filters(self):
+        """Test multiple filters applied together."""
+        loader = DictLoader(
+            {"a.html": "A", "b.html": "B", "c.txt": "C", "d.js": "D"}
+        )
+        loader.add_filter("*.html")
+        loader.add_filter("*.js")
+        assert loader.list_templates() == ["c.txt"]
+
+    def test_filter_scope_basic(self):
+        """Test basic filter scope context manager."""
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        with loader.filter_scope("*.html"):
+            assert loader.list_templates() == ["c.txt"]
+        # Filters restored after scope
+        assert set(loader.list_templates()) == {"a.html", "b.html", "c.txt"}
+
+    def test_filter_scope_nested(self):
+        """Test nested filter scopes."""
+        loader = DictLoader(
+            {"a.html": "A", "b.html": "B", "c.txt": "C", "d.js": "D"}
+        )
+        with loader.filter_scope("*.html"):
+            assert loader.list_templates() == ["c.txt", "d.js"]
+            with loader.filter_scope("*.js"):
+                assert loader.list_templates() == ["c.txt"]
+            # Inner scope exited, *.html still active
+            assert loader.list_templates() == ["c.txt", "d.js"]
+        # Outer scope exited, no filters active
+        assert set(loader.list_templates()) == {
+            "a.html",
+            "b.html",
+            "c.txt",
+            "d.js",
+        }
+
+    def test_filter_scope_exception_preserves_state(self):
+        """Test that exceptions in filter_scope restore original state."""
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        loader.add_filter("*.txt")  # Pre-existing filter
+        try:
+            with loader.filter_scope("*.html"):
+                raise ValueError("test exception")
+        except ValueError:
+            pass
+        # Original filter should be restored
+        assert loader.list_templates() == ["a.html", "b.html"]
+
+    def test_filter_scope_exception_on_enter(self):
+        """Test that invalid filter on enter restores original state."""
+        loader = DictLoader({"a.html": "A", "b.html": "B", "c.txt": "C"})
+        loader.add_filter("*.txt")  # Pre-existing filter
+        try:
+            with loader.filter_scope(123):  # Invalid type
+                pass
+        except TypeError:
+            pass
+        # Original filter should be preserved
+        assert loader.list_templates() == ["a.html", "b.html"]
+
+    def test_filter_type_error(self):
+        """Test that unsupported filter types raise TypeError."""
+        loader = DictLoader({"a.html": "A"})
+        with pytest.raises(TypeError, match="Unsupported filter type"):
+            loader.add_filter(123)
+        with pytest.raises(TypeError, match="Unsupported filter type"):
+            loader.add_filter([1, 2, 3])
+
+    def test_filter_persists_across_list_calls(self):
+        """Test that filters persist across multiple list_templates calls."""
+        loader = DictLoader({"a.html": "A", "b.html": "B"})
+        loader.add_filter("*.html")
+        assert loader.list_templates() == []
+        assert loader.list_templates() == []  # Same result
+
+    def test_filtered_template_still_loadable(self):
+        """Test that filtered templates can still be loaded directly."""
+        loader = DictLoader({"a.html": "HELLO", "b.html": "WORLD"})
+        loader.add_filter("*.html")
+        assert loader.list_templates() == []
+        # But we can still load them
+        source, _, _ = loader.get_source(None, "a.html")
+        assert source == "HELLO"
+
+    def test_filter_case_sensitive(self):
+        """Test that glob matching is case-sensitive."""
+        loader = DictLoader(
+            {"a.html": "A", "A.html": "B", "a.HTML": "C"}
+        )
+        loader.add_filter("*.html")
+        # Only lowercase .html should match
+        assert set(loader.list_templates()) == {"a.HTML"}  # Only a.HTML has uppercase HTML
+
+    def test_filter_empty_pattern(self):
+        """Test empty string pattern matches nothing."""
+        loader = DictLoader({"a.html": "A", "b.html": "B"})
+        loader.add_filter("")
+        # Empty pattern matches only empty string
+        assert set(loader.list_templates()) == {"a.html", "b.html"}
+
+    def test_filter_none_name(self):
+        """Test handling of None template names (should not crash)."""
+        loader = DictLoader({"a.html": "A"})
+        # Callable that returns True for None
+        loader.add_filter(lambda name: name is None)
+        assert loader.list_templates() == ["a.html"]
+
+    def test_filter_exception_propagates(self):
+        """Test that exceptions during filter matching propagate."""
+        loader = DictLoader({"a.html": "A"})
+
