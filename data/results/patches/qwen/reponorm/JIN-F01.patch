 ) -> "t.List[t.Tuple[t.Any, t.List[V]]]":
     """Group a sequence of objects by an attribute using Python's
     :func:`itertools.groupby`. The attribute can use dot notation for
@@ -1203,17 +1204,61 @@ def sync_do_groupby(
           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    By default, string keys differing only by lowercasing belong to one
+    group, retaining the spelling of the first encountered key and the
+    input order of its members. Use ``case_sensitive=True`` to keep
+    differently cased keys separate. Non-string comparable keys retain
+    normal grouping behavior. Unicode handling follows lowercasing, not
+    casefolding.
+
+    .. versionchanged:: 3.1
+        Added the ``case_sensitive`` parameter.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
     """
-    expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+    attrgetter = make_attrgetter(environment, attribute, default=default)
+
+    def sort_key(item: t.Any) -> t.Any:
+        result = attrgetter(item)
+        if not case_sensitive and isinstance(result, str):
+            result = result.lower()
+        return result
+
+    def group_key(item: t.Any) -> t.Any:
+        result = attrgetter(item)
+        if not case_sensitive and isinstance(result, str):
+            result = result.lower()
+        return result
+
+    # Sort by the expression (which may normalize strings for comparison)
+    sorted_items = sorted(value, key=sort_key)
+
+    # Group by the normalized expression, but preserve original key from first item
+    result = []
+    current_normalized_key: t.Any = None
+    current_original_key: t.Any = None
+    current_group: t.List[t.Any] = []
+
+    for item in sorted_items:
+        normalized_key = group_key(item)
+        original_key = attrgetter(item)
+        if normalized_key != current_normalized_key:
+            if current_group:
+                result.append(_GroupTuple(current_original_key, current_group))
+            current_normalized_key = normalized_key
+            current_original_key = original_key
+            current_group = [item]
+        else:
+            current_group.append(item)
+
+    if current_group:
+        result.append(_GroupTuple(current_original_key, current_group))
+
+    return result
 
 
