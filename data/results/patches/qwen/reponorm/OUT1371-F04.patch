+# Valid builtin filter categories
+VALID_BUILTIN_FILTER_CATEGORIES = frozenset({"string_utils", "math_utils", "format_utils"})
+
+
+def _load_builtin_filters(builtin_filters: Optional[List[str]] = None) -> Dict[str, Callable]:
+    """Load built-in filter functions based on category names.
+    
+    Parameters
+    ----------
+    builtin_filters : list of str, optional
+        List of category names to load. If None or empty, no built-in filters are added.
+        
+    Returns
+    -------
+    dict
+        A dictionary mapping filter names to their callable implementations.
+        
+    Raises
+    ------
+    ValueError
+        If an unknown category name is provided.
+    """
+    filters = {}
+    
+    if not builtin_filters:
+        return filters
+    
+    for category in builtin_filters:
+        if category not in VALID_BUILTIN_FILTER_CATEGORIES:
+            raise ValueError(f"Unknown builtin filter category: {category}")
+        
+        if category == "string_utils":
+            from outlines.string_utils import (
+                upper, lower, title, reverse, truncate, pad_left, pad_right,
+            )
+            filters.update({
+                "upper": upper,
+                "lower": lower,
+                "title": title,
+                "reverse": reverse,
+                "truncate": truncate,
+                "pad_left": pad_left,
+                "pad_right": pad_right,
+            })
+        elif category == "math_utils":
+            from outlines.math_utils import (
+                add, subtract, multiply, divide, round, abs, min, max,
+            )
+            filters.update({
+                "add": add,
+                "subtract": subtract,
+                "multiply": multiply,
+                "divide": divide,
+                "round": round,
+                "abs": abs,
+                "min": min,
+                "max": max,
+            })
+        elif category == "format_utils":
+            from outlines.format_utils import (
+                json as json_filter, csv, indent, wrap, escape, unescape,
+            )
+            filters.update({
+                "json": json_filter,
+                "csv": csv,
+                "indent": indent,
+                "wrap": wrap,
+                "escape": escape,
+                "unescape": unescape,
+            })
+    
+    return filters
+
