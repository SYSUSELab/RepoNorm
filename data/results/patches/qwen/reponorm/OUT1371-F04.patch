+        with tempfile.NamedTemporaryFile(mode='w', suffix='.jinja', delete=False) as f:
+            f.write("Value: {{ a | add(4) }}")
+            temp_path = f.name
+        
+        try:
+            p = Prompt.from_file(temp_path, builtin_filters=["math_utils"])
