+    def test_from_str_with_string_utils(self):
+        """Test from_str with string_utils category."""
+        p = Prompt.from_str("{{ name | upper }}", builtin_filters=["string_utils"])
+        result = p(name="hello")
+        assert result == "HELLO"
+
+    def test_from_file_with_math_utils(self):
+        """Test from_file with math_utils category."""
+        import tempfile
