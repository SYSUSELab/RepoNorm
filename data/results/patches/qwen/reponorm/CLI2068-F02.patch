diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..bf319f8 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,109 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+
+class TestEditTimeout:
+    """Tests for the timeout parameter in click.edit."""
+
+    def test_timeout_none_allows_indefinite(self, monkeypatch):
+        """timeout=None should allow editor to run indefinitely (default behavior)."""
+        called = []
+
+        def mock_edit(text):
+            called.append(True)
+            return text
+
+        from click._termui_impl import Editor
+
+        ed = Editor(editor="cat", timeout=None)
+        ed.edit = mock_edit
+        result = ed.edit("test")
+        assert result == "test"
+        assert len(called) == 1
+
+    def test_timeout_zero_raises_valueerror(self):
+        """timeout=0 should raise ValueError before editor starts."""
+        with pytest.raises(ValueError, match="timeout must be a positive integer"):
+            click.edit("test", timeout=0)
+
+    def test_timeout_negative_raises_valueerror(self):
+        """timeout=-1 should raise ValueError before editor starts."""
+        with pytest.raises(ValueError, match="timeout must be a positive integer"):
+            click.edit("test", timeout=-1)
+
+    def test_timeout_float_raises_valueerror(self):
+        """timeout as float should raise ValueError before editor starts."""
+        with pytest.raises(ValueError, match="timeout must be an integer"):
+            click.edit("test", timeout=1.5)
+
+    def test_timeout_string_raises_valueerror(self):
+        """timeout as string should raise ValueError before editor starts."""
+        with pytest.raises(ValueError, match="timeout must be an integer"):
+            click.edit("test", timeout="1")
+
+    def test_timeout_boolean_raises_valueerror(self):
+        """timeout as boolean should raise ValueError before editor starts."""
+        with pytest.raises(ValueError, match="timeout must be an integer"):
+            click.edit("test", timeout=True)
+
+    def test_timeout_valid_integer_does_not_raise(self):
+        """Valid positive integer timeout should not raise."""
+        # This would actually try to launch an editor, so we just check it doesn't
+        # raise during validation by testing the internal logic
+        from click._termui_impl import Editor
+
+        ed = Editor(editor="cat", timeout=5)
+        assert ed.timeout == 5
+
+    @pytest.mark.parametrize(
+        ("timeout", "expected_msg"),
+        [
+            (1, "after 1 seconds"),
+            (2, "after 2 seconds"),
+            (999, "after 999 seconds"),
+        ],
+    )
+    def test_timeout_error_message_format(self, timeout, expected_msg, monkeypatch):
+        """Error message should use correct format without pluralization."""
+        from click._termui_impl import Editor
+
+        ed = Editor(editor="fake_editor", timeout=timeout)
+
+        # Mock subprocess.Popen to simulate timeout
+        import subprocess
+        import os
+
+        call_count = [0]
+
+        class MockProcess:
+            pid = 12345
+
+            def wait(self, timeout=None):
+                call_count[0] += 1
+                if call_count[0] == 1:
+                    # First call is with the actual timeout
+                    raise subprocess.TimeoutExpired(cmd="fake_editor", timeout=timeout)
+                else:
+                    # Second call is for graceful shutdown (timeout=1), succeed
+                    return 0
+
+            def terminate(self):
+                pass
+
+            def kill(self):
+                pass
+
+        def mock_killpg(pid, sig):
+            pass
+
+        monkeypatch.setattr(subprocess, "Popen", lambda *a, **k: MockProcess())
+        monkeypatch.setattr(os, "killpg", mock_killpg)
+
+        with pytest.raises(click.ClickException) as exc_info:
+            ed.edit_file("/tmp/test.txt")
+
+        assert expected_msg in str(exc_info.value)
+        assert f"fake_editor: Editing timed out after {timeout} seconds" == str(
+            exc_info.value
+        )
