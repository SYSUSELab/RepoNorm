+    # Validate levels parameter
+    if levels is not None:
+        if isinstance(levels, bool):
+            raise FilterArgumentError("levels must be an integer or None")
+        if not isinstance(levels, int) or levels <= 0:
+            raise FilterArgumentError("levels must be a positive integer")
+    
+    # Parse attribute into a list of attribute paths
+    if isinstance(attribute, str):
+        if levels is not None:
+            # Comma-separated string for hierarchical grouping
+            attr_list = [a.strip() for a in attribute.split(",")]
+        else:
+            # Single attribute for regular grouping
+            attr_list = [attribute]
+    elif isinstance(attribute, (int, float)):
+        attr_list = [attribute]
+    elif isinstance(attribute, (list, tuple)):
+        if levels is not None:
+            if len(attribute) != levels:
+                raise FilterArgumentError(
+                    f"attribute list length ({len(attribute)}) does not match levels ({levels})"
+                )
+            attr_list = list(attribute)
+        else:
+            # Multiple attributes without levels is an error
+            raise FilterArgumentError(
+                "multiple attributes require levels argument"
+            )
+    else:
+        raise FilterArgumentError("attribute must be a string, int, or sequence")
+    
+    # If levels is None or 1, use regular groupby
+    if levels is None or levels == 1:
+        if len(attr_list) != 1:
+            raise FilterArgumentError(
+                "single-level grouping requires exactly one attribute"
+            )
+        expr = make_attrgetter(environment, attr_list[0], default=default)
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+    
+    # Hierarchical grouping
+    def build_hierarchical_groups(items: t.List[V], attrs: t.List[t.Union[str, int]]) -> t.List[t.Tuple[t.Any, t.Any]]:
+        """Recursively build hierarchical groups."""
+        if len(attrs) == 1:
+            # Last level: group by the final attribute
+            expr = make_attrgetter(environment, attrs[0], default=default)
+            return [
+                _GroupTuple(key, list(values))
+                for key, values in groupby(sorted(items, key=expr), expr)
+            ]
+        
+        # Intermediate level: group by first attribute, then recurse
+        first_attr = attrs[0]
+        remaining_attrs = attrs[1:]
+        expr = make_attrgetter(environment, first_attr, default=default)
+        
+        grouped = {}
+        for item in items:
+            key = expr(item)
+            if key not in grouped:
+                grouped[key] = []
+            grouped[key].append(item)
+        
+        result = []
+        for key in sorted(grouped.keys(), key=lambda x: (x is None, x)):
+            child_groups = build_hierarchical_groups(grouped[key], remaining_attrs)
+            result.append(_GroupTuple(key, child_groups))
+        
+        return result
+    
