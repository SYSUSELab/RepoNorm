@@ -833,6 +833,227 @@ class Context:
         return self._parameter_source.get(name)
 
 
+    def save_state(self) -> dict[str, t.Any]:
+        """Create a snapshot of the context's parsing and presentation state.
+        
+        The returned dictionary contains copies of all mutable state that can be
+        restored later with :meth:`restore_state`. This is useful for temporarily
+        changing parsing or presentation state and then restoring it.
+        
+        The snapshot includes:
+        
+        - ``params``: parameter values
+        - ``args``: leftover arguments
+        - ``_protected_args``: protected arguments
+        - ``_opt_prefixes``: option prefixes
+        - ``obj``: user object
+        - ``_meta``: metadata dictionary
+        - ``default_map``: default values mapping
+        - ``invoked_subcommand``: name of invoked subcommand
+        - ``terminal_width``: terminal width setting
+        - ``max_content_width``: maximum content width
+        - ``resilient_parsing``: resilient parsing flag
+        - ``allow_extra_args``: allow extra args flag
+        - ``allow_interspersed_args``: allow interspersed args flag
+        - ``ignore_unknown_options``: ignore unknown options flag
+        - ``help_option_names``: help option names list
+        - ``token_normalize_func``: token normalization function
+        - ``auto_envvar_prefix``: environment variable prefix
+        - ``color``: color output setting
+        - ``show_default``: show default values setting
+        - ``_parameter_source``: parameter source tracking
+        
+        Mutable values are copied to ensure independence from the source context.
+        Snapshots are reusable and multiple snapshots remain independently restorable.
+        
+        .. versionadded:: 8.3
+        """
+        import copy
+        
+        # Track shared mutable objects to preserve references
+        shared_objects = {}
+        
+        # Collect all mutable objects and their locations
+        mutable_fields = [
+            ("args", self.args),
+            ("_protected_args", self._protected_args),
+            ("_opt_prefixes", self._opt_prefixes),
+            ("_meta", self._meta),
+            ("default_map", self.default_map),
+            ("help_option_names", self.help_option_names),
+            ("_parameter_source", self._parameter_source),
+        ]
+        
+        # Build a map of id -> (field_name, value) for mutable objects
+        seen_ids = {}
+        for field_name, value in mutable_fields:
+            if value is not None and isinstance(value, (list, dict, set)):
+                obj_id = id(value)
+                if obj_id not in seen_ids:
+                    seen_ids[obj_id] = []
+                seen_ids[obj_id].append(field_name)
+        
+        # For each shared object, store one copy and mark others as aliases
+        result = {}
+        for field_name, value in mutable_fields:
+            if value is None:
+                result[field_name] = None
+            elif isinstance(value, (list, dict, set)):
+                obj_id = id(value)
+                if obj_id in shared_objects:
+                    # Use the same copy for all fields sharing this object
+                    result[field_name] = shared_objects[obj_id]
+                else:
+                    # Create a new copy
+                    if isinstance(value, dict):
+                        copy_value = copy.copy(value)
+                    elif isinstance(value, set):
+                        copy_value = copy.copy(value)
+                    else:  # list
+                        copy_value = copy.copy(value)
+                    shared_objects[obj_id] = copy_value
+                    result[field_name] = copy_value
+            else:
+                result[field_name] = value
+        
+        # Handle params separately (always deep copy)
+        result["params"] = copy.deepcopy(self.params)
+        
+        # Handle immutable/simple fields
+        result["obj"] = self.obj
+        result["invoked_subcommand"] = self.invoked_subcommand
+        result["terminal_width"] = self.terminal_width
+        result["max_content_width"] = self.max_content_width
+        result["resilient_parsing"] = self.resilient_parsing
+        result["allow_extra_args"] = self.allow_extra_args
+        result["allow_interspersed_args"] = self.allow_interspersed_args
+        result["ignore_unknown_options"] = self.ignore_unknown_options
+        result["token_normalize_func"] = self.token_normalize_func
+        result["auto_envvar_prefix"] = self.auto_envvar_prefix
+        result["color"] = self.color
+        result["show_default"] = self.show_default
+        
+        return result
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Restore the context's state from a snapshot.
+        
+        This method restores the context's parsing and presentation state from a
+        snapshot created by :meth:`save_state`. It is transactional: if any part
+        of the restoration fails, the context remains unchanged.
+        
+        :param snapshot: A dictionary containing the saved state. Must contain all
+            supported keys and have ``_meta`` as a dictionary.
+            
+        :raises ValueError: If the snapshot is missing required keys, has invalid
+            metadata, or cannot be copied.
+            
+        .. versionadded:: 8.3
+        """
+        import copy
+        
+        # Validate the snapshot structure first (transactional)
+        required_keys = {
+            "params", "args", "_protected_args", "_opt_prefixes",
+            "obj", "_meta", "default_map", "invoked_subcommand",
+            "terminal_width", "max_content_width", "resilient_parsing",
+            "allow_extra_args", "allow_interspersed_args", "ignore_unknown_options",
+            "help_option_names", "token_normalize_func", "auto_envvar_prefix",
+            "color", "show_default", "_parameter_source",
+        }
+        
+        # Check for missing keys (unknown keys are ignored)
+        missing_keys = required_keys - set(snapshot.keys())
+        if missing_keys:
+            raise ValueError(
+                f"Snapshot is missing required keys: {', '.join(sorted(missing_keys))}"
+            )
+        
+        # Validate metadata is a dictionary
+        meta = snapshot["_meta"]
+        if not isinstance(meta, dict):
+            raise ValueError("Snapshot '_meta' must be a dictionary")
+        
+        # Prepare the restored values (respecting shared references)
+        try:
+            restored_params = copy.deepcopy(snapshot["params"])
+            
+            # Track shared mutable objects to preserve references
+            shared_objects = {}
+            
+            # Process mutable fields in order, sharing copies when they share the same object
+            mutable_fields = [
+                ("args", snapshot["args"]),
+                ("_protected_args", snapshot["_protected_args"]),
+                ("_opt_prefixes", snapshot["_opt_prefixes"]),
+                ("_meta", snapshot["_meta"]),
+                ("default_map", snapshot["default_map"]),
+                ("help_option_names", snapshot["help_option_names"]),
+                ("_parameter_source", snapshot["_parameter_source"]),
+            ]
+            
+            restored_values = {}
+            for field_name, value in mutable_fields:
+                if value is None:
+                    restored_values[field_name] = None
+                elif isinstance(value, (list, dict, set)):
+                    obj_id = id(value)
+                    if obj_id in shared_objects:
+                        # Use the same copy for all fields sharing this object
+                        restored_values[field_name] = shared_objects[obj_id]
+                    else:
+                        # Create a new copy
+                        if isinstance(value, dict):
+                            copy_value = copy.copy(value)
+                        elif isinstance(value, set):
+                            copy_value = copy.copy(value)
+                        else:  # list
+                            copy_value = copy.copy(value)
+                        shared_objects[obj_id] = copy_value
+                        restored_values[field_name] = copy_value
+                else:
+                    restored_values[field_name] = value
+            
+            restored_obj = snapshot["obj"]
+            restored_invoked_subcommand = snapshot["invoked_subcommand"]
+            restored_terminal_width = snapshot["terminal_width"]
+            restored_max_content_width = snapshot["max_content_width"]
+            restored_resilient_parsing = snapshot["resilient_parsing"]
+            restored_allow_extra_args = snapshot["allow_extra_args"]
+            restored_allow_interspersed_args = snapshot["allow_interspersed_args"]
+            restored_ignore_unknown_options = snapshot["ignore_unknown_options"]
+            restored_token_normalize_func = snapshot["token_normalize_func"]
+            restored_auto_envvar_prefix = snapshot["auto_envvar_prefix"]
+            restored_color = snapshot["color"]
+            restored_show_default = snapshot["show_default"]
+        except Exception as e:
+            raise ValueError(f"Failed to prepare snapshot data: {e}") from e
+        
+        # Now apply the changes (transactional - all or nothing)
+        self.params = restored_params
+        self.args = restored_values["args"]
+        self._protected_args = restored_values["_protected_args"]
+        self._opt_prefixes = restored_values["_opt_prefixes"]
+        self.obj = restored_obj
+        # Restore metadata contents while preserving the existing dictionary
+        self._meta.clear()
+        self._meta.update(restored_values["_meta"])
+        self.default_map = restored_values["default_map"]
+        self.invoked_subcommand = restored_invoked_subcommand
+        self.terminal_width = restored_terminal_width
+        self.max_content_width = restored_max_content_width
+        self.resilient_parsing = restored_resilient_parsing
+        self.allow_extra_args = restored_allow_extra_args
+        self.allow_interspersed_args = restored_allow_interspersed_args
+        self.ignore_unknown_options = restored_ignore_unknown_options
+        self.help_option_names = restored_values["help_option_names"]
+        self.token_normalize_func = restored_token_normalize_func
+        self.auto_envvar_prefix = restored_auto_envvar_prefix
+        self.color = restored_color
+        self.show_default = restored_show_default
+        self._parameter_source = restored_values["_parameter_source"]
+
+
 class Command:
     """Commands are the basic building block of command line interfaces in
     Click.  A basic command handles command line parsing and might dispatch
diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..dc4e5b9 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -543,3 +543,230 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+@click.command()
+@click.option('--name', default='World')
+def hello(name):
+    pass
+
+
+def test_save_state():
+    """Test that save_state creates a valid snapshot."""
+    ctx = Context(hello)
+    ctx.params = {"name": "Alice"}
+    ctx.args = ["extra"]
+    ctx._protected_args = ["protected"]
+    ctx._opt_prefixes = {"--"}
+    ctx.obj = {"user": "test"}
+    ctx._meta["key"] = "value"
+    ctx.default_map = {"hello": {"name": "Bob"}}
+    ctx.invoked_subcommand = "sub"
+    ctx.terminal_width = 80
+    ctx.max_content_width = 100
+    ctx.resilient_parsing = True
+    ctx.allow_extra_args = False
+    ctx.allow_interspersed_args = True
+    ctx.ignore_unknown_options = False
+    ctx.help_option_names = ["-h", "--help"]
+    ctx.token_normalize_func = str.lower
+    ctx.auto_envvar_prefix = "MYAPP"
+    ctx.color = True
+    ctx.show_default = True
+    ctx._parameter_source = {"name": ParameterSource.COMMANDLINE}
+
+    snapshot = ctx.save_state()
+
+    # Check all expected keys are present
+    assert set(snapshot.keys()) == {
+        "params", "args", "_protected_args", "_opt_prefixes",
+        "obj", "_meta", "default_map", "invoked_subcommand",
+        "terminal_width", "max_content_width", "resilient_parsing",
+        "allow_extra_args", "allow_interspersed_args", "ignore_unknown_options",
+        "help_option_names", "token_normalize_func", "auto_envvar_prefix",
+        "color", "show_default", "_parameter_source",
+    }
+
+
+def test_restore_state():
+    """Test that restore_state restores context from snapshot."""
+    ctx = Context(hello)
+    ctx.params = {"name": "Alice"}
+    ctx.args = ["extra"]
+    ctx._protected_args = ["protected"]
+    ctx._opt_prefixes = {"--"}
+    ctx.obj = {"user": "test"}
+    ctx._meta["key"] = "value"
+    ctx.default_map = {"hello": {"name": "Bob"}}
+    ctx.invoked_subcommand = "sub"
+    ctx.terminal_width = 80
+    ctx.max_content_width = 100
+    ctx.resilient_parsing = True
+    ctx.allow_extra_args = False
+    ctx.allow_interspersed_args = True
+    ctx.ignore_unknown_options = False
+    ctx.help_option_names = ["-h", "--help"]
+    ctx.token_normalize_func = str.lower
+    ctx.auto_envvar_prefix = "MYAPP"
+    ctx.color = True
+    ctx.show_default = True
+    ctx._parameter_source = {"name": ParameterSource.COMMANDLINE}
+
+    snapshot = ctx.save_state()
+
+    # Clear all state
+    ctx.params = {}
+    ctx.args = []
+    ctx._protected_args = []
+    ctx._opt_prefixes = set()
+    ctx.obj = None
+    ctx._meta.clear()
+    ctx.default_map = None
+    ctx.invoked_subcommand = None
+    ctx.terminal_width = None
+    ctx.max_content_width = None
+    ctx.resilient_parsing = False
+    ctx.allow_extra_args = None
+    ctx.allow_interspersed_args = None
+    ctx.ignore_unknown_options = None
+    ctx.help_option_names = ["--help"]
+    ctx.token_normalize_func = None
+    ctx.auto_envvar_prefix = None
+    ctx.color = None
+    ctx.show_default = None
+    ctx._parameter_source = {}
+
+    ctx.restore_state(snapshot)
+
+    assert ctx.params == {"name": "Alice"}
+    assert ctx.args == ["extra"]
+    assert ctx._protected_args == ["protected"]
+    assert ctx._opt_prefixes == {"--"}
+    assert ctx.obj == {"user": "test"}
+    assert ctx._meta == {"key": "value"}
+    assert ctx.default_map == {"hello": {"name": "Bob"}}
+    assert ctx.invoked_subcommand == "sub"
+    assert ctx.terminal_width == 80
+    assert ctx.max_content_width == 100
+    assert ctx.resilient_parsing is True
+    assert ctx.allow_extra_args is False
+    assert ctx.allow_interspersed_args is True
+    assert ctx.ignore_unknown_options is False
+    assert ctx.help_option_names == ["-h", "--help"]
+    assert ctx.token_normalize_func is str.lower
+    assert ctx.auto_envvar_prefix == "MYAPP"
+    assert ctx.color is True
+    assert ctx.show_default is True
+    assert ctx._parameter_source == {"name": ParameterSource.COMMANDLINE}
+
+
+def test_snapshot_independence():
+    """Test that multiple snapshots remain independently restorable."""
+    ctx = Context(hello)
+    ctx.params = {"x": 1}
+    snap1 = ctx.save_state()
+    ctx.params = {"y": 2}
+    snap2 = ctx.save_state()
+
+    ctx.params = {}
+    ctx.restore_state(snap1)
+    assert ctx.params == {"x": 1}
+
+    ctx.params = {}
+    ctx.restore_state(snap2)
+    assert ctx.params == {"y": 2}
+
+
+def test_metadata_shared_reference():
+    """Test that metadata dictionary is shared but contents are restored."""
+    ctx = Context(hello)
+    ctx._meta["shared"] = "original"
+    snap = ctx.save_state()
+
+    # Modify metadata
+    ctx._meta["new_key"] = "new_value"
+    ctx._meta["shared"] = "modified"
+
+    ctx.restore_state(snap)
+    assert ctx._meta == {"shared": "original"}
+    assert "shared" in snap["_meta"]
+
+
+def test_missing_keys_error():
+    """Test that missing keys raise ValueError."""
+    ctx = Context(hello)
+    try:
+        ctx.restore_state({"params": {}})
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "missing required keys" in str(e).lower()
+
+
+def test_invalid_metadata_error():
+    """Test that invalid metadata raises ValueError."""
+    ctx = Context(hello)
+    ctx.params = {"a": 1}
+    snap = ctx.save_state()
+    try:
+        ctx.restore_state({**snap, "_meta": "not a dict"})
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "'_meta' must be a dictionary" in str(e)
+
+
+def test_unknown_keys_ignored():
+    """Test that unknown keys in snapshot are ignored."""
+    ctx = Context(hello)
+    ctx.params = {"a": 1}
+    snap = ctx.save_state()
+    snap["unknown_key"] = "ignored"
+    ctx.params = {}
+    ctx.restore_state(snap)
+    assert ctx.params == {"a": 1}
+
+
+def test_mutable_values_independent():
+    """Test that mutable values are independent after restore."""
+    ctx = Context(hello)
+    ctx.params = {"nested": {"inner": [1, 2, 3]}}
+    snap = ctx.save_state()
+
+    # Modify original params
+    ctx.params["nested"]["inner"].append(4)
+    ctx.params["nested"]["inner"].append(5)
+
+    # Restore from snapshot
+    ctx.params = {}
+    ctx.restore_state(snap)
+    assert ctx.params["nested"]["inner"] == [1, 2, 3]
+
+
+def test_shared_references_preserved():
+    """Test that shared references across fields are preserved."""
+    ctx = Context(hello)
+    shared_list = [1, 2, 3]
+    ctx.args = shared_list
+    ctx._protected_args = shared_list
+    snap = ctx.save_state()
+
+    ctx.restore_state(snap)
+    assert ctx.args is ctx._protected_args
+
+
+def test_transactional_restore():
+    """Test that restore is transactional - no partial changes on failure."""
+    ctx = Context(hello)
+    ctx.params = {"a": 1}
+    ctx.args = ["x"]
+    
+    # Save initial state
+    initial_snap = ctx.save_state()
+    
+    # Try to restore with invalid data (should fail without changing context)
+    try:
+        ctx.restore_state({"params": {}, "_meta": "invalid"})
+    except ValueError:
+        pass
+    
+    # Context should be unchanged
+    assert ctx.params == {"a": 1}
+    assert ctx.args == ["x"]
