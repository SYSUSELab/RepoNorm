+    def extract_marked_translations(
+        self,
+        source: t.Union[str, nodes.Template],
+        source_name: t.Optional[str] = None,
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract marked translations from a template source or AST.
+
+        Parses a string or accepts a parsed template and yields independent
+        record mappings. Each record has ``source``, marker ``lineno``, a copied
+        ``metadata`` mapping, and ``messages``. Each message contains its
+        ``lineno``, gettext ``function``, and extracted ``message``. Nested
+        gettext calls in the marker body are associated with that record.
+
+        Extraction retains no records between calls or template compilations,
+        so recompiling a source cannot accumulate stale markers. Repeated calls
+        are stable and callers may mutate returned records.
+
+        :param source: The template source string or already-parsed AST node.
+        :param source_name: Optional name for the source being processed.
+        :yield: Dictionary records with ``source``, ``lineno``, ``metadata``,
+                and ``messages`` keys.
+        """
+        from .ext import extract_from_ast
+        
+        if isinstance(source, str):
+            source = self.parse(source)
+
+        # Find all Extract nodes in the AST
+        for extract_node in source.find_all(nodes.Extract):
+            # Extract messages from the body using extract_from_ast
+            messages = []
+            for msg_lineno, func, msg in extract_from_ast(extract_node):
+                messages.append({"lineno": msg_lineno, "function": func, "message": msg})
+
+            yield {
+                "source": source_name,
+                "lineno": extract_node.lineno,
+                "metadata": dict(extract_node.metadata),
+                "messages": messages,
+            }
+
+    def extract_marked_translations_from_templates(
+        self, names: t.Optional[t.Iterable[str]] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract marked translations from templates supplied by the loader.
+
+        Yields the same records as :meth:`extract_marked_translations` for
+        templates supplied by the configured loader. ``names`` is a finite
+        iterable of logical template names, processed in its iteration order;
+        when omitted, process all listed templates. Each record's ``source``
+        is the logical name being processed. This operation extracts source
+        without rendering templates or recursively following includes or
+        inheritance.
+
+        :param names: Optional iterable of template names to process. If None,
+                     processes all templates from the loader.
+        :yield: Dictionary records with ``source``, ``lineno``, ``metadata``,
+                and ``messages`` keys.
+        """
+        # No loader configured, return empty iterator
+        if self.loader is None:
+            return
+
+        if names is None:
+            try:
+                names = self.loader.list_templates()
+            except TypeError:
+                # Loader doesn't support list_templates
+                return
+
+        for name in names:
+            try:
+                source, _, _ = self.loader.get_source(self, name)
+            except Exception:
+                # Skip templates that can't be loaded
+                continue
+
+            for record in self.extract_marked_translations(source, source_name=name):
+                yield record
+
