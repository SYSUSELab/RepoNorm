+class TranslationExtractorExtension(Extension):
+    """This extension adds extract markers for translation extraction.
+
+    The ``{% extract key=constant, ... %}...{% endextract %}`` tag marks
+    translatable content without rendering it. Metadata values must be
+    compile-time constants; dynamic expressions and duplicate keys raise
+    :exc:`TemplateSyntaxError` naming the key. Marker bodies are ordinary
+    Jinja bodies and render unchanged. They may contain control structures
+    and any gettext calls supported by normal extraction.
+    """
+
+    tags = {"extract"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse an extract marker."""
+        lineno = next(parser.stream).lineno
+        metadata: t.Dict[str, nodes.Expr] = {}
+
+        # Parse metadata key=value pairs
+        while parser.stream.current.type != "block_end":
+            if metadata:
+                parser.stream.expect("comma")
+
+            token = parser.stream.expect("name")
+            if token.value in metadata:
+                parser.fail(
+                    f"extract key {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # Expect assignment for value
+            parser.stream.expect("assign")
+            # Value must be a compile-time constant
+            value = parser.parse_expression()
+            if not isinstance(value, nodes.Const):
+                parser.fail(
+                    f"extract key {token.value!r} value must be a constant.",
+                    token.lineno,
+                    exc=TemplateSyntaxError,
+                )
+            metadata[token.value] = value
+
+        parser.stream.expect("block_end")
+
+        # Parse body until endextract
+        body = self._parse_body(parser)
+
+        node = nodes.Extract(body, metadata)
+        node.set_lineno(lineno)
+        return node
+
+    def _parse_body(self, parser: "Parser") -> t.List[nodes.Node]:
+        """Parse body until endextract tag."""
+        body = []
+        data_buffer: t.List[str] = []
+        
+        def flush_data():
+            if data_buffer:
+                body.append(nodes.Output([nodes.TemplateData("".join(data_buffer))]))
+                del data_buffer[:]
+        
+        while True:
+            if parser.stream.current.type == "data":
+                data_buffer.append(parser.stream.current.value)
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                flush_data()
+                next(parser.stream)
+                expr = parser.parse_tuple()
+                parser.stream.expect("variable_end")
+                body.append(nodes.Output([expr]))
+            elif parser.stream.current.type == "block_begin":
+                flush_data()
+                # Check if this is endextract by peeking ahead
+                next(parser.stream)
+                # Skip whitespace to get to the actual token
+                while parser.stream.current.type == "whitespace":
+                    next(parser.stream)
+                if parser.stream.current.test("name:endextract"):
+                    next(parser.stream)
+                    break
+                # For other blocks (if, for, etc.), we need to parse the full statement.
+                # We've consumed block_begin, so current is now the name token (e.g., "if").
+                # parse_statement expects to start at a name token, so we can call it directly.
+                node = parser.parse_statement()
+                body.append(node)
+            elif parser.stream.current.type == "name":
+                # This could be a closing tag like endif, endfor, etc.
+                # These are handled by the parent block's parse_statements,
+                # so we just skip them.
+                next(parser.stream)
+            elif parser.stream.current.type == "block_end":
+                # This is the block_end after a closing tag like endif.
+                # Skip it to continue parsing.
+                next(parser.stream)
+            elif parser.stream.eos:
+                parser.fail("unclosed extract block")
+            else:
+                raise RuntimeError("internal parser error")
+        
+        # Flush any remaining data
+        flush_data()
+        return body
+
+
