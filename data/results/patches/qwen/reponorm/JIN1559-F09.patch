+class TestExtractMarkedTranslationsFromTemplates:
+    """Tests for Environment.extract_marked_translations_from_templates."""
+
+    def test_extract_from_templates_basic(self):
+        """Test extracting from templates via loader."""
+        loader = DictLoader({
+            "template1.html": "{% extract key='t1' %}{{ _('Template 1') }}{% endextract %}",
+            "template2.html": "{% extract key='t2' %}{{ _('Template 2') }}{% endextract %}",
+        })
+        env = Environment(loader=loader, extensions=[TranslationExtractorExtension])
+        
+        records = list(env.extract_marked_translations_from_templates())
+        
+        assert len(records) == 2
+        sources = {r["source"] for r in records}
+        assert sources == {"template1.html", "template2.html"}
+
+    def test_extract_from_templates_with_names(self):
+        """Test extracting specific templates by name."""
+        loader = DictLoader({
+            "template1.html": "{% extract key='t1' %}{{ _('Template 1') }}{% endextract %}",
+            "template2.html": "{% extract key='t2' %}{{ _('Template 2') }}{% endextract %}",
+            "template3.html": "{% extract key='t3' %}{{ _('Template 3') }}{% endextract %}",
+        })
+        env = Environment(loader=loader, extensions=[TranslationExtractorExtension])
+        
+        records = list(env.extract_marked_translations_from_templates(["template1.html"]))
+        
+        assert len(records) == 1
+        assert records[0]["source"] == "template1.html"
+
+    def test_extract_from_templates_order_preserved(self):
+        """Test that template names are processed in iteration order."""
+        loader = DictLoader({
+            "z.html": "{% extract key='z' %}{{ _('Z') }}{% endextract %}",
+            "a.html": "{% extract key='a' %}{{ _('A') }}{% endextract %}",
+            "m.html": "{% extract key='m' %}{{ _('M') }}{% endextract %}",
+        })
+        env = Environment(loader=loader, extensions=[TranslationExtractorExtension])
+        
+        records = list(env.extract_marked_translations_from_templates(["z.html", "a.html", "m.html"]))
+        
+        assert len(records) == 3
+        assert records[0]["source"] == "z.html"
+        assert records[1]["source"] == "a.html"
+        assert records[2]["source"] == "m.html"
+
+    def test_extract_from_templates_skips_missing(self):
