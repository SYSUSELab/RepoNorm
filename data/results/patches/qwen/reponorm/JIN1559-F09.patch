+class TestTranslationExtractorExtension:
+    """Tests for TranslationExtractorExtension and extract markers."""
+
+    def test_extract_basic(self):
+        """Test basic extract marker with gettext call."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = "{% extract key='test' %}{{ _('Hello World') }}{% endextract %}"
+        records = list(env.extract_marked_translations(source))
+        
+        assert len(records) == 1
+        record = records[0]
+        assert record["source"] is None
+        assert record["lineno"] == 1
+        assert record["metadata"] == {"key": Const("test")}
+        assert len(record["messages"]) == 1
+        msg = record["messages"][0]
+        assert msg["lineno"] == 1
+        assert msg["function"] == "_"
+        assert msg["message"] == "Hello World"
+
+    def test_extract_multiple_keys(self):
+        """Test extract marker with multiple metadata keys."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = (
+            "{% extract key='test', domain='mydomain', context='ctx' %}"
+            "{{ _('Hello') }}"
+            "{% endextract %}"
+        )
+        records = list(env.extract_marked_translations(source))
+        
+        assert len(records) == 1
+        record = records[0]
+        assert record["metadata"]["key"] == Const("test")
+        assert record["metadata"]["domain"] == Const("mydomain")
+        assert record["metadata"]["context"] == Const("ctx")
+
+    def test_extract_duplicate_key_error(self):
+        """Test that duplicate keys raise TemplateSyntaxError."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = "{% extract key='a', key='b' %}test{% endextract %}"
+        
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            env.parse(source)
+        assert "key 'key' defined twice" in str(exc_info.value)
+
+    def test_extract_non_constant_value_error(self):
+        """Test that non-constant values raise TemplateSyntaxError."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = "{% extract key=something() %}test{% endextract %}"
+        
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            env.parse(source)
+        assert "key 'key' value must be a constant" in str(exc_info.value)
+
+    def test_extract_nested_gettext(self):
+        """Test nested gettext calls in extract body."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = (
+            "{% extract key='outer' %}"
+            "{{ _('Outer') }}"
+            "{% if condition %}{{ _('Inner') }}{% endif %}"
+            "{% endextract %}"
+        )
+        records = list(env.extract_marked_translations(source))
+        
+        assert len(records) == 1
+        record = records[0]
+        assert len(record["messages"]) == 2
+        messages = [m["message"] for m in record["messages"]]
+        assert "Outer" in messages
+        assert "Inner" in messages
+
+    def test_extract_control_structures(self):
+        """Test control structures in extract body."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = (
+            "{% extract key='loop' %}"
+            "{% for i in items %}{{ _('%d') % i }}{% endfor %}"
+            "{% endextract %}"
+        )
+        # Should parse without error
+        ast = env.parse(source)
+        assert ast is not None
+
+    def test_extract_preserves_body_rendering(self):
+        """Test that extract body renders unchanged when used in template."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = (
+            "{% extract key='test' %}"
+            "Hello {{ name }}!"
+            "{% endextract %}"
+        )
+        template = env.from_string(source)
+        result = template.render(name="World")
+        # The extract block should render its body normally
+        assert "Hello World!" in result
+
+    def test_extract_no_records_after_recompile(self):
+        """Test that recompiling doesn't accumulate stale markers."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = "{% extract key='test' %}{{ _('Hello') }}{% endextract %}"
+        
+        # First extraction
+        records1 = list(env.extract_marked_translations(source))
+        assert len(records1) == 1
+        
+        # Parse again (simulating recompile)
+        ast = env.parse(source)
+        records2 = list(env.extract_marked_translations(ast))
+        assert len(records2) == 1
+        
+        # Extract from string again
+        records3 = list(env.extract_marked_translations(source))
+        assert len(records3) == 1
+
+    def test_extract_mutability(self):
+        """Test that returned records can be mutated without affecting future calls."""
+        env = Environment(extensions=[TranslationExtractorExtension])
+        source = "{% extract key='test' %}{{ _('Hello') }}{% endextract %}"
+        
+        records1 = list(env.extract_marked_translations(source))
+        records1[0]["messages"].append({"fake": True})
+        
+        records2 = list(env.extract_marked_translations(source))
+        assert len(records2[0]["messages"]) == 1
