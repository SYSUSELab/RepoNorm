+def validate_template_path(template: str) -> None:
+    """Validate a template path name.
+
+    Returns ``None`` for valid names and raises :exc:`TemplateNotFound` when
+    the value is ``None`` or the empty string, contains a NUL byte, begins with
+    ``/`` or ``\\``, begins with an ASCII drive prefix such as ``C:``, or
+    contains an ASCII control character below code point 32 other than tab,
+    newline, or carriage return. Those three named control characters remain
+    valid.
+
+    .. versionadded:: 3.1
+    """
+    if template is None or template == "":
+        raise TemplateNotFound(template)
+
+    # Check for NUL byte
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    # Check for absolute paths (beginning with / or \)
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+
+    # Check for Windows drive prefix (e.g., C:, D:)
+    if len(template) >= 2 and template[1] == ":":
+        if template[0].isascii() and template[0].isalpha():
+            raise TemplateNotFound(template)
+
+    # Check for control characters below code point 32, except tab (9),
+    # newline (10), and carriage return (13)
+    for char in template:
+        code = ord(char)
+        if code < 32 and code not in (9, 10, 13):
+            raise TemplateNotFound(template)
+
