+def test_validate_nesting_nested_levels():
+    """Nested levels should all validate correctly."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.group()
+    def group():
+        pass
+
+    @group.command()
+    def sub():
+        click.echo("sub")
+
+    # Build the full context hierarchy
+    from click.shell_completion import _resolve_context
+    ctx_args = {}
+    ctx = _resolve_context(cli, ctx_args, "cli", ["group", "sub"])
+
+    # Close in correct order: sub -> group -> cli
+    # Using nested with statements ensures proper order
+    with ctx:  # sub
+        pass  # sub exits first
+    with ctx.parent:  # group
+        pass  # group exits second
+    with ctx.parent.parent:  # cli
+        pass  # cli exits last
+
