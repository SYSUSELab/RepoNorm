+def test_validate_nesting_default_false():
+    """By default, validate_nesting is False and no validation occurs."""
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    def sub():
+        click.echo("sub")
+
+    # Should work without errors
+    result = cli.main(["sub"], standalone_mode=False)
+    assert result is None  # Returns None when standalone_mode=False
+
+
+def test_validate_nesting_parent_refuses_close_with_child():
+    """A validated parent must refuse to close while any child remains open."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.command()
+    def sub():
+        click.echo("sub")
+
+    ctx = cli.make_context("cli", [], resilient_parsing=True)
+    ctx.__enter__()
+    try:
+        # Create child context manually
+        sub_ctx = ctx._make_sub_context(click.Command("sub"))
+        sub_ctx.__enter__()
+        # Don't close the child - leave it open
+
+        # Try to close parent manually - should fail
+        with pytest.raises(RuntimeError, match="Cannot close"):
+            ctx.close()
+    finally:
+        # Clean up by closing child first
+        sub_ctx.__exit__(None, None, None)
+
+
+def test_validate_nesting_child_closes_first_works():
+    """Closing child first then parent should work."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.command()
+    def sub():
+        click.echo("sub")
+
+    ctx = cli.make_context("cli", [], resilient_parsing=True)
+    ctx.__enter__()
+    try:
+        # Create child context manually
+        sub_ctx = ctx._make_sub_context(click.Command("sub"))
+        with sub_ctx:
+            pass  # Child closes properly
+
+        # Parent can now close
+        ctx.close()  # Should not raise
+    finally:
+        pass
+
