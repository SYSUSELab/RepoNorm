+def test_validate_nesting_failed_parsing_no_phantom():
+    """Failed parsing should not leave phantom open child."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.command()
+    def sub():
+        click.echo("sub")
+
+    ctx = cli.make_context("cli", [], resilient_parsing=True)
+    ctx.__enter__()
+    try:
+        # Create child context
+        sub_ctx = ctx._make_sub_context(click.Command("sub"))
+        sub_ctx.__enter__()
+
+        # Simulate failed parsing by exiting without proper cleanup
+        sub_ctx.__exit__(ValueError("parse error"), None, None)
+
+        # Parent should be able to close (child was removed on exit)
+        ctx.close()  # Should not raise
+    finally:
+        pass
+
+
+def test_validate_nesting_closed_child_reopens():
+    """Entering a previously closed child opens and tracks it again."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.command()
+    def sub():
+        click.echo("sub")
+
+    ctx = cli.make_context("cli", [], resilient_parsing=True)
+    ctx.__enter__()
+    try:
+        # Create and close child
+        sub_ctx = ctx._make_sub_context(click.Command("sub"))
+        with sub_ctx:
+            pass
+
+        # Re-enter the same child context
+        sub_ctx.__enter__()
+
+        # Parent should have child again
+        with pytest.raises(RuntimeError, match="Cannot close"):
+            ctx.close()
+    finally:
+        sub_ctx.__exit__(None, None, None)
+
