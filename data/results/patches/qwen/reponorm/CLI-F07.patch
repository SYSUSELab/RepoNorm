+def test_validate_nesting_inherited_by_descendants():
+    """Validation flag is inherited by descendants."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.group()
+    def group():
+        pass
+
+    @group.command()
+    def sub():
+        click.echo("sub")
+
+    # Build the full context hierarchy like shell completion does
+    from click.shell_completion import _resolve_context
+    ctx_args = {}
+    ctx = _resolve_context(cli, ctx_args, "cli", ["group", "sub"])
+
+    with ctx:
+        # All contexts in hierarchy should have validate_nesting=True
+        assert ctx.validate_nesting is True
+        assert ctx.parent.validate_nesting is True
+        assert ctx.parent.parent.validate_nesting is True
+
+
+def test_validate_nesting_multiple_children():
+    """Parent with multiple children should track all of them."""
+    @click.group(context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.command()
+    def sub1():
+        click.echo("sub1")
+
+    @cli.command()
+    def sub2():
+        click.echo("sub2")
+
+    ctx = cli.make_context("cli", [], resilient_parsing=True)
+    ctx.__enter__()
+    try:
+        # Create two child contexts
+        sub1_ctx = ctx._make_sub_context(click.Command("sub1"))
+        sub2_ctx = ctx._make_sub_context(click.Command("sub2"))
+
+        with sub1_ctx:
+            pass
+
+        # Parent still has one child open
+        with pytest.raises(RuntimeError, match="Cannot close"):
+            ctx.close()
+    finally:
+        sub2_ctx.__exit__(None, None, None)
+
