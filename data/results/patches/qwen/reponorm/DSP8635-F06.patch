+    @staticmethod
+    def _validate_bounds(min_chars, max_chars):
+        """Validate that instruction length bounds are non-boolean nonnegative integers with min <= max."""
+        # Check for boolean type (bool is a subclass of int in Python)
+        if isinstance(min_chars, bool) or isinstance(max_chars, bool):
+            raise ValueError("min_instr_chars and max_instr_chars must be non-boolean integers")
+        
+        # Check for non-negative integers
+        if not isinstance(min_chars, int) or not isinstance(max_chars, int):
+            raise ValueError("min_instr_chars and max_instr_chars must be integers")
+        
+        if min_chars < 0 or max_chars < 0:
+            raise ValueError("min_instr_chars and max_instr_chars must be non-negative")
+        
+        if min_chars > max_chars:
+            raise ValueError("min_instr_chars must be less than or equal to max_instr_chars")
+
+    def _truncate_at_sentence_boundary(self, text, max_len):
+        """Truncate text at the last sentence boundary that fits within max_len.
+        
+        Returns the truncated text with '...' appended if truncation occurred.
+        If no sentence boundary is found, returns hard-truncated text.
+        """
+        if len(text) <= max_len:
+            return text
+        
+        # Reserve one character for '...'
+        search_limit = max_len - 1
+        
+        # Find the last sentence boundary (. ! or ? followed by whitespace/end)
+        # Pattern matches . ! or ? followed by optional whitespace and either end or more whitespace
+        pattern = r'[.!?](?:\s|$)'
+        match = None
+        for m in re.finditer(pattern, text[:search_limit]):
+            match = m
+            
+        if match:
+            # Truncate at the sentence boundary
+            end_pos = match.end()
+            result = text[:end_pos].rstrip() + "…"
+            return result
+        else:
+            # No sentence boundary found, hard truncate
+            return text[:max_len - 1] + "…"
+
+    def _apply_length_constraints(self, generated_instruction, basic_instruction, lm_kwargs):
+        """Apply instruction length constraints to the generated instruction.
+        
+        Returns the final instruction after applying length constraints.
+        """
+        measured_len = len(generated_instruction)
+        
+        # Handle zero cap case
+        if self.max_instr_chars == 0:
+            if self.verbose:
+                print(f"Instruction truncated to empty string due to zero max length cap. Measured length: {measured_len}")
+            return ""
+        
+        # Check if instruction is too short
+        if measured_len < self.min_instr_chars:
+            if self.verbose:
+                print(f"Generated instruction ({measured_len} chars) shorter than min ({self.min_instr_chars}). Falling back to canonical basic instruction.")
+            return basic_instruction[:self.max_instr_chars] if len(basic_instruction) > self.max_instr_chars else basic_instruction
+        
+        # Check if instruction is too long
+        if measured_len > self.max_instr_chars:
+            if self.rephrase_when_too_long:
+                # Rephrase the instruction
+                original_temp = lm_kwargs.get("temperature")
+                try:
+                    shorten_predictor = dspy.Predict(ShortenInstruction)
+                    with dspy.settings.context(lm=self.prompt_model):
+                        self.prompt_model.kwargs["temperature"] = lm_kwargs.get("temperature", 0.5)
+                        shortened = shorten_predictor(
+                            long_instruction=generated_instruction,
+                            max_chars=self.max_instr_chars,
+                        ).proposed_instruction
+                    
+                    # Strip the output prefix
+                    shortened = strip_prefix(shortened)
+                    
+                    # Check if rephrased instruction is valid
+                    if not shortened or len(shortened) < self.min_instr_chars:
+                        if self.verbose:
+                            print(f"Rephrased instruction empty or too short ({len(shortened) if shortened else 0} chars). Falling back to canonical basic instruction.")
+                        return basic_instruction[:self.max_instr_chars] if len(basic_instruction) > self.max_instr_chars else basic_instruction
+                    
+                    # Hard-truncate if still overlong
+                    if len(shortened) > self.max_instr_chars:
+                        if self.verbose:
+                            print(f"Rephrased instruction ({len(shortened)} chars) still exceeds max ({self.max_instr_chars}). Hard-truncating.")
+                        return shortened[:self.max_instr_chars]
+                    
+                    if self.verbose:
+                        print(f"Rephrased instruction from {measured_len} to {len(shortened)} chars (max: {self.max_instr_chars})")
+                    return shortened
+                finally:
+                    # Restore original temperature
+                    if original_temp is not None:
+                        self.prompt_model.kwargs["temperature"] = original_temp
+                    elif "temperature" in self.prompt_model.kwargs:
+                        del self.prompt_model.kwargs["temperature"]
+            else:
+                # Truncate without rephrasing
+                truncated = self._truncate_at_sentence_boundary(generated_instruction, self.max_instr_chars)
+                if self.verbose:
+                    print(f"Instruction ({measured_len} chars) exceeds max ({self.max_instr_chars}). Truncating to {len(truncated)} chars.")
+                return truncated
+        
+        return generated_instruction
