+class TestMaxInstructHistory:
+    """Tests for max_instruct_history parameter validation and clamping."""
+
+    def test_default_max_instruct_history(self):
+        """Test that default max_instruct_history is 5."""
+        prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+        program = Predict("question -> answer")
+        trainset = []
+
+        proposer = GroundedProposer(prompt_model=prompt_model, program=program, trainset=trainset, verbose=False)
+        assert proposer.max_instruct_history == 5
+
+    def test_valid_integer_values(self):
+        """Test that valid integer values are accepted."""
+        prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+        program = Predict("question -> answer")
+        trainset = []
+
+        for value in [0, 1, 5, 10, 20]:
+            proposer = GroundedProposer(
+                prompt_model=prompt_model, program=program, trainset=trainset, 
+                max_instruct_history=value, verbose=False
+            )
+            assert proposer.max_instruct_history == value
+
+    def test_clamps_to_zero(self):
+        """Test that negative values are clamped to 0."""
+        prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+        program = Predict("question -> answer")
+        trainset = []
+
+        for value in [-1, -10, -100]:
+            proposer = GroundedProposer(
+                prompt_model=prompt_model, program=program, trainset=trainset, 
+                max_instruct_history=value, verbose=False
+            )
+            assert proposer.max_instruct_history == 0
+
+    def test_clamps_to_twenty(self):
+        """Test that values above 20 are clamped to 20."""
+        prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+        program = Predict("question -> answer")
+        trainset = []
+
+        for value in [21, 50, 100]:
+            proposer = GroundedProposer(
+                prompt_model=prompt_model, program=program, trainset=trainset, 
+                max_instruct_history=value, verbose=False
+            )
+            assert proposer.max_instruct_history == 20
+
