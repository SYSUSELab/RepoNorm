+class TestHistoryLimiting:
+    """Tests for verifying that the history limit is applied correctly."""
+
+    def test_max_instruct_history_zero(self):
+        """Test that max_instruct_history=0 results in empty history string."""
+        from dspy.propose.utils import create_predictor_level_history_string
+        
+        prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+        program = Predict("question -> answer")
+        program.predictors()[0].signature = program.predictors()[0].signature.with_instructions("Instruction A")
+        
+        # Create trial logs with multiple programs
+        trial_logs = {
+            1: {"program_path": "/fake/path", "score": 0.5},
+            2: {"program_path": "/fake/path", "score": 0.8},
+        }
+        
+        # Mock deepcopy to return the same program
+        original_deepcopy = program.deepcopy
+        program.deepcopy = lambda: program
+        
+        # Mock load to do nothing
+        original_load = program.load
+        program.load = lambda path: None
+        
+        try:
+            history = create_predictor_level_history_string(program, 0, trial_logs, 0)
+            # With 0 limit, should return empty or minimal history
+            assert history.strip() == "" or len(history.strip()) == 0
+        finally:
+            program.deepcopy = original_deepcopy
+            program.load = original_load
+
+    def test_max_instruct_history_one(self):
+        """Test that max_instruct_history=1 limits to one instruction."""
+        from dspy.propose.utils import create_predictor_level_history_string
+        
+        prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+        program = Predict("question -> answer")
+        program.predictors()[0].signature = program.predictors()[0].signature.with_instructions("Instruction A")
+        
+        # Create trial logs with multiple programs
+        trial_logs = {
+            1: {"program_path": "/fake/path", "score": 0.5},
+            2: {"program_path": "/fake/path", "score": 0.8},
+        }
+        
+        # Mock deepcopy to return the same program
+        original_deepcopy = program.deepcopy
+        program.deepcopy = lambda: program
+        
+        # Mock load to do nothing
+        original_load = program.load
+        program.load = lambda path: None
+        
+        try:
+            history = create_predictor_level_history_string(program, 0, trial_logs, 1)
+            # Should contain at most one instruction
+            score_count = history.count("| Score:")
+            assert score_count <= 1
+        finally:
+            program.deepcopy = original_deepcopy
+            program.load = original_load
