+def _extract_comments(text: str) -> list[str]:
+    """Extract Python-style # comments from text, excluding those inside quoted strings.
+
+    Comments are extracted in source order, trimmed of surrounding whitespace, and
+    non-blank bodies are returned. Escaped quotes inside JSON strings are preserved.
+
+    Args:
+        text: Text containing JSON with optional Python-style # comments.
+
+    Returns:
+        List of comment bodies (strings), in source order.
+    """
+    comments = []
+    in_string = False
+    escape_next = False
+    i = 0
+
+    while i < len(text):
+        char = text[i]
+
+        if escape_next:
+            escape_next = False
+            i += 1
+            continue
+
+        if char == '\\':
+            escape_next = True
+            i += 1
+            continue
+
+        if char == '"' and not in_string:
+            in_string = True
+        elif char == '"' and in_string:
+            in_string = False
+        elif char == '#' and not in_string:
+            # Found a comment, extract until end of line
+            comment_start = i + 1
+            # Find end of line or end of string
+            end_line = text.find('\n', comment_start)
+            if end_line == -1:
+                comment_body = text[comment_start:].strip()
+            else:
+                comment_body = text[comment_start:end_line].strip()
+
+            if comment_body:
+                comments.append(comment_body)
+            i = end_line if end_line != -1 else len(text)
+            continue
+
+        i += 1
+
+    return comments
+
+
+def _combine_comments(comments: list[str] | None) -> str | None:
+    """Combine a list of comment strings into a single document-level annotation.
+
+    Nonblank comment bodies are trimmed of surrounding whitespace and joined with newlines.
+    Empty or blank comments do not contribute to the combined result.
+
+    Args:
+        comments: Optional list of comment strings.
+
+    Returns:
+        Combined comment string with newlines between nonblank entries, or None if empty/None.
+    """
+    if not comments:
+        return None
+
+    # Filter out blank/empty comments and trim each one
+    trimmed = [c.strip() for c in comments if c and c.strip()]
+    if not trimmed:
+        return None
+
+    return '\n'.join(trimmed)
+def _remove_comments(text: str) -> str:
+    """Remove Python-style # comments from text, excluding those inside quoted strings.
+
+    Comments are removed while preserving escaped quotes inside JSON strings.
+
+    Args:
+        text: Text containing JSON with optional Python-style # comments.
+
+    Returns:
+        Text with comments removed.
+    """
+    result = []
+    in_string = False
+    escape_next = False
+    i = 0
+
+    while i < len(text):
+        char = text[i]
+
+        if escape_next:
+            escape_next = False
+            result.append(char)
+            i += 1
+            continue
+
+        if char == '\\':
+            escape_next = True
+            result.append(char)
+            i += 1
+            continue
+
+        if char == '"' and not in_string:
+            in_string = True
+            result.append(char)
+            i += 1
+            continue
+        elif char == '"' and in_string:
+            in_string = False
+            result.append(char)
+            i += 1
+            continue
+        elif char == '#' and not in_string:
+            # Found a comment, skip until end of line
+            # Find end of line or end of string
+            end_line = text.find('\n', i)
+            i = end_line if end_line != -1 else len(text)
+            continue
+
+        result.append(char)
+        i += 1
+
+    return ''.join(result)
+
+
