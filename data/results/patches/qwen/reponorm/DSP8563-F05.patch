+    def format_with_metadata(self) -> list[dict[str, Any]]:
+        """Format ToolCalls with metadata alongside execution fields.
+
+        Returns the same list envelope as format() but includes non-None metadata
+        beside each call's type/function fields, not inside arguments.
+        Unset metadata is omitted; explicit empty strings/lists/dictionaries and zero priority are preserved.
+
+        Returns:
+            Formatted list with metadata included for each call.
+        """
+        formatted_calls = []
+        for tool_call in self.tool_calls:
+            call_dict: dict[str, Any] = {
+                "type": "function",
+                "function": {
+                    "name": tool_call.name,
+                    "arguments": tool_call.args,
+                },
+            }
+
+            # Add metadata fields if they are not None
+            # Preserve explicit empty strings/lists/dictionaries and zero priority
+            if tool_call.note is not None:
+                call_dict["note"] = tool_call.note
+            if tool_call.comment is not None:
+                call_dict["comment"] = tool_call.comment
+            if tool_call.annotation is not None:
+                call_dict["annotation"] = tool_call.annotation
+            if tool_call.tags is not None:
+                call_dict["tags"] = tool_call.tags
+            if tool_call.priority is not None:
+                call_dict["priority"] = tool_call.priority
+            if tool_call.meta is not None:
+                call_dict["meta"] = tool_call.meta
+
+            formatted_calls.append(call_dict)
+
+        return [
+            {
+                "type": "tool_calls",
+                "tool_calls": formatted_calls,
+            }
+        ]
