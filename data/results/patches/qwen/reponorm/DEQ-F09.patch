+# Tests for IsColor validator
+def test_iscolor_hex_valid():
+    """Test valid hex color formats."""
+    assert '#FF5733' == IsColor()
+    assert '#f57' == IsColor()
+    assert '#abc123' == IsColor()
+    assert '#ABC123' == IsColor()
+    assert '#000000' == IsColor()
+    assert '#fff' == IsColor()
+    assert '  #FF5733  ' == IsColor()  # whitespace around value
+
+
+def test_iscolor_hex_invalid():
+    """Test invalid hex color formats."""
+    assert '#GG5733' != IsColor()  # invalid hex digit
+    assert '#FF573' != IsColor()  # wrong length (5 chars)
+    assert '#FF57333' != IsColor()  # wrong length (7 chars)
+    assert '#FF57' != IsColor()  # wrong length (4 chars)
+    assert '#FF5733G' != IsColor()  # invalid hex digit at end
+    assert '' != IsColor()  # empty string
+
+
+def test_iscolor_rgb_valid():
+    """Test valid RGB color formats."""
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'rgb(0, 0, 0)' == IsColor()
+    assert 'rgb(255, 255, 255)' == IsColor()
+    assert 'RGB(255, 87, 51)' == IsColor()  # uppercase
+    assert 'RgB(255, 87, 51)' == IsColor()  # mixed case
+    assert 'rgb( 255 , 87 , 51 )' == IsColor()  # extra whitespace
+    assert 'rgb(255, 87, 51%)' == IsColor()  # mixed integer/percentage
+    assert 'rgb(100%, 50%, 25%)' == IsColor()  # all percentages
+    assert 'rgb(0%, 0%, 0%)' == IsColor()  # zero percentages
+    assert 'rgb(100%, 100%, 100%)' == IsColor()  # max percentages
+
+
+def test_iscolor_rgb_invalid():
+    """Test invalid RGB color formats."""
+    assert 'rgb(256, 87, 51)' != IsColor()  # out of range (>255)
+    assert 'rgb(-1, 87, 51)' != IsColor()  # negative
+    assert 'rgb(255, 87)' != IsColor()  # missing component
+    assert 'rgb(255, 87, 51, 0.5)' != IsColor()  # alpha channel
+    assert 'rgb(255.5, 87, 51)' != IsColor()  # float
+    assert 'rgb(255, 87, 51%)' == IsColor('rgb')  # mixed integer/percentage allowed
+    assert 'rgba(255, 87, 51)' != IsColor()  # alpha variant not supported
+    assert 'rgb(255, 87, 51,' != IsColor()  # malformed
+
+
+def test_iscolor_hsl_valid():
+    """Test valid HSL color formats."""
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'hsl(0, 0%, 0%)' == IsColor()
+    assert 'hsl(360, 100%, 100%)' == IsColor()
+    assert 'HSL(14, 100%, 60%)' == IsColor()  # uppercase
+    assert 'HsL(14, 100%, 60%)' == IsColor()  # mixed case
+    assert 'hsl( 14 , 100% , 60% )' == IsColor()  # extra whitespace
+    assert 'hsl(14deg, 100%, 60%)' == IsColor()  # deg suffix
+    assert 'hsl( 14deg , 100% , 60% )' == IsColor()  # deg with whitespace
+    assert 'hsl(0deg, 0%, 0%)' == IsColor()  # zero with deg
+    assert 'hsl(360deg, 100%, 100%)' == IsColor()  # max with deg
+
+
+def test_iscolor_hsl_invalid():
+    """Test invalid HSL color formats."""
+    assert 'hsl(361, 100%, 60%)' != IsColor()  # hue > 360
+    assert 'hsl(-1, 100%, 60%)' != IsColor()  # negative hue
+    assert 'hsl(14, 101%, 60%)' != IsColor()  # saturation > 100%
+    assert 'hsl(14, 100%, 101%)' != IsColor()  # lightness > 100%
+    assert 'hsl(14, 100%, 60)' != IsColor()  # missing % on components
+    assert 'hsl(14, %, 60%)' != IsColor()  # empty percentage
+    assert 'hsl(14deg, 100%, 60%)' != IsColor('rgb')  # wrong format
+    assert 'hsla(14, 100%, 60%)' != IsColor()  # alpha variant not supported
+    assert 'hsl(14, 100%, 60%, 0.5)' != IsColor()  # alpha channel
+
+
+def test_iscolor_format_specified():
+    """Test format-specific validation."""
+    # Hex format
+    assert '#FF5733' == IsColor('hex')
+    assert '#f57' == IsColor('hex')
+    assert 'FF5733' != IsColor('hex')  # no hash required when format specified
+    
+    # RGB format
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert '#FF5733' != IsColor('rgb')  # hex doesn't match rgb format
+    assert 'hsl(14, 100%, 60%)' != IsColor('rgb')  # hsl doesn't match rgb format
+    
+    # HSL format
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+    assert '#FF5733' != IsColor('hsl')  # hex doesn't match hsl format
+    assert 'rgb(255, 87, 51)' != IsColor('hsl')  # rgb doesn't match hsl format
+
+
+def test_iscolor_non_string():
+    """Test that non-string values don't match."""
+    assert None != IsColor()
+    assert 123 != IsColor()
+    assert [] != IsColor()
+    assert {} != IsColor()
+    assert True != IsColor()
+    assert 3.14 != IsColor()
+
+
+def test_iscolor_named_colors():
+    """Test that named colors don't match."""
+    assert 'red' != IsColor()
+    assert 'blue' != IsColor()
+    assert 'green' != IsColor()
+    assert 'transparent' != IsColor()
+    assert 'white' != IsColor()
+    assert 'black' != IsColor()
+
+
+def test_iscolor_repr():
+    """Test string representation of IsColor."""
+    assert repr(IsColor()) == "IsColor(*)"
+    assert repr(IsColor('hex')) == "IsColor('hex')"
+    assert repr(IsColor('rgb')) == "IsColor('rgb')"
+    assert repr(IsColor('hsl')) == "IsColor('hsl')"
+
+
+def test_iscolor_str():
+    """Test string conversion of IsColor."""
+    assert str(IsColor()) == "IsColor(*)"
+    assert str(IsColor('hex')) == "IsColor('hex')"
+    assert str(IsColor('rgb')) == "IsColor('rgb')"
+    assert str(IsColor('hsl')) == "IsColor('hsl')"
