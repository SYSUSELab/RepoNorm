+class IsColor(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid color code in hex, RGB, or HSL format.
+
+    The validator supports three color formats:
+    - Hex colors: `#FF5733`, `#f57` (with optional `#`)
+    - RGB colors: `rgb(255, 87, 51)` (components can be integers 0-255 or percentages 0-100%)
+    - HSL colors: `hsl(14, 100%, 60%)` (hue with optional `deg` suffix, saturation/lightness as percentages)
+
+    Args:
+        format: The expected color format ('hex', 'rgb', or 'hsl'). If omitted, any supported format is accepted.
+
+    Examples:
+        ```py title="IsColor"
+        from dirty_equals import IsColor
+
+        assert '#FF5733' == IsColor()
+        assert '#f57' == IsColor()
+        assert 'ff5733' == IsColor()  # without hash also works for hex
+        assert 'rgb(255, 87, 51)' == IsColor()
+        assert 'RGB(255, 87, 51)' == IsColor()  # case insensitive
+        assert 'rgb(100%, 50%, 25%)' == IsColor()  # percentage components
+        assert 'hsl(14, 100%, 60%)' == IsColor()
+        assert 'HSL(14, 100%, 60%)' == IsColor()  # case insensitive
+        assert 'hsl(14deg, 100%, 60%)' == IsColor()  # deg suffix allowed
+        assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+        assert 'rgb(255, 87, 51)' != IsColor('hsl')  # wrong format
+        assert 123 != IsColor()  # non-string values don't match
+        ```
+    """
+
+    def __init__(self, format: Optional[Literal['hex', 'rgb', 'hsl']] = None):
+        self.format = format
+        if format is None:
+            super().__init__(plain_repr('*'))
+        else:
+            super().__init__(plain_repr(repr(format)))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        value = other.strip()
+
+        if self.format is None:
+            # Try all formats
+            return (self._is_hex(value)[1] or
+                    self._is_rgb(value) or
+                    self._is_hsl(value))
+        elif self.format == 'hex':
+            has_hash, is_valid = self._is_hex(value)
+            # When format='hex' is specified, # is required
+            return has_hash and is_valid
+        elif self.format == 'rgb':
+            return self._is_rgb(value)
+        elif self.format == 'hsl':
+            return self._is_hsl(value)
+        else:
+            return False
+
+    def _is_hex(self, value: str) -> Tuple[bool, bool]:
+        """Check if value is a valid hex color. Returns (has_hash, is_valid)."""
+        # Check for leading #
+        has_hash = value.startswith('#')
+        if has_hash:
+            value = value[1:]
+
+        # Must be 3 or 6 hex digits
+        if len(value) not in (3, 6):
+            return (has_hash, False)
+
+        # All characters must be hex digits
+        try:
+            int(value, 16)
+            return (has_hash, True)
+        except ValueError:
+            return (has_hash, False)
+
+    def _is_rgb(self, value: str) -> bool:
+        """Check if value is a valid rgb() color."""
+        # Check function name prefix (case-insensitive)
+        if not re.match(r'^rgb\s*\(', value, re.IGNORECASE):
+            return False
+
+        # Extract content inside parentheses
+        match = re.match(r'^rgb\s*\((.+)\)$', value, re.IGNORECASE | re.DOTALL)
+        if not match:
+            return False
+
+        content = match.group(1).strip()
+
+        # Split by comma and validate each component
+        parts = [p.strip() for p in content.split(',')]
+        if len(parts) != 3:
+            return False
+
+        for part in parts:
+            if not self._validate_rgb_component(part):
+                return False
+
+        return True
+
+    def _validate_rgb_component(self, component: str) -> bool:
+        """Validate a single RGB component (integer 0-255 or percentage 0-100%)."""
+        # Check for percentage
+        if component.endswith('%'):
+            percent_str = component[:-1]
+            # Must be 1-3 digits only (no signs, no decimals)
+            if not re.match(r'^\d{1,3}$', percent_str):
+                return False
+            try:
+                percent = int(percent_str)
+                return 0 <= percent <= 100
+            except ValueError:
+                return False
+        else:
+            # Integer component
+            if not re.match(r'^\d{1,3}$', component):
+                return False
+            try:
+                num = int(component)
+                return 0 <= num <= 255
+            except ValueError:
+                return False
+
+    def _is_hsl(self, value: str) -> bool:
+        """Check if value is a valid hsl() color."""
+        # Check function name prefix (case-insensitive)
+        if not re.match(r'^hsl\s*\(', value, re.IGNORECASE):
+            return False
+
+        # Extract content inside parentheses
+        match = re.match(r'^hsl\s*\((.+)\)$', value, re.IGNORECASE | re.DOTALL)
+        if not match:
+            return False
+
+        content = match.group(1).strip()
+
+        # Split by comma and validate each component
+        parts = [p.strip() for p in content.split(',')]
+        if len(parts) != 3:
+            return False
+
+        # Validate hue (first component)
+        if not self._validate_hsl_hue(parts[0]):
+            return False
+
+        # Validate saturation and lightness (percentage components)
+        if not self._validate_hsl_percentage(parts[1]):
+            return False
+        if not self._validate_hsl_percentage(parts[2]):
+            return False
+
+        return True
+
+    def _validate_hsl_hue(self, hue: str) -> bool:
+        """Validate HSL hue component (0-360 with optional deg suffix)."""
+        # Check for deg suffix
+        if hue.lower().endswith('deg'):
+            hue_num = hue[:-3]
+            # No whitespace between number and deg
+            if not hue_num or hue_num[-1].isspace():
+                return False
+        else:
+            hue_num = hue
+
+        # Must be 1-3 digits only (no signs, no decimals)
+        if not re.match(r'^\d{1,3}$', hue_num):
+            return False
+
+        try:
+            num = int(hue_num)
+            return 0 <= num <= 360
+        except ValueError:
+            return False
+
+    def _validate_hsl_percentage(self, component: str) -> bool:
+        """Validate HSL saturation/lightness component (percentage 0-100%)."""
+        if not component.endswith('%'):
+            return False
+
+        percent_str = component[:-1]
+        # Must be 1-3 digits only (no signs, no decimals)
+        if not re.match(r'^\d{1,3}$', percent_str):
+            return False
+
+        try:
+            percent = int(percent_str)
+            return 0 <= percent <= 100
+        except ValueError:
+            return False
