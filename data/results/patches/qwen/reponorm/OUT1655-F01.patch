diff --git a/outlines/types/__init__.py b/outlines/types/__init__.py
index 85af9ad..94fd4c0 100644
--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,13 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Hexadecimal string (optionally prefixed with 0x)
+hex_str = Regex(r"(?:0x)?[0-9a-fA-F]+")
+
+# UUID4 (version 4, variant RFC4122)
+uuid4 = Regex(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}")
+
+# IPv4 address (four dot-separated octets, 0-255, leading zeros allowed)
+ipv4_octet = r"(?:0{1,3}|0{0,2}[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])"
+ipv4 = Regex(rf"{ipv4_octet}\.{ipv4_octet}\.{ipv4_octet}\.{ipv4_octet}")
