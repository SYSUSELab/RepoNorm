+def register_filter(name: str, func: Callable):
+    """Register a custom filter for use in prompts.
+
+    Registered filters are available to all prompts constructed after registration,
+    including those created via bare ``@outlines.prompt``, ``Prompt.from_str``,
+    and ``Prompt.from_file``, including included and inherited file templates.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter to register.
+    func : Callable
+        The filter function to register.
+
+    Notes
+    -----
+    - Registering an existing name replaces its registered callable.
+    - Unregistering an unknown name is a no-op.
+    - Registry changes affect only templates constructed after the change;
+      existing ``Prompt`` instances retain the filter callable captured by
+      their Jinja environment.
+    - The Outlines-specific filters ``name``, ``description``, ``source``,
+      ``signature``, ``schema``, and ``args`` remain protected and cannot
+      be overridden by global filters.
+    """
+    _global_filters[name] = func
+
+
+def unregister_filter(name: str):
+    """Unregister a previously registered filter.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter to unregister.
+
+    Notes
+    -----
+    - Unregistering an unknown name is a no-op.
+    - Changes affect only templates constructed after the unregistration;
+      existing ``Prompt`` instances retain their original filter callables.
+    """
+    _global_filters.pop(name, None)
+
