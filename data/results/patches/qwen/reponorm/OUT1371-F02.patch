+class TestRegisterFilter:
+    """Tests for register_filter and unregister_filter functions."""
+
+    def test_register_filter(self):
+        """Test that a filter can be registered and used in prompts."""
+        from outlines.prompts import _global_filters, Prompt
+        
+        # Register a custom filter
+        def my_upper(value):
+            return value.upper() if isinstance(value, str) else value
+        
+        register_filter("my_upper", my_upper)
+        
+        try:
+            # Verify it's in the global registry
+            assert "my_upper" in _global_filters
+            assert _global_filters["my_upper"] is my_upper
+            
+            # Use it in a prompt
+            template = Prompt._template_from_str("Hello {{ name|my_upper }}!")
+            result = template.render({"name": "world"})
+            assert result == "Hello WORLD!"
+        finally:
+            # Clean up
+            unregister_filter("my_upper")
+    
+    def test_unregister_filter(self):
+        """Test that a filter can be unregistered."""
+        from outlines.prompts import _global_filters, Prompt
+        
+        def my_filter(value):
+            return value
+        
+        register_filter("my_filter", my_filter)
+        assert "my_filter" in _global_filters
+        
+        unregister_filter("my_filter")
+        assert "my_filter" not in _global_filters
+    
+    def test_unregister_unknown_filter_is_noop(self):
+        """Test that unregistering an unknown filter is a no-op."""
+        from outlines.prompts import _global_filters
+        
+        initial_len = len(_global_filters)
+        unregister_filter("nonexistent_filter_xyz")
+        assert len(_global_filters) == initial_len
+    
+    def test_replace_registered_filter(self):
+        """Test that registering an existing name replaces its callable."""
+        from outlines.prompts import _global_filters, Prompt
+        
+        def filter_v1(value):
+            return "v1"
+        
+        def filter_v2(value):
+            return "v2"
+        
+        register_filter("replace_me", filter_v1)
+        assert _global_filters["replace_me"] is filter_v1
+        
+        register_filter("replace_me", filter_v2)
+        assert _global_filters["replace_me"] is filter_v2
+        
+        template = Prompt._template_from_str("{{ value|replace_me }}")
+        result = template.render({"value": "test"})
+        assert result == "v2"
+        
+        unregister_filter("replace_me")
+    
+    def test_protected_filters_cannot_be_overridden(self):
+        """Test that protected filters cannot be overridden by global filters."""
+        from outlines.prompts import _PROTECTED_FILTERS, Prompt
+        
+        def fake_name(value):
+            return "FAKE_NAME"
+        
+        # Try to override a protected filter
+        register_filter("name", fake_name)
+        
+        # The protected filter should still work correctly
+        def sample_fn():
+            pass
+        
+        template = Prompt._template_from_str("{{ sample_fn|name }}")
+        result = template.render(sample_fn=sample_fn)
+        assert result == "sample_fn"  # Should be original function name
+        
+        unregister_filter("name")
+    
+    def test_existing_prompt_retains_original_filter(self):
+        """Test that existing Prompt instances retain their original filters."""
+        from outlines.prompts import _global_filters, Prompt
+        
+        def filter_v1(value):
+            return "v1"
+        
+        def filter_v2(value):
+            return "v2"
+        
+        # Create a prompt with v1
+        register_filter("persist_test", filter_v1)
+        template1 = Prompt._template_from_str("{{ value|persist_test }}")
+        result1 = template1.render({"value": "test"})
+        assert result1 == "v1"
+        
+        # Replace the filter
+        register_filter("persist_test", filter_v2)
+        
+        # Old prompt should still use v1
+        result1_after = template1.render({"value": "test"})
+        assert result1_after == "v1"
+        
+        # New prompt should use v2
+        template2 = Prompt._template_from_str("{{ value|persist_test }}")
+        result2 = template2.render({"value": "test"})
+        assert result2 == "v2"
+        
+        unregister_filter("persist_test")
+    
+    def test_filter_with_include_template(self):
+        """Test that registered filters work with included templates."""
+        from outlines.prompts import _global_filters, Prompt
+        import tempfile
+        
+        def format_value(value):
+            return f"[{value}]"
+        
+        register_filter("format_value", format_value)
+        
+        try:
+            with tempfile.TemporaryDirectory() as tmpdir:
+                # Create an included template file
+                include_path = os.path.join(tmpdir, "include.jinja")
+                with open(include_path, "w") as f:
+                    f.write("{{ value|format_value }}")
+                
+                # Create main template that includes the other
+                main_path = os.path.join(tmpdir, "main.jinja")
+                with open(main_path, "w") as f:
+                    f.write("{% include 'include.jinja' %}")
+                
+                template = Prompt._template_from_file(Path(main_path))
+                result = template.render({"value": "hello"})
+                assert result == "[hello]"
+        finally:
+            unregister_filter("format_value")
+    
+    def test_filter_with_include_template_nested(self):
+        """Test that registered filters work with nested included templates."""
+        from outlines.prompts import _global_filters, Prompt
+        import tempfile
+        
+        def format_value(value):
+            return f"<{value}>"
+        
+        register_filter("format_value", format_value)
+        
+        try:
+            with tempfile.TemporaryDirectory() as tmpdir:
+                # Create an inner template
+                inner_path = os.path.join(tmpdir, "inner.jinja")
+                with open(inner_path, "w") as f:
+                    f.write("{{ value|format_value }}")
+                
+                # Create a middle template that includes the inner one
+                middle_path = os.path.join(tmpdir, "middle.jinja")
+                with open(middle_path, "w") as f:
+                    f.write("Middle: {% include 'inner.jinja' %}")
+                
+                # Create main template that includes the middle one
+                main_path = os.path.join(tmpdir, "main.jinja")
+                with open(main_path, "w") as f:
+                    f.write("Main: {% include 'middle.jinja' %}")
+                
+                template = Prompt._template_from_file(Path(main_path))
+                result = template.render({"value": "test"})
+                assert result == "Main: Middle: <test>"
+        finally:
+            unregister_filter("format_value")
