           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    By default, the input is sorted by the grouping key before grouping,
+    so groups appear in sorted order. Set ``stable=False`` to preserve
+    the first-seen order of keys instead. When ``stable=False``, equal
+    keys merge even when not adjacent or not the same object; the first
+    original key object is retained as the grouper. This supports
+    equality-comparable keys including lists and dictionaries, and
+    mixtures with hashable keys, without requiring ordering or hashing
+    or changing the keys. String representations must not define key
+    equality.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
+
+    .. versionadded:: NEXTVERSION
+        Added the ``stable`` parameter.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
 
+    if stable:
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+
+    # First-seen order: no sorting required
+    # Use linear search for unhashable keys (lists, dicts, etc.)
+    seen_keys: list[t.Any] = []
+    result: list[t.Tuple[t.Any, list[V]]] = []
+
+    for item in value:
+        key = expr(item)
+        # Check if key already exists using equality comparison
+        found = False
+        for i, existing_key in enumerate(seen_keys):
+            if key == existing_key:
+                result[i][1].append(item)
+                found = True
+                break
+        if not found:
+            seen_keys.append(key)
+            result.append((key, [item]))
+
+    return [_GroupTuple(key, values) for key, values in result]
 
