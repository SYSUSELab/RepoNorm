+import pytest
+import dspy
+from dspy.primitives.prediction import Prediction
+
+
+class TestPredictionCacheUsage:
+    """Tests for Prediction.get_cache_usage() and set_cache_usage() functionality."""
+
+    def test_initial_cache_usage_none(self):
+        """Test that initial cache_usage is None."""
+        pred = Prediction(name="test", value=42)
+        assert pred.get_cache_usage() is None
+
+    def test_set_and_get_cache_usage(self):
+        """Test setting and getting cache usage."""
+        pred = Prediction(name="test", value=42)
+        
+        cache_usage = {
+            "hits": 5,
+            "mem_hits": 3,
+            "disk_hits": 2,
+            "misses": 1,
+        }
+        pred.set_cache_usage(cache_usage)
+        
+        result = pred.get_cache_usage()
+        assert result == cache_usage
+
+    def test_cache_usage_deep_copy_protection(self):
+        """Test that get_cache_usage returns a deep copy to prevent mutation."""
+        pred = Prediction(name="test", value=42)
+        
+        cache_usage = {
+            "hits": 5,
+            "mem_hits": 3,
+            "disk_hits": 2,
+            "misses": 1,
+        }
+        pred.set_cache_usage(cache_usage)
+        
+        # Get the cache usage and mutate it
+        result = pred.get_cache_usage()
+        result["hits"] = 999
+        
+        # Verify original value is preserved
+        result2 = pred.get_cache_usage()
+        assert result2["hits"] == 5
+
+    def test_cache_usage_with_track_usage(self):
+        """Test that cache_usage is captured when track_usage=True."""
+        class SimpleModule(dspy.Module):
+            def forward(self, x="test"):
+                return dspy.Prediction(result="success")
+
+        module = SimpleModule()
+        
+        # Without track_usage
+        pred = module(x="test")
+        assert pred.get_cache_usage() is None
+        
+        # With track_usage
+        with dspy.settings.context(track_usage=True):
+            pred = module(x="test")
+            assert pred.get_cache_usage() is not None
+            assert isinstance(pred.get_cache_usage(), dict)
+            assert "hits" in pred.get_cache_usage()
+            assert "mem_hits" in pred.get_cache_usage()
+            assert "disk_hits" in pred.get_cache_usage()
+            assert "misses" in pred.get_cache_usage()
+
+    def test_cache_usage_independent_per_call(self):
+        """Test that each call has independent cache usage snapshot."""
+        class SimpleModule(dspy.Module):
+            def forward(self, x="test"):
+                return dspy.Prediction(result="success")
+
+        module = SimpleModule()
+        
+        with dspy.settings.context(track_usage=True):
+            pred1 = module(x="test1")
+            pred2 = module(x="test2")
+            
+            # Each prediction should have its own snapshot
+            assert pred1.get_cache_usage() is not None
+            assert pred2.get_cache_usage() is not None
+            
+            # They should be independent (different objects)
+            assert pred1.get_cache_usage() is not pred2.get_cache_usage()
+
+    def test_cache_usage_preserves_existing_lm_usage(self):
+        """Test that cache_usage doesn't interfere with lm_usage."""
+        class SimpleModule(dspy.Module):
+            def forward(self, x="test"):
+                return dspy.Prediction(result="success")
+
+        module = SimpleModule()
+        
+        with dspy.settings.context(track_usage=True):
+            pred = module(x="test")
+            
+            # Both lm_usage and cache_usage should be available
+            lm_usage = pred.get_lm_usage()
+            cache_usage = pred.get_cache_usage()
+            
+            assert lm_usage is not None or lm_usage is None  # May be empty dict
+            assert cache_usage is not None
