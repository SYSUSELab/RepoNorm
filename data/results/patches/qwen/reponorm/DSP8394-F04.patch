+import pytest
+import threading
+import tempfile
+import dspy
+from dspy.clients.cache import Cache
+
+
+class TestCacheStats:
+    """Tests for cache.stats() and cache.reset_stats() functionality."""
+
+    def setup_method(self):
+        """Set up test fixtures."""
+        self.temp_dir = tempfile.mkdtemp()
+        self.cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir=self.temp_dir)
+
+    def test_initial_stats(self):
+        """Test that initial stats are all zeros."""
+        stats = self.cache.stats()
+        assert stats == {
+            "hits": 0,
+            "mem_hits": 0,
+            "disk_hits": 0,
+            "misses": 0,
+        }
+
+    def test_record_memory_hit(self):
+        """Test recording a memory hit."""
+        self.cache._record_hit("memory")
+        stats = self.cache.stats()
+        assert stats["hits"] == 1
+        assert stats["mem_hits"] == 1
+        assert stats["disk_hits"] == 0
+        assert stats["misses"] == 0
+
+    def test_record_disk_hit(self):
+        """Test recording a disk hit."""
+        self.cache._record_hit("disk")
+        stats = self.cache.stats()
+        assert stats["hits"] == 1
+        assert stats["mem_hits"] == 0
+        assert stats["disk_hits"] == 1
+        assert stats["misses"] == 0
+
+    def test_record_miss(self):
+        """Test recording a miss."""
+        self.cache._record_miss()
+        stats = self.cache.stats()
+        assert stats["hits"] == 0
+        assert stats["mem_hits"] == 0
+        assert stats["disk_hits"] == 0
+        assert stats["misses"] == 1
+
+    def test_hits_equals_mem_hits_plus_disk_hits(self):
+        """Test that hits equals mem_hits + disk_hits."""
+        self.cache._record_hit("memory")
+        self.cache._record_hit("memory")
+        self.cache._record_hit("disk")
+        stats = self.cache.stats()
+        assert stats["hits"] == 3
+        assert stats["mem_hits"] == 2
+        assert stats["disk_hits"] == 1
+        assert stats["hits"] == stats["mem_hits"] + stats["disk_hits"]
+
+    def test_reset_stats(self):
+        """Test resetting stats without clearing cache entries."""
+        self.cache._record_hit("memory")
+        self.cache._record_hit("disk")
+        self.cache._record_miss()
+        
+        # Verify stats before reset
+        stats_before = self.cache.stats()
+        assert stats_before["hits"] == 2
+        assert stats_before["misses"] == 1
+        
+        # Reset stats
+        self.cache.reset_stats()
+        
+        # Verify stats after reset
+        stats_after = self.cache.stats()
+        assert stats_after == {
+            "hits": 0,
+            "mem_hits": 0,
+            "disk_hits": 0,
+            "misses": 0,
+        }
+        
+        # Verify cache entries still exist
+        request = {"key": "value"}
+        self.cache.put(request, "cached_value")
+        result = self.cache.get(request)
+        assert result == "cached_value"
+
+    def test_stats_returns_fresh_dictionary(self):
+        """Test that stats returns a fresh dictionary each time."""
+        self.cache._record_hit("memory")
+        
+        stats1 = self.cache.stats()
+        stats1["hits"] = 999  # Mutate the returned dict
+        
+        stats2 = self.cache.stats()
+        assert stats2["hits"] == 1  # Original value should be preserved
+
+    def test_get_records_memory_hit(self):
+        """Test that get() records a memory hit when value is in memory cache."""
+        self.cache.reset_stats()
+        request = {"key": "value"}
+        self.cache.put(request, "cached_value")
+        
+        result = self.cache.get(request)
+        assert result == "cached_value"
+        
+        stats = self.cache.stats()
+        assert stats["mem_hits"] == 1
+        assert stats["hits"] == 1
+
+    def test_get_records_miss(self):
+        """Test that get() records a miss when key doesn't exist."""
+        self.cache.reset_stats()
+        request = {"key": "nonexistent"}
+        
+        result = self.cache.get(request)
+        assert result is None
+        
+        stats = self.cache.stats()
+        assert stats["misses"] == 1
+        assert stats["hits"] == 0
+
+    def test_concurrent_access(self):
+        """Test thread-safe access to stats counters."""
+        cache = Cache(enable_disk_cache=False, enable_memory_cache=True, disk_cache_dir=self.temp_dir)
+        errors = []
+
+        def record_hits():
+            try:
+                for _ in range(100):
+                    cache._record_hit("memory")
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=record_hits) for _ in range(10)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        assert len(errors) == 0, f"Thread safety errors: {errors}"
+        
+        stats = cache.stats()
+        assert stats["mem_hits"] == 1000
+        assert stats["hits"] == 1000
+
+    def test_put_does_not_count_as_read(self):
+        """Test that put() does not count as a read operation."""
+        self.cache.reset_stats()
+        request = {"key": "value"}
+        self.cache.put(request, "cached_value")
+        
+        stats = self.cache.stats()
+        assert stats["hits"] == 0
+        assert stats["misses"] == 0
+        assert stats["mem_hits"] == 0
+        assert stats["disk_hits"] == 0
+
+    def test_multiple_gets_accumulate_correctly(self):
+        """Test that multiple gets accumulate statistics correctly."""
+        self.cache.reset_stats()
+        request = {"key": "value"}
+        self.cache.put(request, "cached_value")
+        
+        # Multiple hits on same key
+        self.cache.get(request)
+        self.cache.get(request)
+        self.cache.get(request)
+        
+        stats = self.cache.stats()
+        assert stats["mem_hits"] == 3
+        assert stats["hits"] == 3
+        assert stats["misses"] == 0
+
+    def test_mixed_operations(self):
+        """Test mixed operations (hits and misses)."""
+        self.cache.reset_stats()
+        
+        # Put some values
+        self.cache.put({"key1": "v1"}, "value1")
+        self.cache.put({"key2": "v2"}, "value2")
+        
+        # Get existing keys (hits)
+        self.cache.get({"key1": "v1"})
+        self.cache.get({"key2": "v2"})
+        
+        # Get non-existing keys (misses)
+        self.cache.get({"key3": "v3"})
+        self.cache.get({"key4": "v4"})
+        
+        stats = self.cache.stats()
+        assert stats["mem_hits"] == 2
+        assert stats["hits"] == 2
+        assert stats["misses"] == 2
