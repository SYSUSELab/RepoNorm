+    def _calculate_cache_delta(self, usage_tracker) -> Optional[dict]:
+        """Calculate the delta between cached and current cache statistics.
+        
+        Returns a dictionary with cache statistics for this call, or None if
+        no cache was available or tracking wasn't enabled.
+        """
+        from dspy.clients.cache import request_cache
+        
+        # Get the baseline cache snapshot captured at tracker creation
+        baseline = usage_tracker.get_cache_usage()
+        if baseline is None:
+            return None
+        
+        # Get current cache stats
+        cache = dspy.cache
+        if cache is None:
+            return None
+        
+        current = cache.stats()
+        
+        # Calculate delta (current - baseline)
+        delta = {
+            "hits": current["hits"] - baseline["hits"],
+            "mem_hits": current["mem_hits"] - baseline["mem_hits"],
+            "disk_hits": current["disk_hits"] - baseline["disk_hits"],
+            "misses": current["misses"] - baseline["misses"],
+        }
+        
+        return delta
