+    def test_groupby_separator(self, env):
+        """Test groupby with custom separator parameter."""
+        # Default dot separator - accesses nested attributes
+        result = env.from_string(
+            "{{ items|groupby(attribute='a.b')|list }}"
+        ).render(items=[{"a": {"b": 1}}, {"a": {"b": 2}}, {"a": {"b": 1}}])
+        assert "(1," in result and "(2," in result
+
+        # Custom separator makes dots literal
+        class Item:
+            def __init__(self, name):
+                self.name = name
+        items = [Item("x"), Item("y"), Item("x")]
+        with pytest.raises(Exception):
+            env.from_string(
+                "{{ items|groupby(attribute='literal.key', separator='__')|list }}"
+            ).render(items=items)
+
+        # Multi-character separator
+        result = env.from_string(
+            "{{ items|groupby(attribute='a__b', separator='__')|list }}"
+        ).render(items=[{"a": {"b": 1}}, {"a": {"b": 2}}, {"a": {"b": 1}}])
+        assert "(1," in result and "(2," in result
+
+    def test_map_separator(self, env):
+        """Test map with custom separator parameter."""
+        # Default dot separator
+        result = env.from_string(
+            "{{ items|map(attribute='x.y', separator='.')|list }}"
+        ).render(items=[{"x": {"y": 1}}, {"x": {"y": 2}}])
+        assert "[1, 2]" in result
+
+        # Empty separator raises error on evaluation
+        with pytest.raises(FilterArgumentError):
+            env.from_string(
+                "{{ items|map(attribute='foo', separator='')|list }}"
+            ).render(items=[{"foo": 1}])
+
+        # Empty input with empty separator remains lazy
+        result = env.from_string(
+            "{{ items|map(attribute='foo', separator='')|list }}"
+        ).render(items=[])
+        assert result == "[]"
+
+        # Custom separator makes dots literal
+        class ItemWithDots:
+            def __init__(self, val):
+                self._data = {"key.with.dots": val}
+            def __getitem__(self, key):
+                return self._data.get(key)
+            def __repr__(self):
+                return f"ItemWithDots({self._data!r})"
+        
+        items = [ItemWithDots(1), ItemWithDots(2)]
+        result = env.from_string(
+            "{{ items|map(attribute='key.with.dots', separator='|')|list }}"
+        ).render(items=items)
+        assert "[1, 2]" in result
+
+    def test_map_named_filter_forwards_separator(self, env):
+        """Test that map with named filter forwards separator kwarg."""
+        # This should fail because do_upper doesn't accept **kwargs
+        with pytest.raises(TypeError, match="separator"):
+            env.from_string(
+                "{{ items|map('upper', separator='.')|list }}"
+            ).render(items=["hello", "world"])
+
+        # Without separator, it should work
+        result = env.from_string(
+            "{{ items|map('upper')|list }}"
+        ).render(items=["hello", "world"])
+        assert "['HELLO', 'WORLD']" in result
+
