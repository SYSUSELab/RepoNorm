+def _make_priority_gettext(
+    gettext: t.Callable[[str], str],
+    priority_gettext: t.Optional[t.Callable[[str, int], t.Optional[str]]],
+    newstyle: bool = False,
+) -> t.Callable[..., str]:
+    """Wrap gettext with priority fallback support."""
+    @pass_context
+    def priority_aware_gettext(
+        __context: Context, __string: str, **variables: t.Any
+    ) -> str:
+        # Get priority from keyword argument or default to 0
+        priority = variables.pop("_priority", 0)
+        
+        # Filter out any extra kwargs that the underlying gettext might not accept
+        # by creating a clean dict for the underlying call
+        clean_variables = {k: v for k, v in variables.items() if k != "_priority"}
+        
+        # Convert priority to int; invalid/None/negative become 0
+        try:
+            priority = int(priority) if priority is not None else 0
+        except (TypeError, ValueError):
+            priority = 0
+        
+        # Ensure non-negative
+        if priority < 0:
+            priority = 0
+        
+        # Determine max level: min(converted_priority, 9)
+        max_level = min(priority, 9)
+        
+        # Try levels in increasing order
+        result = None
+        for level in range(max_level + 1):
+            if priority_gettext is not None:
+                candidate = priority_gettext(__string, level)
+            else:
+                # Fall back to regular gettext if no priority resolver installed
+                # For newstyle, use __context.call to handle context automatically
+                # For oldstyle, pass context directly since the function expects it
+                if newstyle:
+                    candidate = __context.call(gettext, __string, **variables)
+                else:
+                    candidate = gettext(__context, __string)
+            
+            # Check if result differs from source (miss detection)
+            if candidate is not None and candidate != __string:
+                result = candidate
+                break
+        
+        # If all levels returned miss (same as source), use last result
+        if result is None:
+            if newstyle:
+                result = __context.call(gettext, __string, **variables)
+            else:
+                result = gettext(__context, __string)
+        
+        rv = result
+        if __context.eval_ctx.autoescape:
+            rv = Markup(rv)
+        return rv % variables  # type: ignore
+
+    return priority_aware_gettext
+
+
+def _make_priority_ngettext(
+    ngettext: t.Callable[[str, str, int], str],
+    priority_ngettext: t.Optional[t.Callable[[str, str, int, int], t.Optional[str]]],
+    newstyle: bool = False,
+) -> t.Callable[..., str]:
+    """Wrap ngettext with priority fallback support."""
+    @pass_context
+    def priority_aware_ngettext(
+        __context: Context,
+        __singular: str,
+        __plural: str,
+        __num: int,
+        **variables: t.Any,
+    ) -> str:
+        # Get priority from keyword argument or default to 0
+        priority = variables.pop("_priority", 0)
+        
+        # Convert priority to int; invalid/None/negative become 0
+        try:
+            priority = int(priority) if priority is not None else 0
+        except (TypeError, ValueError):
+            priority = 0
+        
+        # Ensure non-negative
+        if priority < 0:
+            priority = 0
+        
+        # Determine max level: min(converted_priority, 9)
+        max_level = min(priority, 9)
+        
+        # Try levels in increasing order
+        result = None
+        for level in range(max_level + 1):
+            if priority_ngettext is not None:
+                candidate = priority_ngettext(__singular, __plural, __num, level)
+            else:
+                # Fall back to regular ngettext if no priority resolver installed
+                # For newstyle, use __context.call to handle context automatically
+                # For oldstyle, pass context directly since the function expects it
+                if newstyle:
+                    candidate = __context.call(ngettext, __singular, __plural, __num, **variables)
+                else:
+                    candidate = ngettext(__context, __singular, __plural, __num)
+            
+            # Check if result differs from applicable source message
+            expected = __singular if __num == 1 else __plural
+            if candidate is not None and candidate != expected:
+                result = candidate
+                break
+        
+        # If all levels returned miss (same as source), use last result
+        if result is None:
+            if newstyle:
+                result = __context.call(ngettext, __singular, __plural, __num, **variables)
+            else:
+                result = ngettext(__context, __singular, __plural, __num)
+        
+        variables.setdefault("num", __num)
+        rv = result
+        if __context.eval_ctx.autoescape:
+            rv = Markup(rv)
+        return rv % variables  # type: ignore
+
+    return priority_aware_ngettext
+
