+            "foo", "baz", "qux", "test.html"
+        ]
+        # Multiple . and .. mixed
+        assert split_template_path("./foo/./bar/../baz/./test.html") == [
+            "foo", "baz", "test.html"
+        ]
+
+    def test_trailing_slash(self):
+        """Trailing slashes should not cause issues."""
+        assert split_template_path("foo/bar.html/") == ["foo", "bar.html"]
+        assert split_template_path("foo/bar.html//") == ["foo", "bar.html"]
+
+    def test_foo_dotdot_returns_empty(self):
