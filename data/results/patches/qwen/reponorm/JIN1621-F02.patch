+    def test_normalized_vs_original_equivalence(self):
+        """Different spellings should resolve to same normalized form."""
+        # Group 1: Simple path with various separator styles
+        variants_group1 = [
+            "foo/bar.html",
+            "foo\\bar.html",
+            "foo/\\bar.html",
+            "foo\\.\\bar.html",
+            "./foo/bar.html",
+            "foo/./bar.html",
+        ]
+        results_group1 = [split_template_path(v) for v in variants_group1]
+        first = results_group1[0]
+        for i, r in enumerate(results_group1[1:], start=1):
+            assert r == first, f"group1 variant {i} {variants_group1[i]!r} != {first!r}"
+
+        # Group 2: Path with .. that cancels a segment
+        variants_group2 = [
+            "foo/bar/../test.html",
+            "foo\\bar\\..\\test.html",
+            "foo/\\bar\\/../test.html",
+            "./foo/bar/../test.html",
+            "foo/./bar/../test.html",
+        ]
+        results_group2 = [split_template_path(v) for v in variants_group2]
+        first = results_group2[0]
+        for i, r in enumerate(results_group2[1:], start=1):
