+
+    def test_empty_string(self):
+        """Empty string should return empty list (no segments)."""
+        assert split_template_path("") == []
+
+    def test_only_dot(self):
+        """Just . should return empty list."""
+        assert split_template_path(".") == []
+
+    def test_only_dots(self):
