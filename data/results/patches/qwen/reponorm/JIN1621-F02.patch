+    """Split a path into segments and perform normalization.
+    
+    Both ``/`` and ``\\`` are treated as logical separators. Empty segments
+    and ``.`` are removed. Internal ``..`` segments remove the preceding
+    ordinary segment.
+    
+    Raises :exc:`TemplateNotFound` if:
+    
+    - The path starts with ``/``, ``\\``, or ``\\\\`` (UNC form).
+    - The path starts with a drive prefix like ``C:``.
+    - An internal ``..`` would pop beyond the logical root.
     """
+    # Check for absolute paths (starting with / or \)
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+    
+    # Check for UNC forms (\\server\share)
+    if template.startswith("\\\\"):
+        raise TemplateNotFound(template)
+    
+    # Check for drive prefix (e.g., C:, D:)
+    if len(template) >= 2 and template[1] == ":" and template[0].isalpha():
+        raise TemplateNotFound(template)
+    
+    # Replace all backslashes with forward slashes for uniform processing
+    normalized = template.replace("\\", "/")
+    
+    # Split by /
+    parts = normalized.split("/")
+    
+    # Process each part
     pieces = []
-    for piece in template.split("/"):
-        if (
-            os.path.sep in piece
-            or (os.path.altsep and os.path.altsep in piece)
-            or piece == os.path.pardir
-        ):
-            raise TemplateNotFound(template)
-        elif piece and piece != ".":
+    for piece in parts:
+        if piece == "" or piece == ".":
+            continue
+        elif piece == "..":
+            if pieces:
+                pieces.pop()
+            else:
+                raise TemplateNotFound(template)
+        else:
             pieces.append(piece)
+    
     return pieces
 
 
