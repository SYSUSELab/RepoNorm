+class TestTemplatePathNormalization:
+    """Tests for normalized template path handling."""
+
+    def test_simple_path(self):
+        """Simple paths should work as before."""
+        assert split_template_path("foo.html") == ["foo.html"]
+        assert split_template_path("foo/bar.html") == ["foo", "bar.html"]
+        assert split_template_path("a/b/c/d.html") == ["a", "b", "c", "d.html"]
+
+    def test_dot_segments_removed(self):
+        """Dot segments should be removed during normalization."""
+        assert split_template_path("./foo.html") == ["foo.html"]
+        assert split_template_path("foo/./bar.html") == ["foo", "bar.html"]
+        assert split_template_path("./foo/./bar.html") == ["foo", "bar.html"]
+
+    def test_backslash_as_separator(self):
+        """Backslashes should be treated as separators."""
+        assert split_template_path("foo\\bar.html") == ["foo", "bar.html"]
+        assert split_template_path("foo\\bar\\baz.html") == ["foo", "bar", "baz.html"]
+
+    def test_mixed_separators(self):
+        """Mixed separators should be handled consistently."""
+        assert split_template_path("foo/\\bar.html") == ["foo", "bar.html"]
+        assert split_template_path("foo\\\\bar/baz.html") == ["foo", "bar", "baz.html"]
+
+    def test_double_dot_cancels_segment(self):
+        """Double dot should cancel preceding segment."""
+        assert split_template_path("foo/../bar.html") == ["bar.html"]
+        assert split_template_path("foo/bar/../baz.html") == ["foo", "baz.html"]
+        assert split_template_path("a/b/c/../d.html") == ["a", "b", "d.html"]
+
+    def test_backslash_double_dot(self):
+        """Backslash double dot should work the same."""
+        assert split_template_path("foo\\..\\bar.html") == ["bar.html"]
+        assert split_template_path("foo\\bar\\..\\baz.html") == ["foo", "baz.html"]
+
+    def test_mixed_double_dot(self):
+        """Mixed separators with double dots should work."""
+        assert split_template_path("foo/..\\bar.html") == ["bar.html"]
+        assert split_template_path("foo\\../bar.html") == ["bar.html"]
+
+    def test_empty_segments_removed(self):
+        """Empty segments from consecutive separators should be removed."""
+        assert split_template_path("foo//bar.html") == ["foo", "bar.html"]
+        assert split_template_path("foo///bar.html") == ["foo", "bar.html"]
+        assert split_template_path("foo\\/bar.html") == ["foo", "bar.html"]
+
+    def test_leading_slash_rejected(self):
+        """Leading slash should raise TemplateNotFound."""
+        with pytest.raises(TemplateNotFound, match="/"):
+            split_template_path("/foo.html")
+        with pytest.raises(TemplateNotFound, match="/foo/bar.html"):
+            split_template_path("/foo/bar.html")
+
+    def test_leading_backslash_rejected(self):
+        """Leading backslash should raise TemplateNotFound."""
+        with pytest.raises(TemplateNotFound, match="\\\\"):
+            split_template_path("\\foo.html")
+        with pytest.raises(TemplateNotFound, match="\\\\foo/bar.html"):
+            split_template_path("\\foo/bar.html")
+
+    def test_unc_form_rejected(self):
+        r"""UNC form (\\servershare) should raise TemplateNotFound."""
+        with pytest.raises(TemplateNotFound, match="\\\\\\\\"):
+            split_template_path("\\\\server\\share\\template.html")
+
+    def test_drive_prefix_rejected(self):
+        """Drive prefix like C: should raise TemplateNotFound."""
+        with pytest.raises(TemplateNotFound, match="C:"):
+            split_template_path("C:\\foo.html")
+        with pytest.raises(TemplateNotFound, match="D:"):
+            split_template_path("D:/foo/bar.html")
+
+    def test_leading_dotdot_rejected(self):
+        """Leading .. should raise TemplateNotFound."""
+        with pytest.raises(TemplateNotFound, match=".."):
+            split_template_path("../foo.html")
+        with pytest.raises(TemplateNotFound, match=".."):
+            split_template_path("..\\foo.html")
+
+    def test_internal_dotdot_beyond_root_rejected(self):
+        """Internal .. that would pop beyond root should raise."""
+        with pytest.raises(TemplateNotFound, match=".."):
+            split_template_path("foo/bar/../../../baz.html")
+        with pytest.raises(TemplateNotFound, match=".."):
+            split_template_path("a/b/c/../../../../../d.html")
+
+    def test_multiple_consecutive_dots(self):
+        """Multiple consecutive .. should be processed sequentially."""
+        # a/b/c/../../../d.html -> d.html (3 pops from 3 segments)
+        assert split_template_path("a/b/c/../../../d.html") == ["d.html"]
+        # a/b/../../c.html -> c.html (2 pops from 2 segments)
+        assert split_template_path("a/b/../../c.html") == ["c.html"]
+
+    def test_only_dotdot_rejected(self):
+        """Just .. should raise TemplateNotFound."""
+        with pytest.raises(TemplateNotFound, match=".."):
+            split_template_path("..")
+        with pytest.raises(TemplateNotFound, match=".."):
+            split_template_path("..\\")
+
+    def test_complex_normalization(self):
