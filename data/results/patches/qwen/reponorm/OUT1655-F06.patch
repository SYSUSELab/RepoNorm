diff --git a/outlines/types/__init__.py b/outlines/types/__init__.py
index 85af9ad..ac4b737 100644
--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,13 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches HTTP/HTTPS URLs with a restricted subset of valid hosts:
+# - scheme: exactly lowercase http or https
+# - host: localhost, DNS name (at least 2 labels), or IPv4 address
+# - DNS labels: ASCII letters/digits/internal hyphens, alphanumeric start/end, max 63 chars
+# - IPv4: canonical decimal (0-255, no leading zeros)
+# - port: optional, 1-5 decimal digits
+# - path: optional, slash-led, URL punctuation but no whitespace
+# - query/fragment: optional, must have at least one non-whitespace char when present
+url = Regex(r"^https?://((?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)(?!\d|\.)|localhost|(?=.*[a-zA-Z])[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*)(?::\d{1,5})?(?:/[^?\s#]*)?(?:\?[^\s]+)?(?:#[^\s]+)?$")
diff --git a/tests/types/test_custom_types.py b/tests/types/test_custom_types.py
index 691b681..597f853 100644
--- a/tests/types/test_custom_types.py
+++ b/tests/types/test_custom_types.py
@@ -108,3 +108,94 @@ def test_type_enum(custom_type, test_string, should_match):
 
     does_match = test_string in custom_type.__members__
     assert does_match is should_match
+
+
+@pytest.mark.parametrize(
+    "custom_type,test_string,should_match",
+    [
+        # Valid URLs - localhost
+        (types.url, "http://localhost", True),
+        (types.url, "https://localhost", True),
+        (types.url, "http://localhost:8080", True),
+        (types.url, "https://localhost:8080/path", True),
+        (types.url, "http://localhost/path?query=value", True),
+        (types.url, "https://localhost/path#fragment", True),
+        (types.url, "http://localhost/path?query=value#fragment", True),
+        (types.url, "http://localhost/", True),
+        (types.url, "http://localhost/path/to/resource", True),
+        
+        # Valid URLs - DNS names
+        (types.url, "http://example.com", True),
+        (types.url, "https://sub.example.com", True),
+        (types.url, "http://example.co.uk", True),
+        (types.url, "http://my-site.example.org", True),
+        (types.url, "http://a.b", True),  # minimum 2 labels
+        (types.url, "http://a-b.c-d", True),  # hyphens in labels
+        (types.url, "http://example.com/path", True),
+        (types.url, "http://example.com:3000/api", True),
+        
+        # Valid URLs - IPv4
+        (types.url, "http://192.168.1.1", True),
+        (types.url, "http://192.168.1.1:8080/path", True),
+        (types.url, "http://1.2.3.4", True),
+        (types.url, "http://0.0.0.0", True),
+        (types.url, "http://255.255.255.255", True),
+        (types.url, "http://10.0.0.1:99999", True),  # max 5 digit port
+        
+        # Invalid - uppercase scheme
+        (types.url, "HTTP://localhost", False),
+        (types.url, "HTTPS://localhost", False),
+        
+        # Invalid - wrong scheme
+        (types.url, "ftp://localhost", False),
+        (types.url, "ws://localhost", False),
+        
+        # Invalid - user info
+        (types.url, "http://user@localhost", False),
+        (types.url, "http://user:pass@localhost", False),
+        
+        # Invalid - hostname issues
+        (types.url, "http://local_host", False),  # underscore
+        (types.url, "http://localhost.local.", False),  # trailing dot
+        
+        # Invalid - port issues
+        (types.url, "http://localhost:abc", False),  # non-digit port
+        (types.url, "http://localhost:", False),  # empty port after colon
+        
+        # Invalid - IP issues
+        (types.url, "http://192.168.1.256", False),  # octet > 255
+        (types.url, "http://192.168.01.1", False),  # leading zero
+        (types.url, "http://192.168.1", False),  # incomplete IP
+        (types.url, "http://192.168.1.1.1", False),  # too many octets
+        
+        # Invalid - whitespace
+        (types.url, "http://localhost ", False),  # trailing space
+        (types.url, "http://localhost/path with spaces", False),  # space in path
+        (types.url, "http://localhost/path?q=hello world", False),  # space in query
+        
+        # Invalid - empty query/fragment
+        (types.url, "http://localhost?", False),
+        (types.url, "http://localhost#", False),
+        (types.url, "http://localhost/path?", False),
+        (types.url, "http://localhost/path#", False),
+        
+        # Edge cases - special chars in path/query
+        (types.url, "http://localhost/path?query=value&other=thing", True),  # & in query
+        (types.url, "http://localhost/path?key=value#section", True),  # # in fragment
+        (types.url, "http://localhost/path%20encoded", True),  # % encoding in path
+        (types.url, "http://localhost/path@with@at", True),  # @ in path
+    ],
+)
+def test_url_regex(custom_type, test_string, should_match):
+    class Model(BaseModel):
+        attr: custom_type
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(custom_type)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
