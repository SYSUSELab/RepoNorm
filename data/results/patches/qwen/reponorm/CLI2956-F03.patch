@@ -93,6 +93,19 @@ def batch(iterable: cabc.Iterable[V], batch_size: int) -> list[tuple[V, ...]]:
     return list(zip(*repeat(iter(iterable), batch_size), strict=False))
 
 
+def _batch_values(values: tuple[V, ...], batch_size: int) -> tuple[tuple[V, ...], ...]:
+    """Group values into non-empty tuples of at most batch_size items.
+    
+    Preserves every value including 0, False, empty string, and None.
+    Preserves input order and includes a shorter final batch.
+    Empty input produces ().
+    """
+    result: list[tuple[V, ...]] = []
+    for i in range(0, len(values), batch_size):
+        result.append(values[i:i + batch_size])
+    return tuple(result)
+
