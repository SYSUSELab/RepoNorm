+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, int], str]]] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str], str]]] = None,
+        fallback_npgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, str, int], str]]] = None,
+    ) -> None:
+        """Install gettext callables with optional fallback chains.
+        
+        Each fallback argument is an optional finite iterable of callables matching
+        its primary provider's signature. The installer snapshots each iterable when
+        called. A missing or empty iterable behaves like install_gettext_callables.
+        Supplying a non-empty contextual fallback iterable without the matching
+        pgettext or npgettext primary raises ValueError naming the required primary.
+        
+        Call the primary provider first. A gettext or pgettext result is missing when
+        it equals the source message. An ngettext or npgettext result is missing when
+        it equals the selected source form: singular for n == 1, plural otherwise.
+        Only on a miss, call matching fallback providers in their declared order and
+        stop at the first non-missing result. If every provider misses, return the
+        selected source message. Provider exceptions propagate without calling later
+        providers. Context providers receive the context string on every attempt.
+        
+        New-style formatting and autoescaping happen after a provider is selected,
+        using the same behavior as the existing installer. Calling the installer
+        again replaces all installed providers and chains.
+        """
+        # Validate that contextual fallbacks require their primary
+        if fallback_pgettext_funcs is not None:
+            if pgettext is None:
+                raise ValueError(
+                    "fallback_pgettext_funcs requires pgettext primary provider"
+                )
+        if fallback_npgettext_funcs is not None:
+            if npgettext is None:
+                raise ValueError(
+                    "fallback_npgettext_funcs requires npgettext primary provider"
+                )
+        
+        # Snapshot iterables to tuples
+        if fallback_gettext_funcs is not None:
+            fallback_gettext_funcs = tuple(fallback_gettext_funcs)
+        if fallback_ngettext_funcs is not None:
+            fallback_ngettext_funcs = tuple(fallback_ngettext_funcs)
+        if fallback_pgettext_funcs is not None:
+            fallback_pgettext_funcs = tuple(fallback_pgettext_funcs)
+        if fallback_npgettext_funcs is not None:
+            fallback_npgettext_funcs = tuple(fallback_npgettext_funcs)
+        
+        if newstyle is not None:
+            self.environment.newstyle_gettext = newstyle  # type: ignore
+        
+        # Apply fallback wrappers first, then newstyle wrappers
+        # Fallback wrappers need to wrap the original functions before newstyle wrapping
+        if fallback_gettext_funcs:
+            gettext = _fallback_gettext(gettext, fallback_gettext_funcs)
+        if fallback_ngettext_funcs:
+            ngettext = _fallback_ngettext(ngettext, fallback_ngettext_funcs)
+        if pgettext is not None and fallback_pgettext_funcs:
+            pgettext = _fallback_pgettext(pgettext, fallback_pgettext_funcs)
+        if npgettext is not None and fallback_npgettext_funcs:
+            npgettext = _fallback_npgettext(npgettext, fallback_npgettext_funcs)
+        
+        # Apply newstyle wrappers after fallback wrappers
+        if self.environment.newstyle_gettext:  # type: ignore
+            gettext = _make_new_gettext(gettext)
+            ngettext = _make_new_ngettext(ngettext)
+
+            if pgettext is not None:
+                pgettext = _make_new_pgettext(pgettext)
+
+            if npgettext is not None:
+                npgettext = _make_new_npgettext(npgettext)
+
+        self.environment.globals.update(
+            gettext=gettext, ngettext=ngettext, pgettext=pgettext, npgettext=npgettext
+        )
+
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
         for key in ("gettext", "ngettext", "pgettext", "npgettext"):
             self.environment.globals.pop(key, None)
