+def _fallback_gettext(
+    gettext_func: t.Callable[[str], str],
+    fallback_funcs: t.Sequence[t.Callable[[str], str]],
+) -> t.Callable[[str], str]:
+    """Create a gettext function with fallback chain support."""
+    
+    def wrapped(message: str) -> str:
+        # Try primary provider first
+        result = gettext_func(message)
+        if result != message:
+            return result
+        
+        # Try fallback providers in order
+        for fallback_func in fallback_funcs:
+            result = fallback_func(message)
+            if result != message:
+                return result
+        
+        # All providers missed, return original message
+        return message
+    
+    return wrapped
+
+
+def _fallback_ngettext(
+    ngettext_func: t.Callable[[str, str, int], str],
+    fallback_funcs: t.Sequence[t.Callable[[str, str, int], str]],
+) -> t.Callable[[str, str, int], str]:
+    """Create an ngettext function with fallback chain support."""
+    
+    def wrapped(singular: str, plural: str, n: int) -> str:
+        # Determine the selected source form based on n
+        selected_source = singular if n == 1 else plural
+        
+        # Try primary provider first
+        result = ngettext_func(singular, plural, n)
+        if result != selected_source:
+            return result
+        
+        # Try fallback providers in order
+        for fallback_func in fallback_funcs:
+            result = fallback_func(singular, plural, n)
+            if result != selected_source:
+                return result
+        
+        # All providers missed, return selected source
+        return selected_source
+    
+    return wrapped
+
