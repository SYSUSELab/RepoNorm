+class TestFallbackInternationalization:
+    """Tests for install_gettext_callables_with_fallback."""
+
+    def test_basic_gettext_fallback(self):
+        """Test basic gettext fallback chain."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        
+        # Primary provider that always misses
+        def primary_gettext(msg):
+            return msg  # Always returns source, indicating miss
+        
+        # Fallback provider that succeeds
+        def fallback_gettext(msg):
+            return f"FALLBACK:{msg}"
+        
+        env.install_gettext_callables_with_fallback(  # type: ignore
+            gettext=primary_gettext,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[fallback_gettext]
+        )
+        
+        t = env.from_string("{{ _('hello') }}")
+        assert t.render() == "FALLBACK:hello"
+
+    def test_primary_provider_used_when_successful(self):
+        """Test that primary provider is used when it succeeds."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        
+        # Primary provider that succeeds
+        def primary_gettext(msg):
+            return f"PRIMARY:{msg}"
+        
+        # Fallback provider (should not be called)
+        def fallback_gettext(msg):
+            return f"FALLBACK:{msg}"
+        
+        env.install_gettext_callables_with_fallback(  # type: ignore
+            gettext=primary_gettext,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[fallback_gettext]
+        )
+        
+        t = env.from_string("{{ _('hello') }}")
+        assert t.render() == "PRIMARY:hello"
+
+    def test_multiple_fallbacks_called_in_order(self):
+        """Test that multiple fallbacks are called in order."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        
+        call_order = []
+        
+        def primary_gettext(msg):
+            return msg  # Miss
+        
+        def fallback1_gettext(msg):
+            call_order.append("fallback1")
+            return msg  # Miss
+        
+        def fallback2_gettext(msg):
+            call_order.append("fallback2")
+            return f"FALLBACK2:{msg}"
+        
+        env.install_gettext_callables_with_fallback(  # type: ignore
+            gettext=primary_gettext,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[fallback1_gettext, fallback2_gettext]
+        )
+        
+        t = env.from_string("{{ _('hello') }}")
+        assert t.render() == "FALLBACK2:hello"
+        assert call_order == ["fallback1", "fallback2"]
+
+    def test_chain_stops_at_first_success(self):
+        """Test that chain stops at first successful provider."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        
+        call_count = {"fallback1": 0, "fallback2": 0}
+        
+        def primary_gettext(msg):
+            return msg  # Miss
+        
+        def fallback1_gettext(msg):
+            call_count["fallback1"] += 1
+            return f"FALLBACK1:{msg}"  # Success
+        
+        def fallback2_gettext(msg):
+            call_count["fallback2"] += 1
+            return f"FALLBACK2:{msg}"
+        
+        env.install_gettext_callables_with_fallback(  # type: ignore
+            gettext=primary_gettext,
+            ngettext=lambda s, p, n: s if n == 1 else p,
+            fallback_gettext_funcs=[fallback1_gettext, fallback2_gettext]
+        )
+        
+        t = env.from_string("{{ _('hello') }}")
+        assert t.render() == "FALLBACK1:hello"
+        assert call_count["fallback1"] == 1
+        assert call_count["fallback2"] == 0
