diff --git a/outlines/types/__init__.py b/outlines/types/__init__.py
index 85af9ad..57c0edf 100644
--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,10 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches any MAC address in EUI-48 format with either colon or hyphen separators.
+# Hex letters may be upper- or lowercase. Dotted, unseparated, shortened, EUI-64,
+# and surrounded-by-whitespace forms are outside this format.
+mac_address = Regex(
+    r"([0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}|[0-9A-Fa-f]{2}(-[0-9A-Fa-f]{2}){5})"
+)
diff --git a/tests/types/test_custom_types.py b/tests/types/test_custom_types.py
index 691b681..ee47d64 100644
--- a/tests/types/test_custom_types.py
+++ b/tests/types/test_custom_types.py
@@ -108,3 +108,57 @@ def test_type_enum(custom_type, test_string, should_match):
 
     does_match = test_string in custom_type.__members__
     assert does_match is should_match
+
+
+@pytest.mark.parametrize(
+    "custom_type,test_string,should_match",
+    [
+        # Valid MAC addresses with colon separators
+        (types.mac_address, "00:1A:2B:3C:4D:5E", True),
+        (types.mac_address, "00:1a:2b:3c:4d:5e", True),
+        (types.mac_address, "FF:FF:FF:FF:FF:FF", True),
+        (types.mac_address, "ff:ff:ff:ff:ff:ff", True),
+        (types.mac_address, "00:00:00:00:00:00", True),
+        # Valid MAC addresses with hyphen separators
+        (types.mac_address, "00-1A-2B-3C-4D-5E", True),
+        (types.mac_address, "00-1a-2b-3c-4d-5e", True),
+        (types.mac_address, "FF-FF-FF-FF-FF-FF", True),
+        (types.mac_address, "ff-fF-Ff-fF-fF-Ff", True),
+        (types.mac_address, "00-00-00-00-00-00", True),
+        # Invalid MAC addresses - mixed separators
+        (types.mac_address, "00:1A:2B:3C:4D-5E", False),
+        (types.mac_address, "00-1A:2B-3C:4D-5E", False),
+        # Invalid MAC addresses - dotted format
+        (types.mac_address, "001A.2B3C.4D5E", False),
+        # Invalid MAC addresses - unseparated
+        (types.mac_address, "001A2B3C4D5E", False),
+        # Invalid MAC addresses - shortened (only 5 pairs)
+        (types.mac_address, "00:1A:2B:3C:4D", False),
+        (types.mac_address, "00-1A-2B-3C-4D", False),
+        # Invalid MAC addresses - EUI-64 (8 pairs)
+        (types.mac_address, "00:1A:2B:3C:4D:5E:6F:78", False),
+        # Invalid MAC addresses - surrounded by whitespace
+        (types.mac_address, " 00:1A:2B:3C:4D:5E ", False),
+        # Invalid MAC addresses - trailing/leading separator
+        (types.mac_address, "00:1A:2B:3C:4D:5E:", False),
+        (types.mac_address, ":00:1A:2B:3C:4D:5E", False),
+        # Invalid MAC addresses - invalid hex digit
+        (types.mac_address, "00:1A:2B:3C:4D:5G", False),
+        (types.mac_address, "00:1A:2B:3C:4D:5H", False),
+        # Invalid MAC addresses - empty string
+        (types.mac_address, "", False),
+    ],
+)
+def test_mac_address(custom_type, test_string, should_match):
+    class Model(BaseModel):
+        attr: custom_type
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(custom_type)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
