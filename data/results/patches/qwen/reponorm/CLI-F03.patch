+    def _check_resource_limit(self) -> None:
+        """Check if adding another resource would exceed the limit."""
+        if self.max_resources is None:
+            return
+        
+        # First check: ensure we don't cause any ancestor to exceed their limit
+        # Ancestors' limits apply to their direct resources + all descendant resources
+        parent = self.parent
+        while parent is not None:
+            if parent.max_resources is not None:
+                # Calculate total resources under this ancestor's limit
+                # This includes the ancestor's direct resources + all descendants
+                total_under_ancestor = parent._active_resources
+                
+                # Add all resources from this context and intermediate contexts
+                current = self
+                while current is not None and current != parent:
+                    total_under_ancestor += current._active_resources
+                    current = current.parent
+                
+                # Check if adding this new resource would exceed ancestor's limit
+                # Use > because we want to allow exactly at the limit
+                if total_under_ancestor + self._reserved_resources > parent.max_resources:
+                    raise RuntimeError(
+                        f"Resource limit of {parent.max_resources} exceeded for context "
+                        f"{parent.info_name or 'unnamed'}"
+                    )
+            parent = parent.parent
+        
+        # Finally check our own limit
+        if self._active_resources + 1 > self.max_resources:
+            raise RuntimeError(
+                f"Resource limit of {self.max_resources} exceeded for context "
+                f"{self.info_name or 'unnamed'}"
+            )
+
+    def _reserve_resource(self) -> None:
+        """Reserve capacity for a resource being entered."""
+        self._reserved_resources += 1
+
+    def _commit_resource(self) -> None:
+        """Commit a reservation after successful entry."""
+        self._reserved_resources -= 1
+        self._active_resources += 1
+
+    def _release_resource(self) -> None:
+        """Release a resource when it exits."""
+        if self._active_resources > 0:
+            self._active_resources -= 1
+
+    def _release_reservation(self) -> None:
+        """Release a reservation without consuming capacity."""
+        self._reserved_resources -= 1
+
+    def _release_own_resources(self) -> None:
+        """Release only this context's own registered resources."""
+        # Simply reset this context's active resources
+        # Ancestor limits will automatically reflect the change
+        self._active_resources = 0
+
