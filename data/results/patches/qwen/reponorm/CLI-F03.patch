+class _ResourceWrapper:
+    """Wrapper for context managers that tracks resource entry/exit."""
+    
+    def __init__(self, context: Context, cm: AbstractContextManager):
+        self._context = context
+        self._cm = cm
+        self._value = None
+        self._entered = False
+    
+    def __enter__(self):
+        self._entered = True
+        self._value = self._cm.__enter__()
+        return self._value
+    
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        try:
+            return self._cm.__exit__(exc_type, exc_val, exc_tb)
+        finally:
+            # Release capacity when exiting
+            if self._entered:
+                self._context._release_resource()
+    
+    def __getattr__(self, name):
+        if self._value is not None:
+            return getattr(self._value, name)
+        raise AttributeError(f"'{type(self).__name__}' object has no attribute '{name}'")
+    
+    def __getitem__(self, key):
+        if self._value is not None:
+            return self._value[key]
+        raise TypeError(f"'{type(self).__name__}' object is not subscriptable")
+    
+    def __setitem__(self, key, value):
+        if self._value is not None:
+            self._value[key] = value
+        else:
+            raise TypeError(f"'{type(self).__name__}' object does not support item assignment")
+    
+    def __delitem__(self, key):
+        if self._value is not None:
+            del self._value[key]
+        else:
+            raise TypeError(f"'{type(self).__name__}' object does not support item deletion")
+    
+    def __iter__(self):
+        if self._value is not None:
+            return iter(self._value)
+        raise TypeError(f"'{type(self).__name__}' object is not iterable")
+    
+    def __len__(self):
+        if self._value is not None:
+            return len(self._value)
+        raise TypeError(f"'{type(self).__name__}' object has no len()")
+    
+    def __contains__(self, item):
+        if self._value is not None:
+            return item in self._value
+        return False
+    
+    def __bool__(self):
+        if self._value is not None:
+            return bool(self._value)
+        return False
+    
+    def __repr__(self):
+        if self._value is not None:
+            return repr(self._value)
+        return f"<{type(self).__name__} not entered>"
+    
+    def __str__(self):
+        if self._value is not None:
+            return str(self._value)
+        return "<not entered>"
+    
+    def __hash__(self):
+        if self._value is not None:
+            return hash(self._value)
+        return super().__hash__()
+    
+    def __eq__(self, other):
+        if self._value is not None:
+            return self._value == other
+        return False
+    
+    def __lt__(self, other):
+        if self._value is not None:
+            return self._value < other
+        return NotImplemented
+    
+    def __le__(self, other):
+        if self._value is not None:
+            return self._value <= other
+        return NotImplemented
+    
+    def __gt__(self, other):
+        if self._value is not None:
+            return self._value > other
+        return NotImplemented
+    
+    def __ge__(self, other):
+        if self._value is not None:
+            return self._value >= other
+        return NotImplemented
+
