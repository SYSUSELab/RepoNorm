+@pass_environment
+def _groupby_sort_key(key):
+    """Return a tuple for sorting groupby keys in the required order.
+    
+    Order: normal comparable keys first (including empty string), then None,
+    then missing/Undefined group.
+    """
+    if isinstance(key, Undefined):
+        # Missing/Undefined group comes last
+        return (2, 0, "")
+    elif key is None:
+        # None group comes second
+        return (1, 0, "")
+    else:
+        # Normal keys come first, sorted by their natural order
+        return (0, 0, key)
+
