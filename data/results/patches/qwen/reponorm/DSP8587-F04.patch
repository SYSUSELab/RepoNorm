+    def tick(self, now_ts: float | None = None) -> StreamResponse | None:
+        """Check if the stream has been idle for too long.
+
+        Before the timeout, returns None. At or after the timeout, returns one StreamResponse
+        with an empty chunk and clears the complete per-stream boundary/cache state, so subsequent
+        ticks do not emit duplicates.
+
+        Args:
+            now_ts: Optional timestamp to use instead of calling self.clock(). Useful for testing.
+
+        Returns:
+            StreamResponse with empty chunk if timeout occurred, None otherwise.
+        """
+        if self.idle_timeout_s is None:
+            return None
+
+        current_ts = now_ts if now_ts is not None else self.clock()
+
+        # If we haven't seen any activity yet, don't timeout immediately
+        if self._last_activity_ts is None:
+            return None
+
+        elapsed = current_ts - self._last_activity_ts
+        if elapsed < self.idle_timeout_s:
+            return None
+
+        # Timeout occurred - emit response and clear state
+        self._timeout_emitted = True
+        self._clear_state()
+        return StreamResponse(self.predict_name, self.signature_field_name, "")
+
+    def _clear_state(self):
+        """Clear all per-stream boundary and cache state."""
+        self.stream_start = False
+        self.stream_end = True
+        self.cache_hit = False
+        self.field_start_queue = []
+        self.field_end_queue = Queue()
+        self._last_activity_ts = None
+        self._timeout_emitted = True
+
 
