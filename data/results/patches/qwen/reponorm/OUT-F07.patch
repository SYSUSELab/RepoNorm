+class MockFallbackProcessor:
+    """A mock logits processor that always returns logits unchanged."""
+    
+    def __init__(self):
+        self.reset_called = False
+    
+    def __call__(self, input_ids, logits):
+        return logits
+    
+    def reset(self):
+        self.reset_called = True
+
+
+def test_xgrammar_fallback_processor(model_transformers, json_schema):
+    """Test that fallback processor is used when primary fails."""
+    import torch
+    from outlines.backends.xgrammar import XGrammarLogitsProcessor
+    import warnings
+    
+    # Create a processor with a fallback
+    fallback = MockFallbackProcessor()
+    processor = XGrammarLogitsProcessor(json_schema, fallback)
+    
+    # Verify fallback is set
+    assert processor.fallback_processor is fallback
+    
+    # Process logits - this will fail on primary and use fallback
+    input_ids = torch.tensor([[1, 2, 3]])
+    logits = torch.randn(1, 100)
+    
+    # Should warn about fallback being used
+    with pytest.warns(UserWarning, match="XGrammar processor failed"):
+        result = processor.process_logits(input_ids, logits)
+    
+    # Fallback should have been activated
+    assert processor._fallback_activated == True
+    
+    # Subsequent calls should use fallback without warning
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        result2 = processor.process_logits(input_ids, logits)
+        # Check no "XGrammar processor failed" warnings
+        fallback_warnings = [x for x in w if "XGrammar processor failed" in str(x.message)]
+        assert len(fallback_warnings) == 0
+
+
+def test_xgrammar_fallback_reset(model_transformers, json_schema):
+    """Test that reset() resets both processors."""
+    import torch
+    from outlines.backends.xgrammar import XGrammarLogitsProcessor
+    
+    fallback = MockFallbackProcessor()
+    processor = XGrammarLogitsProcessor(json_schema, fallback)
+    
+    # Trigger fallback activation
+    input_ids = torch.tensor([[1, 2, 3]])
+    logits = torch.randn(1, 100)
+    
+    with pytest.warns(UserWarning, match="XGrammar processor failed"):
+        processor.process_logits(input_ids, logits)
+    
+    assert processor._fallback_activated == True
+    assert not fallback.reset_called
+    
+    # Reset should clear both
+    processor.reset()
+    assert processor._fallback_activated == False
+    assert fallback.reset_called
+
+
+def test_xgrammar_no_fallback_raises_exception(model_transformers, json_schema):
+    """Test that exception propagates when no fallback is provided."""
+    import torch
+    from outlines.backends.xgrammar import XGrammarLogitsProcessor
+    
+    # Create processor without fallback
+    processor = XGrammarLogitsProcessor(json_schema)
+    assert processor.fallback_processor is None
+    
+    # Should raise exception (no fallback to catch it)
+    input_ids = torch.tensor([[1, 2, 3]])
+    logits = torch.randn(1, 100)
+    
+    with pytest.raises(Exception):
+        processor.process_logits(input_ids, logits)
+
+
+def test_xgrammar_factory_methods_accept_fallback(model_transformers, json_schema, regex, cfg):
+    """Test that all factory methods accept fallback parameter."""
+    from outlines.backends.xgrammar import XGrammarBackend
+    
+    backend = XGrammarBackend(model_transformers)
+    fallback = MockFallbackProcessor()
+    
+    # JSON schema factory
+    processor = backend.get_json_schema_logits_processor(json_schema, fallback)
+    assert processor.fallback_processor is fallback
+    
+    # Regex factory
+    processor = backend.get_regex_logits_processor(regex, fallback)
+    assert processor.fallback_processor is fallback
+    
+    # CFG factory
+    processor = backend.get_cfg_logits_processor(cfg, fallback)
+    assert processor.fallback_processor is fallback
