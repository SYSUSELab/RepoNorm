@@ -22,18 +22,42 @@ class XGrammarLogitsProcessor(OutlinesLogitsProcessor):
 
     """
 
-    def __init__(self, compiled_grammar: str):
+    def __init__(
+        self,
+        compiled_grammar: str,
+        max_batch_size: int | None = None,
+    ):
         """
         Parameters
         ----------
         compiled_grammar: str
             The compiled grammar to use to create the logits processor.
+        max_batch_size: int | None
+            The maximum batch size allowed for generation. If None, there is no
+            limit. If provided, must be a non-negative integer (not a boolean).
+            A value of 0 disallows any nonempty generation.
 
         """
         import xgrammar as xgr
 
+        # Validate max_batch_size if provided
+        if max_batch_size is not None:
+            if isinstance(max_batch_size, bool):
+                raise ValueError(
+                    "max_batch_size must be an integer or None, not a boolean"
+                )
+            if not isinstance(max_batch_size, int):
+                raise ValueError(
+                    f"max_batch_size must be an integer or None, got {type(max_batch_size).__name__}"
+                )
+            if max_batch_size < 0:
+                raise ValueError(
+                    f"max_batch_size must be a non-negative integer, got {max_batch_size}"
+                )
+
         self.xgr = xgr
         self.compiled_grammar = compiled_grammar
+        self.max_batch_size = max_batch_size
         self.xgrammar_logits_processor = None
         super().__init__("torch")
 
