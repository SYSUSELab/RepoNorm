+def _validate_trans_expr(expr: nodes.Expr, var_name: str, lineno: int, parser: "Parser") -> None:
+    """Validate that a translation expression only contains allowed node types.
+    
+    Allowed: constants, names, attribute access, filters, tests, or calls whose
+    callee is a simple name. Arguments and keyword values must follow the same rule.
+    Dynamic *args and **kwargs are rejected. Other forms raise TemplateSyntaxError.
+    """
+    from .nodes import Name, Const, Getattr, Filter, Test, Call
+    
+    def _check_node(node: nodes.Node, path: str = "") -> None:
+        if isinstance(node, Name):
+            # Names are always allowed
+            return
+        elif isinstance(node, Const):
+            # Constants are always allowed
+            return
+        elif isinstance(node, Getattr):
+            # Attribute access is allowed, check the base
+            _check_node(node.node, f"{path}.node")
+            return
+        elif isinstance(node, Filter):
+            # Filters are allowed, check the node and arguments
+            if node.node is not None:
+                _check_node(node.node, f"{path}.node")
+            for arg in node.args:
+                _check_node(arg, f"{path}.args")
+            for kw in node.kwargs:
+                _check_node(kw.value, f"{path}.kwargs.value")
+            if node.dyn_args is not None:
+                raise TemplateSyntaxError(
+                    f"dynamic *args not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            if node.dyn_kwargs is not None:
+                raise TemplateSyntaxError(
+                    f"dynamic **kwargs not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            return
+        elif isinstance(node, Test):
+            # Tests are allowed, check the node and arguments
+            _check_node(node.node, f"{path}.node")
+            for arg in node.args:
+                _check_node(arg, f"{path}.args")
+            for kw in node.kwargs:
+                _check_node(kw.value, f"{path}.kwargs.value")
+            if node.dyn_args is not None:
+                raise TemplateSyntaxError(
+                    f"dynamic *args not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            if node.dyn_kwargs is not None:
+                raise TemplateSyntaxError(
+                    f"dynamic **kwargs not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            return
+        elif isinstance(node, Call):
+            # Calls are allowed only if the callee is a simple name
+            if not isinstance(node.node, Name):
+                raise TemplateSyntaxError(
+                    f"method call not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            for arg in node.args:
+                _check_node(arg, f"{path}.args")
+            for kw in node.kwargs:
+                _check_node(kw.value, f"{path}.kwargs.value")
+            if node.dyn_args is not None:
+                raise TemplateSyntaxError(
+                    f"dynamic *args not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            if node.dyn_kwargs is not None:
+                raise TemplateSyntaxError(
+                    f"dynamic **kwargs not allowed in translation expression for {var_name!r}",
+                    lineno,
+                    filename=parser.name,
+                )
+            return
+        else:
+            # All other node types are disallowed
+            raise TemplateSyntaxError(
+                f"expression {type(node).__name__} not allowed in translation expression for {var_name!r}",
+                lineno,
+                filename=parser.name,
+            )
+    
+    _check_node(expr)
+
+
