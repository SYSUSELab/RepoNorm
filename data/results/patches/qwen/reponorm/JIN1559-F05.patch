+class TestTranslationVariableValidation:
+    """Tests for translation variable name and expression validation."""
+
+    @pytest.fixture
+    def i18n_env(self):
+        """Return an environment with i18n extension enabled."""
+        from jinja2 import Environment
+        from jinja2 import pass_context
+        
+        @pass_context
+        def _(context, s):
+            return s
+        
+        @pass_context
+        def gettext(context, s):
+            return s
+        
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.globals["_"] = _
+        env.globals["gettext"] = gettext
+        return env
+
+    def test_reserved_name_gettext_header(self, i18n_env):
+        """Reserved name 'gettext' in header should raise TemplateSyntaxError."""
+        with pytest.raises(TemplateSyntaxError) as excinfo:
+            i18n_env.from_string("{% trans gettext='test' %}hello{% endtrans %}")
+        assert "conflicts with translation function names" in str(excinfo.value)
+
+    def test_reserved_name_ngettext_header(self, i18n_env):
+        """Reserved name 'ngettext' in header should raise TemplateSyntaxError."""
+        with pytest.raises(TemplateSyntaxError) as excinfo:
+            i18n_env.from_string("{% trans ngettext='test' %}hello{% endtrans %}")
+        assert "conflicts with translation function names" in str(excinfo.value)
+
+    def test_reserved_name_pgettext_header(self, i18n_env):
+        """Reserved name 'pgettext' in header should raise TemplateSyntaxError."""
