+    You can also provide a ``key_transform`` callable to transform the
+    displayed grouper value while keeping the original key for grouping
+    and sorting purposes. This is useful when you want to display a
+    formatted version of the key without affecting the grouping behavior.
+
+    .. sourcecode:: jinja
+
+        {%- for city, items in users|groupby("city", key_transform=str.upper) -%}
+          {{ city }}: {{ items|length }} users
+        {%- endfor %}
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
-    .. versionchanged:: 2.6
-        The attribute supports dot notation for nested access.
+    .. versionadded:: NEXT_VERSION
+        Added the ``key_transform`` parameter.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
-
+    
+    # Sort by original keys
+    sorted_value = sorted(value, key=expr)
+    
+    result = []
+    for key, values in groupby(sorted_value, expr):
+        # Apply key_transform if provided
+        if key_transform is not None:
+            # Check if the callback expects environment (decorated with @pass_environment)
+            pass_arg = _PassArg.from_obj(key_transform)
+            if pass_arg is _PassArg.environment:
+                transformed_key = key_transform(environment, key)
+            else:
+                transformed_key = key_transform(key)
+        else:
+            transformed_key = key
+        
+        result.append(_GroupTuple(transformed_key, list(values)))
+    
+    return result
 
