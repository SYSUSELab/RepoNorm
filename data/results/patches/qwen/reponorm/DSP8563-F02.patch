+    @classmethod
+    def validate_input(cls, v):
+        """Validate and parse input, supporting string input via parse_python_calls."""
+        if isinstance(v, str):
+            parsed = parse_python_calls(v)
+            return cls(tool_calls=[cls.ToolCall(**tc) for tc in parsed["tool_calls"]])
+        elif isinstance(v, dict):
+            # Handle dict input - could be raw dict or already structured
+            if "tool_calls" in v:
+                return cls(**v)
+            elif "value" in v and isinstance(v["value"], list):
+                # Handle wrapped dict input
+                return cls.from_dict_list(v["value"])
+            else:
+                # Assume it's a list of tool call dicts
+                return cls.from_dict_list(v)
+        elif isinstance(v, list):
+            return cls.from_dict_list(v)
+        else:
+            # Let pydantic handle other types
+            return cls.model_validate(v)
+
+    @classmethod
+    def model_validate(cls, v, **kwargs):
+        """Override model_validate to support string input."""
+        if isinstance(v, str):
+            parsed = parse_python_calls(v)
+            return cls(tool_calls=[cls.ToolCall(**tc) for tc in parsed["tool_calls"]])
+        return super().model_validate(v, **kwargs)
