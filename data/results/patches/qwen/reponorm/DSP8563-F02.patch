+# Tests for parse_python_calls and ToolCalls string input support
+from dspy.adapters.types.tool import parse_python_calls
+
+
+def test_parse_python_calls_basic():
+    """Test basic single call parsing."""
+    result = parse_python_calls("search(query='hello')")
+    assert result == {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]}
+
+
+def test_parse_python_calls_multiple():
+    """Test multiple calls separated by newlines."""
+    result = parse_python_calls("a(); b()")
+    assert len(result["tool_calls"]) == 2
+    assert result["tool_calls"][0]["name"] == "a"
+    assert result["tool_calls"][1]["name"] == "b"
+
+
+def test_parse_python_calls_semicolon_separated():
+    """Test calls separated by semicolons."""
+    result = parse_python_calls("a(); b(); c()")
+    assert len(result["tool_calls"]) == 3
+
+
+def test_parse_python_calls_nested_structures():
+    """Test nested lists, dicts, tuples."""
+    result = parse_python_calls("process(data={'a': [1, 2], 'b': (3, 4)})")
+    # Tuples should be converted to lists
+    assert result["tool_calls"][0]["args"]["data"] == {"a": [1, 2], "b": [3, 4]}
+
+
+def test_parse_python_calls_unicode():
+    """Test Unicode strings."""
+    result = parse_python_calls("process(text='你好世界')")
+    assert result["tool_calls"][0]["args"]["text"] == "你好世界"
+
+
+def test_parse_python_calls_no_args():
