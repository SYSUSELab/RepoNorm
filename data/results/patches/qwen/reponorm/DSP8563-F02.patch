+def parse_python_calls(text: str) -> dict[str, Any]:
+    """Parse Python-style tool calls from text.
+    
+    Accepts one or more top-level calls separated by newlines or semicolons.
+    Returns {"tool_calls": [{"name": ..., "args": {...}}, ...]}.
+    
+    Raises ValueError for invalid input.
+    """
+    if not text or not text.strip():
+        raise ValueError("Empty input")
+    
+    # Split by newlines and semicolons, filter empty parts
+    parts = []
+    current = ""
+    for char in text:
+        if char == '\n':
+            if current.strip():
+                parts.append(current.strip())
+            current = ""
+        elif char == ';':
+            if current.strip():
+                parts.append(current.strip())
+            current = ""
+        else:
+            current += char
+    if current.strip():
+        parts.append(current.strip())
+    
+    if not parts:
+        raise ValueError("Empty input")
+    
+    tool_calls = []
+    
+    for part in parts:
+        call = _parse_single_call(part)
+        tool_calls.append(call)
+    
+    return {"tool_calls": tool_calls}
+
+
+def _has_comment_outside_strings(text: str) -> bool:
+    """Check if text has # outside of string literals."""
+    in_string = False
+    string_char = None
+    i = 0
+    while i < len(text):
+        char = text[i]
+        
+        if not in_string:
+            if char == '#':
+                return True
+            elif char in ('"', "'"):
+                # Check for triple quotes
+                if text[i:i+3] in ('"""', "'''"):
+                    in_string = True
+                    string_char = text[i:i+3]
+                    i += 3
+                    continue
+                else:
+                    in_string = True
+                    string_char = char
+        else:
+            if string_char in ('"""', "'''"):
+                if text[i:i+3] == string_char:
+                    in_string = False
+                    string_char = None
+                    i += 3
+                    continue
+            else:
+                if char == '\\' and i + 1 < len(text):
+                    i += 2
+                    continue
+                if char == string_char:
+                    in_string = False
+                    string_char = None
+        
+        i += 1
+    
+    return False
+
+
+def _parse_single_call(text: str) -> dict[str, Any]:
+
+    """Parse a single tool call from text."""
+    if not text.strip():
+        raise ValueError("Empty input")
+    
+    # Check for comments outside strings
+    if _has_comment_outside_strings(text):
+        raise ValueError("Python comments are not allowed")
+    
+    try:
+        tree = ast.parse(text, mode='exec')
+    except SyntaxError as e:
+        raise ValueError(f"Malformed syntax: {e.msg}") from e
+    
+    if len(tree.body) != 1:
+        raise ValueError("Only single tool calls are allowed per statement")
+    
+    node = tree.body[0]
+    
+    # Must be an expression statement containing a Call
+    if isinstance(node, ast.Expr):
+        expr = node.value
+        if isinstance(expr, ast.Call):
+            return _parse_call_node(expr)
+        else:
+            raise ValueError(f"Expected function call, got {type(expr).__name__}")
+    elif isinstance(node, ast.Pass):
+        raise ValueError("Empty statement is not allowed")
+    else:
+        raise ValueError(f"Statement type {type(node).__name__} is not allowed")
+
+
+def _parse_call_node(call: ast.Call) -> dict[str, Any]:
+    """Parse a Call AST node into a tool call dict."""
+    name = _get_name_from_expr(call.func)
+    
+    args = {}
+    seen_kwargs = set()
+    
+    # Check for positional arguments
+    if call.args:
+        raise ValueError("Positional arguments are not allowed")
+    
+    # Check for argument unpacking (*args, **kwargs)
+    for kwarg in call.keywords:
+        if kwarg.arg is None:  # **kwargs unpacking
+            raise ValueError("Argument unpacking (**kwargs) is not allowed")
+        
+        # Check for duplicate keyword arguments
+        if kwarg.arg in seen_kwargs:
+            raise ValueError(f"Duplicate keyword argument: {kwarg.arg}")
+        seen_kwargs.add(kwarg.arg)
+        
+        args[kwarg.arg] = _parse_value(kwarg.value)
+    
+    return {"name": name, "args": args}
+
+
+def _get_name_from_expr(expr: ast.expr) -> str:
+    """Get the tool name from an expression (identifier or dotted sequence)."""
+    if isinstance(expr, ast.Name):
+        return expr.id
+    elif isinstance(expr, ast.Attribute):
+        # Handle dotted names like module.function
+        parts = []
+        current = expr
+        while isinstance(current, ast.Attribute):
+            parts.append(current.attr)
+            current = current.value
+        if isinstance(current, ast.Name):
+            parts.append(current.id)
+        parts.reverse()
+        # Use the final identifier as the tool name
+        return parts[-1] if parts else ""
+    else:
+        raise ValueError(f"Unsupported expression type: {type(expr).__name__}")
+
+
+def _parse_value(node: ast.expr) -> Any:
+    """Parse an AST node into a Python value."""
+    if isinstance(node, ast.Constant):
+        return _parse_constant(node)
+    elif isinstance(node, ast.List):
+        return [_parse_value(elt) for elt in node.elts]
+    elif isinstance(node, ast.Tuple):
+        # Convert tuples recursively into lists
+        return [_parse_value(elt) for elt in node.elts]
+    elif isinstance(node, ast.Dict):
+        return _parse_dict(node)
+    elif isinstance(node, ast.UnaryOp):
+        return _parse_unary_op(node)
+    else:
+        raise ValueError(f"Unsupported expression type: {type(node).__name__}")
+
+
+def _parse_constant(node: ast.Constant) -> Any:
+    """Parse a Constant node."""
+    value = node.value
+    
+    # Allow None as a valid value
+    if value is None:
+        return None
+    
+    # Reject strings (we'll handle them specially)
+    if isinstance(value, str):
+        return value
+    
+    # Reject bytes
+    if isinstance(value, bytes):
+        raise ValueError("Bytes are not allowed")
+    
+    # Reject complex numbers
+    if isinstance(value, complex):
+        raise ValueError("Complex numbers are not allowed")
+    
+    # Reject Ellipsis
+    if value is ...:
+        raise ValueError("Ellipsis is not allowed")
+    
+    # Reject non-finite floats
+    if isinstance(value, float):
+        if value != value:  # NaN check
+            raise ValueError("Non-finite numbers are not allowed")
+        if value == float('inf') or value == float('-inf'):
+            raise ValueError("Non-finite numbers are not allowed")
+    
+    # Integers are OK
+    if isinstance(value, int):
+        return value
+    
+    # Floats are OK (finite ones)
+    if isinstance(value, float):
+        return value
+    
+    # Booleans are OK
+    if isinstance(value, bool):
+        return value
+    
+    raise ValueError(f"Unsupported constant type: {type(value).__name__}")
+
+
+def _parse_dict(node: ast.Dict) -> dict[str, Any]:
+    """Parse a Dict node."""
+    result = {}
+    
+    # Check keys
+    for key in node.keys:
+        if key is None:
+            raise ValueError("Dictionary keys must be strings")
+        if not isinstance(key, ast.Constant) or not isinstance(key.value, str):
+            raise ValueError("Dictionary keys must be strings")
+        
+        key_str = key.value
+        
+        # Check for duplicate keys
+        if key_str in result:
+            raise ValueError(f"Duplicate dictionary key: {key_str}")
+        
+        result[key_str] = _parse_value(node.values[node.keys.index(key)])
+    
+    return result
+
+
+def _parse_unary_op(node: ast.UnaryOp) -> Any:
+    """Parse a UnaryOp node (only +/- on numbers)."""
+    op = node.op
+    
+    # Only allow UnaryMinus and UnaryPlus
+    if not isinstance(op, (ast.UAdd, ast.USub)):
+        raise ValueError(f"Unsupported unary operator: {type(op).__name__}")
+    
+    operand = node.operand
+    
+    # Operand must be a number (not boolean)
+    if isinstance(operand, ast.Constant):
+        value = operand.value
+        if isinstance(value, bool):
+            raise ValueError("Unary operators are not allowed on booleans")
+        if isinstance(value, (int, float)):
+            if isinstance(op, ast.UAdd):
+                return +value
+            else:
+                return -value
+        raise ValueError(f"Unary operators only allowed on numbers, got {type(value).__name__}")
+    
+    raise ValueError(f"Unary operators only allowed on numeric literals, got {type(operand).__name__}")
+
+
