+class ConditionalI18nExtension(Extension):
+    """This extension adds conditional translation support with lazy fallback bodies.
+    
+    Provides {% ctrans condition, ... %} followed by a required {% fallback %} 
+    and {% endctrans %}. The condition is evaluated exactly once. When true, 
+    the first branch follows trans message, variable, pluralization, trimmed/notrimmed, 
+    old/new-style, autoescape, and extraction behavior. When false, the fallback 
+    is an ordinary Jinja body and only that body is evaluated; it may contain 
+    filters, conditions, includes, and other normal constructs.
+    
+    An optional context="literal" header value selects pgettext or npgettext 
+    for the true branch and appears in normal extraction. It may occur once 
+    and must be a string literal. The plural selector follows ordinary trans rules.
+    A missing fallback, duplicate context, nonliteral context, multiple plural 
+    sections, or unclosed block raises the corresponding compile-time template error.
+    
+    Extraction reports only the true translation message. Fallback text and 
+    expressions are not translation messages unless they independently call a 
+    configured gettext function.
+    """
+
+    tags = {"ctrans"}
+
+    def __init__(self, environment: "Environment") -> None:
+        super().__init__(environment)
+        environment.globals["_"] = _gettext_alias
+        environment.extend(
+            newstyle_gettext=False,
+        )  # type ignore
+        # Install default gettext callables
+        import gettext
+        translations = gettext.NullTranslations()
+        self.environment.globals.update(
+            gettext=translations.gettext,
+            ngettext=translations.ngettext,
+            pgettext=getattr(translations, "pgettext", lambda c, s: s),
+            npgettext=getattr(translations, "npgettext", lambda c, s, p, n: s if n == 1 else p),
+        )
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translation tag."""
+        lineno = next(parser.stream).lineno
+        
+        # Parse the condition expression
+        test = parser.parse_expression()
+        
+        # Extract variables from condition expression
+        referenced_from_condition = set()
+        for node in test.find_all(nodes.Name):
+            if node.ctx == "load":
+                referenced_from_condition.add(node.name)
+        
+        # Initialize variables for parsing
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        context_value: t.Optional[str] = None
+        has_context = False
+        
+        # Parse header options (variables, trimmed, context)
+        while parser.stream.current.type != "block_end":
+            # Skip whitespace before checking for options
+            while parser.stream.current.type == "whitespace":
+                next(parser.stream)
+            
+            if variables or has_context:
+                parser.stream.expect("comma")
+            
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+            
+            token = parser.stream.expect("name")
+            
+            # Check for context="literal" option
+            if token.value == "context":
+                if has_context:
+                    parser.fail(
+                        "duplicate context in ctrans tag",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                
+                parser.stream.expect("assign")
+                ctx_token = parser.stream.expect("string")
+                context_value = ctx_token.value
+                has_context = True
+                continue
+            
+            # Check for trimmed/notrimmed option
+            if trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            
+            # Handle variables
+            if variables:
+                parser.stream.expect("comma")
+            
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+            
+            # Track plural expression
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+        
+        parser.stream.expect("block_end")
+        
+        # Parse the true branch (translation content)
+        have_plural = False
+        singular_names: t.List[str] = []
+        singular = ""
+        plural_names: t.List[str] = []
+        plural = ""
+        
+        # Parse until endctrans or pluralize
+        singular_names, singular = self._parse_ctrans_block(parser, allow_pluralize=True)
+        referenced = set(singular_names) | referenced_from_condition
+        
+        if singular_names:
+            referenced.update(singular_names)
+            if plural_expr is None:
+                plural_expr = nodes.Name(singular_names[0], "load")
+        
+        # Register free names from condition and singular branch before checking pluralize
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+        
+        # Check for pluralize section
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)  # consume pluralize name
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_ctrans_block(parser, allow_pluralize=False)
+            # After parsing plural section, we should be at fallback or endctrans
+            # The _parse_ctrans_block breaks before consuming the block tag
+            # So we need to consume the whitespace/block_end if present
+            while parser.stream.current.type == "whitespace":
+                next(parser.stream)
+            referenced.update(plural_names)
+        
+        # Register free names as simple name expressions
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+        
+        if not have_plural:
+            plural_expr = None
+        
+        # Build the true branch node (translation call)
+        true_branch = self._make_trans_node(
+            singular=singular,
+            plural=plural,
+            variables=variables,
+            plural_expr=plural_expr,
+            vars_referenced=bool(referenced),
+            num_called_num=have_plural,
+            context=context_value,
+            trimmed=trimmed,
+        )
+        
+        # Parse the fallback body (ordinary Jinja content)
+        # After parsing true/plural branches, we should be at fallback
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("missing fallback in ctrans tag", lineno)
+        
+        next(parser.stream)  # consume fallback
+        # parse_statements will consume block_end internally
+        fallback_body = list(parser.parse_statements(["name:endctrans"], drop_needle=True))
+        
+        # Create the ConditionalTrans node
+        node = nodes.ConditionalTrans(test, [true_branch], fallback_body, lineno=lineno)
+        
+        result: t.List[nodes.Node] = []
+        if plural_expr_assignment is not None:
+            result.append(plural_expr_assignment)
+        result.append(node)
+        
+        return result
+    
+    def _parse_ctrans_block(
+        self, parser: "Parser", allow_pluralize: bool
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next block tag with a given name."""
+        referenced: t.List[str] = []
+        buf: t.List[str] = []
+        
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                # Skip whitespace to get to the actual tag name
+                while parser.stream.current.type == "whitespace":
+                    next(parser.stream)
+                if parser.stream.current.test("name:endctrans"):
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if allow_pluralize:
+                        break
+                    parser.fail(
+                        "a translatable section can have only one pluralize section"
+                    )
+                elif parser.stream.current.test("name:fallback"):
+                    # Fallback is a valid stopping point for the true branch
+                    break
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed translation block")
+            else:
+                raise RuntimeError("internal parser error")
+        
+        return referenced, concat(buf)
+    
+    def _make_trans_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+        context: t.Optional[str],
+        trimmed: t.Optional[bool],
+    ) -> nodes.Output:
+        """Generates a useful node from the data provided."""
+        newstyle = self.environment.newstyle_gettext  # type: ignore
+        
+        # Apply trimming if needed
+        if trimmed is None:
+            trimmed = self.environment.policies["ext.i18n.trimmed"]
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+        
+        # no variables referenced?  no need to escape for old style
+        # gettext invocations only if there are vars.
+        if not vars_referenced and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+        
+        # Determine which gettext function to use based on context
+        if context is not None:
+            if plural_expr is None:
+                gettext_func = nodes.Name("pgettext", "load")
+                node = nodes.Call(
+                    gettext_func,
+                    [nodes.Const(context), nodes.Const(singular)],
+                    [],
+                    None,
+                    None,
+                )
+            else:
+                gettext_func = nodes.Name("npgettext", "load")
+                node = nodes.Call(
+                    gettext_func,
+                    [
+                        nodes.Const(context),
+                        nodes.Const(singular),
+                        nodes.Const(plural),
+                        plural_expr,
+                    ],
+                    [],
+                    None,
+                    None,
+                )
+        elif plural_expr is None:
+            gettext_func = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext_func, [nodes.Const(singular)], [], None, None)
+        else:
+            gettext_func = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                gettext_func,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+        
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+        
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(
+                    node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+        
+        return nodes.Output([node])
+    
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
