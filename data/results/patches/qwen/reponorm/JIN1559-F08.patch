+    def visit_ConditionalTrans(
+        self, node: nodes.ConditionalTrans, frame: Frame
+    ) -> None:
+        """Compile a conditional translation block with lazy fallback."""
+        # Create a soft frame for the true branch to handle variable scoping
+        if_frame = frame.soft()
+        
+        # Write the condition check
+        self.writeline("if ", node)
+        self.visit(node.test, if_frame)
+        self.write(":")
+        self.indent()
+        
+        # Compile the true branch (translation call)
+        # The true_branch is an Output node containing the gettext call
+        self.blockvisit(node.true_branch, if_frame)
+        self.outdent()
+        
+        # Write the else branch with the fallback body
+        self.writeline("else:")
+        self.indent()
+        
+        # Compile the fallback body as ordinary Jinja content
+        # This allows filters, conditions, includes, etc.
+        self.blockvisit(node.fallback, frame)
+        self.outdent()
+
     def visit_Macro(self, node: nodes.Macro, frame: Frame) -> None:
         macro_frame, macro_ref = self.macro_body(node, frame)
         self.newline()
