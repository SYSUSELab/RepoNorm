+class TestConditionalI18nExtension:
+    """Tests for the ConditionalI18nExtension with {% ctrans %} tag."""
+
+    def test_ctrans_true(self):
+        """Test ctrans with condition true - should render translation."""
+        template = ctrans_env.from_string(
+            '{% ctrans True %}Hello{% fallback %}Fallback{% endctrans %}'
+        )
+        assert template.render() == "Hello"
+
+    def test_ctrans_false(self):
+        """Test ctrans with condition false - should render fallback."""
+        template = ctrans_env.from_string(
+            '{% ctrans False %}Hello{% fallback %}Fallback{% endctrans %}'
+        )
+        assert template.render() == "Fallback"
+
+    def test_ctrans_with_variable(self):
+        """Test ctrans with variable in both branches."""
+        template = ctrans_env.from_string(
+            '{% ctrans x %}Hello {{ name }}{% fallback %}Fallback {{ name }}{% endctrans %}'
+        )
+        assert template.render(x=True, name="World") == "Hello World"
+        assert template.render(x=False, name="World") == "Fallback World"
+
+    def test_ctrans_context(self):
+        """Test ctrans with context option."""
+        template = ctrans_env.from_string(
+            '{% ctrans True context="fruit" %}Apple{% fallback %}No fruit{% endctrans %}'
+        )
+        assert template.render() == "Apple"
+
+    def test_ctrans_plural(self):
+        """Test ctrans with pluralization."""
+        template = ctrans_env.from_string(
+            '{% ctrans num > 1 %}One apple{% pluralize num %}Apples{% fallback %}No apples{% endctrans %}'
+        )
+        assert template.render(num=1) == "No apples"
+        assert template.render(num=2) == "Apples"
+
+    def test_ctrans_context_plural(self):
+        """Test ctrans with context and pluralization."""
+        template = ctrans_env.from_string(
+            '{% ctrans num > 1 context="fruit" %}Apple{% pluralize num %}Apples{% fallback %}No fruit{% endctrans %}'
+        )
+        assert template.render(num=1) == "Apple"
+        assert template.render(num=2) == "Apples"
+
+    def test_ctrans_missing_fallback(self):
+        """Test ctrans without fallback raises error."""
+        with pytest.raises(TemplateSyntaxError, match="missing fallback"):
+            ctrans_env.from_string('{% ctrans True %}Hello{% endctrans %}')
+
+    def test_ctrans_duplicate_context(self):
+        """Test ctrans with duplicate context raises error."""
+        with pytest.raises(TemplateSyntaxError, match="duplicate context"):
+            ctrans_env.from_string(
+                '{% ctrans True context="a" context="b" %}Hello{% fallback %}Fallback{% endctrans %}'
+            )
+
+    def test_ctrans_nonliteral_context(self):
+        """Test ctrans with non-literal context raises error."""
+        with pytest.raises(TemplateSyntaxError, match="expected token 'string'"):
+            ctrans_env.from_string(
+                '{% ctrans True context=x %}Hello{% fallback %}Fallback{% endctrans %}'
+            )
+
+    def test_ctrans_multiple_plural(self):
+        """Test ctrans with multiple pluralize sections raises error."""
+        with pytest.raises(TemplateSyntaxError, match="only one pluralize section"):
+            ctrans_env.from_string(
+                '{% ctrans True %}Hello{% pluralize %}Hi{% pluralize %}Hey{% fallback %}Fallback{% endctrans %}'
+            )
+
+    def test_ctrans_unclosed(self):
+        """Test unclosed ctrans block raises error."""
+        with pytest.raises(TemplateSyntaxError, match="endctrans"):
+            ctrans_env.from_string('{% ctrans True %}Hello{% fallback %}Fallback')
+
+    def test_ctrans_extraction(self):
+        """Test extraction from ctrans only extracts true branch."""
+        node = ctrans_env.parse(
+            '{% ctrans True %}Hello{% fallback %}Fallback{% endctrans %}'
+        )
+        extracted = list(extract_from_ast(node))
+        # Should only extract "Hello", not "Fallback"
+        assert len(extracted) == 1
+        assert extracted[0][2] == "Hello"
+
+    def test_ctrans_extraction_with_gettext_in_fallback(self):
+        """Test that gettext in fallback is also extracted."""
+        node = ctrans_env.parse(
+            '{% ctrans True %}Hello{% fallback %}{{ _("Fallback") }}{% endctrans %}'
+        )
+        extracted = list(extract_from_ast(node))
+        # Should extract both "Hello" from ctrans and "Fallback" from _()
+        assert len(extracted) == 2
+
+    def test_ctrans_trimmed(self):
+        """Test ctrans with trimmed option."""
+        template = ctrans_env.from_string(
+            '{% ctrans True trimmed %}  Hello  {% fallback %}  Fallback  {% endctrans %}'
+        )
+        assert template.render() == "Hello"
+
+    def test_ctrans_nested_conditionals_in_fallback(self):
+        """Test complex constructs in fallback body."""
+        template = ctrans_env.from_string(
+            '''{% ctrans False %}{% if show %}Show{% else %}Hide{% endif %}{% fallback %}Default{% endctrans %}'''
+        )
+        assert template.render(show=True) == "Default"
+        assert template.render(show=False) == "Default"
+
+    def test_ctrans_include_in_fallback(self):
+        """Test include in fallback body (with a dummy loader)."""
+        loader = DictLoader({
+            'test': '{% ctrans False %}{% include "included" %}{% fallback %}Default{% endctrans %}',
+            'included': 'Included content',
+        })
+        env = Environment(loader=loader, extensions=[ConditionalI18nExtension])
+        template = ctrans_env.get_template('test')
+        assert template.render() == "Default"
+
+    def test_ctrans_filters_in_fallback(self):
+        """Test filters in fallback body."""
+        template = ctrans_env.from_string(
+            '{% ctrans False %}{{ "hello"|upper }}{% fallback %}default{% endctrans %}'
+        )
+        assert template.render() == "default"
+        # When condition is true, fallback is not evaluated
+        template2 = ctrans_env.from_string(
+            '{% ctrans True %}{{ "hello"|upper }}{% fallback %}{{ "fallback"|lower }}{% endctrans %}'
+        )
+        assert template2.render() == "HELLO"
