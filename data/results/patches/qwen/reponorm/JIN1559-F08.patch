+class ConditionalTrans(Stmt):
+    """A conditional translation block with a fallback body.
+    
+    The condition is evaluated exactly once. When true, the first branch
+    follows trans message, variable, pluralization, trimmed/notrimmed,
+    old/new-style, autoescape, and extraction behavior. When false,
+    the fallback is an ordinary Jinja body and only that body is
+    evaluated; it may contain filters, conditions, includes, and other
+    normal constructs.
+    
+    Example usage::
+    
+        {% ctrans condition %}Hello{% endctrans %}
+        {% ctrans condition context="fruit" %}Apple{% pluralize %}Apples{% endctrans %}
+        {% ctrans condition %}Hello{% fallback %}Fallback text{% endctrans %}
+    """
+
+    fields = ("test", "true_branch", "fallback")
+    test: Node
+    true_branch: t.List[Node]
+    fallback: t.List[Node]
+
