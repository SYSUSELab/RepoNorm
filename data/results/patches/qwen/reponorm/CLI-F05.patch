+def _run_callback_with_retry(callback_info: dict) -> None:
+    """Run a callback with retry logic for transient failures.
+    
+    :param callback_info: Dict containing 'func', 'retry_cleanup', and 'backoff'.
+    """
+    import math
+    import time
+    
+    func = callback_info['func']
+    max_retries = callback_info['retry_cleanup']
+    backoff = callback_info['backoff']
+    
+    # First attempt (no delay)
+    last_exception = None
+    attempts = 1
+    
+    while True:
+        try:
+            func()
+            return  # Success, exit immediately
+        except (KeyboardInterrupt, SystemExit):
+            # Never retry these exceptions
+            raise
+        except Exception as e:
+            last_exception = e
+            attempts += 1
+            
+            if attempts > max_retries + 1:
+                # All retries exhausted, propagate the last exception
+                raise
+            else:
+                # Wait with exponential backoff before retry
+                time.sleep(backoff)
+                backoff *= 2  # Double for next retry
+
