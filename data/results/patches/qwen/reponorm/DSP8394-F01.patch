+    class _BypassContext:
+        """Internal context manager for bypass mode."""
+        
+        def __init__(self, cache: 'Cache'):
+            self.cache = cache
+        
+        def __enter__(self):
+            # Push new bypass state onto the stack
+            current = self.cache._bypass_state.get()
+            if current is None:
+                current = []
+            current.append(self.cache)
+            self.cache._bypass_state.set(current)
+            return self
+        
+        def __exit__(self, exc_type, exc_val, exc_tb):
+            # Pop bypass state from the stack
+            current_list = self.cache._bypass_state.get()
+            if len(current_list) > 0:
+                current_list.pop()
+                if len(current_list) == 0:
+                    self.cache._bypass_state.set(None)
+                else:
+                    self.cache._bypass_state.set(current_list)
+            return False
+    
+    def bypass(self) -> '_BypassContext':
+        """Context manager to temporarily bypass cache reads while retaining writes.
+        
+        Within this context, cache reads behave as cache misses even when a value
+        is stored. Writes remain enabled according to the existing memory/disk
+        configuration. After the context ends, newly written values can be read
+        normally.
+        
+        This context manager works with both synchronous and asynchronous functions
+        decorated with @request_cache. A bypassed call recomputes its result, stores
+        it, and later ordinary calls reuse the fresh result.
+        
+        Nested contexts retain bypass until their outer context exits. Normal and
+        exceptional exits restore the previous state. Bypass is local to the current
+        thread/asynchronous execution context; an independently started thread or
+        sibling async task must retain its own state.
+        
+        Example:
+            >>> with dspy.cache.bypass():
+            ...     result = some_cached_function()  # Will recompute, not use cache
+            >>> result2 = some_cached_function()   # Will use cache now
+            
+        Returns:
+            _BypassContext: A context manager object.
+        """
+        return self._BypassContext(self)
+
 
 def request_cache(
     cache_arg_name: Optional[str] = None,
