+def test_bypass_basic(cache):
+    """Test basic bypass functionality - reads are misses, writes still work."""
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    value = "test_response"
+    
+    # First, put a value in cache
+    cache.put(request, value)
+    
+    # Verify we can get it normally
+    result = cache.get(request)
+    assert result == value
+    
+    # Now use bypass - should not find cached value
+    with cache.bypass():
+        result = cache.get(request)
+        assert result is None
+    
+    # After bypass, should be able to get again
+    result = cache.get(request)
+    assert result == value
+
+
+def test_bypass_writes_still_work(cache):
+    """Test that writes still work during bypass."""
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    
+    with cache.bypass():
+        # Write a new value while bypassed
+        cache.put(request, "new_value")
+    
+    # Should be able to read the new value after bypass
+    result = cache.get(request)
+    assert result == "new_value"
+
+
+def test_bypass_nested_contexts(cache):
+    """Test nested bypass contexts - outer context controls exit."""
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    cache.put(request, "cached_value")
+    
+    # Outer bypass context
+    with cache.bypass():
+        assert cache.get(request) is None
+        
+        # Inner bypass context
+        with cache.bypass():
+            assert cache.get(request) is None
+        
+        # Still in outer context, should still be bypassed
+        assert cache.get(request) is None
+    
+    # After outer context exits, should be able to read
+    result = cache.get(request)
+    assert result == "cached_value"
+
+
+def test_bypass_exceptional_exit(cache):
+    """Test that bypass restores state after exception."""
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    cache.put(request, "cached_value")
+    
+    try:
+        with cache.bypass():
+            assert cache.get(request) is None
+            raise ValueError("Test exception")
+    except ValueError:
+        pass
+    
+    # State should be restored after exception
+    result = cache.get(request)
+    assert result == "cached_value"
