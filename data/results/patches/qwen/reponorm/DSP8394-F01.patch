+def test_bypass_thread_local(cache):
+    """Test bypass is local to thread."""
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    cache.put(request, "cached_value")
+    
+    results = {}
+    
+    def thread_func():
+        # In this thread, bypass should NOT affect the main thread's state
+        result = cache.get(request)
+        results['thread'] = result
+    
+    # Main thread enters bypass
+    with cache.bypass():
+        # Main thread sees bypass
+        assert cache.get(request) is None
+        
+        # Start a new thread
+        t = threading.Thread(target=thread_func)
+        t.start()
+        t.join()
+        
+        # Thread should see cached value (not affected by main thread's bypass)
+        assert results['thread'] == "cached_value"
+    
+    # Main thread can now read
+    result = cache.get(request)
+    assert result == "cached_value"
+
+
+def test_bypass_multiple_cache_instances(tmp_path):
+    """Test bypass is local to each Cache instance."""
+    cache1 = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=True,
+        disk_cache_dir=str(tmp_path / "cache1"),
+        disk_size_limit_bytes=1024 * 1024,
+        memory_max_entries=100,
+    )
+    
+    cache2 = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=True,
+        disk_cache_dir=str(tmp_path / "cache2"),
+        disk_size_limit_bytes=1024 * 1024,
+        memory_max_entries=100,
+    )
+    
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    cache1.put(request, "cache1_value")
+    cache2.put(request, "cache2_value")
+    
+    # Bypass only affects cache1
+    with cache1.bypass():
+        assert cache1.get(request) is None
+        assert cache2.get(request) == "cache2_value"
+    
+    # Both should work normally after
+    assert cache1.get(request) == "cache1_value"
+    assert cache2.get(request) == "cache2_value"
+
