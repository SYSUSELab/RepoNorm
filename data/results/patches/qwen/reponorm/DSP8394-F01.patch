+def test_bypass_with_request_cache_sync(cache):
+    """Test bypass works with @request_cache decorator on sync functions."""
+    call_count = [0]
+    
+    @request_cache()
+    def my_function(prompt):
+        call_count[0] += 1
+        return f"Response for {prompt}"
+    
+    # Mock dspy.cache
+    import dspy
+    original_cache = dspy.cache
+    dspy.cache = cache
+    
+    try:
+        # First call - should compute
+        result1 = my_function("Hello")
+        assert result1 == "Response for Hello"
+        assert call_count[0] == 1
+        
+        # Second call - should use cache
+        result2 = my_function("Hello")
+        assert result2 == "Response for Hello"
+        assert call_count[0] == 1
+        
+        # Third call in bypass - should recompute
+        with cache.bypass():
+            result3 = my_function("Hello")
+            assert result3 == "Response for Hello"
+            assert call_count[0] == 2
+        
+        # Fourth call - should use cache (fresh result from bypass)
+        result4 = my_function("Hello")
+        assert result4 == "Response for Hello"
+        assert call_count[0] == 2
+        
+    finally:
+        dspy.cache = original_cache
+
