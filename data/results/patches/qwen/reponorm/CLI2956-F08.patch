diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..67d1eca 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -543,3 +543,205 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+
+def test_get_option_history_tracking_enabled(runner):
+    """Test that option history is recorded when tracking is enabled."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        assert history is not None
+        assert len(history) == 1
+        assert history[0]["value"] == 5
+        assert history[0]["source"] == ParameterSource.COMMANDLINE
+
+    result = runner.invoke(cmd, ["--count", "5"])
+    assert not result.exception
+
+
+def test_get_option_history_tracking_disabled(runner):
+    """Test that get_option_history returns None when tracking is disabled."""
+    @click.command(track_changes=False)
+    @click.option("--count", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        assert history is None
+
+    result = runner.invoke(cmd, ["--count", "5"])
+    assert not result.exception
+
+
+def test_get_option_history_nonexistent_option(runner):
+    """Test that get_option_history returns [] for nonexistent options."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("nonexistent")
+        assert history == []
+
+    result = runner.invoke(cmd, ["--count", "5"])
+    assert not result.exception
+
+
+def test_get_option_history_manual_assignment(runner):
+    """Test that manual assignments are recorded with source=None."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        # First entry from parsing
+        history_before = ctx.get_option_history("count")
+        assert len(history_before) == 1
+        
+        # Manual assignment
+        ctx.params["count"] = 42
+        
+        # Second entry should be appended
+        history_after = ctx.get_option_history("count")
+        assert len(history_after) == 2
+        assert history_after[1]["value"] == 42
+        assert history_after[1]["source"] is None
+
+    result = runner.invoke(cmd, ["--count", "5"])
+    assert not result.exception
+
+
+def test_get_option_history_positional_arg_not_recorded(runner):
+    """Test that positional arguments are not recorded in option history."""
+    @click.command(track_changes=True)
+    @click.argument("name")
+    def cmd(name):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("name")
+        assert history == []
+
+    result = runner.invoke(cmd, ["hello"])
+    assert not result.exception
+
+
+def test_get_option_history_short_option_alias(runner):
+    """Test that short option aliases work for querying history."""
+    @click.command(track_changes=True)
+    @click.option("--count", "-c", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        # Query by short option name
+        history = ctx.get_option_history("-c")
+        assert history is not None
+        assert len(history) == 1
+        assert history[0]["value"] == 5
+
+    result = runner.invoke(cmd, ["-c", "5"])
+    assert not result.exception
+
+
+def test_get_option_history_snapshot_immutability(runner):
+    """Test that returned history is a snapshot and mutations don't affect it."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        history_before = ctx.get_option_history("count")
+        
+        # Manual assignment
+        ctx.params["count"] = 42
+        
+        history_after = ctx.get_option_history("count")
+        
+        # history_before should not be affected
+        assert len(history_before) == 1
+        assert history_before[0]["value"] == 5
+        
+        # Mutating history_after shouldn't affect history_before
+        history_after.append({"value": 999, "source": None, "timestamp": 0})
+        assert len(ctx.get_option_history("count")) == 2
+
+    result = runner.invoke(cmd, ["--count", "5"])
+    assert not result.exception
+
+
+def test_get_option_history_multiple_option(runner):
+    """Test that multiple options record once with final tuple value."""
+    @click.command(track_changes=True)
+    @click.option("--items", "-i", multiple=True)
+    def cmd(items: tuple = ()):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("items")
+        assert history is not None
+        assert len(history) == 1
+        assert history[0]["value"] == ("a", "b", "c")
+        assert history[0]["source"] == ParameterSource.COMMANDLINE
+
+    result = runner.invoke(cmd, ["-i", "a", "-i", "b", "-i", "c"])
+    assert not result.exception
+
+
+def test_get_option_history_default_map_source(runner):
+    """Test that default_map source is recorded correctly."""
+    @click.command(track_changes=True)
+    @click.option("--count", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        assert history is not None
+        assert len(history) == 1
+        assert history[0]["value"] == 42
+        assert history[0]["source"] == ParameterSource.DEFAULT_MAP
+
+    result = runner.invoke(cmd, [], default_map={"count": 42})
+    assert not result.exception
+
+
+def test_get_option_history_environment_source(runner, monkeypatch):
+    """Test that environment variable source is recorded correctly."""
+    monkeypatch.setenv("COUNT", "10")
+    
+    @click.command(track_changes=True)
+    @click.option("--count", envvar="COUNT", default=0)
+    def cmd(count: int = 0):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        assert history is not None
+        assert len(history) == 1
+        assert history[0]["value"] == 10
+        assert history[0]["source"] == ParameterSource.ENVIRONMENT
+
+    result = runner.invoke(cmd, [])
+    assert not result.exception
+
+
+def test_get_option_history_group_subcommand_isolation(runner):
+    """Test that group and subcommand contexts keep independent histories."""
+    @click.group(track_changes=True)
+    def grp():
+        pass
+
+    @grp.command(track_changes=False)
+    @click.option("--count", default=0)
+    def sub(count: int = 0):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        assert history is None  # Tracking disabled on subcommand
+
+    result = runner.invoke(grp, ["sub", "--count", "5"])
+    assert not result.exception
+
+
