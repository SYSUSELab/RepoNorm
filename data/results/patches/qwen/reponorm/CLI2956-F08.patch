+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get a list of values that were assigned to an option in this context.
+
+        This returns a snapshot of all values that were actually assigned to the
+        option during parsing or manual assignment. Each entry contains the value,
+        source, and timestamp.
+
+        :param name: The parameter name (Python attribute name), long option
+            (e.g., ``"count"``), or short option (e.g., ``"-c"``).
+
+        .. versionadded:: 8.3
+        """
+        # Check if tracking is enabled on the current command
+        if not getattr(self.command, "track_changes", False):
+            return None
+
+        # Get the parameter by name - check both direct name and option aliases
+        param = None
+        for p in self.command.params:
+            if p.name == name:
+                param = p
+                break
+            if name in p.opts or name in p.secondary_opts:
+                param = p
+                break
+
+        if param is None:
+            return []
+
+        # Return a deep copy of the history list to ensure immutability
