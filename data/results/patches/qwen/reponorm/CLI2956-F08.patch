+class _ParamDict(dict[str, t.Any]):
+    """A dict wrapper that records manual parameter assignments."""
+
+    def __init__(self, ctx: Context) -> None:
+        super().__init__()
+        self._ctx = ctx
+
+    def __setitem__(self, key: str, value: t.Any) -> None:
+        # Record manual assignment with source=None
+        # Only record if tracking is enabled and this is a manual assignment
+        # (not during parsing, which uses set_with_source)
+        # Also only record Options, not Arguments (positional params)
+        if getattr(self._ctx.command, "track_changes", False):
+            # Check if this is an Option (not an Argument)
+            param = None
+            for p in self._ctx.command.params:
+                if p.name == key:
+                    param = p
+                    break
+            if param is not None and isinstance(param, Option):
+                import time
+                entry = {
+                    "value": value,
+                    "source": None,
+                    "timestamp": time.time(),
+                }
+                if key not in self._ctx._option_history:
+                    self._ctx._option_history[key] = []
+                self._ctx._option_history[key].append(entry)
+        super().__setitem__(key, value)
+
+    def set_with_source(self, key: str, value: t.Any, source: t.Any) -> None:
+        """Set a value with explicit source (used during parsing)."""
+        import time
+        entry = {
+            "value": value,
+            "source": source,
+            "timestamp": time.time(),
+        }
+        if key not in self._ctx._option_history:
+            self._ctx._option_history[key] = []
+        self._ctx._option_history[key].append(entry)
+        super().__setitem__(key, value)
+
