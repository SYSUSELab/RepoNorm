+
+# Domain-specific gettext functions for testing
+def dgettext(domain, string):
+    return f"[{domain}] {string}"
+
+
+def dngettext(domain, singular, plural, n):
+    return f"[{domain}] {plural if n != 1 else singular}"
+
+
+class TestDomainInternationalization:
+    """Tests for translation domain support in trans blocks."""
+
+    def test_domain_basic(self):
+        """Test basic domain usage with trans block."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda s: s,
+            ngettext=lambda s, p, n: p if n != 1 else s,
+            dgettext=dgettext,
+            dngettext=dngettext,
+        )
+        
+        # Without domain - uses regular gettext
+        tmpl = env.from_string("{% trans %}Hello{% endtrans %}")
+        assert tmpl.render() == "Hello"
+        
+        # With domain - uses dgettext
+        tmpl = env.from_string('{% trans domain="admin" %}Hello{% endtrans %}')
+        assert tmpl.render() == "[admin] Hello"
+
+    def test_domain_plural(self):
+        """Test domain with pluralization."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda s: s,
+            ngettext=lambda s, p, n: p if n != 1 else s,
+            dgettext=dgettext,
+            dngettext=dngettext,
+        )
+        
+        # Without domain
+        tmpl = env.from_string(
+            "{% trans count=2 %}One item{% pluralize %}{{ count }} items{% endtrans %}"
+        )
+        assert tmpl.render() == "2 items"
+        
+        # With domain
+        tmpl = env.from_string(
+            '{% trans domain="admin", count=2 %}One item{% pluralize %}'
+            '{{ count }} items{% endtrans %}'
+        )
+        assert tmpl.render() == "[admin] 2 items"
+
+    def test_domain_with_variables(self):
+        """Test domain with variables in trans block."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda s: s,
+            ngettext=lambda s, p, n: p if n != 1 else s,
+            dgettext=dgettext,
+            dngettext=dngettext,
+        )
+        
+        tmpl = env.from_string(
+            '{% trans domain="admin", name="World" %}Hello {{ name }}{% endtrans %}'
+        )
+        assert tmpl.render() == "[admin] Hello World"
+
+    def test_domain_parameter_order(self):
+        """Test that domain can be specified in any position."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda s: s,
+            ngettext=lambda s, p, n: p if n != 1 else s,
+            dgettext=dgettext,
+            dngettext=dngettext,
+        )
+        
+        # Domain first
+        tmpl = env.from_string(
+            '{% trans domain="admin", count=2 %}One{% pluralize %}{{ count }}{% endtrans %}'
+        )
+        assert tmpl.render() == "[admin] 2"
+        
+        # Domain last
+        tmpl = env.from_string(
+            '{% trans count=2, domain="admin" %}One{% pluralize %}{{ count }}{% endtrans %}'
+        )
+        assert tmpl.render() == "[admin] 2"
+
+    def test_domain_whitespace_modifier(self):
+        """Test whitespace modifiers work with domain."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda s: s,
+            ngettext=lambda s, p, n: p if n != 1 else s,
+            dgettext=lambda d, s: f"[{d}] {s.strip()}",
+            dngettext=lambda d, s, p, n: f"[{d}] {p if n != 1 else s}",
+        )
+        
+        tmpl = env.from_string(
+            '{% trans domain="admin" trimmed %}  Hello  {% endtrans %}'
+        )
+        assert tmpl.render() == "[admin] Hello"
+
+    def test_duplicate_domain_error(self):
+        """Test that duplicate domain raises TemplateAssertionError."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        
+        with pytest.raises(TemplateAssertionError) as excinfo:
+            env.from_string('{% trans domain="admin", domain="other" %}Hello{% endtrans %}')
+        assert "defined twice" in str(excinfo.value).lower()
+
+    def test_non_literal_domain_error(self):
+        """Test that non-literal domain raises TemplateAssertionError."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        
+        with pytest.raises(TemplateAssertionError) as excinfo:
+            env.from_string('{% trans domain=some_var %}Hello{% endtrans %}')
+        error_msg = str(excinfo.value).lower()
+        assert "domain" in error_msg
+        assert "literal" in error_msg
+
+    def test_newstyle_domain(self):
+        """Test newstyle gettext with domain."""
+        from markupsafe import Markup
+        
+        def newstyle_dgettext(ctx, domain, string, **variables):
+            result = f"[{domain}] {string}"
+            if ctx.eval_ctx.autoescape:
+                result = Markup(result)
+            return result % variables
+        
+        def newstyle_dngettext(ctx, domain, singular, plural, num, **variables):
+            variables.setdefault("num", num)
+            result = f"[{domain}] {plural if num != 1 else singular}"
+            if ctx.eval_ctx.autoescape:
+                result = Markup(result)
+            return result % variables
+        
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda ctx, s: s,
+            ngettext=lambda ctx, s, p, n: p if n != 1 else s,
+            dgettext=newstyle_dgettext,
+            dngettext=newstyle_dngettext,
+            newstyle=True,
+        )
+        
+        tmpl = env.from_string('{% trans domain="admin" %}Hello{% endtrans %}')
+        assert tmpl.render() == "[admin] Hello"
+
+    def test_uninstall_removes_domain_globals(self):
+        """Test that uninstall_gettext_translations removes domain globals."""
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            gettext=lambda s: s,
+            ngettext=lambda s, p, n: p if n != 1 else s,
+            dgettext=dgettext,
+            dngettext=dngettext,
+        )
+        
+        # Check domain globals exist
+        assert "dgettext" in env.globals
+        assert "dngettext" in env.globals
+        
+        # Uninstall
+        env.uninstall_gettext_translations()
+        
+        # Check domain globals removed
+        assert "dgettext" not in env.globals
+        assert "dngettext" not in env.globals
