+def truncate_description(description, max_chars):
+    """Truncate a description to fit within max_chars characters.
+    
+    Args:
+        description: The string to truncate.
+        max_chars: Maximum number of characters allowed. None means no limit.
+                   Must be a positive integer if not None.
+    
+    Returns:
+        The truncated description or the original if within limit.
+    
+    Raises:
+        ValueError: If max_chars is not None and is not a positive integer.
+    """
+    if max_chars is None:
+        return description
+    
+    # Validate max_chars: must be a positive integer, not boolean
+    if isinstance(max_chars, bool):
+        raise ValueError("max_chars must be a positive integer or None, not a boolean")
+    
+    if not isinstance(max_chars, int):
+        raise ValueError(f"max_chars must be a positive integer or None, got {type(max_chars).__name__}")
+    
+    if max_chars <= 0:
+        raise ValueError(f"max_chars must be a positive integer or None, got {max_chars}")
+    
+    # Count Python string characters, not encoded bytes
+    desc_len = len(description)
+    
+    if desc_len <= max_chars:
+        return description
+    
+    # Cap of one produces only …
+    if max_chars == 1:
+        return "…"
+    
+    # Reserve one character for the ellipsis
+    cap = max_chars - 1
+    
+    # Try to find the last complete sentence ending (. ! or ?, followed by whitespace or end)
+    # that fits within cap characters
+    last_sentence_end = -1
+    
+    # Search backwards from cap position
+    for i in range(cap - 1, -1, -1):
+        char = description[i]
+        if char in ".!?":
+            # Check if followed by whitespace or end of string
+            if i + 1 >= cap or description[i + 1].isspace():
+                last_sentence_end = i + 1
+                break
+    
+    if last_sentence_end > 0:
+        # Truncate at the sentence boundary and add ellipsis
+        result = description[:last_sentence_end].rstrip() + "…"
+        return result
+    else:
+        # No sentence boundary found, take hard prefix of cap-1 characters
+        result = description[:cap].rstrip() + "…"
+        return result
+
