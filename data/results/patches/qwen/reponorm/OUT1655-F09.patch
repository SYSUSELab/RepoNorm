+# Matches a GUID/UUID in braced format: {8-4-4-4-12} with hex digits
+guid = Regex(r"\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}")
diff --git a/tests/types/test_custom_types.py b/tests/types/test_custom_types.py
index 691b681..11850af 100644
--- a/tests/types/test_custom_types.py
+++ b/tests/types/test_custom_types.py
@@ -108,3 +108,42 @@ def test_type_enum(custom_type, test_string, should_match):
 
     does_match = test_string in custom_type.__members__
     assert does_match is should_match
+
+
+@pytest.mark.parametrize(
+    "test_string,should_match",
+    [
+        # Valid GUIDs with braces
+        ("{00000000-0000-0000-0000-000000000000}", True),
+        ("{FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF}", True),
+        ("{01234567-89AB-CDEF-0123-456789ABCDEF}", True),
+        ("{abcdef01-2345-6789-abcd-ef0123456789}", True),
+        ("{ABCDEF01-2345-6789-ABCD-EF0123456789}", True),
+        # Invalid GUIDs - no braces
+        ("00000000-0000-0000-0000-000000000000", False),
+        # Invalid GUIDs - parentheses instead of braces
+        ("(00000000-0000-0000-0000-000000000000)", False),
+        # Invalid GUIDs - wrong length segments
+        ("{0000000-0000-0000-0000-000000000000}", False),  # 7 chars
+        ("{00000000-0000-0000-0000-00000000000}", False),  # 11 chars
+        # Invalid GUIDs - whitespace inside
+        ("{00000000-0000-0000-0000-00000000000 }", False),
+        # Invalid GUIDs - non-hex characters
+        ("{GGGGGGGG-GGGG-GGGG-GGGG-GGGGGGGGGGGG}", False),
+        # Invalid GUIDs - mixed valid/invalid
+        ("{00000000-0000-0000-0000-00000000000g}", False),
+    ],
+)
+def test_guid(test_string, should_match):
+    class Model(BaseModel):
+        attr: types.guid
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(types.guid)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
