+# Global TTL state for the active global DSPy cache
+_global_ttl: Optional[float] = None
+_global_ttl_lock = threading.Lock()
+
+
+def set_ttl(seconds: Optional[float]) -> None:
+    global _global_ttl
+    """Set the TTL for the active global DSPy cache.
+    
+    Args:
+        seconds: Positive finite number of seconds for TTL, or None for no expiration.
+        
+    Raises:
+        ValueError: If seconds is zero, negative, nonfinite, boolean, or nonnumeric.
+    """
+    # Validate input: reject booleans first (before checking numeric type)
+    if isinstance(seconds, bool):
+        raise ValueError("TTL cannot be a boolean")
+    
+    if seconds is not None and not isinstance(seconds, (int, float)):
+        raise ValueError("TTL must be a positive finite number or None")
+    
+    if seconds is not None:
+        if seconds <= 0:
+            raise ValueError("TTL must be positive")
+        if not math.isfinite(seconds):
+            raise ValueError("TTL must be finite")
+    
+    with _global_ttl_lock:
+        _global_ttl = seconds
+
+
+def _get_global_ttl() -> Optional[float]:
+    """Get the current global TTL value."""
+    with _global_ttl_lock:
+        return _global_ttl
+
+
+def _wrap_value_with_expiry(value: Any, expiry_time: Optional[float]) -> Tuple[Any, Optional[float]]:
+    """Wrap a value with its expiry time for storage."""
+    return (value, expiry_time)
+
+
+def _unwrap_value_from_expiry(stored: Tuple[Any, Optional[float]]) -> Any:
+    """Unwrap a value from its stored format."""
+    return stored[0]
+
+
+def _is_expired(stored: Tuple[Any, Optional[float]]) -> bool:
+    """Check if a stored value has expired."""
+    _, expiry_time = stored
+    if expiry_time is None:
+        return False
+    return _get_current_time() > expiry_time
+
+
+def _get_current_time() -> float:
+    """Get the current time in seconds since epoch."""
+    import time
+    return time.time()
+
 
