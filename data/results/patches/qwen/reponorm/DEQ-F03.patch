+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address.
+
+    The supported grammar is deliberately finite, not full RFC email syntax.
+    The local part uses ASCII letters/digits and `_ % + -`, with dots only
+    between nonempty runs (no leading, trailing or consecutive dots).
+    Domain labels use ASCII letters/digits and internal hyphens; labels are
+    nonempty and cannot start or end with a hyphen. There are at least two
+    labels and the final label consists of at least two ASCII letters.
+
+    Args:
+        domain: Optional domain filter. If provided, the email's domain must
+            match exactly (case-sensitive). A subdomain is not an implicit match.
+
+    Examples:
+        ```py title="IsEmail"
+        from dirty_equals import IsEmail
+
+        assert "test@example.com" == IsEmail()
+        assert "test.email+tag@domain.co.uk" == IsEmail()
+        assert "user_name@test-domain.org" == IsEmail()
+
+        assert "test@example.com" == IsEmail("example.com")
+        assert "test@example.com" != IsEmail("other.com")
+        assert "sub.example.com" != IsEmail("example.com")  # subdomain not implicit match
+        ```
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        """
+        Args:
+            domain: Optional domain filter. If provided, the email's domain must
+                match exactly (case-sensitive).
+
+        Examples:
+            ```py title="IsEmail"
+            from dirty_equals import IsEmail
+
+            assert "test@example.com" == IsEmail()
+            assert "test@example.com" == IsEmail("example.com")
+            assert "test@example.com" != IsEmail("other.com")
+            ```
+        """
+        self.domain = domain
+        super().__init__(plain_repr('*') if domain is None else domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check basic email format
+        if '@' not in other:
+            return False
+
+        local_part, domain_part = other.rsplit('@', 1)
+
+        # Validate local part
+        # Must not be empty, no leading/trailing/consecutive dots
+        if not local_part:
+            return False
+        if local_part.startswith('.') or local_part.endswith('.'):
+            return False
+        if '..' in local_part:
+            return False
+        # Only allow specific chars: ASCII letters/digits and `_ % + - .`
+        for c in local_part:
+            if not (c.isalnum() or c in '_%+-.' ):
+                return False
+
+        # Validate domain
+        labels = domain_part.split('.')
+        if len(labels) < 2:
+            return False
+        for label in labels[:-1]:
+            if not label:
+                return False
+            if label.startswith('-') or label.endswith('-'):
+                return False
+            # Domain labels: ASCII letters/digits and internal hyphens
+            for c in label:
+                if not (c.isalnum() or c == '-'):
+                    return False
+        # Last label (TLD) must be at least 2 ASCII letters
+        tld = labels[-1]
+        if len(tld) < 2 or not tld.isalpha():
+            return False
+
+        # If domain filter is provided, check exact case-sensitive match
+        if self.domain is not None:
+            if domain_part != self.domain:
+                return False
+
+        return True
