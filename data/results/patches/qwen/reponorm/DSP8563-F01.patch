@@ -261,6 +263,47 @@ class ToolCalls(Type):
 
     tool_calls: list[ToolCall]
 
+    @pydantic.model_validator(mode="before")
+    @classmethod
+    def validate_input(cls, values: Any) -> Any:
+        """Normalize various input formats into the standard tool_calls container.
+
+        Accepts:
+            - Existing {"tool_calls": [...]} container (passes through)
+            - Single {"name": "...", "args": {...}} object (wraps in list)
+            - Bare list of objects (including empty list)
+            - Plain JSON strings representing any of the above
+            - Existing ToolCalls instance (passes through)
+
+        Returns normalized structures for model validation. Raises on malformed input.
+        """
+        # Pass through existing ToolCalls instances unchanged
+        if isinstance(values, cls):
+            return values
+
+        # Handle JSON strings by parsing them first
+        if isinstance(values, str):
+            try:
+                values = json.loads(values)
+            except (json.JSONDecodeError, ValueError):
+                # Non-JSON strings are returned unchanged and will be rejected by model validation
+                return values
+
+        # Handle single tool call object: {"name": "...", "args": {...}}
+        if isinstance(values, dict):
+            # Check if it's a single tool call (has name and args at top level)
+            if "name" in values and "args" in values:
+                return {"tool_calls": [values]}
+            # Otherwise assume it's already a {"tool_calls": [...]} container
+            return values
+
+        # Handle bare list of tool calls
+        if isinstance(values, list):
+            return {"tool_calls": values}
+
+        # For any other type, pass through and let model validation handle errors
+        return values
+
