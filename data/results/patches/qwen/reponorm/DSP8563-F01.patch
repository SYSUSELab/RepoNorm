+def test_tool_calls_validate_input_normalization(input_data, expected_names):
+    """Test that validate_input normalizes various input formats correctly."""
+    tool_calls = ToolCalls.model_validate(input_data)
+    names = [tc.name for tc in tool_calls.tool_calls]
+    assert names == expected_names
+
+
+def test_tool_calls_validate_input_from_dict_list():
+    """Test that from_dict_list still works as before."""
+    tool_calls = ToolCalls.from_dict_list(
+        [{"name": "search", "args": {"query": "hello"}}]
+    )
+    assert len(tool_calls.tool_calls) == 1
+    assert tool_calls.tool_calls[0].name == "search"
+
+
+def test_tool_calls_validate_input_existing_instance():
+    """Test that existing ToolCalls instances are passed through unchanged."""
+    original = ToolCalls.from_dict_list([{"name": "test", "args": {}}])
+    result = ToolCalls.model_validate(original)
+    assert result is original
