diff --git a/tests/types/test_custom_types.py b/tests/types/test_custom_types.py
index 691b681..1448491 100644
--- a/tests/types/test_custom_types.py
+++ b/tests/types/test_custom_types.py
@@ -108,3 +108,40 @@ def test_type_enum(custom_type, test_string, should_match):
 
     does_match = test_string in custom_type.__members__
     assert does_match is should_match
+
+
+@pytest.mark.parametrize(
+    "test_string,should_match",
+    [
+        # Valid binary strings
+        ("0b0", True),
+        ("0b1", True),
+        ("0b10", True),
+        ("0b101", True),
+        ("0b11111111", True),
+        ("0b0000", True),
+        # Invalid binary strings
+        ("0B101", False),  # uppercase prefix
+        ("0b", False),  # no digits after prefix
+        ("0b2", False),  # invalid digit
+        ("0b10a", False),  # invalid character
+        ("+0b101", False),  # sign prefix
+        ("0b_101", False),  # underscore
+        ("0b 101", False),  # whitespace
+        ("0b101abc", False),  # extra characters
+        ("-0b101", False),  # negative sign
+    ],
+)
+def test_binary_str(test_string, should_match):
+    class Model(BaseModel):
+        attr: types.binary_str
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(types.binary_str)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
