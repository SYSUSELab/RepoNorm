+    def extract_translations_with_metadata(
+        self, source: t.Union[str, nodes.Template], source_name: t.Optional[str] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract translations with metadata from the given template source.
+        
+        This method returns an iterator of independent record mappings for 
+        metadata-bearing translation blocks. Each record contains:
+        
+        - ``source``: The source name if provided, otherwise None
+        - ``lineno``: The line number of the trans block start
+        - ``metadata``: A copy of the metadata mapping (note, created, modified)
+        - ``messages``: List of message records containing lineno, function, and message
+        
+        Each message record contains:
+        - ``lineno``: The line number of the message
+        - ``function``: The gettext function used (gettext, ngettext, etc.)
+        - ``message``: The extracted message value (string or tuple for plural forms)
+        
+        Repeated extraction is stable and has no retained Environment state;
+        callers may modify returned records without affecting later results.
+        
+        :param source: Jinja source string or parsed AST node.
+        :param source_name: Optional name for the source being extracted.
+        :return: Iterator of translation records with metadata.
+        
+        .. versionadded:: 3.1.0
+        """
+        if isinstance(source, str):
+            ast = self.parse(source)
+        else:
+            ast = source
+            
+        # Get all translation blocks with their metadata
+        trans_blocks = []
+        for node in ast.find_all(nodes.Output):
+            if node.metadata:
+                trans_blocks.append((node, node.metadata))
+        
+        # Extract messages from each trans block
+        for block_node, block_metadata in trans_blocks:
+            messages = []
+            
+            # Find gettext calls within this specific trans block
+            for child in block_node.nodes:
+                self._extract_messages_from_node(child, messages)
+            
+            yield {
+                'source': source_name,
+                'lineno': block_node.lineno,
+                'metadata': dict(block_metadata),  # Copy to prevent mutation
+                'messages': messages,
+            }
+    
+    def _extract_messages_from_node(self, node: nodes.Node, messages: list) -> None:
+        """Recursively extract gettext messages from a node tree."""
+        if isinstance(node, nodes.Call):
+            if isinstance(node.node, nodes.Name) and node.node.name in ('gettext', 'ngettext', 'pgettext', 'npgettext'):
+                strings = []
+                for arg in node.args:
+                    if isinstance(arg, nodes.Const) and isinstance(arg.value, str):
+                        strings.append(arg.value)
+                    else:
+                        strings.append(None)
+                
+                for _ in node.kwargs:
+                    strings.append(None)
+                if node.dyn_args is not None:
+                    strings.append(None)
+                if node.dyn_kwargs is not None:
+                    strings.append(None)
+                
+                # Determine output format
+                out = tuple(x for x in strings if x is not None) if len(strings) != 1 else strings[0]
+                
+                messages.append({
+                    'lineno': node.lineno,
+                    'function': node.node.name,
+                    'message': out,
+                })
+        
+        # Recurse into child nodes
+        for field_name in node.fields:
+            value = getattr(node, field_name)
+            if isinstance(value, list):
+                for item in value:
+                    if isinstance(item, nodes.Node):
+                        self._extract_messages_from_node(item, messages)
+            elif isinstance(value, nodes.Node):
+                self._extract_messages_from_node(value, messages)
+
     def make_globals(
