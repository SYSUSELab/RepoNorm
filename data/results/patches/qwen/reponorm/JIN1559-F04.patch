+class TestMetadataExtraction:
+    """Tests for translation metadata extraction with note, created, modified keys."""
+
+    def test_trans_with_note_metadata(self):
+        """Test trans tag with note metadata key."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Test note" %}Hello{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source))
+        assert len(records) == 1
+        assert records[0]['metadata'] == {'note': 'Test note'}
+        assert records[0]['messages'][0]['message'] == 'Hello'
+
+    def test_trans_with_all_metadata_keys(self):
+        """Test trans tag with all three metadata keys."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Note", created="2024-01-01", modified="2024-06-01" %}World{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source))
+        assert len(records) == 1
+        assert records[0]['metadata'] == {
+            'note': 'Note',
+            'created': '2024-01-01',
+            'modified': '2024-06-01'
+        }
+
+    def test_trans_with_unicode_metadata(self):
+        """Test trans tag with Unicode values in metadata."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="日本語のノート" %}Unicode{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source))
+        assert len(records) == 1
+        assert records[0]['metadata'] == {'note': '日本語のノート'}
+
+    def test_trans_with_empty_string_metadata(self):
+        """Test trans tag with empty string value in metadata."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="" %}Empty{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source))
+        assert len(records) == 1
+        assert records[0]['metadata'] == {'note': ''}
+
+    def test_trans_duplicate_metadata_key_error(self):
+        """Test that duplicate metadata keys raise TemplateAssertionError."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Note1", note="Note2" %}Hello{% endtrans %}"""
+        with pytest.raises(TemplateAssertionError) as exc_info:
+            env.parse(source)
+        assert "duplicate" in str(exc_info.value).lower() or "twice" in str(exc_info.value).lower()
+        assert "'note'" in str(exc_info.value)
+
+    def test_trans_non_string_metadata_value_error(self):
+        """Test that non-string metadata values raise TemplateAssertionError."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note=variable %}Hello{% endtrans %}"""
+        with pytest.raises(TemplateAssertionError) as exc_info:
+            env.parse(source)
+        assert "string literal" in str(exc_info.value).lower()
+        assert "'note'" in str(exc_info.value)
+
+    def test_trans_invalid_key_treated_as_variable(self):
+        """Test that invalid metadata keys are treated as variables."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans invalid_key="value" %}Hello{% endtrans %}"""
+        ast = env.parse(source)
+        # Should not have metadata on Output nodes
+        output_nodes = list(ast.find_all(nodes.Output))
+        assert all(node.metadata is None for node in output_nodes)
+
+    def test_extract_translations_with_metadata_stability(self):
+        """Test that returned records are independent and stable."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Test note" %}Hello World{% endtrans %}"""
+        
+        records1 = list(env.extract_translations_with_metadata(source, source_name="test.html"))
+        original_metadata = dict(records1[0]['metadata'])
+        
+        # Modify the returned record
+        records1[0]['metadata']['note'] = "MODIFIED"
+        
+        # Extract again - should be unchanged
+        records2 = list(env.extract_translations_with_metadata(source, source_name="test.html"))
+        assert records2[0]['metadata'] == original_metadata
+
+    def test_extract_translations_with_metadata_multiple_blocks(self):
+        """Test extraction from multiple trans blocks."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """
+{% trans note="First note" %}First message{% endtrans %}
+{% trans created="2024-01-01", modified="2024-06-01" %}Second message{% endtrans %}
+"""
+        records = list(env.extract_translations_with_metadata(source, source_name="multi.html"))
+        assert len(records) == 2
+        
+        # First block
+        assert records[0]['source'] == 'multi.html'
+        assert records[0]['lineno'] == 2
+        assert records[0]['metadata'] == {'note': 'First note'}
+        assert records[0]['messages'][0]['message'] == 'First message'
+        
+        # Second block
+        assert records[1]['source'] == 'multi.html'
+        assert records[1]['lineno'] == 3
+        assert records[1]['metadata'] == {'created': '2024-01-01', 'modified': '2024-06-01'}
+        assert records[1]['messages'][0]['message'] == 'Second message'
+
+    def test_extract_translations_with_metadata_plural_form(self):
+        """Test extraction with plural forms."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Plural note", count=n %}{{ n }} item{% pluralize %}{{ n }} items{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source, source_name="test.html"))
+        assert len(records) == 1
+        assert records[0]['metadata'] == {'note': 'Plural note'}
+        assert records[0]['messages'][0]['function'] == 'ngettext'
+        assert isinstance(records[0]['messages'][0]['message'], tuple)
+        assert len(records[0]['messages'][0]['message']) == 2
+
+    def test_extract_translations_with_metadata_source_name(self):
+        """Test that source_name parameter is correctly included."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Test" %}Hello{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source, source_name="my_template.html"))
+        assert len(records) == 1
+        assert records[0]['source'] == 'my_template.html'
+
+    def test_extract_translations_with_metadata_no_metadata(self):
+        """Test that templates without metadata don't produce records."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans %}Hello{% endtrans %}"""
+        records = list(env.extract_translations_with_metadata(source))
+        assert len(records) == 0
+
+    def test_extract_translations_with_metadata_ast_node_input(self):
+        """Test that AST node can be passed directly."""
+        env = Environment(extensions=['jinja2.ext.i18n'])
+        source = """{% trans note="Test" %}Hello{% endtrans %}"""
+        ast = env.parse(source)
+        records = list(env.extract_translations_with_metadata(ast, source_name="from_ast"))
+        assert len(records) == 1
+        assert records[0]['source'] == 'from_ast'
