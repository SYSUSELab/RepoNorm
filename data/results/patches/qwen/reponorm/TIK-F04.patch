+
+
+# ====================
+# Chunked encoding
+# ====================
+
+
+def test_chunk_basic():
+    """Test basic chunking with overlap."""
+    enc = tiktoken.get_encoding("gpt2")
+    # 'abcde' with size 3, overlap 1 should give ['abc', 'cde']
+    result = enc.encode("abcde", chunk_size=3, chunk_overlap=1)
+    assert len(result) == 2
+    # Verify that decoding each window independently gives back the original windows
+    decoded_windows = [enc.decode(tokens) for tokens in result]
+    assert decoded_windows == ["abc", "cde"]
+
+
+def test_chunk_no_overlap():
+    """Test chunking without overlap."""
+    enc = tiktoken.get_encoding("gpt2")
+    # 'abcdef' with size 3, overlap 0 should give ['abc', 'def']
+    result = enc.encode("abcdef", chunk_size=3, chunk_overlap=0)
+    assert len(result) == 2
+    decoded_windows = [enc.decode(tokens) for tokens in result]
+    assert decoded_windows == ["abc", "def"]
+
+
+def test_chunk_empty_text():
+    """Test that empty text yields [[]]."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("", chunk_size=3)
+    assert result == [[]]
+
+
+def test_chunk_single_window():
+    """Test that text shorter than chunk_size returns single window."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("ab", chunk_size=3, chunk_overlap=1)
+    assert len(result) == 1
+    decoded = enc.decode(result[0])
+    assert decoded == "ab"
+
+
+def test_chunk_boundary_exact():
+    """Test chunking where text length is exact multiple of (chunk_size - overlap)."""
+    enc = tiktoken.get_encoding("gpt2")
+    # With size=3, overlap=1, step=2. Text 'abcdef' has length 6.
+    # Windows: [0:3]='abc', [2:5]='cde', [4:7]='ef' -> stops at end
+    result = enc.encode("abcdef", chunk_size=3, chunk_overlap=1)
+    assert len(result) == 3
+    decoded_windows = [enc.decode(tokens) for tokens in result]
+    assert decoded_windows == ["abc", "cde", "ef"]
+
+
+def test_chunk_invalid_bool_chunk_size():
+    """Test that bool chunk_size raises ValueError."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError, match="chunk_size must be an integer or None"):
+        enc.encode("test", chunk_size=True)
+    with pytest.raises(ValueError, match="chunk_size must be an integer or None"):
+        enc.encode("test", chunk_size=False)
+
+
+def test_chunk_invalid_negative_chunk_size():
+    """Test that negative chunk_size raises ValueError."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError, match="chunk_size must be a positive integer"):
+        enc.encode("test", chunk_size=-1)
+    with pytest.raises(ValueError, match="chunk_size must be a positive integer"):
+        enc.encode("test", chunk_size=0)
+
+
+def test_chunk_invalid_overlap_ge_size():
+    """Test that overlap >= size raises ValueError."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError, match="chunk_overlap must be less than chunk_size"):
+        enc.encode("test", chunk_size=3, chunk_overlap=3)
+    with pytest.raises(ValueError, match="chunk_overlap must be less than chunk_size"):
+        enc.encode("test", chunk_size=3, chunk_overlap=5)
+
+
+def test_chunk_invalid_negative_overlap():
+    """Test that negative overlap raises ValueError."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError, match="chunk_overlap must be non-negative"):
+        enc.encode("test", chunk_size=3, chunk_overlap=-1)
+
+
+def test_chunk_invalid_non_int_chunk_size():
+    """Test that non-integer chunk_size raises ValueError."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError, match="chunk_size must be an integer or None"):
+        enc.encode("test", chunk_size=3.5)
+    with pytest.raises(ValueError, match="chunk_size must be an integer or None"):
+        enc.encode("test", chunk_size="3")
+
+
+def test_chunk_disallowed_special_full_text():
+    """Test that disallowed special check applies to full text before splitting."""
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "<|endoftext|> hello"
+    with pytest.raises(ValueError):
+        enc.encode(text, chunk_size=5)
+
+
+def test_chunk_allowed_special_whole_window():
+    """Test that allowed special tokens wholly within a window encode normally."""
+    enc = tiktoken.get_encoding("cl100k_base")
+    text = "hello <|endoftext|> world"
+    result = enc.encode(text, chunk_size=20, allowed_special="all")
+    # Should have multiple windows
+    assert len(result) > 1
+    # Check that endoftext token appears in one of the windows
+    eot_token = enc.eot_token
+    found_eot = any(eot_token in window for window in result)
+    assert found_eot
+
+
+def test_chunk_unicode_surrogates():
+    """Test that Unicode surrogate pairs are handled correctly in chunked encoding."""
+    enc = tiktoken.get_encoding("cl100k_base")
+    # Test with emoji (surrogate pair)
+    text = "\ud83d\udc4d test \ud83d\ude00"
+    result = enc.encode(text, chunk_size=20)
+    assert len(result) > 0
+    # Decode should work
+    decoded = "".join(enc.decode(tokens) for tokens in result)
+    # Note: due to chunking, we may not get exact roundtrip
+    # but the encoding should not raise an error
+
+
+def test_chunk_without_chunk_size_returns_list():
+    """Test that without chunk_size, encode returns list[int], not list[list[int]]."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("hello world")
+    assert isinstance(result, list)
+    assert all(isinstance(x, int) for x in result)
+    assert not isinstance(result[0], list)
+
+
+def test_chunk_with_chunk_size_returns_list_of_lists():
+    """Test that with chunk_size, encode returns list[list[int]]."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("hello world", chunk_size=5)
+    assert isinstance(result, list)
+    assert all(isinstance(x, list) for x in result)
