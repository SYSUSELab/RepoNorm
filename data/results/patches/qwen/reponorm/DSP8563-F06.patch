+# Tests for markdown code fence support in ToolCalls
+def test_tool_calls_model_validate_markdown_fence():
+    """Test that ToolCalls.model_validate accepts JSON wrapped in markdown code fence."""
+    from dspy.adapters.types.tool import ToolCalls
+    
+    # Test with json label
+    text = """```json
+[{"name": "test", "args": {"x": 1}}]
+```"""
+    result = ToolCalls.model_validate(text)
+    assert len(result.tool_calls) == 1
+    assert result.tool_calls[0].name == "test"
+    
+    # Test without label
+    text2 = """```
+[{"name": "test2", "args": {"y": 2}}]
+```"""
+    result2 = ToolCalls.model_validate(text2)
+    assert len(result2.tool_calls) == 1
+    assert result2.tool_calls[0].name == "test2"
+    
+    # Test with JSON uppercase label
+    text3 = """```JSON
+[{"name": "test3", "args": {"z": 3}}]
+```"""
+    result3 = ToolCalls.model_validate(text3)
+    assert len(result3.tool_calls) == 1
+    assert result3.tool_calls[0].name == "test3"
