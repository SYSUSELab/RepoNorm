+    def validate_input(cls, data: Any):
+        """Validate and preprocess input for ToolCalls.
+
+        Accepts:
+        - Canonical container: {"tool_calls": [...]}
+        - Bare list: [{"name": "...", "args": {...}}, ...]
+        - Single object: {"name": "...", "args": {...}}
+        - JSON string wrapped in markdown code fence: ```json
+{json}
+```
+        - Plain JSON string: "[...]" or "{"tool_calls": [...]}"
+
+        Returns the processed data or raises validation error.
+        """
+        if isinstance(data, cls):
+            return data
+
+        # Handle string input (JSON or markdown-wrapped JSON)
+        if isinstance(data, str):
+            # Try to extract JSON from markdown code fence
+            extracted = _extract_json_from_markdown(data)
+            if extracted is not None:
+                data = extracted
+
+            # Parse JSON string
+            try:
+                import json
+                data = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                # If JSON parsing fails, let pydantic handle it
+                pass
+
+        # Handle bare list: convert to canonical format
+        if isinstance(data, list):
+            return {"tool_calls": data}
+
+        # Handle single object: wrap in list
+        if isinstance(data, dict):
+            # Check if this looks like a single tool call (has name and args keys)
+            if "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+
+        return data
