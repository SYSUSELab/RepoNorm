+def _extract_json_from_markdown(text: str) -> str | None:
+    """Extract JSON from markdown code fence.
+
+    Accepts:
+    - First triple-backtick block with any language label (including json, JSON, or no label)
+    - Followed by a newline
+    - Next triple-backtick delimiter closes it
+
+    Returns the trimmed body as string, or None if no valid fence found.
+
+    Does NOT support:
+    - Inline fences without opening newline
+    - Missing closures
+    - Malformed JSON (JSON parsing is done separately)
+    """
+    # Pattern for markdown code fence: ``` followed by optional language, newline, content, closing ```
+    # The opening fence may have any language label (including json, JSON, or no label), followed by a newline
+    pattern = r"^\s*```(?:[a-zA-Z]+)?\n(.*?)^\s*```"
+    match = re.search(pattern, text, re.DOTALL | re.MULTILINE)
+    if match:
+        return match.group(1).strip()
+    return None
+
