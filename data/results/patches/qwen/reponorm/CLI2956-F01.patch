+def _get_auto_complete_strategy(
+    param: Parameter, incomplete: str
+) -> list[CompletionItem] | None:
+    """Determine if auto-completion should be used based on the parameter name.
+    
+    Returns a list of CompletionItems if auto-completion is applicable,
+    or None if it should fall back to normal completion.
+    """
+    strategy = param.auto_complete
+    
+    # If False, no auto-completion
+    if strategy is False:
+        return None
+    
+    # If True, determine strategy from option name
+    if strategy is True:
+        name = param.name
+        if name is None:
+            return None
+        
+        tokens = name.split("_")
+        
+        # Check for username-related tokens
+        username_tokens = {"user", "username", "owner", "author"}
+        if any(token in username_tokens for token in tokens):
+            return _complete_username(incomplete)
+        
+        # Check for branch/ref/revision tokens
+        branch_tokens = {"branch", "ref", "revision", "rev"}
+        if any(token in branch_tokens for token in tokens):
+            return _complete_branch(incomplete)
+        
+        # Check for environment tokens
+        env_tokens = {"env", "environment"}
+        if any(token in env_tokens for token in tokens):
+            return _complete_environment(incomplete)
+        
+        # Check for directory tokens first (more specific than path)
+        dir_tokens = {"dir", "directory"}
+        if any(token in dir_tokens for token in tokens):
+            return _complete_directory(incomplete)
+        
+        # Check for path-related tokens
+        path_tokens = {"path", "input", "output", "file"}
+        if any(token in path_tokens for token in tokens):
+            return _complete_path(incomplete)
+        
+        # No matching strategy found
+        return None
+    
+    # If string, use explicit strategy
+    if isinstance(strategy, str):
+        if strategy == "user":
+            return _complete_username(incomplete)
+        elif strategy == "branch":
+            return _complete_branch(incomplete)
+        elif strategy == "environment":
+            return _complete_environment(incomplete)
+        elif strategy == "file":
+            return _complete_path(incomplete)
+        elif strategy == "directory":
+            return _complete_directory(incomplete)
+    
+    return None
+
+
+def _complete_username(incomplete: str) -> list[CompletionItem]:
+    """Complete usernames from the system password database."""
+    try:
+        import pwd
+        
+        results = []
+        for entry in pwd.getpwall():
+            username = entry.pw_name
+            # Exclude usernames starting with underscore
+            if username.startswith("_"):
+                continue
+            
+            if username.startswith(incomplete):
+                results.append(CompletionItem(username))
+        
+        # Sort and limit to 20 results
+        results.sort(key=lambda x: x.value)
+        return results[:20]
+    except (ImportError, OSError, KeyError):
+        # Fallback to empty list if pwd module unavailable
+        return []
+
+
+def _complete_branch(incomplete: str) -> list[CompletionItem]:
+    """Complete Git branch names."""
+    import subprocess
+    
+    try:
+        result = subprocess.run(
+            ["git", "branch", "-a"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+        
+        if result.returncode != 0:
+            return []
+        
+        branches = set()
+        for line in result.stdout.splitlines():
+            # Remove leading asterisk for current branch indicator
+            branch = line.lstrip("* ").lstrip()
+            # Remove remote tracking suffixes
+            if "/" in branch:
+                branch = branch.split("/")[-1]
+            # Skip empty lines and comments
+            if branch and not branch.startswith("#"):
+                branches.add(branch)
+        
+        # Filter by incomplete prefix
+        results = [
+            CompletionItem(branch)
+            for branch in sorted(branches)
+            if branch.startswith(incomplete)
+        ]
+        
+        return results[:20]
+    except (subprocess.SubprocessError, OSError, ValueError):
+        # Fallback to empty list if git command fails
+        return []
+
+
+def _complete_environment(incomplete: str) -> list[CompletionItem]:
+    """Complete environment variable names."""
+    import os
+    
+    env_vars = os.environ.keys()
+    results = [
+        CompletionItem(var)
+        for var in sorted(env_vars)
+        if var.startswith(incomplete)
+    ]
+    
+    return results[:20]
+
+
+def _complete_path(incomplete: str) -> list[CompletionItem]:
+    """Complete file paths using Path completion."""
+    from pathlib import Path
+    
+    # Handle tilde expansion
+    if incomplete.startswith("~"):
+        home = str(Path.home())
+        incomplete = incomplete.replace("~", home, 1)
+    
+    # Use Path's glob-like completion
+    path = Path(incomplete)
+    
+    # If incomplete ends with separator, complete directories/files at that level
+    if incomplete.endswith(os.sep) or incomplete.endswith("/"):
+        try:
+            matches = list(path.glob("*"))
+        except (OSError, ValueError):
+            return []
+    else:
+        # Try to match partial paths
+        try:
+            parent = path.parent
+            stem = path.name
+            if parent.exists():
+                matches = [p for p in parent.iterdir() if p.name.startswith(stem)]
+            else:
+                return []
+        except (OSError, ValueError):
+            return []
+    
+    results = []
+    for match in matches:
+        # Add trailing slash for directories
+        suffix = os.sep if match.is_dir() else ""
+        value = str(match.relative_to(Path.cwd())) if match.is_absolute() else str(match)
+        results.append(CompletionItem(value + suffix))
+    
+    # Sort and limit results
+    results.sort(key=lambda x: x.value)
+    return results[:20]
+
+
+def _complete_directory(incomplete: str) -> list[CompletionItem]:
+    """Complete directory paths only."""
+    from pathlib import Path
+    
+    # Handle tilde expansion
+    if incomplete.startswith("~"):
+        home = str(Path.home())
+        incomplete = incomplete.replace("~", home, 1)
+    
+    path = Path(incomplete)
+    
+    # Only complete directories
+    try:
+        if incomplete.endswith(os.sep) or incomplete.endswith("/"):
+            matches = list(path.glob("*"))
+        else:
+            parent = path.parent
+            stem = path.name
+            if parent.exists():
+                matches = [p for p in parent.iterdir() if p.name.startswith(stem)]
+            else:
+                return []
+    except (OSError, ValueError):
+        return []
+    
+    results = []
+    for match in matches:
+        if match.is_dir():
+            # Add trailing slash for directories
+            suffix = os.sep
+            value = str(match.relative_to(Path.cwd())) if match.is_absolute() else str(match)
+            results.append(CompletionItem(value + suffix))
+    
+    # Sort and limit results
+    results.sort(key=lambda x: x.value)
+    return results[:20]
+
