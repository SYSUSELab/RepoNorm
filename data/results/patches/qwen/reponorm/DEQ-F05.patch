@@ -0,0 +1,138 @@
+import pytest
+
+from dirty_equals import IsPhoneNumber
+
+
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        # Generic validation - valid cases
+        ("+1-555-123-4567", IsPhoneNumber()),
+        ("555-123-4567", IsPhoneNumber()),
+        ("+44 20 7946 0958", IsPhoneNumber()),
+        ("020 7946 0958", IsPhoneNumber()),
+        ("+91 98765 43210", IsPhoneNumber()),
+        ("1234567", IsPhoneNumber()),  # 7-digit minimum without +
+        ("123456789012345", IsPhoneNumber()),  # 15-digit maximum without +
+        ("+1234567890123456789", IsPhoneNumber()),  # 19-digit max with +
+        ("+1 (555) 123-4567", IsPhoneNumber()),  # Valid +1 with parens
+        ("(555) 123-4567", IsPhoneNumber()),  # Valid with parens
+        ("+1.555.123.4567", IsPhoneNumber()),  # Valid with dots
+        ("+1\t555\t123\t4567", IsPhoneNumber()),  # Valid with tabs
+    ],
+)
+def test_is_phone_number_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        # Invalid generic cases
+        ("", IsPhoneNumber()),
+        ("abc-def-ghij", IsPhoneNumber()),
+        (123, IsPhoneNumber()),
+        (None, IsPhoneNumber()),
+        ([], IsPhoneNumber()),
+        ({}, IsPhoneNumber()),
+        ("+123", IsPhoneNumber()),  # Too few digits with +
+        ("123456", IsPhoneNumber()),  # Too few digits without +
+        ("1234567890123456", IsPhoneNumber()),  # Too many digits without +
+        ("+12345678901234567890", IsPhoneNumber()),  # Too many digits with +
+        ("++1-555-123-4567", IsPhoneNumber()),  # Multiple plus signs
+        ("1+-555-123-4567", IsPhoneNumber()),  # Plus not at start
+        ("(555(123)-4567", IsPhoneNumber()),  # Nested parens
+        ("555)123-(4567", IsPhoneNumber()),  # Unbalanced parens
+        ("555-123-4567@", IsPhoneNumber()),  # Invalid char @
+        ("+1-555-123-4567\n", IsPhoneNumber()),  # Newline
+        ("+1-555-123-4567\r", IsPhoneNumber()),  # Carriage return
+    ],
+)
+def test_is_phone_number_false(other, dirty):
+    assert other != dirty
+
+
+# US-specific validation
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        ("555-123-4567", IsPhoneNumber("US")),
+        ("+1-555-123-4567", IsPhoneNumber("US")),
+        ("(555) 123-4567", IsPhoneNumber("US")),
+        ("555.123.4567", IsPhoneNumber("US")),
+        ("555 123 4567", IsPhoneNumber("US")),
+        ("+1 (555) 123-4567", IsPhoneNumber("US")),
+        # Case-insensitive country codes
+        ("555-123-4567", IsPhoneNumber("us")),
+        ("555-123-4567", IsPhoneNumber("Us")),
+    ],
+)
+def test_is_phone_number_us_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        # Invalid US cases
+        ("12345678901", IsPhoneNumber("US")),  # 11-digit without +
+        ("+1-555-123-456", IsPhoneNumber("US")),  # +1 with 9 digits
+        ("+1-555-123-45678", IsPhoneNumber("US")),  # +1 with 12 digits
+        ("555-123-456", IsPhoneNumber("US")),  # 9-digit national
+        ("555-123-45678", IsPhoneNumber("US")),  # 11-digit national
+    ],
+)
+def test_is_phone_number_us_false(other, dirty):
+    assert other != dirty
+
+
+# GB-specific validation
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        ("020 7946 0958", IsPhoneNumber("GB")),
+        ("+44 20 7946 0958", IsPhoneNumber("GB")),
+        ("02071234567", IsPhoneNumber("GB")),  # 11-digit national
+        ("+44 7911 123456", IsPhoneNumber("GB")),  # +44 with mobile
+        ("+44 20 7946 09589", IsPhoneNumber("GB")),  # +44 with 13 digits
+        # Case-insensitive country codes
+        ("020 7946 0958", IsPhoneNumber("gb")),
+        ("020 7946 0958", IsPhoneNumber("Gb")),
+    ],
+)
+def test_is_phone_number_gb_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        # Invalid GB cases
+        ("07946 0958", IsPhoneNumber("GB")),  # 9-digit national (too short)
+        ("20 7946 0958", IsPhoneNumber("GB")),  # Without leading 0
+        ("+44 20 7946 095", IsPhoneNumber("GB")),  # +44 with 11 digits
+        ("+44 20 7946 095890", IsPhoneNumber("GB")),  # +44 with 14 digits
+    ],
+)
+def test_is_phone_number_gb_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_phone_number_repr():
+    # Generic validator should display as IsPhoneNumber(*)
+    is_phone = IsPhoneNumber()
+    assert repr(is_phone) == "IsPhoneNumber(*)"
+    
+    # Country-specific should display with quotes
+    is_phone_us = IsPhoneNumber("US")
+    assert repr(is_phone_us) == "IsPhoneNumber('US')"
+    
+    is_phone_gb = IsPhoneNumber("GB")
+    assert repr(is_phone_gb) == "IsPhoneNumber('GB')"
+
+
+def test_is_phone_number_false_repr():
+    is_phone = IsPhoneNumber()
+    with pytest.raises(AssertionError):
+        assert "123" == is_phone
+    assert str(is_phone) == "IsPhoneNumber(*)"
