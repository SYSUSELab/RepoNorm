@@ -0,0 +1,189 @@
+import re
+from typing import Any, Literal, Optional
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid phone number.
+
+    This validator supports flexible phone number validation across different international formats
+    and country codes. It handles common phone number formats including international notation
+    (e.g., `+1-555-123-4567`), national formats (e.g., `555-123-4567`), and various delimiter styles
+    (spaces, dashes, parentheses, dots).
+
+    Args:
+        country: Optional country code to validate against specific country rules.
+            Supported countries are 'US' (United States) and 'GB' (United Kingdom).
+            Country codes are matched case-insensitively. If omitted, generic international
+            validation is used.
+
+    Examples:
+        ```py title="IsPhoneNumber"
+        from dirty_equals import IsPhoneNumber
+
+        # Generic validation - accepts any valid phone number format
+        assert '+1-555-123-4567' == IsPhoneNumber()
+        assert '555-123-4567' == IsPhoneNumber()
+        assert '+44 20 7946 0958' == IsPhoneNumber()
+
+        # US-specific validation
+        assert '555-123-4567' == IsPhoneNumber('US')
+        assert '+1-555-123-4567' == IsPhoneNumber('US')
+        assert '(555) 123-4567' == IsPhoneNumber('US')
+
+        # GB-specific validation
+        assert '020 7946 0958' == IsPhoneNumber('GB')
+        assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+
+        # Invalid examples
+        assert 123 != IsPhoneNumber()
+        assert '' != IsPhoneNumber()
+        assert 'abc-def-ghij' != IsPhoneNumber()
+        ```
+    """
+
+    def __init__(self, country: Optional[Literal['US', 'GB']] = None):
+        """
+        Args:
+            country: Optional country code ('US' or 'GB'). If omitted, generic validation is used.
+                Country codes are matched case-insensitively.
+        """
+        self.country = country.upper() if country else None
+        super().__init__(plain_repr('*') if not country else country)
+
+    def equals(self, other: Any) -> bool:
+        # Only accept string inputs
+        if not isinstance(other, str):
+            return False
+
+        # Reject empty strings
+        if not other.strip():
+            return False
+
+        # Validate the raw input format first
+        if not self._is_valid_raw_format(other):
+            return False
+
+        # Extract digits only
+        digits = self._extract_digits(other)
+
+        # Check digit count constraints
+        if self.country == 'US':
+            return self._validate_us(digits, other)
+        elif self.country == 'GB':
+            return self._validate_gb(digits, other)
+        else:
+            return self._validate_generic(digits, other)
+
+    def _is_valid_raw_format(self, s: str) -> bool:
+        """
+        Validate the raw input format according to the precise syntax boundary:
+        - Only ASCII digits, spaces/tabs, dashes, dots and balanced, non-nested parentheses containing digits are accepted
+        - At most one plus is allowed, at the start of the input
+        - Newlines and other characters are invalid
+        """
+        # Check for newlines or other invalid characters
+        if '\n' in s or '\r' in s:
+            return False
+
+        # Check for plus sign - must be at the start if present
+        if '+' in s:
+            if s[0] != '+':
+                return False
+            # There should be exactly one plus at the start
+            if s.count('+') != 1:
+                return False
+
+        # Valid separator characters (including + which we already validated)
+        valid_chars = set('0123456789 \t-.().+')
+
+        # Check each character
+        i = 0
+        paren_depth = 0
+        while i < len(s):
+            c = s[i]
+
+            if c == '(':
+                # Parentheses must be balanced and non-nested
+                if paren_depth > 0:
+                    return False  # Nested parentheses
+                paren_depth = 1
+                # Next char after '(' must be a digit
+                if i + 1 >= len(s) or not s[i + 1].isdigit():
+                    return False
+            elif c == ')':
+                if paren_depth == 0:
+                    return False  # Unbalanced closing paren
+                paren_depth = 0
+                # Previous char before ')' must be a digit
+                if i == 0 or not s[i - 1].isdigit():
+                    return False
+            elif c not in valid_chars:
+                return False  # Invalid character
+
+            i += 1
+
+        # All parentheses must be closed
+        if paren_depth != 0:
+            return False
+
+        return True
+
+    def _extract_digits(self, s: str) -> str:
+        """Extract only digits from the phone number string."""
+        return ''.join(c for c in s if c.isdigit())
+
+    def _has_international_prefix(self, s: str) -> bool:
+        """Check if the string has an international prefix (+ at start)."""
+        return s.startswith('+')
+
+    def _validate_generic(self, digits: str, s: str) -> bool:
+        """
+        Validate using generic international syntax:
+        - With country code (+): 8-19 digits total
+        - Without country code: 7-15 digits
+        """
+        # Check if it starts with + (international format)
+        has_plus = self._has_international_prefix(s)
+
+        if has_plus:
+            # International format: 8-19 digits
+            return 8 <= len(digits) <= 19
+        else:
+            # National format: 7-15 digits
+            return 7 <= len(digits) <= 15
+
+    def _validate_us(self, digits: str, s: str) -> bool:
+        """
+        Validate US phone numbers:
+        - National format: 10 digits (no country code)
+        - International format: +1 followed by 10 digits (total 11 digits)
+        """
+        if self._has_international_prefix(s):
+            # International format: +1 followed by 10 digits
+            return len(digits) == 11
+        else:
+            # National format: 10 digits
+            return len(digits) == 10
+
+    def _validate_gb(self, digits: str, s: str) -> bool:
+        """
+        Validate GB phone numbers:
+        - National format: 10-11 digits starting with 0
+        - International format: +44 followed by 10-11 digits (total 12-13 digits)
+        """
+        if self._has_international_prefix(s):
+            # International format: +44 followed by 10-11 digits
+            # Total should be 12-13 digits (2 for +44 + 10-11 for the rest)
+            return 12 <= len(digits) <= 13
+        else:
+            # National format: 10-11 digits starting with 0
+            return 10 <= len(digits) <= 11 and digits.startswith('0')
diff --git a/tests/test_phone.py b/tests/test_phone.py
