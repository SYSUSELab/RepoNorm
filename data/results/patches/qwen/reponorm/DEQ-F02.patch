+# Tests for IsMac
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        # Valid MAC addresses in various formats
+        ('00:1A:2B:3C:4D:5E', IsMac()),
+        ('00:1A:2B:3C:4D:5E', IsMac),
+        ('00-1A-2B-3C-4D-5E', IsMac()),
+        ('00-1A-2B-3C-4D-5E', IsMac),
+        ('001A.2B3C.4D5E', IsMac()),
+        ('001A.2B3C.4D5E', IsMac),
+        ('001A2B3C4D5E', IsMac()),
+        ('001A2B3C4D5E', IsMac),
+        # Case insensitivity
+        ('00:1a:2b:3c:4d:5e', IsMac()),
+        ('00:1A:2B:3C:4D:5E', IsMac('colon')),
+        ('00-1A-2B-3C-4D-5E', IsMac('hyphen')),
+        ('001A.2B3C.4D5E', IsMac('dot')),
+        ('001A2B3C4D5E', IsMac('compact')),
+    ],
+)
+def test_is_mac_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        # Invalid MAC addresses
+        ('foobar', IsMac()),
+        ([1, 2, 3], IsMac()),
+        (123, IsMac()),
+        (None, IsMac()),
+        ('', IsMac()),
+        # Wrong format lengths
+        ('00:1A:2B:3C:4D', IsMac()),  # too short
+        ('00:1A:2B:3C:4D:5E:6F', IsMac()),  # too long
+        ('00-1A-2B-3C-4D', IsMac()),  # hyphen too short
+        ('001A.2B3C.4D', IsMac()),  # dot too short
+        ('001A2B3C4D', IsMac()),  # compact too short
+        # Invalid hex characters
+        ('00:1A:2B:3C:4D:GG', IsMac()),
+        ('00-1A-2B-3C-4D-GG', IsMac()),
+        ('001A.2B3C.4DGZ', IsMac()),
+        ('001A2B3C4DGZ', IsMac()),
+        # Mixed separators
+        ('00 1A:2B:3C:4D:5E', IsMac()),
+        ('00:1A-2B:3C:4D:5E', IsMac()),
+        # Whitespace
+        (' 00:1A:2B:3C:4D:5E', IsMac()),
+        ('00:1A:2B:3C:4D:5E ', IsMac()),
+        ('00:1A:2B:3C:4D:5E\n', IsMac()),
+        # Wrong format restriction
+        ('00-1A-2B-3C-4D-5E', IsMac('colon')),
+        ('00:1A:2B:3C:4D:5E', IsMac('hyphen')),
+        ('001A.2B3C.4D5E', IsMac('colon')),
+        ('001A2B3C4D5E', IsMac('dot')),
+    ],
+)
+def test_is_mac_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_mac_repr():
+    is_mac = IsMac()
+    with pytest.raises(AssertionError):
+        assert '123' == is_mac
+    assert str(is_mac) == 'IsMac(*)'
+
+
+def test_is_mac_colon_repr():
+    is_mac = IsMac('colon')
+    with pytest.raises(AssertionError):
+        assert '123' == is_mac
+    assert str(is_mac) == "IsMac('colon')"
+
+
+def test_is_mac_hyphen_repr():
+    is_mac = IsMac('hyphen')
+    assert str(is_mac) == "IsMac('hyphen')"
+
+
+def test_is_mac_dot_repr():
+    is_mac = IsMac('dot')
+    assert str(is_mac) == "IsMac('dot')"
+
+
+def test_is_mac_compact_repr():
+    is_mac = IsMac('compact')
+    assert str(is_mac) == "IsMac('compact')"
