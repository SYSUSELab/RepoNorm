+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address.
+
+    MAC addresses are six-octet hexadecimal values that can be represented in various formats:
+    - Colon-separated: `00:1A:2B:3C:4D:5E`
+    - Hyphen-separated: `00-1A-2B-3C-4D-5E`
+    - Three-group dotted (Cisco): `001A.2B3C.4D5E`
+    - Compact (no separators): `001A2B3C4D5E`
+
+    Matching is case-insensitive for hexadecimal digits. Malformed lengths, non-hexadecimal
+    characters, mixed separators, and non-string values compare unequal.
+
+    The optional format argument restricts matching to a specific format when supplied.
+
+    Examples:
+    ```py title="IsMac"
+    from dirty_equals import IsMac
+
+    assert '00:1A:2B:3C:4D:5E' == IsMac
+    assert '00-1A-2B-3C-4D-5E' == IsMac
+    assert '001A.2B3C.4D5E' == IsMac
+    assert '001A2B3C4D5E' == IsMac
+    assert '00:1a:2b:3c:4d:5e' == IsMac  # case-insensitive
+
+    assert '00:1A:2B:3C:4D:5E' == IsMac('colon')
+    assert '00-1A-2B-3C-4D-5E' != IsMac('colon')
+    assert '001A.2B3C.4D5E' == IsMac('dot')
+    assert '001A2B3C4D5E' == IsMac('compact')
+    ```
+    """
+
+    def __init__(self, format: Literal['colon', 'hyphen', 'dot', 'compact', None] = None):
+        """
+        Args:
+            format: The expected format of the MAC address. If omitted, all formats are accepted.
+                One of: 'colon', 'hyphen', 'dot', 'compact'.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert '00:1A:2B:3C:4D:5E' == IsMac
+        assert '00:1A:2B:3C:4D:5E' == IsMac('colon')
+        assert '00-1A-2B-3C-4D-5E' == IsMac('hyphen')
+        assert '001A.2B3C.4D5E' == IsMac('dot')
+        assert '001A2B3C4D5E' == IsMac('compact')
+        ```
+        """
+        self.format = format
+        super().__init__(plain_repr('*') if format is None else format)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check for leading/trailing whitespace
+        if other != other.strip():
+            return False
+
+        if self.format is None:
+            # Accept any valid format
+            return (
+                self._is_valid_colon(other)
+                or self._is_valid_hyphen(other)
+                or self._is_valid_dot(other)
+                or self._is_valid_compact(other)
+            )
+        elif self.format == 'colon':
+            return self._is_valid_colon(other)
+        elif self.format == 'hyphen':
+            return self._is_valid_hyphen(other)
+        elif self.format == 'dot':
+            return self._is_valid_dot(other)
+        elif self.format == 'compact':
+            return self._is_valid_compact(other)
+        else:
+            return False
+
+    @staticmethod
+    def _is_valid_colon(mac: str) -> bool:
+        """Check if mac is a valid colon-separated MAC address."""
+        parts = mac.split(':')
+        if len(parts) != 6:
+            return False
+        for part in parts:
+            if len(part) != 2:
+                return False
+            try:
+                int(part, 16)
+            except ValueError:
+                return False
+        return True
+
+    @staticmethod
+    def _is_valid_hyphen(mac: str) -> bool:
+        """Check if mac is a valid hyphen-separated MAC address."""
+        parts = mac.split('-')
+        if len(parts) != 6:
+            return False
+        for part in parts:
+            if len(part) != 2:
+                return False
+            try:
+                int(part, 16)
+            except ValueError:
+                return False
+        return True
+
+    @staticmethod
+    def _is_valid_dot(mac: str) -> bool:
+        """Check if mac is a valid three-group dotted (Cisco-style) MAC address."""
+        parts = mac.split('.')
+        if len(parts) != 3:
+            return False
+        for part in parts:
+            if len(part) != 4:
+                return False
+            try:
+                int(part, 16)
+            except ValueError:
+                return False
+        return True
+
+    @staticmethod
+    def _is_valid_compact(mac: str) -> bool:
+        """Check if mac is a valid compact (no separator) MAC address."""
+        if len(mac) != 12:
+            return False
+        try:
+            int(mac, 16)
+        except ValueError:
+            return False
+        return True
