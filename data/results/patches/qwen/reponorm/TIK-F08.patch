+    def _compute_patterns(self, tokens: list[int]) -> dict[tuple[int, int], int]:
+        """Compute occurrence counts for adjacent token-ID pairs.
+
+        Returns a dictionary mapping up to three distinct adjacent token-ID pairs
+        to their occurrence counts. Counts overlapping pairs (e.g., three consecutive
+        copies of token A contribute two occurrences of (A,A)).
+
+        If fewer than three distinct pairs exist, returns all of them.
+        At the top-three boundary, any selection among equal-frequency pairs is valid.
+        Empty or single-token sequences have no pairs (empty dict).
+        """
+        if len(tokens) < 2:
+            return {}
+
+        # Count all adjacent pairs
+        pair_counts: dict[tuple[int, int], int] = {}
+        for i in range(len(tokens) - 1):
+            pair = (tokens[i], tokens[i + 1])
+            pair_counts[pair] = pair_counts.get(pair, 0) + 1
+
+        # Sort by count descending, then take top 3
+        sorted_pairs = sorted(pair_counts.items(), key=lambda x: -x[1])
+        top_three = sorted_pairs[:3]
+
+        return dict(top_three)
+
