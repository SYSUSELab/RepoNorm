+# Scalar coercion test fixtures
+def dummy_float_function(x: float) -> str:
+    """A dummy function for testing float parameters."""
+    return f"{x}"
+
+
+def dummy_large_int_function(x: int) -> str:
+    """A dummy function for testing large integer parameters."""
+    return f"{x}"
+
+
+def dummy_with_kwargs(x: int, **kwargs) -> str:
+    """A dummy function for testing kwargs."""
+    return f"{x}"
+
+
+def dummy_bool_function(flag: bool) -> str:
+    """A dummy function for testing boolean parameters."""
+    return f"{flag}"
+
+
+# Scalar coercion tests
+def test_coerce_boolean_true():
+    """Test case-insensitive boolean true coercion."""
+    tool = Tool(dummy_bool_function)
+    
+    # Test various forms of true - _validate_and_parse_args returns dict
+    assert tool._validate_and_parse_args(flag="true") == {"flag": True}
+    assert tool._validate_and_parse_args(flag="True") == {"flag": True}
+    assert tool._validate_and_parse_args(flag="TRUE") == {"flag": True}
+    assert tool._validate_and_parse_args(flag=" true ") == {"flag": True}
+
+
+def test_coerce_boolean_false():
+    """Test case-insensitive boolean false coercion."""
+    tool = Tool(dummy_bool_function)
+    
+    assert tool._validate_and_parse_args(flag="false") == {"flag": False}
+    assert tool._validate_and_parse_args(flag="False") == {"flag": False}
+    assert tool._validate_and_parse_args(flag="FALSE") == {"flag": False}
+    assert tool._validate_and_parse_args(flag=" false ") == {"flag": False}
+
