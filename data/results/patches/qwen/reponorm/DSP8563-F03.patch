+                    return bytes_val
+                except Exception:
+                    pass
+        
+        # Return original value for unknown format
+        return value
+    
+    # String type - leave unchanged
+    if type_str == "string":
+        return value
+    
+    # Other types - leave unchanged
+    return value
+
 
