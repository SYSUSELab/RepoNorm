+def _coerce_scalar(value: Any, schema: dict[str, Any]) -> Any:
+    """Coerce scalar string values according to JSON schema type.
+    
+    For boolean fields, accept case-insensitive "true" and "false".
+    For integer and number fields, accept finite decimal numeric strings,
+    with optional sign, decimal point and exponent.
+    Numeric fields also accept nonnegative decimal durations with suffix ms, s, m or h
+    and sizes with suffix KB, MB or GB. Units are case-sensitive; allow whitespace
+    between magnitude and suffix.
+    
+    Args:
+        value: The value to coerce
+        schema: The JSON schema for the field
+        
+    Returns:
+        The coerced value, or the original value if coercion fails
+    """
+    # Only coerce strings
+    if not isinstance(value, str):
+        return value
+    
+    # Trim surrounding whitespace
+    trimmed = value.strip()
+    
+    # Get the expected type from schema
+    type_str = schema.get("type")
+    
+    # If no type specified in schema, don't coerce
+    if type_str is None:
+        return value
+    
+    # Boolean coercion
+    if type_str == "boolean":
+        lower = trimmed.lower()
+        if lower == "true":
+            return True
+        elif lower == "false":
+            return False
+        # If it's not a valid boolean string, return original for error handling
+        return value
+    
+    # Integer/Number coercion
+    if type_str in ("integer", "number"):
+        # Try numeric string first
+        if _NUMERIC_PATTERN.match(trimmed):
+            try:
+                # Use Decimal for precise conversion
+                num = Decimal(trimmed)
+                
+                # Check for NaN/Inf
+                if not num.is_finite():
+                    return value
+                
+                if type_str == "integer":
+                    # For integers, check if the value is integral
+                    if num != int(num):
+                        # Non-integral value for integer schema - return original
+                        return value
+                    # Convert to int using Decimal for precision
+                    return int(num)
+                else:
+                    # Number type - convert to float
+                    return float(num)
+            except Exception:
+                return value
+        
+        # Try duration pattern (only for number type, not integer)
+        if type_str == "number":
+            match = re.match(r'^([+-]?\d+(?:\.\d+)?)\s*(ms|s|m|h)$', trimmed, re.IGNORECASE)
+            if match:
+                try:
+                    magnitude = Decimal(match.group(1))
+                    suffix = match.group(2).lower()
+                    
+                    if not magnitude.is_finite():
+                        return value
+                    
+                    # Convert to seconds
+                    seconds = float(magnitude) * _DURATION_SUFFIXES[suffix]
+                    return float(seconds)
+                except Exception:
+                    pass
+        
+        # Try size pattern (only for number type, not integer)
+        if type_str == "number":
+            match = re.match(r'^(\d+)\s*(KB|MB|GB)$', trimmed, re.IGNORECASE)
