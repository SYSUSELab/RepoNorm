+    def _check_param_conflicts(self, ctx: Context) -> None:
+        """Check for conflicting options that were both explicitly provided."""
+        params = ctx.command.get_params(ctx)
+        
+        # Build a mapping of parameter names to their option strings
+        name_to_opts: dict[str, list[str]] = {}
+        for param in params:
+            if param.name is not None:
+                name_to_opts[param.name] = param.opts
+        
+        # Check each parameter with conflicts_with
+        for param in params:
+            if param.conflicts_with is None:
+                continue
+            
+            # Get the source of this parameter's value
+            param_source = ctx.get_parameter_source(param.name)  # type: ignore
+            if param_source not in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):
+                continue
+            
+            # Check each conflicting parameter
+            for conflict_name in param.conflicts_with:
+                if conflict_name not in name_to_opts:
+                    raise UsageError(
+                        f"Option '{param.opts[0]}' has an unknown conflict: '{conflict_name}'."
+                    )
+                
+                conflict_param = next(
+                    p for p in params if p.name == conflict_name
+                )
+                conflict_source = ctx.get_parameter_source(conflict_name)
+                
+                # Only trigger conflict if both are COMMANDLINE or PROMPT
+                if conflict_source in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):
+                    conflict_opts = conflict_param.opts
+                    first_opt = param.opts[0]
+                    second_opt = conflict_opts[0] if conflict_opts else conflict_name
+                    
+                    raise UsageError(
+                        f"Option '{first_opt}' cannot be used together with '{second_opt}'."
+                    )
+
