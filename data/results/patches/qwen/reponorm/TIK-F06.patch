+
+
+# ====================
+# Transformers
+# ====================
+
+def test_transformers_single():
+    """Test single transformer function."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    # Without transformer
+    assert enc.encode("Hello World") == [15496, 2159]
+    # With transformer - should be same as encoding "hello world"
+    assert enc.encode("Hello World", transformers=lowercase) == [31373, 995]
+
+
+def test_transformers_list():
+    """Test list of transformer functions."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    def remove_space(text):
+        return text.replace(" ", "")
+    
+    # Chain: "Hello World" -> "hello world" -> "helloworld"
+    result = enc.encode("Hello World", transformers=[lowercase, remove_space])
+    expected = enc.encode("helloworld")
+    assert result == expected
+
+
+def test_transformers_empty_batch():
+    """Test empty batch with transformers."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def uppercase(text):
+        return text.upper()
+    
+    assert enc.encode_batch([], transformers=uppercase) == []
+
+
+def test_transformers_repeated_documents():
+    """Test that repeated documents invoke callbacks independently."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    call_count = 0
+    
+    def counting_transformer(text):
+        nonlocal call_count
+        call_count += 1
+        return text.upper()
+    
+    # Encode same document multiple times
+    result1 = enc.encode("test", transformers=counting_transformer)
+    result2 = enc.encode("test", transformers=counting_transformer)
+    result3 = enc.encode("test", transformers=counting_transformer)
+    
+    # Each invocation should count separately
+    assert call_count == 3
+    # Results should all be the same (encoding of "TEST")
+    assert result1 == result2 == result3
+
+
+def test_transformers_type_error():
+    """Test that non-string return from transformer raises TypeError."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def bad_transformer(text):
+        return 123  # Not a string
+    
+    with pytest.raises(TypeError, match="Transformer returned int, expected str"):
+        enc.encode("test", transformers=bad_transformer)
+
+
+def test_transformers_exception_propagation():
+    """Test that exceptions in transformers propagate unchanged."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def failing_transformer(text):
+        raise ValueError("Custom error message")
+    
+    with pytest.raises(ValueError, match="Custom error message"):
+        enc.encode("test", transformers=failing_transformer)
+
+
+def test_transformers_none():
+    """Test that None transformers is equivalent to no transformers."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def uppercase(text):
+        return text.upper()
+    
+    # Without transformers
+    result1 = enc.encode("hello fanta")
+    # With None transformers
+    result2 = enc.encode("hello fanta", transformers=None)
+    # With uppercase transformer
+    result3 = enc.encode("hello fanta", transformers=uppercase)
+    
+    assert result1 == result2
+    assert result1 != result3
+
+
+def test_transformers_encode_ordinary():
+    """Test transformers with encode_ordinary."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    # Without transformer - special tokens are ignored
+    result1 = enc.encode_ordinary("hello <|endoftext|>")
+    # With transformer - text is lowercased first
+    result2 = enc.encode_ordinary("HELLO <|ENDOFTXT|>", transformers=lowercase)
+    
+    # The results should differ because different text is encoded
+    assert result1 != result2
+
+
+def test_transformers_encode_ordinary_batch():
+    """Test transformers with encode_ordinary_batch."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    texts = ["Hello World", "Goodbye World"]
+    result = enc.encode_ordinary_batch(texts, transformers=lowercase)
+    expected = [[31373, 995], [11274, 16390, 995]]
+    assert result == expected
+
+
+def test_transformers_encode_batch():
+    """Test transformers with encode_batch."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    texts = ["Hello World", "Goodbye World"]
+    result = enc.encode_batch(texts, transformers=lowercase)
+    expected = [[31373, 995], [11274, 16390, 995]]
+    assert result == expected
+
+
+def test_transformers_order_preserved():
+    """Test that transformers are applied in order."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def add_prefix(text):
+        return "PREFIX_" + text
+    
+    def uppercase(text):
+        return text.upper()
+    
+    # Order matters: prefix first, then uppercase
+    result1 = enc.encode("test", transformers=[add_prefix, uppercase])
+    expected1 = enc.encode("PREFIX_TEST")
+    assert result1 == expected1
+    
+    # Reverse order: uppercase first, then prefix
+    result2 = enc.encode("test", transformers=[uppercase, add_prefix])
+    expected2 = enc.encode("PREFIX_TEST")
+    assert result2 == expected2
+
+
+def test_transformers_encode_with_unstable():
+    """Test transformers with encode_with_unstable."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def uppercase(text):
+        return text.upper()
+    
+    # Test that transformer is applied before encoding
+    stable_tokens, _ = enc.encode_with_unstable(
+        "hello fanta", 
+        transformers=uppercase
+    )
+    # Should be same as encoding "HELLO FANTA" directly
+    expected_stable, _ = enc.encode_with_unstable("HELLO FANTA")
+    assert stable_tokens == expected_stable
+
+
+def test_transformers_encode_to_numpy():
+    """Test transformers with encode_to_numpy."""
+    import numpy as np
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def lowercase(text):
+        return text.lower()
+    
+    result = enc.encode_to_numpy("Hello World", transformers=lowercase)
+    expected = enc.encode_to_numpy("hello world")
+    assert np.array_equal(result, expected)
