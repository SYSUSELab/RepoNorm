+def _apply_transformers(text: str, transformers: None | Callable[[str], str] | Sequence[Callable[[str], str]]) -> str:
+    """Apply a sequence of transformers to text.
+    
+    Args:
+        text: The input text to transform.
+        transformers: A single callable or sequence of callables to apply.
+        
+    Returns:
+        The transformed text.
+        
+    Raises:
+        TypeError: If any transformer returns a non-string value.
+    """
+    if transformers is None:
+        return text
+    
+    # Normalize to a list
+    if callable(transformers):
+        transformers = [transformers]
+    
+    result = text
+    for transformer in transformers:
+        result = transformer(result)
+        if not isinstance(result, str):
+            raise TypeError(
+                f"Transformer returned {type(result).__name__}, expected str"
+            )
+    return result
+
+
