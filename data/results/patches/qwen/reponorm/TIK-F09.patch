+def test_compress():
+    """Test that compress=True collapses adjacent repeated token IDs."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Test basic compression
+    text = "The dog dog dog ran ran quickly"
+    tokens = enc.encode(text)
+    compressed = enc.encode(text, compress=True)
+    
+    # Verify compression reduced length
+    assert len(compressed) < len(tokens), "Compression should reduce length when there are repetitions"
+    
+    # Verify no consecutive duplicates in compressed output
+    for i in range(len(compressed) - 1):
+        assert compressed[i] != compressed[i + 1], f"Found consecutive duplicates {compressed[i]} at position {i}"
+    
+    # Verify non-compressed has consecutive duplicates
+    has_duplicates = any(tokens[i] == tokens[i + 1] for i in range(len(tokens) - 1))
+    assert has_duplicates, "Original encoding should have consecutive duplicates"
+
+
+def test_compress_empty():
+    """Test compress with empty string."""
+    enc = tiktoken.get_encoding("gpt2")
+    assert enc.encode("", compress=True) == []
+
+
+def test_compress_no_repetitions():
+    """Test compress with text that has no repeated adjacent tokens."""
+    enc = tiktoken.get_encoding("gpt2")
+    text = "hello world"
+    normal = enc.encode(text)
+    compressed = enc.encode(text, compress=True)
+    assert normal == compressed
+
+
+def test_compress_encode_ordinary():
+    """Test compress parameter with encode_ordinary."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    text = "dog dog dog"
+    normal = enc.encode_ordinary(text)
+    compressed = enc.encode_ordinary(text, compress=True)
+    
+    # Verify compression reduced length
+    if len(normal) > 1:
+        assert len(compressed) <= len(normal), "Compression should not increase length"
+    
+    # Verify no consecutive duplicates in compressed output
+    for i in range(len(compressed) - 1):
+        assert compressed[i] != compressed[i + 1], f"Found consecutive duplicates {compressed[i]}"
+
+
+def test_compress_batch():
+    """Test compress parameter with batch encoding."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    texts = ["dog dog", "cat cat", "bird bird bird"]
+    results = enc.encode_batch(texts, compress=True)
+    
+    # Verify each result has no consecutive duplicates
+    for result in results:
+        for i in range(len(result) - 1):
+            assert result[i] != result[i + 1], f"Found consecutive duplicates in {result}"
+
+
+def test_compress_encode_to_numpy():
+    """Test compress parameter with encode_to_numpy."""
+    import numpy as np
+    enc = tiktoken.get_encoding("gpt2")
+    
+    text = "dog dog dog"
+    compressed = enc.encode_to_numpy(text, compress=True)
+    
+    # Verify no consecutive duplicates
+    for i in range(len(compressed) - 1):
+        assert compressed[i] != compressed[i + 1], f"Found consecutive duplicates {compressed[i]}"
