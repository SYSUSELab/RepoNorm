+def _compress_tokens(tokens: list[int]) -> list[int]:
+    """Compresses a list of tokens by collapsing adjacent repeated token IDs.
+    
+    This is a lossy transformation that does not preserve the original text.
+    Each consecutive run of the same token ID is represented by one token ID.
+    Repeated IDs separated by another token remain distinct.
+    
+    Example:
+        >>> _compress_tokens([1, 2, 2, 2, 3, 3, 4])
+        [1, 2, 3, 4]
+    """
+    if not tokens:
+        return []
+    compressed = [tokens[0]]
+    for token in tokens[1:]:
+        if token != compressed[-1]:
+            compressed.append(token)
+    return compressed
+
