+
+
+# ====================
+# Token Validation
+# ====================
+
+
+def test_validator_accepts_true():
+    """Validator returning True should accept tokens."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("hello world", validators=[lambda t: True])
+    assert len(result) <= 2
+
+
+def test_validator_accepts_none():
+    """Validator returning None should accept tokens."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("hello world", validators=[lambda t: None])
+    assert len(result) <= 2
+
+
+def test_validator_rejects_false():
+    """Validator returning False should raise ValueError."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError):
+        enc.encode("hello world", validators=[lambda t: False])
+
+
+def test_validator_no_validators():
+    """No validators should return normal encoding."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("hello world", validators=None)
+    assert len(result) <= 2
+
+
+def test_validator_empty_batch():
+    """Empty batch with validators should return empty list."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode_batch([], validators=[lambda t: len(t) < 10])
+    assert result == []
+
+
+def test_validator_batch_all_pass():
+    """Batch with all passing validators should return all results."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode_batch(
+        ["hello world", "goodbye world"],
+        validators=[lambda t: len(t) < 10]
+    )
+    assert result == [[31373, 995], [11274, 16390, 995]]
+
+
+def test_validator_batch_one_fails():
+    """Batch with one failing validator should raise ValueError (no partial results)."""
+    enc = tiktoken.get_encoding("gpt2")
+    with pytest.raises(ValueError):
+        enc.encode_batch(["hello world", "a"], validators=[lambda t: len(t) > 1])
+
+
+def test_validator_mutation_isolation():
+    """Validator mutations should not affect returned tokens or other validators."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def mutating_validator(tokens):
+        tokens.append(999)
+        return True
+    
+    result = enc.encode("hello world", validators=[mutating_validator])
+    assert len(result) <= 2  # Should not contain 999
+
+
+def test_validator_multiple_in_order():
+    """Multiple validators should execute in order and all must pass."""
+    enc = tiktoken.get_encoding("gpt2")
+    result = enc.encode("hello world", validators=[
+        lambda t: len(t) < 10,
+        lambda t: 31373 in t
+    ])
+    assert len(result) <= 2
+
+
+def test_validator_early_termination():
+    """Later validators should not be called if an earlier one fails."""
+    call_order = []
+    
+    def first_validator(tokens):
+        call_order.append('first')
+        return False
+    
+    def second_validator(tokens):
+        call_order.append('second')
+        return True
+    
+    enc = tiktoken.get_encoding("gpt2")
+    try:
+        enc.encode("hello world", validators=[first_validator, second_validator])
+    except ValueError:
+        pass
+    
+    assert call_order == ['first']  # Second validator should not be called
+
+
+def test_validator_exception_propagates():
+    """Exceptions from validators should propagate unchanged."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    def raising_validator(tokens):
+        raise RuntimeError("Custom error")
+    
+    with pytest.raises(RuntimeError, match="Custom error"):
+        enc.encode("hello world", validators=[raising_validator])
+
+
+def test_validator_length_constraint():
+    """Validator can enforce length constraints."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Short text passes (2 tokens)
+    result = enc.encode("hello world", validators=[lambda t: len(t) <= 2])
+    assert result == [31373, 995]
+    
+    # Long text fails (3 tokens)
+    with pytest.raises(ValueError):
+        enc.encode("goodbye world", validators=[lambda t: len(t) <= 2])
+
+
+def test_validator_token_id_constraint():
+    """Validator can check for specific token IDs."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Text containing expected token passes
+    result = enc.encode("hello world", validators=[lambda t: 31373 in t])
+    assert result == [31373, 995]
+    
+    # Text without expected token fails
+    with pytest.raises(ValueError):
+        enc.encode("goodbye world", validators=[lambda t: 31373 in t])
+
+
+def test_validator_encode_to_numpy():
+    """Validators work with encode_to_numpy."""
+    enc = tiktoken.get_encoding("gpt2")
+    
+    # Passes validation
+    result = enc.encode_to_numpy("hello world", validators=[lambda t: len(t) < 10])
+    assert isinstance(result, np.ndarray)
+    assert list(result) == [31373, 995]
+    
+    # Fails validation
+    with pytest.raises(ValueError):
+        enc.encode_to_numpy("hello world", validators=[lambda t: len(t) < 2])
