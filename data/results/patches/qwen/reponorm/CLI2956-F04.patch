+
+
+# Tests for required_if functionality
+
+import click
+from click.testing import CliRunner
+
+
+def test_required_if_mapping_basic():
+    """Test that required_if with a mapping works correctly."""
+    @click.command()
+    @click.option("--auth-mode", default=None)
+    @click.option("--api-key", required_if={"auth_mode": "api"})
+    def cmd(auth_mode, api_key):
+        click.echo(f"auth_mode={auth_mode}, api_key={api_key}")
+
+    runner = CliRunner()
+    
+    # When auth_mode is not "api", api_key should be optional
+    result = runner.invoke(cmd, ["--auth-mode", "basic"])
+    assert result.exit_code == 0
+    assert "auth_mode=basic, api_key=None" in result.output
+    
+    # When auth_mode is "api", api_key should be required
+    result = runner.invoke(cmd, ["--auth-mode", "api"])
+    assert result.exit_code != 0
+    assert "Missing option" in result.output or "--api-key" in result.output
+    
+    # When both are provided, it should work
+    result = runner.invoke(cmd, ["--auth-mode", "api", "--api-key", "secret123"])
+    assert result.exit_code == 0
+    assert "auth_mode=api, api_key=secret123" in result.output
+
+
+def test_required_if_callable_predicate():
+    """Test that required_if with a callable predicate works correctly."""
+    @click.command()
+    @click.option("--count", type=int, default=0)
+    @click.option("--verbose", is_flag=True, default=None, required_if=lambda ctx, param: ctx.params.get("count", 0) > 5)
+    def cmd(count, verbose):
+        click.echo(f"count={count}, verbose={verbose}")
+
+    runner = CliRunner()
+    
+    # When count <= 5, verbose should be optional
+    result = runner.invoke(cmd, ["--count", "3"])
+    assert result.exit_code == 0
+    assert "count=3, verbose=None" in result.output
+    
+    # When count > 5, verbose should be required
+    result = runner.invoke(cmd, ["--count", "10"])
+    assert result.exit_code != 0
+    assert "Missing option" in result.output or "--verbose" in result.output
+    
+    # When count > 5 and verbose is provided, it should work
+    result = runner.invoke(cmd, ["--count", "10", "--verbose"])
+    assert result.exit_code == 0
+    assert "count=10, verbose=True" in result.output
+
+
+def test_required_if_invalid_type():
+    """Test that required_if raises TypeError for invalid types."""
+    try:
+        @click.command()
+        @click.option("--test", required_if="invalid")
+        def cmd(test):
+            pass
+        assert False, "Should have raised TypeError"
+    except TypeError as e:
+        assert "required_if must be a mapping, callable, or None" in str(e)
+
+
+def test_required_if_empty_mapping():
+    """Test that an empty mapping does not require anything."""
+    @click.command()
+    @click.option("--optional", required_if={})
+    def cmd(optional):
+        click.echo(f"optional={optional}")
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 0
+    assert "optional=None" in result.output
+
+
+def test_required_if_none():
+    """Test that None disables required_if."""
+    @click.command()
+    @click.option("--optional", required_if=None)
+    def cmd(optional):
+        click.echo(f"optional={optional}")
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 0
+    assert "optional=None" in result.output
+
+
+def test_required_if_non_string_key():
+    """Test that non-string keys raise TypeError."""
+    try:
+        @click.command()
+        @click.option("--test", required_if={123: "value"})
+        def cmd(test):
+            pass
+        assert False, "Should have raised TypeError"
+    except TypeError as e:
+        assert "required_if keys must be strings" in str(e)
+
+
+def test_required_if_with_default_value():
+    """Test that required_if respects existing default values."""
+    @click.command()
+    @click.option("--mode", default="internal")
+    @click.option("--external-key", required_if={"mode": "external"})
+    def cmd(mode, external_key):
+        click.echo(f"mode={mode}, external_key={external_key}")
+
+    runner = CliRunner()
+    
+    # With default mode="internal", external_key should not be required
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 0
+    assert "mode=internal, external_key=None" in result.output
+    
+    # With explicit mode="external", external_key should be required
+    result = runner.invoke(cmd, ["--mode", "external"])
+    assert result.exit_code != 0
+    assert "Missing option" in result.output or "--external-key" in result.output
+
+
+def test_required_if_with_envvar():
+    """Test that required_if works with environment variables."""
+    @click.command()
+    @click.option("--mode", envvar="APP_MODE")
+    @click.option("--key", required_if={"mode": "prod"})
+    def cmd(mode, key):
+        click.echo(f"mode={mode}, key={key}")
+
+    runner = CliRunner()
+    
+    # Without env var, key should not be required
+    result = runner.invoke(cmd, [], env={"APP_MODE": ""})
+    assert result.exit_code == 0
+    
+    # With env var set to prod, key should be required
+    result = runner.invoke(cmd, [], env={"APP_MODE": "prod"})
+    assert result.exit_code != 0
+    assert "Missing option" in result.output or "--key" in result.output
+
+
+def test_required_if_multiple_conditions():
+    """Test that all conditions in the mapping must match."""
+    @click.command()
+    @click.option("--mode", default="dev")
+    @click.option("--env", default="local")
+    @click.option("--key", required_if={"mode": "prod", "env": "cloud"})
+    def cmd(mode, env, key):
+        click.echo(f"mode={mode}, env={env}, key={key}")
+
+    runner = CliRunner()
+    
+    # Only mode=prod, key should not be required
+    result = runner.invoke(cmd, ["--mode", "prod"])
+    assert result.exit_code == 0
+    
+    # Only env=cloud, key should not be required
+    result = runner.invoke(cmd, ["--env", "cloud"])
+    assert result.exit_code == 0
+    
+    # Both mode=prod and env=cloud, key should be required
+    result = runner.invoke(cmd, ["--mode", "prod", "--env", "cloud"])
+    assert result.exit_code != 0
+    assert "Missing option" in result.output or "--key" in result.output
+    
+    # All conditions met and key provided, should work
+    result = runner.invoke(cmd, ["--mode", "prod", "--env", "cloud", "--key", "secret"])
+    assert result.exit_code == 0
+    assert "mode=prod, env=cloud, key=secret" in result.output
