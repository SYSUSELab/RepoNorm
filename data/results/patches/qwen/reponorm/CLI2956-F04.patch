+    def _check_required_if_condition(self, ctx: Context) -> bool:
+        """Check if required_if condition is met.
+
+        Returns True if the target option should be required based on
+        the current context and parameter values.
+        """
+        if self._required_if is None:
+            return False
+        # Empty mapping means no condition, so not required
+        if isinstance(self._required_if, dict) and len(self._required_if) == 0:
+            return False
+
+        # Check if it's a callable predicate
