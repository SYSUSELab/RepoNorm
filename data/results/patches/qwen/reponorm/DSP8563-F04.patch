+def _canonicalize_args(args):
+    """Recursively canonicalize arguments for fingerprinting.
+    
+    - Sort dictionary keys
+    - Treat tuples as lists
+    - Trim surrounding whitespace from string values
+    - Preserve numeric/boolean types and list order
+    """
+    if isinstance(args, dict):
+        return {k: _canonicalize_args(v) for k, v in sorted(args.items())}
+    elif isinstance(args, tuple):
+        return [_canonicalize_args(item) for item in args]
+    elif isinstance(args, str):
+        return args.strip()
+    else:
+        # Preserve other types (numbers, booleans, None, lists)
+        return args
+
+
+def _validate_args(args):
+    """Validate that args contains only JSON-serializable values.
+    
+    Rejects nonfinite numbers and non-JSON values with ValueError.
+    """
+    if isinstance(args, dict):
+        for k, v in args.items():
+            if not isinstance(k, str):
+                raise ValueError(f"Dictionary key must be a string, got {type(k)}")
+            _validate_args(v)
+    elif isinstance(args, (list, tuple)):
+        for item in args:
+            _validate_args(item)
+    elif isinstance(args, float):
+        if not (args == args and abs(args) != float('inf')):  # Check for NaN and inf
+            raise ValueError("Nonfinite numbers are not allowed")
+    elif isinstance(args, bool):
+        pass  # Booleans are valid
+    elif isinstance(args, int):
+        pass  # Integers are valid
+    elif isinstance(args, str):
+        pass  # Strings are valid
+    elif args is None:
+        pass  # None is valid
+    else:
+        raise ValueError(f"Non-JSON value type: {type(args)}")
+
