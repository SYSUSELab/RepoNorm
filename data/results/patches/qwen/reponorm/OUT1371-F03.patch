+def _get_active_condition(conditional_filters: Optional[Dict[str, Dict[str, Callable]]]) -> Optional[str]:
+    """Determine which condition is active based on environment variables.
+    
+    Returns the name of the active condition or None if no standard conditions match.
+    """
+    if not conditional_filters:
+        return None
+    
+    # Check for debug condition first (highest priority)
+    if os.environ.get("OUTLINES_DEBUG", "").lower() == "true":
+        if "debug" in conditional_filters:
+            return "debug"
+    
+    # Check for production condition
+    if os.environ.get("ENVIRONMENT", "").lower() == "production":
+        if "production" in conditional_filters:
+            return "production"
+    
+    # Check for testing condition
+    env_testing = os.environ.get("ENV", "").lower() == "testing"
+    outlines_testing = os.environ.get("OUTLINES_TESTING", "").lower() == "true"
+    testing_mode = os.environ.get("TESTING_MODE", "").lower() == "on"
+    
+    if env_testing or outlines_testing or testing_mode:
+        if "testing" in conditional_filters:
+            return "testing"
+    
+    # If no standard condition matched, select alphabetically first key
+    sorted_keys = sorted(conditional_filters.keys())
+    if sorted_keys:
+        return sorted_keys[0]
+    
+    return None
+
