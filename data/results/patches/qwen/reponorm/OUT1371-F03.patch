+def test_conditional_filters_from_file():
+    """Test conditional filters with Prompt.from_file."""
+    import tempfile
+    
+    def custom_filter(value):
+        return f"[CUSTOM]{value}"
+    
+    conditional_filters = {
+        "debug": {"custom": custom_filter},
+    }
+    
+    with tempfile.TemporaryDirectory() as tmpdir:
+        template_path = os.path.join(tmpdir, "template.txt")
+        with open(template_path, "w") as f:
+            f.write("{{ value|custom }}")
+        
+        prompt = Prompt.from_file(Path(template_path), conditional_filters)
+        assert prompt(value="test") == "[CUSTOM]test"
