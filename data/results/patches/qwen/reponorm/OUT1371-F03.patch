+def test_conditional_filters_basic():
+    """Test basic conditional filters functionality."""
+    
+    def debug_filter(value):
+        return f"[DEBUG]{value}"
+    
+    def production_filter(value):
+        return f"[PROD]{value}"
+    
+    def testing_filter(value):
+        return f"[TEST]{value}"
+    
+    conditional_filters = {
+        "debug": {"custom": debug_filter},
+        "production": {"custom": production_filter},
+        "testing": {"custom": testing_filter},
+    }
+    
+    # Test with no condition active - should use alphabetically first key
+    content = "{{ value|custom }}"
+    prompt = Prompt.from_str(content, conditional_filters)
+    assert prompt(value="test") == "[DEBUG]test"  # debug is alphabetically first
+    
+    # Test with debug condition active
+    with patch.dict(os.environ, {"OUTLINES_DEBUG": "true"}, clear=True):
+        prompt = Prompt.from_str(content, conditional_filters)
+        assert prompt(value="test") == "[DEBUG]test"
+    
+    # Test with production condition active
+    with patch.dict(os.environ, {"ENVIRONMENT": "production"}, clear=True):
+        prompt = Prompt.from_str(content, conditional_filters)
+        assert prompt(value="test") == "[PROD]test"
+    
+    # Test with testing condition active
+    with patch.dict(os.environ, {"ENV": "testing"}, clear=True):
+        prompt = Prompt.from_str(content, conditional_filters)
+        assert prompt(value="test") == "[TEST]test"
+
+
+def test_conditional_filters_priority():
+    """Test that priority order is respected: debug > production > testing."""
+    
+    def debug_filter(value):
+        return f"[DEBUG]{value}"
+    
+    def production_filter(value):
+        return f"[PROD]{value}"
+    
+    def testing_filter(value):
+        return f"[TEST]{value}"
+    
+    conditional_filters = {
+        "debug": {"custom": debug_filter},
+        "production": {"custom": production_filter},
+        "testing": {"custom": testing_filter},
+    }
+    
+    content = "{{ value|custom }}"
+    
+    # Debug takes priority over production
+    with patch.dict(os.environ, {"OUTLINES_DEBUG": "true", "ENVIRONMENT": "production"}, clear=True):
+        prompt = Prompt.from_str(content, conditional_filters)
+        assert prompt(value="test") == "[DEBUG]test"
+    
+    # Debug takes priority over testing
+    with patch.dict(os.environ, {"OUTLINES_DEBUG": "true", "ENV": "testing"}, clear=True):
+        prompt = Prompt.from_str(content, conditional_filters)
+        assert prompt(value="test") == "[DEBUG]test"
+    
+    # Production takes priority over testing (when debug not active)
+    with patch.dict(os.environ, {"ENVIRONMENT": "production", "ENV": "testing"}, clear=True):
+        prompt = Prompt.from_str(content, conditional_filters)
+        assert prompt(value="test") == "[PROD]test"
+
