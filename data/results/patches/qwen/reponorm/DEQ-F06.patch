+
+# Credit card issuer types
+Issuer = Literal['Visa', 'Mastercard', 'AmericanExpress']
+
+
+def _luhn_check(digits: str) -> bool:
+    """
+    Validate a card number using the Luhn algorithm.
+    
+    Args:
+        digits: String of digits only (ASCII 0-9).
+        
+    Returns:
+        True if the digits pass the Luhn checksum, False otherwise.
+    """
+    total = 0
+    reverse_digits = digits[::-1]
+    
+    for i, char in enumerate(reverse_digits):
+        digit = int(char)
+        if i % 2 == 1:
+            digit *= 2
+            if digit > 9:
+                digit -= 9
+        total += digit
+    
+    return total % 10 == 0
+
+
+def _extract_digits(value: Any) -> str | None:
+    """
+    Extract digits from a card number string or integer.
+    
+    Accepts strings/ints containing ASCII digits, spaces, hyphens, and whitespace.
+    Returns None for invalid input types or non-ASCII-digit characters.
+    
+    Args:
+        value: Card number as string or integer.
+        
+    Returns:
+        String of extracted digits, or None if invalid.
+    """
+    if isinstance(value, int):
+        s = str(value)
+    elif isinstance(value, str):
+        s = value
+    else:
+        return None
+    
+    # Remove allowed separators (spaces, hyphens) and surrounding whitespace
+    cleaned = s.strip().replace(' ', '').replace('-', '')
+    
+    # Check that all remaining characters are ASCII digits 0-9
+    for char in cleaned:
+        if char < '0' or char > '9':
+            return None
+    
+    return cleaned
+
+
+def _is_valid_length_for_issuer(digits: str, issuer: Issuer) -> bool:
+    """
+    Check if the digit count matches the expected length for an issuer.
+    
+    Args:
+        digits: String of digits.
+        issuer: The issuer name.
+        
+    Returns:
+        True if the length is valid for the issuer.
+    """
+    length = len(digits)
+    if issuer == 'Visa':
+        return length in (13, 16, 19)
+    elif issuer == 'Mastercard':
+        return length == 16
+    elif issuer == 'AmericanExpress':
+        return length == 15
+    return False
+
+
+def _is_valid_prefix_for_issuer(digits: str, issuer: Issuer) -> bool:
+    """
+    Check if the card number prefix matches the expected pattern for an issuer.
+    
+    Args:
+        digits: String of digits.
+        issuer: The issuer name.
+        
+    Returns:
+        True if the prefix is valid for the issuer.
+    """
+    if len(digits) == 0:
+        return False
+        
+    if issuer == 'Visa':
+        # Visa starts with 4
+        return digits[0] == '4'
+    
+    elif issuer == 'Mastercard':
+        # Mastercard: 16 digits starting with 51-55 or 2221-2720
+        if len(digits) != 16:
+            return False
+        first_two = int(digits[:2])
+        first_four = int(digits[:4])
+        return (51 <= first_two <= 55) or (2221 <= first_four <= 2720)
+    
+    elif issuer == 'AmericanExpress':
+        # Amex: 15 digits starting with 34 or 37
+        if len(digits) != 15:
+            return False
+        first_two = int(digits[:2])
+        return first_two in (34, 37)
+    
+    return False
+
+
+class IsCreditCard(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid credit card number.
+    
+    Validates card numbers using the Luhn algorithm and optionally restricts
+    them to a named issuer (Visa, Mastercard, or American Express).
+    
+    Card numbers can be provided as strings or integers. Strings may contain
+    spaces, hyphens, and surrounding whitespace; other characters cause
+    comparison to fail.
+    
+    Without an issuer specified, any 12-19 digit number that passes the Luhn
+    check is accepted. Digits must be ASCII '0' through '9'.
+    
+    ```py title="IsCreditCard"
+    from dirty_equals import IsCreditCard
+
+    # Basic Luhn validation
+    assert '4111111111111111' == IsCreditCard
+    assert '4111 1111 1111 1111' == IsCreditCard
+    assert '4111-1111-1111-1111' == IsCreditCard
+    assert 4111111111111111 == IsCreditCard
+
+    # With issuer restriction
+    assert '4111111111111111' == IsCreditCard('Visa')
+    assert '5500000000000004' == IsCreditCard('Mastercard')
+    assert '378282246310005' == IsCreditCard('AmericanExpress')
+
+    # Invalid Luhn checksum
+    assert '4111111111111112' != IsCreditCard
+
+    # Wrong issuer
+    assert '4111111111111111' != IsCreditCard('Mastercard')
+    ```
+    """
+
+    def __init__(self, issuer: Issuer | None = None):
+        """
+        Args:
+            issuer: Optional issuer to validate against. Must be one of
+                'Visa', 'Mastercard', or 'AmericanExpress'. If omitted,
+                any valid credit card number is accepted.
+        """
+        self.issuer = issuer
+        super().__init__(issuer or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        # Extract digits from the input
+        digits = _extract_digits(other)
+        if digits is None:
+            return False
+        
+        # Check length range (12-19 digits)
+        if not (12 <= len(digits) <= 19):
+            return False
+        
+        # Check Luhn algorithm
+        if not _luhn_check(digits):
+            return False
+        
+        # Check issuer-specific rules if specified
+        if self.issuer is not None:
+            if not _is_valid_length_for_issuer(digits, self.issuer):
+                return False
+            if not _is_valid_prefix_for_issuer(digits, self.issuer):
+                return False
+        
+        return True
