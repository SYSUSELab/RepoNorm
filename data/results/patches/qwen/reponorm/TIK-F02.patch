+    #[pyo3(name = "encode_with_offsets")]
+    fn py_encode_with_offsets(
+        &self,
+        py: Python,
+        text: &str,
+        allowed_special: HashSet<PyBackedStr>,
+    ) -> PyResult<(Vec<Rank>, Vec<usize>)> {
+        py.allow_threads(|| {
+            let allowed_special: HashSet<&str> =
+                allowed_special.iter().map(|s| s.as_ref()).collect();
+            let (tokens, _last_piece_token_len, positions) = self.encode_with_offsets(text, &allowed_special);
+            
+            // Convert byte offsets to character offsets
+            let char_positions: Vec<usize> = positions
+                .iter()
+                .map(|&byte_pos| {
+                    // Count Unicode code points up to this byte position
+                    text[..byte_pos].chars().count()
+                })
+                .collect();
+            
+            Ok((tokens, char_positions))
+        })
+    }
