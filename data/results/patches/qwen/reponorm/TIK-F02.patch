diff --git a/tests/test_encoding.py b/tests/test_encoding.py
index f33cf85..78a8632 100644
--- a/tests/test_encoding.py
+++ b/tests/test_encoding.py
@@ -254,3 +254,129 @@ def test_hyp_batch_roundtrip(make_enc: Callable[[], tiktoken.Encoding], batch):
     assert encoded == [enc.encode(t) for t in batch]
     decoded = enc.decode_batch(encoded)
     assert decoded == batch
+
+
+# Tests for return_positions parameter
+def test_encode_return_positions_basic():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test basic encoding with return_positions=True
+    tokens, positions = enc.encode("hello world", return_positions=True)
+    assert tokens == [15339, 1917]
+    assert positions == [0, 5]
+    
+    # Verify that token IDs match ordinary encoding
+    assert enc.encode("hello world") == tokens
+
+
+def test_encode_return_positions_empty():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Empty input yields ([], [])
+    tokens, positions = enc.encode("", return_positions=True)
+    assert tokens == []
+    assert positions == []
+
+
+def test_encode_return_positions_unicode():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test Unicode characters (non-ASCII)
+    tokens, positions = enc.encode("héllo wörld", return_positions=True)
+    # Verify positions are character indices, not byte indices
+    assert positions[0] == 0  # 'h' is at char index 0
+    
+    # Verify token IDs match ordinary encoding
+    assert enc.encode("héllo wörld") == tokens
+
+
+def test_encode_return_positions_emoji():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test emoji
+    tokens, positions = enc.encode("hello 👋 world", return_positions=True)
+    # Verify positions are character indices
+    assert positions[0] == 0  # 'h' is at char index 0
+    assert positions[1] == 5  # space after 'hello' is at char index 5
+    
+    # Verify token IDs match ordinary encoding
+    assert enc.encode("hello 👋 world") == tokens
+
+
+def test_encode_return_positions_special_tokens():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test special tokens
+    tokens, positions = enc.encode(
+        "<|startoftext|> hello <|endoftext|>",
+        return_positions=True,
+        allowed_special={"<|startoftext|>", "<|endoftext|>"}
+    )
+    # Special tokens start at their literal text's starting character
+    assert positions[0] == 0  # '<|startoftext|>' starts at char index 0
+    assert positions[-1] == 22  # '<|endoftext|>' starts at char index 24
+    
+    # Verify token IDs match ordinary encoding
+    assert enc.encode("<|startoftext|> hello <|endoftext|>", allowed_special="all") == tokens
+
+
+def test_encode_batch_return_positions_basic():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test batch encoding with return_positions=True
+    result = enc.encode_batch(["hello", "world"], return_positions=True)
+    assert result == [([15339], [0]), ([14957], [0])]
+    
+    # Verify that token IDs match ordinary encoding
+    assert enc.encode_batch(["hello", "world"]) == [[15339], [14957]]
+
+
+def test_encode_batch_return_positions_empty():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test batch encoding with empty strings
+    result = enc.encode_batch(["hello", "", "world"], return_positions=True)
+    assert result == [([15339], [0]), ([], []), ([14957], [0])]
+
+
+def test_encode_batch_return_positions_unicode():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Test batch encoding with Unicode
+    result = enc.encode_batch(["héllo", "wörld"], return_positions=True)
+    # Verify positions are character indices
+    assert result[0][1][0] == 0  # 'h' is at char index 0
+    assert result[1][1][0] == 0  # 'w' is at char index 0
+    
+    # Verify token IDs match ordinary encoding
+    assert enc.encode_batch(["héllo", "wörld"]) == [result[0][0], result[1][0]]
+
+
+def test_encode_return_positions_default_false():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Default return type should be unchanged (list[int])
+    result = enc.encode("hello world")
+    assert isinstance(result, list)
+    assert result == [15339, 1917]
+    
+    # Explicit return_positions=False should also return list[int]
+    result = enc.encode("hello world", return_positions=False)
+    assert isinstance(result, list)
+    assert result == [15339, 1917]
+
+
+def test_encode_batch_return_positions_default_false():
+    enc = tiktoken.get_encoding("cl100k_base")
+    
+    # Default return type should be unchanged (list[list[int]])
+    result = enc.encode_batch(["hello", "world"])
+    assert isinstance(result, list)
+    assert all(isinstance(item, list) for item in result)
+    assert result == [[15339], [14957]]
+    
+    # Explicit return_positions=False should also return list[list[int]]
+    result = enc.encode_batch(["hello", "world"], return_positions=False)
+    assert isinstance(result, list)
+    assert all(isinstance(item, list) for item in result)
+    assert result == [[15339], [14957]]
