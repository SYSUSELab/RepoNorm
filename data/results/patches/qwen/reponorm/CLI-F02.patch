+def test_on_exit_chained_subcommands(runner):
+    """Test on_exit works with chained subcommands."""
+    events = []
+
+    @click.group()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: events.append(f"cli_{c.command.name}")
+
+    @cli.group()
+    @click.pass_context
+    def group(ctx):
+        ctx.on_exit = lambda c: events.append(f"group_{c.command.name}")
+
+    @group.command()
+    @click.pass_context
+    def cmd(ctx):
+        ctx.on_exit = lambda c: events.append(f"cmd_{c.command.name}")
+
+    result = runner.invoke(cli, ["group", "cmd"], standalone_mode=False)
+    assert not result.exception
+    # All levels should have their callbacks invoked
+    assert "cli_cli" in events
+    assert "group_group" in events
+    assert "cmd_cmd" in events
+
+
+def test_on_exit_ignore_regular_exception(runner):
+    """Test that ordinary Exception from callback is ignored."""
+    events = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: (_ for _ in ()).throw(ValueError("callback error"))
+        events.append("command_body")
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    # Command should complete normally despite callback error
+    assert events == ["command_body"]
