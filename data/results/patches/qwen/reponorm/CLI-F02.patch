+def test_on_exit_normal_command_completion(runner):
+    """Test on_exit works with normal command completion."""
+    events = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: events.append("on_exit")
