+def test_on_exit_resource_cleanup_after_keyboard_interrupt(runner):
+    """Test resources are released when KeyboardInterrupt propagates."""
+    cleaned_up = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        def cleanup():
+            cleaned_up.append(True)
+        
+        ctx.call_on_close(cleanup)
+        ctx.on_exit = lambda c: (_ for _ in ()).throw(KeyboardInterrupt())
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert result.exception is not None
+    assert isinstance(result.exception, KeyboardInterrupt)
+    # Cleanup should still happen
+    assert cleaned_up == [True]
+
+
+def test_on_exit_resource_cleanup_after_system_exit(runner):
+    """Test resources are released when SystemExit propagates."""
+    cleaned_up = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        def cleanup():
+            cleaned_up.append(True)
+        
+        ctx.call_on_close(cleanup)
+        ctx.on_exit = lambda c: (_ for _ in ()).throw(SystemExit(1))
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert result.exception is not None
+    assert isinstance(result.exception, SystemExit)
+    # Cleanup should still happen
+    assert cleaned_up == [True]
