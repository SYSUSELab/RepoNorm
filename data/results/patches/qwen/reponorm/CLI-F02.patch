+def test_on_exit_with_context_manager_resources(runner):
+    """Test on_exit works alongside context manager resources."""
+    resources = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        @contextmanager
+        def resource():
+            resources.append("acquire")
+            try:
+                yield object()
+            finally:
+                resources.append("release")
+
+        ctx.on_exit = lambda c: resources.append("on_exit")
+        ctx.with_resource(resource())
+        resources.append("use")
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    # Resources should be properly managed
+    assert resources == ["acquire", "use", "release", "on_exit"]
