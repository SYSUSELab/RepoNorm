+def test_on_exit_command_raises_exception(runner):
+    """Test on_exit runs even when command raises an exception."""
+    events = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: events.append("on_exit")
+        raise ValueError("test error")
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert result.exception is not None
+    assert isinstance(result.exception, ValueError)
+    # on_exit should still be called
+    assert events == ["on_exit"]
+
