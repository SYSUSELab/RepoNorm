+
+# Tests for on_exit callback parameter
+
+
+def test_on_exit_basic(runner):
+    """Test basic on_exit callback invocation."""
+    called = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: called.append("exit")
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    assert called == ["exit"]
+
+
+def test_on_exit_callback_receives_context(runner):
+    """Test that on_exit callback receives the Context being closed."""
+    received_ctx = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: received_ctx.append(c)
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    assert len(received_ctx) == 1
+    # The callback receives a context, we just verify it was called
+
+
+def test_on_exit_callback_sees_command_identity(runner):
+    """Test that on_exit callback can observe final command identity."""
+    observed_commands = []
+
+    @click.group()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: observed_commands.append(c.command.name)
+
+    @cli.command()
+    def sub():
+        pass
+
+    result = runner.invoke(cli, ["sub"], standalone_mode=False)
+    assert not result.exception
+    # The callback sees the command of the context it's attached to
+    assert "cli" in observed_commands
+
+
+def test_on_exit_callback_sees_parsed_params(runner):
+    """Test that on_exit callback can observe parsed parameters."""
+    observed_params = []
+
+    @click.command()
+    @click.option("--name", default="default")
+    @click.pass_context
+    def cli(ctx, name):
+        ctx.params["name"] = name
+        ctx.on_exit = lambda c: observed_params.append(c.params.get("name"))
+
+    result = runner.invoke(cli, ["--name", "test"], standalone_mode=False)
+    assert not result.exception
+    assert observed_params == ["test"]
+
+
+def test_on_exit_single_invocation_per_teardown(runner):
+    """Test that on_exit runs once per completed teardown."""
+    call_count = [0]
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: call_count.append(1)
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    assert len(call_count) == 2
+
+
+def test_on_exit_nested_context_no_duplicate(runner):
+    """Test that nested with ctx doesn't invoke callback multiple times."""
+    call_count = [0]
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: call_count.append(1)
+        # Simulate nested context entry
+        with click.Context(cli, parent=ctx) as inner_ctx:
+            pass
+        # Outer context exit should only trigger once
+        return None
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    assert len(call_count) == 2
+
+
+def test_on_exit_separate_enter_exit_cycle(runner):
+    """Test that a later separate enter/exit cycle invokes callback again."""
+    call_counts = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: call_counts.append(1)
+
+    # First invocation
+    result1 = runner.invoke(cli, standalone_mode=False)
+    assert not result1.exception
+    
+    # Second invocation (separate cycle)
+    result2 = runner.invoke(cli, standalone_mode=False)
+    assert not result2.exception
+    
+    assert call_counts == [1, 1]
+
+
+def test_on_exit_explicit_exit_no_double_invoke(runner):
+    """Test that calling ctx.exit() and leaving enclosing context doesn't invoke twice."""
+    call_count = [0]
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: call_count.append(1)
+        ctx.exit()
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    assert len(call_count) == 2
+
+
+def test_on_exit_scope_cleanup_false_not_triggered(runner):
+    """Test that scope(cleanup=False) does not trigger on_exit."""
+    call_count = [0]
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: call_count.append(1)
+        # Create a scoped context without cleanup
+        with ctx.scope(cleanup=False) as scoped_ctx:
+            pass
+        # The scoped context shouldn't trigger on_exit
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert not result.exception
+    # Main context should still trigger on_exit
+    assert len(call_count) == 2
+
+
+def test_on_exit_parent_child_independent_callbacks(runner):
+    """Test that parent and child contexts have independent callbacks."""
+    parent_calls = []
+    child_calls = []
+
+    @click.group()
+    @click.pass_context
+    def cli(ctx):
+        ctx.on_exit = lambda c: parent_calls.append("parent")
+
+    @cli.command()
+    @click.pass_context
+    def sub(ctx):
+        ctx.on_exit = lambda c: child_calls.append("child")
+
+    result = runner.invoke(cli, ["sub"], standalone_mode=False)
+    assert not result.exception
+    # Both parent and child callbacks should be invoked
+    assert parent_calls == ["parent"]
+    assert child_calls == ["child"]
+
