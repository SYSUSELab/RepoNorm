+    You can limit the number of groups returned with ``max_groups``.
+    When set to a non-negative integer, only the first N groups in
+    ascending key order are returned. Setting it to 0 returns no groups.
+    Negative, non-integer, or boolean values raise
+    :exc:`~jinja2.exceptions.FilterArgumentError`.
+
+    .. versionchanged:: 3.1
+        Added the ``max_groups`` parameter.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
     """
+    if isinstance(max_groups, bool):
+        raise FilterArgumentError("max_groups must be an integer or None, not a boolean")
+    if max_groups is not None and not isinstance(max_groups, int):
+        raise FilterArgumentError("max_groups must be an integer or None")
+    if max_groups is not None and max_groups < 0:
+        raise FilterArgumentError("max_groups must be non-negative")
+
