+def _get_process_priority(priority: str | None) -> int | None:
+    """Map priority name to nice value or None.
+    
+    Returns None if priority is None or invalid.
+    Nice values range from -20 (highest priority) to 19 (lowest).
+    """
+    if priority is None:
+        return None
+    
+    mapping = {
+        "low": 10,
+        "below_normal": 5,
+        "normal": 0,
+        "above_normal": -5,
+        "high": -10,
+    }
+    
+    return mapping.get(priority)
+
