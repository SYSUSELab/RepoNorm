+def test_xgrammar_logits_processor_custom_adapter():
+    """Test that XGrammarLogitsProcessor accepts custom tensor adapters."""
+    from outlines.processors.tensor_adapters import TorchTensorAdapter
+    
+    # Test 1: Default behavior (torch)
+    processor = XGrammarLogitsProcessor("test_grammar")
+    assert processor.tensor_adapter.library_name == "torch"
+    
+    # Test 2: Custom adapter with tensor_library_name="custom"
+    custom_adapter = TorchTensorAdapter()
+    processor = XGrammarLogitsProcessor(
+        "test_grammar", 
+        tensor_library_name="custom", 
+        custom_adapter=custom_adapter
+    )
+    assert processor.tensor_adapter is custom_adapter
+    
+    # Test 3: ValueError when custom_adapter is None and tensor_library_name="custom"
+    with pytest.raises(ValueError, match="custom_adapter is required"):
+        XGrammarLogitsProcessor("test_grammar", tensor_library_name="custom")
+    
+    # Test 4: ValueError when custom_adapter is provided with non-custom library
+    with pytest.raises(ValueError, match="can only be used when"):
+        XGrammarLogitsProcessor(
+            "test_grammar", 
+            tensor_library_name="numpy", 
+            custom_adapter=custom_adapter
+        )
+    
+    # Test 5: Other libraries still work
+    processor = XGrammarLogitsProcessor("test_grammar", tensor_library_name="numpy")
+    assert processor.tensor_adapter.library_name == "numpy"
+
+
+def test_xgrammar_backend_custom_adapter_forwarding(backend):
+    """Test that XGrammarBackend factory methods forward custom adapter parameters."""
+    from outlines.processors.tensor_adapters import TorchTensorAdapter
+    
+    custom_adapter = TorchTensorAdapter()
+    
+    # Test get_json_schema_logits_processor
+    processor = backend.get_json_schema_logits_processor(
+        '{"type": "object"}',
+        tensor_library_name="custom",
+        custom_adapter=custom_adapter,
+    )
+    assert isinstance(processor, XGrammarLogitsProcessor)
+    assert processor.tensor_adapter is custom_adapter
+    
+    # Test get_regex_logits_processor
+    processor = backend.get_regex_logits_processor(
+        r"[0-9]{3}",
+        tensor_library_name="custom",
+        custom_adapter=custom_adapter,
+    )
+    assert isinstance(processor, XGrammarLogitsProcessor)
+    assert processor.tensor_adapter is custom_adapter
+    
+    # Test get_cfg_logits_processor
+    processor = backend.get_cfg_logits_processor(
+        "root ::= answer\nanswer ::= \"yes\" | \"no\"",
+        tensor_library_name="custom",
+        custom_adapter=custom_adapter,
+    )
+    assert isinstance(processor, XGrammarLogitsProcessor)
+    assert processor.tensor_adapter is custom_adapter
