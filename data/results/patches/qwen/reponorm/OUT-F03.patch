diff --git a/tests/backends/test_xgrammar.py b/tests/backends/test_xgrammar.py
index 1133b9f..45f660d 100644
--- a/tests/backends/test_xgrammar.py
+++ b/tests/backends/test_xgrammar.py
@@ -93,3 +93,137 @@ def test_xgrammar_backend_invalid_model(model_llamacpp):
         match="The xgrammar backend only supports Transformers models",
     ):
         XGrammarBackend(model_llamacpp)
+
+
+def test_xgrammar_logits_processor_temperature_default(model_transformers):
+    """Test that default temperature is 1.0."""
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor('{"type": "string"}')
+    assert processor.temperature == 1.0
+
+
+def test_xgrammar_logits_processor_temperature_custom(model_transformers):
+    """Test that custom temperature values are accepted and stored."""
+    backend = XGrammarBackend(model_transformers)
+    
+    # Test various valid temperatures
+    for temp in [0.5, 1.0, 2.0, 0.1, 10.0]:
+        processor = backend.get_json_schema_logits_processor(
+            '{"type": "string"}', temperature=temp
+        )
+        assert processor.temperature == float(temp)
+
+
+def test_xgrammar_logits_processor_temperature_invalid_types():
+    """Test that invalid temperature types raise ValueError."""
+    import pytest
+    
+    from outlines.backends.xgrammar import XGrammarLogitsProcessor
+    
+    # String temperature
+    with pytest.raises(ValueError, match="temperature must be a numeric value"):
+        XGrammarLogitsProcessor("test_grammar", temperature="1.0")
+    
+    # None temperature
+    with pytest.raises(ValueError, match="temperature must be a numeric value"):
+        XGrammarLogitsProcessor("test_grammar", temperature=None)
+    
+    # List temperature
+    with pytest.raises(ValueError, match="temperature must be a numeric value"):
+        XGrammarLogitsProcessor("test_grammar", temperature=[1.0])
+
+
+def test_xgrammar_logits_processor_temperature_non_finite():
+    """Test that non-finite temperature values raise ValueError."""
+    import pytest
+    import math
+    
+    from outlines.backends.xgrammar import XGrammarLogitsProcessor
+    
+    # Infinity
+    with pytest.raises(ValueError, match="temperature must be a finite value"):
+        XGrammarLogitsProcessor("test_grammar", temperature=float('inf'))
+    
+    # Negative infinity
+    with pytest.raises(ValueError, match="temperature must be a finite value"):
+        XGrammarLogitsProcessor("test_grammar", temperature=float('-inf'))
+    
+    # NaN
+    with pytest.raises(ValueError, match="temperature must be a finite value"):
+        XGrammarLogitsProcessor("test_grammar", temperature=float('nan'))
+
+
+def test_xgrammar_logits_processor_temperature_zero_or_negative():
+    """Test that zero or negative temperature values raise ValueError."""
+    import pytest
+    
+    from outlines.backends.xgrammar import XGrammarLogitsProcessor
+    
+    # Zero
+    with pytest.raises(ValueError, match="temperature must be greater than zero"):
+        XGrammarLogitsProcessor("test_grammar", temperature=0)
+    
+    # Negative
+    with pytest.raises(ValueError, match="temperature must be greater than zero"):
+        XGrammarLogitsProcessor("test_grammar", temperature=-1.0)
+
+
+def test_xgrammar_logits_processor_temperature_reset(model_transformers):
+    """Test that temperature remains unchanged after reset()."""
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor(
+        '{"type": "string"}', temperature=2.0
+    )
+    
+    initial_temp = processor.temperature
+    processor.reset()
+    
+    assert processor.temperature == initial_temp
+
+
+def test_xgrammar_backend_all_methods_forward_temperature(model_transformers):
+    """Test that all three factory methods forward the temperature option."""
+    backend = XGrammarBackend(model_transformers)
+    
+    json_schema = '{"type": "string"}'
+    regex = r"[0-9]{3}"
+    cfg = "root ::= answer\nanswer ::= \"yes\" | \"no\""
+    
+    # JSON schema
+    processor = backend.get_json_schema_logits_processor(
+        json_schema, temperature=0.7
+    )
+    assert processor.temperature == 0.7
+    
+    # Regex
+    processor = backend.get_regex_logits_processor(regex, temperature=0.7)
+    assert processor.temperature == 0.7
+    
+    # CFG
+    processor = backend.get_cfg_logits_processor(cfg, temperature=0.7)
+    assert processor.temperature == 0.7
+
+
+def test_xgrammar_logits_processor_process_logits_temperature_scaling(model_transformers):
+    """Test that temperature scaling is applied correctly in process_logits."""
+    import torch
+    
+    backend = XGrammarBackend(model_transformers)
+    processor = backend.get_json_schema_logits_processor(
+        '{"type": "string"}', temperature=2.0
+    )
+    
+    # Create dummy logits
+    input_ids = torch.tensor([[1, 2, 3]])
+    logits = torch.tensor([[10.0, 20.0, 30.0, 40.0]])
+    
+    # Get processed logits
+    processed_logits = processor(input_ids, logits)
+    
+    # Verify shape is preserved
+    assert processed_logits.shape == logits.shape
+    
+    # Temperature scaling should have been applied before grammar constraints
+    # The exact values depend on the grammar constraints, but we can verify
+    # that the processor has the correct temperature attribute
+    assert processor.temperature == 2.0
