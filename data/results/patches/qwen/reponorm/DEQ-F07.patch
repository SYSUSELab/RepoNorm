+
+# Hash algorithm lengths in hex characters
+_HASH_LENGTHS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hash digest for a given algorithm.
+
+    Supports MD5, SHA1, SHA224, SHA256, SHA384, and SHA512 algorithms.
+    The comparison is case-insensitive for the algorithm name but preserves
+    the original spelling in the repr.
+
+    ```py title="IsHash"
+    from dirty_equals import IsHash
+
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+    assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('SHA1')
+    assert 'aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d' == IsHash('sha256')
+    assert 'cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e' == IsHash('SHA512')
+    ```
+    """
+
+    def __init__(self, algorithm: Literal['MD5', 'SHA1', 'SHA224', 'SHA256', 'SHA384', 'SHA512']):
+        """
+        Args:
+            algorithm: The hash algorithm to check. Case-insensitive.
+
+        Raises:
+            ValueError: If the algorithm is not supported.
+        """
+        self.algorithm = algorithm
+        self._algorithm_lower = algorithm.lower()
+
+        if self._algorithm_lower not in _HASH_LENGTHS:
+            raise ValueError(f'Unsupported hash algorithm: {algorithm!r}')
+
+        self.length = _HASH_LENGTHS[self._algorithm_lower]
+        super().__init__(plain_repr(algorithm))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if len(other) != self.length:
+            return False
+
+        # Check if all characters are valid hex digits
+        try:
+            int(other, 16)
+            return True
+        except ValueError:
+            return False
