     #: .. versionadded:: 2.4
     has_source_access = True
 
+    def __init__(self) -> None:
+        """Initialize the loader with an empty alias dictionary."""
+        self._aliases: t.Dict[str, str] = {}
+        self._environment: t.Optional["Environment"] = None
+
+    def set_environment(self, environment: "Environment") -> None:
+        """Set the environment for this loader.
+
+        This is called by the Environment when the loader is assigned.
+        """
+        self._environment = environment
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Add an alias for a template.
+
+        The alias is resolved exactly once by the loader that owns it, before
+        that loader performs its normal loading or composite routing; aliases
+        do not chain.
+
+        :param alias: The alias name to use for looking up the template.
+        :param target: The actual template name to load.
+
+        .. versionadded:: 3.1
+        """
+        if not isinstance(alias, str) or not isinstance(target, str):
+            raise TypeError("alias and target must be strings")
+        self._aliases[alias] = target
+        self._update_cache(alias)
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias if it exists.
+
+        Removing an unknown alias is harmless.
+
+        .. versionadded:: 3.1
+        """
+        self._aliases.pop(alias, None)
+        self._update_cache(alias)
+
+    def _resolve_alias(self, name: str) -> str:
+        """Resolve an alias to its target if it exists.
+
+        Returns the original name if no alias exists.
+        Raises TemplateNotFound if the alias points to a non-existent target.
+        """
+        if name in self._aliases:
+            target = self._aliases[name]
+            # Check if target exists by attempting to get its source
+            try:
+                self.get_source(None, target)
+                return target
+            except TemplateNotFound:
+                raise TemplateNotFound(name)
+        return name
+
+    def _update_cache(self, alias: str) -> None:
+        """Invalidate cached templates when an alias is modified.
+
+        This method is called when an alias is added or removed to ensure
+        that any cached templates using this alias are invalidated.
+        """
+        if self._environment is not None and self._environment.cache is not None:
+            # Invalidate all cache entries for this loader
+            keys_to_remove = []
+            for key in list(self._environment.cache.keys()):
+                if key[0]() == self:
+                    keys_to_remove.append(key)
+            for key in keys_to_remove:
+                del self._environment.cache[key]
+
     def get_source(
         self, environment: "Environment", template: str
     ) -> t.Tuple[str, t.Optional[str], t.Optional[t.Callable[[], bool]]]:
