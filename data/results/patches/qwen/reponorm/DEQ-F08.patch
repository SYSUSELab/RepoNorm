+class IsRegex(DirtyEquals[str]):
+    """
+    Checks if a value is a string that matches a regular expression pattern.
+
+    `IsRegex` allows matching strings against regular expressions with different modes:
+    - `match`: Match at the beginning of the string (default)
+    - `search`: Search anywhere in the string
+    - `fullmatch`: Match the entire string
+
+    Examples:
+    ```py title="IsRegex"
+    from dirty_equals import IsRegex
+
+    assert 'foobar' == IsRegex(r'foo.*')
+    assert 'foobar' == IsRegex(r'foo', mode='match')
+    assert 'barfoobar' == IsRegex(r'foo', mode='search')
+    assert 'foobar' == IsRegex(r'foobar', mode='fullmatch')
+    assert 'foobarbaz' != IsRegex(r'foobar', mode='fullmatch')
+    ```
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, Pattern[str]],
+        flags: int = 0,
+        *,
+        mode: Literal['match', 'search', 'fullmatch'] = 'match',
+    ):
+        """
+        Args:
+            pattern: Regular expression pattern to match. Can be a string or compiled regex.
+            flags: Optional flags for the regular expression (e.g., `re.IGNORECASE`).
+                If a compiled pattern is passed, this should be 0.
+            mode: Matching mode - 'match' (default), 'search', or 'fullmatch'.
+
+        Raises:
+            re.error: If the pattern is invalid.
+            ValueError: If an invalid mode is provided or if flags are passed with a compiled pattern.
+            TypeError: If a bytes pattern is provided.
+        """
+        self.mode = mode
+        if self.mode not in ("match", "search", "fullmatch"):
+            raise ValueError(f"Invalid mode: {self.mode}")
+        self.pattern: Union[str, Pattern[str]]
+        self.flags: int
+
+        if isinstance(pattern, bytes):
+            raise TypeError("IsRegex does not support bytes patterns")
+
+        if isinstance(pattern, re.Pattern):
+            if flags != 0:
+                raise ValueError(
+                    "Cannot pass flags when a compiled pattern is provided"
+                )
+            self.pattern = pattern
+            self.flags = pattern.flags
+        else:
+            # Validate the pattern by compiling it
+            try:
+                re.compile(pattern, flags)
+            except re.error:
+                raise
+            self.pattern = pattern
+            self.flags = flags
+
+        super().__init__(
+            plain_repr(repr(self.pattern)),
+            flags=Omit if self.flags == 0 else plain_repr(repr(re.RegexFlag(self.flags))),
+            mode=Omit if self.mode == 'match' else self.mode,
+        )
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if isinstance(self.pattern, re.Pattern):
+            # Use the compiled pattern directly without additional flags
+            if self.mode == 'match':
+                result = self.pattern.match(other)
+            elif self.mode == 'search':
+                result = self.pattern.search(other)
+            elif self.mode == 'fullmatch':
+                result = self.pattern.fullmatch(other)
+            else:
+                raise ValueError(f"Invalid mode: {self.mode}")
+        else:
+            # Use string pattern with flags
+            if self.mode == 'match':
+                result = re.match(self.pattern, other, flags=self.flags)
+            elif self.mode == 'search':
+                result = re.search(self.pattern, other, flags=self.flags)
+            elif self.mode == 'fullmatch':
+                result = re.fullmatch(self.pattern, other, flags=self.flags)
+            else:
+                raise ValueError(f"Invalid mode: {self.mode}")
+
+        return result is not None
