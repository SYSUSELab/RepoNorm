+def _create_backup(filename: str) -> None:
+    """Create a backup copy of the file with timestamp and collision handling.
+
+    :param filename: The path to the file to backup.
+    :raises ClickException: If backup creation fails.
+    """
+    import os
+    from datetime import datetime
+
+    # Only create backup if file exists
+    if not os.path.isfile(filename):
+        return
+
+    base, ext = os.path.splitext(filename)
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+    backup_name = f"{base}.backup.{timestamp}{ext}"
+
+    # Handle collision for same-second edits
+    counter = 1
+    while os.path.exists(backup_name):
+        backup_name = f"{base}.backup.{timestamp}_{counter}{ext}"
+        counter += 1
+
+    try:
+        shutil.copy2(filename, backup_name)
+    except OSError as e:
+        raise ClickException(f"Failed to create backup file") from e
+
 
