+# Tests for IsIP
+def test_is_ip_basic():
+    """Test basic IPv4 and IPv6 address matching."""
+    from dirty_equals import IsIP
+    
+    assert "192.168.1.1" == IsIP()
+    assert "::1" == IsIP()
+    assert "10.0.0.1" == IsIP()
+    assert "fe80::1" == IsIP()
+
+
+def test_is_ip_networks():
+    """Test network matching."""
+    from dirty_equals import IsIP
+    
+    assert "192.168.1.0/24" == IsIP()
+    assert "::/0" == IsIP()
+    assert "10.0.0.0/8" == IsIP()
+
+
+def test_is_ip_version():
+    """Test version filtering."""
+    from dirty_equals import IsIP
+    
+    # Version 4
+    v4 = IsIP(4)
+    assert "192.168.1.1" == v4
+    assert "10.0.0.1" == v4
+    assert "192.168.1.0/24" == v4
+    assert "::1" != v4
+    assert "fe80::1" != v4
+    
+    # Version 6
+    v6 = IsIP(6)
+    assert "::1" == v6
+    assert "fe80::1" == v6
+    assert "::/0" == v6
+    assert "192.168.1.1" != v6
+    assert "10.0.0.1" != v6
+
+
+def test_is_ip_integers():
+    """Test integer representation of IP addresses."""
+    from dirty_equals import IsIP
+    
+    # IPv4 as integer (0 <= value < 2**32)
+    assert 3232235777 == IsIP()  # 192.168.1.1
+    assert 0 == IsIP()  # 0.0.0.0
+    assert 2**32 - 1 == IsIP()  # 255.255.255.255
+    
+    # IPv6 as integer (2**32 <= value < 2**128)
+    assert 2**32 == IsIP()  # ::
+    assert 2**32 + 1 == IsIP()  # ::1
+    
+    # Invalid range should not match
+    assert -1 != IsIP()
+    assert 2**128 != IsIP()
+
+
+def test_is_ip_bytes():
+    """Test bytes representation of IP addresses."""
+    from dirty_equals import IsIP
+    import ipaddress
+    
+    ipv4_bytes = ipaddress.IPv4Address('192.168.1.1').packed
+    assert ipv4_bytes == IsIP()
+    
+    ipv6_bytes = ipaddress.IPv6Address('::1').packed
+    assert ipv6_bytes == IsIP()
+
+
+def test_is_ip_repr():
+    """Test repr behavior."""
+    from dirty_equals import IsIP
+    
+    assert repr(IsIP()) == "IsIP()"
+    assert repr(IsIP(4)) == "IsIP(4)"
+    assert repr(IsIP(6)) == "IsIP(6)"
+    assert repr(IsIP(4, netmask="255.255.255.0")) == "IsIP(4, '255.255.255.0')"
+    assert repr(IsIP(within="192.168.0.0/16")) == "IsIP('192.168.0.0/16')"
+
+
+def test_is_ip_netmask_type_error():
