+def test_is_ip_within_value_errors():
+    """Test ValueError cases for within parameter."""
+    from dirty_equals import IsIP
+    
+    # Empty list/tuple
+    try:
+        IsIP(within=[])
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "empty" in str(e).lower()
+    
+    try:
+        IsIP(within=())
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "empty" in str(e).lower()
+    
+    # CIDR with host bits set
+    try:
+        IsIP(within="192.168.1.5/24")
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "host bits" in str(e).lower()
+    
+    # Bare address without slash
+    try:
+        IsIP(within="192.168.1.1")
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "bare address" in str(e).lower()
+    
+    # Invalid element type
+    try:
+        IsIP(within=[123])
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "invalid" in str(e).lower()
+    
+    # Non-network string in list
+    try:
+        IsIP(within=["192.168.0.0/16", "not-a-network"])
+        assert False, "Should have raised ValueError"
+    except ValueError as e:
+        assert "bare address" in str(e).lower() or "invalid" in str(e).lower()
