+def test_is_ip_combined_constraints():
+    """Test combining version, netmask, and within constraints."""
+    from dirty_equals import IsIP
+    
+    # Version + netmask
+    v = IsIP(version=4, netmask="255.255.255.0")
+    assert "192.168.1.0/24" == v
+    assert "192.168.1.0/16" != v
+    
+    # Version + within
+    v = IsIP(version=4, within="192.168.0.0/16")
+    assert "192.168.1.1" == v
+    assert "::1" != v
+    
+    # All three together
+    v = IsIP(version=4, netmask="255.255.255.0", within="192.168.0.0/16")
+    assert "192.168.1.0/24" == v
+    assert "192.168.1.0/16" != v  # Wrong netmask
+    assert "10.0.0.0/24" != v  # Not within range
