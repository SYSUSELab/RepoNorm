+import ipaddress
+from typing import Any, List, Optional, Tuple, Union
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+
+class IsIP(DirtyEquals[Union[ipaddress.IPv4Address, ipaddress.IPv6Address, ipaddress.IPv4Network, ipaddress.IPv6Network]]):
+    """
+    A class that checks if a value is a valid IP address or network, optionally checking version, netmask, or within a specific network.
+
+    ```py title="IsIP"
+    from dirty_equals import IsIP
+
+    assert "192.168.1.1" == IsIP
+    assert "10.0.0.1" == IsIP(4)
+    assert "::1" == IsIP(6)
+    assert 3232235777 == IsIP  # IPv4 as integer
+    assert "192.168.1.0/24" == IsIP
+    assert "192.168.1.0/24" == IsIP(netmask="255.255.255.0")
+    assert "192.168.1.100" == IsIP(within="192.168.1.0/24")
+    ```
+    """
+
+    def __init__(
+        self,
+        version: Optional[int] = None,
+        *,
+        netmask: Optional[Union[str, int]] = None,
+        within: Optional[Union[str, ipaddress.IPv4Network, ipaddress.IPv6Network, List[Union[str, ipaddress.IPv4Network, ipaddress.IPv6Network]], Tuple[Union[str, ipaddress.IPv4Network, ipaddress.IPv6Network], ...]]] = None,
+    ):
+        """
+        Args:
+            version: The IP version to check (4 or 6), if omitted, both versions are accepted.
+            netmask: The netmask to check for networks. Can be an IPv4 dotted-decimal mask,
+                an IPv6 mask string, or the corresponding integer mask value.
+                Requires version to be specified.
+            within: Restrict matching to a strict CIDR network string, ipaddress network object,
+                or a nonempty list/tuple of these. An address must belong to at least one configured
+                network; a network input must be wholly contained in one configured network.
+
+        Raises:
+            TypeError: If netmask is provided without version.
+            ValueError: If within is empty or contains invalid values.
+        """
+        if netmask is not None and version is None:
+            raise TypeError("To check the netmask you must specify the IP version")
+
+        self.version = version
+        self.netmask = netmask
+        self.within = within
+
+        # Validate and normalize 'within' parameter
+        self._normalized_within_v4: Optional[Tuple[ipaddress.IPv4Network, ...]] = None
+        self._normalized_within_v6: Optional[Tuple[ipaddress.IPv6Network, ...]] = None
+
+        if within is not None:
+            if isinstance(within, (str, ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                within_list = [within]
+            elif isinstance(within, (list, tuple)):
+                within_list = list(within)
+            else:
+                raise ValueError("within must be a string, ipaddress network object, or a nonempty list/tuple of these")
+
+            if not within_list:
+                raise ValueError("within cannot be empty")
+
+            normalized_networks_v4: List[ipaddress.IPv4Network] = []
+            normalized_networks_v6: List[ipaddress.IPv6Network] = []
+
+            for item in within_list:
+                try:
+                    if isinstance(item, str):
+                        # Check if it's a bare address (no slash) - this should raise ValueError
+                        if "/" not in item:
+                            raise ValueError(f"within configuration contains bare address string without a slash: {item}")
+                        network = ipaddress.ip_network(item, strict=False)
+                    elif isinstance(item, (ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                        network = item
+                    else:
+                        raise ValueError(f"within configuration contains invalid element type: {type(item)}")
+
+                    # Check for host bits set in the network (for string inputs)
+                    if isinstance(item, str):
+                        # Extract the IP part before the slash
+                        ip_part = item.split('/')[0]
+                        # Compare with the network address to detect host bits
+                        if ip_part != str(network.network_address):
+                            raise ValueError(f"within configuration contains CIDR with host bits set: {item}")
+
+                    if isinstance(network, ipaddress.IPv4Network):
+                        normalized_networks_v4.append(network)
+                    else:
+                        normalized_networks_v6.append(network)
+                except (ValueError, TypeError) as e:
+                    if "host bits" in str(e) or "bare address" in str(e):
+                        raise
+                    raise ValueError(f"Invalid within configuration: {item}") from e
+
+            if not normalized_networks_v4 and not normalized_networks_v6:
+                raise ValueError("within must contain at least one valid network")
+
+            self._normalized_within_v4 = tuple(normalized_networks_v4)
+            self._normalized_within_v6 = tuple(normalized_networks_v6)
+
+        # Prepare repr args
+        repr_args = []
+        if version is not None:
+            repr_args.append(version)
+        if netmask is not None:
+            repr_args.append(netmask)
+        if within is not None:
+            repr_args.append(within)
+
+        super().__init__(*repr_args)
+
+    def equals(self, other: Any) -> bool:
+        try:
+            parsed = self._parse_ip(other)
+            if parsed is None:
+                return False
+
+            # Check version
+            if self.version is not None:
+                actual_version = 4 if isinstance(parsed, (ipaddress.IPv4Address, ipaddress.IPv4Network)) else 6
+                if actual_version != self.version:
+                    return False
+
+            # Check netmask - only applies to networks
+            if self.netmask is not None:
+                if not isinstance(parsed, (ipaddress.IPv4Network, ipaddress.IPv6Network)):
+                    return False
+                if not self._check_netmask(parsed, self.netmask):
+                    return False
+
+            # Check within
+            if self._normalized_within_v4 is not None or self._normalized_within_v6 is not None:
+                if not self._check_within(parsed):
+                    return False
+
+            return True
+        except (TypeError, ValueError):
+            return False
+
+    def _parse_ip(self, other: Any) -> Optional[Union[ipaddress.IPv4Address, ipaddress.IPv6Address, ipaddress.IPv4Network, ipaddress.IPv6Network]]:
+        """Parse the input into an IP address or network object."""
+        if isinstance(other, (ipaddress.IPv4Address, ipaddress.IPv6Address, ipaddress.IPv4Network, ipaddress.IPv6Network)):
+            return other
+        elif isinstance(other, str):
+            try:
+                # Try parsing as network first (includes addresses with /0)
+                network = ipaddress.ip_network(other, strict=False)
+                return network
+            except ValueError:
+                pass
+            try:
+                addr = ipaddress.ip_address(other)
+                return addr
+            except ValueError:
+                return None
+        elif isinstance(other, int):
+            if 0 <= other < 2**32:
+                # IPv4 address
+                try:
+                    return ipaddress.IPv4Address(other)
+                except (ValueError, OverflowError):
+                    return None
+            elif 2**32 <= other < 2**128:
+                # IPv6 address
+                try:
+                    return ipaddress.IPv6Address(other)
+                except (ValueError, OverflowError):
+                    return None
+            else:
+                return None
+        elif isinstance(other, bytes):
+            try:
+                addr = ipaddress.ip_address(other)
+                return addr
+            except (ValueError, TypeError):
+                return None
+        else:
+            return None
+
+    def _check_netmask(self, network: Union[ipaddress.IPv4Network, ipaddress.IPv6Network], netmask: Union[str, int]) -> bool:
+        """Check if the network has the specified netmask."""
+        if isinstance(netmask, int):
+            # Integer represents the complete mask value, not CIDR prefix length
+            expected_mask_int = netmask
+            actual_mask_int = int(network.netmask)
+            return expected_mask_int == actual_mask_int
+        else:
+            # String - could be dotted decimal (IPv4) or IPv6 mask string
+            try:
+                # Try parsing as an address first (dotted decimal for IPv4)
+                test_addr = ipaddress.ip_address(netmask)
+                
+                if isinstance(test_addr, ipaddress.IPv4Address):
+                    # Convert dotted decimal to prefix length
+                    prefix_len = self._dotted_decimal_to_prefix(netmask)
+                    if prefix_len is None:
+                        return False
+                    expected_mask_int = (0xFFFFFFFF << (32 - prefix_len)) & 0xFFFFFFFF
+                    return int(network.netmask) == expected_mask_int
+                else:
+                    # IPv6 - parse the mask string directly
+                    prefix_len = self._ipv6_mask_string_to_prefix(netmask)
+                    expected_network = ipaddress.IPv6Network(f"::/{prefix_len}", strict=False)
+                    return int(network.netmask) == int(expected_network.netmask)
+            except (ValueError, TypeError):
+                return False
+
+    def _dotted_decimal_to_prefix(self, mask_str: str) -> Optional[int]:
+        """Convert dotted decimal mask to prefix length."""
+        try:
+            parts = [int(p) for p in mask_str.split(".")]
+            if len(parts) != 4:
+                return None
+            # Check if it's a valid contiguous mask
+            mask_int = sum(p << (8 * (3 - i)) for i, p in enumerate(parts))
+            # Count leading 1s
+            prefix_len = 0
+            for i in range(31, -1, -1):
+                if mask_int & (1 << i):
+                    prefix_len += 1
+                else:
+                    break
+            # Verify all remaining bits are 0
+            if mask_int != ((1 << prefix_len) - 1) << (32 - prefix_len):
+                return None
+            return prefix_len
+        except (ValueError, AttributeError):
+            return None
+
+    def _ipv6_mask_string_to_prefix(self, mask_str: str) -> int:
+        """Convert IPv6 mask string to prefix length."""
+        try:
+            addr = ipaddress.IPv6Address(mask_str)
+            mask_int = int(addr)
+            # Count leading 1s
+            prefix_len = 0
+            for i in range(127, -1, -1):
+                if mask_int & (1 << i):
+                    prefix_len += 1
+                else:
+                    break
+            return prefix_len
+        except (ValueError, TypeError):
+            return 0
+
+    def _check_within(self, parsed: Union[ipaddress.IPv4Address, ipaddress.IPv6Address, ipaddress.IPv4Network, ipaddress.IPv6Network]) -> bool:
+        """Check if the parsed IP/network is within any of the configured networks."""
+        if self._normalized_within_v4 is None and self._normalized_within_v6 is None:
+            return True
+
+        if isinstance(parsed, (ipaddress.IPv4Address, ipaddress.IPv4Network)):
+            if self._normalized_within_v4 is None:
+                return False
+            # For addresses, check if they're contained in any network
+            if isinstance(parsed, ipaddress.IPv4Address):
+                for network in self._normalized_within_v4:
+                    if parsed in network:
+                        return True
+                return False
+            # For networks, check if they're wholly contained in any network
+            else:
+                for network in self._normalized_within_v4:
+                    if parsed.subnet_of(network):
+                        return True
+                return False
+        elif isinstance(parsed, (ipaddress.IPv6Address, ipaddress.IPv6Network)):
+            if self._normalized_within_v6 is None:
+                return False
+            if isinstance(parsed, ipaddress.IPv6Address):
+                for network in self._normalized_within_v6:
+                    if parsed in network:
+                        return True
+                return False
+            else:
+                for network in self._normalized_within_v6:
+                    if parsed.subnet_of(network):
+                        return True
+                return False
+
+        return False
