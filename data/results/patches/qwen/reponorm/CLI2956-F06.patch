+def _looks_like_dynamic_default(default: t.Any) -> bool:
+    """Check if a default value looks like a dynamic default dictionary.
+    
+    Returns True if the default is a non-empty dict where all keys are
+    full long option names starting with '--'. Values may or may not be dicts.
+    This is used to detect potential dynamic defaults for validation.
+    """
+    if not isinstance(default, dict):
+        return False
+    if not default:  # Empty dict is not dynamic
+        return False
+    for key, value in default.items():
+        # Key must be a full long option name starting with --
+        if not isinstance(key, str) or not key.startswith("--"):
+            return False
+    return True
+
+
+def _is_dynamic_default(default: t.Any) -> bool:
+    """Check if a default value is a valid dynamic default dictionary.
+    
+    Returns True if the default is a non-empty dict where all keys are
+    full long option names starting with '--' and all values are dicts.
+    """
+    if not _looks_like_dynamic_default(default):
+        return False
+    for key, value in default.items():
+        if not isinstance(value, dict):
+            return False
+        for dep_value, target_default in value.items():
+            if not isinstance(dep_value, str):
+                return False
+    return True
+
+
+def _validate_dynamic_mapping(dynamic_default: dict[str, dict[str, t.Any]]) -> None:
+    """Validate that a dynamic default mapping has proper structure.
+    
+    Raises TypeError if any mapping value is not a dict.
+    """
+    for dep_option_name, dep_values_to_targets in dynamic_default.items():
+        if not isinstance(dep_values_to_targets, dict):
+            raise TypeError(
+                f"Dynamic default mapping for '{dep_option_name}' must be a dict, "
+                f"got {type(dep_values_to_targets).__name__}"
+            )
+        for dep_value, target_default in dep_values_to_targets.items():
+            if not isinstance(dep_value, str):
+                raise TypeError(
+                    f"Dependency value in dynamic default for '{dep_option_name}' "
+                    f"must be a string, got {type(dep_value).__name__}"
+                )
+
+
+def _resolve_dynamic_default(
+    param: Parameter,
+    ctx: Context,
+    dynamic_default: dict[str, dict[str, t.Any]],
+) -> tuple[t.Any, ParameterSource]:
+    """Resolve a dynamic default based on dependency values.
+    
+    Returns the resolved default value and its source.
+    Raises UsageError for unknown options or cycles.
+    Raises TypeError for invalid dynamic mappings.
+    """
+    # Validate the dynamic mapping structure first
+    _validate_dynamic_mapping(dynamic_default)
+    
+    # Build a map of option names to their actual parameter objects
+    param_map = {p.name: p for p in ctx.command.get_params(ctx)}
+    
+    # Build dependency graph: which params have dynamic defaults and what do they depend on
+    # Key: param name, Value: set of param names it depends on
+    dep_graph: dict[str, set[str]] = {}
+    
+    for dep_option_name, dep_values_to_targets in dynamic_default.items():
+        # Find the parameter for this dependency
+        dep_param = None
+        for p in ctx.command.get_params(ctx):
+            if dep_option_name in p.opts:
+                dep_param = p
+                break
+        
+        if dep_param is None:
+            raise UsageError(
+                f"Unknown option in dynamic default: {dep_option_name}"
+            )
+        
+        # Record that the current param depends on dep_param
+        if param.name not in dep_graph:
+            dep_graph[param.name] = set()
+        dep_graph[param.name].add(dep_param.name)
+    
+    # Detect cycles using DFS with coloring
+    # WHITE = 0 (unvisited), GRAY = 1 (in progress), BLACK = 2 (done)
+    # Initialize color for all params, not just those with dynamic defaults
+    all_param_names = {p.name for p in ctx.command.get_params(ctx)}
+    color: dict[str, int] = {name: 0 for name in all_param_names}
+    
+    def dfs_detect_cycle(node: str, path: list[str]) -> None:
+        if color[node] == 1:  # GRAY - back edge found, cycle detected
+            cycle_start = path.index(node)
+            cycle_path = path[cycle_start:] + [node]
+            raise UsageError(
+                f"Dependency cycle detected: {' -> '.join(cycle_path)}"
+            )
+        if color[node] == 2:  # BLACK - already fully processed
+            return
+        
+        color[node] = 1  # GRAY - in progress
+        path.append(node)
+        
+        for neighbor in dep_graph.get(node, set()):
+            dfs_detect_cycle(neighbor, path)
+        
+        path.pop()
+        color[node] = 2  # BLACK - done
+    
+    # Check for cycles starting from each node
+    for node in dep_graph:
+        if color[node] == 0:  # WHITE - unvisited
+            dfs_detect_cycle(node, [])
+    
+    # Resolve each dependency in the dynamic default
+    resolved_deps: dict[str, t.Any] = {}
+    
+    for dep_option_name, dep_values_to_targets in dynamic_default.items():
+        # Find the parameter by matching the long option
+        dep_param = None
+        for p in ctx.command.get_params(ctx):
+            if dep_option_name in p.opts:
+                dep_param = p
+                break
+        
+        if dep_param is None:
+            raise UsageError(
+                f"Unknown option in dynamic default: {dep_option_name}"
+            )
+        
+        # Get the resolved value of the dependency
+        dep_value = ctx.params.get(dep_param.name)
+        
+        # Convert boolean values to strings for matching
+        if isinstance(dep_value, bool):
+            dep_str = "True" if dep_value else "False"
+        else:
+            dep_str = str(dep_value) if dep_value is not None else ""
+        
+        resolved_deps[dep_param.name] = (dep_str, dep_value)
+    
+    # Select the target default based on resolved dependency values
+    for dep_option_name, dep_values_to_targets in dynamic_default.items():
+        dep_param = None
+        for p in ctx.command.get_params(ctx):
+            if dep_option_name in p.opts:
+                dep_param = p
+                break
+        
+        if dep_param is None:
+            continue
+            
+        dep_value = ctx.params.get(dep_param.name)
+        
+        # Convert boolean values to strings for matching
+        if isinstance(dep_value, bool):
+            dep_str = "True" if dep_value else "False"
+        else:
+            dep_str = str(dep_value) if dep_value is not None else ""
+        
+        # Look up the target default
+        if dep_str in dep_values_to_targets:
+            return dep_values_to_targets[dep_str], ParameterSource.DEFAULT
+    
+    # No match found - return None
+    return None, ParameterSource.DEFAULT
