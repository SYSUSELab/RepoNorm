+    def with_filters(self, filters: Optional[Dict[str, Callable]]) -> "Prompt":
+        """Return a new Prompt derived from this one with additional/overridden filters.
+
+        The supplied mapping extends the current filters and overrides matching names,
+        without changing the original prompt or other derived prompts. Passing `None`
+        or an empty mapping retains all current filters. Derivation can be chained
+        and works for prompts created by any of the three APIs above.
+
+        Parameters
+        ----------
+        filters : Optional[Dict[str, Callable]]
+            A mapping of filter names to callables to add or override.
+
+        Returns
+        -------
+        Prompt
+            A new Prompt instance with the combined filters.
+        """
+        # Start with existing filters
+        new_filters = dict(self._filters)
+        # Update with new filters (they override existing ones)
+        if filters:
+            new_filters.update(filters)
+        
+        # Re-create the template with combined filters
+        if self._content is not None:
+            new_template = Prompt._template_from_str(self._content, new_filters)
+        elif self._source is not None:
+            new_template = Prompt._template_from_file(self._source, new_filters)
+        else:
+            # Fallback - should not happen normally
+            new_template = self.template
+        
+        # Create a new Prompt with the new template and combined filters
+        return Prompt(new_template, self.signature, new_filters, self._content, self._source)
 
