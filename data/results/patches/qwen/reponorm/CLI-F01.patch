+def test_chained_command_group_file_option_no_resource_warning():
+    """Test that file options in chained command groups don't leave unclosed files."""
+    import warnings
+    import gc
+    
+    cmd1 = Command("cmd1", params=[Option(["--file"], type=File())])
+    cmd2 = Command("cmd2", params=[Option(["--file2"], type=File())])
+    cli = Group("cli", chain=True, commands=[cmd1, cmd2])
+    
+    # Capture warnings
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        
+        # Trigger completion for chained command
+        out = _get_completions(cli, ["cmd1", "--file", "/etc/passwd"], "")
+        
+        # Force garbage collection
+        gc.collect()
+        
+        # Check for ResourceWarnings about unclosed files
+        resource_warnings = [warning for warning in w if issubclass(warning.category, ResourceWarning)]
+        assert len(resource_warnings) == 0, f"Found {len(resource_warnings)} ResourceWarning(s): {[str(w.message) for w in resource_warnings]}"
