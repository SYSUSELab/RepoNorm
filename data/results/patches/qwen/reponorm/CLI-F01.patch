+def test_file_option_no_resource_warning():
+    """Test that file options don't leave unclosed files during completion."""
+    import warnings
+    import gc
+    
+    cli = Command("cli", params=[Option(["--file"], type=File())])
+    
+    # Capture warnings
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        
+        # Trigger completion which would open the file
+        out = _get_completions(cli, ["--file", "/etc/passwd"], "")
+        
+        # Force garbage collection
+        gc.collect()
+        
+        # Check for ResourceWarnings about unclosed files
+        resource_warnings = [warning for warning in w if issubclass(warning.category, ResourceWarning)]
+        assert len(resource_warnings) == 0, f"Found {len(resource_warnings)} ResourceWarning(s): {[str(w.message) for w in resource_warnings]}"
+
