+@pytest.mark.skipif(platform.system() == "Windows", reason="Unix-specific lock behavior")
+def test_edit_lock_files_enabled(runner):
+    """Test that lock_files creates and removes lock file on successful edit."""
+    import os
+    import tempfile
+    
+    with runner.isolated_filesystem():
+        # Create a test file
+        test_file = "test.txt"
+        with open(test_file, "w") as f:
+            f.write("original content\n")
+        
+        # Edit with lock_files enabled using sed (simple editor)
+        result = click.edit(filename=test_file, editor="sed -i 's/original/modified/'", lock_files=True)
+        
+        # Check lock file was created and removed
+        lock_file = f".{os.path.basename(test_file)}.lock"
+        assert not os.path.exists(lock_file), "Lock file should be removed after successful edit"
+        
+        # Check file was modified
+        with open(test_file, "r") as f:
+            content = f.read()
+        assert "modified" in content
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="Unix-specific lock behavior")
+def test_edit_lock_files_concurrent_access(runner):
+    """Test that concurrent access is prevented by lock file."""
+    import os
+    import time
+    
+    with runner.isolated_filesystem():
+        # Create a test file
+        test_file = "concurrent.txt"
+        with open(test_file, "w") as f:
+            f.write("content\n")
+        
+        # Create lock file manually to simulate another process
+        lock_file = f".{os.path.basename(test_file)}.lock"
+        with open(lock_file, "w") as f:
+            f.write(f"PID: 12345\nTime: 2024-01-01T12:00:00\n")
+        
+        # Try to edit - should fail with ClickException
+        from click.exceptions import ClickException
+        with pytest.raises(ClickException) as exc_info:
+            click.edit(filename=test_file, editor="cat", lock_files=True)
+        
+        # Check error message contains lock info
+        assert lock_file in str(exc_info.value)
+        assert "12345" in str(exc_info.value) or "unknown" in str(exc_info.value)
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="Unix-specific lock behavior")
+def test_edit_lock_files_content_format(runner):
+    """Test that lock file has correct format with PID and Time."""
+    import os
+    import time
+    
+    with runner.isolated_filesystem():
+        # Create a test file
+        test_file = "format_test.txt"
+        with open(test_file, "w") as f:
+            f.write("content\n")
+        
+        # Manually create lock file to check format
+        lock_file = f".{os.path.basename(test_file)}.lock"
+        pid = os.getpid()
+        current_time = time.strftime('%Y-%m-%dT%H:%M:%S')
+        
+        # Use O_EXCL to atomically create lock
+        fd = os.open(lock_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(fd, "w") as f:
+            f.write(f"PID: {pid}\n")
+            f.write(f"Time: {current_time}\n")
+        
+        # Read and verify format
+        with open(lock_file, "r") as f:
+            content = f.read()
+        
+        assert f"PID: {pid}" in content
+        assert "Time:" in content
+        
+        # Clean up
+        os.unlink(lock_file)
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="Unix-specific lock behavior")
+def test_edit_lock_files_different_dirs(runner):
+    """Test that same basename in different directories have independent locks."""
+    import os
+    
+    with runner.isolated_filesystem():
+        # Create two directories
+        dir1 = "dir1"
+        dir2 = "dir2"
+        os.makedirs(dir1)
+        os.makedirs(dir2)
+        
+        # Create test files with same name in different dirs
+        file1 = os.path.join(dir1, "test.txt")
+        file2 = os.path.join(dir2, "test.txt")
+        
+        with open(file1, "w") as f:
+            f.write("content1\n")
+        with open(file2, "w") as f:
+            f.write("content2\n")
+        
+        # Create lock for file1
+        lock1 = os.path.join(dir1, ".test.txt.lock")
+        with open(lock1, "w") as f:
+            f.write(f"PID: 11111\nTime: 2024-01-01T12:00:00\n")
+        
+        # Editing file2 should succeed because lock is in different directory
+        result = click.edit(filename=file2, editor="sed -i 's/content2/modified2/'", lock_files=True)
+        
+        # Lock for file1 should still exist
+        assert os.path.exists(lock1)
+        
+        # File2 should be modified
+        with open(file2, "r") as f:
+            content = f.read()
+        assert "modified2" in content
+        
+        # Clean up
+        os.unlink(lock1)
+
