+@pytest.mark.skipif(platform.system() == "Windows", reason="Unix-specific lock behavior")
+def test_edit_lock_files_false_no_locking(runner):
+    """Test that lock_files=False preserves existing behavior (no locking)."""
+    import os
+    with runner.isolated_filesystem():
+        # Create a test file
+        test_file = "no_lock.txt"
+        with open(test_file, "w") as f:
+            f.write("content\n")
+        
+        # Edit with lock_files=False (default)
+        click.edit(filename=test_file, editor="sed -i 's/content/modified/'", lock_files=False)
+        
+        # No lock file should be created
+        lock_file = f".{os.path.basename(test_file)}.lock"
+        assert not os.path.exists(lock_file)
+        
+        # File should be modified
+        with open(test_file, "r") as f:
+            content = f.read()
+        assert "modified" in content
