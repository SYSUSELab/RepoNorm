+@pytest.mark.skipif(platform.system() == "Windows", reason="Unix-specific lock behavior")
+def test_edit_lock_files_nonzero_exit(runner):
+    """Test that lock is removed even when editor exits with nonzero code."""
+    import os
+    from click.exceptions import ClickException
+    
+    with runner.isolated_filesystem():
+        # Create a test file
+        test_file = "nonzero.txt"
+        with open(test_file, "w") as f:
+            f.write("content\n")
+        
+        # Use an editor that always fails
+        with pytest.raises(ClickException):
+            click.edit(filename=test_file, editor="false", lock_files=True)
+        
+        # Lock file should be removed even on failure
+        lock_file = f".{os.path.basename(test_file)}.lock"
+        assert not os.path.exists(lock_file)
+
