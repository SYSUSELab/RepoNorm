index b54e905..09c9c54 100644
--- a/tests/test_ext.py
+++ b/tests/test_ext.py
@@ -465,6 +465,36 @@ class TestInternationalization:
             (3, "npgettext", ("babel", "%(users)s user", "%(users)s users", None), []),
         ]
 
+    def test_trans_with_context(self):
+        """Test trans block with context string literal."""
+        from jinja2.ext import babel_extract
+
+        source = BytesIO(
+            b"""
+            {% trans "fruit" %}Apple{% endtrans %}
+            {% trans "fruit" count=something %}{{ count }} apple{% pluralize %}{{ count }} apples{% endtrans %}
+            """
+        )
+        assert list(babel_extract(source, ("pgettext", "npgettext", "_"), [], {})) == [
+            (2, "pgettext", ("fruit", "Apple"), []),
+            (3, "npgettext", ("fruit", "%(count)s apple", "%(count)s apples", None), []),
+        ]
+
+    def test_trans_without_context(self):
+        """Test that trans without context still uses gettext/ngettext."""
+        from jinja2.ext import babel_extract
+
+        source = BytesIO(
+            b"""
+            {% trans %}Hello World{% endtrans %}
+            {% trans count=something %}{{ count }} user{% pluralize %}{{ count }} users{% endtrans %}
+            """
+        )
+        assert list(babel_extract(source, ("gettext", "ngettext", "_"), [], {})) == [
+            (2, "gettext", "Hello World", []),
+            (3, "ngettext", ("%(count)s user", "%(count)s users", None), []),
+        ]
+
 
