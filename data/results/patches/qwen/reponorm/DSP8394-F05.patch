+def test_large_compressible_response_reduction(tmp_path):
+    """Test that compression measurably reduces storage for large responses."""
+    import gzip
+    
+    # Create a large compressible response
+    large_text = "This is a repeated pattern " * 10000
+    request = {"prompt": "Large response", "model": "test"}
+    
+    # Write with gzip
+    cache_gzip = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=False,
+        disk_cache_dir=str(tmp_path / "gzip"),
+        disk_size_limit_bytes=1024 * 1024,
+        memory_max_entries=0,
+        compress="gzip",
+        cull_limit=None,
+        eviction_policy=None,
+    )
+    
+    cache_gzip.put(request, large_text)
+    
+    # Write without compression
+    cache_none = Cache(
+        enable_disk_cache=True,
+        enable_memory_cache=False,
+        disk_cache_dir=str(tmp_path / "none"),
+        disk_size_limit_bytes=1024 * 1024,
+        memory_max_entries=0,
+        compress=None,
+        cull_limit=None,
+        eviction_policy=None,
+    )
+    
+    cache_none.put(request, large_text)
+    
+    # Compare sizes
+    gzip_dir = tmp_path / "gzip"
+    none_dir = tmp_path / "none"
+    
+    # Count files and estimate total size
+    gzip_files = list(gzip_dir.glob("*"))
+    none_files = list(none_dir.glob("*"))
+    
+    # At least one file should exist in each
+    assert len(gzip_files) >= 1
+    assert len(none_files) >= 1
+    
+    # Gzip should be smaller than uncompressed for compressible data
+    gzip_total = sum(f.stat().st_size for f in gzip_files)
+    none_total = sum(f.stat().st_size for f in none_files)
+    
+    # Allow some margin for overhead
+    assert gzip_total < none_total * 1.5, f"Gzip ({gzip_total}) should be significantly smaller than uncompressed ({none_total})"
