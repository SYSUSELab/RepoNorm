+    def set_translation_version(self, message: str, version: str) -> None:
+        """Set the translation version for a message."""
+        if not hasattr(self, "_translation_versions"):
+            self._translation_versions = {}
+        self._translation_versions[message] = version
+
+    def get_translation_version(self, message: str) -> t.Optional[str]:
+        """Get the translation version for a message. Returns None if unknown."""
+        if not hasattr(self, "_translation_versions"):
+            return None
+        return self._translation_versions.get(message)
+
+    def compare_translation_versions(
+        self, message1: str, message2: str
+    ) -> bool:
+        """Compare translation versions of two messages.
+        
+        Returns True only when both messages are registered and their versions are equal.
+        Either or both missing always returns False.
+        """
+        v1 = self.get_translation_version(message1)
+        v2 = self.get_translation_version(message2)
+        if v1 is None or v2 is None:
+            return False
+        return v1 == v2
+
+    def remove_translation_version(self, message: str) -> None:
+        """Remove the translation version for a message.
+        
+        Is harmless for an unknown message.
+        """
+        if hasattr(self, "_translation_versions"):
+            self._translation_versions.pop(message, None)
+
+    def clear_translation_versions(self) -> None:
+        """Remove all translation versions."""
+        if hasattr(self, "_translation_versions"):
+            self._translation_versions.clear()
+
