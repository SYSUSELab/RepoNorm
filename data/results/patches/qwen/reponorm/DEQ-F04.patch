+def test_is_url():
+    # Basic URL validation
+    assert 'https://example.com' == IsURL()
+    assert 'http://example.com' == IsURL()
+    assert 'ftp://example.com' == IsURL()
+    assert 'not a url' != IsURL()
+    assert 123 != IsURL()
+    assert None != IsURL()
+    assert '' != IsURL()
+    assert 'example.com' != IsURL()  # no protocol
+    assert 'https://' != IsURL()  # no domain
+
+
+def test_is_url_protocol():
+    # Single protocol
+    assert 'https://example.com' == IsURL('https')
+    assert 'http://example.com' != IsURL('https')
+    assert 'HTTPS://example.com' == IsURL('https')  # case insensitive
+    
+    # Protocol collection (list)
+    assert 'https://example.com' == IsURL(['http', 'https'])
+    assert 'http://example.com' == IsURL(['http', 'https'])
+    assert 'ftp://example.com' != IsURL(['http', 'https'])
+    
+    # Protocol collection (tuple)
+    assert 'https://example.com' == IsURL(('http', 'https'))
+    
+    # Protocol collection (set)
+    assert 'https://example.com' == IsURL({'http', 'https'})
+    
+    # Protocol collection (frozenset)
+    assert 'https://example.com' == IsURL(frozenset(['http', 'https']))
+    
+    # Empty protocol collection - should reject all URLs
+    assert 'https://example.com' != IsURL([])
+    assert 'http://example.com' != IsURL(())
+
+
+def test_is_url_domain():
+    # Domain matching against full netloc (including port)
+    assert 'https://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'https://example.com:8080' != IsURL(domain='example.com')
+    assert 'https://example.com' != IsURL(domain='example.com:8080')
+    
+    # No domain specified - any domain is fine
+    assert 'https://example.com' == IsURL(domain=None)
+    assert 'https://other.com' == IsURL(domain=None)
+
+
+def test_is_url_combined():
+    # Combine protocol and domain checks
+    assert 'https://api.example.com/v1' == IsURL('https', 'api.example.com')
+    assert 'http://api.example.com/v1' != IsURL('https', 'api.example.com')
+    assert 'https://other.com/v1' != IsURL('https', 'api.example.com')
+    
+    # Case insensitive protocol, exact domain match
+    assert 'HTTPS://API.EXAMPLE.COM' == IsURL('https', 'API.EXAMPLE.COM')
+
+
+def test_is_url_repr():
+    # Test repr formats as per specification
+    assert repr(IsURL()) == 'IsURL(*)'
+    assert repr(IsURL('https')) == "IsURL('https')"
+    assert repr(IsURL('example.com')) == "IsURL('example.com')"
+    assert repr(IsURL('https', 'example.com')) == "IsURL('https', 'example.com')"
