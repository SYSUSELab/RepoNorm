+class IsURL(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid URL, optionally checking protocol or domain.
+
+    This validator ensures the value is a properly formatted URL with a scheme/protocol
+    and network location (domain). It can optionally restrict which protocols or domains
+    are accepted.
+
+    Args:
+        protocol: Single protocol string or collection of allowed protocols (e.g., 'https', ['http', 'https']).
+                  An empty collection allows no protocol, while None disables filtering.
+        domain: Domain pattern to match against the full network location (including port if present).
+                None disables filtering.
+
+    Examples:
+        ```py title="IsURL"
+        from dirty_equals import IsURL
+
+        assert 'https://example.com' == IsURL()
+        assert 'http://example.com/path' == IsURL()
+        assert 'ftp://files.example.com' == IsURL()
+
+        # Check specific protocol
+        assert 'https://example.com' == IsURL('https')
+        assert 'http://example.com' != IsURL('https')
+        assert 'https://example.com' == IsURL(protocol='https')
+
+        # Check multiple protocols
+        assert 'http://example.com' == IsURL(['http', 'https'])
+        assert 'ftp://example.com' != IsURL(['http', 'https'])
+
+        # Check specific domain (matches full netloc including port)
+        assert 'https://example.com' == IsURL(domain='example.com')
+        assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+        assert 'https://example.com:8080' != IsURL(domain='example.com')
+
+        # Combine protocol and domain checks
+        assert 'https://api.example.com/v1' == IsURL('https', 'api.example.com')
+        ```
+    """
+
+    def __init__(
+        self,
+        protocol: Union[None, str, Collection[str]] = None,
+        domain: Union[None, str] = None,
+    ):
+        """
+        Args:
+            protocol: Single protocol string or collection of allowed protocols.
+                      An empty collection allows no protocol, while None disables filtering.
+            domain: Domain pattern to match against the full network location (including port if present).
+                    None disables filtering.
+        """
+        self.protocol = protocol
+        self.domain = domain
+        
+        # Build repr args based on what was provided
+        repr_args: list[Any] = []
+        
+        if protocol is not None:
+            if isinstance(protocol, str):
+                repr_args.append(protocol)
+            elif len(protocol) == 0:
+                repr_args.append(plain_repr('*'))
+            else:
+                # For collections with content, we still use * for simplicity
+                repr_args.append(plain_repr('*'))
+        else:
+            # No protocol specified - use * to indicate any protocol
+            repr_args.append(plain_repr('*'))
+        
+        if domain is not None:
+            repr_args.append(domain)
+        
+        super().__init__(*repr_args)
+
+    def equals(self, other: Any) -> bool:
+        """Check if the value is a valid URL matching the optional constraints."""
+        if not isinstance(other, str):
+            return False
+        
+        # Parse the URL using urlparse
+        from urllib.parse import urlparse
+        
+        try:
+            parsed = urlparse(other)
+        except Exception:
+            return False
+        
+        # Must have a scheme (protocol)
+        if not parsed.scheme:
+            return False
+        
+        # Must have a netloc (network location/domain)
+        if not parsed.netloc:
+            return False
+        
+        # Check protocol if specified
+        if self.protocol is not None:
+            if isinstance(self.protocol, str):
+                if parsed.scheme.lower() != self.protocol.lower():
+                    return False
+            elif isinstance(self.protocol, (list, tuple, set, frozenset)):
+                if len(self.protocol) == 0:
+                    # Empty collection means no protocol allowed
+                    return False
+                else:
+                    # Check if scheme is in the collection (case-insensitive)
+                    if parsed.scheme.lower() not in [p.lower() for p in self.protocol]:
+                        return False
+        
+        # Check domain if specified
+        if self.domain is not None:
+            # Match against the full netloc (including port)
+            if parsed.netloc != self.domain:
+                return False
+        
+        return True
