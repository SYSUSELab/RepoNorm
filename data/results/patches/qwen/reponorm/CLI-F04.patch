diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..f22b088 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -543,3 +543,151 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+
+# Tests for cleanup_timeout feature
+
+def test_cleanup_timeout_none_default():
+    """Default cleanup_timeout is None (indefinite wait)."""
+    ctx = click.Context(click.Command("test"))
+    assert ctx.cleanup_timeout is None
+
+
+def test_cleanup_timeout_inheritance():
+    """Child context inherits parent's cleanup_timeout when not explicitly set."""
+    parent = click.Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = click.Context(click.Command("child"), parent=parent)
+    assert child.cleanup_timeout == 5.0
+
+
+def test_cleanup_timeout_explicit_override():
+    """Child can override parent's cleanup_timeout with explicit value."""
+    parent = click.Context(click.Command("parent"), cleanup_timeout=5.0)
+    child = click.Context(click.Command("child"), parent=parent, cleanup_timeout=10.0)
+    assert child.cleanup_timeout == 10.0
+
+
+def test_cleanup_timeout_zero_raises_valueerror():
+    """cleanup_timeout=0 raises ValueError."""
+    with pytest.raises(ValueError, match="cleanup_timeout must be positive"):
+        click.Context(click.Command("test"), cleanup_timeout=0)
+
+
+def test_cleanup_timeout_negative_raises_valueerror():
+    """cleanup_timeout < 0 raises ValueError."""
+    with pytest.raises(ValueError, match="cleanup_timeout must be positive"):
+        click.Context(click.Command("test"), cleanup_timeout=-1)
+
+
+def test_cleanup_timeout_positive_valid():
+    """Positive cleanup_timeout values are accepted."""
+    ctx = click.Context(click.Command("test"), cleanup_timeout=1.0)
+    assert ctx.cleanup_timeout == 1.0
+
+
+def test_cleanup_timeout_normal_completion():
+    """Cleanup completes within timeout without error."""
+    called = []
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        def callback():
+            called.append(True)
+        ctx.call_on_close(callback)
+        # Use a short timeout since cleanup is fast
+        ctx.cleanup_timeout = 1.0
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert result.exception is None
+    assert called == [True]
+
+
+def test_cleanup_timeout_with_resource():
+    """with_resource works correctly with cleanup_timeout."""
+    values = []
+
+    @contextmanager
+    def manager():
+        val = [1]
+        yield val
+        val[0] = 0
+        values.append(val[0])
+
+    ctx = click.Context(click.Command("test"), cleanup_timeout=1.0)
+
+    with ctx.scope():
+        rv = ctx.with_resource(manager())
+        assert rv[0] == 1
+
+    assert rv == [0]
+    assert values == [0]
+
+
+def test_cleanup_timeout_repeated_close():
+    """Repeated close calls on same context do not restart earlier cleanup."""
+    call_count = [0]
+
+    ctx = click.Context(click.Command("test"), cleanup_timeout=1.0)
+
+    def callback():
+        call_count[0] += 1
+
+    ctx.call_on_close(callback)
+
+    # First close executes the callback
+    ctx.close()
+    assert call_count[0] == 1
+
+    # Second close should not re-execute callbacks (new exit stack)
+    ctx.close()
+    assert call_count[0] == 1
+
+
+def test_cleanup_timeout_error_reporting():
+    """Errors during cleanup are raised when cleanup completes within timeout."""
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        def failing_callback():
+            raise RuntimeError("cleanup failed")
+        ctx.call_on_close(failing_callback)
+        ctx.cleanup_timeout = 1.0
+
+    runner = click.testing.CliRunner()
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert isinstance(result.exception, RuntimeError)
+    assert str(result.exception) == "cleanup failed"
+
+
+def test_cleanup_timeout_warning_on_timeout():
+    """Warning is issued when cleanup does not complete within timeout."""
+    import io
+    import sys
+
+    slow_called = [False]
+
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.1)
+
+    def slow_callback():
+        slow_called[0] = True
+        # Sleep longer than timeout
+        import time
+        time.sleep(2)
+
+    ctx.call_on_close(slow_callback)
+
+    # Capture stderr
+    old_stderr = sys.stderr
+    sys.stderr = io.StringIO()
+    try:
+        ctx.close()
+        stderr_output = sys.stderr.getvalue()
+    finally:
+        sys.stderr = old_stderr
+
+    # Should have warning in stderr
+    assert "did not complete" in stderr_output or "Warning" in stderr_output
+    # Callback should have been started but not completed
+    assert slow_called[0] is True
