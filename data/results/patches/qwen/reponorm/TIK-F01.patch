diff --git a/tests/test_encoding.py b/tests/test_encoding.py
index f33cf85..d17ce8e 100644
--- a/tests/test_encoding.py
+++ b/tests/test_encoding.py
@@ -254,3 +254,123 @@ def test_hyp_batch_roundtrip(make_enc: Callable[[], tiktoken.Encoding], batch):
     assert encoded == [enc.encode(t) for t in batch]
     decoded = enc.decode_batch(encoded)
     assert decoded == batch
+
+
+# Tests for max_tokens and max_total_tokens budget limits
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_max_tokens_validation(make_enc):
+    """Test that invalid max_tokens values raise ValueError."""
+    enc = make_enc()
+    
+    # Test bool values are rejected
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode("hello", max_tokens=True)
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode("hello", max_tokens=False)
+    
+    # Test non-positive integers are rejected
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode("hello", max_tokens=0)
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode("hello", max_tokens=-1)
+    
+    # Test None is allowed (no limit)
+    result = enc.encode("hello", max_tokens=None)
+    assert len(result) > 0
+    
+    # Test valid positive integer works
+    result = enc.encode("hello", max_tokens=100)
+    assert len(result) > 0
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_max_tokens_per_document_limit(make_enc):
+    """Test that max_tokens limits each document individually."""
+    enc = make_enc()
+    
+    # Test exact equality is accepted
+    text = "hello world"
+    encoded = enc.encode(text)
+    result = enc.encode(text, max_tokens=len(encoded))
+    assert result == encoded
+    
+    # Test over-budget raises error
+    with pytest.raises(ValueError, match="exceeds max_tokens"):
+        enc.encode("hello world", max_tokens=1)
+    
+    # Test empty input with valid limits remains allowed
+    result = enc.encode("", max_tokens=10)
+    assert result == []
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_max_total_tokens_batch_limit(make_enc):
+    """Test that max_total_tokens limits the sum across the batch."""
+    enc = make_enc()
+    
+    # Test exact equality is accepted
+    texts = ["hello", "world"]
+    total_tokens = sum(len(enc.encode(t)) for t in texts)
+    result = enc.encode_batch(texts, max_total_tokens=total_tokens)
+    assert len(result) == 2
+    
+    # Test over-budget raises error
+    with pytest.raises(ValueError, match="exceeds max_total_tokens"):
+        enc.encode_batch(["hello", "world"], max_total_tokens=1)
+    
+    # Test empty batch with valid limits remains allowed
+    result = enc.encode_batch([], max_total_tokens=10)
+    assert result == []
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_encode_batch_max_tokens_validation(make_enc):
+    """Test that invalid max_tokens/max_total_tokens values raise ValueError in encode_batch."""
+    enc = make_enc()
+    
+    # Test bool values are rejected
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode_batch(["hello"], max_tokens=True)
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode_batch(["hello"], max_total_tokens=False)
+    
+    # Test non-positive integers are rejected
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode_batch(["hello"], max_tokens=0)
+    with pytest.raises(ValueError, match="must be a positive integer"):
+        enc.encode_batch(["hello"], max_total_tokens=-1)
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_encode_batch_per_document_violation_first(make_enc):
+    """Test that per-document violations are reported before total violations."""
+    enc = make_enc()
+    
+    # First document exceeds per-document limit
+    with pytest.raises(ValueError, match="Document at index 0.*exceeding max_tokens"):
+        enc.encode_batch(["this is a very long text that exceeds budget", "short"], max_tokens=5)
+    
+    # Second document exceeds per-document limit
+    with pytest.raises(ValueError, match="Document at index 1.*exceeding max_tokens"):
+        enc.encode_batch(["short", "this is a very long text that exceeds budget"], max_tokens=5)
+
+
+@pytest.mark.parametrize("make_enc", ENCODING_FACTORIES)
+def test_encode_batch_combined_limits(make_enc):
+    """Test that both max_tokens and max_total_tokens apply together."""
+    enc = make_enc()
+    
+    # Both limits satisfied
+    texts = ["hello", "world"]
+    result = enc.encode_batch(texts, max_tokens=10, max_total_tokens=100)
+    assert len(result) == 2
+    
+    # Per-document limit violated
+    with pytest.raises(ValueError, match="Document at index 0.*exceeding max_tokens"):
+        enc.encode_batch(["this is a very long text that exceeds budget", "short"], 
+                         max_tokens=5, max_total_tokens=100)
+    
+    # Total limit violated but per-document OK
+    with pytest.raises(ValueError, match="Total tokens.*exceeds max_total_tokens"):
+        enc.encode_batch(["hello", "world"], max_tokens=10, max_total_tokens=1)
