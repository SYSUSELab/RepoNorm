+def _get_effective_weights(tip_weights):
+    """
+    Compute effective weights for tip selection.
+    
+    - Missing keys have weight 1
+    - Unknown keys are ignored
+    - Positive finite integer/float weights are usable
+    - Non-numeric, boolean, nonfinite and nonpositive values have weight zero
+    
+    Returns a dict mapping tip keys to their effective weights.
+    """
+    if tip_weights is None:
+        return {key: 1.0 for key in TIPS}
+    
+    effective_weights = {}
+    for key, value in TIPS.items():
+        if key not in tip_weights:
+            # Missing keys have weight 1
+            effective_weights[key] = 1.0
+        else:
+            weight = tip_weights[key]
+            # Check if weight is valid (positive finite number, but not bool)
+            if isinstance(weight, bool):
+                # Booleans should be treated as invalid (weight 0)
+                effective_weights[key] = 0.0
+            elif isinstance(weight, (int, float)):
+                # Check for finite positive values
+                if math.isfinite(weight) and weight > 0:
+                    effective_weights[key] = float(weight)
+                else:
+                    # Non-positive or infinite values get weight 0
+                    effective_weights[key] = 0.0
+            else:
+                # Non-numeric values get weight 0
+                effective_weights[key] = 0.0
+    
+    return effective_weights
+
+
+def _weighted_choice(rng, items, weights):
+    """
+    Select an item from items using the given weights.
+    
+    - If all weights are zero or sum is zero, use uniform selection
+    - Avoid overflow by normalizing weights before computing cumulative sum
+    
+    Args:
+        rng: Random number generator (must have random() method)
+        items: List of items to choose from
+        weights: List of weights corresponding to items
+        
+    Returns:
+        Selected item
+    """
+    n = len(items)
+    if n == 0:
+        raise ValueError("Cannot select from empty list")
+    
+    # Normalize weights to avoid overflow
+    total_weight = sum(weights)
+    
+    if total_weight == 0:
+        # All weights are zero - use uniform selection
+        idx = int(rng.random() * n)
+        return items[idx]
+    
+    # Generate a random value in [0, total_weight)
+    r = rng.random() * total_weight
+    
+    # Find the selected index by accumulating weights
+    cumulative = 0.0
+    for i, w in enumerate(weights):
+        cumulative += w
+        if r < cumulative:
+            return items[i]
+    
+    # Fallback (should rarely happen due to floating point issues)
+    return items[-1]
+
+
+
