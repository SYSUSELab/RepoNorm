+def test_tip_weights_none():
+    """Test that tip_weights=None uses uniform selection."""
+    prompt_model = DummyLM([{"proposed_instruction": "instruction"}] * 10)
+    program = Predict("question -> answer")
+    trainset = []
+
+    proposer = GroundedProposer(
+        prompt_model=prompt_model, 
+        program=program, 
+        trainset=trainset, 
+        verbose=False,
+        set_tip_randomly=True,
+        tip_weights=None
+    )
+    
+    # Verify tip_weights is stored
+    assert proposer.tip_weights is None
+    
+    result = proposer.propose_instructions_for_program(
+        trainset=trainset, 
+        program=program, 
+        demo_candidates=None, 
+        trial_logs={}, 
+        N=1, 
+        T=0.5
+    )
+    
+    assert isinstance(result, dict)
+    assert len(result) == len(program.predictors())
+
