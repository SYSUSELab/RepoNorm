+@mark_dualiter("items", lambda: [{"foo": 1}, {"foo": 2}, {"foo": 1}])
+def test_groupby_reverse(env_async, items):
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('foo', reverse=True) -%}"
+        "{{ grouper }}:{% for x in list %}{{ x.foo }} {% endfor %}|"
+        "{%- endfor %}"
+    )
+    # Groups should be in descending order
+    assert tmpl.render(items=items).split("|") == ["2:2 ", "1:1 1 ", ""]
+
+
