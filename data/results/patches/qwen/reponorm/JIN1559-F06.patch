+class TestTranslationCache:
+    """Tests for the translation cache functionality."""
+
+    def test_cache_basic(self, env_i18n):
+        """Test basic caching of gettext calls."""
+        call_count = {"gettext": 0}
+
+        def counting_gettext(s):
+            call_count["gettext"] += 1
+            return f"translated_{s}"
+
+        env_i18n.install_gettext_callables(
+            gettext=counting_gettext,
+            ngettext=lambda s, p, n: f"translated_{s}_{n}",
+            cache_size=10,
+        )
+
+        t = env_i18n.from_string('{{ _("hello") }}')
+        
+        # First call should hit the provider
+        result1 = t.render()
+        assert result1 == "translated_hello"
+        assert call_count["gettext"] == 1
+
+        # Second call should be cached
+        result2 = t.render()
+        assert result2 == "translated_hello"
+        assert call_count["gettext"] == 1  # Still 1, cached
+
+    def test_cache_ngettext(self, env_i18n):
+        """Test caching of ngettext calls."""
+        call_count = {"ngettext": 0}
+
+        def counting_ngettext(singular, plural, num):
+            call_count["ngettext"] += 1
+            return f"{singular}_{num}" if num != 1 else singular
+
+        env_i18n.install_gettext_callables(
+            gettext=lambda s: f"t_{s}",
+            ngettext=counting_ngettext,
+            cache_size=10,
+        )
+
+        t = env_i18n.from_string('{{ ngettext("one", "two", 2) }}')
+        
+        # First call
+        result1 = t.render()
+        assert result1 == "one_2"
+        assert call_count["ngettext"] == 1
+
+        # Second call (cached)
+        result2 = t.render()
+        assert result2 == "one_2"
+        assert call_count["ngettext"] == 1
+
+    def test_cache_pgettext(self, env_i18n):
+        """Test caching of pgettext calls."""
+        call_count = {"pgettext": 0}
+
+        def counting_pgettext(context, string):
+            call_count["pgettext"] += 1
+            return f"{context}_{string}"
+
+        env_i18n.install_gettext_callables(
+            gettext=lambda s: f"t_{s}",
+            ngettext=lambda s, p, n: f"n_{s}_{n}",
+            pgettext=counting_pgettext,
+            cache_size=10,
+        )
+
+        t = env_i18n.from_string('{{ pgettext("ctx", "hello") }}')
+        
+        # First call
+        result1 = t.render()
+        assert result1 == "ctx_hello"
+        assert call_count["pgettext"] == 1
+
+        # Second call (cached)
+        result2 = t.render()
+        assert result2 == "ctx_hello"
+        assert call_count["pgettext"] == 1
+
+    def test_cache_npgettext(self, env_i18n):
+        """Test caching of npgettext calls."""
+        call_count = {"npgettext": 0}
+
+        def counting_npgettext(context, singular, plural, num):
+            call_count["npgettext"] += 1
+            return f"{context}_{singular}_{num}" if num != 1 else f"{context}_{singular}"
+
+        env_i18n.install_gettext_callables(
+            gettext=lambda s: f"t_{s}",
+            ngettext=lambda s, p, n: f"n_{s}_{n}",
+            pgettext=lambda c, s: f"p_{c}_{s}",
+            npgettext=counting_npgettext,
+            cache_size=10,
+        )
+
+        t = env_i18n.from_string('{{ npgettext("ctx", "one", "two", 2) }}')
+        
+        # First call
+        result1 = t.render()
+        assert result1 == "ctx_one_2"
+        assert call_count["npgettext"] == 1
+
+        # Second call (cached)
+        result2 = t.render()
+        assert result2 == "ctx_one_2"
+        assert call_count["npgettext"] == 1
+
+    def test_cache_partition_isolation(self, env_i18n):
+        """Test that different partitions have separate cache entries."""
+        call_count = {"gettext": 0}
+
+        def counting_gettext(s):
+            call_count["gettext"] += 1
+            return f"translated_{s}"
+
+        env_i18n.install_gettext_callables(
+            gettext=counting_gettext,
+            ngettext=lambda s, p, n: f"translated_{s}_{n}",
+            cache_size=10,
+        )
+
+        t = env_i18n.from_string('{{ _("hello") }}')
+        
+        # Default partition
+        result1 = t.render()
+        assert call_count["gettext"] == 1
+
