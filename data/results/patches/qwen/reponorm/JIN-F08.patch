+class _GroupTupleWithCount(t.NamedTuple):
+    grouper: t.Any
+    list: t.List
+    count: int
+
+    # Use the regular tuple repr to hide this subclass if users print
+    # out the value during debugging.
+    def __repr__(self) -> str:
+        return tuple.__repr__(self)
+
+    def __str__(self) -> str:
+        return tuple.__str__(self)
+
+
 @pass_environment
 def sync_do_groupby(
     environment: "Environment",
     value: "t.Iterable[V]",
     attribute: t.Union[str, int],
     default: t.Optional[t.Any] = None,
+    with_counts: bool = False,
 ) -> "t.List[t.Tuple[t.Any, t.List[V]]]":
     """Group a sequence of objects by an attribute using Python's
     :func:`itertools.groupby`. The attribute can use dot notation for
@@ -1203,6 +1218,22 @@ def sync_do_groupby(
           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    When ``with_counts=True``, each group is a three-field namedtuple
+    supporting ``(grouper, list, count)`` unpacking/indexing and
+    ``.grouper``, ``.list``, ``.count`` attributes. The ``count`` field
+    records the number of members when the result is created.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for group in users|groupby("city", with_counts=True) %}
+          <li>{{ group.grouper }} ({{ group.count }}):
+            {{ group.list|map(attribute="name")|join(", ") }}
+          </li>
+        {% endfor %}</ul>
+
+    .. versionchanged:: 3.1
+        Added the ``with_counts`` parameter.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,6 +1241,13 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
+    if with_counts:
+        return [
+            _GroupTupleWithCount(key, values_list, len(values_list))
+            for key, values_list in (
+                (key, list(values)) for key, values in groupby(sorted(value, key=expr), expr)
+            )
+        ]
     return [
         _GroupTuple(key, list(values))
         for key, values in groupby(sorted(value, key=expr), expr)
@@ -1222,11 +1260,22 @@ async def do_groupby(
     value: "t.Union[t.AsyncIterable[V], t.Iterable[V]]",
     attribute: t.Union[str, int],
     default: t.Optional[t.Any] = None,
+    with_counts: bool = False,
 ) -> "t.List[t.Tuple[t.Any, t.List[V]]]":
     expr = make_attrgetter(environment, attribute, default=default)
+    # Convert async iterable to list first
+    value_list = await auto_to_list(value)
+    sorted_value = sorted(value_list, key=expr)
+    
+    if with_counts:
+        result = []
+        for key, values in groupby(sorted_value, expr):
+            values_list = await auto_to_list(values)
+            result.append(_GroupTupleWithCount(key, values_list, len(values_list)))
+        return result
     return [
         _GroupTuple(key, await auto_to_list(values))
-        for key, values in groupby(sorted(await auto_to_list(value), key=expr), expr)
