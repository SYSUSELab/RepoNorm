diff --git a/tests/test_filters.py b/tests/test_filters.py
index 43ddf59..bd9a22f 100644
--- a/tests/test_filters.py
+++ b/tests/test_filters.py
@@ -852,3 +852,120 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+
+class TestGroupByWithCounts:
+    """Tests for groupby with_counts parameter."""
+
+    def test_groupby_with_counts_false(self, env):
+        """Test that with_counts=False returns original 2-field tuples."""
+        tmpl = env.from_string(
+            "{% for grouper, items in data|groupby('foo', with_counts=False) %}"
+            "{{ grouper }}:{{ items|length }}|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(data=[
+            {"foo": 1, "bar": 2},
+            {"foo": 2, "bar": 3},
+            {"foo": 1, "bar": 1},
+            {"foo": 3, "bar": 4},
+        ])
+        assert result == "1:2|2:1|3:1|"
+
+    def test_groupby_with_counts_true(self, env):
+        """Test that with_counts=True returns 3-field tuples with count."""
+        tmpl = env.from_string(
+            "{% for group in data|groupby('foo', with_counts=True) %}"
+            "{{ group.grouper }}({{ group.count }})|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(data=[
+            {"foo": 1, "bar": 2},
+            {"foo": 2, "bar": 3},
+            {"foo": 1, "bar": 1},
+            {"foo": 3, "bar": 4},
+        ])
+        assert result == "1(2)|2(1)|3(1)|"
+
+    def test_groupby_with_counts_tuple_unpacking(self, env):
+        """Test tuple unpacking (grouper, list, count)."""
+        tmpl = env.from_string(
+            "{% for grouper, items, count in data|groupby('foo', with_counts=True) %}"
+            "{{ grouper }}({{ count }})|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(data=[
+            {"foo": 1, "bar": 2},
+            {"foo": 2, "bar": 3},
+            {"foo": 1, "bar": 1},
+            {"foo": 3, "bar": 4},
+        ])
+        assert result == "1(2)|2(1)|3(1)|"
+
+    def test_groupby_with_counts_indexing(self, env):
+        """Test indexing [0], [1], [2]."""
+        tmpl = env.from_string(
+            "{% for group in data|groupby('foo', with_counts=True) %}"
+            "{{ group[0] }}({{ group[2] }})|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(data=[
+            {"foo": 1, "bar": 2},
+            {"foo": 2, "bar": 3},
+            {"foo": 1, "bar": 1},
+            {"foo": 3, "bar": 4},
+        ])
+        assert result == "1(2)|2(1)|3(1)|"
+
+    def test_groupby_with_counts_attributes(self, env):
+        """Test .grouper, .list, .count attributes."""
+        tmpl = env.from_string(
+            "{% for group in data|groupby('foo', with_counts=True) %}"
+            "{{ group.grouper }}:{{ group.list|length }}:{{ group.count }}|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(data=[
+            {"foo": 1, "bar": 2},
+            {"foo": 2, "bar": 3},
+            {"foo": 1, "bar": 1},
+            {"foo": 3, "bar": 4},
+        ])
+        assert result == "1:2:2|2:1:1|3:1:1|"
+
+    def test_groupby_with_counts_empty_input(self, env):
+        """Test empty input with with_counts=True."""
+        tmpl = env.from_string(
+            "{% for group in []|groupby('foo', with_counts=True) %}"
+            "{{ group.grouper }}({{ group.count }})|"
+            "{% endfor %}"
+        )
+        result = tmpl.render()
+        assert result == ""
+
+    def test_groupby_with_counts_default_attribute(self, env):
+        """Test default attribute with with_counts=True."""
+        tmpl = env.from_string(
+            "{% for group in users|groupby('city', default='NY', with_counts=True) %}"
+            "{{ group.grouper }}:{{ group.list|map(attribute='name')|join(',') }}|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(users=[
+            {"name": "emma", "city": "NY"},
+            {"name": "smith", "city": "WA"},
+            {"name": "john"},
+        ])
+        assert result == "NY:emma,john|WA:smith|"
+
+    def test_groupby_with_counts_multidot_attribute(self, env):
+        """Test dot notation attribute with with_counts=True."""
+        tmpl = env.from_string(
+            "{% for group in users|groupby('address.city', with_counts=True) %}"
+            "{{ group.grouper }}({{ group.count }})|"
+            "{% endfor %}"
+        )
+        result = tmpl.render(users=[
+            {"name": "emma", "address": {"city": "NY"}},
+            {"name": "john", "address": {"city": "WA"}},
+            {"name": "smith", "address": {"city": "NY"}},
+        ])
+        assert result == "NY(2)|WA(1)|"
