@@ -0,0 +1,226 @@
+"""Test edge cases for dynamic defaults."""
+import click
+from click.testing import CliRunner
+import pytest
+
+
+def test_dynamic_default_basic():
+    """Test basic dynamic default resolution."""
+    @click.command()
+    @click.option("--mode", default="debug")
+    @click.option(
+        "--verbose",
+        default={
+            "--mode": {
+                "debug": True,
+                "release": False,
+            }
+        },
+        show_default=True,
+    )
+    def cmd(mode, verbose):
+        print(f"mode={mode}, verbose={verbose}")
+
+    runner = CliRunner()
+    
+    # Test mode=debug -> verbose=True
+    result = runner.invoke(cmd, ["--mode", "debug"])
+    assert result.exit_code == 0
+    assert "mode=debug, verbose=True" in result.output
+    
+    # Test mode=release -> verbose=False
+    result = runner.invoke(cmd, ["--mode", "release"])
+    assert result.exit_code == 0
+    assert "mode=release, verbose=False" in result.output
+
+
+def test_dynamic_default_explicit_wins():
+    """Test that explicit values override dynamic defaults."""
+    @click.command()
+    @click.option("--mode", default="debug")
+    @click.option(
+        "--verbose",
+        default={
+            "--mode": {
+                "debug": True,
+                "release": False,
+            }
+        },
+    )
+    def cmd(mode, verbose):
+        print(f"mode={mode}, verbose={verbose}")
+
+    runner = CliRunner()
+    
+    # Explicit --verbose=True should win
+    result = runner.invoke(cmd, ["--mode", "release", "--verbose", "True"])
+    assert result.exit_code == 0
+    assert "mode=release, verbose=True" in result.output
+
+
+def test_dynamic_default_envvar_wins():
+    """Test that environment variables override dynamic defaults."""
+    @click.command()
+    @click.option("--mode", default="debug")
+    @click.option(
+        "--verbose",
+        envvar="VERBOSE",  # Explicitly set envvar
+        default={
+            "--mode": {
+                "debug": True,
+                "release": False,
+            }
+        },
+    )
+    def cmd(mode, verbose):
+        print(f"mode={mode}, verbose={verbose}")
+
+    runner = CliRunner()
+    
+    # Environment variable should win
+    result = runner.invoke(cmd, ["--mode", "release"], env={"VERBOSE": "True"})
+    assert result.exit_code == 0
+    assert "mode=release, verbose=True" in result.output
+
+
+def test_dynamic_default_type_casting():
+    """Test that resolved values go through type casting pipeline."""
+    @click.command()
+    @click.option("--count", default=1)
+    @click.option(
+        "--multiplier",
+        default={
+            "--count": {
+                "1": 2,
+                "2": 3,
+                "5": 10,
+            }
+        },
+        type=int,
+    )
+    def cmd(count, multiplier):
+        print(f"count={count}, multiplier={multiplier}")
+
+    runner = CliRunner()
+    
+    result = runner.invoke(cmd, ["--count", "5"])
+    assert result.exit_code == 0
+    assert "count=5, multiplier=10" in result.output
+
+
+def test_dynamic_default_none_value():
+    """Test dynamic default with None as a key."""
+    @click.command()
+    @click.option("--flag", is_flag=True, default=False)
+    @click.option(
+        "--value",
+        default={
+            "--flag": {
+                "True": "enabled",
+                "False": "disabled",
+            }
+        },
+    )
+    def cmd(flag, value):
+        print(f"flag={flag}, value={value}")
+
+    runner = CliRunner()
+    
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 0
+    assert "flag=False, value=disabled" in result.output
+
+
+def test_dynamic_default_help_shows_dynamic():
+    """Test that help shows (dynamic) for dynamic defaults."""
+    @click.command()
+    @click.option("--mode", default="debug")
+    @click.option(
+        "--verbose",
+        default={
+            "--mode": {
+                "debug": True,
+                "release": False,
+            }
+        },
+        show_default=True,
+    )
+    def cmd(mode, verbose):
+        pass
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "(dynamic)" in result.output
+
+
+def test_dynamic_default_unknown_option_error():
+    """Test that unknown options in dynamic default raise UsageError."""
+    @click.command()
+    @click.option(
+        "--verbose",
+        default={
+            "--unknown-option": {
+                "true": True,
+            }
+        },
+    )
+    def cmd(verbose):
+        pass
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, [])
+    assert result.exit_code != 0
+    assert "Unknown option" in result.output
+
+
+def test_dynamic_default_cycle_detection():
+    """Test that cycles in dynamic defaults are detected."""
+    @click.command()
+    @click.option(
+        "--a",
+        default={
+            "--b": {
+                "default": "a_val",
+            }
+        },
+    )
+    @click.option(
+        "--b",
+        default={
+            "--a": {
+                "default": "b_val",
+            }
+        },
+    )
+    def cmd(a, b):
+        print(f"a={a}, b={b}")
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, [])
+    # Cycles should raise UsageError
+    assert result.exit_code != 0
+    assert "cycle" in result.output.lower() or "Cycle" in result.output
+
+
+def test_dynamic_default_non_dict_value_error():
+    """Test that non-dict values in dynamic mapping raise TypeError."""
+    @click.command()
+    @click.option(
+        "--verbose",
+        default={
+            "--mode": "not_a_dict",  # Should be a dict
+        },
+    )
+    def cmd(verbose):
+        pass
+
+    runner = CliRunner()
+    result = runner.invoke(cmd, [])
+    assert result.exit_code != 0
+    assert result.exception is not None
+    assert "must be a dict" in str(result.exception)
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
