+    def _resolve_dynamic_default(
+        self, ctx: Context, raw_default: t.Any, resolving: set | None = None
+    ) -> t.Any:
+        """Resolve a dynamic default dictionary to an actual default value.
+        
+        A dynamic default is a non-empty dict whose keys are full long option
+        names (e.g., "--mode") and values are dicts mapping dependency values
+        to target defaults.
+        """
+        if not isinstance(raw_default, dict):
+            return raw_default
+        
+        if not raw_default:
+            return raw_default
+        
+        # Check if this looks like a dynamic default (keys start with --)
+        has_long_option_keys = any(
+            isinstance(k, str) and k.startswith("--") 
+            for k in raw_default.keys()
+        )
+        
+        if not has_long_option_keys:
+            return raw_default
+        
+        # This is a dynamic default - resolve it
+        if resolving is None:
+            resolving = set()
+        
+        resolved = None
+        for dep_opt, value_map in raw_default.items():
+            if not isinstance(value_map, dict):
+                raise TypeError(
+                    f"Dynamic default mapping for {dep_opt!r} must be a dict, "
+                    f"got {type(value_map).__name__}"
+                )
+            
+            # Get the parameter name from the long option
+            param_name = dep_opt[2:]  # Remove "--" prefix
+            
+            # Find the parameter in the command
+            param = None
+            for p in ctx.command.get_params(ctx):
+                if p.name == param_name:
+                    param = p
+                    break
+            
+            if param is None:
+                raise UsageError(
+                    f"Unknown option {dep_opt!r} referenced in dynamic default"
+                )
+            
+            # Cycle detection: check if we're currently resolving this parameter
+            if param_name in resolving:
+                raise UsageError(
+                    f"Dependency cycle detected involving option {dep_opt!r}"
+                )
+            
+            # Get the current value of the dependency parameter
+            dep_value = ctx.params.get(param_name)
+            
+            # Convert boolean values to string for matching
+            if isinstance(dep_value, bool):
+                dep_value_str = "True" if dep_value else "False"
+            else:
+                dep_value_str = str(dep_value) if dep_value is not None else None
+            
+            # Look up the appropriate default value
+            if dep_value_str in value_map:
+                resolved = value_map[dep_value_str]
+            elif dep_value is None and None in value_map:
+                resolved = value_map[None]
+            
+            # Recursively resolve if the resolved value is also a dynamic default
+            if resolved is not None and isinstance(resolved, dict):
+                new_resolving = resolving | {param_name}
+                resolved = self._resolve_dynamic_default(
+                    ctx, resolved, new_resolving
+                )
+        
+        return resolved
