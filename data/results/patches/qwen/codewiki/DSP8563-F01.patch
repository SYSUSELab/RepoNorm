+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except json.JSONDecodeError:
+                # Non-JSON string - return unchanged
+                return data
+
+        # Handle existing ToolCalls instance (pass through)
+        if isinstance(data, cls):
+            return data
+
+        # Handle bare list
+        if isinstance(data, list):
+            return {"tool_calls": data}
+
+        # Handle single object (dict with name and args keys)
+        if isinstance(data, dict):
