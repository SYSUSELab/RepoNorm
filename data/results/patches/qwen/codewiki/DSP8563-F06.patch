+    @classmethod
+    def model_validate(cls, obj: Any, **kwargs) -> "ToolCalls":
+        """Validate and create a ToolCalls instance from various input formats.
+
+        Supports:
+        - Already validated ToolCalls instances
+        - Dicts with 'tool_calls' key
+        - Single tool call dicts (name + args)
+        - Lists of tool call dicts (including empty lists)
+        - JSON strings (plain or in Markdown code fences)
+        """
+        if isinstance(obj, cls):
+            return obj
+
+        if isinstance(obj, dict):
+            if "tool_calls" in obj:
+                return super().model_validate(obj, **kwargs)
+            if "name" in obj and "args" in obj:
+                return cls(tool_calls=[cls.ToolCall(**obj)])
+
+        if isinstance(obj, list):
+            if len(obj) == 0:
+                return cls(tool_calls=[])
+            first_item = obj[0]
+            if isinstance(first_item, dict) and "name" in first_item and "args" in first_item:
+                tool_calls = [cls.ToolCall(**item) for item in obj]
+                return cls(tool_calls=tool_calls)
