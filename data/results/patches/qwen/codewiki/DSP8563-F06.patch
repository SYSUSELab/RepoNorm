+    @classmethod
+    def _extract_from_markdown_fence(cls, text: str) -> str | None:
+        """Extract content from the first Markdown code fence block."""
+        # Match opening fence: optional whitespace, triple backticks, optional language, newline
+        opening_pattern = r"^\s*```(?:[a-zA-Z_]+)?\n"
+        match = re.match(opening_pattern, text)
+        if not match:
+            return None
+
+        rest = text[match.end():]
+        # Match closing fence: optional whitespace, triple backticks
+        closing_pattern = r"\n\s*```"
+        close_match = re.search(closing_pattern, rest)
+        if not close_match:
+            return None
+
+        content = rest[:close_match.start()].strip()
+        return content
