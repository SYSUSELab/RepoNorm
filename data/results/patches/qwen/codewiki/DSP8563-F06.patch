+            extracted = cls._extract_from_markdown_fence(obj)
+            if extracted is not None:
+                try:
+                    parsed = json_repair.loads(extracted)
+                    return cls.model_validate(parsed, **kwargs)
+                except Exception:
+                    pass
+
+            # Try parsing directly
+            try:
+                parsed = json_repair.loads(obj)
+                return cls.model_validate(parsed, **kwargs)
+            except Exception:
+                pass
+
+        return super().model_validate(obj, **kwargs)
