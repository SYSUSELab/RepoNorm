+def _extract_markdown_fence_content(text):
+    """
+    Extract JSON content from a Markdown code fence block.
+    
+    Supports:
+    - Triple backtick fences with optional language label (json, JSON, or no label)
+    - First fence block only; ignores surrounding prose
+    - Does not treat backticks inside JSON strings as fences
+    
+    Returns the extracted content if found, otherwise None.
+    """
+    if not isinstance(text, str):
+        return None
+    
+    # Pattern matches: opening fence (``` + optional label), newline, content, closing fence
+    # The label can be any characters except newline, followed by newline
+    pattern = r"^\s*```(?:json|JSON)?\s*\n(.*?)^\s*```\s*$"
+    match = re.search(pattern, text, re.MULTILINE | re.DOTALL)
+    if match:
+        return match.group(1).strip()
+    return None
+
