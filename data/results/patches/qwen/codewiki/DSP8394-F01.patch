+class _BypassState:
+    """Thread-local storage for bypass state."""
+    
+    def __init__(self):
+        self._local = threading.local()
+    
+    def get_bypass_stack(self) -> List[bool]:
+        """Get the bypass stack for the current thread."""
+        if not hasattr(self._local, 'bypass_stack'):
+            self._local.bypass_stack = []
+        return self._local.bypass_stack
+    
+    def is_bypassed(self) -> bool:
+        """Check if bypass is active in the current thread."""
+        return len(self.get_bypass_stack()) > 0
+    
+    def push_bypass(self):
+        """Push a new bypass level."""
+        self.get_bypass_stack().append(True)
+    
+    def pop_bypass(self):
+        """Pop the top bypass level."""
+        if self.get_bypass_stack():
+            self.get_bypass_stack().pop()
+
+
+# Global bypass state registry - maps Cache instances to their bypass states
+_bypass_states: dict = {}
+_bypass_lock = threading.Lock()
+
+
+def _get_or_create_bypass_state(cache: "Cache") -> _BypassState:
+    """Get or create a bypass state for a cache instance."""
+    with _bypass_lock:
+        if id(cache) not in _bypass_states:
+            _bypass_states[id(cache)] = _BypassState()
+        return _bypass_states[id(cache)]
+
