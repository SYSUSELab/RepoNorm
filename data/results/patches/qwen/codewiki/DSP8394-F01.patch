+    @contextmanager
+    def bypass(self):
+        """Context manager to temporarily bypass cache reads while retaining writes.
+        
+        Within this context, cache reads behave as cache misses even when a value is stored.
+        Writes remain enabled according to the existing memory/disk configuration.
+        After the context ends, newly written values can be read normally.
+        
+        Nested contexts retain bypass until their outer context exits.
+        Normal and exceptional exits restore the previous state.
+        Bypass is local to the current thread/asynchronous execution context.
+        
+        Example:
+            >>> with dspy.cache.bypass():
+            ...     result = cache.get(request)  # Always returns None (cache miss)
+            ...     cache.put(request, value)    # Write still works
+        """
+        self._bypass_state.push_bypass()
+        try:
+            yield
+        finally:
+            self._bypass_state.pop_bypass()
