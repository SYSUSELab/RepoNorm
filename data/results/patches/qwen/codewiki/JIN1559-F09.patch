diff --git a/src/jinja2/ext.py b/src/jinja2/ext.py
index d21b83a..b037799 100644
--- a/src/jinja2/ext.py
+++ b/src/jinja2/ext.py
@@ -852,3 +852,92 @@ i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+
+
+class TranslationExtractorExtension(Extension):
+    """This extension adds support for extracting marked translations from templates.
+
+    The extension provides a ``{% extract key=constant, ... %}...{% endextract %}`` tag
+    that allows marking specific sections of a template for translation extraction.
+    Metadata values must be compile-time constants; dynamic expressions and duplicate
+    keys raise :exc:`TemplateSyntaxError` naming the key. Marker bodies are ordinary Jinja
+    bodies and render unchanged. They may contain control structures and any gettext
+    calls supported by normal extraction.
+    """
+
+    tags = {"extract"}
+
+    def __init__(self, environment):
+        self.environment = environment
+
+    def parse(self, parser):
+        """Parse an extract block."""
+        lineno = next(parser.stream).lineno
+
+        # Parse metadata key-value pairs
+        metadata: t.Dict[str, t.Any] = {}
+        while parser.stream.current.type != "block_end":
+            # Check if we've reached the end of arguments
+            if parser.stream.current.test("name:endextract"):
+                break
+
+            token = parser.stream.expect("name")
+
+            if token.value in metadata:
+                parser.fail(
+                    f"Duplicate key {token.value!r} in extract block",
+                    token.lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            # Expect equals sign
+            parser.stream.expect("assign")
+
+            # Parse value - must be a constant
+            value_node = parser.parse_expression()
+
+            # Check if it's a constant (compile-time literal)
+            if isinstance(value_node, nodes.Const):
+                metadata[token.value] = value_node.value
+            else:
+                parser.fail(
+                    f"Metadata value for key {token.value!r} must be a compile-time constant",
+                    token.lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            # Expect comma or end of arguments
+            if not parser.stream.skip_if("comma"):
+                break
+
+        parser.stream.expect("block_end")
+
+        # Parse the body of the extract block using subparse
+        # This handles data, variables, and nested blocks properly
+        body = parser.subparse(("name:endextract",))
+        # Consume the endextract token
+        parser.stream.expect("name:endextract")
+
+        # Create a node that wraps the body with metadata
+        extract_node = ExtractNode(body, metadata, lineno=lineno)
+
+        return [extract_node]
+
+
+class ExtractNode(nodes.Node):
+    """A node representing an extract block."""
+
+    fields = ("body", "metadata")
+    body: t.List[nodes.Node]
+    metadata: t.Dict[str, t.Any]
+
+    def __init__(
+        self,
+        body: t.List[nodes.Node],
+        metadata: t.Dict[str, t.Any],
+        lineno: t.Optional[int] = None,
+    ):
+        super().__init__()
+        self.body = body
+        self.metadata = metadata
+        self.lineno = lineno
