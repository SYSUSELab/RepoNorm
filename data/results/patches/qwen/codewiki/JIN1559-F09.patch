@@ -1114,6 +1114,85 @@ class Environment:
 
         return ChainMap(d, self.globals)
 
+    def extract_marked_translations(
+        self, source: t.Union[str, nodes.Template], source_name: t.Optional[str] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract marked translations from a template source string or AST.
+
+        This method parses a string or accepts a parsed template and yields independent
+        record mappings. Each record has ``source``, marker ``lineno``, a copied
+        ``metadata`` mapping, and ``messages``. Each message contains its ``lineno``,
+        gettext ``function``, and extracted ``message``. Nested gettext calls in the
+        marker body are associated with that record.
+
+        Extraction retains no records between calls or template compilations, so
+        recompiling a source cannot accumulate stale markers. Repeated calls are stable
+        and callers may mutate returned records. Ordinary rendering, ``extract_translations``,
+        and Babel translator comments continue independently.
+
+        :param source: Jinja source to parse or an already parsed template.
+        :param source_name: Optional name for the source being processed.
+        :return: Iterator of record dictionaries with extraction results.
+
+        .. versionadded:: 3.2
+        """
+        if isinstance(source, str):
+            ast = self.parse(source)
+        else:
+            ast = source
+
+        # Find all ExtractNode instances in the AST
+        for node in ast.find_all(nodes.Node):
+            if type(node).__name__ == "ExtractNode":
+                # Extract messages from the body of this extract block
+                from .ext import extract_from_ast
+                messages = list(extract_from_ast(node))
+                
+                yield {
+                    "source": source_name,
+                    "lineno": node.lineno,
+                    "metadata": dict(node.metadata),
+                    "messages": messages,
+                }
+
+    def extract_marked_translations_from_templates(
+        self, names: t.Optional[t.Iterable[str]] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract marked translations from templates supplied by the configured loader.
+
+        This method yields the same records as ``extract_marked_translations`` for
+        templates supplied by the configured loader. The ``names`` parameter is a
+        finite iterable of logical template names, processed in its iteration order;
+        when omitted, process all listed templates. Each record's ``source`` is the
+        logical name being processed. This operation extracts source without rendering
+        templates or recursively following includes or inheritance.
+
+        :param names: Iterable of template names to process, or None to process all.
+        :return: Iterator of record dictionaries with extraction results.
+
+        .. versionadded:: 3.2
+        """
+        assert self.loader is not None, "No loader configured."
+
+        if names is None:
+            try:
+                names = self.loader.list_templates()
+            except TypeError:
+                raise RuntimeError(
+                    "Cannot extract from templates: loader does not support listing templates"
+                )
+
+        for name in names:
+            try:
+                source = self.loader.get_source(self, name)
+                if isinstance(source, tuple):
+                    source_str = source[0]
+                else:
+                    source_str = source
+                yield from self.extract_marked_translations(source_str, source_name=name)
+            except Exception:
+                # Skip templates that can't be loaded
+                pass
 
