+def _report_pending_cleanup_errors() -> None:
+    """Report any cleanup errors that occurred after timeout."""
+    remaining = []
+    for thread, cleanup_error in _pending_cleanup_errors:
+        if thread.is_alive():
+            remaining.append((thread, cleanup_error))
