+def _get_process_priority(priority: str | None) -> int | None:
+    """Map process priority names to platform-specific values.
+    
+    Returns a tuple of (nice_value, creationflags) where:
+    - nice_value is for Unix-like systems (lower = higher priority)
+    - creationflags is for Windows (bitmask of priority class flags)
+    
+    Returns None if no priority should be set.
+    Raises ValueError for invalid priority values.
+    """
+    if priority is None:
+        return None
+    
+    # Define priority mappings
+    # Order from least to most favored: low < below_normal < normal < above_normal < high
+    PRIORITY_MAP = {
+        "low": {"unix_nice": 10, "win_flags": 0x00000080},  # CREATE_LOW_PRIORITY_CLASS
+        "below_normal": {"unix_nice": 5, "win_flags": 0x00000040},  # CREATE BELOW NORMAL
+        "normal": {"unix_nice": 0, "win_flags": 0x00000020},  # CREATE_NORMAL_PRIORITY_CLASS
+        "above_normal": {"unix_nice": -5, "win_flags": 0x00000080},  # CREATE_ABOVE_NORMAL_PRIORITY_CLASS
+        "high": {"unix_nice": -10, "win_flags": 0x00000080},  # CREATE_HIGH_PRIORITY_CLASS
+    }
+    
+    # Note: The actual Windows constants are defined in os module on Windows
+    # We'll use numeric values that correspond to those constants
+    
+    if priority not in PRIORITY_MAP:
+        raise ValueError(
+            f"Invalid process_priority: {priority!r}. "
+            f"Must be None, 'low', 'below_normal', 'normal', 'above_normal', or 'high'."
+        )
+    
+    mapping = PRIORITY_MAP[priority]
+    
+    # For Unix-like systems, we return the nice value
+    # For Windows, we return the creationflags
+    # The caller will handle platform-specific application
+    
+    return mapping["unix_nice"]
+
+
+def _apply_process_priority(priority: str | None) -> t.Callable[[], None] | None:
+    """Create a preexec_fn for Unix-like systems to set process priority.
+    
+    Returns a callable to be used as preexec_fn in subprocess.Popen,
+    or None if no priority should be set.
+    """
+    if priority is None:
+        return None
+    
+    try:
+        nice_value = _get_process_priority(priority)
+    except ValueError:
+        return None
+    
+    def set_priority() -> None:
+        try:
+            os.nice(nice_value)
+        except (OSError, PermissionError):
+            # If we can't set the priority, just continue with default
+            pass
+    
+    return set_priority
+
