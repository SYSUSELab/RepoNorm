+    def tick(self, now_ts: float | None = None) -> StreamResponse | None:
+        """Check if the stream has exceeded the idle timeout.
+
+        Args:
+            now_ts: Optional timestamp to use for timeout checking. If None, uses self.clock().
+
+        Returns:
+            StreamResponse with empty chunk if timeout has been exceeded, None otherwise.
+            After returning a timeout response, clears per-stream boundary/cache state to prevent duplicates.
+        """
+        if self.idle_timeout_s is None:
+            return None
+
+        if self.last_activity_time is None:
+            return None
+
+        current_time = now_ts if now_ts is not None else self.clock()
+        elapsed = current_time - self.last_activity_time
+
+        if elapsed >= self.idle_timeout_s:
+            # Return timeout response with empty chunk
+            result = StreamResponse(self.predict_name, self.signature_field_name, "")
+            # Clear state to prevent duplicate emissions
+            self._clear_state()
+            return result
+
+        return None
