diff --git a/test_filter_tokens.py b/test_filter_tokens.py
new file mode 100644
index 0000000..6c16bcf
--- /dev/null
+++ b/test_filter_tokens.py
@@ -0,0 +1,61 @@
+import numpy as np
+import tiktoken
+
+# Test basic functionality
+enc = tiktoken.get_encoding("gpt2")
+
+# Test 1: No filtering (default)
+result_list = enc.encode("hello world")
+print(f"Test 1 - No filter: {result_list}")
+
+# Test 2: Filter with list
+result_filtered = enc.encode("hello world", filter_tokens=[995])
+print(f"Test 2 - Filter [995]: {result_filtered}")
+
+# Test 3: Filter with tuple
+result_filtered_tuple = enc.encode("hello world", filter_tokens=(995,))
+print(f"Test 3 - Filter (995,): {result_filtered_tuple}")
+
+# Test 4: Filter with set
+result_filtered_set = enc.encode("hello world", filter_tokens={995})
+print(f"Test 4 - Filter {{995}}: {result_filtered_set}")
+
+# Test 5: Empty filter should do nothing
+result_empty_filter = enc.encode("hello world", filter_tokens=[])
+print(f"Test 5 - Empty filter: {result_empty_filter}")
+
+# Test 6: NumPy encode without filter
+np_result = enc.encode_to_numpy("hello world")
+print(f"Test 6 - NumPy no filter: {np_result}, dtype: {np_result.dtype}, shape: {np_result.shape}")
+
+# Test 7: NumPy encode with filter
+np_filtered = enc.encode_to_numpy("hello world", filter_tokens=[995])
+print(f"Test 7 - NumPy filter [995]: {np_filtered}, dtype: {np_filtered.dtype}, shape: {np_filtered.shape}")
+
+# Test 8: Verify list and numpy match
+list_result = enc.encode("hello world", filter_tokens=[995])
+numpy_result = enc.encode_to_numpy("hello world", filter_tokens=[995])
+print(f"Test 8 - Match: {list(list(numpy_result)) == list_result}")
+
+# Test 9: All tokens filtered
+all_filtered = enc.encode("hello world", filter_tokens=[31373, 995])
+print(f"Test 9 - All filtered: {all_filtered}")
+
+# Test 10: NumPy all filtered
+all_filtered_np = enc.encode_to_numpy("hello world", filter_tokens=[31373, 995])
+print(f"Test 10 - NumPy all filtered: {all_filtered_np}, dtype: {all_filtered_np.dtype}, shape: {all_filtered_np.shape}")
+
+# Test 11: Disallowed special token should raise BEFORE filtering
+try:
+    enc.encode("<|endoftext|>", disallowed_special="all", filter_tokens=[50256])
+    print("Test 11 - FAILED: Should have raised")
+except ValueError as e:
+    print(f"Test 11 - Correctly raised: {e}")
+
+# Test 12: Caller collection not mutated
+caller_list = [995]
+original = caller_list.copy()
+enc.encode("hello world", filter_tokens=caller_list)
+print(f"Test 12 - Caller not mutated: {caller_list == original}")
+
+print("\nAll tests completed!")
diff --git a/test_filter_tokens_extended.py b/test_filter_tokens_extended.py
new file mode 100644
index 0000000..017db35
--- /dev/null
+++ b/test_filter_tokens_extended.py
@@ -0,0 +1,111 @@
+import numpy as np
+import tiktoken
+
+enc = tiktoken.get_encoding("gpt2")
+
+# Test 1: Duplicates in filter_tokens should have no extra effect
+result = enc.encode("hello world", filter_tokens=[995, 995])
+print(f"Test 1 - Duplicates: {result}")
+assert result == [31373], f"Expected [31373], got {result}"
+
+# Test 2: Order preservation - check that remaining tokens keep their original order
+text = "hello world hello"
+result = enc.encode(text, filter_tokens=[995])
+print(f"Test 2 - Order: {result}")
+# Should preserve order of remaining tokens (first and third token)
+
+# Test 3: Multiple tokens filtered
+result = enc.encode("hello world test", filter_tokens=[995, 31373])
+print(f"Test 3 - Multiple filters: {result}")
+
+# Test 4: Disallowed special token raises BEFORE filtering
+try:
+    enc.encode("<|endoftext|>", disallowed_special="all", filter_tokens=[50256])
+    print("Test 4 - FAILED: Should have raised")
+except ValueError:
+    print("Test 4 - Correctly raised before filtering")
+
+# Test 5: With disallowed_special=(), special token is encoded then can be filtered
+result = enc.encode("<|endoftext|>", disallowed_special=(), filter_tokens=[27, 91, 437, 1659, 5239, 91, 29])
+print(f"Test 5 - Special token filtered: {result}")
+assert result == [], f"Expected [], got {result}"
+
+# Test 6: NumPy matches list for various cases
+test_cases = [
+    ("hello world", []),
+    ("hello world", [995]),
+    ("hello world", [31373]),
+    ("hello world", [31373, 995]),
+    ("", []),
+]
+
+for text, filter_list in test_cases:
+    list_result = enc.encode(text, filter_tokens=filter_list)
+    numpy_result = enc.encode_to_numpy(text, filter_tokens=filter_list)
+    assert list(numpy_result) == list_result, f"Mismatch for {text}, {filter_list}: {list(numpy_result)} vs {list_result}"
+    print(f"Test 6 - Match for '{text}' with filter {filter_list}: OK")
+
+# Test 7: Empty string
+result = enc.encode("", filter_tokens=[995])
+print(f"Test 7 - Empty string: {result}")
+assert result == [], f"Expected [], got {result}"
+
+# Test 8: NumPy empty string
+result_np = enc.encode_to_numpy("", filter_tokens=[995])
+print(f"Test 8 - NumPy empty string: {result_np}, shape: {result_np.shape}")
+assert result_np.shape == (0,), f"Expected shape (0,), got {result_np.shape}"
+
+# Test 9: Non-existent token in filter (should not affect anything)
+result = enc.encode("hello world", filter_tokens=[999999])
+print(f"Test 9 - Non-existent filter: {result}")
+assert result == [31373, 995], f"Expected [31373], got {result}"
+
+# Test 10: Large filter set
+large_filter = list(range(1000))
+result = enc.encode("hello world", filter_tokens=large_filter)
+print(f"Test 10 - Large filter: {result}")
+assert result == [31373], f"Expected [31373], got {result}"
+
+# Test 11: Set input type
+result = enc.encode("hello world", filter_tokens={995})
+print(f"Test 11 - Set input: {result}")
+assert result == [31373], f"Expected [31373], got {result}"
+
+# Test 12: Tuple input type
+result = enc.encode("hello world", filter_tokens=(995,))
+print(f"Test 12 - Tuple input: {result}")
+assert result == [31373], f"Expected [31373], got {result}"
+
+# Test 13: Verify caller collection not mutated
+caller_list = [995, 995]
+original = caller_list.copy()
+enc.encode("hello world", filter_tokens=caller_list)
+assert caller_list == original, f"Caller was mutated: {caller_list} != {original}"
+print("Test 13 - Caller not mutated: OK")
+
+# Test 14: Verify caller set not mutated
+caller_set = {995}
+original_set = frozenset(caller_set)
+enc.encode("hello world", filter_tokens=caller_set)
+assert frozenset(caller_set) == original_set, f"Caller was mutated"
+print("Test 14 - Caller set not mutated: OK")
+
+# Test 15: Verify caller tuple not mutated
+caller_tuple = (995,)
+original_tuple = caller_tuple
+enc.encode("hello world", filter_tokens=caller_tuple)
+assert caller_tuple == original_tuple, f"Caller was mutated"
+print("Test 15 - Caller tuple not mutated: OK")
+
+# Test 16: Filter with allowed_special
+result = enc.encode("<|endoftext|>", disallowed_special=(), filter_tokens=[27, 91, 437, 1659, 5239, 91, 29])
+print(f"Test 16 - Filter with allowed_special: {result}")
+assert result == [], f"Expected [], got {result}"
+
+# Test 17: NumPy all filtered returns empty array with correct dtype
+result_np = enc.encode_to_numpy("hello world", filter_tokens=[31373, 995])
+print(f"Test 17 - NumPy all filtered: {result_np}, dtype: {result_np.dtype}, shape: {result_np.shape}")
+assert result_np.dtype == np.uint32, f"Expected uint32, got {result_np.dtype}"
+assert result_np.shape == (0,), f"Expected shape (0,), got {result_np.shape}"
+
+print("\nAll extended tests passed!")
