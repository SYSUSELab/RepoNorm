diff --git a/src/click/core.py b/src/click/core.py
index 666ad68..6297d26 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -280,6 +280,7 @@ class Context:
         token_normalize_func: t.Callable[[str], str] | None = None,
         color: bool | None = None,
         show_default: bool | None = None,
+        validate_nesting: bool = False,
     ) -> None:
         #: the parent context or `None` if none exists.
         self.parent = parent
@@ -287,6 +288,12 @@ class Context:
         self.command = command
         #: the descriptive information name
         self.info_name = info_name
+        #: If True, validate that child contexts are closed before closing
+        #: this context. Defaults to False unless a parent has it enabled.
+        if validate_nesting or (parent is not None and parent.validate_nesting):
+            self.validate_nesting = True
+        else:
+            self.validate_nesting = False
         #: Map of parameter names to their parsed values. Parameters
         #: with ``expose_value=False`` are not stored.
         self.params: dict[str, t.Any] = {}
@@ -431,6 +438,7 @@ class Context:
         self._depth = 0
         self._parameter_source: dict[str, ParameterSource] = {}
         self._exit_stack = ExitStack()
+        self._children: set[Context] = set()
 
     @property
     def protected_args(self) -> list[str]:
@@ -468,6 +476,10 @@ class Context:
     def __enter__(self) -> Context:
         self._depth += 1
         push_context(self)
+        
+        # Register this context as a child of its parent if validation is enabled
+        if self.parent is not None and self.parent.validate_nesting:
+            self.parent._children.add(self)
         return self
 
     def __exit__(
@@ -478,6 +490,9 @@ class Context:
     ) -> None:
         self._depth -= 1
         if self._depth == 0:
+            # Remove from parent's children before closing
+            if self.parent is not None:
+                self.parent._children.discard(self)
             self.close()
         pop_context()
 
@@ -607,6 +622,18 @@ class Context:
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
         """
+        # Validate nesting if enabled
+        if self.validate_nesting and self._children:
+            child_names = [child.info_name or "unnamed" for child in self._children]
+            raise RuntimeError(
+                f"Cannot close context '{self.info_name}' while child contexts "
+                f"are still open: {', '.join(child_names)}"
+            )
+        
+        # Remove self from parent's children before closing
+        if self.parent is not None:
+            self.parent._children.discard(self)
+        
         self._exit_stack.close()
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
