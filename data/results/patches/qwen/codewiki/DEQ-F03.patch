+# Email validation patterns
+# Local part: ASCII letters/digits and `_ % + -`, with dots only between nonempty runs
+_LOCAL_PART_PATTERN = r'[A-Za-z0-9_%+]+(?:\.[A-Za-z0-9_%+]+)*'
+
+# Domain labels: ASCII letters/digits and internal hyphens; cannot start or end with hyphen
+_DOMAIN_LABEL_PATTERN = r'[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?'
+
+# Final label must be at least 2 ASCII letters
+_FINAL_LABEL_PATTERN = r'[A-Za-z]{2,}'
+
+# Full email pattern
+_EMAIL_PATTERN = f'^{_LOCAL_PART_PATTERN}@{_DOMAIN_LABEL_PATTERN}(?:\\.{_DOMAIN_LABEL_PATTERN})*(?:\\.{_FINAL_LABEL_PATTERN})$'
+
+
+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address.
+
+    The email grammar is deliberately finite, not full RFC email syntax:
+    - Local part uses ASCII letters/digits and `_ % + -`, with dots only between nonempty runs
+      (no leading, trailing or consecutive dots).
+    - Domain labels use ASCII letters/digits and internal hyphens; labels are nonempty and
+      cannot start or end with a hyphen.
+    - There are at least two labels and the final label consists of at least two ASCII letters.
+    - Match the entire string without trimming whitespace.
+
+    Args:
+        domain: Optional domain filter. If provided, the email's domain must match exactly
+            (case-sensitive). A subdomain is not an implicit match.
+
+    Examples:
+    ```py title="IsEmail"
+    from dirty_equals import IsEmail
+
+    assert 'test@example.com' == IsEmail()
+    assert 'test.email+tag@domain.co.uk' == IsEmail()
+    assert 'user_name@sub.domain.org' == IsEmail()
+
+    # Reject invalid emails
+    assert 'notanemail' != IsEmail()
+    assert '@nodomain.com' != IsEmail()
+    assert 'nolocal@' != IsEmail()
+    assert 'leading.dot@test.com' != IsEmail()
+    assert 'trailing.dot@test.com' != IsEmail()
+    assert 'consecutive..dots@test.com' != IsEmail()
+    assert 123 != IsEmail()
+    assert None != IsEmail()
+
+    # Domain filter
+    assert 'test@example.com' == IsEmail('example.com')
+    assert 'test@example.com' != IsEmail('other.com')
+    assert 'test@sub.example.com' != IsEmail('example.com')  # subdomain is not a match
+    assert 'TEST@example.com' != IsEmail('example.com')  # case sensitive
+    ```
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        self.domain = domain
+        super().__init__(plain_repr('*') if domain is None else domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check basic email format
+        if not re.fullmatch(_EMAIL_PATTERN, other):
+            return False
+
+        # If domain filter is provided, check it matches exactly
+        if self.domain is not None:
+            # Extract domain from email (everything after @)
+            _, email_domain = other.rsplit('@', 1)
+            if email_domain != self.domain:
+                return False
+
+        return True
