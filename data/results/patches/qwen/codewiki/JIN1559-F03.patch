+import re
+
+# Read the original file
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# 1. Add priority_gettext and priority_ngettext to _install_callables signature
+old_install_callables_sig = '''    def _install_callables(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+    ) -\u003e None:'''
+
+new_install_callables_sig = '''    def _install_callables(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        priority_gettext: t.Optional[t.Callable[[str, int], str]] = None,
+        priority_ngettext: t.Optional[t.Callable[[str, str, int, int], str]] = None,
+    ) -\u003e None:'''
+
+content = content.replace(old_install_callables_sig, new_install_callables_sig)
+
+# 2. Update _install_callables body to store priority callables
+old_install_body = '''        self.environment.globals.update(
+            gettext=gettext, ngettext=ngettext, pgettext=pgettext, npgettext=npgettext
+        )'''
+
+new_install_body = '''        self.environment.globals.update(
+            gettext=gettext, ngettext=ngettext, pgettext=pgettext, npgettext=npgettext
+        )
+        if priority_gettext is not None:
+            self.environment.priority_gettext = priority_gettext
+        else:
+            self.environment.priority_gettext = None
+        if priority_ngettext is not None:
+            self.environment.priority_ngettext = priority_ngettext
+        else:
+            self.environment.priority_ngettext = None'''
+
+content = content.replace(old_install_body, new_install_body)
+
+# Write the modified file
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
+
+print("Patch applied successfully!")
