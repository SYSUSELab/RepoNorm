+import re
+
+# Read the original file
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# 1. Add priority variable initialization and handling in parse method
+old_parse_init = '''    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a translatable tag."""
+        lineno = next(parser.stream).lineno
+        num_called_num = False
+
+        # find all the variables referenced.  Additionally a variable can be
+        # defined in the body of the trans block too, but this is checked at
+        # a later state.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None'''
+
+new_parse_init = '''    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a translatable tag."""
+        lineno = next(parser.stream).lineno
+        num_called_num = False
+
+        # find all the variables referenced.  Additionally a variable can be
+        # defined in the body of the trans block too, but this is checked at
+        # a later state.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        priority: t.Optional[nodes.Expr] = None'''
+
+content = content.replace(old_parse_init, new_parse_init)
+
+# 2. Add priority handling in the while loop (after trimmed handling)
+old_trimmed_handling = '''            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")'''
+
+new_trimmed_handling = '''            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            elif token.value == "priority":
+                if priority is not None:
+                    parser.fail(
+                        "translatable tag has duplicate priority",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                next(parser.stream)
+                priority = parser.parse_expression()
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")'''
+
+content = content.replace(old_trimmed_handling, new_trimmed_handling)
+
+# 3. Update _make_node call to include priority
+old_make_node_call = '''        node = self._make_node(
+            singular,
+            plural,
+            variables,
+            plural_expr,
+            bool(referenced),
+            num_called_num and have_plural,
+        )'''
+
+new_make_node_call = '''        node = self._make_node(
+            singular,
+            plural,
+            variables,
+            plural_expr,
+            bool(referenced),
+            num_called_num and have_plural,
+            priority,
+        )'''
+
+content = content.replace(old_make_node_call, new_make_node_call)
+
+# Write the modified file
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
+
+print("Patch applied successfully!")
