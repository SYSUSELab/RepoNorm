+import re
+
+# Read the original file
+with open('src/jinja2/ext.py', 'r') as f:
+    content = f.read()
+
+# 1. Update _make_node signature to include priority parameter
+old_make_node_sig = '''    def _make_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+    ) -> nodes.Output:'''
+
+new_make_node_sig = '''    def _make_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+        priority: t.Optional[nodes.Expr] = None,
+    ) -> nodes.Output:'''
+
+content = content.replace(old_make_node_sig, new_make_node_sig)
+
+# 2. Replace the entire _make_node body with priority-aware implementation
+old_make_node_body = '''    def _make_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+    ) -> nodes.Output:
+        """Generates a useful node from the data provided."""
+        newstyle = self.environment.newstyle_gettext  # type: ignore
+        node: nodes.Expr
+
+        # no variables referenced?  no need to escape for old style
+        # gettext invocations only if there are vars.
+        if not vars_referenced and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(
+                    node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+        return nodes.Output([node])'''
+
+new_make_node_body = '''    def _make_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+        priority: t.Optional[nodes.Expr] = None,
+    ) -> nodes.Output:
+        """Generates a useful node from the data provided."""
+        newstyle = self.environment.newstyle_gettext  # type: ignore
+        
+        # Check if priority resolvers are installed
+        has_priority_resolvers = (
+            getattr(self.environment, "priority_gettext", None) is not None or
+            getattr(self.environment, "priority_ngettext", None) is not None
+        )
+        
+        # If no priority and no priority resolvers, use simple gettext
+        if priority is None and not has_priority_resolvers:
+            node = self._make_simple_node(
+                singular, plural, variables, plural_expr, vars_referenced, 
+                num_called_num, newstyle
+            )
+            return nodes.Output([node])
+        
+        # Build the priority fallback logic
+        node = self._make_priority_node(
+            singular, plural, variables, plural_expr, vars_referenced,
+            num_called_num, priority, newstyle
+        )
+        return nodes.Output([node])
+    
+    def _make_simple_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+        newstyle: bool,
+    ) -> nodes.Expr:
+        """Generate a simple gettext/ngettext node without priority."""
+        node: nodes.Expr
+
+        # no variables referenced?  no need to escape for old style
+        # gettext invocations only if there are vars.
+        if not vars_referenced and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(
+                    node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+        return node
+    
+    def _make_priority_node(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+        priority: t.Optional[nodes.Expr],
+        newstyle: bool,
+    ) -> nodes.Expr:
+        """Generate a priority-aware gettext/ngettext node with fallback."""
+        # Convert priority expression to int (default 0 if None)
+        if priority is None:
+            priority_expr = nodes.Const(0)
+        else:
+            priority_expr = priority
+        
+        # Get the appropriate gettext function name
+        if plural_expr is None:
+            gettext_func = "priority_gettext"
+        else:
+            gettext_func = "priority_ngettext"
+        
+        # Build arguments for the priority function call
+        args: t.List[nodes.Expr] = []
+        
+        if plural_expr is None:
+            # Singular only
+            args.append(nodes.Const(singular))
+        else:
+            # Plural - need both singular and plural
+            args.append(nodes.Const(singular))
+            args.append(nodes.Const(plural))
+            args.append(plural_expr)
+        
+        # Add level argument
+        args.append(nodes.Name("level", "load"))
+        
+        # Create the priority function call
+        priority_call = nodes.Call(
+            nodes.Name(gettext_func, "load"),
+            args,
+            [],
+            None,
+            None,
+        )
+        
+        # Handle newstyle vs oldstyle
+        if newstyle:
+            # Newstyle gettext handles variable expansion and autoescape
+            for key, value in variables.items():
+                if num_called_num and key == "num":
+                    continue
+                priority_call.kwargs.append(nodes.Keyword(key, value))
+            result_var = nodes.Name("_result", "store")
+            assign = nodes.Assign(result_var, priority_call)
+            
+            # Return the result
+            return nodes.If(
+                nodes.Compare(
+                    nodes.Name("_result", "load"),
+                    [("compare_eq", nodes.Const(singular if plural_expr is None else plural_expr))]
+                ),
+                nodes.Break(),
+                nodes.Continue(),
+            )
+        else:
+            # Oldstyle - need to handle escaping and formatting
+            result_var = nodes.Name("_result", "store")
+            assign = nodes.Assign(result_var, priority_call)
+            
+            # Mark as safe if autoescaping
+            result_var_safe = nodes.MarkSafeIfAutoescape(result_var)
+            
+            # Apply variable formatting if needed
+            if variables:
+                formatted = nodes.Mod(
+                    result_var_safe,
+                    nodes.Dict([
+                        nodes.Pair(nodes.Const(key), value)
+                        for key, value in variables.items()
+                    ])
+                )
+            else:
+                formatted = result_var_safe
+            
+            return formatted'''
+
+content = content.replace(old_make_node_body, new_make_node_body)
+
+# Write the modified file
+with open('src/jinja2/ext.py', 'w') as f:
+    f.write(content)
+
+print("Patch applied successfully!")
