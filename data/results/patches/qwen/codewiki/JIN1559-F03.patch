+"""Test script for priority fallback feature - detailed."""
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+# Test with priority resolvers
+env = Environment(extensions=[InternationalizationExtension])
+
+call_log = []
+
+def gettext(msg):
+    call_log.append(f"gettext({msg!r})")
+    return msg.upper()
+
+def ngettext(singular, plural, n):
+    call_log.append(f"ngettext({singular!r}, {plural!r}, {n})")
+    if n == 1:
+        return singular.upper()
+    return plural.upper()
+
+def priority_gettext(msg, level):
+    call_log.append(f"priority_gettext({msg!r}, {level})")
+    # Return different result at level 0
+    if level == 0:
+        return f"P0_{msg}"
+    return msg.upper()
+
+def priority_ngettext(singular, plural, n, level):
+    call_log.append(f"priority_ngettext({singular!r}, {plural!r}, {n}, {level})")
+    if level == 0:
+        if n == 1:
+            return f"P0_{singular}"
+        return f"P0_{plural}"
+    if n == 1:
+        return singular.upper()
+    return plural.upper()
+
+# Install with priority resolvers
+env.install_gettext_callables(
+    gettext, ngettext, 
+    priority_gettext=priority_gettext,
+    priority_ngettext=priority_ngettext
+)
+
+# Test 1: Basic trans without priority (should use ordinary gettext once)
+print("=== Test 1: Basic trans without priority ===")
+call_log.clear()
+tmpl = env.from_string("{% trans %}hello{% endtrans %}")
+result = tmpl.render()
+print(f"Call log: {call_log}")
+print(f"Result: {result!r}")
+assert result == "HELLO", f"Expected 'HELLO', got {result!r}"
+assert len(call_log) == 1, f"Expected 1 call, got {len(call_log)}"
+
+# Test 2: Trans with priority=2 (should try levels 0-2)
+print("\n=== Test 2: Trans with priority=2 ===")
+call_log.clear()
+tmpl = env.from_string("{% trans priority=2 %}hello{% endtrans %}")
+result = tmpl.render()
+print(f"Call log: {call_log}")
+print(f"Result: {result!r}")
+# Should try level 0 first, get P0_hello, which is different from source, so stop
+assert result == "P0_hello", f"Expected 'P0_hello', got {result!r}"
+assert len(call_log) == 1, f"Expected 1 call, got {len(call_log)}"
+
+# Test 3: Trans with priority=2 where level 0 returns source message
+print("\n=== Test 3: Priority where level 0 returns source ===")
+call_log.clear()
+
+def priority_gettext2(msg, level):
+    call_log.append(f"priority_gettext2({msg!r}, {level})")
+    # Level 0 returns source message (miss), continue to next level
+    if level == 0:
+        return msg  # Same as source, should continue
+    return msg.upper()
+
+env.install_gettext_callables(
+    gettext, ngettext,
+    priority_gettext=priority_gettext2,
+    priority_ngettext=None
+)
+
+tmpl = env.from_string("{% trans priority=2 %}hello{% endtrans %}")
+result = tmpl.render()
+print(f"Call log: {call_log}")
+print(f"Result: {result!r}")
+# Should try level 0 (returns 'hello' = source, miss), then level 1 (returns 'HELLO')
+assert result == "HELLO", f"Expected 'HELLO', got {result!r}"
+assert len(call_log) == 2, f"Expected 2 calls, got {len(call_log)}"
+
+print("\nAll tests passed!")
