+"""Test script for priority fallback feature."""
+from jinja2 import Environment
+from jinja2.ext import InternationalizationExtension
+
+# Test basic trans without priority (should work as before)
+env = Environment(extensions=[InternationalizationExtension])
+
+def gettext(msg):
+    print(f"gettext called with: {msg!r}")
+    return msg.upper()
+
+def ngettext(singular, plural, n):
+    print(f"ngettext called with: {singular!r}, {plural!r}, {n}")
+    if n == 1:
+        return singular.upper()
+    return plural.upper()
+
+env.install_gettext_callables(gettext, ngettext)
+
+# Test 1: Basic trans without priority
+print("=== Test 1: Basic trans without priority ===")
+tmpl = env.from_string("{% trans %}hello{% endtrans %}")
+result = tmpl.render()
+print(f"Result: {result!r}")
+assert result == "HELLO", f"Expected 'HELLO', got {result!r}"
+
+# Test 2: Trans with priority=0 (should behave like no priority)
