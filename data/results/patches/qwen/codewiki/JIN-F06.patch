+    You can also transform the displayed grouper value using a callback
+    function via the ``key_transform`` parameter. The callback receives
+    each completed group's original key and returns its displayed value.
+    Original keys still determine grouping and sorting; display-key
+    collisions must not merge groups.
+
+    .. sourcecode:: jinja
+
+        {# Transform numeric keys to uppercase strings #}
+        {% for city, items in users|groupby("city", key_transform=str.upper) %}
+          <li>{{ city }}: {{ items|length }} users</li>
+        {% endfor %}
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,11 +1224,18 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
-
+    result = []
+    for key, values in groupby(sorted(value, key=expr), expr):
+        if key_transform is not None:
+            # Check if the callback expects the environment as first argument
+            if hasattr(key_transform, "jinja_pass_arg"):
+                transformed_key = key_transform(environment, key)
+            else:
+                transformed_key = key_transform(key)
+        else:
+            transformed_key = key
+        result.append(_GroupTuple(transformed_key, list(values)))
+    return result
 
