+class _ParamDict(dict):
+    """A dictionary wrapper that tracks parameter assignments when
+    option history tracking is enabled."""
+
+    def __init__(self, ctx: Context) -> None:
+        super().__init__()
+        self._ctx = ctx
+
+    def __setitem__(self, key: str, value: t.Any) -> None:
+        # Track manual assignments - append when there's already history
+        if getattr(self._ctx.command, "track_changes", False):
+            history = self._ctx._option_history.get(key)
+            if history:
+                # Always append for manual assignments
+                import time
+                entry = {
+                    "value": value,
+                    "source": None,  # Manual assignment has no source
+                    "timestamp": time.time(),
+                }
+                self._ctx._option_history[key].append(entry)
+            else:
+                # No history yet - this is during normal parsing, record with source=None
+                # Source will be set later by handle_parse_result
+                import time
+                entry = {
+                    "value": value,
+                    "source": None,  # Placeholder, will be updated
+                    "timestamp": time.time(),
+                }
+                self._ctx._option_history[key] = [entry]
+        super().__setitem__(key, value)
+
