+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of option value assignments for a given option.
+
+        This returns a list of dictionaries, each containing information about
+        an assignment to the option. Each dictionary has the following keys:
+
+        - ``value``: The assigned value.
+        - ``source``: The :class:`ParameterSource` indicating where the value came from,
+          or ``None`` if it was manually assigned via ``ctx.params[name]``.
+        - ``timestamp``: A floating-point Unix timestamp of when the assignment occurred.
+
+        When tracking is disabled on the current command, this method returns ``None``.
+        When tracking is enabled but ``name`` does not identify an option on the
+        current command, it returns an empty list.
+
+        Positional arguments are not included in option history entries.
+
+        .. versionadded:: 8.3
+
+        :param name: The name of the option (Python parameter name, long option like
+                     ``"--count"``, or short option like ``"-c"``).
+        :returns: A list of assignment records, ``None`` if tracking is disabled,
+                  or an empty list if the option is not found.
+        """
+        # Check if tracking is enabled for this context's command
+        if not getattr(self.command, "track_changes", False):
+            return None
+
+        # First try direct lookup by name
+        history = self._option_history.get(name)
+        if history is not None:
+            # Return a shallow copy to prevent mutation of internal state
+            return list(history)
+
+        # If not found, try to match by option names (--opt, -o)
+        for param in self.command.params:
+            if hasattr(param, 'opts'):
+                for opt in param.opts:
+                    if opt == name:
+                        # Found matching option, return its history
+                        hist = self._option_history.get(param.name)
+                        if hist is not None:
+                            return list(hist)
+                        return []
+
+        # No matching option found
+        return []
+
