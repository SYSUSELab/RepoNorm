+    def save_state(self) -> dict[str, t.Any]:
+        """Save the current parsing and presentation state into a snapshot.
+
+        This creates a snapshot of the context's state that can later be
+        restored using :meth:`restore_state`. The snapshot is a dictionary
+        containing copies of all relevant state fields.
+
+        Mutable values are copied to ensure independence from the source
+        context. The snapshot can be reused multiple times to restore
+        the same state.
+
+        .. versionadded:: 8.3
+        """
+        # Copy mutable values to ensure independence from the source context
+        return {
+            "params": copy.deepcopy(self.params),
+            "args": list(self.args),
+            "_protected_args": list(self._protected_args),
+            "_opt_prefixes": set(self._opt_prefixes),
+            "obj": copy.deepcopy(self.obj),
+            "_meta": dict(self._meta),
+            "default_map": dict(self.default_map) if self.default_map is not None else None,
+            "invoked_subcommand": self.invoked_subcommand,
+            "terminal_width": self.terminal_width,
+            "max_content_width": self.max_content_width,
+            "allow_extra_args": self.allow_extra_args,
+            "allow_interspersed_args": self.allow_interspersed_args,
+            "ignore_unknown_options": self.ignore_unknown_options,
+            "resilient_parsing": self.resilient_parsing,
+            "help_option_names": list(self.help_option_names),
+            "token_normalize_func": self.token_normalize_func,
+            "auto_envvar_prefix": self.auto_envvar_prefix,
+            "color": self.color,
+            "show_default": self.show_default,
+            "_parameter_source": dict(self._parameter_source),
+        }
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Restore the context state from a snapshot.
+
+        This restores the context's state from a snapshot created by
+        :meth:`save_state`. The restoration is transactional - if any
+        part of the restoration fails, the context remains unchanged.
+
+        The ``_meta`` field in the snapshot is used to update the
+        existing metadata dictionary (which is shared with parent and
+        child contexts). Other fields are replaced with their values
+        from the snapshot.
+
+        :param snapshot: A dictionary returned by :meth:`save_state`.
+        :raises ValueError: If the snapshot is missing required keys or
+                            has invalid metadata type.
+
+        .. versionadded:: 8.3
+        """
+        # Validate that all required keys are present
+        required_keys = {
+            "params", "args", "_protected_args", "_opt_prefixes", "obj",
+            "_meta", "default_map", "invoked_subcommand", "terminal_width",
+            "max_content_width", "allow_extra_args", "allow_interspersed_args",
+            "ignore_unknown_options", "resilient_parsing", "help_option_names",
+            "token_normalize_func", "auto_envvar_prefix", "color", "show_default",
+            "_parameter_source"
+        }
+
+        for key in required_keys:
+            if key not in snapshot:
+                raise ValueError(f"Missing required key in snapshot: {key}")
+
+        # Validate that _meta is a dictionary
+        meta = snapshot["_meta"]
+        if not isinstance(meta, dict):
+            raise ValueError("Snapshot '_meta' must be a dictionary")
+
+        # Validate that default_map is either None or a mapping
+        dm = snapshot["default_map"]
+        if dm is not None and not isinstance(dm, cabc.MutableMapping):
+            raise ValueError("Snapshot 'default_map' must be None or a MutableMapping")
+
+        # Perform the restoration transactionally
+        # First, validate all values can be assigned
+        try:
+            # Create local copies of all values to ensure atomicity
+            params_copy = dict(snapshot["params"])
+            args_copy = list(snapshot["args"])
+            protected_args_copy = list(snapshot["_protected_args"])
+            opt_prefixes_copy = set(snapshot["_opt_prefixes"])
+            obj_copy = copy.deepcopy(snapshot["obj"])
+            default_map_copy = dict(snapshot["default_map"]) if snapshot["default_map"] is not None else None
+            invoked_subcommand_copy = snapshot["invoked_subcommand"]
+            terminal_width_copy = snapshot["terminal_width"]
+            max_content_width_copy = snapshot["max_content_width"]
+            allow_extra_args_copy = snapshot["allow_extra_args"]
+            allow_interspersed_args_copy = snapshot["allow_interspersed_args"]
+            ignore_unknown_options_copy = snapshot["ignore_unknown_options"]
+            resilient_parsing_copy = snapshot["resilient_parsing"]
+            help_option_names_copy = list(snapshot["help_option_names"])
+            token_normalize_func_copy = snapshot["token_normalize_func"]
+            auto_envvar_prefix_copy = snapshot["auto_envvar_prefix"]
+            color_copy = snapshot["color"]
+            show_default_copy = snapshot["show_default"]
+            parameter_source_copy = dict(snapshot["_parameter_source"])
+        except Exception as e:
+            raise ValueError(f"Failed to prepare snapshot values: {e}")
+
+        # Now perform the actual restoration
+        self.params = params_copy
+        self.args = args_copy
+        self._protected_args = protected_args_copy
+        self._opt_prefixes = opt_prefixes_copy
+        self.obj = obj_copy
+        self.default_map = default_map_copy
+        self.invoked_subcommand = invoked_subcommand_copy
+        self.terminal_width = terminal_width_copy
+        self.max_content_width = max_content_width_copy
+        self.allow_extra_args = allow_extra_args_copy
+        self.allow_interspersed_args = allow_interspersed_args_copy
+        self.ignore_unknown_options = ignore_unknown_options_copy
+        self.resilient_parsing = resilient_parsing_copy
+        self.help_option_names = help_option_names_copy
+        self.token_normalize_func = token_normalize_func_copy
+        self.auto_envvar_prefix = auto_envvar_prefix_copy
+        self.color = color_copy
+        self.show_default = show_default_copy
+        self._parameter_source = parameter_source_copy
+
+        # Update the shared metadata dictionary (not replace it)
