--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,11 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches credit card numbers with exactly 16 digits in one of three formats:
+# - No separators (e.g., 1234567890123456)
+# - Four groups of four separated by hyphens (e.g., 1234-5678-9012-3456)
+# - Four groups of four separated by spaces (e.g., 1234 5678 9012 3456)
+# This type checks textual shape only; it does not validate Luhn checksums,
+# issuers, BIN ranges, or whether a number was issued.
+credit_card = Regex(r"(\d{16}|\d{4}-\d{4}-\d{4}-\d{4}|\d{4} \d{4} \d{4} \d{4})")
