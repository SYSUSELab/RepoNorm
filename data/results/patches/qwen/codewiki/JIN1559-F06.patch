+    def set_translation_cache_partition(self, partition: t.Any) -> None:
+        """Set a new cache partition and clear old entries."""
+        if self._cache is not None:
+            self._cache.set_partition(partition)
+
+    def clear_translation_cache(self) -> None:
+        """Clear all cached translation results."""
+        if self._cache is not None:
+            self._cache.clear()
