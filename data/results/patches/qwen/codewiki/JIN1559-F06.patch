+class _TranslationCache:
+    """A bounded LRU cache for translation callables.
+
+    Each Environment and overlay has independent cache state.
+    Caching works before old/new-style formatting and autoescaping,
+    so formatting variables are not part of raw provider keys.
+    """
+
+    def __init__(self, capacity: int, partition: t.Any) -> None:
+        self.capacity = capacity
+        self.partition = partition
+        self._lock = Lock()
+        self._cache: t.Dict[t.Tuple, t.Any] = {}
+        self._queue: t.Deque[t.Tuple] = deque()
+        self._postinit()
+
+    def _postinit(self) -> None:
+        self._popleft = self._queue.popleft
+        self._pop = self._queue.pop
+        self._remove = self._queue.remove
+        self._append = self._queue.append
+
+    def get(self, key: t.Tuple) -> t.Optional[t.Any]:
+        """Get a cached value or None if not found."""
+        with self._lock:
+            if key in self._cache:
+                # Move to end (most recently used)
+                try:
+                    self._remove(key)
+                except ValueError:
+                    pass
+                self._append(key)
+                return self._cache[key]
+            return None
+
+    def set(self, key: t.Tuple, value: t.Any) -> None:
+        """Set a cached value."""
+        with self._lock:
+            if key in self._cache:
+                self._remove(key)
+            elif len(self._cache) == self.capacity:
+                del self._cache[self._popleft()]
+            self._append(key)
+            self._cache[key] = value
+
+    def clear(self) -> None:
+        """Clear all cache entries."""
+        with self._lock:
+            self._cache.clear()
+            self._queue.clear()
+
+    def resize(self, capacity: int) -> None:
+        """Resize the cache. Capacity of 0 disables the cache."""
+        if capacity < 0:
+            raise ValueError(f"Cache capacity must be non-negative (got {capacity})")
+        with self._lock:
+            self.capacity = capacity
+            if capacity == 0:
+                self._cache.clear()
+                self._queue.clear()
+
+    def set_partition(self, partition: t.Any) -> None:
+        """Change the partition and clear old entries."""
+        with self._lock:
+            self.partition = partition
+            self._cache.clear()
+            self._queue.clear()
+
+
+
+def _wrap_gettext(
+    func: t.Callable[[str], str],
+    cache: t.Optional[_TranslationCache],
+) -> t.Callable[..., str]:
+    """Wrap gettext to use caching."""
+    @pass_context
+    def wrapped(__context: Context, __string: str, **variables: t.Any) -> str:
+        if cache is not None:
+            key = ("gettext", __string, cache.partition)
+            result = cache.get(key)
+            if result is not None:
+                return result
+
+        rv = func(__string)
+        if cache is not None:
+            cache.set(key, rv)
+        return rv
+
+    return wrapped
+
+
