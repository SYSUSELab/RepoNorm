+import warnings
+import click
+from click.testing import CliRunner
+import os
+import tempfile
+import gc
+import resource
+import sys
+
+# Enable all warnings
+warnings.filterwarnings("error", category=ResourceWarning)
+
+@click.command()
+@click.option('--file', type=click.File('r'))
+def cli(file):
+    """Test command with file option."""
+    print(f"File: {file}")
+    pass
+
+if __name__ == "__main__":
+    # Test shell completion - this should not produce ResourceWarning
+    runner = CliRunner()
+    
+    # Simulate bash completion with a file argument that would open a file
+    env = {
+        "COMP_WORDS": "--file /etc/passwd ",
+        "COMP_CWORD": "2",
+        "_CLICK_COMPLETE": "bash_complete"
+    }
+    
+    try:
+        result = runner.invoke(cli, env=env)
+        print(f"Output: {result.output}")
+        print(f"Exit code: {result.exit_code}")
+    except ResourceWarning as e:
+        print(f"Got ResourceWarning: {e}")
+        sys.exit(1)
+    
+    # Now test actual invocation (not completion)
+    result2 = runner.invoke(cli, ['--file', '/etc/passwd'])
+    print(f"Actual invocation output: {result2.output}")
+    print(f"Actual invocation exit code: {result2.exit_code}")
+    
+    # Force garbage collection to trigger ResourceWarning
+    gc.collect()
+    
+    print("Done")
