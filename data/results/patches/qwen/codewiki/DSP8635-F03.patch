+def _get_effective_weights(tip_weights):
+    """
+    Compute effective weights for each tip based on provided tip_weights.
+    
+    - Missing keys have weight 1
+    - Unknown keys are ignored
+    - Positive finite integer/float weights are usable
+    - Non-numeric, boolean, nonfinite and nonpositive values have weight zero
+    
+    Returns a dict mapping tip keys to their effective weights.
+    """
+    if tip_weights is None:
+        return {k: 1.0 for k in TIPS}
+    
+    effective = {}
+    for key in TIPS:
+        if key not in tip_weights:
+            # Missing keys have weight 1
+            effective[key] = 1.0
+        else:
+            w = tip_weights[key]
+            # Check if weight is valid (positive finite number)
+            if isinstance(w, bool):
+                # Booleans have weight 0
+                effective[key] = 0.0
+            elif isinstance(w, (int, float)):
+                if w > 0 and w != float('inf') and w != float('-inf'):
+                    effective[key] = float(w)
+                else:
+                    effective[key] = 0.0
+            else:
+                # Non-numeric has weight 0
+                effective[key] = 0.0
+    
+    return effective
+
+
+def _weighted_choice(rng, weights_dict):
+    """
+    Select a key from weights_dict using weighted random selection.
+    
+    - Zero-weight entries must never be selected when any positive weight exists
+    - None and an all-zero effective mapping use uniform selection over existing tips
+    - Avoid overflow when summing large finite weights by normalizing
+    
+    Uses the rng object's random() method for reproducibility.
+    """
+    keys = list(weights_dict.keys())
+    ws = [weights_dict[k] for k in keys]
+    
+    # Check if all weights are zero or negative
+    total = sum(ws)
+    if total <= 0:
+        # Uniform selection when all weights are zero or negative
+        return rng.choice(keys)
+    
+    # Normalize weights to avoid overflow with large values
+    normalized_ws = [w / total for w in ws]
+    
+    r = rng.random()
+    cumsum = 0.0
+    for i, w in enumerate(normalized_ws):
+        cumsum += w
+        if r < cumsum:
+            return keys[i]
+    return keys[-1]  # Fallback for floating point issues
+
+
