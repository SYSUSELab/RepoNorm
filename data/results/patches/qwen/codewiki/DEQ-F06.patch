@@ -0,0 +1,178 @@
+from typing import Any, Literal, Optional, Tuple, TypeVar, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal as TypingLiteral
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+T = TypeVar('T', str, int)
+
+
+class IsCreditCard(DirtyEquals[T]):
+    """
+    A class that checks if a value is a valid credit card number, optionally checking the issuer.
+
+    Accepts card numbers as strings or integers. Strings may contain spaces, hyphens, and surrounding whitespace;
+    other characters compare unequal.
+
+    Without an issuer, any 12-19 digit number that passes the Luhn check is accepted.
+
+    Digits are ASCII '0' through '9', not Unicode numeric characters. No real-world card allocation,
+    BIN database or payment capability is checked.
+
+    The optional issuer is exactly one of `Visa`, `Mastercard`, or `AmericanExpress`, matched case-sensitively.
+
+    - Visa numbers start with 4 and contain 13, 16, or 19 digits.
+    - Mastercard numbers contain 16 digits and start in the 51--55 or 2221--2720 ranges.
+    - American Express numbers contain 15 digits and start with 34 or 37.
+
+    A number with an issuer mismatch, invalid prefix or length, or invalid Luhn checksum compares unequal.
+
+    Examples:
+    ```py title="IsCreditCard"
+    from dirty_equals import IsCreditCard
+
+    assert '4111111111111111' == IsCreditCard
+    assert '4111-1111-1111-1111' == IsCreditCard
+    assert '4111 1111 1111 1111' == IsCreditCard
+    assert 4111111111111111 == IsCreditCard
+
+    assert '4111111111111111' == IsCreditCard(issuer='Visa')
+    assert '5500000000000004' == IsCreditCard(issuer='Mastercard')
+    assert '378282246310005' == IsCreditCard(issuer='AmericanExpress')
+
+    assert '4111111111111111' != IsCreditCard(issuer='Mastercard')
+    assert '5500000000000004' != IsCreditCard(issuer='Visa')
+    ```
+    """
+
+    def __init__(
+        self,
+        *,
+        issuer: Optional[Literal['Visa', 'Mastercard', 'AmericanExpress']] = None,
+    ):
+        """
+        Args:
+            issuer: The expected card issuer, if provided. Must be one of 'Visa', 'Mastercard', or 'AmericanExpress'.
+
+        Example:
+        ```py title="IsCreditCard"
+        from dirty_equals import IsCreditCard
+
+        assert '4111111111111111' == IsCreditCard(issuer='Visa')
+        assert '5500000000000004' == IsCreditCard(issuer='Mastercard')
+        assert '378282246310005' == IsCreditCard(issuer='AmericanExpress')
+        ```
+        """
+        self.issuer = issuer
+        super().__init__(plain_repr(issuer) if issuer else Omit)
+
+    def equals(self, other: Any) -> bool:
+        # Extract digits from the input
+        digits = self._extract_digits(other)
+        
+        if digits is None:
+            return False
+        
+        # Check Luhn algorithm
+        if not self._luhn_check(digits):
+            return False
+        
+        # Check length (must be 12-19 digits)
+        if len(digits) < 12 or len(digits) > 19:
+            return False
+        
+        # If no issuer specified, we're done
+        if self.issuer is None:
+            return True
+        
+        # Check issuer-specific rules
+        return self._check_issuer(digits, self.issuer)
+
+    def _extract_digits(self, other: Any) -> Optional[str]:
+        """Extract digits from input, returning None if invalid."""
+        # Handle integer input
+        if isinstance(other, int):
+            # Reject booleans explicitly (they're technically ints in Python)
+            if isinstance(other, bool):
+                return None
+            return str(other)
+        
+        # Handle string input
+        if isinstance(other, str):
+            # Remove leading/trailing whitespace
+            s = other.strip()
+            
+            # Only allow digits, spaces, and hyphens
+            for c in s:
+                if c not in '0123456789 -':
+                    return None
+            
+            # Remove spaces and hyphens
+            digits = ''.join(c for c in s if c.isdigit())
+            
+            # Verify all remaining characters are ASCII digits (not Unicode numerals)
+            for c in digits:
+                if c not in '0123456789':
+                    return None
+            
+            return digits
+        
+        # Other types are not equal
+        return None
+
+    def _luhn_check(self, digits: str) -> bool:
+        """Check if the digits pass the Luhn algorithm."""
+        total = 0
+        reverse_digits = digits[::-1]
+        
+        for i, char in enumerate(reverse_digits):
+            n = int(char)
+            if i % 2 == 1:  # Double every second digit from the right
+                n *= 2
+                if n > 9:
+                    n -= 9
+            total += n
+        
+        return total % 10 == 0
+
+    def _check_issuer(self, digits: str, issuer: str) -> bool:
+        """Check if the digits match the specified issuer's rules."""
+        if issuer == 'Visa':
+            # Starts with 4, contains 13, 16, or 19 digits
+            if not digits.startswith('4'):
+                return False
+            if len(digits) not in (13, 16, 19):
+                return False
+            return True
+        
+        elif issuer == 'Mastercard':
+            # 16 digits, starts in 51-55 or 2221-2720 ranges
+            if len(digits) != 16:
+                return False
+            
+            first_two = int(digits[:2])
+            first_four = int(digits[:4])
+            
+            # Check 51-55 range
+            if 51 <= first_two <= 55:
+                return True
+            
+            # Check 2221-2720 range
+            if 2221 <= first_four <= 2720:
+                return True
+            
+            return False
+        
+        elif issuer == 'AmericanExpress':
+            # 15 digits, starts with 34 or 37
+            if len(digits) != 15:
+                return False
+            if not (digits.startswith('34') or digits.startswith('37')):
+                return False
+            return True
+        
+        return False
