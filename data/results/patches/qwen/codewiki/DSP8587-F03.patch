+    def stats(self) -> dict[str, Any]:
+        """Return serialization-friendly statistics about the active field stream.
+        
+        Returns a dictionary with the following keys:
+        - predict_name: The name of the predictor
+        - field: The signature field name being listened to
+        - chunk_count: Number of chunks emitted since stream start
+        - char_count: Total character count of emitted chunks
+        - first_ts: Timestamp of first emission (seconds since epoch), or None
+        - last_ts: Timestamp of last emission (seconds since epoch), or None
+        - duration_s: Duration between first and last emission, or None
+        - avg_chunk_chars: Average characters per chunk, or 0
+        
+        Before an emission, counters are zero, timestamps/duration are None, and average is zero.
+        When the listener enters its ended state, all counters and timestamps reset immediately.
+        """
+        duration_s = None
+        avg_chunk_chars = 0.0
+        
+        if self.first_ts is not None and self.last_ts is not None:
+            duration_s = self.last_ts - self.first_ts
+            
+        if self.chunk_count > 0:
+            avg_chunk_chars = self.char_count / self.chunk_count
+            
+        return {
+            "predict_name": self.predict_name,
+            "field": self.signature_field_name,
+            "chunk_count": self.chunk_count,
+            "char_count": self.char_count,
+            "first_ts": self.first_ts,
+            "last_ts": self.last_ts,
+            "duration_s": duration_s,
+            "avg_chunk_chars": avg_chunk_chars,
