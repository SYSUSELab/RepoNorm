@@ -22,18 +23,40 @@ class XGrammarLogitsProcessor(OutlinesLogitsProcessor):
 
     """
 
-    def __init__(self, compiled_grammar: str):
+    def __init__(self, compiled_grammar: str, temperature: float = 1.0):
         """
         Parameters
         ----------
         compiled_grammar: str
             The compiled grammar to use to create the logits processor.
+        temperature: float
+            The temperature value to apply to logits before grammar constraints.
+            Must be a finite numeric value greater than zero. Default is 1.0.
+
+        Raises
+        ------
+        ValueError
+            If temperature is not a finite positive number.
 
         """
+        if not isinstance(temperature, (int, float)):
+            raise ValueError(
+                f"temperature must be a numeric value, got {type(temperature)}"
+            )
+        if not math.isfinite(temperature):
+            raise ValueError(
+                f"temperature must be a finite value, got {temperature}"
+            )
+        if temperature <= 0:
+            raise ValueError(
+                f"temperature must be greater than zero, got {temperature}"
+            )
+
         import xgrammar as xgr
 
         self.xgr = xgr
         self.compiled_grammar = compiled_grammar
+        self.temperature = temperature
         self.xgrammar_logits_processor = None
         super().__init__("torch")
 
