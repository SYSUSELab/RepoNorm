+            if lower_key not in seen_lower_keys:
+                seen_lower_keys.add(lower_key)
+                orig_key, group_items = groups[lower_key]
+                result.append(_GroupTuple(orig_key, group_items))
+        else:
+            if key not in seen_lower_keys:
+                seen_lower_keys.add(key)
+                orig_key, group_items = groups[key]
+                result.append(_GroupTuple(orig_key, group_items))
+    
+    return result
