diff --git a/tests/test_async_filters.py b/tests/test_async_filters.py
index 5d4f332..dd45d28 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -251,3 +251,50 @@ def test_custom_async_iteratable_filter(env_async, items):
     )
     out = tmpl.render(items=items)
     assert out == "0,1,2 .. 3,4,5"
+
+@mark_dualiter("items", lambda: [{'name': 'NY'}, {'name': 'NYC'}, {'name': 'ny'}, {'name': 'nyc'}])
+def test_groupby_case_sensitive(env_async, items):
+    """Test case-sensitive grouping with case_sensitive=True."""
+    tmpl = env_async.from_string(
+        """
+    {%- for grouper, list in items()|groupby('name', case_sensitive=true) -%}
+        {{ grouper }}|
+    {%- endfor %}"""
+    )
+    # Each different casing should be a separate group
+    result = tmpl.render(items=items)
+    assert result.split("|") == ["NY", "NYC", "ny", "nyc", ""]
+
+
+@mark_dualiter("items", lambda: [{'name': 'NY'}, {'name': 'NYC'}, {'name': 'ny'}, {'name': 'nyc'}])
+def test_groupby_case_insensitive(env_async, items):
+    """Test case-insensitive grouping with case_sensitive=False (default)."""
+    tmpl = env_async.from_string(
+        """
+    {%- for grouper, list in items()|groupby('name') -%}
+        {{ grouper }}:{{ list|length }}|
+    {%- endfor %}"""
+    )
+    # Case-insensitive grouping - NY groups with ny, NYC groups with nyc
+    result = tmpl.render(items=items)
+    # Each group should have 2 items
+    assert "NY:2" in result
+    assert "NYC:2" in result
+    # Should have exactly 2 groups
+    assert result.count("|") == 2
+
+
+@mark_dualiter("items", lambda: [{'name': 'alice'}, {'name': 'Bob'}, {'name': 'ALICE'}, {'name': 'bob'}])
+def test_groupby_case_insensitive_order(env_async, items):
+    """Test that case-insensitive grouping preserves first-seen spelling from sorted order."""
+    tmpl = env_async.from_string(
+        """
+    {%- for grouper, list in items()|groupby('name') -%}
+        {{ grouper }}-{{ list|length }}|
+    {%- endfor %}"""
+    )
+    # After sorting, 'ALICE' comes before 'alice', so ALICE is first-seen
+    # 'Bob' comes before 'bob', so Bob is first-seen
+    result = tmpl.render(items=items)
+    assert "ALICE-2" in result
+    assert "Bob-2" in result
