+    expr = make_attrgetter(environment, attribute, default=default)
+    
+    if case_sensitive:
+        # Case-sensitive grouping - use current behavior
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
+    
+    # Case-insensitive grouping for strings
+    # Group by lowercase key but keep original spelling of first encountered key
+    groups: dict[t.Any, tuple[t.Any, list[V]]] = {}
+    
+    for item in sorted(value, key=expr):
+        key = expr(item)
+        
+        if isinstance(key, str):
+            # Use lowercase as the grouping key
+            lower_key = key.lower()
+            
+            if lower_key not in groups:
+                # First time seeing this key (case-insensitively)
+                # Store the original key and start a new group
+                groups[lower_key] = (key, [])
+            
+            # Append to the group with the stored original key
+            orig_key, group_items = groups[lower_key]
+            group_items.append(item)
+            groups[lower_key] = (orig_key, group_items)
+        else:
+            # Non-string keys - use them directly
+            if key not in groups:
+                groups[key] = (key, [])
+            groups[key][1].append(item)
+    
+    # Return groups in order of first appearance (sorted by original key)
+    result = []
+    seen_lower_keys: set[t.Any] = set()
+    
