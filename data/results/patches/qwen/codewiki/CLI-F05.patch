     def close(self) -> None:
         """Invoke all close callbacks registered with
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
+
+        Cleanup callbacks are retried on transient failures according to
+        the context's :attr:`retry_cleanup` setting. Each callback has its
+        own retry budget and backoff sequence.
         """
+        import time
+        import math
+
+        # First, close all context managers registered via with_resource
         self._exit_stack.close()
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
 
+        # Now handle retry logic for call_on_close callbacks
+        # Callbacks are executed in reverse order (LIFO) to match nested context behavior
+        callbacks = list(reversed(self._close_callbacks))
+        self._close_callbacks.clear()
+
+        last_exception = None
+        for callback in callbacks:
+            # Try up to (retry_cleanup + 1) times
+            max_attempts = self.retry_cleanup + 1
+            current_backoff = self.retry_cleanup_backoff
+            attempt = 0
+            exception_to_propagate = None
+
+            while attempt < max_attempts:
+                try:
+                    callback()
+                    # Success - no need to retry
+                    exception_to_propagate = None
+                    break
+                except (KeyboardInterrupt, SystemExit):
+                    # Never retry these exceptions
+                    raise
+                except Exception as e:
+                    exception_to_propagate = e
+                    attempt += 1
+                    if attempt < max_attempts:
+                        # Wait before retrying with exponential backoff
+                        time.sleep(current_backoff)
+                        current_backoff *= 2
+
+            # If we exhausted all attempts, keep the last exception
+            if exception_to_propagate is not None:
+                last_exception = exception_to_propagate
+
+        # Propagate the last exception if any occurred
+        if last_exception is not None:
+            raise last_exception
+
