+    def from_string(cls, text: str) -> "ToolCalls":
+        """Parse tool calls from JSON text with optional Python-style # comments.
+
+        Supports single call, bare list, or canonical tool_calls container.
+        Combines nonblank comment bodies in source order, trim surrounding whitespace,
+        join with newlines. Document-level comment applies to every call and overrides
+        explicit comment fields; note remains independent.
+
+        Args:
+            text: JSON text with optional Python-style # comments outside quoted strings.
+
+        Returns:
+            A ToolCalls instance.
+
+        Raises:
+            ValueError: If JSON is invalid, required fields are missing, or metadata fields are invalid.
+
+        Example:
+
+            text = \'\'\'
+            {
+                "name": "search",
+                "args": {"query": "hello"}
+            }
+            # This is a comment
+            \'\'\'
+            tool_calls = ToolCalls.from_string(text)
+        """
+        comments = _extract_comments(text)
+        cleaned_text = _remove_comments_from_json(text)
+        try:
+            data = json.loads(cleaned_text)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Invalid JSON: {e}")
+        
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                items = data["tool_calls"]
+            elif "name" in data and "args" in data:
+                items = [data]
+            else:
+                raise ValueError("JSON object must have 'tool_calls' key or be a single call with 'name'/'args'")
+        elif isinstance(data, list):
+            items = data
+        else:
+            raise ValueError("JSON must be an object or array")
+        
+        for i, item in enumerate(items):
+            if not isinstance(item, dict):
+                raise ValueError(f"Item {i} is not a dictionary")
+            if "name" not in item:
+                raise ValueError(f"Item {i} missing 'name' field")
+            if "args" not in item:
+                raise ValueError(f"Item {i} missing 'args' field")
+        
+        return cls.from_dict_list(items, comments=comments)
