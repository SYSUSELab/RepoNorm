+def _remove_comments_from_json(text: str) -> str:
+    """Remove Python-style # comments from JSON text while preserving # inside strings."""
+    result = []
+    i = 0
+    n = len(text)
+    while i < n:
+        char = text[i]
+        if char == '"':
+            result.append(char)
+            i += 1
+            while i < n:
+                char = text[i]
+                result.append(char)
+                if char == '\\' and i + 1 < n:
+                    i += 1
+                    result.append(text[i])
+                    i += 1
+                    continue
+                elif char == '"':
+                    break
+                i += 1
+            i += 1
+        elif char == '#':
+            while i < n and text[i] != '\n':
+                i += 1
+        else:
+            result.append(char)
+            i += 1
+    return ''.join(result)
+
+
+def _extract_comments(text: str) -> list[str]:
+    """Extract Python-style # comments from text while preserving # inside strings."""
+    comments = []
+    i = 0
+    n = len(text)
+    while i < n:
+        char = text[i]
+        if char == '"':
+            i += 1
+            while i < n:
+                char = text[i]
+                if char == '\\' and i + 1 < n:
+                    i += 2
+                    continue
+                elif char == '"':
+                    break
+                i += 1
+            i += 1
+        elif char == '#':
+            i += 1
+            comment_start = i
+            while i < n and text[i] != '\n':
+                i += 1
+            comment_body = text[comment_start:i].strip()
+            if comment_body:
+                comments.append(comment_body)
+        else:
+            i += 1
+    return comments
+
 
