+    def format_with_metadata(self) -> list[dict[str, Any]]:
+        """Format tool calls with metadata fields alongside execution fields.
+
+        Returns the same envelope as format() but includes non-None metadata fields
+        beside type/function fields, not inside arguments. Preserves explicit empty
+        strings/lists/dictionaries and zero priority. Omit unset metadata.
+
+        Returns:
+            List containing tool_calls envelope with metadata fields.
+        """
+        result = []
+        for tool_call in self.tool_calls:
+            call_entry = {
+                "type": "function",
+                "function": {
+                    "name": tool_call.name,
+                    "arguments": tool_call.args,
+                },
+            }
+            if tool_call.note is not None:
+                call_entry["note"] = tool_call.note
+            if tool_call.comment is not None:
+                call_entry["comment"] = tool_call.comment
+            if tool_call.annotation is not None:
+                call_entry["annotation"] = tool_call.annotation
+            if tool_call.tags is not None:
+                call_entry["tags"] = tool_call.tags
+            if tool_call.priority is not None:
+                call_entry["priority"] = tool_call.priority
+            if tool_call.meta is not None:
+                call_entry["meta"] = tool_call.meta
+            result.append(call_entry)
+        return [{"type": "tool_calls", "tool_calls": result}]
