+    Hierarchical grouping can be enabled by passing a sequence of
+    attributes along with the ``levels`` parameter. Each attribute
+    defines one level of grouping, in order. The number of attributes
+    must equal ``levels``.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for dept, roles in users|groupby(["department", "role"], levels=2) %}
+          <li>{{ dept }}
+            <ul>{% for role, members in roles %}
+              <li>{{ role }}: {{ members|map(attribute="name")|join(", ") }}
+            {% endfor %}</ul>
+          </li>
+        {% endfor %}</ul>
+
+    .. versionchanged:: 3.1
+        Added the ``levels`` parameter for hierarchical grouping.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
     """
+    # Handle hierarchical grouping
+    if levels is not None:
+        # Validate levels
+        if isinstance(levels, bool) or not isinstance(levels, int) or levels <= 0:
+            raise FilterArgumentError("levels must be a positive integer")
+        
+        # Normalize attribute to a list
+        if isinstance(attribute, str):
+            # Comma-separated string
+            attrs = [a.strip() for a in attribute.split(",")]
+        elif isinstance(attribute, (list, tuple)):
+            attrs = list(attribute)
+        else:
+            # Single attribute treated as list
+            attrs = [attribute]
+        
+        # Validate attribute count matches levels
+        if len(attrs) != levels:
+            raise FilterArgumentError(
+                f"expected {levels} attributes, got {len(attrs)}"
+            )
+        
+        # Each attribute is a complete path (may contain dots)
+        # Pass them as-is to _recursive_groupby
+        return _recursive_groupby(environment, list(value), attrs, 0, default)
+    
+    # Single-level grouping (existing behavior)
+    # But first validate that we don't have multiple attributes without levels
+    if isinstance(attribute, (list, tuple)):
+        if len(attribute) > 1:
+            raise FilterArgumentError(
+                "multiple attributes require the levels parameter"
+            )
+        # Single-element list, convert to the element
+        attribute = attribute[0]
+    
     expr = make_attrgetter(environment, attribute, default=default)
