+def _recursive_groupby(
+    environment: "Environment",
+    value: t.List[V],
+    attributes: t.Sequence[t.Union[str, int]],
+    index: int,
+    default: t.Optional[t.Any] = None,
+) -> t.List[t.Tuple[t.Any, t.Union[t.List[V], t.List[t.Tuple[t.Any, t.Any]]]]]:
+    """Recursively group items by multiple attributes.
+    
+    :param environment: The Jinja2 environment.
+    :param value: The list of items to group.
+    :param attributes: Sequence of attribute paths for each level.
+    :param index: Current level index.
+    :param default: Default value for missing attributes.
+    :return: List of tuples (grouper, groups_or_items).
+    """
+    if index >= len(attributes):
+        # No more levels, return items as-is
+        return [(_GroupTuple(None, value))]
+    
+    attr = attributes[index]
+    expr = make_attrgetter(environment, attr, default=default)
+    
+    # Sort by current attribute
+    sorted_value = sorted(value, key=expr)
+    
+    if index == len(attributes) - 1:
+        # Last level, return items directly
+        result = []
+        for key, values in groupby(sorted_value, expr):
+            result.append(_GroupTuple(key, list(values)))
+        return result
+    
+    # Intermediate level, recurse
+    result = []
+    for key, values in groupby(sorted_value, expr):
+        sub_groups = _recursive_groupby(
+            environment, list(values), attributes, index + 1, default
+        )
+        result.append(_GroupTuple(key, sub_groups))
+    
+    return result
+
+
