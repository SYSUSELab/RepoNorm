diff --git a/src/click/shell_strategies.py b/src/click/shell_strategies.py
new file mode 100644
index 0000000..a05e066
--- /dev/null
+++ b/src/click/shell_strategies.py
@@ -0,0 +1,153 @@
+"""Built-in shell completion strategies for click.Option."""
+import os
+import subprocess
+from typing import TYPE_CHECKING, Callable
+
+if TYPE_CHECKING:
+    from click import Context, Parameter
+
+
+def _filter_by_prefix(items: list[str], incomplete: str) -> list[str]:
+    """Filter items that start with the incomplete prefix."""
+    if not incomplete:
+        return items
+    return [item for item in items if item.startswith(incomplete)]
+
+
+def _sort_and_limit(items: list[str], max_count: int = 20) -> list[str]:
+    """Sort items and limit to max_count unique values."""
+    seen = set()
+    result = []
+    for item in sorted(items):
+        if item not in seen:
+            seen.add(item)
+            result.append(item)
+            if len(result) >= max_count:
+                break
+    return result
+
+
+def get_strategy_from_name(name: str) -> str | None:
+    """Detect completion strategy from underscore-delimited tokens in option name.
+    
+    Returns the strategy name if found, None otherwise.
+    """
+    # Normalize: lowercase and split by underscores
+    tokens = name.lower().split("_")
+    
+    # User-related tokens
+    user_tokens = {"user", "username", "owner", "author"}
+    if any(token in user_tokens for token in tokens):
+        return "user"
+    
+    # Branch/ref/revision tokens
+    branch_tokens = {"branch", "ref", "revision", "commit", "sha"}
+    if any(token in branch_tokens for token in tokens):
+        return "branch"
+    
+    # Environment/var tokens
+    env_tokens = {"env", "environment", "var", "variable"}
+    if any(token in env_tokens for token in tokens):
+        return "environment"
+    
+    # File/path tokens (but not directory)
+    file_tokens = {"file", "path", "input", "output", "filename", "filepath"}
+    if any(token in file_tokens for token in tokens):
+        return "file"
+    
+    # Directory tokens
+    dir_tokens = {"dir", "directory", "folder"}
+    if any(token in dir_tokens for token in tokens):
+        return "directory"
+    
+    return None
+
+
+def complete_user(ctx: "Context", param: "Parameter", incomplete: str) -> list[str]:
+    """Complete POSIX usernames, excluding those starting with underscore."""
+    try:
+        import pwd
+        
+        usernames = []
+        for entry in pwd.getpwall():
+            username = entry.pw_name
+            # Exclude system accounts starting with underscore
+            if not username.startswith("_"):
+                usernames.append(username)
+        
+        filtered = _filter_by_prefix(usernames, incomplete)
+        return _sort_and_limit(filtered, 20)
+    except (ImportError, OSError):
+        # Fall back to normal completion if pwd module unavailable
+        return []
+
+
+def complete_branch(ctx: "Context", param: "Parameter", incomplete: str) -> list[str]:
+    """Complete Git branch names."""
+    try:
+        result = subprocess.run(
+            ["git", "branch", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+        if result.returncode == 0:
+            branches = [b.strip() for b in result.stdout.splitlines() if b.strip()]
+            filtered = _filter_by_prefix(branches, incomplete)
+            return _sort_and_limit(filtered, 20)
+    except (subprocess.SubprocessError, FileNotFoundError, OSError):
+        pass
+    
+    return []
+
+
+def complete_environment(ctx: "Context", param: "Parameter", incomplete: str) -> list[str]:
+    """Complete environment variable names (not values)."""
+    env_vars = list(os.environ.keys())
+    filtered = _filter_by_prefix(env_vars, incomplete)
+    return _sort_and_limit(filtered, 20)
+
+
+def complete_file(ctx: "Context", param: "Parameter", incomplete: str) -> list[str]:
+    """Complete file paths using standard path completion."""
+    from click.shell_completion import CompletionItem
+    
+    # Use Path type's completion which handles shell-based completion
+    from click.types import Path as ClickPath
+    path_type = ClickPath()
+    completions = path_type.shell_complete(ctx, param, incomplete)
+    
+    # Return just the values
+    return [c.value for c in completions]
+
+
+def complete_directory(ctx: "Context", param: "Parameter", incomplete: str) -> list[str]:
+    """Complete directory paths only."""
+    from click.shell_completion import CompletionItem
+    
+    # Use Path type with dir_okay=True, file_okay=False
+    from click.types import Path as ClickPath
+    path_type = ClickPath(dir_okay=True, file_okay=False)
+    completions = path_type.shell_complete(ctx, param, incomplete)
+    
+    # Return just the values
+    return [c.value for c in completions]
+
+
+STRATEGIES = {
+    "user": complete_user,
+    "branch": complete_branch,
+    "environment": complete_environment,
+    "file": complete_file,
+    "directory": complete_directory,
+}
+
+
+def get_strategy(strategy_name: str) -> Callable:
+    """Get a completion strategy function by name."""
+    if strategy_name not in STRATEGIES:
+        raise ValueError(
+            f"Unknown auto_complete strategy '{strategy_name}'. "
+            f"Valid strategies are: {', '.join(sorted(STRATEGIES.keys()))}"
+        )
+    return STRATEGIES[strategy_name]
