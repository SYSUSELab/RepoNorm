+    fn compress_tokens(tokens: Vec<Rank>) -> Vec<Rank> {
+        if tokens.is_empty() {
+            return tokens;
+        }
+        
+        let mut compressed = Vec::with_capacity(tokens.len());
+        let mut prev_token = tokens[0];
+        compressed.push(prev_token);
+        
+        for &token in &tokens[1..] {
+            if token != prev_token {
+                compressed.push(token);
+                prev_token = token;
+            }
+        }
+        
+        compressed
     }
