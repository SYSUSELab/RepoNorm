+def _validate_ttl(ttl: Any) -> None:
+    """Validate TTL value.
+    
+    A TTL is a positive finite number of seconds; None means no expiration.
+    Reject zero, negative, nonfinite, boolean and nonnumeric TTLs with ValueError.
+    """
+    # Check for None (no expiration)
+    if ttl is None:
+        return
+    
+    # Reject booleans first (bool is subclass of int in Python)
+    if isinstance(ttl, bool):
+        raise ValueError(f"TTL must be a positive finite number or None, got {type(ttl).__name__}")
+    
+    # Check if it's numeric
+    if not isinstance(ttl, (int, float)):
+        raise ValueError(f"TTL must be a positive finite number or None, got {type(ttl).__name__}")
+    
+    # Reject zero and negative
+    if ttl <= 0:
+        raise ValueError(f"TTL must be a positive finite number or None, got {ttl}")
+    
+    # Reject non-finite numbers (inf, -inf, nan)
+    if not (float('-inf') < ttl < float('inf')):
+        raise ValueError(f"TTL must be a positive finite number or None, got {ttl}")
+
