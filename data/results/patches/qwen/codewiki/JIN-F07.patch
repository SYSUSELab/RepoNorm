@@ -1203,6 +1205,18 @@ def sync_do_groupby(
           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    By default, the values are sorted before grouping, so groups are
+    ordered by their keys. When ``stable=True``, groups are ordered by
+    the first occurrence of each key instead of sorting keys. Members
+    retain input order. Equal keys merge even when not adjacent or not
+    the same object; the first original key object is retained as grouper.
+    This supports equality-comparable keys including lists and dictionaries,
+    and mixtures with hashable keys, without requiring ordering or hashing
+    or changing the keys.
+
+    .. versionchanged:: 3.1
+        Added the ``stable`` parameter.
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,6 +1224,28 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
+    
+    if stable:
+        # Group by first occurrence, using equality comparison
+        groups = []
+        for item in value:
+            k = expr(item)
+            # Find existing group with equal key
+            idx = None
+            for i, (existing_key, _) in enumerate(groups):
+                if k == existing_key:
+                    idx = i
+                    break
+            
+            if idx is None:
+                # New key - create new group
+                groups.append((k, [item]))
+            else:
+                # Existing key - add to group
+                groups[idx][1].append(item)
+        
+        return [_GroupTuple(key, list(values)) for key, values in groups]
+    
     return [
         _GroupTuple(key, list(values))
         for key, values in groupby(sorted(value, key=expr), expr)
