diff --git a/tests/test_filters.py b/tests/test_filters.py
index 43ddf59..0fe9c29 100644
--- a/tests/test_filters.py
+++ b/tests/test_filters.py
@@ -852,3 +852,46 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+    def test_groupby_stable(self, env):
+        """Test that stable=True groups by first occurrence instead of sorting."""
+        # Test with non-adjacent equal keys - should preserve first-occurrence order
+        tmpl = env.from_string(
+            "{%- for grouper, list in ['a', 'b', 'a', 'c', 'b']|groupby(None, stable=True) -%}"
+            "{{ grouper }}:{% for x in list %}{{ x }} {% endfor %}|{%- endfor %}"
+        )
+        assert tmpl.render() == "a:a a |b:b b |c:c |"
+
+    def test_groupby_stable_unhashable_keys(self, env):
+        """Test stable=True with unhashable keys (lists, dicts)."""
+        # List keys (comparable but unhashable)
+        tmpl = env.from_string(
+            "{%- for grouper, list in [[1], [2], [1], [3]]|groupby(None, stable=True) -%}"
+            "{{ grouper }}:{% for x in list %}{{ x }} {% endfor %}|{%- endfor %}"
+        )
+        assert tmpl.render() == "[1]:[1] [1] |[2]:[2] |[3]:[3] |"
+
+        # Dict keys (unhashable and not comparable)
+        tmpl = env.from_string(
+            "{%- for grouper, list in [{'a': 1}, {'b': 2}, {'a': 1}, {'c': 3}]|groupby(None, stable=True) -%}"
+            "{{ grouper }}:{% for x in list %}{{ x }} {% endfor %}|{%- endfor %}"
+        )
+        result = tmpl.render()
+        parts = result.split("|")
+        assert len(parts) == 4
+        assert "'a': 1" in parts[0]
+        assert "'b': 2" in parts[1]
+        assert "'c': 3" in parts[2]
+
+    def test_groupby_stable_mixed_keys(self, env):
+        """Test stable=True with mixed hashable and unhashable keys."""
+        tmpl = env.from_string(
+            "{%- for grouper, list in ['a', [1], 'a', {'b': 2}]|groupby(None, stable=True) -%}"
+            "{{ grouper }}:{% for x in list %}{{ x }} {% endfor %}|{%- endfor %}"
+        )
+        result = tmpl.render()
+        parts = result.split("|")
+        assert len(parts) == 4
+        assert "a:a a" in parts[0]
+        assert "[1]:[1]" in parts[1]
+        assert "'b': 2" in parts[2]
