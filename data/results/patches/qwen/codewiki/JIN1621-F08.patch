         """Iterates over all templates.  If the loader does not support that
         it should raise a :exc:`TypeError` which is the default behavior.
         """
+        result = self._list_templates()
+        # Apply filters
+        filtered = []
+        for name in result:
+            exclude = False
+            for filter_type, filter_value in self._filters:
+                if filter_type == 'fnmatch':
+                    import fnmatch
+                    if fnmatch.fnmatch(name, filter_value):
+                        exclude = True
+                        break
+                elif filter_type == 'regex':
+                    if filter_value.search(name):
+                        exclude = True
+                        break
+                elif filter_type == 'callable':
+                    if filter_value(name):
+                        exclude = True
+                        break
+            if not exclude:
+                filtered.append(name)
+        return filtered
+
+    def _list_templates(self) -> t.List[str]:
+        """Internal method that returns template names without applying filters.
+        
+        Concrete loaders should override this method instead of list_templates().
+        """
         raise TypeError("this loader cannot iterate over all templates")
 
+    def add_filter(self, filter_pattern: t.Union[str, t.Pattern[str], t.Callable[[str], bool]]) -> None:
+        """Add a filter that excludes templates matching the pattern from list_templates.
+
+        Strings use case-sensitive glob matching, compiled regular expressions use
+        search, and callables receive the template name and exclude it when truthy.
+        Unsupported objects raise TypeError; exceptions raised while matching propagate unchanged.
+
+        Filters persist until cleared and affect listings only. A filtered name remains
+        directly loadable.
+        """
+        if isinstance(filter_pattern, str):
+            self._filters.append(('fnmatch', filter_pattern))
+        elif hasattr(filter_pattern, 'search'):  # Compiled regex
+            self._filters.append(('regex', filter_pattern))
+        elif callable(filter_pattern):
+            self._filters.append(('callable', filter_pattern))
+        else:
+            raise TypeError(f"Unsupported filter type: {type(filter_pattern).__name__}")
+
+    def clear_filters(self) -> None:
+        """Remove all filters."""
+        self._filters.clear()
+
+    @contextmanager
+    def filter_scope(self, *patterns: t.Union[str, t.Pattern[str], t.Callable[[str], bool]]) -> t.Iterator[None]:
+        """A synchronous context manager for temporarily adding filters.
+
+        Accepts the same filter inputs as add_filter. Scopes may nest; leaving a scope
+        restores the filter configuration present on entry, including when entering or
+        executing the scope raises an exception. Filter changes made inside the scope
+        are temporary. The scope is local to that loader and does not promise thread
+        or asynchronous-task isolation.
+        """
+        saved_filters = self._filters.copy()
+        try:
+            for pattern in patterns:
+                self.add_filter(pattern)
+            yield
+        finally:
+            self._filters = saved_filters
+
