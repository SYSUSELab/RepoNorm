+def validate_template_path(template: str) -> None:
+    """Validate a template path.
+
+    Returns ``None`` for a valid name and raises :exc:`TemplateNotFound` when
+    the value is ``None`` or the empty string, contains a NUL byte, begins
+    with ``/`` or ``\\``, begins with an ASCII drive prefix such as ``C:``,
+    or contains an ASCII control character below code point 32 other than
+    tab, newline, or carriage return. Those three named control characters
+    remain valid.
+
+    .. versionadded:: 3.1
+    """
+    if not isinstance(template, str):
+        raise TemplateNotFound(template)
+
+    # Check for None or empty string
+    if not template:
+        raise TemplateNotFound(template)
+
+    # Check for NUL byte
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    # Check for absolute path (starts with / or \)
+    if template[0] in ("/", "\\"):
+        raise TemplateNotFound(template)
+
+    # Check for drive prefix (e.g., C:, D:)
+    if len(template) >= 2 and template[1] == ":":
+        # Check if first character is a letter (A-Z or a-z)
+        if "a" <= template[0] <= "z" or "A" <= template[0] <= "Z":
+            raise TemplateNotFound(template)
+
+    # Check for control characters below 32 (except tab=9, newline=10, CR=13)
+    for char in template:
+        code = ord(char)
+        if code < 32 and code not in (9, 10, 13):
+            raise TemplateNotFound(template)
+
