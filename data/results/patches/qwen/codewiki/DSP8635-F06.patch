+class ShortenInstruction(dspy.Signature):
+    """You are an instruction shortener for large language models. Your task is to shorten a given instruction while preserving its core meaning."""
+
+    long_instruction = dspy.InputField(desc="The original instruction that needs to be shortened")
+    max_chars = dspy.InputField(desc="The maximum number of characters allowed for the shortened instruction")
+    proposed_instruction = dspy.OutputField(
+        desc="A shortened version of the instruction that fits within the character limit",
+        prefix="PROPOSED INSTRUCTION:",
+    )
