+    def _apply_instruction_constraints(self, generated_instruction, predictor, verbose=False):
+        """Apply instruction length constraints and optional rephrasing.
+        
+        Args:
+            generated_instruction: The instruction generated by the LM
+            predictor: The predictor whose canonical instruction may be used as fallback
+            verbose: Whether to print debug information
+            
+        Returns:
+            The constrained instruction string
+        """
+        # Measure length after existing prefix stripping
+        stripped = strip_prefix(generated_instruction)
+        measured_len = len(stripped)
+        
+        # Handle zero cap case
+        if self.max_instr_chars == 0:
+            if verbose:
+                print(f"[Instruction constraint] Zero cap applied, returning empty string")
+            return ""
+        
+        # Case 1: Instruction too short - use canonical basic instruction
+        if measured_len < self.min_instr_chars:
+            if verbose:
+                print(f"[Instruction constraint] Too short ({measured_len} < {self.min_instr_chars}), using canonical basic instruction")
+            basic_instruction = get_signature(predictor).instructions
+            final_len = len(basic_instruction)
+            if final_len > self.max_instr_chars:
+                if verbose:
+                    print(f"[Instruction constraint] Canonical instruction still over max ({final_len} > {self.max_instr_chars}), truncating")
+                basic_instruction = basic_instruction[:self.max_instr_chars]
+            return basic_instruction
+        
+        # Case 2: Instruction too long
+        if measured_len > self.max_instr_chars:
+            if self.rephrase_when_too_long:
+                # Rephrase the instruction
+                if verbose:
+                    print(f"[Instruction constraint] Too long ({measured_len} > {self.max_instr_chars}), attempting rephrase")
+                
+                # Save current LM kwargs to avoid mutation
+                lm_kwargs_snapshot = dict(self.prompt_model.kwargs)
+                
+                try:
+                    # Make exactly one ShortenInstruction call
+                    shorten_pred = dspy.Predict(ShortenInstruction)
+                    with dspy.settings.context(lm=self.prompt_model):
+                        shortened = shorten_pred(
+                            long_instruction=stripped,
+                            max_chars=self.max_instr_chars,
+                        ).proposed_instruction
+                    
+                    # Strip the output prefix
+                    shortened = strip_prefix(shortened)
+                    
+                    # Check if rephrased instruction is valid
+                    if not shortened or len(shortened) < self.min_instr_chars:
+                        if verbose:
+                            print(f"[Instruction constraint] Rephrase failed or too short ({len(shortened)} < {self.min_instr_chars}), falling back to canonical")
+                        # Fall back to canonical basic instruction
+                        basic_instruction = get_signature(predictor).instructions
+                        if len(basic_instruction) > self.max_instr_chars:
+                            if verbose:
+                                print(f"[Instruction constraint] Fallback still over max, truncating")
+                            basic_instruction = basic_instruction[:self.max_instr_chars]
+                        return basic_instruction
+                    
+                    # Hard-truncate if still overlong
+                    if len(shortened) > self.max_instr_chars:
+                        if verbose:
+                            print(f"[Instruction constraint] Rephrase still over max ({len(shortened)} > {self.max_instr_chars}), hard truncating")
+                        shortened = shortened[:self.max_instr_chars]
+                    
+                    return shortened
+                finally:
+                    # Restore LM kwargs
+                    self.prompt_model.kwargs.clear()
+                    self.prompt_model.kwargs.update(lm_kwargs_snapshot)
+            else:
+                # No rephrasing - truncate to last sentence boundary or hard truncate
+                if verbose:
+                    print(f"[Instruction constraint] Too long ({measured_len} > {self.max_instr_chars}), no rephrasing enabled")
+                
+                # Try to find last sentence boundary (. ! or ? followed by whitespace/end)
+                # that fits with one character reserved for …
+                target_len = self.max_instr_chars - 1  # Reserve 1 char for …
+                truncated = None
+                
+                # Search backwards for sentence boundaries
+                for i in range(target_len, -1, -1):
+                    if i < len(stripped):
+                        char = stripped[i]
+                        if char in '.!?':
+                            # Check if followed by whitespace or end
+                            if i + 1 >= len(stripped) or stripped[i+1] in ' \t\n\r':
+                                truncated = stripped[:i].rstrip() + '…'
+                                break
+                
+                if truncated is None:
+                    # Hard truncate
+                    if verbose:
+                        print(f"[Instruction constraint] No sentence boundary found, hard truncating")
+                    truncated = stripped[:self.max_instr_chars - 1] + '…'
+                
+                # Ensure we don't exceed max
+                if len(truncated) > self.max_instr_chars:
+                    truncated = truncated[:self.max_instr_chars]
+                
+                return truncated
+        
+        # Case 3: Instruction is within bounds
+        return stripped
