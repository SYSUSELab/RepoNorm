+class TestInstructionLengthConstraints:
+    """Tests for the new instruction length constraints feature."""
+    
+    def test_min_greater_than_max_raises_error(self):
+        """Test that min > max raises ValueError."""
+        prompt_model = DummyLM([])
+        program = Predict("question -> answer")
+        
+        with pytest.raises(ValueError, match="min_instr_chars must be <= max_instr_chars"):
+            GroundedProposer(
+                prompt_model=prompt_model, 
+                program=program, 
+                trainset=[],
+                min_instr_chars=100,
+                max_instr_chars=50
+            )
+    
+    def test_negative_min_instr_chars_raises_error(self):
+        """Test that negative min_instr_chars raises ValueError."""
+        prompt_model = DummyLM([])
+        program = Predict("question -> answer")
+        
+        with pytest.raises(ValueError, match="min_instr_chars must be non-negative"):
