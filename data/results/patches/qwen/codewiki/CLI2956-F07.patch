+    def _check_param_conflicts(self) -> None:
+        """Check for conflicting options that were both explicitly provided.
+        
+        Raises UsageError if two conflicting options are both from COMMANDLINE
+        or PROMPT sources.
+        """
+        from click.exceptions import UsageError
+        
+        # Build a map of parameter names to their sources
+        param_sources: dict[str, ParameterSource] = {}
+        for name in self._parameter_source:
+            source = self._parameter_source[name]
+            if source in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):
+                param_sources[name] = source
+        
+        # Check each option for conflicts
+        for param in self.command.get_params(self):
+            if not isinstance(param, Option) or not param.conflicts_with:
+                continue
+            
+            # Skip if this option wasn't explicitly provided
+            if param.name not in param_sources:
+                continue
+            
+            # Get the opts for error message
+            opts = param.opts or [param.human_readable_name]
+            
+            for conflict_name in param.conflicts_with:
+                if conflict_name in param_sources:
+                    # Find the conflicting option's opts
+                    conflict_opt = None
+                    for p in self.command.get_params(self):
+                        if p.name == conflict_name and isinstance(p, Option):
+                            conflict_opt = p
+                            break
+                    
+                    conflict_opts = conflict_opt.opts if conflict_opt else [conflict_name]
+                    
+                    raise UsageError(
+                        f"Option '{opts[0]}' cannot be used together with "
+                        f"'{conflict_opts[0]}'."
+                    )
+
 
