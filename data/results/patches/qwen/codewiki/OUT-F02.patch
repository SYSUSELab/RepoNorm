+    def _compile_with_caching(
+        self,
+        compile_fn,
+        source: str,
+        cache: OrderedDict,
+        lock: threading.Lock,
+        in_progress: dict[str, threading.Event],
+    ) -> str:
+        """Compile a grammar with caching support.
+
+        Parameters
+        ----------
+        compile_fn
+            The compilation function to call.
+        source
+            The source string to compile.
+        cache
+            The cache dictionary.
+        lock
+            The lock for thread-safe access.
+        in_progress
+            Dictionary tracking in-progress compilations.
