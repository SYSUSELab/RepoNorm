+    def _evict_if_needed(self, cache: OrderedDict):
+        """Evict least recently used entries if cache exceeds max size."""
+        if self.max_cached_grammars is not None:
+            while len(cache) > self.max_cached_grammars:
+                cache.popitem(last=False)  # Remove oldest entry
