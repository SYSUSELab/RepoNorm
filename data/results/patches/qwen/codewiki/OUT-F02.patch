+                cache.move_to_end(source)
+                return cache[source]
+
+            # Check if compilation is in progress
+            if source in in_progress:
+                # Wait for the in-progress compilation
+                event = in_progress[source]
+                del in_progress[source]  # Remove from tracking before waiting
+                event.wait()
+                # After wait, check if result was cached successfully
+                if source in cache:
