+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, int], str]]] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str], str]]] = None,
+        fallback_npgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, str, int], str]]] = None,
+    ) -> None:
+        """Install gettext callables with optional fallback chains.
+
+        Each fallback argument is an optional finite iterable of callables matching
+        its primary provider's signature. The installer snapshots each iterable when called.
+        A missing or empty iterable behaves like install_gettext_callables. Supplying a
+        non-empty contextual fallback iterable without the matching pgettext or
+        npgettext primary raises ValueError naming the required primary.
+
+        Call the primary provider first. A gettext or pgettext result is missing when
+        it equals the source message. An ngettext or npgettext result is missing when
+        it equals the selected source form: singular for n == 1, plural otherwise. Only
+        on a miss, call matching fallback providers in their declared order and stop at
+        the first non-missing result. If every provider misses, return the selected source
+        message. Provider exceptions propagate without calling later providers. Context
+        providers receive the context string on every attempt.
+        """
+        # Validate that contextual fallbacks require matching primary providers
+        if fallback_pgettext_funcs is not None:
+            try:
+                fallback_pgettext_funcs_list = list(fallback_pgettext_funcs)
+            except TypeError:
+                fallback_pgettext_funcs_list = []
+
+            if fallback_pgettext_funcs_list and pgettext is None:
+                raise ValueError(
+                    "fallback_pgettext_funcs requires pgettext primary provider"
+                )
+
+        if fallback_npgettext_funcs is not None:
+            try:
+                fallback_npgettext_funcs_list = list(fallback_npgettext_funcs)
+            except TypeError:
+                fallback_npgettext_funcs_list = []
+
+            if fallback_npgettext_funcs_list and npgettext is None:
+                raise ValueError(
+                    "fallback_npgettext_funcs requires npgettext primary provider"
+                )
+
+        # Snapshot fallback iterables into lists
+        fallback_gettext_funcs_list = (
+            list(fallback_gettext_funcs) if fallback_gettext_funcs is not None else []
+        )
+        fallback_ngettext_funcs_list = (
+            list(fallback_ngettext_funcs) if fallback_ngettext_funcs is not None else []
+        )
+        fallback_pgettext_funcs_list = (
+            list(fallback_pgettext_funcs) if fallback_pgettext_funcs is not None else []
+        )
+        fallback_npgettext_funcs_list = (
+            list(fallback_npgettext_funcs) if fallback_npgettext_funcs is not None else []
+        )
+
+        # Set newstyle flag if provided
+        if newstyle is not None:
+            self.environment.newstyle_gettext = newstyle  # type: ignore
+
+        # Apply newstyle wrappers to primary providers
+        if self.environment.newstyle_gettext:  # type: ignore
+            gettext = _make_new_gettext(gettext)
+            ngettext = _make_new_ngettext(ngettext)
+
+            if pgettext is not None:
+                pgettext = _make_new_pgettext(pgettext)
+
+            if npgettext is not None:
+                npgettext = _make_new_npgettext(npgettext)
+
+        # Create fallback-aware wrapper functions
+        gettext_wrapper = _make_fallback_gettext(
+            gettext, fallback_gettext_funcs_list, self.environment.newstyle_gettext, self.environment  # type: ignore
+        )
+        ngettext_wrapper = _make_fallback_ngettext(
+            ngettext, fallback_ngettext_funcs_list, self.environment.newstyle_gettext, self.environment  # type: ignore
+        )
+
+        pgettext_wrapper = None
+        if pgettext is not None:
+            pgettext_wrapper = _make_fallback_pgettext(
+                pgettext, fallback_pgettext_funcs_list, self.environment.newstyle_gettext, self.environment  # type: ignore
+            )
+
+        npgettext_wrapper = None
+        if npgettext is not None:
+            npgettext_wrapper = _make_fallback_npgettext(
+                npgettext, fallback_npgettext_funcs_list, self.environment.newstyle_gettext, self.environment  # type: ignore
+            )
+
+        # Update globals with wrapper functions
+        self.environment.globals.update(
+            gettext=gettext_wrapper,
+            ngettext=ngettext_wrapper,
+            pgettext=pgettext_wrapper,
+            npgettext=npgettext_wrapper,
+        )
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
         for key in ("gettext", "ngettext", "pgettext", "npgettext"):
             self.environment.globals.pop(key, None)
