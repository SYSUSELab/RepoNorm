+def _make_fallback_gettext(
+    gettext_func: t.Callable[[str], str],
+    fallback_funcs: t.List[t.Callable[[str], str]],
+    newstyle: bool,
+    env: Environment,
+) -> t.Callable[..., str]:
+    """Create a gettext wrapper with fallback chain support."""
+
+    if newstyle:
+        def gettext(*args: t.Any, **kwargs: t.Any) -> str:
+            # Handle both template calls (with context) and direct Python calls
+            if args and isinstance(args[0], Context):
+                __context = args[0]
+                __string = args[1] if len(args) > 1 else kwargs.get('__string')
+                variables = {k: v for k, v in kwargs.items() if k != '__string'}
+            else:
+                # Direct call from Python code
+                __string = args[0] if args else kwargs.get('__string')
+                # Create minimal context for formatting/autoescaping
+                eval_ctx = EvalContext(env, '')
+                # For direct Python calls, we need to handle both context-aware and non-context-aware functions
+                def fake_call(context, func, *args, **kwargs):
+                    import inspect
+                    sig = inspect.signature(func)
+                    params = list(sig.parameters.keys())
+                    if len(params) > 0 and params[0] == '__context':
+                        # Function expects context
+                        result = func(context, *args, **kwargs)
+                        return result
+                    else:
+                        # Function doesn't expect context
+                        result = func(*args, **kwargs)
+                        return result
+                
+                __context = type('FakeContext', (), {
+                    'call': fake_call,
+                    'eval_ctx': eval_ctx,
+                    'resolve': lambda _, name: globals().get(name)
+                })()
+                variables = {}
+
+            # Try primary provider first
+            rv = __context.call(gettext_func, __string)
+
+            # Check if result is missing (equals source message)
+            if rv == __string:
+                # Try fallback providers in order
+                for fallback_func in fallback_funcs:
+                    try:
+                        rv = __context.call(fallback_func, __string)
+                        if rv is not None and rv != __string:
+                            break
+                    except Exception:
+                        # Provider exception propagates without calling later providers
+                        raise
+
+            # If no provider returned a translation, return source message
+            if rv is None:
+                rv = __string
+            
+            # Apply newstyle formatting and autoescaping
+            if __context.eval_ctx.autoescape:
+                rv = Markup(rv)
+            return rv % variables  # type: ignore
+
+        return gettext
+    else:
+        def gettext(__string: str, **variables: t.Any) -> str:
+            # Try primary provider first
+            rv = gettext_func(__string)
+
+            # Check if result is missing (equals source message)
+            if rv == __string:
+                # Try fallback providers in order
+                for fallback_func in fallback_funcs:
+                    try:
+                        rv = fallback_func(__string)
+                        if rv is not None and rv != __string:
+                            break
+                    except Exception:
+                        # Provider exception propagates without calling later providers
+                        raise
+
+            # If no provider returned a translation, return source message
+            if rv is None:
+                rv = __string
+            
+            # Apply newstyle formatting
+            return rv % variables  # type: ignore
+
+        return gettext
