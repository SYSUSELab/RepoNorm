+def _create_backup(filename: str) -> str:
+    """Create a backup of the given file.
+
+    Returns the path to the backup file. Raises ClickException on failure.
+    """
+    import os
+    import shutil
+    from datetime import datetime
+
+    from .exceptions import ClickException
+
+    # Check if file exists
+    if not os.path.isfile(filename):
+        return ""  # No backup needed for non-existing files
+
+    # Generate backup filename with timestamp
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+    base_name = filename + ".backup." + timestamp
+
+    # Handle collision by adding a counter suffix
+    backup_path = base_name
+    counter = 1
+    while os.path.exists(backup_path):
+        backup_path = f"{base_name}.{counter}"
+        counter += 1
+
+    # Copy file preserving metadata (including permissions)
+    try:
+        shutil.copy2(filename, backup_path)
+    except OSError as e:
+        raise ClickException(f"Failed to create backup file: {e}") from e
+
+    return backup_path
+
