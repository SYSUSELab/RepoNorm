+    You can also filter groups based on their members using the
+    ``filter_groups`` parameter. The predicate receives the complete
+    member list of each group and should return a truthy value to retain
+    the group. If ``None`` (the default), all groups are retained.
+
+    .. sourcecode:: jinja
+
+        {# Only keep groups with at least 2 members #}
+        <ul>{% for city, items in users|groupby("city", filter_groups=lambda x: len(x) >= 2) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,10 +1224,28 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+    result = []
+    for key, values in groupby(sorted(value, key=expr), expr):
+        values_list = list(values)
+        if filter_groups is None:
+            result.append(_GroupTuple(key, values_list))
+        else:
+            # Check if filter_groups expects environment as first argument
+            pass_arg = _PassArg.from_obj(filter_groups)
+            if pass_arg is _PassArg.environment:
+                # Call with environment first
+                predicate_result = filter_groups(environment, values_list)
+            else:
+                # Call without environment
+                predicate_result = filter_groups(values_list)
+            
+            # In sync mode, awaitables should not be treated as truthy
+            if inspect.isawaitable(predicate_result):
+                continue
+            
+            if predicate_result:
+                result.append(_GroupTuple(key, values_list))
+    return result
 
 
