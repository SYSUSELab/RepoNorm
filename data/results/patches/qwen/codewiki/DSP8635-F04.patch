+def truncate_description(description, max_chars):
+    """
+    Truncate a description to be no longer than max_chars characters.
+
+    Args:
+        description: The string to truncate
+        max_chars: Maximum number of characters allowed (None disables the limit)
+                   Must be a positive integer or None
+
+    Returns:
+        The truncated description with ellipsis if needed
+
+    Raises:
+        ValueError: If max_chars is not None and not a positive non-boolean integer
+    """
+    # Validate max_chars
+    if max_chars is not None:
+        # Check for boolean first (bool is subclass of int in Python)
+        if isinstance(max_chars, bool):
+            raise ValueError("max_chars must be a positive integer or None, not a boolean")
+        if not isinstance(max_chars, int):
+            raise ValueError("max_chars must be a positive integer or None")
+        if max_chars <= 0:
+            raise ValueError("max_chars must be a positive integer or None")
+
+    # None disables the limit - return as-is
+    if max_chars is None:
+        return description
+
+    # Cap of one produces only …
+    if max_chars == 1:
+        return "…"
+
+    # If description is already within the cap, return unchanged
+    if len(description) <= max_chars:
+        return description
+
+    # Reserve one character for the ellipsis
+    cap = max_chars - 1
+
+    # Try to find the last complete sentence ending that fits
+    # Sentence endings are . ! or ? followed by whitespace or end of string
+    result = description[:cap]
+
+    # Look for sentence endings in the truncated portion
+    # Pattern: . ! or ? followed by whitespace or end
+    import re
+    matches = list(re.finditer(r'[.!?](?:\s|$)', result))
+
+    if matches:
+        # Get the last match position
+        last_match = matches[-1]
+        # Include the full sentence ending (the punctuation + whitespace)
+        end_pos = last_match.end()
+        if end_pos <= cap:
+            result = description[:end_pos]
+
+    # Remove trailing whitespace from the prefix
+    result = result.rstrip()
+
+    # Append ellipsis
+    result += "…"
+
+    return result
