+"""URL validation."""
+
+import collections.abc
+from typing import Any, Collection, Optional, Set, Tuple, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsURL(DirtyEquals[str]):
+    """A class that checks if a value is a valid URL, optionally checking protocol or domain."""
+
+    def __init__(
+        self,
+        protocol: Union[None, str, Collection[str]] = None,
+        domain: Union[None, str] = None,
+    ):
+        """
+        Initialize IsURL validator.
+
+        Args:
+            protocol: A single protocol string or collection of allowed protocols.
+                     If None, any protocol is allowed.
+            domain: The domain to match against the URL's netloc (including port).
+                   If None, any domain is allowed.
+        """
+        if isinstance(protocol, str):
+            protocol = {protocol}
+        elif protocol is not None and not isinstance(protocol, collections.abc.Collection):
+            raise TypeError('protocol must be a string or collection of strings')
+
+        if domain is not None and not isinstance(domain, str):
+            raise TypeError('domain must be a string or None')
+
+        # Build repr args based on what's specified
+        repr_args_list = []
+        
+        # Add protocol or wildcard placeholder
+        if protocol is None:
+            # Use plain_repr for single '*' case, regular string for multiple args
+            if domain is None:
+                repr_args_list.append(plain_repr('*'))
+            else:
+                repr_args_list.append('*')
+        else:
+            repr_args_list.append(str(next(iter(protocol))))
+
+        # Add domain if specified
+        if domain is not None:
+            repr_args_list.append(domain)
+
+        super().__init__(*repr_args_list)
+        self.protocol = protocol
+        self.domain = domain
+
+    def equals(self, other: Any) -> bool:
+        """Check if the given value is a valid URL matching the criteria."""
+        if not isinstance(other, str):
+            return False
+
+        try:
+            from urllib.parse import urlparse
+        except ImportError:
+            # Fallback for environments without urlparse
+            return False
+
+        parsed = urlparse(other)
+
+        # Check if URL has a scheme (protocol)
+        if not parsed.scheme:
+            return False
+
+        # Check if URL has a netloc (network location)
+        if not parsed.netloc:
+            return False
+
+        # Check protocol if specified
+        if self.protocol is not None:
+            if parsed.scheme not in self.protocol:
+                return False
+
+        # Check domain if specified
+        if self.domain is not None:
+            if parsed.netloc != self.domain:
+                return False
+
+        return True
