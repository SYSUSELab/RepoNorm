+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('https://example.com', IsURL()),
+        ('http://example.com/path', IsURL()),
+        ('ftp://files.example.com/file.txt', IsURL()),
+        ('https://user:pass@example.com', IsURL()),
+        ('https://sub.example.com', IsURL()),
+        ('https://example.com/', IsURL()),
+        ('https://example.com?query=1', IsURL()),
+        ('https://example.com#hash', IsURL()),
+        ('https://example.com:8080', IsURL()),
+        ('https://example.com:8080/path', IsURL()),
+    ],
+)
+def test_is_url_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('foobar', IsURL()),
+        (123, IsURL()),
+        (None, IsURL()),
+        ([], IsURL()),
+        ({}, IsURL()),
+        ('example.com', IsURL()),  # No protocol
+        ('//example.com', IsURL()),  # No protocol
+    ],
+)
+def test_is_url_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_url_protocol_true():
+    assert 'https://example.com' == IsURL('https')
+    assert 'http://example.com' == IsURL({'https', 'http'})
+    assert 'ftp://example.com' == IsURL({'ftp', 'http'})
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('http://example.com', IsURL('https')),
+        ('ftp://example.com', IsURL('https')),
+        ('ws://example.com', IsURL({'https', 'http'})),
+    ],
+)
+def test_is_url_protocol_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_url_domain_true():
+    assert 'https://example.com' == IsURL(domain='example.com')
+    assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+    assert 'https://example.com:8080/path' == IsURL(domain='example.com:8080')
+    assert 'https://user:pass@example.com' == IsURL(domain='user:pass@example.com')
