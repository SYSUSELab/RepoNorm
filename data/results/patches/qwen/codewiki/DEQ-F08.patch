@@ -0,0 +1,108 @@
+import re
+from typing import Any, Optional, Pattern, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsRegex(DirtyEquals[str]):
+    """
+    A class that checks if a value is a string that matches a regular expression pattern.
+
+    `IsRegex` supports three modes of matching:
+    - `match`: Matches at the beginning of the string (default)
+    - `search`: Searches anywhere in the string
+    - `fullmatch`: Requires the entire string to match
+
+    Args:
+        pattern: Regular expression pattern as a string or compiled regex object.
+        flags: Optional regex flags (e.g., `re.IGNORECASE`, `re.MULTILINE`).
+            These are ignored if a compiled pattern is passed.
+        mode: One of `'match'`, `'search'`, or `'fullmatch'`. Default is `'match'`.
+
+    Examples:
+        ```py title="IsRegex"
+        from dirty_equals import IsRegex
+        import re
+
+        assert "hello world" == IsRegex("hello")
+        assert "hello world" == IsRegex("world", mode="search")
+        assert "hello" == IsRegex("hello", mode="fullmatch")
+        assert "hello" != IsRegex("hello", mode="fullmatch", flags=re.I)
+
+        # Compiled patterns work too
+        pattern = re.compile(r"\d+")
+        assert "123" == IsRegex(pattern)
+        assert "abc" != IsRegex(pattern)
+        ```
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, Pattern[str]],
+        flags: int = 0,
+        *,
+        mode: Literal["match", "search", "fullmatch"] = "match",
+    ):
+        self.pattern: str
+        self.flags: int
+        self.mode: str
+
+        if isinstance(pattern, bytes):
+            raise TypeError("IsRegex does not support bytes patterns")
+
+        if mode not in ("match", "search", "fullmatch"):
+            raise ValueError(f"Invalid mode: {mode!r}. Must be 'match', 'search', or 'fullmatch'.")
+
+        if isinstance(pattern, re.Pattern):
+            # Check if external flags are provided with a compiled pattern
+            if flags != 0:
+                raise ValueError(
+                    f"Cannot pass flags when pattern is already compiled. "
+                    f"Pattern has flags: {pattern.flags}"
+                )
+            self.pattern = pattern.pattern
+            self.flags = pattern.flags
+        elif isinstance(pattern, str):
+            # Validate the pattern by compiling it
+            try:
+                re.compile(pattern, flags)
+            except re.error:
+                raise
+            self.pattern = pattern
+            self.flags = flags
+        else:
+            # Invalid pattern type - let re.compile handle it
+            re.compile(pattern, flags)
+            # This shouldn't happen, but just in case
+            self.pattern = str(pattern)
+            self.flags = flags
+
+        self.mode = mode
+
+        # Build repr arguments
+        repr_args: list[Any] = [plain_repr(repr(self.pattern))]
+        if self.flags != 0:
+            repr_args.append(plain_repr(f"flags={int(self.flags)}"))
+        if self.mode != "match":
+            repr_args.append(plain_repr(f"mode={self.mode!r}"))
+
+        super().__init__(*repr_args)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.mode == "match":
+            result = re.match(self.pattern, other, flags=self.flags)
+        elif self.mode == "search":
+            result = re.search(self.pattern, other, flags=self.flags)
+        else:  # fullmatch
+            result = re.fullmatch(self.pattern, other, flags=self.flags)
+
+        return result is not None
