+import pytest
+
+from dirty_equals import IsColor
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        # Hex colors with #
+        ('#FF5733', IsColor()),
+        ('#f57', IsColor()),
+        ('#ABCDEF', IsColor()),
+        ('#abc', IsColor()),
+        # Hex colors without #
+        ('FF5733', IsColor()),
+        ('f57', IsColor()),
+        ('ABCDEF', IsColor()),
+        ('abc', IsColor()),
+        # RGB colors with integers
+        ('rgb(255, 87, 51)', IsColor()),
+        ('RGB(255, 87, 51)', IsColor()),
+        ('rgb(0, 0, 0)', IsColor()),
+        ('rgb(255, 255, 255)', IsColor()),
+        # RGB colors with percentages
+        ('rgb(100%, 50%, 25%)', IsColor()),
+        ('RGB(100%, 0%, 100%)', IsColor()),
+        ('rgb(0%, 0%, 0%)', IsColor()),
+        # HSL colors
+        ('hsl(14, 100%, 60%)', IsColor()),
+        ('HSL(14, 100%, 60%)', IsColor()),
+        ('hsl(0, 0%, 0%)', IsColor()),
+        ('hsl(360, 100%, 100%)', IsColor()),
+        # HSL with deg suffix
+        ('hsl(14deg, 100%, 60%)', IsColor()),
+        ('HSL(14deg, 100%, 60%)', IsColor()),
+        # Whitespace tolerance
+        ('  #FF5733  ', IsColor()),
+        (' rgb(255, 87, 51) ', IsColor()),
+        (' hsl(14, 100%, 60%) ', IsColor()),
+        ('rgb( 255 , 87 , 51 )', IsColor()),
+        ('hsl( 14 , 100% , 60% )', IsColor()),
+    ],
+)
+def test_is_color_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        # Invalid hex
+        ('#GGG', IsColor()),
+        ('#FF57', IsColor()),
+        ('#FF57333', IsColor()),
+        ('XYZ', IsColor()),
+        # Out of range RGB values
+        ('rgb(256, 0, 0)', IsColor()),
+        ('rgb(-1, 0, 0)', IsColor()),
+        ('rgb(101%, 0%, 0%)', IsColor()),
+        ('rgb(-10%, 0%, 0%)', IsColor()),
+        # Out of range HSL values
+        ('hsl(361, 0%, 0%)', IsColor()),
+        ('hsl(-1, 0%, 0%)', IsColor()),
+        ('hsl(14, 101%, 60%)', IsColor()),
+        ('hsl(14, -1%, 60%)', IsColor()),
+        ('hsl(14, 0%, 101%)', IsColor()),
+        ('hsl(14, 0%, -1%)', IsColor()),
+        # Wrong format when format specified
+        ('#FF5733', IsColor('rgb')),
+        ('rgb(255, 87, 51)', IsColor('hex')),
+        ('hsl(14, 100%, 60%)', IsColor('hex')),
+        ('#FF5733', IsColor('hsl')),
+        ('rgb(255, 87, 51)', IsColor('hsl')),
+        ('hsl(14, 100%, 60%)', IsColor('rgb')),
+        # Non-string values
+        (123, IsColor()),
+        ([], IsColor()),
+        ({}, IsColor()),
+        (None, IsColor()),
+        (True, IsColor()),
+        # Malformed colors
+        ('rgb(255, 87)', IsColor()),
+        ('rgb(255)', IsColor()),
+        ('hsl(14, 100%)', IsColor()),
+        ('hsl(14)', IsColor()),
+        ('rgba(255, 87, 51, 0.5)', IsColor()),
+        ('hsla(14, 100%, 60%, 0.5)', IsColor()),
+        # Named colors
+        ('red', IsColor()),
+        ('blue', IsColor()),
+        ('transparent', IsColor()),
+    ],
+)
+def test_is_color_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_color_repr():
+    is_color = IsColor()
+    assert str(is_color) == 'IsColor(*)'
+
+
+def test_is_color_hex_repr():
+    is_color = IsColor('hex')
+    assert str(is_color) == "IsColor('hex')"
+
+
+def test_is_color_rgb_repr():
+    is_color = IsColor('rgb')
+    assert str(is_color) == "IsColor('rgb')"
+
+
+def test_is_color_hsl_repr():
+    is_color = IsColor('hsl')
+    assert str(is_color) == "IsColor('hsl')"
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('#FF5733', IsColor('hex')),
+        ('#f57', IsColor('hex')),
+        ('FF5733', IsColor('hex')),
+        ('f57', IsColor('hex')),
+        ('rgb(255, 87, 51)', IsColor('rgb')),
+        ('RGB(255, 87, 51)', IsColor('rgb')),
+        ('rgb(100%, 50%, 25%)', IsColor('rgb')),
+        ('hsl(14, 100%, 60%)', IsColor('hsl')),
+        ('HSL(14deg, 100%, 60%)', IsColor('hsl')),
+    ],
+)
+def test_is_color_format_specific_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        ('#FF5733', IsColor('rgb')),
+        ('#FF5733', IsColor('hsl')),
+        ('rgb(255, 87, 51)', IsColor('hex')),
+        ('rgb(255, 87, 51)', IsColor('hsl')),
+        ('hsl(14, 100%, 60%)', IsColor('hex')),
+        ('hsl(14, 100%, 60%)', IsColor('rgb')),
+    ],
+)
+def test_is_color_format_specific_false(other, dirty):
+    assert other != dirty
