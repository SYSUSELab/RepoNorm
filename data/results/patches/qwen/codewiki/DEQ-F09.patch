+import re
+from typing import Any, Literal, Optional, Tuple, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal as TypingLiteral
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsColor(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid color code.
+
+    Supports three color formats: hexadecimal, RGB, and HSL.
+
+    Args:
+        format: The expected color format ('hex', 'rgb', or 'hsl'). If omitted, any supported format is accepted.
+
+    Supported formats:
+
+    - **Hexadecimal**: Optional `#` prefix followed by 3 or 6 hex digits.
+      Examples: `'#FF5733'`, `'#f57'`, `'FF5733'`, `'f57'`
+
+    - **RGB**: `rgb()` function with three integer (0-255) or percentage (0-100%) components.
+      Examples: `'rgb(255, 87, 51)'`, `'RGB(255, 87, 51)'`, `'rgb(100%, 50%, 25%)'`
+
+    - **HSL**: `hsl()` function with hue (0-360, optional `deg` suffix), saturation (0-100%), and lightness (0-100%).
+      Examples: `'hsl(14, 100%, 60%)'`, `'HSL(14deg, 100%, 60%)'`, `'hsl(14 deg, 100%, 60%)'`
+
+    Whitespace is allowed around values and between components, but not inside numbers or between function name and `(`.
+
+    Examples:
+    ```py title="IsColor"
+    from dirty_equals import IsColor
+
+    assert '#FF5733' == IsColor()
+    assert '#f57' == IsColor()
+    assert 'FF5733' == IsColor()
+    assert 'rgb(255, 87, 51)' == IsColor()
+    assert 'RGB(255, 87, 51)' == IsColor()
+    assert 'hsl(14, 100%, 60%)' == IsColor()
+    assert 'HSL(14deg, 100%, 60%)' == IsColor()
+
+    assert '#FF5733' == IsColor('hex')
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+
+    assert '#FF5733' != IsColor('rgb')
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+    ```
+    """
+
+    def __init__(
+        self,
+        format: Optional[Literal['hex', 'rgb', 'hsl']] = None,
+    ):
+        """
+        Args:
+            format: The expected color format ('hex', 'rgb', or 'hsl'). If omitted, any supported format is accepted.
+        """
+        self.format = format
+        super().__init__(plain_repr('*') if format is None else format)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        value = other.strip()
+        if not value:
+            return False
+
+        # Try each format based on the specified constraint
+        if self.format is None:
+            # Try all formats
+            if self._is_hex(value):
+                return True
+            if self._is_rgb(value):
+                return True
+            if self._is_hsl(value):
+                return True
+            return False
+        elif self.format == 'hex':
+            return self._is_hex(value)
+        elif self.format == 'rgb':
+            return self._is_rgb(value)
+        elif self.format == 'hsl':
+            return self._is_hsl(value)
+        else:
+            return False
+
+    def _is_hex(self, value: str) -> bool:
+        """Check if value is a valid hex color."""
+        # Optional # followed by 3 or 6 hex digits
+        pattern = r'^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$'
+        return bool(re.fullmatch(pattern, value))
+
+    def _is_rgb(self, value: str) -> bool:
+        """Check if value is a valid rgb() color."""
+        # rgb() function with case-insensitive name
+        # Components are integers 0-255 or percentages 0-100%
+        # Whitespace allowed around components but not inside numbers
+        
+        # Pattern for rgb function
+        pattern = r'^rgb\s*\(\s*([^,]+)\s*,\s*([^,]+)\s*,\s*([^)]+)\s*\)$'
+        match = re.fullmatch(pattern, value, re.IGNORECASE)
+        
+        if not match:
+            return False
+        
+        r_str, g_str, b_str = match.groups()
+        
+        # Validate each component
+        return (self._validate_rgb_component(r_str) and 
+                self._validate_rgb_component(g_str) and 
+                self._validate_rgb_component(b_str))
+
+    def _validate_rgb_component(self, component: str) -> bool:
+        """Validate an RGB component (integer 0-255 or percentage 0-100%)."""
+        component = component.strip()
+        
+        # Check for percentage
+        if component.endswith('%'):
+            num_part = component[:-1]
+            # Must be 1-3 digits, no signs or fractions
+            if not re.fullmatch(r'[0-9]{1,3}', num_part):
+                return False
+            try:
+                num = int(num_part)
+                return 0 <= num <= 100
+            except ValueError:
+                return False
+        
+        # Check for integer
+        if re.fullmatch(r'[0-9]{1,3}', component):
+            try:
+                num = int(component)
+                return 0 <= num <= 255
+            except ValueError:
+                return False
+        
+        return False
+
+    def _is_hsl(self, value: str) -> bool:
+        """Check if value is a valid hsl() color."""
+        # hsl() function with case-insensitive name
+        # Hue is 0-360 with optional deg suffix
+        # Saturation and lightness are percentages 0-100%
+        # Whitespace allowed around components but not inside numbers or between hue and deg
+        
+        # Pattern for hsl function
+        pattern = r'^hsl\s*\(\s*([^,]+)\s*,\s*([^,]+)\s*,\s*([^)]+)\s*\)$'
+        match = re.fullmatch(pattern, value, re.IGNORECASE)
+        
+        if not match:
+            return False
+        
+        h_str, s_str, l_str = match.groups()
+        
+        # Validate each component
+        return (self._validate_hsl_hue(h_str) and 
+                self._validate_hsl_component(s_str) and 
+                self._validate_hsl_component(l_str))
+
+    def _validate_hsl_hue(self, hue: str) -> bool:
+        """Validate HSL hue component (0-360 with optional deg suffix)."""
+        hue = hue.strip()
+        
+        # Check for deg suffix
+        if hue.lower().endswith('deg'):
+            num_part = hue[:-3]
+            # Must be 1-3 digits, no signs or fractions
+            if not re.fullmatch(r'[0-9]{1,3}', num_part):
+                return False
+            try:
+                num = int(num_part)
+                return 0 <= num <= 360
+            except ValueError:
+                return False
+        
+        # Check for number without deg suffix
+        if re.fullmatch(r'[0-9]{1,3}', hue):
+            try:
+                num = int(hue)
+                return 0 <= num <= 360
+            except ValueError:
+                return False
+        
+        return False
+
+    def _validate_hsl_component(self, component: str) -> bool:
+        """Validate HSL saturation/lightness component (percentage 0-100%)."""
+        component = component.strip()
+        
+        # Must end with %
+        if not component.endswith('%'):
+            return False
+        
+        num_part = component[:-1]
+        # Must be 1-3 digits, no signs or fractions
+        if not re.fullmatch(r'[0-9]{1,3}', num_part):
+            return False
+        
+        try:
+            num = int(num_part)
+            return 0 <= num <= 100
+        except ValueError:
+            return False
