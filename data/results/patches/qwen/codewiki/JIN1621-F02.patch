+    # Normalize separators: replace both / and \ with / for consistent processing
+    normalized = template.replace("\\", "/")
+
+    # Split into segments
+    pieces = []
+    for piece in normalized.split("/"):
+        if piece == "..":
+            # .. should remove the preceding ordinary segment
+            if not pieces:
+                # This would pop beyond the root - reject
+                raise TemplateNotFound(template)
+            pieces.pop()
         elif piece and piece != ".":
