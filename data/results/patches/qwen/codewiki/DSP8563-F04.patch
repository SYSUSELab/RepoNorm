+        def __init__(self, **data):
+            super().__init__(**data)
+            self._compute_fingerprint_and_id()
+
+        def _compute_fingerprint_and_id(self):
+            """Compute fingerprint and id once at construction."""
+            # Validate args
+            validate_args(self.args)
+
+            # Canonicalize args
+            canonical_args = canonicalize_args(self.args)
+
+            # Create the canonical JSON object
+            obj = {"name": self.name, "args": canonical_args}
+
+            # Serialize with sorted keys and compact separators
+            json_str = json.dumps(obj, sort_keys=True, separators=(',', ':'), ensure_ascii=True)
+
+            # Compute SHA-256
+            fingerprint = hashlib.sha256(json_str.encode('utf-8')).hexdigest()
+
+            # Store as private attributes
+            object.__setattr__(self, '_fingerprint', fingerprint)
+            object.__setattr__(self, '_id', fingerprint[:8])
+
+        @property
+        def fingerprint(self) -> str:
+            return self._fingerprint
+
+        @property
+        def id(self) -> str:
+            return self._id
+
+        def model_dump(self, *args, **kwargs):
+            # Override to exclude fingerprint and id by default
+            result = super().model_dump(*args, **kwargs)
+            result.pop('_fingerprint', None)
+            result.pop('_id', None)
+            return result
