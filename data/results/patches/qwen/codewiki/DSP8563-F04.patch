+def canonicalize_args(args: Any) -> Any:
+    """Canonicalize args for fingerprinting.
+
+    Recursively sort dictionary keys, treat tuples as lists, and trim whitespace from strings.
+    Preserve numeric/boolean types and list order; do not trim dictionary keys or tool name.
+    """
+    if isinstance(args, dict):
+        return {k: canonicalize_args(v) for k, v in sorted(args.items())}
+    elif isinstance(args, tuple):
+        return [canonicalize_args(item) for item in args]
+    elif isinstance(args, str):
+        return args.strip()
+    else:
+        return args
+
+
+def validate_args(args: Any) -> None:
+    """Validate that args contains only JSON-compatible values.
+
+    Reject nonfinite numbers and non-JSON values with ValueError.
+    """
+    if isinstance(args, dict):
+        for k, v in args.items():
+            if not isinstance(k, str):
+                raise ValueError(f"Dictionary keys must be strings, got {type(k)}")
+            validate_args(v)
+    elif isinstance(args, (tuple, list)):
+        for item in args:
+            validate_args(item)
+    elif isinstance(args, float):
+        if not (args == args and abs(args) != float('inf')):  # Check for NaN and inf
+            raise ValueError("Non-finite numbers are not allowed")
+    elif isinstance(args, bool):
+        pass  # booleans are valid
+    elif isinstance(args, int):
+        pass  # integers are valid
+    elif isinstance(args, str):
+        pass  # strings are valid
+    elif args is None:
+        pass  # null is valid
+    else:
+        raise ValueError(f"Unsupported type: {type(args)}")
+
+
 
 class ToolCalls(Type):
     class ToolCall(BaseModel):
+        model_config = ConfigDict(frozen=True)
