+def _make_groupby_key(key):
+    """Create a sort key that orders: normal keys < None < missing/undefined.
+
+    This ensures that:
+    1. Normal comparable keys come first (including empty string in string order)
+    2. Then None values
+    3. Then missing/Undefined values
+
+    Returns a tuple (type_index, value) where type_index is:
+    - 0 for normal keys
+    - 1 for None
+    - 2 for missing/Undefined
+
+    For missing/undefined values, we use a sentinel to avoid comparison issues
+    between different types of missing values.
+    """
+    if key is missing or isinstance(key, Undefined):
+        # Return a high value for missing/undefined with a consistent sentinel
+        return (2, "___MISSING___")
+    elif key is None:
+        # Return middle value for None
+        return (1, None)
+    else:
+        # Return low value for normal keys
+        return (0, key)
+
