+def register_filter(name: str, func: Callable):
+    """Register a global filter for prompts.
+
+    Registered filters are available to all prompts constructed after registration,
+    including through bare `@outlines.prompt`, `Prompt.from_str`, and `Prompt.from_file`,
+    including included and inherited file templates.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter.
+    func : Callable
+        The filter function to register.
+
+    Notes
+    -----
+    - Registering an existing name replaces its registered callable.
+    - Unregistering an unknown name is a no-op.
+    - Registry changes affect only templates constructed after the change.
+    - Existing `Prompt` instances retain the filter callable captured by their Jinja environment.
+    - The Outlines-specific filters (`name`, `description`, `source`, `signature`, `schema`,
+      and `args`) are protected and cannot be overridden by global filters.
+    """
+    _global_filters[name] = func
+
+
+def unregister_filter(name: str):
+    """Unregister a global filter for prompts.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter to unregister.
+
+    Notes
+    -----
+    - Unregistering an unknown name is a no-op.
+    - The Outlines-specific filters (`name`, `description`, `source`, `signature`, `schema`,
+      and `args`) are protected and cannot be unregistered.
+    """
+    if name in _global_filters:
+        del _global_filters[name]
+
