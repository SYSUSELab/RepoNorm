+# Hash algorithm specifications: (name_lower, hex_length)
+_HASH_ALGORITHMS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hexadecimal hash string for a given algorithm.
+
+    Supported algorithms: MD5, SHA1, SHA224, SHA256, SHA384, SHA512 (case-insensitive).
+
+    Examples:
+    ```py title="IsHash"
+    from dirty_equals import IsHash
+
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+    assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('SHA1')
+    assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == IsHash('sha256')
+
+    assert 'invalid' != IsHash('md5')
+    assert 'too short' != IsHash('md5')
+    assert 'x' * 33 != IsHash('md5')  # Too long
+    assert 123 != IsHash('md5')  # Not a string
+    ```
+    """
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm to validate against.
+                Supported values: 'MD5', 'SHA1', 'SHA224', 'SHA256', 'SHA384', 'SHA512'
+                (case-insensitive).
+
+        Raises:
+            ValueError: If the algorithm is not supported.
+        """
+        self.algorithm = algorithm
+        self._algorithm_lower = algorithm.lower()
+        
+        if self._algorithm_lower not in _HASH_ALGORITHMS:
+            raise ValueError(
+                f"Unsupported hash algorithm: {algorithm!r}. "
+                f"Supported algorithms: {', '.join(sorted(_HASH_ALGORITHMS.keys()))}"
+            )
+        
+        self._hex_length = _HASH_ALGORITHMS[self._algorithm_lower]
+        super().__init__(plain_repr(algorithm))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        
+        # Check length first
+        if len(other) != self._hex_length:
+            return False
+        
+        # Check if all characters are valid hexadecimal
+        try:
+            int(other, 16)
+        except ValueError:
+            return False
+        
+        return True
+
+
