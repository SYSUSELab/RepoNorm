+    def extract_translations_with_metadata(
+        self, source: str, source_name: t.Optional[str] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract translation blocks with their metadata.
+        
+        Returns an iterator of independent record mappings for metadata-bearing
+        translation blocks. Each record contains:
+        - source: the original source string
+        - lineno: the block's line number
+        - metadata: a copy of the metadata mapping (note, created, modified)
+        - messages: list of message dicts with lineno, function, and message
+        
+        Repeated extraction is stable and has no retained Environment state;
+        callers may modify returned records without affecting later results.
+        """
+        from .ext import extract_translations_with_metadata as ext_extract
+        
+        # Get the InternationalizationExtension if available
+        for ext in self.iter_extensions():
+            if type(ext).__name__ == "InternationalizationExtension":
+                break
+        else:
+            # No i18n extension, nothing to extract
+            return
+        
+        yield from ext_extract(source, self)
+
 
