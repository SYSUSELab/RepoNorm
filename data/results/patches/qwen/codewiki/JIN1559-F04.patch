+def extract_translations_with_metadata(
+    source: t.Union[str, nodes.Template],
+    environment: "Environment",
+) -> t.Iterator[t.Dict[str, t.Any]]:
+    """Extract translations with metadata from a template source.
+    
+    Returns an iterator of independent record mappings for metadata-bearing 
+    translation blocks. Each record contains:
+    - source: the template source (or empty string if Template node provided)
+    - lineno: the line number of the trans block start
+    - metadata: a copy of the metadata mapping (note, created, modified)
+    - messages: list of message records with lineno, function, and message
+    
+    Repeated extraction is stable and has no retained Environment state;
+    callers may modify returned records without affecting later results.
+    """
+    from .nodes import Output, Mod, Call, Name, Const, MarkSafeIfAutoescape, Dict, Pair
+    
+    # Parse the source if it's a string
+    if isinstance(source, str):
+        ast = environment.parse(source)
+    else:
+        ast = source
+    
+    # Iterate through all Output nodes that have metadata
+    for node in ast.find_all(Output):
+        if hasattr(node, 'metadata') and node.metadata:
+            trans_lineno = node.lineno
+            
+            # Extract messages from this block
+            messages = []
+            for msg_node in node.nodes:
+                # Handle both Mod nodes and direct MarkSafeIfAutoescape nodes
+                if isinstance(msg_node, Mod):
+                    left = msg_node.left
+                else:
+                    left = msg_node
+                
+                # Unwrap MarkSafeIfAutoescape if present
+                if isinstance(left, MarkSafeIfAutoescape):
+                    left = left.expr
+                
+                # Get the call node (gettext, ngettext, pgettext, etc.)
+                if isinstance(left, Call):
+                    call_node = left
+                    args = call_node.args
+                    
+                    # Determine the function name
+                    if isinstance(call_node.node, Name):
+                        func_name = call_node.node.name
+                    else:
+                        func_name = '_'
+                    
+                    # Get the message(s)
+                    if args:
+                        if len(args) == 1:
+                            first_arg = args[0]
+                            if isinstance(first_arg, Const):
+                                # Singular message
+                                messages.append({
+                                    'lineno': trans_lineno,
+                                    'function': func_name,
+                                    'message': first_arg.value,
+                                })
+                            elif isinstance(first_arg, Dict):
+                                # Contextual message (plural forms)
+                                plural_forms = []
+                                for pair in first_arg.items:
+                                    if isinstance(pair, Pair) and isinstance(pair.key, Const):
+                                        plural_forms.append(pair.key.value)
+                                
+                                messages.append({
+                                    'lineno': trans_lineno,
+                                    'function': func_name,
+                                    'message': tuple(plural_forms),
+                                })
+                        elif len(args) >= 2:
+                            # Plural form (ngettext): singular, plural, [num]
+                            singular = None
+                            plural = None
+                            for arg in args[:2]:
+                                if isinstance(arg, Const):
+                                    if singular is None:
+                                        singular = arg.value
+                                    else:
+                                        plural = arg.value
+                            
+                            if singular is not None or plural is not None:
+                                messages.append({
+                                    'lineno': trans_lineno,
+                                    'function': func_name,
+                                    'message': (singular, plural),
+                                })
+            
+            yield {
+                'source': source if isinstance(source, str) else '',
+                'lineno': trans_lineno,
+                'metadata': dict(node.metadata),
+                'messages': messages,
+            }
