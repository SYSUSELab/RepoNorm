+class _FileChecker:
+    """Internal class to track file states for change detection."""
+
+    def __init__(self, searchpath: t.List[str]):
+        self.searchpath = searchpath
+        self._file_states: t.Dict[str, float] = {}
+        self._lock = threading.Lock()
+
+    def update(self) -> t.Set[str]:
+        """Scan all search paths and return changed template names."""
+        current_states: t.Dict[str, float] = {}
+        
+        for searchpath in self.searchpath:
+            if not os.path.isdir(searchpath):
+                continue
+            for root, _, filenames in os.walk(searchpath):
+                for filename in filenames:
+                    filepath = os.path.join(root, filename)
+                    relpath = os.path.relpath(filepath, searchpath)
+                    # Normalize path separators
+                    relpath = relpath.replace(os.path.sep, "/")
+                    
+                    try:
+                        mtime = os.path.getmtime(filepath)
+                    except OSError:
+                        continue
+                    
+                    key = f"{searchpath}:{relpath}"
+                    current_states[key] = mtime
+        
+        changed = set()
+        with self._lock:
+            # Check for modified or deleted files
+            for key, mtime in current_states.items():
+                if key not in self._file_states:
+                    # New file added
+                    changed.add(key)
+                elif self._file_states[key] != mtime:
+                    # File modified
+                    changed.add(key)
+            
+            # Check for deleted files
+            for key in self._file_states:
+                if key not in current_states:
+                    changed.add(key)
+            
+            self._file_states = current_states
+        
+        return changed
+
+    def invalidate(self, paths: t.Set[str]) -> t.Set[str]:
+        """Invalidate specific paths and return their canonical names."""
+        with self._lock:
+            for path in paths:
+                self._file_states.pop(path, None)
+        return paths
+
