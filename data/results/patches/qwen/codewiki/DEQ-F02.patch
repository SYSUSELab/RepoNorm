+
+# MAC address patterns
+_mac_patterns = {
+    'colon': re.compile(r'^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'),
+    'hyphen': re.compile(r'^([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}$'),
+    'dot': re.compile(r'^([0-9A-Fa-f]{4}\.){2}[0-9A-Fa-f]{4}$'),
+    'compact': re.compile(r'^[0-9A-Fa-f]{12}$'),
+}
+
+
+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address.
+
+    By default, accepts six-octet hexadecimal MAC addresses in colon-separated,
+    hyphen-separated, three-group dotted, and compact forms. Matching hexadecimal
+    digits is case-insensitive.
+
+    When a format is specified, only addresses in that form match.
+
+    Examples:
+    ```py title="IsMac"
+    from dirty_equals import IsMac
+
+    assert '00:1A:2B:3C:4D:5E' == IsMac
+    assert '00-1A-2B-3C-4D-5E' == IsMac
+    assert '001A.2B3C.4D5E' == IsMac
+    assert '001A2B3C4D5E' == IsMac
+    assert 'aa:bb:cc:dd:ee:ff' == IsMac
+
+    assert '00:1A:2B:3C:4D:5E' == IsMac('colon')
+    assert '00-1A-2B-3C-4D-5E' == IsMac('hyphen')
+    assert '001A.2B3C.4D5E' == IsMac('dot')
+    assert '001A2B3C4D5E' == IsMac('compact')
+
+    assert '00:1A:2B:3C:4D:5E' != IsMac('hyphen')
+    assert '00-1A-2B:3C-4D:5E' != IsMac  # mixed separators
+    assert 'foobar' != IsMac
+    assert 123 != IsMac
+    ```
+    """
+
+    def __init__(self, format: Literal['colon', 'hyphen', 'dot', 'compact', None] = None):
+        """
+        Args:
+            format: The format of the MAC address to check. If omitted, all formats are accepted.
+
+        Valid formats:
+            - `colon`: Six groups of two hex digits separated by colons (e.g., `00:1A:2B:3C:4D:5E`)
+            - `hyphen`: Six groups of two hex digits separated by hyphens (e.g., `00-1A-2B-3C-4D-5E`)
+            - `dot`: Three groups of four hex digits separated by dots (e.g., `001A.2B3C.4D5E`)
+            - `compact`: Twelve consecutive hex digits (e.g., `001A2B3C4D5E`)
+        """
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format is None:
+            # Check against all patterns
+            for pattern in _mac_patterns.values():
+                if pattern.fullmatch(other):
+                    return True
+            return False
+        else:
+            # Check against specific format
+            pattern = _mac_patterns.get(self.format)
+            if pattern is None:
+                return False
+            return pattern.fullmatch(other) is not None
