+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        # No format - all valid MAC forms should match
+        ('00:11:22:33:44:55', IsMac),
+        ('00-11-22-33-44-55', IsMac),
+        ('0011.2233.4455', IsMac),
+        ('001122334455', IsMac),
+        ('AA:BB:CC:DD:EE:FF', IsMac),
+        ('aa:bb:cc:dd:ee:ff', IsMac),
+        ('Aa:Bb:Cc:Dd:Ee:Ff', IsMac),
+        # With format argument
+        ('00:11:22:33:44:55', IsMac('colon')),
+        ('00-11-22-33-44-55', IsMac('hyphen')),
+        ('0011.2233.4455', IsMac('dot')),
+        ('001122334455', IsMac('compact')),
+    ],
+)
+def test_is_mac_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    'other,dirty',
+    [
+        # Invalid formats when no format specified
+        ('00:11:22:33:44', IsMac),  # too short
+        ('00:11:22:33:44:55:66', IsMac),  # too long
+        ('00:11:22:33:44:GG', IsMac),  # invalid hex
+        ('00 11 22 33 44 55', IsMac),  # space separator
+        ('00:11-22:33-44:55', IsMac),  # mixed separators
+        ('0011.2233.4455.6677', IsMac),  # dot with wrong length
+        (123456789012, IsMac),  # not a string
+        ([], IsMac),  # not a string
+        (None, IsMac),  # not a string
+        # Format mismatch
+        ('00:11:22:33:44:55', IsMac('hyphen')),
+        ('00-11-22-33-44-55', IsMac('colon')),
+        ('0011.2233.4455', IsMac('compact')),
+        ('001122334455', IsMac('dot')),
+        # Whitespace not allowed
+        (' 00:11:22:33:44:55', IsMac),
+        ('00:11:22:33:44:55 ', IsMac),
+        ('00:11:22:33:44:55\n', IsMac),
+        # Invalid format names
+        ('00:11:22:33:44:55', IsMac('invalid')),
+    ],
+)
+def test_is_mac_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_mac_repr():
+    is_mac = IsMac()
+    with pytest.raises(AssertionError):
+        assert 'foobar' == is_mac
+    assert str(is_mac) == 'IsMac(*)'
+
+
+def test_is_mac_format_repr():
+    is_mac = IsMac('colon')
+    with pytest.raises(AssertionError):
+        assert 'foobar' == is_mac
+    assert str(is_mac) == "IsMac('colon')"
