+    def _generate_cache_salt(self):
+        """Generate a nonempty ASCII cache salt for distinguishing proposals.
+        
+        Uses the RNG object's random/choice/uniform interface without requiring getrandbits.
+        Returns a hex string that can be reproduced with the same RNG seed.
+        """
+        # Generate 16 bytes of randomness using the RNG's uniform method
+        # Each byte is represented as two hex characters
+        salt_parts = []
+        for _ in range(16):
+            # Use uniform to get a value between 0 and 255, then convert to hex
+            byte_val = int(self.rng.uniform(0, 255))
+            salt_parts.append(f"{byte_val:02x}")
+        return "".join(salt_parts)
