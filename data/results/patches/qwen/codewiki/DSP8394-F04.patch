+    def stats(self) -> Dict[str, int]:
+        """Return a fresh dictionary with cache statistics.
+        
+        Returns:
+            A dictionary with integer keys 'hits', 'mem_hits', 'disk_hits', 'misses'.
+            hits equals mem_hits plus disk_hits.
+        """
+        with self._stats_lock:
