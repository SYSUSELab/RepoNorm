+    def _validate_trans_expr(self, node: nodes.Expr, var_name: str) -> None:
+        """Validate that a translation expression only contains allowed constructs.
+        
+        Allowed: constants, names, attribute access, filters, tests, or calls whose
+        callee is a simple name. Arguments and keyword values must follow the same rule.
+        Dynamic *args and **kwargs are rejected.
+        
+        Other forms including item access, arithmetic, conditional expressions, and
+        method calls raise TemplateSyntaxError.
+        """
+        self._check_node(node, var_name)
+    
+    def _check_node(self, node: nodes.Node, var_name: str) -> None:
+        """Recursively check that all nodes in the expression tree are valid."""
+        # Valid node types for translation expressions
+        valid_types = (
+            nodes.Const,      # constants
+            nodes.Name,       # simple names
+            nodes.Getattr,    # attribute access
+            nodes.Filter,     # filters
+            nodes.Test,       # tests
+            nodes.Call,       # calls with simple name callee
+        )
+        
+        if isinstance(node, valid_types):
+            # For Call nodes, validate the callee is a simple name
+            if isinstance(node, nodes.Call):
+                if not isinstance(node.node, nodes.Name):
+                    self._fail_invalid_expr(var_name, "call callee must be a simple name", node.lineno)
+                # Validate arguments
+                for arg in node.args:
+                    self._check_node(arg, var_name)
+                for kw in node.kwargs:
+                    self._check_node(kw.value, var_name)
+                # Reject dynamic arguments (*args, **kwargs)
+                if node.dyn_args is not None or node.dyn_kwargs is not None:
+                    self._fail_invalid_expr(
+                        var_name, "dynamic *args/**kwargs are not allowed", node.lineno
+                    )
+            # For Filter/Test nodes, validate the argument
+            elif isinstance(node, (nodes.Filter, nodes.Test)):
+                self._check_node(node.node, var_name)
+            # For Getattr, validate the object
+            elif isinstance(node, nodes.Getattr):
+                self._check_node(node.node, var_name)
+            # Name and Const are valid and don't need further validation
+            elif isinstance(node, (nodes.Name, nodes.Const)):
+                pass
+        elif isinstance(node, nodes.BinExpr):
+            self._fail_invalid_expr(var_name, "arithmetic operations not allowed", node.lineno)
+        elif isinstance(node, nodes.UnaryExpr):
+            self._fail_invalid_expr(var_name, "unary operations not allowed", node.lineno)
+        elif isinstance(node, nodes.CondExpr):
+            self._fail_invalid_expr(var_name, "conditional expressions not allowed", node.lineno)
+        elif isinstance(node, nodes.Compare):
+            self._fail_invalid_expr(var_name, "comparison operations not allowed", node.lineno)
+        elif isinstance(node, nodes.And):
+            self._fail_invalid_expr(var_name, "boolean operations not allowed", node.lineno)
+        elif isinstance(node, nodes.Or):
+            self._fail_invalid_expr(var_name, "boolean operations not allowed", node.lineno)
+        elif isinstance(node, nodes.Getitem):
+            self._fail_invalid_expr(var_name, "item access not allowed", node.lineno)
+        elif isinstance(node, nodes.Slice):
+            self._fail_invalid_expr(var_name, "slicing not allowed", node.lineno)
+        elif isinstance(node, nodes.List):
+            self._fail_invalid_expr(var_name, "list literals not allowed", node.lineno)
+        elif isinstance(node, nodes.Dict):
+            self._fail_invalid_expr(var_name, "dict literals not allowed", node.lineno)
+        elif isinstance(node, nodes.Set):
+            self._fail_invalid_expr(var_name, "set literals not allowed", node.lineno)
+        elif isinstance(node, nodes.Tuple):
+            self._fail_invalid_expr(var_name, "tuple literals not allowed", node.lineno)
+        elif isinstance(node, nodes.Starred):
+            self._fail_invalid_expr(var_name, "starred expressions not allowed", node.lineno)
+        else:
+            self._fail_invalid_expr(var_name, f"expression type {type(node).__name__} not allowed", node.lineno)
+    
+    def _fail_invalid_expr(self, var_name: str, reason: str, lineno: int) -> None:
+        """Raise TemplateSyntaxError for invalid expression."""
+        raise TemplateSyntaxError(
+            f"translation variable {var_name!r}: {reason} (template data, translation contexts)",
+            lineno=lineno,
+        )
+
+
