+
+@mark_dualiter("items", lambda: [
+    {'foo': 1, 'bar': 2},
+    {'foo': 2, 'bar': 3},
+    {'foo': 1, 'bar': 1},
+    {'foo': 3, 'bar': 4},
+])
+def test_groupby_max_groups(env_async, items):
+    """Test max_groups parameter limits number of groups returned."""
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('foo', max_groups=2) -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.foo }},{% endfor %}|{%- endfor %}"
+    )
+    result = tmpl.render(items=items)
+    assert result == "1:1,:1,|2:2,|"
+
+
+@mark_dualiter("items", lambda: [
+    {'foo': 1, 'bar': 2},
+    {'foo': 2, 'bar': 3},
+    {'foo': 1, 'bar': 1},
+    {'foo': 3, 'bar': 4},
+])
+def test_groupby_max_groups_none(env_async, items):
+    """Test max_groups=None returns all groups (same as default)."""
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('foo', max_groups=None) -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.foo }},{% endfor %}|{%- endfor %}"
+    )
+    result = tmpl.render(items=items)
+    assert result == "1:1,:1,|2:2,|3:3,|"
+
+
+@mark_dualiter("items", lambda: [
+    {'foo': 1, 'bar': 2},
+    {'foo': 2, 'bar': 3},
+    {'foo': 1, 'bar': 1},
+    {'foo': 3, 'bar': 4},
+])
+def test_groupby_max_groups_zero(env_async, items):
+    """Test max_groups=0 returns no groups."""
+    tmpl = env_async.from_string(
+        "{%- for grouper, list in items()|groupby('foo', max_groups=0) -%}"
+        "{{ grouper }}{% for x in list %}:{{ x.foo }},{% endfor %}|{%- endfor %}"
+    )
+    result = tmpl.render(items=items)
+    assert result == ""
+
+
+@mark_dualiter("items", lambda: [{'foo': 1}])
+def test_groupby_max_groups_negative(env_async, items):
+    """Test max_groups=-1 raises FilterArgumentError."""
+    from jinja2.exceptions import FilterArgumentError
+    with pytest.raises(FilterArgumentError) as exc_info:
+        tmpl = env_async.from_string(
