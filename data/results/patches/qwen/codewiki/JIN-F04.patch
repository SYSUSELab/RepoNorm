+            "{{ grouper }}{% for x in list %}:{{ x.foo }},{% endfor %}|{%- endfor %}"
+        )
+        tmpl.render(items=items)
+    assert "integer or None" in str(exc_info.value)
+
+
+@mark_dualiter("items", lambda: [{'foo': 1}])
+def test_groupby_max_groups_boolean_false(env_async, items):
+    """Test max_groups=False raises FilterArgumentError."""
+    from jinja2.exceptions import FilterArgumentError
+    with pytest.raises(FilterArgumentError) as exc_info:
+        tmpl = env_async.from_string(
