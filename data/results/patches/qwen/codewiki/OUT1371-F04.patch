+"""Formatting utilities for prompt filters."""
+
+import html
+import json as _json_module
+
+
+def json(value: object) -> str:
+    """Format a value as JSON using json.dumps defaults."""
+    return _json_module.dumps(value)
+
+
+def csv(value: list) -> str:
+    """Format an iterable as one CSV row with standard quoting and no line terminator.
+    
+    Parameters
+    ----------
+    value : iterable
+        The values to format as a CSV row.
+        
+    Returns
+    -------
+    str
+        A single CSV row string.
+    """
+    import csv
+    import io
+    
+    output = io.StringIO()
+    writer = csv.writer(output, lineterminator="")
+    writer.writerow(value)
+    return output.getvalue()
+
+
+def indent(value: str, width: int = 4) -> str:
+    """Add `width` spaces to each non-empty line.
+    
+    Parameters
+    ----------
+    value : str
+        The input string.
+    width : int, optional
+        The number of spaces to add per line. Default is 4.
+        
+    Returns
+    -------
+    str
+        The indented string.
+    """
+    if not isinstance(width, int):
+        raise TypeError("width must be an integer")
+    
+    lines = value.split("\n")
+    prefix = " " * width
+    result_lines = []
+    for line in lines:
+        if line:
+            result_lines.append(prefix + line)
+        else:
+            result_lines.append(line)
+    return "\n".join(result_lines)
+
+
+def wrap(value: str, width: int = 70) -> str:
+    """Wrap text with Python's normal word wrapping.
+    
+    Parameters
+    ----------
+    value : str
+        The input string.
+    width : int, optional
+        The maximum line width. Default is 70.
+        
+    Returns
+    -------
+    str
+        The wrapped string.
+    """
+    return "\n".join(textwrap.wrap(value, width))
+
+
+def escape(value: str) -> str:
+    """Apply HTML escaping (including quotes) to a string.
+    
+    Parameters
+    ----------
+    value : str
+        The input string.
+        
+    Returns
+    -------
+    str
+        The HTML-escaped string.
+    """
+    return html.escape(value, quote=True)
+
+
+def unescape(value: str) -> str:
+    """Unescape an HTML-escaped string.
+    
+    Parameters
+    ----------
+    value : str
+        The HTML-escaped string.
+        
+    Returns
+    -------
+    str
+        The unescaped string.
+    """
+    return html.unescape(value)
+
+
+import textwrap
