+"""Mathematical utilities for prompt filters."""
+_builtin_round = round
+_builtin_abs = abs
+_builtin_min = min
+_builtin_max = max
+
+
+def add(a: float, b: float) -> float:
+    """Add two numbers."""
+    return a + b
+
+
+def subtract(a: float, b: float) -> float:
+    """Subtract b from a."""
+    return a - b
+
+
+def multiply(a: float, b: float) -> float:
+    """Multiply two numbers."""
+    return a * b
+
+
+def divide(a: float, b: float) -> float:
+    """Divide a by b."""
+    return a / b
+
+
+def round(value: float, ndigits: int = None) -> float:
+    """Round a number to the specified number of digits.
+    
+    Parameters
+    ----------
+    value : float
+        The number to round.
+    ndigits : int, optional
+        The number of decimal places to round to. If None, rounds to an integer.
+        
+    Returns
+    -------
+    float
+        The rounded number.
+    """
+    if ndigits is None:
+        return _builtin_round(value)
+    return _builtin_round(value, ndigits)
+
+
+def abs(value: float) -> float:
+    """Return the absolute value of a number."""
+    return _builtin_abs(value)
+
+
+def min(value: float, *others: float) -> float:
+    """Return the minimum of the given values.
+    
+    Parameters
+    ----------
+    value : float
+        The first value.
+    *others : float
+        Additional values to compare.
+        
+    Returns
+    -------
+    float
+        The minimum value.
+    """
+    return _builtin_min(value, *others)
+
+
+def max(value: float, *others: float) -> float:
+    """Return the maximum of the given values.
+    
+    Parameters
+    ----------
+    value : float
+        The first value.
+    *others : float
+        Additional values to compare.
+        
+    Returns
+    -------
+    float
+        The maximum value.
+    """
+    return _builtin_max(value, *others)
