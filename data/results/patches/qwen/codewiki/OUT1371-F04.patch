@@ -0,0 +1,115 @@
+"""String manipulation utilities for prompt filters."""
+
+
+def upper(value: str) -> str:
+    """Convert the input to uppercase text."""
+    return value.upper()
+
+
+def lower(value: str) -> str:
+    """Convert the input to lowercase text."""
+    return value.lower()
+
+
+def title(value: str) -> str:
+    """Convert the input to title case text."""
+    return value.title()
+
+
+def reverse(value: str) -> str:
+    """Reverse the text by code point."""
+    return value[::-1]
+
+
+def truncate(value: str, length: int, end: str = "...") -> str:
+    """Return unchanged text when it fits and otherwise produce at most `length` characters
+    by replacing the tail with as much of `end` as fits.
+    
+    Parameters
+    ----------
+    value : str
+        The input string to truncate.
+    length : int
+        The maximum length of the output. Must be non-negative.
+    end : str, optional
+        The suffix to append when truncating. Default is "...".
+        
+    Returns
+    -------
+    str
+        The truncated or original string.
+        
+    Raises
+    ------
+    ValueError
+        If length is negative.
+    """
+    if length < 0:
+        raise ValueError("length must be non-negative")
+    
+    if len(value) <= length:
+        return value
+    
+    # Calculate how much of 'end' we can fit
+    remaining_length = length - len(end)
+    if remaining_length <= 0:
+        # Can't fit any of the original text, just return what fits of end
+        return end[:length]
+    
+    return value[:remaining_length] + " " + end
+
+
+def pad_left(value: str, width: int, fill: str = " ") -> str:
+    """Pad the left side of the string to reach the specified width.
+    
+    Parameters
+    ----------
+    value : str
+        The input string to pad.
+    width : int
+        The target width. If less than or equal to len(value), returns value unchanged.
+    fill : str
+        The character to use for padding. Must be exactly one character.
+        
+    Returns
+    -------
+    str
+        The padded string.
+        
+    Raises
+    ------
+    ValueError
+        If fill is not exactly one character.
+    """
+    if len(fill) != 1:
+        raise ValueError("fill must be exactly one character")
+    
+    return value.rjust(width, fill)
+
+
+def pad_right(value: str, width: int, fill: str = " ") -> str:
+    """Pad the right side of the string to reach the specified width.
+    
+    Parameters
+    ----------
+    value : str
+        The input string to pad.
+    width : int
+        The target width. If less than or equal to len(value), returns value unchanged.
+    fill : str
+        The character to use for padding. Must be exactly one character.
+        
+    Returns
+    -------
+    str
+        The padded string.
+        
+    Raises
+    ------
+    ValueError
+        If fill is not exactly one character.
+    """
+    if len(fill) != 1:
+        raise ValueError("fill must be exactly one character")
+    
+    return value.ljust(width, fill)
