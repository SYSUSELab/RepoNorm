+def _add_builtin_filters(env: jinja2.Environment, builtin_filters: Optional[List[str]] = None) -> None:
+    """Add built-in filter categories to the Jinja2 environment.
+    
+    Parameters
+    ----------
+    env : jinja2.Environment
+        The Jinja2 environment to add filters to.
+    builtin_filters : list of str, optional
+        A list of filter category names to add. Valid categories are:
+        - "string": string_utils filters (upper, lower, title, reverse, truncate, pad_left, pad_right)
+        - "math": math_utils filters (add, subtract, multiply, divide, round, abs, min, max)
+        - "format": format_utils filters (json, csv, indent, wrap, escape, unescape)
+        
+        If None or empty, no additional filters are added.
+        
+    Raises
+    ------
+    ValueError
+        If an unknown filter category is specified.
+    """
+    if not builtin_filters:
+        return
+    
+    # Import here to avoid circular dependencies
+    from outlines import string_utils, math_utils, format_utils
+    
+    # Define the mapping of categories to their filter functions
+    category_filters = {
+        "string": [
+            ("upper", string_utils.upper),
+            ("lower", string_utils.lower),
+            ("title", string_utils.title),
+            ("reverse", string_utils.reverse),
+            ("truncate", string_utils.truncate),
+            ("pad_left", string_utils.pad_left),
+            ("pad_right", string_utils.pad_right),
+        ],
+        "math": [
+            ("add", math_utils.add),
+            ("subtract", math_utils.subtract),
+            ("multiply", math_utils.multiply),
+            ("divide", math_utils.divide),
+            ("round", math_utils.round),
+            ("abs", math_utils.abs),
+            ("min", math_utils.min),
+            ("max", math_utils.max),
+        ],
+        "format": [
+            ("json", format_utils.json),
+            ("csv", format_utils.csv),
+            ("indent", format_utils.indent),
+            ("wrap", format_utils.wrap),
+            ("escape", format_utils.escape),
+            ("unescape", format_utils.unescape),
+        ],
+    }
+    
+    for category in builtin_filters:
+        if category not in category_filters:
+            raise ValueError(f"Unknown builtin filter category: {category}")
+        
+        for filter_name, filter_func in category_filters[category]:
+            env.filters[filter_name] = filter_func
+
