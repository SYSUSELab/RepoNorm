+def _get_active_condition(conditional_filters: Optional[Dict[str, Dict[str, Callable]]]) -> Optional[str]:
+    """Determine which condition is active based on environment variables.
+    
+    Returns the name of the active condition, or None if no standard conditions match.
+    """
+    if not conditional_filters:
+        return None
+    
+    # Check for debug condition first (highest priority)
+    if os.environ.get("OUTLINES_DEBUG", "").lower() == "true":
+        return "debug"
+    
+    # Check for production condition
+    if os.environ.get("ENVIRONMENT", "").lower() == "production":
+        return "production"
+    
+    # Check for testing condition (multiple ways to activate)
+    env = os.environ.get("ENV", "").lower()
+    outlines_testing = os.environ.get("OUTLINES_TESTING", "").lower()
+    testing_mode = os.environ.get("TESTING_MODE", "").lower()
+    
+    if env == "testing" or outlines_testing == "true" or testing_mode == "on":
+        return "testing"
+    
+    # No standard condition matched - return alphabetically first key
+    return min(conditional_filters.keys())
+
