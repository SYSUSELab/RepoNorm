+    def add_alias(self, alias: str, target: str) -> None:
+        """Add an alias for a template.
+
+        The alias will be resolved to the target when loading templates.
+        Adding an existing alias overwrites it. Removing an unknown alias is
+        harmless.
+
+        Alias mutation invalidates that alias in every Environment cache which
+        has loaded it, so the next normal request observes the update or removal.
+        """
+        self._aliases[alias] = target
+        self._alias_version += 1
