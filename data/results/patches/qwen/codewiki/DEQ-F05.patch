+"""Tests for IsPhoneNumber validator."""
+import pytest
+
+from dirty_equals import IsPhoneNumber
+
+
+@pytest.mark.parametrize(
+    'value,dirty,match',
+    [
+        # Basic phone number validation (generic)
+        ('555-123-4567', IsPhoneNumber(), True),
+        ('+1-555-123-4567', IsPhoneNumber(), True),
+        ('020 7946 0958', IsPhoneNumber(), True),
+        ('+44 20 7946 0958', IsPhoneNumber(), True),
+        ('+33 6 12 34 56 78', IsPhoneNumber(), True),
+        
+        # Non-string types should be rejected
+        (123, IsPhoneNumber(), False),
+        ([], IsPhoneNumber(), False),
+        (None, IsPhoneNumber(), False),
+        
+        # US-specific validation
+        ('555-123-4567', IsPhoneNumber('US'), True),
+        ('+1-555-123-4567', IsPhoneNumber('US'), True),
+        ('555-xxx-xxxx', IsPhoneNumber('US'), True),  # Placeholder format
+        
+        # Invalid US formats
+        ('123', IsPhoneNumber('US'), False),
+        ('123-456-789', IsPhoneNumber('US'), False),
+        ('+1+1-555-123-4567', IsPhoneNumber('US'), False),  # Multiple plus signs
+        
+        # GB-specific validation
+        ('020 7946 0958', IsPhoneNumber('GB'), True),
+        ('+44 20 7946 0958', IsPhoneNumber('GB'), True),
+        
+        # Case insensitive country codes
+        ('020 7946 0958', IsPhoneNumber('gb'), True),
+        ('+44 20 7946 0958', IsPhoneNumber('gb'), True),
+        
+        # Unknown country - generic international format only
+        ('+33 6 12 34 56 78', IsPhoneNumber('FR'), True),
+        ('12345678', IsPhoneNumber('FR'), False),  # No plus sign
+        
+        # Edge cases
+        ('', IsPhoneNumber(), False),  # Empty string
+        ('---', IsPhoneNumber(), False),  # Only separators
+        ('123\n456', IsPhoneNumber(), False),  # Newline
+        ('123\t456', IsPhoneNumber(), False),  # Tab is valid char but too few digits
+        ('(123) 456-7890', IsPhoneNumber(), True),  # Parentheses
+        ('123-456-78901234567890', IsPhoneNumber(), False),  # Too many digits
+        ('123', IsPhoneNumber(), False),  # Too few digits
+    ],
+)
+def test_dirty_equals_true(value, dirty, match):
+    """Test that dirty equals works correctly."""
+    if match:
+        assert value == dirty
+    else:
+        assert value != dirty
+
+
+def test_string_representation():
+    """Test string representation of IsPhoneNumber."""
+    assert repr(IsPhoneNumber()) == "IsPhoneNumber(*)"
+    assert repr(IsPhoneNumber('US')) == "IsPhoneNumber('US')"
+    assert repr(IsPhoneNumber('gb')) == "IsPhoneNumber('gb')"  # Shows original case
+
+
+def test_syntax_validation():
+    """Test syntax validation rules."""
+    # Valid characters
+    assert '555-123-4567' == IsPhoneNumber()
+    assert '555.123.4567' == IsPhoneNumber()
+    assert '555 123 4567' == IsPhoneNumber()
+    assert '(555) 123-4567' == IsPhoneNumber()
+    
+    # Invalid characters
+    assert '555@123#4567' != IsPhoneNumber()
+    assert '555\x00123' != IsPhoneNumber()
+    
+    # Plus sign rules
+    assert '+1-555-123-4567' == IsPhoneNumber()
+    assert '555-123-4567+1' != IsPhoneNumber()  # Plus not at start
+    assert '+1+1-555-123-4567' != IsPhoneNumber()  # Multiple plus signs
+    
+    # Balanced parentheses
+    assert '(555) 123-4567' == IsPhoneNumber()
+    assert '((555)) 123-4567' == IsPhoneNumber()  # Nested but balanced
+    assert '(555 123-4567' != IsPhoneNumber()  # Unbalanced
+    assert '555) 123-4567' != IsPhoneNumber()  # Unbalanced
+
+
+def test_digit_lengths():
+    """Test digit length requirements."""
+    # Generic: 7-15 digits without +, 8-19 with +
+    assert '1234567' == IsPhoneNumber()  # Min national (7 digits)
+    assert '123456789012345' == IsPhoneNumber()  # Max national (15 digits)
+    assert '12345678' == IsPhoneNumber()  # Min international (8 digits with +)
+    assert '+1234567890123456789' == IsPhoneNumber()  # Max international (19 digits with +)
+    
+    # Too short
+    assert '123456' != IsPhoneNumber()
+    assert '12345678' != IsPhoneNumber('US')  # Too short for US
+    
+    # Too long
+    assert '1234567890123456' != IsPhoneNumber()  # Over 15 digits
+    assert '+12345678901234567890' != IsPhoneNumber()  # Over 19 digits
+
+
+def test_country_specific_formats():
+    """Test country-specific format validation."""
+    # US formats
+    assert '555-123-4567' == IsPhoneNumber('US')  # 10 digits national
+    assert '+1-555-123-4567' == IsPhoneNumber('US')  # +1 with 10 digits
+    assert '+15551234567' == IsPhoneNumber('US')  # +1 without separators
+    
+    # GB formats
+    assert '020 7946 0958' == IsPhoneNumber('GB')  # National starting with 0
+    assert '+44 20 7946 0958' == IsPhoneNumber('GB')  # +44 with 10-11 digits
+    assert '+442079460958' == IsPhoneNumber('GB')  # +44 without separators
+    
+    # Wrong country code
+    assert '+44 20 7946 0958' != IsPhoneNumber('US')  # UK number for US
+    assert '+1-555-123-4567' != IsPhoneNumber('GB')  # US number for GB
+
+
+def test_placeholder_formats():
+    """Test placeholder/example number formats."""
+    # US placeholder format
+    assert '555-xxx-xxxx' == IsPhoneNumber('US')
+    assert '555-XXX-XXXX' == IsPhoneNumber('US')
+    
+    # Without country code, placeholder doesn't meet min digit requirement
+    assert '555-xxx-xxxx' != IsPhoneNumber()  # Only 3 digits, need 7+
