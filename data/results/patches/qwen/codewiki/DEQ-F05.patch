+
+# Test 1: Basic phone number validation
+assert "555-123-4567" == IsPhoneNumber()
+print("✓ Basic US national format works")
+
+# Test 2: International format with +1
+assert "+1-555-123-4567" == IsPhoneNumber()
+print("✓ International format with +1 works")
+
+# Test 3: GB national format
+assert "020 7946 0958" == IsPhoneNumber()
+print("✓ GB national format works")
+
+# Test 4: GB international format
+assert "+44 20 7946 0958" == IsPhoneNumber()
+print("✓ GB international format works")
+
+# Test 5: Invalid - non-string
+try:
+    assert 123 != IsPhoneNumber()
+    print("✓ Non-string rejected")
+except AssertionError:
+    print("✗ Non-string should be rejected")
+
+# Test 6: US with country code
+assert "555-123-4567" == IsPhoneNumber("US")
+print("✓ US national format with country code works")
+
+# Test 7: US international with +1
+assert "+1-555-123-4567" == IsPhoneNumber("US")
+print("✓ US international format with +1 works")
+
+# Test 8: Invalid US format (wrong length)
+assert "123-456-789" != IsPhoneNumber("US")
+print("✓ Invalid US format rejected")
+
+# Test 9: GB national format with country code
+assert "020 7946 0958" == IsPhoneNumber("GB")
+print("✓ GB national format with country code works")
+
+# Test 10: GB international with +44
+assert "+44 20 7946 0958" == IsPhoneNumber("GB")
+print("✓ GB international format with +44 works")
+
+# Test 11: Case insensitive country code
+assert "020 7946 0958" == IsPhoneNumber("gb")
+print("✓ Case insensitive country code works")
+
+# Test 12: Unknown country - generic international
+assert "+33 6 12 34 56 78" == IsPhoneNumber("FR")
+print("✓ Unknown country generic international works")
+
+# Test 13: String representation
+repr_generic = repr(IsPhoneNumber())
+print(f"Generic repr: {repr_generic}")
+assert repr_generic == "IsPhoneNumber(*)", f"Expected 'IsPhoneNumber(*)', got '{repr_generic}'"
+print("✓ Generic string representation works")
+
+repr_us = repr(IsPhoneNumber("US"))
+print(f"US repr: {repr_us}")
+assert repr_us == "IsPhoneNumber('US')", f"Expected \"IsPhoneNumber('US')\", got '{repr_us}'"
+print("✓ Country-specific string representation works")
+
+print("\nAll tests passed!")
+
+# Additional edge case tests
+print("\nTesting additional edge cases...")
+
+# Test placeholder format (555-xxx-xxxx)
+assert "555-xxx-xxxx" == IsPhoneNumber('US')
+print("✓ Placeholder format works")
+
+# Test with parentheses
+assert "(555) 123-4567" == IsPhoneNumber()
+print("✓ Parentheses format works")
+
+# Test with dots
+assert "555.123.4567" == IsPhoneNumber()
+print("✓ Dots format works")
+
+# Test with tabs
+assert "555\t123\t4567" == IsPhoneNumber()
+print("✓ Tabs format works")
+
+# Test invalid - newline in phone number
+assert "+1-555\n123-4567" != IsPhoneNumber()
+print("✓ Newline rejected")
+
+# Test invalid - multiple plus signs
+assert "+1+1-555-123-4567" != IsPhoneNumber()
+print("✓ Multiple plus signs rejected")
+
+# Test invalid - plus not at start
+assert "1+1-555-123-4567" != IsPhoneNumber()
+print("✓ Plus not at start rejected")
+
+# Test invalid - unbalanced parentheses
+assert "(555) 123-4567)" != IsPhoneNumber()
+print("✓ Unbalanced parentheses rejected")
+
+# Test invalid - too many digits for US international
+assert "+1-555-123-4567-8901" != IsPhoneNumber('US')
+print("✓ Too many digits for US international rejected")
+
+# Test invalid - too few digits for GB national
+assert "020 7946" != IsPhoneNumber('GB')
+print("✓ Too few digits for GB national rejected")
+
+# Test unknown country without plus
+assert "555-123-4567" != IsPhoneNumber('FR')
+print("✓ Unknown country without plus rejected")
+
+# Test unknown country with valid format
+assert "+33 6 12 34 56 78" == IsPhoneNumber('FR')
+print("✓ Unknown country with valid format works")
+
+# Test generic validation - too few digits
+assert "123" != IsPhoneNumber()
+print("✓ Too few digits rejected")
+
+# Test generic validation - too many digits
+assert "12345678901234567890" != IsPhoneNumber()
+print("✓ Too many digits rejected")
+
+# Test generic validation - valid international
+assert "+123456789" == IsPhoneNumber()
+print("✓ Valid international format works")
+
