+import re
+from typing import Any, Optional, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid phone number, optionally checking country-specific formatting.
+
+    This validator supports flexible phone number validation across different international formats
+    and country codes. It handles common phone number formats including international notation
+    (e.g., `+1-555-123-4567`), national formats (e.g., `555-123-4567`), and various delimiter styles
+    (spaces, dashes, parentheses, dots).
+
+    Args:
+        country: Optional country code ('US', 'GB', etc.) for country-specific validation.
+            If omitted, validates against generic international rules.
+            Country codes are matched case-insensitively.
+
+    Examples:
+        ```py title="IsPhoneNumber"
+        from dirty_equals import IsPhoneNumber
+
+        # Generic validation - accepts any valid phone number format
+        assert '+1-555-123-4567' == IsPhoneNumber()
+        assert '555-123-4567' == IsPhoneNumber()
+        assert '+44 20 7946 0958' == IsPhoneNumber()
+
+        # US-specific validation
+        assert '555-123-4567' == IsPhoneNumber('US')
+        assert '+1-555-123-4567' == IsPhoneNumber('US')
+        assert '555-xxx-xxxx' == IsPhoneNumber('US')  # placeholder format
+
+        # GB-specific validation
+        assert '020 7946 0958' == IsPhoneNumber('GB')
+        assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+
+        # Case-insensitive country codes
+        assert '020 7946 0958' == IsPhoneNumber('gb')
+        assert '+44 20 7946 0958' == IsPhoneNumber('gb')
+
+        # Invalid examples
+        assert 123 != IsPhoneNumber()  # non-string rejected
+        assert '123-456-789' != IsPhoneNumber('US')  # wrong length for US
+        ```
+    """
+
+    # Supported countries with their specific validation rules
+    SUPPORTED_COUNTRIES = {'US', 'GB'}
+
+    def __init__(self, country: Optional[Union[str, Literal['*']]] = None):
+        """
+        Args:
+            country: Optional country code for country-specific validation.
+                If omitted, validates against generic international rules.
+                Country codes are matched case-insensitively.
+
+        Examples:
+            ```py title="IsPhoneNumber"
+            from dirty_equals import IsPhoneNumber
+
+            # Generic validation
+            assert '+1-555-123-4567' == IsPhoneNumber()
+
+            # US-specific validation
+            assert '555-123-4567' == IsPhoneNumber('US')
+
+            # GB-specific validation
+            assert '020 7946 0958' == IsPhoneNumber('GB')
+            ```
+        """
+        self.country = country.upper() if country else None
+        super().__init__(plain_repr('*') if country is None else country)
+
+    def equals(self, other: Any) -> bool:
+        """Check if the given value is a valid phone number."""
+        # Only accept string inputs
+        if not isinstance(other, str):
+            return False
+
+        # Validate syntax first
+        if not self._validate_syntax(other):
+            return False
+
+        # Extract digits and check based on country
+        digits = self._extract_digits(other)
+        has_plus = other.startswith('+')
+
+        if self.country:
+            return self._validate_country_format(digits, has_plus, other)
+        else:
+            return self._validate_generic_format(digits, has_plus)
+
+    def _validate_syntax(self, phone: str) -> bool:
+        """
+        Validate the basic syntax of the phone number.
+
+        Rules:
+        - Only ASCII digits, spaces, tabs, dashes, dots, plus sign, balanced non-nested parentheses,
+          and placeholder characters (x, X) are allowed
+        - At most one plus sign, which must be at the start
+        - No newlines or other characters
+        """
+        # Check for newlines or other invalid characters
+        if '\n' in phone or '\r' in phone:
+            return False
+
+        # Check for plus sign - must be at start if present
+        plus_count = phone.count('+')
+        if plus_count > 1:
+            return False
+        if plus_count == 1 and not phone.startswith('+'):
+            return False
+
+        # Valid separator characters (including +) and placeholder characters (x, X)
+        valid_chars = set('0123456789 \t-.()+xX')
+
+        # Check each character
+        for char in phone:
+            if char not in valid_chars:
+                return False
+
+        # Check for balanced parentheses (simple check - no nested, matching pairs)
+        paren_depth = 0
+        for char in phone:
+            if char == '(':
+                paren_depth += 1
+            elif char == ')':
+                paren_depth -= 1
+                if paren_depth < 0:
+                    return False
+        if paren_depth != 0:
+            return False
+
+        return True
+
+    def _extract_digits(self, phone: str) -> str:
+        """Extract only digits from the phone number string."""
+        return ''.join(c for c in phone if c.isdigit())
+
+    def _extract_alphanumeric(self, phone: str) -> str:
+        """Extract digits and placeholder characters (x, X) from the phone number string."""
+        return ''.join(c for c in phone if c.isalnum())
+
+    def _validate_generic_format(self, digits: str, has_plus: bool) -> bool:
+        """
+        Validate against generic international rules.
+
+        Rules:
+        - With +: 8-19 digits total (including country code)
+        - Without +: 7-15 digits (national format)
+        """
+        if has_plus:
+            # International format: + followed by 8-19 digits
+            return 8 <= len(digits) <= 19
+        else:
+            # National format: 7-15 digits
+            return 7 <= len(digits) <= 15
+
+    def _validate_country_format(self, digits: str, has_plus: bool, original: str) -> bool:
+        """
+        Validate against country-specific rules.
+
+        US:
+        - National: 10 digits
+        - International: +1 followed by 10 digits
+
+        GB:
+        - National: 10-11 digits starting with 0
+        - International: +44 followed by 10-11 digits
+        """
+        if self.country == 'US':
+            if has_plus:
+                # Must start with +1
+                if not original.startswith('+1'):
+                    return False
+                # After +1, must have exactly 10 digits
+                return len(digits) == 11  # 1 (country code) + 10 (number)
+            else:
+                # National format: exactly 10 digits
+                # Also accept placeholder formats like 555-xxx-xxxx (10 alphanumeric chars)
+                if len(digits) == 10:
+                    return True
+                # Check for placeholder format (alphanumeric chars = 10)
+                alnum = self._extract_alphanumeric(original)
+                return len(alnum) == 10
+
+        elif self.country == 'GB':
+            if has_plus:
+                # Must start with +44
+                if not original.startswith('+44'):
+                    return False
+                # After +44, must have 10-11 digits (total digits = 2 + 10-11 = 12-13)
+                return 12 <= len(digits) <= 13
+            else:
+                # National format: 10-11 digits starting with 0
+                if len(digits) < 10 or len(digits) > 11:
+                    return False
+                if not digits.startswith('0'):
+                    return False
+                return True
+
+        else:
+            # Unknown country - use generic international syntax
+            # Must have + and 8-19 digits total
+            if not has_plus:
+                return False
+            return 8 <= len(digits) <= 19
