+    def set_translation_version(self, message: str, version: str) -> None:
+        """Set a version for a translation message."""
+        self._translations_versions[message] = version
+
+    def get_translation_version(self, message: str) -> t.Optional[str]:
+        """Get the version for a translation message. Returns None if unknown."""
+        return self._translations_versions.get(message)
+
+    def compare_translation_versions(
+        self, message1: str, message2: str
+    ) -> bool:
+        """Compare versions of two messages. Returns True only when both messages
+        are registered and their versions are equal. Either or both missing
+        always returns False."""
+        v1 = self._translations_versions.get(message1)
+        v2 = self._translations_versions.get(message2)
+        if v1 is None or v2 is None:
+            return False
+        return v1 == v2
+
+    def remove_translation_version(self, message: str) -> None:
+        """Remove a translation version entry. Harmless for an unknown message."""
+        self._translations_versions.pop(message, None)
+
+    def clear_translation_versions(self) -> None:
+        """Remove every translation version entry."""
+        self._translations_versions.clear()
+
+
+    def bind(self, environment: "Environment") -> "InternationalizationExtension":
+        """Create a copy of this extension bound to another environment."""
+        rv = object.__new__(self.__class__)
+        rv.__dict__.update(self.__dict__)
+        rv.environment = environment
+        # Copy translations versions for overlay support
+        rv._translations_versions = dict(self._translations_versions)
+        # Update environment methods to use the new extension instance
+        environment.set_translation_version = rv.set_translation_version
+        environment.get_translation_version = rv.get_translation_version
+        environment.compare_translation_versions = rv.compare_translation_versions
+        environment.remove_translation_version = rv.remove_translation_version
+        environment.clear_translation_versions = rv.clear_translation_versions
+        return rv
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
         for key in ("gettext", "ngettext", "pgettext", "npgettext"):
             self.environment.globals.pop(key, None)
