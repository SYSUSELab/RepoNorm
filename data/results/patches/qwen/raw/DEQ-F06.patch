+from typing import Any, Literal, Optional, Tuple, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal as TypingLiteral
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsCreditCard(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid credit card number.
+
+    Validates card numbers using the Luhn algorithm and optionally restricts them to a named issuer.
+
+    Card numbers can be provided as strings or integers. Strings may contain spaces, hyphens,
+    and surrounding whitespace; other characters compare unequal.
+
+    Without an issuer, any 12-19 digit number that passes the Luhn check is accepted.
+
+    The optional issuer is exactly one of `Visa`, `Mastercard`, or `AmericanExpress`, matched case-sensitively.
+
+    - Visa numbers start with 4 and contain 13, 16, or 19 digits.
+    - Mastercard numbers contain 16 digits and start in the 51--55 or 2221--2720 ranges.
+    - American Express numbers contain 15 digits and start with 34 or 37.
+
+    Examples:
+    ```py title="IsCreditCard"
+    from dirty_equals import IsCreditCard
+
+    assert '4111111111111111' == IsCreditCard
+    assert '4111 1111 1111 1111' == IsCreditCard
+    assert '4111-1111-1111-1111' == IsCreditCard
+    assert 4111111111111111 == IsCreditCard
+
+    assert '4111111111111111' == IsCreditCard('Visa')
+    assert '5425233430109903' == IsCreditCard('Mastercard')
+    assert '371449635398431' == IsCreditCard('AmericanExpress')
+
+    assert '4111111111111111' != IsCreditCard('Mastercard')
+    assert 'invalid' != IsCreditCard
+    ```
+    """
+
+    def __init__(self, issuer: Optional[Literal['Visa', 'Mastercard', 'AmericanExpress']] = None):
+        """
+        Args:
+            issuer: The expected card issuer, if omitted, any valid card is accepted.
+
+        Raises:
+            ValueError: If issuer is not one of 'Visa', 'Mastercard', or 'AmericanExpress'.
+        """
+        self.issuer = issuer
+        super().__init__(plain_repr(issuer) if issuer else plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        # Extract digits from the input
+        digits = self._extract_digits(other)
+        
+        if digits is None:
+            return False
+        
+        # Check length (12-19 digits)
+        if len(digits) < 12 or len(digits) > 19:
+            return False
+        
+        # Check Luhn algorithm
+        if not self._luhn_check(digits):
+            return False
+        
+        # Check issuer if specified
+        if self.issuer is not None:
+            return self._check_issuer(digits, self.issuer)
+        
+        return True
+
+    def _extract_digits(self, other: Any) -> Optional[str]:
+        """Extract digits from input, returning None if invalid."""
+        # Handle integer input
+        if isinstance(other, int):
+            return str(other)
+        
+        # Handle string input
+        if isinstance(other, str):
+            # Remove spaces and hyphens
+            cleaned = other.replace(' ', '').replace('-', '')
+            
+            # Check if all remaining characters are ASCII digits
+            for c in cleaned:
+                if c < '0' or c > '9':
+                    return None
+            
+            return cleaned
+        
+        return None
+
+    def _luhn_check(self, digits: str) -> bool:
+        """Validate a card number using the Luhn algorithm."""
+        # Convert to list of integers
+        nums = [int(c) for c in digits]
+        
+        # Reverse the digits
+        nums = nums[::-1]
+        
+        total = 0
+        for i, num in enumerate(nums):
+            if i % 2 == 1:  # Double every second digit (from right)
+                num *= 2
+                if num > 9:
+                    num -= 9
+            total += num
+        
+        return total % 10 == 0
+
+    def _check_issuer(self, digits: str, issuer: str) -> bool:
+        """Check if the card matches the specified issuer."""
+        if issuer == 'Visa':
+            # Starts with 4, 13/16/19 digits
+            if not digits.startswith('4'):
+                return False
+            length = len(digits)
+            return length in (13, 16, 19)
+        
+        elif issuer == 'Mastercard':
+            # 16 digits, starts with 51-55 or 2221-2720
+            if len(digits) != 16:
+                return False
+            first_two = int(digits[:2])
+            first_four = int(digits[:4])
+            # Check 51-55 range
+            if 51 <= first_two <= 55:
+                return True
+            # Check 2221-2720 range
+            if 2221 <= first_four <= 2720:
+                return True
+            return False
+        
+        elif issuer == 'AmericanExpress':
+            # 15 digits, starts with 34 or 37
+            if len(digits) != 15:
+                return False
+            return digits.startswith('34') or digits.startswith('37')
+        
+        return False
