+"""Tests for IsCreditCard validator."""
+
+import pytest
+from dirty_equals import IsCreditCard
+
+
+def test_basic_validation():
+    """Test basic credit card validation with Luhn algorithm."""
+    # Valid Visa (16 digits)
+    assert '4111111111111111' == IsCreditCard
+    assert 4111111111111111 == IsCreditCard
+    
+    # Invalid checksum
+    assert '4111111111111112' != IsCreditCard
+
+
+def test_with_spaces_and_hyphens():
+    """Test that spaces and hyphens are handled correctly."""
+    assert '4111 1111 1111 1111' == IsCreditCard
+    assert '4111-1111-1111-1111' == IsCreditCard
+    assert '4111-1111-1111-1111' == IsCreditCard('Visa')
+
+
+def test_integer_input():
+    """Test integer input."""
+    assert 4111111111111111 == IsCreditCard
+    assert 5425233430109903 == IsCreditCard('Mastercard')
+
+
+def test_issuer_specific_validation():
+    """Test issuer-specific validation."""
+    # Visa
+    assert '4111111111111111' == IsCreditCard('Visa')
+    assert '4111111111111111' != IsCreditCard('Mastercard')
+    
+    # Mastercard
+    assert '5425233430109903' == IsCreditCard('Mastercard')
+    assert '5425233430109903' != IsCreditCard('Visa')
+    
+    # American Express
+    assert '371449635398431' == IsCreditCard('AmericanExpress')
+    assert '371449635398431' != IsCreditCard('Visa')
+
+
+def test_invalid_cards():
+    """Test invalid cards return False."""
+    # Non-digit characters
+    assert '411111111111111a' != IsCreditCard
+    assert 'abc' != IsCreditCard
+    
+    # Wrong length
+    assert '12345' != IsCreditCard
+    assert '123456789012345678901234567890' != IsCreditCard
+    
+    # Invalid Luhn checksum
+    assert '4111111111111112' != IsCreditCard
+
+
+def test_visa_length_variations():
+    """Test Visa with different valid lengths."""
+    # 13-digit Visa
+    assert '4222222222222' == IsCreditCard('Visa')
+    
+    # 16-digit Visa
+    assert '4111111111111111' == IsCreditCard('Visa')
+    
+    # 19-digit Visa
+    assert '4111111111111111110' == IsCreditCard('Visa')
+
+
+def test_mastercard_ranges():
+    """Test Mastercard with different valid ranges."""
+    # 51xx range
+    assert '5100000000000008' == IsCreditCard('Mastercard')
+    
+    # 52xx range
+    assert '5200000000000007' == IsCreditCard('Mastercard')
+    
+    # 53xx range
+    assert '5300000000000006' == IsCreditCard('Mastercard')
+    
+    # 54xx range
+    assert '5400000000000005' == IsCreditCard('Mastercard')
+    
+    # 55xx range
+    assert '5500000000000004' == IsCreditCard('Mastercard')
+    
+    # 2221-2720 range
+    assert '2221000000000009' == IsCreditCard('Mastercard')
+    assert '2720000000000005' == IsCreditCard('Mastercard')
+
+
+def test_american_express():
+    """Test American Express numbers."""
+    # 34xx prefix
+    assert '340000000000009' == IsCreditCard('AmericanExpress')
+    
+    # 37xx prefix
+    assert '370000000000002' == IsCreditCard('AmericanExpress')
+
+
+def test_repr():
+    """Test repr output."""
+    is_cc = IsCreditCard()
+    assert str(is_cc) == 'IsCreditCard(*)'
+    
+    is_visa = IsCreditCard('Visa')
+    assert str(is_visa) == 'IsCreditCard(Visa)'
+    
+    is_mc = IsCreditCard('Mastercard')
+    assert str(is_mc) == 'IsCreditCard(Mastercard)'
+    
+    is_amex = IsCreditCard('AmericanExpress')
+    assert str(is_amex) == 'IsCreditCard(AmericanExpress)'
+
+
+def test_class_level_comparison():
+    """Test class-level comparison (without instantiation)."""
+    assert '4111111111111111' == IsCreditCard
+    assert 'invalid' != IsCreditCard
