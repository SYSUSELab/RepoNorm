+def _set_process_priority(pid: int, priority: str) -> None:
+    """Set the CPU scheduling priority of a process.
+    
+    :param pid: The process ID to set the priority for.
+    :param priority: One of ``low``, ``below_normal``, ``normal``, 
+                     ``above_normal``, or ``high``.
+    """
+    # Validate priority value
+    valid_priorities = {"low", "below_normal", "normal", "above_normal", "high"}
+    if priority not in valid_priorities:
+        raise ValueError(
+            f"Invalid process priority: {priority!r}. "
+            f"Must be one of: {', '.join(valid_priorities)}"
+        )
+    
+    try:
+        if WIN:
+            import win32process
+            import winerror
+            
+            # Map priority names to Windows priority classes
+            priority_map = {
+                "low": win32process.IDLE_PRIORITY_CLASS,
+                "below_normal": win32process.BELOW_NORMAL_PRIORITY_CLASS,
+                "normal": win32process.NORMAL_PRIORITY_CLASS,
+                "above_normal": win32process.ABOVE_NORMAL_PRIORITY_CLASS,
+                "high": win32process.HIGH_PRIORITY_CLASS,
+            }
+            
+            priority_class = priority_map[priority]
+            handle = win32process.OpenProcess(
+                win32process.PROCESS_SET_INFORMATION, False, pid
+            )
+            try:
+                win32process.SetPriorityClass(handle, priority_class)
+            finally:
+                win32process.CloseHandle(handle)
+        else:
+            # Unix-like systems use nice values (lower = higher priority)
+            # Range is typically -20 to 19, with 0 being normal
+            nice_map = {
+                "low": 19,
+                "below_normal": 10,
+                "normal": 0,
+                "above_normal": -10,
+                "high": -20,
+            }
+            nice_value = nice_map[priority]
+            os.setpriority(os.PRIO_PROCESS, pid, nice_value)
+    except (OSError, ImportError, AttributeError):
+        # If we can't set the priority (no permission, platform doesn't support),
+        # just continue without setting it
+        pass
+
+
 
