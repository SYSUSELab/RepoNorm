+    def _check_required_if(self, ctx: Context) -> bool:
+        """Check if this parameter is required based on required_if."""
+        if self.required_if is None:
+            return False
+
+        if callable(self.required_if):
+            # Call the predicate with context and this parameter
+            return self.required_if(ctx, self)
+
+        # It's a dict mapping parameter names to expected values
+        # Empty dict means never required
+        if not self.required_if:
+            return False
+
+        for param_name, expected_value in self.required_if.items():
+            # Get the actual value from context params
+            actual_value = ctx.params.get(param_name)
+            if actual_value != expected_value:
+                return False
+
+        return True
