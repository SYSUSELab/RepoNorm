+    def _validate_required_if(self, ctx: Context) -> None:
+        """Validate required_if conditions for all parameters after parsing."""
+        # First, collect all parameter names in this command
+        param_names = {p.name for p in self.get_params(ctx)}
+        
+        for param in self.get_params(ctx):
+            if param.required_if is not None and not callable(param.required_if):
+                # Validate that all keys in required_if map exist as parameters
+                for key in param.required_if.keys():
+                    if key not in param_names:
+                        from .exceptions import UsageError
+                        raise UsageError(
+                            f"required_if references unknown parameter '{key}'",
+                            ctx=ctx,
+                        )
+                
+                # Check if this parameter has a required_if condition
+                if param._check_required_if(ctx):
+                    # Check if the value is missing
+                    if param.value_is_missing(ctx.params.get(param.name)):
+                        from .exceptions import MissingParameter
+                        raise MissingParameter(ctx=ctx, param=param)
