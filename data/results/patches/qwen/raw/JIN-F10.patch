+
+
+@mark_dualiter(
+    "items",
+    lambda: [
+        {"name": "emma", "city": "NY"},
+        {"name": "john", "city": "NY"},
+        {"name": "smith", "city": "WA"},
+    ],
+)
+def test_groupby_filter_groups(env_async, items):
+    """Test filter_groups with async environment."""
+    def predicate(items_list):
+        return len(items_list) > 1
+    
+    tmpl = env_async.from_string(
+        "{% for city, list in items()|groupby('city', filter_groups=predicate) %}"
+        "{{ city }}:{{ list|length }}|{% endfor %}"
+    )
+    result = tmpl.render(items=items, predicate=predicate)
+    # Only NY has more than 1 person
+    assert result == "NY:2|"
+
+
+@mark_dualiter(
+    "items",
+    lambda: [],
+)
+def test_groupby_filter_groups_empty_input(env_async, items):
+    """Test that empty input does not invoke predicate."""
+    called = []
+    
+    def predicate(items_list):
+        called.append(True)
+        return True
+    
+    tmpl = env_async.from_string(
+        "{% for city, list in items()|groupby('city', filter_groups=predicate) %}"
+        "{{ city }}|{% endfor %}"
+    )
+    result = tmpl.render(items=items, predicate=predicate)
+    assert result == ""
+    assert len(called) == 0
+
+
