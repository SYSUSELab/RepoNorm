diff --git a/tests/test_filters.py b/tests/test_filters.py
index 43ddf59..efaa0f2 100644
--- a/tests/test_filters.py
+++ b/tests/test_filters.py
@@ -852,3 +852,135 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+    def test_groupby_filter_groups_none(self, env):
+        """Test that filter_groups=None retains all groups."""
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=None) %}"
+            "{{ city }}:{{ items|length }}|{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "emma", "city": "NY"},
+                {"name": "john", "city": "NY"},
+                {"name": "smith", "city": "WA"},
+            ]
+        )
+        assert out == "NY:2|WA:1|"
+
+    def test_groupby_filter_groups_lambda(self, env):
+        """Test filter_groups with a lambda predicate passed via Python API."""
+        def predicate(items):
+            return len(items) > 1
+        
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=predicate) %}"
+            "{{ city }}:{{ items|length }}|{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "emma", "city": "NY"},
+                {"name": "john", "city": "NY"},
+                {"name": "smith", "city": "WA"},
+            ],
+            predicate=predicate
+        )
+        # Only NY has more than 1 person
+        assert out == "NY:2|"
+
+    def test_groupby_filter_groups_empty_input(self, env):
+        """Test that empty input does not invoke predicate."""
+        called = []
+        
+        def predicate(items):
+            called.append(True)
+            return True
+        
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=predicate) %}"
+            "{{ city }}|{% endfor %}"
+        )
+        out = tmpl.render(users=[], predicate=predicate)
+        assert out == ""
+        assert len(called) == 0
+
+    def test_groupby_filter_groups_pass_environment(self, env):
+        """Test filter_groups with @pass_environment decorated function."""
+        from jinja2 import pass_environment
+        
+        @pass_environment
+        def predicate(environment, items):
+            return len(items) > 1
+        
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=predicate) %}"
+            "{{ city }}:{{ items|length }}|{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "emma", "city": "NY"},
+                {"name": "john", "city": "NY"},
+                {"name": "smith", "city": "WA"},
+            ],
+            predicate=predicate
+        )
+        assert out == "NY:2|"
+
+    def test_groupby_filter_groups_preserves_order(self, env):
+        """Test that group order and member order are preserved."""
+        def predicate(items):
+            return True
+        
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=predicate) %}"
+            "{{ city }}:{% for u in items %}{{ u.name }}-{% endfor %}|{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "b", "city": "A"},
+                {"name": "a", "city": "B"},
+                {"name": "d", "city": "A"},
+                {"name": "c", "city": "B"},
+            ],
+            predicate=predicate
+        )
+        # Groups should be sorted by key (A, B), members within each group
+        assert out == "A:b-d-|B:a-c-|"
+
+    def test_groupby_filter_groups_false_result(self, env):
+        """Test that false predicate result excludes group."""
+        def predicate(items):
+            return False
+        
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=predicate) %}"
+            "{{ city }}|{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "emma", "city": "NY"},
+                {"name": "john", "city": "NY"},
+            ],
+            predicate=predicate
+        )
+        assert out == ""
+
+    def test_groupby_filter_groups_exception_propagation(self, env):
+        """Test that exceptions propagate unchanged."""
+        def predicate(items):
+            raise ValueError("Test exception")
+        
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', filter_groups=predicate) %}"
+            "{{ city }}|{% endfor %}"
+        )
+        try:
+            tmpl.render(
+                users=[
+                    {"name": "emma", "city": "NY"},
+                ],
+                predicate=predicate
+            )
+            assert False, "Should have raised ValueError"
+        except ValueError as e:
+            assert str(e) == "Test exception"
