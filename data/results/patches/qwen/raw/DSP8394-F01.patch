+    def _get_bypass_state(self) -> int:
+        """Get the current bypass nesting level for this Cache instance.
+        
+        Returns:
+            The number of active bypass contexts (0 if none active).
+        """
+        # Use thread-local storage to track bypass state
+        if not hasattr(_bypass_stack, 'cache_states'):
+            _bypass_stack.cache_states = {}
+        
+        states = _bypass_stack.cache_states
+        if id(self) not in states:
+            states[id(self)] = []
+        
+        return len(states[id(self)])
+
+    def _set_bypass_state(self, state: int) -> None:
+        """Set the bypass nesting level for this Cache instance."""
+        if not hasattr(_bypass_stack, 'cache_states'):
+            _bypass_stack.cache_states = {}
+        
+        states = _bypass_stack.cache_states
+        if id(self) not in states:
+            states[id(self)] = []
+        
+        # Adjust the stack to match the desired state
+        while len(states[id(self)]) < state:
+            states[id(self)].append(None)
+        while len(states[id(self)]) > state:
+            states[id(self)].pop()
