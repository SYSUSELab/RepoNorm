+    @contextmanager
+    def bypass(self) -> Any:
+        """Context manager to temporarily bypass cache reads.
+        
+        When entered, cache reads behave as cache misses even when a value is stored.
+        Writes remain enabled according to the existing memory/disk configuration.
+        
+        Nested contexts retain bypass until their outer context exits. Normal and
+        exceptional exits restore the previous state. Bypass is local to the current
+        thread/asynchronous execution context; an independently started thread or 
+        sibling async task must retain its own state.
+        
+        Example:
+            >>> with dspy.cache.bypass():
+            ...     result = cache.get(request)  # Always returns None (cache miss)
+            ...     cache.put(request, new_value)  # Write still works
+        
+        Note:
+            This synchronous context manager can be used inside an async function
+            and remains effective across awaits.
+        """
+        old_state = self._get_bypass_state()
+        self._set_bypass_state(old_state + 1)
+        try:
+            yield
+        finally:
+            self._set_bypass_state(old_state)
