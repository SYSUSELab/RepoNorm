+++ b/dirty_equals/_regex.py
@@ -0,0 +1,102 @@
+import re
+from typing import Any, Literal, Pattern, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsRegex(DirtyEquals[str]):
+    """
+    Checks if a value is a string that matches a regular expression pattern.
+
+    `IsRegex` allows matching strings against regex patterns with support for
+    different match modes (`match`, `search`, `fullmatch`) and regex flags.
+
+    Args:
+        pattern: Regular expression pattern as a string or compiled pattern.
+        flags: Optional regex flags (e.g., `re.IGNORECASE`, `re.MULTILINE`).
+        mode: Match mode - `'match'` (default), `'search'`, or `'fullmatch'`.
+
+    Examples:
+        ```py title="IsRegex"
+        from dirty_equals import IsRegex
+        import re
+
+        assert "foobar" == IsRegex(r"foo.*")
+        assert "foobar" == IsRegex(r"foo", mode="match")
+        assert "foobar" == IsRegex(r"bar", mode="search")
+        assert "foobar" == IsRegex(r"foobar", mode="fullmatch")
+        assert "foobar" != IsRegex(r"^baz$", mode="match")
+        assert "foobar" == IsRegex(r"foobar", mode="fullmatch")
+
+        assert "FOOBAR" == IsRegex(r"foo", flags=re.I)
+        assert "foobar" == IsRegex(r"foo\nbar", flags=re.S)
+
+        # Using compiled patterns
+        pattern = re.compile(r"foo.*")
+        assert "foobar" == IsRegex(pattern)
+        ```
+    """
+
+    def __init__(
+        self,
+        pattern: Union[str, Pattern[str]],
+        flags: int = 0,
+        *,
+        mode: Literal["match", "search", "fullmatch"] = "match",
+    ):
+        self.mode = mode
+        self._check_mode(mode)
+        self.compiled_pattern, self.flags = self._prepare_pattern(pattern, flags)
+        super().__init__(
+            plain_repr(repr(self.compiled_pattern.pattern)),
+            flags=Omit if self.flags == 0 else plain_repr(repr(re.RegexFlag(self.flags))),
+            mode=Omit if self.mode == "match" else plain_repr(repr(self.mode)),
+        )
+
+    @staticmethod
+    def _check_mode(mode: str) -> None:
+        valid_modes = {"match", "search", "fullmatch"}
+        if mode not in valid_modes:
+            raise ValueError(
+                f"mode must be one of {valid_modes}, got {mode!r}"
+            )
+
+    def _prepare_pattern(
+        self, pattern: Union[str, Pattern[str]], flags: int
+    ) -> tuple[Pattern[str], int]:
+        if isinstance(pattern, bytes):
+            raise TypeError("IsRegex does not support bytes patterns")
+
+        if isinstance(pattern, re.Pattern):
+            if flags != 0:
+                raise ValueError(
+                    "Cannot pass flags when pattern is already compiled"
+                )
+            return pattern, pattern.flags
+        elif isinstance(pattern, str):
+            try:
+                compiled = re.compile(pattern, flags)
+            except re.error:
+                raise
+            return compiled, flags
+        else:
+            raise TypeError(f"pattern must be str or Pattern[str], got {type(pattern)}")
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.mode == "match":
+            return re.match(self.compiled_pattern, other) is not None
+        elif self.mode == "search":
+            return re.search(self.compiled_pattern, other) is not None
+        elif self.mode == "fullmatch":
+            return re.fullmatch(self.compiled_pattern, other) is not None
+
+        return False
