           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    A ``key_transform`` function can be specified to transform the
+    displayed grouper value while keeping the original key for grouping
+    and sorting purposes. This allows different keys to display the same
+    value without merging groups.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", key_transform=str.upper) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
     .. versionchanged:: 2.6
         The attribute supports dot notation for nested access.
     """
+    from .utils import _PassArg
+
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+    result = []
+    for key, values in groupby(sorted(value, key=expr), expr):
+        if key_transform is not None:
+            pass_arg = _PassArg.from_obj(key_transform)
+            if pass_arg is _PassArg.environment:
+                key = key_transform(environment, key)
+            else:
+                key = key_transform(key)
+        result.append(_GroupTuple(key, list(values)))
+    return result
 
 
