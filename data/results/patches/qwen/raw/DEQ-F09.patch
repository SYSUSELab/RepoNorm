@@ -0,0 +1,155 @@
+import re
+from typing import Any, Literal, Optional, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal as TypingLiteral
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsColor(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid color code in hex, RGB, or HSL format.
+
+    Supports three formats:
+    - Hex: `#RGB` or `#RRGGBB` (with optional `#`)
+    - RGB: `rgb(r, g, b)` where r, g, b are integers 0-255 or percentages 0-100%
+    - HSL: `hsl(h, s%, l%)` where h is 0-360, s and l are percentages 0-100%
+
+    The `format` parameter can be used to restrict validation to a specific format.
+    Without it, any supported format is accepted.
+
+    Examples:
+    ```py title="IsColor"
+    from dirty_equals import IsColor
+
+    assert '#FF5733' == IsColor
+    assert '#f57' == IsColor
+    assert 'ff5733' == IsColor
+    assert 'rgb(255, 87, 51)' == IsColor
+    assert 'RGB(255, 87, 51)' == IsColor
+    assert 'rgb(100%, 50%, 25%)' == IsColor
+    assert 'hsl(14, 100%, 60%)' == IsColor
+    assert 'HSL(14, 100%, 60%)' == IsColor
+    assert 'hsl(14deg, 100%, 60%)' == IsColor
+
+    assert '#FF5733' == IsColor('hex')
+    assert 'rgb(255, 87, 51)' == IsColor('rgb')
+    assert 'hsl(14, 100%, 60%)' == IsColor('hsl')
+
+    assert '#FF5733' != IsColor('rgb')
+    assert 'rgb(255, 87, 51)' != IsColor('hex')
+    ```
+    """
+
+    def __init__(
+        self,
+        format: Optional[Literal['hex', 'rgb', 'hsl']] = None,
+    ):
+        """
+        Args:
+            format: The expected color format ('hex', 'rgb', or 'hsl').
+                    If omitted, any supported format is accepted.
+
+        ```py title="IsColor"
+        from dirty_equals import IsColor
+
+        assert '#FF5733' == IsColor
+        assert '#FF5733' == IsColor('hex')
+        assert 'rgb(255, 87, 51)' == IsColor('rgb')
+        ```
+        """
+        super().__init__(plain_repr('*') if format is None else format)
+        self.format = format
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        value = other.strip()
+        if not value:
+            return False
+
+        if self.format is None:
+            return (
+                self._is_hex(value)
+                or self._is_rgb(value)
+                or self._is_hsl(value)
+            )
+        elif self.format == 'hex':
+            return self._is_hex(value)
+        elif self.format == 'rgb':
+            return self._is_rgb(value)
+        elif self.format == 'hsl':
+            return self._is_hsl(value)
+        else:
+            return False
+
+    def _is_hex(self, value: str) -> bool:
+        """Check if value is a valid hex color."""
+        # Pattern for hex color: optional # followed by 3 or 6 hex digits
+        pattern = r'^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$'
+        return bool(re.fullmatch(pattern, value))
+
+    def _is_rgb(self, value: str) -> bool:
+        """Check if value is a valid rgb() color."""
+        # Pattern for rgb: rgb(...) with case-insensitive function name
+        # Components can be integers 0-255 or percentages 0-100%
+        # Whitespace allowed around commas but not inside numbers
+        pattern = r'^rgb\s*\(\s*([0-9]{1,3}|[0-9]{1,3}%)\s*,\s*([0-9]{1,3}|[0-9]{1,3}%)\s*,\s*([0-9]{1,3}|[0-9]{1,3}%)\s*\)$'
+        match = re.fullmatch(pattern, value, flags=re.IGNORECASE)
+        if not match:
+            return False
+
+        # Validate each component
+        for i in range(1, 4):
+            component = match.group(i)
+            if '%' in component:
+                # Percentage format
+                num = int(component[:-1])
+                if num < 0 or num > 100:
+                    return False
+            else:
+                # Integer format
+                num = int(component)
+                if num < 0 or num > 255:
+                    return False
+
+        return True
+
+    def _is_hsl(self, value: str) -> bool:
+        """Check if value is a valid hsl() color."""
+        # Pattern for hsl: hsl(...) with case-insensitive function name
+        # Hue can be 0-360 with optional deg suffix
+        # Saturation and lightness are percentages 0-100%
+        # Whitespace allowed around commas but not inside numbers
+        pattern = r'^hsl\s*\(\s*([0-9]{1,3}(?:deg)?)\s*,\s*([0-9]{1,3}%)\s*,\s*([0-9]{1,3}%)\s*\)$'
+        match = re.fullmatch(pattern, value, flags=re.IGNORECASE)
+        if not match:
+            return False
+
+        # Validate hue
+        hue_str = match.group(1)
+        if hue_str.endswith('deg'):
+            hue = int(hue_str[:-3])
+        else:
+            hue = int(hue_str)
+        if hue < 0 or hue > 360:
+            return False
+
+        # Validate saturation
+        sat_str = match.group(2)
+        sat = int(sat_str[:-1])
+        if sat < 0 or sat > 100:
+            return False
+
+        # Validate lightness
+        light_str = match.group(3)
+        light = int(light_str[:-1])
+        if light < 0 or light > 100:
+            return False
+
+        return True
