diff --git a/apply_fix.py b/apply_fix.py
new file mode 100644
index 0000000..5ecdf1c
--- /dev/null
+++ b/apply_fix.py
@@ -0,0 +1,53 @@
+import re
+
+# Read the file
+with open('/workspace/repo/tiktoken/core.py', 'r') as f:
+    content = f.read()
+
+# 1. Add Counter import after functools (already done, skip)
+
+# 2. Modify encode method signature and return type (already done, skip)
+
+# 3. Modify encode method body to capture tokens and optionally return frequency
+old_encode_body = '''        try:
+            return self._core_bpe.encode(text, allowed_special)
+        except UnicodeEncodeError:
+            # BPE operates on bytes, but the regex operates on unicode. If we pass a str that is
+            # invalid UTF-8 to Rust, it will rightfully complain. Here we do a quick and dirty
+            # fixup for any surrogate pairs that may have sneaked their way into the text.
+            # Technically, this introduces a place where encode + decode doesn't roundtrip a Python
+            # string, but given that this is input we want to support, maybe that's okay.
+            # Also we use errors="replace" to handle weird things like lone surrogates.
+            text = text.encode("utf-16", "surrogatepass").decode("utf-16", "replace")
+            return self._core_bpe.encode(text, allowed_special)'''
+
+new_encode_body = '''        try:
+            tokens = self._core_bpe.encode(text, allowed_special)
+        except UnicodeEncodeError:
+            # BPE operates on bytes, but the regex operates on unicode. If we pass a str that is
+            # invalid UTF-8 to Rust, it will rightfully complain. Here we do a quick and dirty
+            # fixup for any surrogate pairs that may have sneaked their way into the text.
+            # Technically, this introduces a place where encode + decode doesn't roundtrip a Python
+            # string, but given that this is input we want to support, maybe that's okay.
+            # Also we use errors="replace" to handle weird things like lone surrogates.
+            text = text.encode("utf-16", "surrogatepass").decode("utf-16", "replace")
+            tokens = self._core_bpe.encode(text, allowed_special)
+
+        if analyze_frequency:
+            frequency = dict(Counter(tokens))
+            return tokens, frequency
+        return tokens'''
+
+content = content.replace(old_encode_body, new_encode_body)
+
+# 4. Modify encode_batch method signature and return type (already done, skip)
+
+# 5. Modify encode_batch docstring to include analyze_frequency example (already done, skip)
+
+# 6. Modify encode_batch encoder partial to include analyze_frequency (already done, skip)
+
+# Write the file
+with open('/workspace/repo/tiktoken/core.py', 'w') as f:
+    f.write(content)
+
+print("Fix applied successfully!")
diff --git a/test_frequency.py b/test_frequency.py
new file mode 100644
index 0000000..3dea516
--- /dev/null
+++ b/test_frequency.py
@@ -0,0 +1,112 @@
+import tiktoken
+
+# Test basic encode functionality
+enc = tiktoken.get_encoding("gpt2")
+
+# Test 1: Basic encode without analyze_frequency
+print("Test 1: Basic encode without analyze_frequency")
+result = enc.encode("hello world hello")
+print(f"Result: {result}")
+print(f"Type: {type(result)}")
+assert isinstance(result, list), "Should return list"
+
+# Test 2: Basic encode_batch without analyze_frequency
+print("\nTest 2: Basic encode_batch without analyze_frequency")
+result = enc.encode_batch(["hello world", "goodbye world"])
+print(f"Result: {result}")
+print(f"Type: {type(result)}")
+assert isinstance(result, list), "Should return list"
+
+# Test 3: Empty batch
+print("\nTest 3: Empty batch")
+result = enc.encode_batch([])
+print(f"Result: {result}")
+print(f"Type: {type(result)}")
+assert result == [], "Empty batch should return []"
+
+# Test 4: encode with analyze_frequency=True
+print("\nTest 4: encode with analyze_frequency=True")
+result = enc.encode("hello world hello", analyze_frequency=True)
+print(f"Result: {result}")
+tokens, freq = result
+print(f"Tokens: {tokens}")
+print(f"Frequency: {freq}")
+assert isinstance(tokens, list), "First element should be list"
+assert isinstance(freq, dict), "Second element should be dict"
+assert freq[31373] == 1, "Token 31373 (hello) should appear once"
+assert freq[995] == 1, "Token 995 ( world) should appear once"
+assert freq[23748] == 1, "Token 23748 ( hello) should appear once"
+
+# Test 5: encode_batch with analyze_frequency=True
+print("\nTest 5: encode_batch with analyze_frequency=True")
+result = enc.encode_batch(["hello world", "hello goodbye"], analyze_frequency=True)
+print(f"Result: {result}")
+doc_tokens, corpus_freq = result
+print(f"Document tokens: {doc_tokens}")
+print(f"Corpus frequency: {corpus_freq}")
+assert isinstance(doc_tokens, list), "First element should be list"
+assert isinstance(corpus_freq, dict), "Second element should be dict"
+assert len(doc_tokens) == 2, "Should have 2 document token lists"
+# Check that frequencies are summed correctly
+assert corpus_freq[31373] == 2, "Token 31373 (hello) should appear twice in corpus"
+assert corpus_freq[995] == 1, "Token 995 ( world) should appear once in corpus"
+assert corpus_freq[24829] == 1, "Token 24829 (goodbye) should appear once in corpus"
+
+# Test 6: Empty batch with analyze_frequency=True
+print("\nTest 6: Empty batch with analyze_frequency=True")
+result = enc.encode_batch([], analyze_frequency=True)
+print(f"Result: {result}")
+doc_tokens, corpus_freq = result
+print(f"Document tokens: {doc_tokens}")
+print(f"Corpus frequency: {corpus_freq}")
+assert doc_tokens == [], "Empty batch should return empty list for document tokens"
+assert corpus_freq == {}, "Empty batch should return empty dict for corpus frequency"
+
+# Test 7: Verify per-document order is maintained
+print("\nTest 7: Verify per-document order is maintained")
+result_with_freq = enc.encode_batch(["hello world", "world hello"], analyze_frequency=True)
+result_without_freq = enc.encode_batch(["hello world", "world hello"])
+print(f"With frequency: {result_with_freq}")
+print(f"Without frequency: {result_without_freq}")
+assert result_with_freq[0] == result_without_freq, "Order should be preserved"
+
+# Test 8: Special tokens with analyze_frequency
+print("\nTest 8: Special tokens with analyze_frequency")
+endoftext_token = "<|endoftext|>"
+result = enc.encode(endoftext_token, allowed_special={endoftext_token}, analyze_frequency=True)
+print(f"Result: {result}")
+tokens, freq = result
+print(f"Tokens: {tokens}")
+print(f"Frequency: {freq}")
+assert len(tokens) == 1, "Should have 1 token"
+assert endoftext_token in enc.special_tokens_set, "Should be a special token"
+
+# Test 9: Unicode handling with analyze_frequency
+print("\nTest 9: Unicode handling with analyze_frequency")
+result = enc.encode("hello delimiter", disallowed_special=(), analyze_frequency=True)
+print(f"Result: {result}")
+tokens, freq = result
+print(f"Tokens: {tokens}")
+print(f"Frequency: {freq}")
+assert isinstance(tokens, list), "Should return list"
+assert isinstance(freq, dict), "Should return dict"
+
+# Test 10: Batch thread count doesn't change summary
+print("\nTest 10: Batch thread count doesn't change summary")
+result_threads_1 = enc.encode_batch(["hello world", "hello world"], num_threads=1, analyze_frequency=True)
+result_threads_8 = enc.encode_batch(["hello world", "hello world"], num_threads=8, analyze_frequency=True)
+print(f"Threads=1: {result_threads_1}")
+print(f"Threads=8: {result_threads_8}")
+assert result_threads_1 == result_threads_8, "Thread count should not affect summary"
+
+# Test 11: Repeated documents in batch
+print("\nTest 11: Repeated documents in batch")
+result = enc.encode_batch(["hello", "hello", "world"], analyze_frequency=True)
+print(f"Result: {result}")
+doc_tokens, corpus_freq = result
+print(f"Document tokens: {doc_tokens}")
+print(f"Corpus frequency: {corpus_freq}")
+assert corpus_freq[31373] == 2, "Token 31373 (hello) should appear twice"
+assert corpus_freq[6894] == 1, "Token 6894 (world) should appear once"
+
+print("\nAll tests passed!")
