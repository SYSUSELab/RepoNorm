+def _canonicalize_value(value: Any) -> Any:
+    """Convert value to canonical form for fingerprinting.
+    
+    - Trims surrounding whitespace from string values
+    - Treats tuples as lists
+    - Recursively sorts dictionary keys
+    - Preserves numeric/boolean types and list order
+    - Rejects nonfinite numbers and non-JSON values with ValueError
+    
+    Args:
+        value: The value to canonicalize
+        
+    Returns:
+        The canonicalized value
+        
+    Raises:
+        ValueError: If the value contains nonfinite numbers or non-JSON types
+    """
+    if value is None:
+        return None
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)):
+        # Reject nonfinite numbers
+        if isinstance(value, float) and (math.isinf(value) or math.isnan(value)):
+            raise ValueError(f"Nonfinite number not allowed: {value}")
+        return value
+    if isinstance(value, str):
+        # Trim surrounding whitespace from string values
+        return value.strip()
+    if isinstance(value, tuple):
+        # Treat tuples as lists
+        return [_canonicalize_value(item) for item in value]
+    if isinstance(value, list):
+        return [_canonicalize_value(item) for item in value]
+    if isinstance(value, dict):
+        # Recursively sort dictionary keys
+        return {k: _canonicalize_value(v) for k, v in sorted(value.items())}
+    raise ValueError(f"Non-JSON value type: {type(value)}")
+
