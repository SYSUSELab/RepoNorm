+    def set_translation_version(self, message: str, version: str) -> None:
+        """Set the version for a translation message."""
+        self.environment.translation_versions[message] = version
+
+    def get_translation_version(self, message: str) -> t.Optional[str]:
+        """Get the version for a translation message. Returns None if not found."""
+        return self.environment.translation_versions.get(message)
+
+    def compare_translation_versions(self, message1: str, message2: str) -> bool:
+        """Compare two translation versions. Returns True only when both messages are
+        registered and their versions are equal.
+        """
+        v1 = self.environment.translation_versions.get(message1)
+        v2 = self.environment.translation_versions.get(message2)
+        return v1 is not None and v2 is not None and v1 == v2
+
+    def remove_translation_version(self, message: str) -> None:
+        """Remove a translation version entry. Harmless for unknown messages."""
+        self.environment.translation_versions.pop(message, None)
+
+    def clear_translation_versions(self) -> None:
+        """Remove all translation version entries."""
+        self.environment.translation_versions.clear()
+
     def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
