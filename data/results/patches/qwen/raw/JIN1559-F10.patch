+    def test_translation_version_tracking(self):
+        """Test basic set/get/remove/clear of translation versions."""
+        env = Environment(extensions=[InternationalizationExtension])
+        
+        # Test set_translation_version
+        env.set_translation_version("hello", "v1")
+        assert env.get_translation_version("hello") == "v1"
+        
+        # Test get on unknown message returns None
+        assert env.get_translation_version("unknown") is None
+        
+        # Test remove_translation_version
+        env.remove_translation_version("hello")
+        assert env.get_translation_version("hello") is None
+        
+        # Test clear_translation_versions
+        env.set_translation_version("msg1", "v1")
+        env.set_translation_version("msg2", "v2")
+        env.clear_translation_versions()
+        assert env.get_translation_version("msg1") is None
+        assert env.get_translation_version("msg2") is None
+
+    def test_compare_translation_versions(self):
+        """Test compare_translation_versions function."""
+        env = Environment(extensions=[InternationalizationExtension])
+        
+        # Both messages registered with same version -> True
+        env.set_translation_version("msg1", "v1")
+        env.set_translation_version("msg2", "v1")
+        assert env.compare_translation_versions("msg1", "msg2") == True
+        
+        # Both messages registered with different versions -> False
+        env.set_translation_version("msg3", "v2")
+        assert env.compare_translation_versions("msg1", "msg3") == False
+        
+        # One or both messages not registered -> False
+        assert env.compare_translation_versions("msg1", "unknown") == False
+        assert env.compare_translation_versions("unknown", "msg2") == False
+        assert env.compare_translation_versions("unknown", "unknown") == False
+
+    def test_overlay_copies_versions(self):
+        """Test that overlay copies version state from parent and isolates updates."""
+        env = Environment(extensions=[InternationalizationExtension])
+        
+        # Set some versions in parent
+        env.set_translation_version("parent_msg", "v1")
+        env.set_translation_version("shared_msg", "v1")
+        
+        # Create overlay
+        overlay = env.overlay()
+        
+        # Overlay should have parent's versions
+        assert overlay.get_translation_version("parent_msg") == "v1"
+        assert overlay.get_translation_version("shared_msg") == "v1"
+        
+        # Updates in overlay are isolated
+        overlay.set_translation_version("parent_msg", "v2")
+        overlay.set_translation_version("overlay_msg", "v1")
+        
+        # Parent unchanged
+        assert env.get_translation_version("parent_msg") == "v1"
+        assert env.get_translation_version("overlay_msg") is None
+        
+        # Overlay has its own updates
+        assert overlay.get_translation_version("parent_msg") == "v2"
+        assert overlay.get_translation_version("overlay_msg") == "v1"
+
+    def test_translation_version_empty_unicode_long_strings(self):
+        """Test empty, Unicode, and long strings."""
+        env = Environment(extensions=[InternationalizationExtension])
+        
+        # Empty string
+        env.set_translation_version("", "v1")
+        assert env.get_translation_version("") == "v1"
+        
+        # Unicode string
+        env.set_translation_version("你好世界", "v1")
+        assert env.get_translation_version("你好世界") == "v1"
+        
+        # Long string
+        long_msg = "a" * 10000
+        env.set_translation_version(long_msg, "v1")
+        assert env.get_translation_version(long_msg) == "v1"
