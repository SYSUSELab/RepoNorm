+def _check_trans_expr(
+    node: nodes.Expr, lineno: int, parser: "Parser"
+) -> None:
+    """Check if an expression is valid for use in trans blocks.
+    
+    Valid expressions consist of:
+    - Constants
+    - Names (simple variables)
+    - Attribute access
+    - Filters
+    - Tests
+    - Calls whose callee is a simple name
+    
+    Invalid expressions include:
+    - Item access (subscript)
+    - Arithmetic operations
+    - Conditional expressions
+    - Method calls (attribute followed by call)
+    - Dynamic *args or **kwargs
+    
+    Raises TemplateSyntaxError with template data and translation contexts
+    information when invalid.
+    """
+    _validate_trans_node(node, lineno, parser)
+
+
+def _validate_trans_node(
+    node: nodes.Node, lineno: int, parser: "Parser", parent_is_call_arg: bool = False
+) -> None:
+    """Recursively validate a node for use in trans blocks."""
+    if isinstance(node, nodes.Const):
+        # Constants are always valid
+        return
+    elif isinstance(node, nodes.Name):
+        # Simple names are valid
+        return
+    elif isinstance(node, nodes.Getattr):
+        # Attribute access is valid
+        _validate_trans_node(node.node, lineno, parser)
+        return
+    elif isinstance(node, nodes.Filter):
+        # Filter is valid, but check its arguments
+        if node.node is not None:
+            _validate_trans_node(node.node, lineno, parser)
+        for arg in node.args:
+            _validate_trans_node(arg, lineno, parser)
+        for kw in node.kwargs:
+            _validate_trans_node(kw.value, lineno, parser)
+        if node.dyn_args is not None:
+            parser.fail(
+                f"dynamic *args not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        if node.dyn_kwargs is not None:
+            parser.fail(
+                f"dynamic **kwargs not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        return
+    elif isinstance(node, nodes.Test):
+        # Test is valid, but check its arguments
+        _validate_trans_node(node.node, lineno, parser)
+        for arg in node.args:
+            _validate_trans_node(arg, lineno, parser)
+        for kw in node.kwargs:
+            _validate_trans_node(kw.value, lineno, parser)
+        if node.dyn_args is not None:
+            parser.fail(
+                f"dynamic *args not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        if node.dyn_kwargs is not None:
+            parser.fail(
+                f"dynamic **kwargs not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        return
+    elif isinstance(node, nodes.Call):
+        # Call is valid only if callee is a simple name
+        if not isinstance(node.node, nodes.Name):
+            parser.fail(
+                f"method calls not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        for arg in node.args:
+            _validate_trans_node(arg, lineno, parser)
+        for kw in node.kwargs:
+            _validate_trans_node(kw.value, lineno, parser)
+        if node.dyn_args is not None:
+            parser.fail(
+                f"dynamic *args not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        if node.dyn_kwargs is not None:
+            parser.fail(
+                f"dynamic **kwargs not allowed in translation expression - template data, translation contexts",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        return
+    elif isinstance(node, nodes.BinExpr):
+        # Binary expressions (arithmetic, comparisons, etc.) are not allowed
+        parser.fail(
+            f"arithmetic and comparison expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.UnaryExpr):
+        # Unary expressions are not allowed
+        parser.fail(
+            f"unary expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Compare):
+        # Comparisons are not allowed
+        parser.fail(
+            f"comparison expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.CondExpr):
+        # Conditional expressions are not allowed
+        parser.fail(
+            f"conditional expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Getitem):
+        # Item access is not allowed
+        parser.fail(
+            f"item access not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Or):
+        # Boolean OR is not allowed
+        parser.fail(
+            f"boolean expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.And):
+        # Boolean AND is not allowed
+        parser.fail(
+            f"boolean expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Not):
+        # Boolean NOT is not allowed
+        parser.fail(
+            f"boolean expressions not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.TemplateData):
+        # Template data is valid
+        return
+    elif isinstance(node, nodes.List):
+        # Lists are not allowed
+        parser.fail(
+            f"list literals not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Dict):
+        # Dicts are not allowed
+        parser.fail(
+            f"dict literals not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Tuple):
+        # Tuples are not allowed
+        parser.fail(
+            f"tuple literals not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Slice):
+        # Slices are not allowed
+        parser.fail(
+            f"slices not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.Concat):
+        # Concat is not allowed
+        parser.fail(
+            f"concatenation not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    elif isinstance(node, nodes.NSRef):
+        # Namespace references are not allowed
+        parser.fail(
+            f"namespace references not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+    else:
+        # Any other node type is not allowed
+        parser.fail(
+            f"expression {type(node).__name__!r} not allowed in translation expression - template data, translation contexts",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
