+    def _matches_filter(self, name: str) -> bool:
+        """Check if a template name matches any registered filter."""
+        for pattern in self._filters:
+            try:
+                if isinstance(pattern, str):
+                    # String uses case-sensitive glob matching
+                    if fnmatch.fnmatch(name, pattern):
+                        return True
+                elif isinstance(pattern, re.Pattern):
+                    # Compiled regex uses search
+                    if pattern.search(name):
+                        return True
+                elif callable(pattern):
+                    # Callable receives the template name and excludes when truthy
+                    if pattern(name):
+                        return True
+                else:
+                    raise TypeError(
+                        f"Unsupported filter type {type(pattern).__name__!r}"
+                    )
+            except Exception:
+                # Exceptions raised while matching propagate unchanged
+                raise
+        return False
+
+    def add_filter(self, filter_pattern: t.Any) -> None:
+        """Add a filter that excludes templates from ``list_templates`` when
+        the filter matches.
+
+        Filters can be:
+
+        - Strings: use case-sensitive glob matching via :func:`fnmatch.fnmatch`.
+        - Compiled regular expressions: use :meth:`re.Pattern.search`.
+        - Callables: receive the template name and should return truthy to exclude.
+
+        Unsupported objects raise :exc:`TypeError`. Exceptions raised while
+        matching propagate unchanged.
+
+        Filters persist until cleared by :meth:`clear_filters`.
+
+        .. versionadded:: 3.1
+        """
+        if not isinstance(filter_pattern, (str, type(re.compile("")))) and not callable(filter_pattern):
+            raise TypeError(
+                f"Unsupported filter type: {type(filter_pattern).__name__}"
+            )
+        self._filters.append(filter_pattern)
+
+    def clear_filters(self) -> None:
+        """Clear all registered filters.
+
+        .. versionadded:: 3.1
+        """
+        self._filters.clear()
+
+    @contextmanager
+    def filter_scope(self, *patterns: t.Any) -> t.Iterator[None]:
+        """A synchronous context manager for temporarily adding filters.
+
+        This is useful for temporarily filtering template listings, for example
+        while compiling a selected subset of templates.
+
+        Accepts the same filter inputs as :meth:`add_filter`. Scopes may nest;
+        leaving a scope restores the filter configuration present on entry,
+        including when entering or executing the scope raises an exception.
+        Filter changes made inside the scope are temporary.
+
+        The scope is local to that loader and does not promise thread or
+        asynchronous-task isolation.
+
+        .. versionadded:: 3.1
+        """
+        saved_filters = self._filters[:]
+        try:
+            for pattern in patterns:
+                self.add_filter(pattern)
+            yield
+        finally:
+            self._filters = saved_filters
+
