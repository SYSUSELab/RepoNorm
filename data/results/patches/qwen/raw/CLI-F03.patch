diff --git a/test_max_resources.py b/test_max_resources.py
new file mode 100644
index 0000000..3e54676
--- /dev/null
+++ b/test_max_resources.py
@@ -0,0 +1,103 @@
+import click
+from contextlib import contextmanager
+
+@contextmanager
+def resource(name):
+    print(f"Entering {name}")
+    yield name
+    print(f"Exiting {name}")
+
+# Test 1: Basic max_resources limit
+print("=== Test 1: Basic max_resources limit ===")
+ctx = click.Context(click.Command('test'), max_resources=2)
+r1 = ctx.with_resource(resource("r1"))
+print(f"Got resource: {r1}")
+r2 = ctx.with_resource(resource("r2"))
+print(f"Got resource: {r2}")
+try:
+    r3 = ctx.with_resource(resource("r3"))
+    print("ERROR: Should have raised RuntimeError")
+except RuntimeError as e:
+    print(f"Correctly raised RuntimeError: {e}")
+ctx.close()
+
+# Test 2: Zero max_resources
+print("\n=== Test 2: Zero max_resources ===")
+ctx = click.Context(click.Command('test'), max_resources=0)
+try:
+    r1 = ctx.with_resource(resource("r1"))
+    print("ERROR: Should have raised RuntimeError")
+except RuntimeError as e:
+    print(f"Correctly raised RuntimeError: {e}")
+
+# Test 3: Inheritance of max_resources
+print("\n=== Test 3: Inheritance of max_resources ===")
+parent = click.Context(click.Command('parent'), max_resources=2)
+p1 = parent.with_resource(resource("p1"))
+print(f"Parent got resource: {p1}")
+child = click.Context(click.Command('child'), parent=parent)
+c1 = child.with_resource(resource("c1"))
+print(f"Child got resource: c1")
+try:
+    c2 = child.with_resource(resource("c2"))
+    print(f"ERROR: Should have raised RuntimeError but got: {c2}")
+except RuntimeError as e:
+    print(f"Correctly raised RuntimeError: {e}")
+parent.close()
+
+# Test 4: Explicit child limit
+print("\n=== Test 4: Explicit child limit ===")
+parent = click.Context(click.Command('parent'), max_resources=1)
+p1 = parent.with_resource(resource("p1"))
+print(f"Parent got resource: {p1}")
+child = click.Context(click.Command('child'), parent=parent, max_resources=1)
+c1 = child.with_resource(resource("c1"))
+print(f"Child got resource: {c1}")
+try:
+    r2 = child.with_resource(resource("c2"))
+    print(f"ERROR: Should have raised RuntimeError but got: {r2}")
+except RuntimeError as e:
+    print(f"Correctly raised RuntimeError: {e}")
+parent.close()
+
+# Test 5: Failed entry returns reservation
+print("\n=== Test 5: Failed entry returns reservation ===")
+class FailingContext:
+    def __enter__(self):
+        raise ValueError("Failed!")
+    def __exit__(self, *args):
+        pass
+
+ctx = click.Context(click.Command('test'), max_resources=2)
+r1 = ctx.with_resource(resource("r1"))
+print(f"Got resource: {r1}")
+try:
+    failing = ctx.with_resource(FailingContext())
+    print("ERROR: Should have raised ValueError")
+except ValueError:
+    print("Failed entry correctly raised ValueError")
+r2 = ctx.with_resource(resource("r2"))
+print(f"Got resource after failure: {r2}")
+ctx.close()
+
+# Test 6: Repeated close
+print("\n=== Test 6: Repeated close ===")
+ctx = click.Context(click.Command('test'), max_resources=2)
+r1 = ctx.with_resource(resource("r1"))
+print(f"Got resource: {r1}")
+ctx.close()
+print("First close done")
+ctx.close()
+print("Second close done")
+
+# Test 7: Closed context re-registration
+print("\n=== Test 7: Closed context re-registration ===")
+ctx = click.Context(click.Command('test'), max_resources=2)
+r1 = ctx.with_resource(resource("r1"))
+print(f"Got resource: {r1}")
+ctx.close()
+r2 = ctx.with_resource(resource("r2"))
+print(f"Got resource after reopen: {r2}")
+ctx.close()
+
+print("\n=== All tests completed ===")
