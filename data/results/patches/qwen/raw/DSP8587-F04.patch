+    def tick(self, now_ts: float | None = None) -> StreamResponse | None:
+        """Check if the stream has timed out due to idle period.
+        
+        Args:
+            now_ts: Optional timestamp to use for timeout checking. If None, uses self.clock().
+            
+        Returns:
+            A StreamResponse with empty chunk if timeout occurred, None otherwise.
+            After returning a timeout response, subsequent calls return None.
+        """
+        if self.idle_timeout_s is None:
+            return None
+            
+        if not self.stream_start:
+            return None
+            
+        current_time = now_ts if now_ts is not None else self.clock()
+        
+        if self._last_activity_time is None:
+            return None
+            
+        elapsed = current_time - self._last_activity_time
+        if elapsed >= self.idle_timeout_s:
+            if self._timeout_response_sent:
+                return None
+            self._timeout_response_sent = True
+            # Clear state to prevent duplicate timeout responses
+            self.stream_end = True
+            self.cache_hit = False
+            self.field_start_queue = []
+            self.field_end_queue = Queue()
+            self.stream_start = False
