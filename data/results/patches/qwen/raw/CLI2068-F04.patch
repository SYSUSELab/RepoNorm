+
+
+def test_edit_editor_args(runner):
+    """Test editor_args parameter functionality."""
+    import tempfile
+    import os
+    
+    # Test 1: Empty editor_args (should work like before)
+    result = click.edit(text="a\nb", editor_args=[], editor="sed -i~ 's/$/Test/'")
+    assert result == "aTest\nbTest\n"
+    
+    # Test 2: None editor_args (should work like before)
+    result = click.edit(text="a\nb", editor_args=None, editor="sed -i~ 's/$/Test/'")
+    assert result == "aTest\nbTest\n"
+    
+    # Test 3: Non-string item raises TypeError
+    with pytest.raises(TypeError, match="editor_args must be an iterable of strings"):
+        click.edit(text="test", editor_args=[123])
+    
+    # Test 4: Mixed list with non-string raises TypeError
+    with pytest.raises(TypeError, match="editor_args must be an iterable of strings"):
+        click.edit(text="test", editor_args=["-f", 123])
+    
+    # Test 5: Float in editor_args raises TypeError
+    with pytest.raises(TypeError, match="editor_args must be an iterable of strings"):
+        click.edit(text="test", editor_args=[1.5])
