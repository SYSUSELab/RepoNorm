+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid phone number.
+
+    Supports validation of phone numbers with various formats including international notation,
+    national formats, and country-specific rules.
+
+    The validator accepts common placeholder/example numbers like `555-xxx-xxxx` for US numbers.
+
+    Args:
+        country: Optional country code to validate against specific country rules.
+            Supported countries are 'US' and 'GB'. Country codes are matched case-insensitively.
+            If omitted, generic international syntax is used.
+
+    Examples:
+    ```py title="IsPhoneNumber"
+    from dirty_equals import IsPhoneNumber
+
+    # Generic validation - accepts any valid phone number format
+    assert '+1-555-123-4567' == IsPhoneNumber()
+    assert '555-123-4567' == IsPhoneNumber()
+
+    # US-specific validation
+    assert '555-123-4567' == IsPhoneNumber('US')
+    assert '+1-555-123-4567' == IsPhoneNumber('US')
+    assert '555-xxx-4567' == IsPhoneNumber('US')  # placeholder format
+
+    # GB-specific validation
+    assert '020 7946 0958' == IsPhoneNumber('GB')
+    assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+
+    # Invalid examples
+    assert 123 != IsPhoneNumber()  # non-string rejected
+    assert 'invalid' != IsPhoneNumber()
+    ```
+    """
+
+    # Valid separator characters
+    SEPARATORS = {' ', '\t', '-', '.', '('}
+
+    def __init__(self, country: Optional[Literal['US', 'GB']] = None):
+        """
+        Args:
+            country: Optional country code ('US' or 'GB'). Case-insensitive.
+                If omitted, generic international syntax is used.
+        """
+        self.country = country.upper() if country else None
+        display_country = self.country or '*'
+        super().__init__(plain_repr(f"'{display_country}'"))
+
+    def equals(self, other: Any) -> bool:
+        # Only accept strings
+        if not isinstance(other, str):
+            return False
+
+        # Check for invalid characters (newlines, etc.)
+        if self._has_invalid_chars(other):
+            return False
+
+        # Parse and extract digits
+        digits, has_plus = self._parse_phone_number(other)
+
+        if digits is None:
+            return False
+
+        # Validate based on country
+        if self.country == 'US':
+            return self._validate_us(digits, has_plus)
+        elif self.country == 'GB':
+            return self._validate_gb(digits, has_plus)
+        else:
+            # Generic international syntax
+            return self._validate_generic(digits, has_plus)
+
+    def _has_invalid_chars(self, s: str) -> bool:
+        """Check if the string contains invalid characters."""
+        for char in s:
+            if char in self.SEPARATORS:
+                continue
+            if char.isdigit():
+                continue
+            if char == '+':
+                continue
+            if char == ')':
+                continue
+            if char.lower() == 'x':
+                # Allow 'x' as placeholder character
+                continue
+            # Newlines and other control characters are invalid
+            if ord(char) < 32:
+                return True
+            # Allow printable ASCII that's a digit or separator
+            # Reject letters and special characters (except x)
+            if not char.isalnum():
+                return True
+        return False
+
+    def _parse_phone_number(self, s: str) -> Tuple[Optional[str], bool]:
+        """
+        Parse the phone number and extract digits.
+        Returns (digits, has_plus) where digits is the extracted digit string or None if invalid.
+        """
+        digits = []
+        has_plus = False
+        paren_depth = 0
+        i = 0
+
+        while i < len(s):
+            char = s[i]
+
+            if char == '+':
+                if has_plus:
+                    # Multiple plus signs are invalid
+                    return None, False
+                if i != 0:
+                    # Plus must be at the start
+                    return None, False
+                has_plus = True
+                i += 1
+                continue
+
+            if char == '(':
+                paren_depth += 1
+                i += 1
+                continue
+
+            if char == ')':
+                if paren_depth == 0:
+                    # Unbalanced parenthesis
+                    return None, False
+                paren_depth -= 1
+                i += 1
+                continue
+
+            if char.isdigit():
+                digits.append(char)
+                i += 1
+                continue
+
+            if char.lower() == 'x':
+                # Allow 'x' as placeholder - treat it as a digit for counting purposes
+                digits.append('x')
+                i += 1
+                continue
+
+            if char in self.SEPARATORS:
+                i += 1
+                continue
+
+            # Invalid character
+            return None, False
+
+        # Check for unbalanced parentheses
+        if paren_depth != 0:
+            return None, False
+
+        return ''.join(digits), has_plus
+
+    def _count_valid_digits(self, digits: str) -> int:
+        """Count digits and placeholder 'x' characters."""
+        return sum(1 for c in digits if c.isdigit() or c.lower() == 'x')
+
+    def _validate_generic(self, digits: str, has_plus: bool) -> bool:
+        """Validate using generic international syntax."""
+        digit_count = self._count_valid_digits(digits)
+        
+        # With + prefix: 8-19 digits
+        if has_plus:
+            return 8 <= digit_count <= 19
+        # Without + prefix: 7-15 digits (national format)
+        else:
+            return 7 <= digit_count <= 15
+
+    def _validate_us(self, digits: str, has_plus: bool) -> bool:
+        """Validate US phone numbers."""
+        if has_plus:
+            # International format: +1 followed by 10 digits
+            if digits.startswith('1'):
+                remaining = digits[1:]
+                remaining_digit_count = self._count_valid_digits(remaining)
+                return remaining_digit_count == 10
+            return False
+        else:
+            # National format: 10 digits
+            return self._count_valid_digits(digits) == 10
+
+    def _validate_gb(self, digits: str, has_plus: bool) -> bool:
+        """Validate GB phone numbers."""
+        if has_plus:
+            # International format: +44 followed by 10-11 digits
+            if digits.startswith('44'):
+                remaining = digits[2:]
+                remaining_digit_count = self._count_valid_digits(remaining)
+                return 10 <= remaining_digit_count <= 11
+            return False
+        else:
+            # National format: starts with 0, 10-11 digits total
+            if digits.startswith('0'):
+                return 10 <= self._count_valid_digits(digits) <= 11
+            return False
