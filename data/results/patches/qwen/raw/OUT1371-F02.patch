+def register_filter(name: str, func: Callable):
+    """Register a global filter for use in prompts.
+
+    Registered filters are available to all prompts constructed after registration,
+    including through bare `@outlines.prompt`, `Prompt.from_str`, and `Prompt.from_file`,
+    as well as included and inherited file templates.
+
+    Registering an existing name replaces its registered callable. Unregistering an
+    unknown name is a no-op. Registry changes affect only templates constructed after
+    the change: an existing `Prompt` retains the filter callable captured by its Jinja
+    environment.
+
+    Outlines-specific filters (`name`, `description`, `source`, `signature`, `schema`,
+    and `args`) remain protected and cannot be replaced.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter.
+    func : Callable
+        The filter function to register.
+
+    Examples
+    --------
+    >>> def my_uppercase_filter(value):
+    ...     return value.upper()
+    >>> register_filter("uppercase", my_uppercase_filter)
+    """
+    _GLOBAL_FILTERS[name] = func
+
+
+def unregister_filter(name: str):
+    """Unregister a global filter.
+
+    Unregistering an unknown name is a no-op.
+
+    Parameters
+    ----------
+    name : str
+        The name of the filter to unregister.
+
+    Examples
+    --------
+    >>> unregister_filter("my_filter")
+    """
+    _GLOBAL_FILTERS.pop(name, None)
+
+
 def get_fn_name(fn: Callable):
