+import dspy
+from dspy.clients import Cache, configure_cache, set_ttl
+import tempfile
+import time
+import pytest
+
+
+def test_ttl_validation():
+    """Test TTL validation."""
+    print("Testing TTL validation...")
+    
+    # Test zero TTL
+    try:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=0,
+        )
+        assert False, "Zero TTL should raise ValueError"
+    except ValueError as e:
+        assert "TTL must be positive" in str(e)
+        print("OK: Zero TTL raised ValueError")
+    
+    # Test negative TTL
+    try:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=-1,
+        )
+        assert False, "Negative TTL should raise ValueError"
+    except ValueError as e:
+        assert "TTL must be positive" in str(e)
+        print("OK: Negative TTL raised ValueError")
+    
+    # Test infinite TTL
+    try:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=float('inf'),
+        )
+        assert False, "Infinite TTL should raise ValueError"
+    except ValueError as e:
+        assert "TTL must be finite" in str(e)
+        print("OK: Infinite TTL raised ValueError")
+    
+    # Test NaN TTL
+    try:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=float('nan'),
+        )
+        assert False, "NaN TTL should raise ValueError"
+    except ValueError as e:
+        assert "TTL must be finite" in str(e)
+        print("OK: NaN TTL raised ValueError")
+    
+    # Test boolean TTL
+    try:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=True,
+        )
+        assert False, "Boolean TTL should raise ValueError"
+    except ValueError as e:
+        assert "TTL cannot be a boolean" in str(e)
+        print("OK: Boolean TTL raised ValueError")
+    
+    # Test string TTL
+    try:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl="invalid",
+        )
+        assert False, "String TTL should raise ValueError"
+    except ValueError as e:
+        assert "TTL must be a number or None" in str(e)
+        print("OK: String TTL raised ValueError")
+    
+    # Test invalid update leaves cache unchanged
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="",
+        ttl=10,
+    )
+    assert cache.ttl == 10
+    
+    try:
+        cache.set_ttl(-1)
+    except ValueError:
+        pass
+    
+    # Should still be 10
+    assert cache.ttl == 10
+    print("OK: Invalid update left cache unchanged")
+
+
+def test_ttl_set_ttl():
+    """Test set_ttl function on global cache."""
+    # Save original cache
+    original_cache = dspy.cache
+    
+    with tempfile.TemporaryDirectory() as tmp_path:
+        # Configure a new cache
+        configure_cache(
+            enable_disk_cache=True,
+            enable_memory_cache=True,
+            disk_cache_dir=tmp_path,
+            disk_size_limit_bytes=1024 * 1024,
+            memory_max_entries=100,
+            ttl=None,
+        )
+        
+        # Set TTL via set_ttl function
+        set_ttl(5)
+        assert dspy.cache.ttl == 5
+        print("OK: set_ttl function works")
+        
+        # Put value with new TTL
+        request = {"prompt": "Hello", "model": "test"}
+        value = {"message": "Test response"}
+        dspy.cache.put(request, value)
+        
+        # Get should work
+        result = dspy.cache.get(request)
+        assert result is not None
+        assert result["message"] == "Test response"
+        print("OK: Value with TTL can be retrieved")
+    
+    # Restore original cache
+    dspy.cache = original_cache
+
+
+def test_ttl_none():
+    """Test that None TTL means no expiration."""
+    with tempfile.TemporaryDirectory() as tmp_path:
+        cache = Cache(
+            enable_disk_cache=True,
+            enable_memory_cache=True,
+            disk_cache_dir=tmp_path,
+            disk_size_limit_bytes=1024 * 1024,
+            memory_max_entries=100,
+            ttl=None,
+        )
+        
+        request = {"prompt": "Hello", "model": "test"}
+        value = {"message": "Test response"}
+        cache.put(request, value)
+        
+        # Get should work immediately
+        result = cache.get(request)
+        assert result is not None
+        assert result["message"] == "Test response"
+        
+        # Wait a long time
+        time.sleep(2)
+        
+        # Get should still work
+        result = cache.get(request)
+        assert result is not None
+        assert result["message"] == "Test response"
+        print("OK: None TTL means no expiration")
+
+
+def test_ttl_overwrite():
+    """Test that overwriting an entry starts a new lifetime."""
+    with tempfile.TemporaryDirectory() as tmp_path:
+        cache = Cache(
+            enable_disk_cache=True,
+            enable_memory_cache=True,
+            disk_cache_dir=tmp_path,
+            disk_size_limit_bytes=1024 * 1024,
+            memory_max_entries=100,
+            ttl=1,
+        )
+        
+        request = {"prompt": "Hello", "model": "test"}
+        value1 = {"message": "First response"}
+        value2 = {"message": "Second response"}
+        
+        # Put first value
+        cache.put(request, value1)
+        
+        # Overwrite with second value
+        cache.put(request, value2)
+        
+        # Get should return second value
+        result = cache.get(request)
+        assert result["message"] == "Second response"
+        print("OK: Overwrite starts new lifetime")
+        
+        # Wait for original TTL to expire (but not too long since overwrite happened almost immediately)
+        # Since overwrite happened almost immediately after first put, we need to wait less than 1 second
+        time.sleep(0.5)
+        
+        # Get should still work because we overwrote it (fresh TTL from overwrite time)
+        result = cache.get(request)
+        assert result is not None
+        assert result["message"] == "Second response"
+        print("OK: Overwritten entry has new lifetime")
+
+
+def test_ttl_memory_only():
+    """Test TTL with memory-only cache."""
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="",
+        ttl=1,
+    )
+    
+    request = {"prompt": "Hello", "model": "test"}
+    value = {"message": "Test response"}
+    cache.put(request, value)
+    
+    # Get should work immediately
+    result = cache.get(request)
+    assert result is not None
+    assert result["message"] == "Test response"
+    
+    # Wait for TTL to expire
+    time.sleep(1.5)
+    
+    # Get should return None
+    result = cache.get(request)
+    assert result is None
+    print("OK: Memory-only cache respects TTL")
+
