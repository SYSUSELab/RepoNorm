+def test_ttl_save_load():
+    """Test that save/load doesn't renew deadlines."""
+    with tempfile.TemporaryDirectory() as tmp_path:
+        cache = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=1,
+        )
+        
+        request = {"prompt": "Hello", "model": "test"}
+        value = {"message": "Test response"}
+        cache.put(request, value)
+        
+        # Save memory cache
+        filepath = f"{tmp_path}/memory_cache.pkl"
+        cache.save_memory_cache(filepath)
+        
+        # Create new cache instance
+        cache2 = Cache(
+            enable_disk_cache=False,
+            enable_memory_cache=True,
+            disk_cache_dir="",
+            ttl=1,
+        )
+        
+        # Load memory cache
+        cache2.load_memory_cache(filepath)
+        
+        # Get should work immediately
+        result = cache2.get(request)
+        assert result is not None
+        assert result["message"] == "Test response"
+        
+        # Wait for TTL to expire
+        time.sleep(1.5)
+        
+        # Get should return None (deadline should not have been renewed)
+        result = cache2.get(request)
+        assert result is None
+        print("OK: Save/load doesn't renew deadlines")
+
