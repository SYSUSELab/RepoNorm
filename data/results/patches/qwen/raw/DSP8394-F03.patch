+        # Get should return None (original TTL expired)
+        result = cache.get(request)
+        assert result is None
+        print("OK: Changing TTL doesn't affect existing entries")
+
+
+def test_ttl_new_writes():
+    """Test that changing TTL affects only new writes."""
+    with tempfile.TemporaryDirectory() as tmp_path:
+        cache = Cache(
+            enable_disk_cache=True,
+            enable_memory_cache=True,
+            disk_cache_dir=tmp_path,
+            disk_size_limit_bytes=1024 * 1024,
+            ttl=1,
+        )
+        
+        request = {"prompt": "Hello", "model": "test"}
+        value = {"message": "Test response"}
+        cache.put(request, value)
+        
+        # Change TTL to longer value
+        cache.set_ttl(10)
+        
+        # New write should use new TTL
+        cache.put(request, value)
+        
+        # Entry should still be valid
+        time.sleep(1.5)
+        
+        # Get should work (new TTL hasn't expired)
+        result = cache.get(request)
+        assert result is not None
+        print("OK: New writes use new TTL")
