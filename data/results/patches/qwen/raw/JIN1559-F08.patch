+class ConditionalI18nExtension(Extension):
+    """This extension adds conditional translation support to Jinja."""
+
+    tags = {"ctrans"}
+
+    def __init__(self, environment: Environment) -> None:
+        super().__init__(environment)
+        environment.extend(
+            install_gettext_translations=self._install,
+            install_null_translations=self._install_null,
+            install_gettext_callables=self._install_callables,
+            uninstall_gettext_translations=self._uninstall,
+            extract_translations=self._extract,
+            newstyle_gettext=False,
+        )
+        # Install null translations by default so gettext functions are available
+        self._install_null()
+
+    def _install(
+        self, translations: "_SupportedTranslations", newstyle: t.Optional[bool] = None
+    ) -> None:
+        gettext = getattr(translations, "ugettext", None)
+        if gettext is None:
+            gettext = translations.gettext
+        ngettext = getattr(translations, "ungettext", None)
+        if ngettext is None:
+            ngettext = translations.ngettext
+
+        pgettext = getattr(translations, "pgettext", None)
+        npgettext = getattr(translations, "npgettext", None)
+        self._install_callables(
+            gettext, ngettext, newstyle=newstyle, pgettext=pgettext, npgettext=npgettext
+        )
+
+    def _install_null(self, newstyle: t.Optional[bool] = None) -> None:
+        import gettext
+
+        self._install_callables(
+            gettext.gettext,
+            gettext.ngettext,
+            newstyle=newstyle,
+            pgettext=pgettext_fallback,
+            npgettext=npgettext_fallback,
+        )
+
+    def _install_callables(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+    ) -> None:
+        if newstyle is None:
+            newstyle = getattr(self.environment, "newstyle_gettext", False)
+        if newstyle:
+            self.environment.globals["gettext"] = gettext
+            self.environment.globals["ngettext"] = ngettext
+            if pgettext is not None:
+                self.environment.globals["pgettext"] = pgettext
+            if npgettext is not None:
+                self.environment.globals["npgettext"] = npgettext
+        else:
+            self.environment.globals["_"] = _gettext_alias
+            self.environment.globals["gettext"] = gettext
+            self.environment.globals["ngettext"] = ngettext
+            if pgettext is not None:
+                self.environment.globals["pgettext"] = pgettext
+            if npgettext is not None:
+                self.environment.globals["npgettext"] = npgettext
+
+    def _uninstall(self) -> None:
+        self.environment.globals.pop("_", None)
+        self.environment.globals.pop("gettext", None)
+        self.environment.globals.pop("ngettext", None)
+        self.environment.globals.pop("pgettext", None)
+        self.environment.globals.pop("npgettext", None)
+
+    def _extract(
+        self,
+        data: str,
+        keywords: t.Optional[t.Sequence[str]] = None,
+        comment_tags: t.Optional[t.Sequence[str]] = None,
+    ) -> t.Iterator[t.Tuple[int, str, str, t.List[str]]]:
+        if keywords is None:
+            keywords = GETTEXT_FUNCTIONS
+        if comment_tags is None:
+            comment_tags = []
+
+        for lineno, funcname, message, comments in babel_extract(
+            io.BytesIO(data.encode("utf-8")),
+            keywords,
+            comment_tags,
+            {},
+        ):
+            yield lineno, funcname, message, comments
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        
+        # Parse condition and options
+        variables: t.Dict[str, nodes.Expr] = {}
+        context: t.Optional[str] = None
+        
+        # First token after ctrans should be the condition
+        token = parser.stream.expect("name")
+        condition_name = token.value
+        
+        # Check for additional variables or block_end
+        while True:
+            if parser.stream.current.type == "block_end":
+                break
+            if variables or context is not None:
+                parser.stream.expect("comma")
+            
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+            
+            token = parser.stream.expect("name")
+            if token.value == "context":
+                if context is not None:
+                    parser.fail("duplicate context value", lineno=lineno)
+                parser.stream.expect("assign")
+                context_token = parser.stream.expect("string")
+                context = context_token.value
+            else:
+                # It's a variable assignment or reference
+                var_name = token.value
+                if var_name in variables:
+                    parser.fail(f"variable {var_name!r} defined twice", lineno=lineno)
+                
+                if parser.stream.current.type == "assign":
+                    next(parser.stream)
+                    var_value = parser.parse_expression()
+                    variables[var_name] = var_value
+                else:
+                    # Just a variable reference
+                    variables[var_name] = nodes.Name(var_name, "load")
+        
+        # Expect block_end
+        parser.stream.expect("block_end")
+        
+        # Parse the true branch (translation message content)
+        buf: t.List[str] = []
+        
+        while True:
+            token = parser.stream.current
+            if token.type == "data":
+                buf.append(token.value.replace("%", "%%"))
+                next(parser.stream)
+            elif token.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif token.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:fallback"):
+                    # Found fallback block
+                    next(parser.stream)
+                    parser.stream.expect("block_end")
+                    break
+                elif parser.stream.current.test("name:endctrans"):
+                    # End without fallback
+                    next(parser.stream)
+                    # Create node with empty fallback
+                    test = nodes.Name(condition_name, "load")
+                    return nodes.ConditionalTranslation(
+                        test,
+                        "".join(buf),
+                        None,
+                        variables,
+                        context,
+                        [],
+                        lineno=lineno,
+                    )
+                else:
+                    parser.fail(
+                        "control structures in conditional translation true branch are not allowed",
+                        token.lineno,
+                    )
+            elif token.type == "eos":
+                parser.fail("unclosed conditional translation block")
+            else:
+                next(parser.stream)
+        
+        # Parse the fallback body (full Jinja body)
+        fallback_body: t.List[nodes.Node] = []
+        while parser.stream.current.type != "block_end":
+            if parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:endctrans"):
+                    next(parser.stream)
+                    break
+                else:
+                    stmt = parser.parse_statement()
+                    fallback_body.append(stmt)
+            else:
+                # Regular data in fallback
+                data_node = nodes.Output([nodes.Const(parser.stream.current.value)])
+                fallback_body.append(data_node)
+                next(parser.stream)
+        
+        # Build the ConditionalTranslation node
+        test = nodes.Name(condition_name, "load")
+        node = nodes.ConditionalTranslation(
+            test,
+            "".join(buf),
+            None,
+            variables,
+            context,
+            fallback_body,
+            lineno=lineno,
+        )
+        
+        return node
+
+
+
 
