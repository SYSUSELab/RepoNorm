+    def visit_ConditionalTranslation(
+        self, node: nodes.ConditionalTranslation, frame: Frame
+    ) -> None:
+        """Compile a conditional translation block."""
+        # Evaluate condition once
+        cond_frame = frame.soft()
+        self.writeline("if ", node)
+        self.visit(node.test, cond_frame)
+        self.write(":")
+        self.indent()
+
+        # Compile true branch (translation)
+        # Build gettext call based on context and pluralization
+        if node.context is not None:
+            if node.plural is not None:
+                # npgettext for context + plural
+                self.writeline("_trans = npgettext(")
+                self.write(f"{node.context!r}, {node.singular!r}, {node.plural!r}")
+                # Visit plural expression
+                self.write(", ")
+                self.visit(node.variables["num"], cond_frame)
+                self.write(")")
+            else:
+                # pgettext for context only
+                self.writeline("_trans = pgettext(")
+                self.write(f"{node.context!r}, {node.singular!r})")
+        else:
+            if node.plural is not None:
+                # ngettext for plural
+                self.writeline("_trans = ngettext(")
+                self.write(f"{node.singular!r}, {node.plural!r}")
+                # Visit plural expression
+                self.write(", ")
+                self.visit(node.variables["num"], cond_frame)
+                self.write(")")
+            else:
+                # gettext for singular
+                self.writeline("_trans = gettext(")
+                self.write(f"{node.singular!r})")
+
+        # Handle variable substitution for old-style gettext
+        if not self.environment.newstyle_gettext:
+            # Old-style: need to format the string with variables
+            if node.variables:
+                var_dict = {}
+                for key, expr in node.variables.items():
+                    if key != "num":
+                        var_dict[key] = expr
+                if var_dict:
+                    self.write(".format(")
+                    parts = []
+                    for key, expr in var_dict.items():
+                        parts.append(f"{key}={self.generate(expr, cond_frame)}")
+                    self.write(", ".join(parts))
+                    self.write(")")
+        else:
+            # New-style: gettext handles formatting
+            pass
+
+        # Output the translated string
+        self.writeline("yield _trans")
+        self.outdent()
+
+        # Compile false branch (fallback body)
+        self.writeline("else:")
+        self.indent()
+        self.blockvisit(node.fallback, frame)
+        self.outdent()
+
