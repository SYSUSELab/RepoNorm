@@ -0,0 +1,87 @@
+"""Math utility functions for prompt filters."""
+
+
+def add(a: float, b: float) -> float:
+    """Add two numbers."""
+    return a + b
+
+
+def subtract(a: float, b: float) -> float:
+    """Subtract b from a."""
+    return a - b
+
+
+def multiply(a: float, b: float) -> float:
+    """Multiply two numbers."""
+    return a * b
+
+
+def divide(a: float, b: float) -> float:
+    """Divide a by b."""
+    return a / b
+
+
+def round(value: float, ndigits=None) -> float:
+    """Round a number to the specified number of digits.
+    
+    Parameters
+    ----------
+    value : float
+        The number to round.
+    ndigits : int, optional
+        The number of decimal places to round to. If None, rounds to the nearest integer.
+        
+    Returns
+    -------
+    float
+        The rounded number.
+    """
+    import builtins
+    if ndigits is None:
+        return builtins.round(value)
+    else:
+        return builtins.round(value, ndigits)
+
+
+def abs(value: float) -> float:
+    """Return the absolute value of a number."""
+    import builtins
+    return builtins.abs(value)
+
+
+def min_value(value: float, *others: float) -> float:
+    """Return the minimum value among the given values.
+    
+    Parameters
+    ----------
+    value : float
+        The first value.
+    *others : float
+        Additional values to compare.
+        
+    Returns
+    -------
+    float
+        The minimum value.
+    """
+    import builtins
+    return builtins.min(value, *others)
+
+
+def max_value(value: float, *others: float) -> float:
+    """Return the maximum value among the given values.
+    
+    Parameters
+    ----------
+    value : float
+        The first value.
+    *others : float
+        Additional values to compare.
+        
+    Returns
+    -------
+    float
+        The maximum value.
+    """
+    import builtins
+    return builtins.max(value, *others)
