@@ -0,0 +1,114 @@
+"""String utility functions for prompt filters."""
+
+
+def upper(value: str) -> str:
+    """Convert the input to uppercase text."""
+    return value.upper()
+
+
+def lower(value: str) -> str:
+    """Convert the input to lowercase text."""
+    return value.lower()
+
+
+def title(value: str) -> str:
+    """Convert the input to title case text."""
+    return value.title()
+
+
+def reverse(value: str) -> str:
+    """Reverse the text by code point."""
+    return value[::-1]
+
+
+def truncate(value: str, length: int, end: str = "...") -> str:
+    """Return unchanged text when it fits and otherwise produce at most `length` characters.
+    
+    Parameters
+    ----------
+    value : str
+        The text to truncate.
+    length : int
+        The maximum length of the output. Must be non-negative.
+    end : str, optional
+        The suffix to append when truncating. Default is "...".
+        
+    Returns
+    -------
+    str
+        The truncated or original text.
+        
+    Raises
+    ------
+    ValueError
+        If length is negative.
+    """
+    if length < 0:
+        raise ValueError("length must be non-negative")
+    
+    if len(value) <= length:
+        return value
+    
+    # Calculate how much space we have for the end string
+    available_for_end = length - len(end)
+    if available_for_end < 0:
+        # Not enough space even for the end string, just return what fits
+        return value[:length]
+    
+    return value[:available_for_end] + end
+
+
+def pad_left(value: str, width: int, fill: str = " ") -> str:
+    """Pad the left side of the text to reach the specified width.
+    
+    Parameters
+    ----------
+    value : str
+        The text to pad.
+    width : int
+        The target width.
+    fill : str, optional
+        The character to use for padding. Must be exactly one character.
+        
+    Returns
+    -------
+    str
+        The padded text.
+        
+    Raises
+    ------
+    ValueError
+        If fill is not exactly one character.
+    """
+    if len(fill) != 1:
+        raise ValueError("fill must be exactly one character")
+    
+    return value.rjust(width, fill)
+
+
+def pad_right(value: str, width: int, fill: str = " ") -> str:
+    """Pad the right side of the text to reach the specified width.
+    
+    Parameters
+    ----------
+    value : str
+        The text to pad.
+    width : int
+        The target width.
+    fill : str, optional
+        The character to use for padding. Must be exactly one character.
+        
+    Returns
+    -------
+    str
+        The padded text.
+        
+    Raises
+    ------
+    ValueError
+        If fill is not exactly one character.
+    """
+    if len(fill) != 1:
+        raise ValueError("fill must be exactly one character")
+    
+    return value.ljust(width, fill)
