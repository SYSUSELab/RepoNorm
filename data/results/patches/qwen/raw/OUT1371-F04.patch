+"""Format utility functions for prompt filters."""
+
+import html
+import json
+
+
+def json_format(value: object) -> str:
+    """Format a value as JSON using json.dumps defaults."""
+    return json.dumps(value)
+
+
+def csv(row: list) -> str:
+    """Format an iterable as one CSV row with standard quoting and no line terminator.
+    
+    Parameters
+    ----------
+    row : list
+        The values to format as a CSV row.
+        
+    Returns
+    -------
+    str
+        The formatted CSV row.
+    """
+    import csv
+    import io
+    
+    output = io.StringIO()
+    writer = csv.writer(output, quoting=csv.QUOTE_MINIMAL)
+    writer.writerow(row)
+    # Remove the trailing newline that csv.writer adds (including \r\n on Windows)
+    result = output.getvalue().rstrip('\r\n')
+    output.close()
+    return result
+
+
+def indent(value: str, width: int = 4) -> str:
+    """Add `width` spaces to each non-empty line.
+    
+    Parameters
+    ----------
+    value : str
+        The text to indent.
+    width : int, optional
+        The number of spaces to add per line. Default is 4.
+        
+    Returns
+    -------
+    str
+        The indented text.
+    """
+    if not isinstance(value, str):
+        value = str(value)
+    
+    lines = value.split('\n')
+    indented_lines = []
+    for line in lines:
+        if line:  # Only indent non-empty lines
+            indented_lines.append(' ' * width + line)
+        else:
+            indented_lines.append(line)
+    return '\n'.join(indented_lines)
+
+
+def wrap(value: str, width: int = 70) -> str:
+    """Wrap text with Python's normal word wrapping.
+    
+    Parameters
+    ----------
+    value : str
+        The text to wrap.
+    width : int, optional
+        The maximum line width. Default is 70.
+        
+    Returns
+    -------
+    str
+        The wrapped text.
+    """
+    import textwrap
+    
+    if not isinstance(value, str):
+        value = str(value)
+    
+    return textwrap.fill(value, width=width)
+
+
+def escape(value: str) -> str:
+    """Apply HTML escaping (including quotes) to the text.
+    
+    Parameters
+    ----------
+    value : str
+        The text to escape.
+        
+    Returns
+    -------
+    str
+        The escaped text.
+    """
+    return html.escape(value, quote=True)
+
+
+def unescape(value: str) -> str:
+    """Unescape HTML entities from the text.
+    
+    Parameters
+    ----------
+    value : str
+        The text to unescape.
+        
+    Returns
+    -------
+    str
+        The unescaped text.
+    """
+    return html.unescape(value)
