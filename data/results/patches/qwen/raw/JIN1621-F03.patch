+def validate_template_path(template: str) -> None:
+    r"""Validate a template path name.
+
+    Raises :exc:`TemplateNotFound` if the template name is invalid.
+    Valid names must not be ``None`` or empty, must not contain NUL bytes,
+    must not begin with ``/``, ``\``, or an ASCII drive prefix like ``C:``,
+    and must not contain ASCII control characters below code point 32
+    other than tab, newline, or carriage return.
+    """
+    if template is None or template == "":
+        raise TemplateNotFound(template)
+
+    # Check for NUL byte
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    # Check for absolute paths (beginning with / or \)
+    if template.startswith("/") or template.startswith("\\"):
+        raise TemplateNotFound(template)
+
+    # Check for ASCII drive prefix (e.g., C:, D:)
+    if len(template) >= 2 and template[1] == ":":
+        if template[0].isascii() and template[0].isalpha():
+            raise TemplateNotFound(template)
+
+    # Check for control characters below code point 32 (except tab, newline, CR)
+    for char in template:
+        code = ord(char)
+        if code < 32 and code not in (9, 10, 13):  # 9=tab, 10=newline, 13=CR
+            raise TemplateNotFound(template)
+
+
