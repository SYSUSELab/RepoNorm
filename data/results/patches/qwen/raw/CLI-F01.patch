@@ -0,0 +1,28 @@
+import warnings
+import click
+from click.shell_completion import shell_complete
+
+# Enable resource warnings
+warnings.filterwarnings("error", category=ResourceWarning)
+
+@click.command()
+@click.option("-f", type=click.File())
+def cli(f):
+    pass
+
+if __name__ == "__main__":
+    # Test: Full flow through shell_complete
+    print("Test: Full flow through shell_complete")
+    
+    import os
+    os.environ["CLICK_COMPLETE"] = "complete_bash"
+    
+    # This should not raise ResourceWarning
+    result = shell_complete(cli, {}, "cli", "CLICK_COMPLETE", "complete_bash")
+    print(f"Result: {result}")
+    
+    import gc
+    gc.collect()
+    print("Test passed - no warning expected\n")
+    
+    print("All tests passed!")
