+def _apply_transformers(text: str, transformers) -> str:
+    """Apply a list of transformers to text.
+    
+    Args:
+        text: The input text string.
+        transformers: A callable or sequence of callables to apply to the text.
+        
+    Returns:
+        The transformed text string.
+        
+    Raises:
+        TypeError: If any transformer returns a non-string value.
+    """
+    if transformers is None:
+        return text
+    
+    # Normalize to a list
+    if callable(transformers):
+        transformers = [transformers]
+    
+    result = text
+    for transformer in transformers:
+        result = transformer(result)
+        if not isinstance(result, str):
+            raise TypeError(
+                f"Transformer returned {type(result).__name__!r}, expected str"
+            )
+    return result
