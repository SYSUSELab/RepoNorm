diff --git a/dirty_equals/_mac.py b/dirty_equals/_mac.py
new file mode 100644
index 0000000..2877264
--- /dev/null
+++ b/dirty_equals/_mac.py
@@ -0,0 +1,122 @@
+import re
+from typing import Any, Literal, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+try:
+    from typing import Literal as TypingLiteral
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address.
+
+    Accepts six-octet hexadecimal MAC addresses in colon-separated, hyphen-separated,
+    three-group dotted, and compact forms. Matching hexadecimal digits is case-insensitive.
+
+    The optional format argument can be one of `colon`, `hyphen`, `dot`, or `compact`;
+    when supplied, otherwise valid addresses in a different form compare unequal.
+
+    Leading/trailing whitespace, including a final newline, is not allowed.
+
+    Examples:
+    ```py title="IsMac"
+    from dirty_equals import IsMac
+
+    assert "00:11:22:33:44:55" == IsMac
+    assert "00-11-22-33-44-55" == IsMac
+    assert "0011.2233.4455" == IsMac
+    assert "001122334455" == IsMac
+    assert "AA:BB:CC:DD:EE:FF" == IsMac  # case insensitive
+
+    assert "00:11:22:33:44:55" == IsMac("colon")
+    assert "00-11-22-33-44-55" == IsMac("hyphen")
+    assert "0011.2233.4455" == IsMac("dot")
+    assert "001122334455" == IsMac("compact")
+
+    assert "00:11:22:33:44:55" != IsMac("hyphen")  # wrong format
+    assert "foobar" != IsMac
+    assert 123 != IsMac
+    ```
+    """
+
+    def __init__(self, format: Optional[Literal["colon", "hyphen", "dot", "compact"]] = None):
+        """
+        Args:
+            format: The expected format of the MAC address. If omitted, any valid format is accepted.
+
+        Valid formats:
+            - `colon`: `XX:XX:XX:XX:XX:XX` (e.g., `00:11:22:33:44:55`)
+            - `hyphen`: `XX-XX-XX-XX-XX-XX` (e.g., `00-11-22-33-44-55`)
+            - `dot`: `XXXX.XXXX.XXXX` (e.g., `0011.2233.4455`)
+            - `compact`: `XXXXXXXXXXXX` (e.g., `001122334455`)
+        """
+        self.format = format
+        super().__init__(plain_repr(format) if format else plain_repr("*"))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check for leading/trailing whitespace including newlines
+        if other != other.strip():
+            return False
+
+        if self.format is None:
+            # Accept any valid format
+            return (
+                self._is_colon_format(other)
+                or self._is_hyphen_format(other)
+                or self._is_dot_format(other)
+                or self._is_compact_format(other)
+            )
+        elif self.format == "colon":
+            return self._is_colon_format(other)
+        elif self.format == "hyphen":
+            return self._is_hyphen_format(other)
+        elif self.format == "dot":
+            return self._is_dot_format(other)
+        elif self.format == "compact":
+            return self._is_compact_format(other)
+        else:
+            return False
+
+    @staticmethod
+    def _is_colon_format(value: str) -> bool:
+        """Check for XX:XX:XX:XX:XX:XX format."""
+        if len(value) != 17:
+            return False
+        parts = value.split(":")
+        if len(parts) != 6:
+            return False
+        return all(len(p) == 2 and all(c in "0123456789abcdefABCDEF" for c in p) for p in parts)
+
+    @staticmethod
+    def _is_hyphen_format(value: str) -> bool:
+        """Check for XX-XX-XX-XX-XX-XX format."""
+        if len(value) != 17:
+            return False
+        parts = value.split("-")
+        if len(parts) != 6:
+            return False
+        return all(len(p) == 2 and all(c in "0123456789abcdefABCDEF" for c in p) for p in parts)
+
+    @staticmethod
+    def _is_dot_format(value: str) -> bool:
+        """Check for XXXX.XXXX.XXXX format."""
+        if len(value) != 14:
+            return False
+        parts = value.split(".")
+        if len(parts) != 3:
+            return False
+        return all(len(p) == 4 and all(c in "0123456789abcdefABCDEF" for c in p) for p in parts)
+
+    @staticmethod
+    def _is_compact_format(value: str) -> bool:
+        """Check for XXXXXXXXXXXX format (12 hex digits)."""
+        if len(value) != 12:
+            return False
+        return all(c in "0123456789abcdefABCDEF" for c in value)
diff --git a/tests/test_mac.py b/tests/test_mac.py
new file mode 100644
index 0000000..6663be9
--- /dev/null
+++ b/tests/test_mac.py
@@ -0,0 +1,87 @@
+import pytest
+
+from dirty_equals import IsMac
+
+
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        # Basic formats without format argument
+        ("00:11:22:33:44:55", IsMac),
+        ("00-11-22-33-44-55", IsMac),
+        ("0011.2233.4455", IsMac),
+        ("001122334455", IsMac),
+        # Case insensitivity
+        ("AA:BB:CC:DD:EE:FF", IsMac),
+        ("aa:bb:cc:dd:ee:ff", IsMac),
+        ("Aa:Bb:Cc:Dd:Ee:Ff", IsMac),
+        # With format argument
+        ("00:11:22:33:44:55", IsMac("colon")),
+        ("00-11-22-33-44-55", IsMac("hyphen")),
+        ("0011.2233.4455", IsMac("dot")),
+        ("001122334455", IsMac("compact")),
+    ],
+)
+def test_is_mac_true(other, dirty):
+    assert other == dirty
+
+
+@pytest.mark.parametrize(
+    "other,dirty",
+    [
+        # Invalid strings
+        ("foobar", IsMac),
+        ("00:11:22:33:44", IsMac),  # too few octets
+        ("00:11:22:33:44:55:66", IsMac),  # too many octets
+        ("00:11:22:33:44:GG", IsMac),  # non-hex character
+        ("0011.2233.445", IsMac),  # dot format with wrong length
+        ("00112233445", IsMac),  # compact format with wrong length
+        ("00:11-22:33:44:55", IsMac),  # mixed separators
+        # Whitespace
+        (" 00:11:22:33:44:55", IsMac),  # leading space
+        ("00:11:22:33:44:55 ", IsMac),  # trailing space
+        ("00:11:22:33:44:55\n", IsMac),  # trailing newline
+        ("\n00:11:22:33:44:55", IsMac),  # leading newline
+        # Non-string values
+        (123, IsMac),
+        (None, IsMac),
+        ([], IsMac),
+        ({}, IsMac),
+        # Format mismatch
+        ("00:11:22:33:44:55", IsMac("hyphen")),
+        ("00-11-22-33-44-55", IsMac("colon")),
+        ("0011.2233.4455", IsMac("compact")),
+        ("001122334455", IsMac("dot")),
+    ],
+)
+def test_is_mac_false(other, dirty):
+    assert other != dirty
+
+
+def test_is_mac_false_repr():
+    is_mac = IsMac()
+    with pytest.raises(AssertionError):
+        assert "123" == is_mac
+    assert str(is_mac) == "IsMac(*)"
+
+
+def test_is_mac_format_false_repr():
+    is_mac = IsMac("colon")
+    with pytest.raises(AssertionError):
+        assert "123" == is_mac
+    assert str(is_mac) == "IsMac(colon)"
+
+
+def test_is_mac_value_retention():
+    is_mac = IsMac()
+    assert "00:11:22:33:44:55" == is_mac
+    assert is_mac.value == "00:11:22:33:44:55"
+    assert str(is_mac) == "'00:11:22:33:44:55'"
+
+
+def test_is_mac_class_getitem():
+    """Test that IsMac can be used as a class."""
+    assert "00:11:22:33:44:55" == IsMac
+    assert "00-11-22-33-44-55" == IsMac
+    assert "0011.2233.4455" == IsMac
+    assert "001122334455" == IsMac
