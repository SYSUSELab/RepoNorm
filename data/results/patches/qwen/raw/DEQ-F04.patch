diff --git a/dirty_equals/_url.py b/dirty_equals/_url.py
new file mode 100644
index 0000000..9b8e359
--- /dev/null
+++ b/dirty_equals/_url.py
@@ -0,0 +1,147 @@
+import re
+from typing import Any, Collection, Optional, Tuple, TypeVar, Union
+
+from ._base import DirtyEquals
+from ._utils import Omit, plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+from urllib.parse import urlparse
+
+T = TypeVar('T')
+
+__all__ = 'IsURL'
+
+
+class IsURL(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid URL, optionally checking protocol or domain.
+
+    `IsURL` validates that a string is a complete URL with a protocol and network location.
+    It can optionally restrict matches to specific protocols (http, https, ftp, etc.) or domains.
+
+    Args:
+        protocol: Single protocol string or collection of allowed protocols.
+            An empty collection allows no protocol, while None disables filtering.
+        domain: Single domain string or collection of allowed domains.
+            Domain matching compares the complete authority/netloc, including an explicitly present port.
+
+    Examples:
+        ```py title="IsURL"
+        from dirty_equals import IsURL
+
+        assert 'https://example.com' == IsURL()
+        assert 'http://example.com/path' == IsURL()
+        assert 'ftp://files.example.com' == IsURL()
+
+        # Check for specific protocol
+        assert 'https://example.com' == IsURL('https')
+        assert 'http://example.com' != IsURL('https')
+        assert 'https://example.com' == IsURL({'http', 'https'})
+        assert 'http://example.com' == IsURL({'http', 'https'})
+
+        # Check for specific domain (includes port if present)
+        assert 'https://example.com' == IsURL(domain='example.com')
+        assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+        assert 'https://example.com:8080' != IsURL(domain='example.com')
+        assert 'https://example.com' == IsURL(domain={'example.com', 'test.com'})
+        ```
+    """
+
+    def __init__(
+        self,
+        protocol: Union[None, str, Collection[str]] = None,
+        domain: Union[None, str, Collection[str]] = None,
+    ):
+        """
+        Args:
+            protocol: Single protocol string or collection of allowed protocols.
+                An empty collection allows no protocol, while None disables filtering.
+            domain: Single domain string or collection of allowed domains.
+                Domain matching compares the complete authority/netloc, including an explicitly present port.
+        """
+        self.protocol = protocol
+        self.domain = domain
+
+        # Build repr args based on what was provided
+        repr_args: list[Any] = []
+        
+        # Handle protocol - only add to repr if not None
+        if protocol is not None:
+            if isinstance(protocol, str):
+                # Pass raw string, _repr_ne will apply repr() correctly
+                repr_args.append(protocol)
+            elif isinstance(protocol, (list, tuple, set, frozenset)):
+                if len(protocol) == 1:
+                    # Pass raw string, _repr_ne will apply repr() correctly
+                    repr_args.append(next(iter(protocol)))
+                else:
+                    repr_args.append(plain_repr('*'))
+            else:
+                repr_args.append(plain_repr('*'))
+                
+        # Handle domain - only add to repr if not None
+        if domain is not None:
+            if isinstance(domain, str):
+                # Pass raw string, _repr_ne will apply repr() correctly
+                repr_args.append(domain)
+            elif isinstance(domain, (list, tuple, set, frozenset)):
+                if len(domain) == 1:
+                    # Pass raw string, _repr_ne will apply repr() correctly
+                    repr_args.append(next(iter(domain)))
+                else:
+                    repr_args.append(plain_repr('*'))
+            else:
+                repr_args.append(plain_repr('*'))
+        
+        # If no args were added, use * as placeholder
+        if not repr_args:
+            repr_args.append(plain_repr('*'))
+
+        super().__init__(*repr_args)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        try:
+            parsed = urlparse(other)
+        except Exception:
+            return False
+
+        # Must have a scheme (protocol)
+        if not parsed.scheme:
+            return False
+
+        # Must have a netloc (network location)
+        if not parsed.netloc:
+            return False
+
+        # Check protocol if specified
+        if self.protocol is not None:
+            if isinstance(self.protocol, str):
+                if parsed.scheme.lower() != self.protocol.lower():
+                    return False
+            elif isinstance(self.protocol, (list, tuple, set, frozenset)):
+                if len(self.protocol) == 0:
+                    # Empty collection means no protocol allowed
+                    return False
+                if parsed.scheme.lower() not in [p.lower() for p in self.protocol]:
+                    return False
+
+        # Check domain if specified
+        if self.domain is not None:
+            if isinstance(self.domain, str):
+                if parsed.netloc.lower() != self.domain.lower():
+                    return False
+            elif isinstance(self.domain, (list, tuple, set, frozenset)):
+                if len(self.domain) == 0:
+                    # Empty collection means no domain allowed
+                    return False
+                if parsed.netloc.lower() not in [d.lower() for d in self.domain]:
+                    return False
+
+        return True
diff --git a/test_isurl.py b/test_isurl.py
new file mode 100644
index 0000000..d78ef15
--- /dev/null
+++ b/test_isurl.py
@@ -0,0 +1,110 @@
+from dirty_equals import IsURL
+
+# Test basic URL validation
+print("Testing basic URL validation...")
+assert 'https://example.com' == IsURL()
+assert 'http://example.com/path' == IsURL()
+assert 'ftp://files.example.com' == IsURL()
+print("  Basic URL validation: PASSED")
+
+# Test non-strings are rejected
+print("Testing non-string rejection...")
+assert 123 != IsURL()
+assert None != IsURL()
+assert [] != IsURL()
+print("  Non-string rejection: PASSED")
+
+# Test incomplete URLs are rejected
+print("Testing incomplete URL rejection...")
+assert 'example.com' != IsURL()  # no protocol
+assert 'https:' != IsURL()  # no netloc
+assert '//' != IsURL()  # no scheme or netloc
+print("  Incomplete URL rejection: PASSED")
+
+# Test protocol validation (single string)
+print("Testing single protocol validation...")
+assert 'https://example.com' == IsURL('https')
+assert 'http://example.com' != IsURL('https')
+assert 'https://example.com' != IsURL('http')
+print("  Single protocol validation: PASSED")
+
+# Test protocol validation (collection)
+print("Testing collection protocol validation...")
+assert 'https://example.com' == IsURL({'http', 'https'})
+assert 'http://example.com' == IsURL({'http', 'https'})
+assert 'ftp://example.com' != IsURL({'http', 'https'})
+assert 'https://example.com' == IsURL(['http', 'https'])
+assert 'https://example.com' == IsURL(('http', 'https'))
+assert 'https://example.com' == IsURL(frozenset(['http', 'https']))
+print("  Collection protocol validation: PASSED")
+
+# Test empty protocol collection
+print("Testing empty protocol collection...")
+assert 'https://example.com' != IsURL(set())
+assert 'https://example.com' != IsURL([])
+print("  Empty protocol collection: PASSED")
+
+# Test domain validation (single string)
+print("Testing single domain validation...")
+assert 'https://example.com' == IsURL(domain='example.com')
+assert 'https://example.com:8080' == IsURL(domain='example.com:8080')
+assert 'https://example.com:8080' != IsURL(domain='example.com')
+assert 'https://other.com' != IsURL(domain='example.com')
+print("  Single domain validation: PASSED")
+
+# Test domain validation (collection)
+print("Testing collection domain validation...")
+assert 'https://example.com' == IsURL(domain={'example.com', 'test.com'})
+assert 'https://test.com' == IsURL(domain={'example.com', 'test.com'})
+assert 'https://other.com' != IsURL(domain={'example.com', 'test.com'})
+print("  Collection domain validation: PASSED")
+
+# Test empty domain collection
+print("Testing empty domain collection...")
+assert 'https://example.com' != IsURL(domain=set())
+assert 'https://example.com' != IsURL(domain=[])
+print("  Empty domain collection: PASSED")
+
+# Test combined protocol and domain
+print("Testing combined protocol and domain...")
+assert 'https://example.com' == IsURL('https', 'example.com')
+assert 'https://example.com:8080' == IsURL('https', 'example.com:8080')
+assert 'https://example.com:8080' != IsURL('https', 'example.com')
+assert 'http://example.com' != IsURL('https', 'example.com')
+print("  Combined protocol and domain: PASSED")
+
+# Test case insensitivity
+print("Testing case insensitivity...")
+assert 'HTTPS://EXAMPLE.COM' == IsURL('https', 'example.com')
+assert 'Http://Example.Com' == IsURL('http', 'example.com')
+print("  Case insensitivity: PASSED")
+
+# Test repr format
+print("Testing repr format...")
+is_url = IsURL()
+assert str(is_url) == "IsURL(*)"
+print(f"  IsURL(): {str(is_url)}")
+
+is_url = IsURL('https')
+assert str(is_url) == "IsURL('https')"
+print(f"  IsURL('https'): {str(is_url)}")
+
+is_url = IsURL(domain='example.com')
+assert str(is_url) == "IsURL('example.com')"
+print(f"  IsURL(domain='example.com'): {str(is_url)}")
+
+is_url = IsURL('https', 'example.com')
+assert str(is_url) == "IsURL('https', 'example.com')"
+print(f"  IsURL('https', 'example.com'): {str(is_url)}")
+
+# Test with multiple protocols in repr
+is_url = IsURL({'http', 'https'})
+assert str(is_url) == "IsURL(*)"
+print(f"  IsURL({{'http', 'https'}}): {str(is_url)}")
+
+# Test with multiple domains in repr
+is_url = IsURL(domain={'example.com', 'test.com'})
+assert str(is_url) == "IsURL(*)"
+print(f"  IsURL(domain={{'example.com', 'test.com'}}): {str(is_url)}")
+
+print("\nAll tests passed!")
