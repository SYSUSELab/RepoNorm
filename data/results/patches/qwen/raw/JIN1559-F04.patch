+    def extract_translations_with_metadata(
+        self,
+        source: t.Union[str, nodes.Template],
+        source_name: t.Optional[str] = None,
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract translations with metadata from the given template.
+        
+        Returns an iterator of record mappings for metadata-bearing translation blocks.
+        Each record contains:
+        - ``source``: The original source code
+        - ``lineno``: The line number of the trans block
+        - ``metadata``: A copy of the metadata mapping (if any)
+        - ``messages``: List of message dicts with lineno, function, and message
+        
+        Repeated extraction is stable and has no retained Environment state.
+        """
+        if isinstance(source, str):
+            ast = self.environment.parse(source)
+        else:
+            ast = source
+            
+        for record in _extract_with_metadata(ast):
+            yield record
