+def _convert_node_to_value(node: t.Any) -> t.Any:
+    """Convert an AST node to its actual Python value."""
+    if isinstance(node, nodes.Const):
+        return node.value
+    elif isinstance(node, nodes.Name):
+        # For variable references, return the name as a string
+        return node.name
+    elif isinstance(node, nodes.Call):
+        # For function calls, return a placeholder
+        return f"<call: {node.node}>"
+    elif isinstance(node, nodes.ExprStmt):
+        return None
+    else:
+        # For other node types, try to get the value attribute if available
+        return getattr(node, 'value', str(node))
+
+
+def _find_call_nodes(node: nodes.Node) -> t.List[nodes.Call]:
+    """Recursively find all Call nodes within a node tree."""
+    calls = []
+    if isinstance(node, nodes.Call):
+        calls.append(node)
+    for child in node.iter_child_nodes():
+        calls.extend(_find_call_nodes(child))
+    return calls
+
+
+def _extract_with_metadata(
+    ast: nodes.Template,
+    gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
+) -> t.Iterator[t.Dict[str, t.Any]]:
+    """Extract translations with metadata from the given template node."""
+    for node in ast.find_all(nodes.Output):
+        # Check if this Output node has metadata (from trans tag)
+        metadata = getattr(node, 'metadata', None)
+        if metadata is None:
+            continue
+            
+        # Convert metadata values from AST nodes to actual values
+        converted_metadata = {}
+        for key, value in metadata.items():
+            converted_metadata[key] = _convert_node_to_value(value)
+            
+        # Extract messages from this node
+        messages = []
+        # Find all Call nodes recursively (handles MarkSafeIfAutoescape wrapper)
+        call_nodes = _find_call_nodes(node)
+        for call_node in call_nodes:
+            func_name = call_node.node.name if hasattr(call_node.node, 'name') else None
+            if func_name in gettext_functions:
+                # Get the message arguments
+                args = call_node.args
+                if args:
+                    first_arg = args[0]
+                    if isinstance(first_arg, nodes.Const):
+                        msg_value = first_arg.value
+                        if isinstance(msg_value, str):
+                            messages.append({
+                                'lineno': call_node.lineno,
+                                'function': func_name,
+                                'message': msg_value,
+                            })
+                    elif isinstance(first_arg, nodes.Concat):
+                        # Handle concatenated strings
+                        msg_parts = []
+                        for part in first_arg.nodes:
+                            if isinstance(part, nodes.Const) and isinstance(part.value, str):
+                                msg_parts.append(part.value)
+                        if msg_parts:
+                            messages.append({
+                                'lineno': call_node.lineno,
+                                'function': func_name,
+                                'message': ''.join(msg_parts),
+                            })
+        
+        if messages:
+            yield {
+                'source': None,  # Will be set by caller if needed
+                'lineno': node.lineno,
+                'metadata': converted_metadata,
+                'messages': messages,
+            }
+
+
 def extract_from_ast(
