diff --git a/test_track_changes.py b/test_track_changes.py
new file mode 100644
index 0000000..ccd0a22
--- /dev/null
+++ b/test_track_changes.py
@@ -0,0 +1,202 @@
+"""Test script for track_changes feature."""
+import time
+import click
+from click import Context
+from click.core import ParameterSource
+
+
+def test_basic_tracking():
+    """Test basic option history tracking."""
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", default=0)
+    def cli(count):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        print(f"History: {history}")
+        assert history is not None, "History should not be None when tracking is enabled"
+        assert len(history) == 1, f"Expected 1 entry, got {len(history)}"
+        assert history[0]["value"] == 0, f"Expected value 0, got {history[0]['value']}"
+        assert history[0]["source"] == ParameterSource.DEFAULT
+        return history
+    
+    result = click.Context(cli).invoke(cli)
+    print("Basic tracking test passed!")
+
+
+def test_commandline_value():
+    """Test that command-line values are recorded correctly."""
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", default=0)
+    def cli(count):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        print(f"History: {history}")
+        assert len(history) == 1
+        assert history[0]["value"] == 5
+        assert history[0]["source"] == ParameterSource.COMMANDLINE
+        return history
+    
+    # Simulate command line invocation
+    ctx = click.Context(cli)
+    ctx.invoke(cli, count=5)
+
+
+def test_multiple_assignments():
+    """Test that multiple assignments are tracked in order."""
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", default=0)
+    def cli(count):
+        ctx = click.get_current_context()
+        
+        # Initial value from parsing
+        history_before = ctx.get_option_history("count")
+        print(f"History before manual assignment: {history_before}")
+        
+        # Manually assign a new value
+        ctx.params["count"] = 10
+        
+        history_after = ctx.get_option_history("count")
+        print(f"History after manual assignment: {history_after}")
+        
+        assert len(history_after) == 2, f"Expected 2 entries, got {len(history_after)}"
+        assert history_after[0]["value"] == 0
+        assert history_after[0]["source"] == ParameterSource.DEFAULT
+        assert history_after[1]["value"] == 10
+        assert history_after[1]["source"] is None  # Manual assignment has no source
+        return history_after
+    
+    ctx = click.Context(cli)
+    ctx.invoke(cli)
+
+
+def test_tracking_disabled():
+    """Test that tracking disabled returns None."""
+    @click.command(track_changes=False)
+    @click.option("-c", "--count", default=0)
+    def cli(count):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("count")
+        print(f"History (tracking disabled): {history}")
+        assert history is None, "History should be None when tracking is disabled"
+        return history
+    
+    ctx = click.Context(cli)
+    ctx.invoke(cli)
+
+
+def test_nonexistent_option():
+    """Test that nonexistent options return empty list."""
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", default=0)
+    def cli(count):
+        ctx = click.get_current_context()
+        history = ctx.get_option_history("nonexistent")
+        print(f"History for nonexistent option: {history}")
+        assert history == [], f"Expected empty list, got {history}"
+        return history
+    
+    ctx = click.Context(cli)
+    ctx.invoke(cli)
+
+
+def test_group_subcommand_isolation():
+    """Test that group and subcommand have independent histories."""
+    @click.group(track_changes=True)
+    @click.option("-g", "--group-opt", default="group_default")
+    def cli(group_opt):
+        pass
+    
+    @cli.command(track_changes=True)
+    @click.option("-s", "--subopt", default="sub_default")
+    def sub(subopt):
+        ctx = click.get_current_context()
+        
+        # Group option should not exist in subcommand context
+        group_history = ctx.get_option_history("group_opt")
+        print(f"Group option history in subcommand: {group_history}")
+        
+        # Subcommand option should exist
+        sub_history = ctx.get_option_history("subopt")
+        print(f"Subcommand option history: {sub_history}")
+        
+        assert group_history == [], f"Expected empty list for group option, got {group_history}"
+        assert sub_history is not None, "Subcommand option history should not be None"
+        assert len(sub_history) == 1
+        assert sub_history[0]["value"] == "sub_default"
+    
+    # Test group level
+    group_ctx = click.Context(cli)
+    group_ctx.invoke(cli)
+    
+    # Test subcommand level
+    sub_ctx = click.Context(cli.commands["sub"])
+    sub_ctx.invoke(cli.commands["sub"])
+
+
+def test_snapshot_immutability():
+    """Test that returned snapshots are immutable."""
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", default=0)
+    def cli(count):
+        ctx = click.get_current_context()
+        
+        # Get initial history
+        history1 = ctx.get_option_history("count")
+        print(f"Initial history: {history1}")
+        
+        # Modify params
+        ctx.params["count"] = 99
+        
+        # Get history again
+        history2 = ctx.get_option_history("count")
+        print(f"After modification: {history2}")
+        
+        # Original snapshot should be unchanged
+        assert history1[0]["value"] == 0, "Original snapshot should be unchanged"
+        assert len(history2) == 2, "New history should have 2 entries"
+        
+        return history2
+    
+    ctx = click.Context(cli)
+    ctx.invoke(cli)
+
+
+if __name__ == "__main__":
+    print("Running tests...")
+    
+    try:
+        test_basic_tracking()
+    except Exception as e:
+        print(f"test_basic_tracking failed: {e}")
+    
+    try:
+        test_commandline_value()
+    except Exception as e:
+        print(f"test_commandline_value failed: {e}")
+    
+    try:
+        test_multiple_assignments()
+    except Exception as e:
+        print(f"test_multiple_assignments failed: {e}")
+    
+    try:
+        test_tracking_disabled()
+    except Exception as e:
+        print(f"test_tracking_disabled failed: {e}")
+    
+    try:
+        test_nonexistent_option()
+    except Exception as e:
+        print(f"test_nonexistent_option failed: {e}")
+    
+    try:
+        test_group_subcommand_isolation()
+    except Exception as e:
+        print(f"test_group_subcommand_isolation failed: {e}")
+    
+    try:
+        test_snapshot_immutability()
+    except Exception as e:
+        print(f"test_snapshot_immutability failed: {e}")
+    
+    print("Tests completed!")
