+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of values assigned to an option during this invocation.
+
+        :param name: The option's parameter name, long option (e.g., ``"--count"``),
+            or short option (e.g., ``"-c"``).
+
+        Returns a list of history entries if tracking is enabled for the current
+        command, otherwise returns ``None``. Each entry is a dictionary with keys:
+        ``value``, ``source``, and ``timestamp``. If tracking is enabled but the
+        name does not identify an option on the current command, returns an empty
+        list. Positional arguments are not included in the history.
+
+        .. versionadded:: 8.3
+        """
+        # Check if tracking is enabled for this command
+        cmd = self.command
+        if not getattr(cmd, 'track_changes', False):
+            return None
+
+        # Get the option from the command's parameters
+        param = None
+        for p in cmd.params:
+            if p.name == name:
+                param = p
+                break
+            # Also check by option names
+            if param is None:
+                for opt_name in p.opts:
+                    if opt_name == name:
+                        param = p
+                        break
+
+        if param is None:
+            # Option not found on this command
+            return []
+
+        # Return the history for this parameter
+        return getattr(param, '_history', [])
+
 
