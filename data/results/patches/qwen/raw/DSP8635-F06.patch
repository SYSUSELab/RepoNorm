+    def _truncate_to_max(self, text, max_chars):
+        """Hard-truncate text to max_chars."""
+        if max_chars == 0:
+            return ""
+        if len(text) <= max_chars:
+            return text
+        return text[:max_chars]
+
+    def _find_last_sentence_boundary(self, text, max_len):
+        """Find the last sentence boundary (. ! or ? followed by whitespace/end) that fits within max_len."""
+        if len(text) <= max_len:
+            return text
+        
+        # Try to find a sentence boundary within max_len - 1 (for the ellipsis)
+        search_limit = max_len - 1
+        if search_limit < 0:
+            return ""
+        
+        # Look for . ! or ? followed by whitespace or end of string
+        pattern = r'[.!?]\s*'
+        matches = list(re.finditer(pattern, text[:search_limit]))
+        
+        if matches:
+            # Get the last match position
+            last_match = matches[-1]
+            end_pos = last_match.end()
+            
+            # Make sure we have room for ellipsis
+            if end_pos + 1 <= max_len:
+                return text[:end_pos] + "…"
+        
+        # No suitable boundary found, hard truncate
+        return text[:max_len - 1] + "…"
+
+    def _shorten_instruction(self, long_instruction, max_chars):
+        """Call ShortenInstruction to shorten an instruction."""
+        try:
+            shorten_predictor = dspy.Predict(ShortenInstruction)
