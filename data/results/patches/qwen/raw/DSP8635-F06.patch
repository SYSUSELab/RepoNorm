+                max_chars=max_chars,
+            )
+            shortened = strip_prefix(result.proposed_instruction)
+            return shortened
+        except Exception as e:
+            # If rephrasing fails, propagate the error
+            raise e
+
+    def _process_instruction_length(self, proposed_instruction, predictor, basic_instruction):
+        """Process instruction length according to min/max constraints."""
+        measured_len = len(proposed_instruction)
+        
+        # Handle zero cap case
+        if self.max_instr_chars == 0:
+            if self.verbose:
+                print(f"Zero max_instr_chars cap applied. Returning empty string.")
+            return ""
+        
+        # Check if shorter than min
+        if measured_len < self.min_instr_chars:
+            if self.verbose:
+                print(f"Generated instruction ({measured_len} chars) shorter than min ({self.min_instr_chars}). Falling back to canonical basic instruction.")
+            # If no basic instruction available (e.g., predictor is None), return truncated generated instruction
+            if not basic_instruction:
+                return self._truncate_to_max(proposed_instruction, self.max_instr_chars)
+            return self._truncate_to_max(basic_instruction, self.max_instr_chars)
+        
+        # Check if longer than max
+        if measured_len > self.max_instr_chars:
+            if self.rephrase_when_too_long:
+                if self.verbose:
+                    print(f"Generated instruction ({measured_len} chars) longer than max ({self.max_instr_chars}). Rephrasing...")
+                
+                # Make exactly one ShortenInstruction call
+                try:
+                    rephrased = self._shorten_instruction(proposed_instruction, self.max_instr_chars)
+                    rephrased_len = len(rephrased)
+                    
+                    # Strip output prefix (already done in _shorten_instruction)
+                    # Check if empty or still shorter than min
+                    if not rephrased or len(rephrased) < self.min_instr_chars:
+                        if self.verbose:
+                            print(f"Rephrased instruction ({rephrased_len} chars) empty or shorter than min ({self.min_instr_chars}). Falling back to canonical basic instruction.")
+                        return self._truncate_to_max(basic_instruction, self.max_instr_chars)
+                    
+                    # Hard-truncate if still overlong
