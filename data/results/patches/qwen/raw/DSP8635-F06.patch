+                truncated = self._find_last_sentence_boundary(proposed_instruction, self.max_instr_chars)
+                if self.verbose:
+                    print(f"Truncated instruction ({len(truncated)} chars)")
+                return truncated
+        
+        # Within bounds, return as-is
+        return proposed_instruction
