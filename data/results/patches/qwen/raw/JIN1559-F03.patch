+def _convert_priority(priority_expr: t.Any) -> int:
+    """Convert priority expression to int, handling invalid/None/negative values."""
+    if priority_expr is None:
+        return 0
+    try:
+        value = int(priority_expr)
+        return max(0, value)
+    except (TypeError, ValueError):
+        return 0
+
+
+def _trans_with_priority(
+    gettext_func: t.Callable[[str], str],
+    ngettext_func: t.Optional[t.Callable[[str, str, int], str]],
+    priority_gettext: t.Optional[t.Callable[[str, int], str]] = None,
+    priority_ngettext: t.Optional[t.Callable[[str, str, int, int], str]] = None,
+    priority: t.Any = 0,
+    singular: str = "",
+    plural: t.Optional[str] = None,
+    num: t.Optional[int] = None,
+) -> str:
+    """Execute trans with priority fallback mechanism."""
+    converted_priority = _convert_priority(priority)
+    max_level = min(converted_priority, 9)
+    
+    # Try levels from 0 to max_level using priority resolvers
+    for level in range(max_level + 1):
+        if plural is not None and ngettext_func is not None:
+            # Plural message
+            if priority_ngettext is not None:
+                result = priority_ngettext(singular, plural, num, level)
+            else:
+                result = ngettext_func(singular, plural, num)
+            
+            # If result differs from source, we found a translation
+            if result != singular and result != plural:
+                return result
+        else:
+            # Singular message
+            if priority_gettext is not None:
+                result = priority_gettext(singular, level)
+            else:
+                result = gettext_func(singular)
+            
+            # If result differs from source, we found a translation
+            if result != singular:
+                return result
+    
+    # Fallback to ordinary gettext if no priority resolver or all levels matched source
+    if plural is not None and ngettext_func is not None:
+        return ngettext_func(singular, plural, num)
+    else:
+        return gettext_func(singular)
