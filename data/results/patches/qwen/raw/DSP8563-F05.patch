+def _remove_python_comments(text: str) -> str:
+    """Remove Python-style # comments from text while preserving # inside quoted strings.
+
+    Args:
+        text: Text potentially containing # comments.
+
+    Returns:
+        Text with # comments removed.
+    """
+    result = []
+    in_string = False
+    escape_next = False
+
+    i = 0
+    while i < len(text):
+        char = text[i]
+
+        if escape_next:
+            # Previous char was backslash, so this char is escaped
+            # Just append it and reset escape flag
+            result.append(char)
+            escape_next = False
+            i += 1
+            continue
+
+        if char == '\\':
+            # Start of escape sequence
+            result.append(char)
+            escape_next = True
+            i += 1
+            continue
+
+        if char == '"':
+            # Toggle string state only if not escaping
+            in_string = not in_string
+            result.append(char)
+            i += 1
+            continue
+
+        if not in_string and char == '#':
+            # Skip until end of line
+            while i < len(text) and text[i] != '\n':
+                i += 1
+            # Keep the newline
+            if i < len(text):
+                result.append('\n')
+                i += 1
+            continue
+
+        result.append(char)
+        i += 1
+
+    return ''.join(result)
+
+
+def _extract_comments(text: str) -> list[str]:
+    """Extract Python-style # comments from text.
+
+    Args:
+        text: Text potentially containing # comments.
+
+    Returns:
+        List of comment strings (without the leading #).
+    """
+    comments = []
+    in_string = False
+    escape_next = False
+
+    i = 0
+    current_comment = []
+
+    while i < len(text):
+        char = text[i]
+
+        if escape_next:
+            # Previous char was backslash, so this char is escaped
+            if current_comment:
+                current_comment.append(char)
+            escape_next = False
+            i += 1
+            continue
+
+        if char == '\\':
+            # Start of escape sequence
+            if current_comment:
+                current_comment.append(char)
+            escape_next = True
+            i += 1
+            continue
+
+        if char == '"':
+            # Toggle string state only if not escaping
+            in_string = not in_string
+            if current_comment:
+                current_comment.append(char)
+            i += 1
+            continue
+
+        if not in_string and char == '#':
+            # Start collecting comment
+            current_comment = []
+            i += 1
+            # Collect until end of line
+            while i < len(text) and text[i] != '\n':
+                current_comment.append(text[i])
+                i += 1
+            # End of comment
+            if current_comment:
+                comment_text = ''.join(current_comment).strip()
+                if comment_text:
+                    comments.append(comment_text)
+            current_comment = []
+            continue
+
+        if current_comment:
+            current_comment.append(char)
+
+        i += 1
+
+    return comments
+
 
