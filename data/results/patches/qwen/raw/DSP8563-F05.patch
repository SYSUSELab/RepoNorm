+    def format_with_metadata(self) -> list[dict[str, Any]]:
+        """Format tool calls with metadata included beside type/function fields.
+
+        Returns the same envelope as format() but includes non-None metadata fields
+        alongside each call's type/function fields, not inside arguments.
+        Unset metadata is omitted; explicit empty strings/lists/dictionaries and zero priority are preserved.
+        """
+        result = []
+        for tool_call in self.tool_calls:
+            call_data = {
+                "type": "function",
+                "function": {
+                    "name": tool_call.name,
+                    "arguments": tool_call.args,
+                },
+            }
+            # Add metadata fields if they are not None
+            if tool_call.note is not None:
+                call_data["note"] = tool_call.note
+            if tool_call.comment is not None:
+                call_data["comment"] = tool_call.comment
+            if tool_call.annotation is not None:
+                call_data["annotation"] = tool_call.annotation
+            if tool_call.tags is not None:
+                call_data["tags"] = tool_call.tags
+            if tool_call.priority is not None:
+                call_data["priority"] = tool_call.priority
+            if tool_call.meta is not None:
+                call_data["meta"] = tool_call.meta
+            result.append(call_data)
+
+        return [
+            {
+                "type": "tool_calls",
+                "tool_calls": result,
+            }
+        ]
+
