     def close(self) -> None:
         """Invoke all close callbacks registered with
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
+
+        If :attr:`cleanup_timeout` is set, this method will wait at most
+        that many seconds for cleanup to complete. If cleanup does not
+        complete within the timeout, a warning is issued but no exception
+        is raised. New callbacks registered during cleanup belong to the
+        next close() call.
         """
-        self._exit_stack.close()
+        import threading
+        import warnings
+        
+        if self.cleanup_timeout is None:
+            # No timeout: synchronous cleanup
+            self._exit_stack.close()
+            # In case the context is reused, create a new exit stack.
+            self._exit_stack = ExitStack()
+            return
+        
+        # Capture the current state of callbacks and exit stack
+        # These are the callbacks that belong to this close() call
+        callbacks_to_run = list(self._close_callbacks)
+        exit_stack_to_close = self._exit_stack
+        
+        # Create a thread to run the cleanup with timeout
+        cleanup_done = threading.Event()
+        cleanup_error = [None]
+        
+        def run_cleanup():
+            try:
+                exit_stack_to_close.close()
+            except Exception as e:
+                cleanup_error[0] = e
+            finally:
+                cleanup_done.set()
+        
+        # Start the cleanup thread
+        thread = threading.Thread(target=run_cleanup, daemon=True)
+        thread.start()
+        
+        # Wait for cleanup with timeout
+        if not cleanup_done.wait(timeout=self.cleanup_timeout):
+            # Timeout reached - issue warning but don't raise exception
+            warnings.warn(
+                f"Cleanup did not complete within {self.cleanup_timeout} seconds. "
+                f"The cleanup thread is still running.",
+                RuntimeWarning,
+                stacklevel=2,
+            )
+            # Don't join the thread - let it finish in the background
+            # Any errors from the background thread will be lost unless we track them
+            # For now, we just warn about the timeout
+        else:
+            # Cleanup completed - check for errors
+            if cleanup_error[0] is not None:
+                raise cleanup_error[0]
+        
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
 
