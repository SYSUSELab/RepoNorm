diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..0003ba7 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,87 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+
+@pytest.mark.parametrize(
+    ("timeout", "expect_error"),
+    [
+        pytest.param(True, ValueError, id="bool True"),
+        pytest.param(False, ValueError, id="bool False"),
+        pytest.param(1.5, ValueError, id="float"),
+        pytest.param("10", ValueError, id="string"),
+        pytest.param([], ValueError, id="list"),
+        pytest.param({}, ValueError, id="dict"),
+        pytest.param(0, ValueError, id="zero"),
+        pytest.param(-1, ValueError, id="negative"),
+        pytest.param(None, None, id="None (no timeout)"),
+        pytest.param(1, None, id="positive int"),
+    ],
+)
+def test_edit_timeout_validation(runner, timeout, expect_error):
+    """Test that invalid timeout values raise ValueError."""
+    if expect_error is ValueError:
+        with pytest.raises(ValueError, match="timeout must be a positive integer or None"):
+            click.edit(text="test", editor="echo hello", timeout=timeout)
+    else:
+        # For valid timeouts, we expect an error from the editor not being found
+        # or the command failing, but not a ValueError
+        try:
+            click.edit(text="test", editor="echo hello", timeout=timeout)
+        except click.ClickException:
+            pass  # Expected - editor command may fail
+
+
+def test_edit_timeout_hanging_editor(runner):
+    """Test that a hanging editor is terminated after timeout."""
+    import time
+    
+    start = time.time()
+    with pytest.raises(click.ClickException, match=r"Editing timed out after 2 seconds"):
+        click.edit(
+            text="test",
+            editor="/usr/local/bin/python3 -c 'import time; time.sleep(10)'",
+            timeout=2,
+        )
+    elapsed = time.time() - start
+    assert 1.9 < elapsed < 4.0, f"Expected ~2s, got {elapsed:.2f}s"
+
+
+def test_edit_timeout_zero_exit_code(runner):
+    """Test that successful editor exit before timeout works normally."""
+    # Use sed to modify the file in place (like the existing test)
+    result = click.edit(
+        text="test",
+        editor="sed -i~ 's/$/Modified/'",
+        timeout=5,
+    )
+    assert result == "testModified\n"
+
+
+def test_edit_timeout_file_edit(runner):
+    """Test timeout works with filename parameter."""
+    import tempfile
+    import os
+    import time
+    
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
+        f.write("original")
+        temp_path = f.name
+    
+    try:
+        start = time.time()
+        with pytest.raises(click.ClickException, match=r"Editing timed out after 2 seconds"):
+            click.edit(
+                filename=temp_path,
+                editor="/usr/local/bin/python3 -c 'import time; time.sleep(10)'",
+                timeout=2,
+            )
+        elapsed = time.time() - start
+        assert 1.9 < elapsed < 4.0, f"Expected ~2s, got {elapsed:.2f}s"
+        
+        # File should still exist and be unchanged
+        with open(temp_path, "r") as f:
+            content = f.read()
+        assert content == "original"
+    finally:
+        os.unlink(temp_path)
