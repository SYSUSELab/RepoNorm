--- a/src/jinja2/environment.py
+++ b/src/jinja2/environment.py
@@ -1114,11 +1114,80 @@ class Environment:
 
         return ChainMap(d, self.globals)
 
+    def extract_marked_translations(
+        self,
+        source: t.Union[str, nodes.Template],
+        source_name: t.Optional[str] = None,
+    ) -> t.Iterator["TranslationRecord"]:
+        """Extract marked translations from a template source or AST node.
+
+        This method parses the source, finds all ``{% extract %}`` blocks,
+        and yields translation records for each marker found. The marker
+        body is parsed as an ordinary Jinja template and any gettext calls
+        within it are extracted.
+
+        :param source: A string containing template source or a parsed
+            :class:`~jinja2.nodes.Template` AST node.
+        :param source_name: Optional logical name of the source being
+            processed. Used to identify the source in the returned records.
+        :return: An iterator yielding :class:`TranslationRecord` instances.
+
+        .. versionadded:: 3.2
+        """
+        from .ext import TranslationExtractorExtension, _extract_from_extract_node
+        from .nodes import ExtractNode
+
+        if isinstance(source, str):
+            ast = self.parse(source)
+        else:
+            ast = source
+
+        for extract_node in ast.find_all(ExtractNode):
+            for record in _extract_from_extract_node(extract_node):
+                yield record._replace(source=source_name)
+
+    def extract_marked_translations_from_templates(
+        self, names: t.Optional[t.Iterable[str]] = None
+    ) -> t.Iterator["TranslationRecord"]:
+        """Extract marked translations from templates loaded by the environment's loader.
+
+        This method loads templates using the configured loader and extracts
+        marked translations from each one. It does not render templates or
+        recursively follow includes/inheritance - only the top-level template
+        content is processed.
+
+        :param names: An iterable of template names to process. If omitted,
+            all templates listed by the loader are processed in their order.
+        :return: An iterator yielding :class:`TranslationRecord` instances.
+
+        .. versionadded:: 3.2
+        """
+        assert self.loader is not None, "No loader configured."
+
+        if names is None:
+            names = self.list_templates()
+
+        for name in names:
+            # Get the template source from the loader
+            try:
+                source, _, _ = self.loader.get_source(self, name)
+            except Exception:
+                continue
+            
+            # Parse and extract
+            ast = self.parse(source)
+            
+            from .nodes import ExtractNode
+            for extract_node in ast.find_all(ExtractNode):
+                from .ext import _extract_from_extract_node
+                
+                for record in _extract_from_extract_node(extract_node):
+                    yield record._replace(source=name)
+
 
