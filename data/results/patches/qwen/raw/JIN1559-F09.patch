diff --git a/src/jinja2/ext.py b/src/jinja2/ext.py
index d21b83a..246da95 100644
--- a/src/jinja2/ext.py
+++ b/src/jinja2/ext.py
@@ -852,3 +852,140 @@ i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+
+
+class TranslationExtractorExtension(Extension):
+    """This extension adds support for extracting translations from marked
+    blocks in templates.  It provides a ``{% extract %}`` tag that allows
+    marking sections of a template for translation extraction.
+
+    The syntax is::
+
+        {% extract key="constant", ... %}...{% endextract %}
+
+    Metadata values must be compile-time constants; dynamic expressions and
+    duplicate keys raise :exc:`TemplateSyntaxError`.  Marker bodies are
+    ordinary Jinja bodies and render unchanged.  They may contain control
+    structures and any gettext calls supported by normal extraction.
+    """
+
+    tags = {"extract"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse an extract block."""
+        lineno = next(parser.stream).lineno
+        metadata: t.Dict[str, nodes.Expr] = {}
+        seen_keys: t.Set[str] = set()
+
+        # Parse metadata key=value pairs
+        while parser.stream.current.type != "block_end":
+            # Skip whitespace tokens
+            if parser.stream.current.type == "whitespace":
+                next(parser.stream)
+                continue
+
+            # If we have metadata, expect a comma separator
+            if metadata:
+                parser.stream.expect("comma")
+
+            token = parser.stream.expect("name")
+            key = token.value
+
+            if key in seen_keys:
+                parser.fail(
+                    f"extract marker has duplicate key {key!r}",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+            seen_keys.add(key)
+
+            parser.stream.expect("assign")
+            expr = parser.parse_expression()
+
+            # Check that the expression is a compile-time constant
+            if not isinstance(expr, nodes.Const):
+                parser.fail(
+                    f"extract marker value for {key!r} must be a constant",
+                    expr.lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            # Add to metadata
+            metadata[key] = expr
+
+        # Parse the body of the extract block
+        body = parser.parse_statements(("name:endextract",), drop_needle=True)
+
+        return nodes.ExtractNode(body, metadata, lineno=lineno)
+
+
+
+class TranslationRecord(t.NamedTuple):
+    """A record returned by :meth:`Environment.extract_marked_translations`.
+
+    :param source: The logical name of the template being processed, or None
+        if extracting from a string source.
+    :param marker_lineno: The line number of the ``{% extract %}`` marker.
+    :param metadata: A copy of the metadata mapping from the extract marker.
+    :param messages: A list of extracted message records, each containing
+        lineno, function, and message.
+    """
+
+    source: t.Optional[str]
+    marker_lineno: int
+    metadata: t.Dict[str, t.Any]
+    messages: t.List[t.Tuple[int, str, t.Union[t.Optional[str], t.Tuple[t.Optional[str], ...]]]]
+
+
+def _extract_from_extract_node(
+    node: "ExtractNode",
+    gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
+) -> t.Iterator[TranslationRecord]:
+    """Extract messages from an ExtractNode's body."""
+    # Extract gettext calls from the body
+    messages: t.List[t.Tuple[int, str, t.Union[t.Optional[str], t.Tuple[t.Optional[str], ...]]]] = []
+    
+    # Find all Call nodes in the body
+    for body_node in node.body:
+        for call_node in body_node.find_all(nodes.Call):
+            if (
+                not isinstance(call_node.node, nodes.Name)
+                or call_node.node.name not in gettext_functions
+            ):
+                continue
+            
+            strings: t.List[t.Optional[str]] = []
+            
+            for arg in call_node.args:
+                if isinstance(arg, nodes.Const) and isinstance(arg.value, str):
+                    strings.append(arg.value)
+                else:
+                    strings.append(None)
+            
+            for _ in call_node.kwargs:
+                strings.append(None)
+            if call_node.dyn_args is not None:
+                strings.append(None)
+            if call_node.dyn_kwargs is not None:
+                strings.append(None)
+            
+            # Convert to tuple format
+            if len(strings) == 1:
+                msg = strings[0]
+            else:
+                msg = tuple(strings)
+            
+            messages.append((call_node.lineno, call_node.node.name, msg))
+    
+    # Create a deep copy of metadata
+    metadata_copy: t.Dict[str, t.Any] = {}
+    for key, expr in node.metadata.items():
+        if isinstance(expr, nodes.Const):
+            metadata_copy[key] = expr.value
+    
+    yield TranslationRecord(
+        source=None,
+        marker_lineno=node.lineno,
+        metadata=metadata_copy,
+        messages=messages,
+    )
