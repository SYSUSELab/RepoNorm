+def _coerce_scalar_value(value: Any, schema_type: str | None) -> Any:
+    """Coerce scalar string values according to JSON schema type.
+    
+    Args:
+        value: The value to coerce.
+        schema_type: The JSON schema type (e.g., "integer", "number", "boolean").
+        
+    Returns:
+        The coerced value, or the original value if coercion is not applicable.
+    """
+    # Only process string values
+    if not isinstance(value, str):
+        return value
+    
+    # Trim surrounding whitespace
+    trimmed = value.strip()
+    
+    # Handle empty strings
+    if not trimmed:
+        return value
+    
+    # Boolean coercion: accept case-insensitive "true" and "false"
+    if schema_type == "boolean":
+        lower = trimmed.lower()
+        if lower == "true":
+            return True
+        elif lower == "false":
+            return False
+        return value
+    
+    # Integer and number coercion
+    if schema_type in ("integer", "number"):
+        # Try to parse as duration first (for number types)
+        if schema_type == "number":
+            match = _DURATION_PATTERN.match(trimmed)
+            if match:
