+                    if magnitude_match:
+                        magnitude = int(magnitude_match.group(1))
+                        suffix = magnitude_match.group(2)
+                        return magnitude * _DURATION_SUFFIXES[suffix]
+                except (ValueError, KeyError):
+                    pass
+        
