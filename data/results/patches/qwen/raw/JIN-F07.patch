+def _groupby_stable(
+    value: t.Iterable[V],
+    expr: t.Callable[[t.Any], t.Any],
+) -> t.List[t.Tuple[t.Any, t.List[V]]]:
+    """Group items by key, preserving first-seen order of keys.
+
+    Supports unhashable keys (lists, dicts) by using equality comparison.
+    Equal keys merge even when not adjacent.
+    Retains the first original key object as grouper.
+    """
+    groups: t.List[t.Tuple[t.Any, t.List[V]]] = []
+    seen_keys: t.List[t.Any] = []
+
+    for item in value:
+        key = expr(item)
+        # Find if we've seen this key before (using equality)
+        found_index = None
+        for i, seen_key in enumerate(seen_keys):
+            if key == seen_key:
+                found_index = i
+                break
+
+        if found_index is not None:
+            # Add to existing group
+            groups[found_index][1].append(item)
+        else:
+            # Create new group with first-seen key
+            seen_keys.append(key)
+            groups.append([key, [item]])
+
+    return groups
+
