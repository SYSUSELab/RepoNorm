+def _groupby_key(key: t.Any, include_empty: bool) -> t.Tuple[int, ...]:
+    """Return a sort key for groupby keys.
+
+    Ordering: normal comparable keys first (including empty string),
+    then None, then Undefined/missing values.
+    """
+    if isinstance(key, Undefined):
+        return (2,)  # Undefined/missing last
+    elif key is None:
+        return (1,)  # None second
+    else:
+        return (0, key)  # Normal keys first
+
