+++ b/test_cache.py
@@ -0,0 +1,116 @@
+import tiktoken
+import time
+import copy
+
+# Test basic encoding
+enc = tiktoken.get_encoding("cl100k_base")
+
+print("Test 1: Basic encode without cache (default use_cache=False)")
+tokens1 = enc.encode("Hello world")
+print(f"Tokens: {tokens1}")
+
+print("\nTest 2: Same text again (should produce same tokens)")
+tokens2 = enc.encode("Hello world")
+assert tokens1 == tokens2, "Same text should produce same tokens"
+print(f"Tokens: {tokens2}")
+
+print("\nTest 3: With special tokens")
+try:
+    enc.encode("<|endoftext|>")
+except ValueError as e:
+    print(f"Expected error: {e}")
+
+special_token_encoded = enc.encode("<|endoftext|>", allowed_special={"<|endoftext|>"})
+print(f"Special token encoded: {special_token_encoded}")
+
+print("\nTest 4: Batch encoding")
+batch_tokens = enc.encode_batch(["hello", "world"])
+print(f"Batch tokens: {batch_tokens}")
+
+print("\nTest 5: Verify batch order preservation")
+assert batch_tokens[0] == enc.encode("hello"), "First element should match"
+assert batch_tokens[1] == enc.encode("world"), "Second element should match"
+print("Order preserved correctly")
+
+print("\nTest 6: Cache enabled - first call (cache miss)")
+start = time.time()
+cached_tokens1 = enc.encode("Hello world", use_cache=True)
+time1 = time.time() - start
+print(f"Tokens: {cached_tokens1}, Time: {time1:.4f}s")
+
+print("\nTest 7: Cache enabled - second call (cache hit)")
+start = time.time()
+cached_tokens2 = enc.encode("Hello world", use_cache=True)
+time2 = time.time() - start
+print(f"Tokens: {cached_tokens2}, Time: {time2:.4f}s")
+assert cached_tokens1 == cached_tokens2, "Cached results should be identical"
+print(f"Cache hit! Second call was faster: {time1/time2:.2f}x")
+
+print("\nTest 8: Cache disabled - third call (no caching)")
+start = time.time()
+uncached_tokens = enc.encode("Hello world", use_cache=False)
+time3 = time.time() - start
+print(f"Tokens: {uncached_tokens}, Time: {time3:.4f}s")
+assert uncached_tokens == cached_tokens1, "Results should be identical regardless of cache"
+
+print("\nTest 9: Different special token policies create different cache entries")
+# First with disallowed_special=()
+result1 = enc.encode("test <|endoftext|>", disallowed_special=(), use_cache=True)
+print(f"With disallowed_special=(): {result1}")
+
+# Then with allowed_special set
+result2 = enc.encode("test <|endoftext|>", allowed_special={"<|endoftext|>"}, use_cache=True)
+print(f"With allowed_special: {result2}")
+
+# They should be different
+assert result1 != result2, "Different policies should produce different results"
+print("Different policies correctly produce different cache entries")
+
+print("\nTest 10: Cache capacity eviction (LRU)")
+# Fill cache with many unique texts
+for i in range(150):
+    enc.encode(f"Text number {i}", use_cache=True)
+
+# Check that old entries are evicted
+old_result = enc.encode("Text number 0", use_cache=True)
+new_result = enc.encode("Text number 149", use_cache=True)
+print(f"Old text still works: {old_result is not None}")
+print(f"New text works: {new_result is not None}")
+
+print("\nTest 11: Returned lists cannot mutate cached values")
+cached_list = enc.encode("Mutation test", use_cache=True)
+original_len = len(cached_list)
+cached_list.append(999999)  # Try to mutate
+# Get it again from cache
+fresh_list = enc.encode("Mutation test", use_cache=True)
+assert len(fresh_list) == original_len, "Cached value should not be mutated"
+print("Cache protection against mutation works!")
+
+print("\nTest 12: Different encoding instances are isolated")
+enc2 = tiktoken.get_encoding("r50k_base")
+enc2_tokens = enc2.encode("Hello world", use_cache=True)
+enc_tokens = enc.encode("Hello world", use_cache=True)
+assert enc2_tokens != enc_tokens, "Different vocabularies should produce different tokens"
+print("Different encoding instances are properly isolated")
+
+print("\nTest 13: Pickle round-trip preserves behavior")
+import pickle
+pickled = pickle.dumps(enc)
+unpickled = pickle.loads(pickled)
+unpickled_tokens = unpickled.encode("Hello world", use_cache=True)
+assert unpickled_tokens == enc.encode("Hello world", use_cache=True), "Pickle round-trip should preserve encoding"
+print("Pickle round-trip works correctly")
+
+print("\nTest 14: encode_batch with caching")
+batch_with_cache = enc.encode_batch(["text1", "text2", "text1"], use_cache=True)
+print(f"Batch with cache: {batch_with_cache}")
+assert batch_with_cache[0] == batch_with_cache[2], "Same text in batch should produce same tokens"
+print("Batch caching works correctly")
+
+print("\nTest 15: encode_ordinary_batch still works")
+ordinary_batch = enc.encode_ordinary_batch(["hello", "world"])
+print(f"Ordinary batch: {ordinary_batch}")
+assert ordinary_batch[0] == enc.encode_ordinary("hello"), "Ordinary batch should work"
+print("encode_ordinary_batch works correctly")
+
+print("\nAll tests passed!")
