new file mode 100644
index 0000000..f31a456
--- /dev/null
+++ b/test_concurrent_cache.py
@@ -0,0 +1,57 @@
+"""Test concurrent cache access."""
+import tiktoken
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import threading
+
+enc = tiktoken.get_encoding("cl100k_base")
+
+print("Test: Concurrent cache access")
+
+# Track results
+results = []
+errors = []
+lock = threading.Lock()
+
+def encode_text(text):
+    try:
+        result = enc.encode(text, use_cache=True)
+        with lock:
+            results.append((text, result))
+    except Exception as e:
+        with lock:
+            errors.append((text, str(e)))
+
+# Run many concurrent requests for the same text
+texts = ["Hello world"] * 50 + ["Goodbye world"] * 50 + ["Different text"] * 50
+
+with ThreadPoolExecutor(max_workers=10) as executor:
+    futures = [executor.submit(encode_text, text) for text in texts]
+    for future in as_completed(futures):
+        future.result()
+
+print(f"Total successful encodings: {len(results)}")
+print(f"Total errors: {len(errors)}")
+
+if errors:
+    print("Errors occurred:")
+    for text, error in errors[:5]:
+        print(f"  {text}: {error}")
+else:
+    print("No errors!")
+
+# Verify all results are correct
+expected_hello = enc.encode("Hello world", use_cache=False)
+expected_goodbye = enc.encode("Goodbye world", use_cache=False)
+expected_different = enc.encode("Different text", use_cache=False)
+
+hello_results = [r for t, r in results if t == "Hello world"]
+goodbye_results = [r for t, r in results if t == "Goodbye world"]
+different_results = [r for t, r in results if t == "Different text"]
+
+assert all(r == expected_hello for r in hello_results), "Hello world results should match"
+assert all(r == expected_goodbye for r in goodbye_results), "Goodbye world results should match"
+assert all(r == expected_different for r in different_results), "Different text results should match"
+
+print("All concurrent results are correct!")
+print(f"Cache size after concurrent access: {len(enc._cache)}")
+print("Concurrent cache test passed!")
