+"""Test cache behavior in detail."""
+import tiktoken
+
+enc = tiktoken.get_encoding("cl100k_base")
+
+print("Test: Cache key includes special token policy")
+
+# Clear cache
+enc._cache.clear()
+
+# First call with disallowed_special=()
+result1 = enc.encode("test", disallowed_special=(), use_cache=True)
+print(f"Cache after first call (disallowed_special=()): {len(enc._cache)} entries")
+
+# Second call with allowed_special set - should be different cache entry
+result2 = enc.encode("test", allowed_special={"test"}, use_cache=True)
+print(f"Cache after second call (allowed_special): {len(enc._cache)} entries")
+
+# Third call with same policy as first - should hit cache
+result3 = enc.encode("test", disallowed_special=(), use_cache=True)
+print(f"Cache after third call (same as first): {len(enc._cache)} entries")
+
+assert len(enc._cache) == 2, "Should have 2 cache entries for different policies"
+assert result1 == result3, "Same policy should produce same result"
+print("Cache correctly distinguishes between different special token policies!")
+
+print("\nTest: LRU eviction order")
+enc._cache.clear()
+
+# Add entries to cache
+for i in range(5):
+    enc.encode(f"text{i}", use_cache=True)
+
+print(f"Cache after adding 5 texts: {[k[0] for k in enc._cache.keys()]}")
+
+# Access text0 to make it most recently used
+enc.encode("text0", use_cache=True)
+
+print(f"Cache after accessing text0: {[k[0] for k in enc._cache.keys()]}")
+
+# Add one more to trigger eviction (capacity is 128, but we only added 6)
+# Need to add enough to trigger eviction
+for i in range(128):
+    enc.encode(f"extra{i}", use_cache=True)
+
+print(f"Cache size after adding 128 extra texts: {len(enc._cache)}")
+
+keys = list(enc._cache.keys())
+# After adding 128+ entries, text0 should still be there (most recent among original)
+# text1-4 should be evicted
+# The last entry should be extra127
+assert keys[-1][0] == "extra127", f"last entry should be extra127, got {keys[-1][0]}"
+assert "text1" not in [k[0] for k in keys], "text1 should be evicted"
+print("LRU eviction works correctly!")
+
+print("\nAll cache behavior tests passed!")
