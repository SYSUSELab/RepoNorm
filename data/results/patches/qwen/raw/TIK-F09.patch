+def _compress_tokens(tokens: list[int]) -> list[int]:
+    """Compresses a list of tokens by collapsing adjacent repeated token IDs.
+    
+    This is a lossy transformation that does not preserve the original text or 
+    guarantee unchanged meaning, and is not a reversible compression format.
+    
+    Args:
+        tokens: A list of token IDs
+        
+    Returns:
+        A new list with adjacent repeated token IDs collapsed into single occurrences
+    """
+    if not tokens:
+        return []
+    
+    compressed = [tokens[0]]
+    for token in tokens[1:]:
+        if token != compressed[-1]:
+            compressed.append(token)
+    return compressed
+
