diff --git a/test_compress.py b/test_compress.py
new file mode 100644
index 0000000..faec66d
--- /dev/null
+++ b/test_compress.py
@@ -0,0 +1,81 @@
+import tiktoken
+
+enc = tiktoken.get_encoding('gpt2')
+
+# Test basic compression
+text = "The dog dog dog ran ran quickly"
+encoded = enc.encode(text)
+print(f"Original encoding: {encoded}")
+
+# Expected compressed result: [464, 3290, 4966, 2952]
+expected_compressed = [464, 3290, 4966, 2952]
+
+# Test with compress=True
+try:
+    compressed = enc.encode(text, compress=True)
+    print(f"Compressed encoding: {compressed}")
+    assert compressed == expected_compressed, f"Expected {expected_compressed}, got {compressed}"
+    print("✓ Basic compression test passed")
+except TypeError as e:
+    print(f"✗ compress parameter not yet implemented: {e}")
+
+# Test without compression (default behavior)
+no_compress = enc.encode(text, compress=False)
+print(f"No compression: {no_compress}")
+assert no_compress == encoded, f"Expected {encoded}, got {no_compress}"
+print("✓ No compression test passed")
+
+# Test empty string
+empty_encoded = enc.encode("", compress=True)
+print(f"Empty string: {empty_encoded}")
+assert empty_encoded == [], f"Expected [], got {empty_encoded}"
+print("✓ Empty string test passed")
+
+# Test single token
+single_text = "hello"
+single_encoded = enc.encode(single_text, compress=True)
+print(f"Single token: {single_encoded}")
+assert len(single_encoded) == 1, f"Expected length 1, got {len(single_encoded)}"
+print("✓ Single token test passed")
+
+# Test all same tokens (if possible)
+# Note: "dog dog" may encode to different tokens depending on vocabulary
+same_text = "dog dog"
+same_encoded = enc.encode(same_text)
+same_compressed = enc.encode(same_text, compress=True)
+print(f"All same tokens: {same_encoded} -> {same_compressed}")
+# The compressed version should have fewer or equal elements
+assert len(same_compressed) <= len(same_encoded), "Compression should reduce or maintain length"
+print("✓ All same tokens test passed")
+
+# Test alternating pattern (should not compress)
+alt_text = "a b a b a b"
+alt_encoded = enc.encode(alt_text)
+alt_compressed = enc.encode(alt_text, compress=True)
+print(f"Alternating: {alt_encoded} -> {alt_compressed}")
+assert alt_encoded == alt_compressed, "Alternating pattern should not be compressed"
+print("✓ Alternating pattern test passed")
+
+# Test encode_to_numpy with compress
+import numpy as np
+numpy_compressed = enc.encode_to_numpy(text, compress=True)
+print(f"Numpy compressed: {numpy_compressed.tolist()}")
+assert numpy_compressed.tolist() == expected_compressed, f"Expected {expected_compressed}, got {numpy_compressed.tolist()}"
+print("✓ Numpy compression test passed")
+
+# Test batch encoding with compress
+batch_texts = ["dog dog", "cat cat", "bird"]
+batch_compressed = enc.encode_batch(batch_texts, compress=True)
+print(f"Batch compressed: {batch_compressed}")
+# Verify that compression was applied correctly
+for i, (original, compressed) in enumerate(zip(enc.encode_batch(batch_texts), batch_compressed)):
+    assert len(compressed) <= len(original), f"Batch item {i}: compression should reduce or maintain length"
+print("✓ Batch compression test passed")
+
+# Test that compress=False is default
+default_result = enc.encode(text)
+explicit_false = enc.encode(text, compress=False)
+assert default_result == explicit_false, "Default should be compress=False"
+print("✓ Default compress=False test passed")
+
+print("\nAll tests passed!")
