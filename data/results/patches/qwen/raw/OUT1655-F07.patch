diff --git a/tests/types/test_custom_types.py b/tests/types/test_custom_types.py
index 691b681..8b4cc60 100644
--- a/tests/types/test_custom_types.py
+++ b/tests/types/test_custom_types.py
@@ -108,3 +108,32 @@ def test_type_enum(custom_type, test_string, should_match):
 
     does_match = test_string in custom_type.__members__
     assert does_match is should_match
+
+
+@pytest.mark.parametrize(
+    "test_string,should_match",
+    [
+        ("1234567890123456", True),  # No separators
+        ("1234-5678-9012-3456", True),  # Hyphen-separated
+        ("1234 5678 9012 3456", True),  # Space-separated
+        ("123456789012345", False),   # Only 15 digits
+        ("12345678901234567", False), # 17 digits
+        ("1234-5678 9012-3456", False),  # Mixed separators
+        ("1234_5678_9012_3456", False),  # Underscore separators
+        ("123456789012345a", False),    # Contains letter
+        ("", False),                     # Empty string
+    ],
+)
+def test_credit_card(test_string, should_match):
+    class Model(BaseModel):
+        attr: types.credit_card
+
+    schema = Model.model_json_schema()
+    assert schema["properties"]["attr"]["type"] == "string"
+    regex_str = schema["properties"]["attr"]["pattern"]
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
+
+    regex_str = to_regex(types.credit_card)
+    does_match = re.fullmatch(regex_str, test_string) is not None
+    assert does_match is should_match
