+def get_current_environment() -> t.Optional["Environment"]:
+    """Get the current environment from thread-local storage."""
+    import threading
+    return getattr(threading.current_thread(), "_jinja2_env", None)
+
+
+def set_translation_cache_partition(value: t.Hashable) -> None:
+    """Set the translation cache partition and clear old entries.
+    
+    Applications whose translation result depends on locale or request state
+    must give each such state a distinct partition.
+    """
+    env = get_current_environment()
+    if env is not None:
+        env._translation_cache_partition = value
+        if hasattr(env, "_translation_cache"):
+            env._translation_cache.clear()
+
+
+def clear_translation_cache() -> None:
+    """Clear all translation cache entries."""
+    env = get_current_environment()
+    if env is not None and hasattr(env, "_translation_cache"):
+        env._translation_cache.clear()
+
+
+def resize_translation_cache(capacity: int) -> None:
+    """Resize the translation cache to a new capacity.
+    
+    A capacity of zero disables and clears the cache.
+    Invalid capacities raise ValueError.
+    """
+    if capacity < 0:
+        raise ValueError("cache capacity must be non-negative")
+    
+    env = get_current_environment()
+    if env is not None:
+        env._translation_cache_size = capacity
+        if capacity == 0:
+            if hasattr(env, "_translation_cache"):
+                delattr(env, "_translation_cache")
+        else:
+            from .utils import LRUCache
+            env._translation_cache = LRUCache(capacity)
+
+
+class _TranslationCacheManager:
+    """Context manager for setting translation cache partition temporarily."""
+    
+    def __init__(self, partition: t.Hashable):
+        self.partition = partition
+        self.old_partition = None
+    
+    def __enter__(self) -> "_TranslationCacheManager":
+        self.old_partition = getattr(
+            threading.current_thread(), "_jinja2_env", None
+        )
+        if self.old_partition is not None:
+            self.old_partition = getattr(self.old_partition, "_translation_cache_partition", None)
+        return self
+    
+    def __exit__(self, *args):
+        pass  # Partition changes are permanent via set_translation_cache_partition
+
+
