+def _make_cached_gettext(
+    gettext: t.Callable[[str], str],
+    func_name: str,
+    env: "Environment",
+) -> t.Callable[[str], str]:
+    """Wrap gettext to use the translation cache."""
+    
+    def cached_gettext(message: str) -> str:
+        # Look up cache and partition at call time, not wrap time
+        cache = getattr(env, "_translation_cache", None)
+        partition = getattr(env, "_translation_cache_partition", None)
+        
+        if cache is None:
+            return gettext(message)
+        
+        key = (func_name, partition, message)
+        
+        try:
+            return cache[key]
+        except KeyError:
+            result = gettext(message)
+            cache[key] = result
+            return result
+    
+    return cached_gettext
+
+
