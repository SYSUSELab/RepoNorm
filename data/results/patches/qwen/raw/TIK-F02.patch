+    // Helper function to convert byte offset to character index
+    fn byte_offset_to_char_index(text: &str, byte_offset: usize) -> usize {
+        // Find the character at the given byte offset
+        // This handles multi-byte UTF-8 characters correctly
+        text.char_indices()
+            .find(|(i, _)| *i == byte_offset)
+            .map(|(i, _)| i)
+            .unwrap_or_else(|| text.len())
+    }
+
+    pub fn encode_with_positions(&self, text: &str, allowed_special: &HashSet<&str>) -> (Vec<Rank>, Vec<usize>) {
+        let special_regex = self._get_tl_special_regex();
+        let regex = self._get_tl_regex();
+        let mut ret = vec![];
+        let mut positions = vec![];
+
+        let mut start = 0;
+        loop {
+            let mut next_special;
+            let mut start_find = start;
+            loop {
+                // Find the next allowed special token, if any
+                next_special = special_regex.find_from_pos(text, start_find).unwrap();
+                match next_special {
+                    Some(m) => {
+                        if allowed_special.contains(&text[m.start()..m.end()]) {
+                            break;
+                        }
+                        start_find = m.start() + 1;
+                    }
+                    None => break,
+                }
+            }
+            let end = next_special.map_or(text.len(), |m| m.start());
+
+            // Process regular text pieces
+            for mat in regex.find_iter(&text[start..end]) {
+                let mat = mat.unwrap();
+                let piece = mat.as_str().as_bytes();
+                let piece_start_byte = start + mat.start();
+                
+                if let Some(token) = self.encoder.get(piece) {
+                    // Direct match - use the character index of the start of the piece
+                    let char_idx = Self::byte_offset_to_char_index(text, piece_start_byte);
+                    ret.push(*token);
+                    positions.push(char_idx);
+                    continue;
+                }
+                
+                // BPE encode the piece
+                let merged = _byte_pair_merge(&self.encoder, piece);
+                for (i, &(start_byte, _)) in merged[..merged.len() - 1].iter().enumerate() {
+                    let end_byte = merged[i + 1].0;
+                    let token = self.encoder[&piece[start_byte..end_byte]];
+                    
+                    // Convert byte offset to character index
+                    let char_idx = Self::byte_offset_to_char_index(text, piece_start_byte + start_byte);
+                    ret.push(token);
+                    positions.push(char_idx);
+                }
+            }
+
+            match next_special {
+                // Handle special tokens
+                Some(m) => {
+                    let piece = m.as_str();
+                    let token = self.special_tokens_encoder[piece];
+                    let char_idx = Self::byte_offset_to_char_index(text, m.start());
+                    ret.push(token);
+                    positions.push(char_idx);
+                    start = m.end();
+                }
+                None => break,
+            }
+        }
+
+        (ret, positions)
+    }
