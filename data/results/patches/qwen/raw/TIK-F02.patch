+        for mat in regex.find_iter(text) {
+            let mat = mat.unwrap();
+            let piece = mat.as_str().as_bytes();
+            let piece_start_byte = mat.start();
+            
+            if let Some(token) = self.encoder.get(piece) {
+                // Direct match - use the character index of the start of the piece
+                let char_idx = Self::byte_offset_to_char_index(text, piece_start_byte);
+                ret.push(*token);
+                positions.push(char_idx);
+                continue;
+            }
+            
+            // BPE encode the piece
+            let merged = _byte_pair_merge(&self.encoder, piece);
+            for (i, &(start_byte, _)) in merged[..merged.len() - 1].iter().enumerate() {
+                let end_byte = merged[i + 1].0;
+                let token = self.encoder[&piece[start_byte..end_byte]];
+                
+                // Convert byte offset to character index
+                let char_idx = Self::byte_offset_to_char_index(text, piece_start_byte + start_byte);
+                ret.push(token);
+                positions.push(char_idx);
+            }
+        }
+
+        (ret, positions)
+    }
