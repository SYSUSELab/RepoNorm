+    #[pyo3(name = "encode_with_positions")]
+    fn py_encode_with_positions(
+        &self,
+        py: Python,
+        text: &str,
+        allowed_special: HashSet<PyBackedStr>,
+    ) -> (Vec<Rank>, Vec<usize>) {
+        py.allow_threads(|| {
+            let allowed_special: HashSet<&str> =
+                allowed_special.iter().map(|s| s.as_ref()).collect();
+            self.encode_with_positions(text, &allowed_special)
+        })
+    }
+
+    #[pyo3(name = "encode_ordinary_with_positions")]
+    fn py_encode_ordinary_with_positions(&self, py: Python, text: &str) -> (Vec<Rank>, Vec<usize>) {
+        py.allow_threads(|| self.encode_ordinary_with_positions(text))
+    }
