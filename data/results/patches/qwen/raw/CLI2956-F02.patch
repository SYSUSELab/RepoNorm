+++ b/test_validators.py
@@ -0,0 +1,178 @@
+import click
+from click.testing import CliRunner
+
+# Test 1: Basic validator functionality
+def test_basic_validator():
+    @click.command()
+    @click.option("--value", type=int, validators=[lambda ctx, param, v: v * 2])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--value", "5"])
+    print("Test 1 - Basic validator:")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=10" in result.output
+    print("  PASSED\n")
+
+# Test 2: Multiple validators chained
+def test_multiple_validators():
+    @click.command()
+    @click.option("--value", type=int, validators=[
+        lambda ctx, param, v: v + 1,
+        lambda ctx, param, v: v * 2,
+        lambda ctx, param, v: v - 3
+    ])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--value", "5"])
+    print("Test 2 - Multiple validators (5 -> 6 -> 12 -> 9):")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=9" in result.output
+    print("  PASSED\n")
+
+# Test 3: Validator that raises BadParameter
+def test_validator_exception():
+    @click.command()
+    @click.option("--value", type=int, validators=[
+        lambda ctx, param, v: v if v >= 0 else (_ for _ in ()).throw(click.BadParameter("Value must be positive"))
+    ])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--value", "-5"])
+    print("Test 3 - Validator exception:")
+    print(f"  Exit code: {result.exit_code}")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code != 0
+    assert "Value must be positive" in result.output
+    print("  PASSED\n")
+
+# Test 4: Empty validators list should work
+def test_empty_validators():
+    @click.command()
+    @click.option("--value", type=int, validators=[])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--value", "5"])
+    print("Test 4 - Empty validators:")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=5" in result.output
+    print("  PASSED\n")
+
+# Test 5: None validators should work
+def test_none_validators():
+    @click.command()
+    @click.option("--value", type=int, validators=None)
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--value", "5"])
+    print("Test 5 - None validators:")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=5" in result.output
+    print("  PASSED\n")
+
+# Test 6: Non-callable in validators should raise TypeError
+def test_non_callable_validator():
+    try:
+        click.Option(["--value"], validators=["not callable"])
+        print("Test 6 - Non-callable validator: FAILED (should have raised TypeError)")
+    except TypeError as e:
+        print("Test 6 - Non-callable validator:")
+        print(f"  Raised TypeError: {e}")
+        print("  PASSED\n")
+
+# Test 7: Validators with callback
+def test_validators_with_callback():
+    def callback(ctx, param, value):
+        return value * 10
+    
+    @click.command()
+    @click.option("--value", type=int, callback=callback, validators=[
+        lambda ctx, param, v: v + 1
+    ])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--value", "5"])
+    print("Test 7 - Validators with callback (5 -> 50 -> 51):")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=51" in result.output
+    print("  PASSED\n")
+
+# Test 8: Validators with multiple=True
+def test_validators_multiple():
+    @click.command()
+    @click.option("--values", type=int, multiple=True, validators=[
+        lambda ctx, param, v: tuple(x * 2 for x in v)
+    ])
+    def cli(values):
+        click.echo(f"values={values}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--values", "1", "--values", "2", "--values", "3"])
+    print("Test 8 - Validators with multiple=True:")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "values=(2, 4, 6)" in result.output
+    print("  PASSED\n")
+
+# Test 9: Validators with default value
+def test_validators_default():
+    @click.command()
+    @click.option("--value", type=int, default=5, validators=[
+        lambda ctx, param, v: v + 10
+    ])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, [])
+    print("Test 9 - Validators with default (default 5 -> 15):")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=15" in result.output
+    print("  PASSED\n")
+
+# Test 10: Validators with envvar
+def test_validators_envvar():
+    @click.command()
+    @click.option("--value", type=int, envvar="TEST_VALUE", validators=[
+        lambda ctx, param, v: v * 100
+    ])
+    def cli(value):
+        click.echo(f"value={value}")
+    
+    runner = CliRunner()
+    result = runner.invoke(cli, [], env={"TEST_VALUE": "5"})
+    print("Test 10 - Validators with envvar:")
+    print(f"  Output: {result.output.strip()}")
+    assert result.exit_code == 0
+    assert "value=500" in result.output
+    print("  PASSED\n")
+
+if __name__ == "__main__":
+    test_basic_validator()
+    test_multiple_validators()
+    test_validator_exception()
+    test_empty_validators()
+    test_none_validators()
+    test_non_callable_validator()
+    test_validators_with_callback()
+    test_validators_multiple()
+    test_validators_default()
+    test_validators_envvar()
+    print("All tests passed!")
