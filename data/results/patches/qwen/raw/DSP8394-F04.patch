+def test_cache_stats_initialization(cache):
+    """Test that cache stats are initialized to zero."""
+    stats = cache.stats()
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+
+
+def test_cache_stats_memory_hit(cache):
+    """Test that memory hits increment the correct counters."""
+    request = {"prompt": "Hello", "model": "openai/gpt-4o-mini"}
+    value = DummyResponse(message="Test response", usage={})
+    
+    cache.put(request, value)
+    
+    # First get should be a memory hit
+    result = cache.get(request)
+    stats = cache.stats()
+    
+    assert stats["mem_hits"] == 1
+    assert stats["hits"] == 1
+    assert stats["misses"] == 0
+
+
+def test_cache_stats_disk_hit(cache):
+    """Test that disk hits increment the correct counters."""
+    request = {"prompt": "Hello", "model": "openai/gpt-4o-mini"}
+    value = DummyResponse(message="Test response", usage={})
+    
+    cache.put(request, value)
+    
+    # Clear memory cache to force disk read
+    cache.reset_memory_cache()
+    
+    # Get from disk (should be disk hit)
+    result = cache.get(request)
+    stats = cache.stats()
+    
+    assert stats["disk_hits"] == 1
+    assert stats["hits"] == 1
+    assert stats["mem_hits"] == 0
+
+
+def test_cache_stats_miss(cache):
+    """Test that misses increment the miss counter."""
+    request = {"prompt": "Non-existent", "model": "gpt-4"}
+    
+    # Get non-existent key (should be miss)
+    result = cache.get(request)
+    stats = cache.stats()
+    
+    assert stats["misses"] == 1
+    assert stats["hits"] == 0
+
+
+def test_cache_stats_reset(cache):
+    """Test that reset_stats clears counters without clearing entries."""
+    request = {"prompt": "Hello", "model": "openai/gpt-4o-mini"}
+    value = DummyResponse(message="Test response", usage={})
+    
+    cache.put(request, value)
+    cache.get(request)  # Memory hit
+    
+    # Reset stats
+    cache.reset_stats()
+    
+    # Stats should be zero
+    stats = cache.stats()
+    assert stats == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+    
+    # But entry should still exist
+    result = cache.get(request)
+    assert result is not None
+    assert result.message == "Test response"
+
+
+def test_cache_stats_fresh_dict(cache):
+    """Test that stats returns a fresh dictionary that can be mutated without affecting stored counters."""
+    cache.reset_stats()
+    
+    stats1 = cache.stats()
+    original_hits = stats1["hits"]
+    
+    # Try to mutate the returned dict
+    stats1["hits"] = 999
+    
+    # Get stats again - should return fresh dict with original values
+    stats2 = cache.stats()
+    assert stats2["hits"] == original_hits
+
+
+def test_cache_stats_hits_equals_mem_plus_disk(cache):
+    """Test that hits equals mem_hits plus disk_hits."""
+    request1 = {"prompt": "Memory test", "model": "openai/gpt-4o-mini"}
+    request2 = {"prompt": "Disk test", "model": "openai/gpt-4o-mini"}
+    
+    cache.put(request1, DummyResponse(message="Memory", usage={}))
+    cache.put(request2, DummyResponse(message="Disk", usage={}))
+    
+    # Clear memory to force disk read
+    cache.reset_memory_cache()
+    
+    # Get from disk
+    cache.get(request2)
+    
+    # Get from memory (promoted during disk read)
+    cache.get(request2)
+    
+    # Get fresh from memory
+    cache.get(request1)
+    
+    stats = cache.stats()
+    assert stats["hits"] == stats["mem_hits"] + stats["disk_hits"]
+
+
+def test_cache_stats_concurrent_access():
+    """Test that concurrent access doesn't mix counts."""
+    import threading
+    
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="/tmp/test_cache",
+        disk_size_limit_bytes=0,
+        memory_max_entries=100,
+    )
+    
+    errors = []
+    
+    def worker(worker_id):
+        try:
+            for i in range(10):
+                cache.put({"worker": worker_id, "key": i}, {"value": i})
+            # Read back all keys
+            for i in range(10):
+                cache.get({"worker": worker_id, "key": i})
+        except Exception as e:
+            errors.append(e)
+    
+    threads = []
+    for i in range(5):
+        t = threading.Thread(target=worker, args=(i,))
+        threads.append(t)
+        t.start()
+    
+    for t in threads:
+        t.join()
+    
+    if errors:
+        pytest.fail(f"Errors occurred during concurrent access: {errors}")
+    
+    stats = cache.stats()
+    # Should have 5 workers * 10 reads = 50 mem_hits
+    assert stats["mem_hits"] == 50
+    assert stats["hits"] == 50
+
