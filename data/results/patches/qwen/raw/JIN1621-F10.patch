+    def add_alias(
+        self, alias: str, target: str, environment: t.Optional["Environment"] = None
+    ) -> None:
+        """Add an alias for a template.
+
+        The alias will be resolved to the target template when loading.
+        If the alias already exists, it will be overwritten.
+        If the target does not exist, the alias will still be added but
+        loading via the alias will raise `TemplateNotFound`.
+
+        :param alias: The alias name to use for looking up templates.
+        :param target: The actual template name that the alias points to.
+        :param environment: Optional environment to invalidate cache for.
+        """
+        old_target = self._aliases.get(alias)
+        self._aliases[alias] = target
+        
+        # Notify all registered environments
+        self._notify_environments(alias)
+        
+        # Also invalidate the old alias if it existed and changed
+        if old_target is not None and old_target != target:
+            self._notify_environments(old_target)
+
+    def remove_alias(
+        self, alias: str, environment: t.Optional["Environment"] = None
+    ) -> None:
+        """Remove an alias.
+
+        If the alias does not exist, this method does nothing.
+
+        :param alias: The alias name to remove.
+        :param environment: Optional environment to invalidate cache for.
+        """
+        if alias in self._aliases:
+            del self._aliases[alias]
+            # Notify all registered environments
+            self._notify_environments(alias)
+
+    def _resolve_alias(self, name: str) -> str:
+        """Resolve an alias to its target template name.
+
+        If the name is an alias, return the target. Otherwise, return the
+        original name unchanged.
+
+        :param name: The template name to resolve.
+        :return: The resolved template name.
+        """
+        return self._aliases.get(name, name)
+
+    def _invalidate_alias(self, alias: str, environment: "Environment") -> None:
+        """Invalidate a cached template associated with an alias.
+
+        When an alias is added, removed, or modified, any cached templates
+        that were loaded via that alias should be invalidated so that
+        subsequent requests observe the update.
+
+        :param alias: The alias that was modified.
+        :param environment: The environment whose cache should be invalidated.
+        """
+        if environment.cache is not None:
+            loader_ref = weakref.ref(self)
+            cache_key = (loader_ref, alias)
+            if cache_key in environment.cache:
+                del environment.cache[cache_key]
+
+    def _register_environment(self, environment: "Environment") -> None:
+        """Register an environment with this loader.
+
+        :param environment: The environment to register.
+        """
+        self._environments.add(environment)
+
+    def _unregister_environment(self, environment: "Environment") -> None:
+        """Unregister an environment from this loader.
+
+        :param environment: The environment to unregister.
+        """
+        self._environments.discard(environment)
+
+    def _notify_environments(self, alias: str) -> None:
+        """Notify all registered environments about an alias change.
+
+        :param alias: The alias that was changed.
+        """
+        for env in list(self._environments):
+            self._invalidate_alias(alias, env)
+
+    def list_templates(self) -> t.List[str]:
+        """Iterates over all templates.  If the loader does not support that
+        it should raise a :exc:`TypeError` which is the default behavior.
+        """
+        raise TypeError("this loader cannot iterate over all templates")
+
 
