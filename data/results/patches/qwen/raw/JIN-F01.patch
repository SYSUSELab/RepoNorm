diff --git a/tests/test_async_filters.py b/tests/test_async_filters.py
index 5d4f332..8a9c673 100644
--- a/tests/test_async_filters.py
+++ b/tests/test_async_filters.py
@@ -251,3 +251,36 @@ def test_custom_async_iteratable_filter(env_async, items):
     )
     out = tmpl.render(items=items)
     assert out == "0,1,2 .. 3,4,5"
+
+
+@mark_dualiter("users", lambda: [
+    {"name": "Alice", "city": "NY"},
+    {"name": "Bob", "city": "ny"},
+    {"name": "Charlie", "city": "NYC"},
+    {"name": "David", "city": "nyc"},
+])
+def test_groupby_case_sensitive(env_async, users):
+    """Test case_sensitive parameter for async groupby."""
+    # Default is case-insensitive (case_sensitive=False)
+    tmpl = env_async.from_string(
+        "{% for city, items in users()|groupby('city') %}"
+        "{{ city }}: {{ items|map(attribute='name')|join(', ') }}\n"
+        "{% endfor %}"
+    )
+    out = tmpl.render(users=users)
+    assert out == "NY: Alice, Bob\nNYC: Charlie, David\n"
+
+    # Case-sensitive grouping
+    tmpl_cs = env_async.from_string(
+        "{% for city, items in users()|groupby('city', case_sensitive=True) %}"
+        "{{ city }}: {{ items|map(attribute='name')|join(', ') }}\n"
+        "{% endfor %}"
+    )
+    out_cs = tmpl_cs.render(users=users)
+    lines = sorted(out_cs.strip().split("\n"))
+    assert lines == [
+        "NY: Alice",
+        "NYC: Charlie",
+        "ny: Bob",
+        "nyc: David",
+    ]
diff --git a/tests/test_filters.py b/tests/test_filters.py
index 43ddf59..d224d58 100644
--- a/tests/test_filters.py
+++ b/tests/test_filters.py
@@ -852,3 +852,76 @@ class TestFilter:
         with pytest.raises(TemplateRuntimeError, match="No filter named 'f'"):
             t1.render(x=42)
             t2.render(x=42)
+
+    def test_groupby_case_sensitive(self, env):
+        """Test case_sensitive parameter for groupby."""
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city') %}"
+            "{{ city }}: {{ items|map(attribute='name')|join(', ') }}\n"
+            "{% endfor %}"
+        )
+        # Default is case-insensitive (case_sensitive=False)
+        out = tmpl.render(
+            users=[
+                {"name": "Alice", "city": "NY"},
+                {"name": "Bob", "city": "ny"},
+                {"name": "Charlie", "city": "NYC"},
+                {"name": "David", "city": "nyc"},
+            ]
+        )
+        assert out == "NY: Alice, Bob\nNYC: Charlie, David\n"
+
+        # Case-sensitive grouping
+        tmpl_cs = env.from_string(
+            "{% for city, items in users|groupby('city', case_sensitive=True) %}"
+            "{{ city }}: {{ items|map(attribute='name')|join(', ') }}\n"
+            "{% endfor %}"
+        )
+        out_cs = tmpl_cs.render(
+            users=[
+                {"name": "Alice", "city": "NY"},
+                {"name": "Bob", "city": "ny"},
+                {"name": "Charlie", "city": "NYC"},
+                {"name": "David", "city": "nyc"},
+            ]
+        )
+        # With case_sensitive=True, each case variant is a separate group
+        lines = sorted(out_cs.strip().split("\n"))
+        assert lines == [
+            "NY: Alice",
+            "NYC: Charlie",
+            "ny: Bob",
+            "nyc: David",
+        ]
+
+    def test_groupby_case_sensitive_with_default(self, env):
+        """Test case_sensitive with default parameter."""
+        tmpl = env.from_string(
+            "{% for city, items in users|groupby('city', default='Unknown', case_sensitive=True) %}"
+            "{{ city }}: {{ items|map(attribute='name')|join(', ') }}\n"
+            "{% endfor %}"
+        )
+        out = tmpl.render(
+            users=[
+                {"name": "Emma", "city": "NY"},
+                {"name": "John"},  # Missing city attribute
+            ]
+        )
+        assert out == "NY: Emma\nUnknown: John\n"
+
+    def test_groupby_case_sensitive_non_string_keys(self, env):
+        """Test that non-string keys are not affected by case sensitivity."""
+        tmpl = env.from_string(
+            "{% for key, items in data|groupby('key') %}"
+            "{{ key }}: {{ items|map(attribute='name')|join(', ') }}\n"
+            "{% endfor %}"
+        )
+        out = tmpl.render(
+            data=[
+                {"name": "A", "key": 1},
+                {"name": "B", "key": 2},
+                {"name": "C", "key": 1},
+            ]
+        )
+        # Numeric keys should work normally
+        assert out == "1: A, C\n2: B\n"
