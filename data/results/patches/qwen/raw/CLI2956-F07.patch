+    def _check_conflicts(self, ctx: Context) -> None:
+        """Check for conflicting options that were both explicitly provided."""
+        # Build a mapping of param names to their sources
+        explicit_sources: dict[str, ParameterSource] = {}
+        for name, source in ctx._parameter_source.items():
+            if source in (ParameterSource.COMMANDLINE, ParameterSource.PROMPT):
+                explicit_sources[name] = source
+
+        # Find all Option params with conflicts_with defined
+        for param in self.get_params(ctx):
+            if not isinstance(param, Option):
+                continue
+            if not param._conflicts_with:
+                continue
+
+            # Check each conflicting option
+            for conflict_name in param._conflicts_with:
+                # Normalize conflict name: replace dashes with underscores and lowercase
+                normalized_conflict = conflict_name.replace("-", "_").lower()
+                
+                # First, check if the conflict name is unknown (not defined as any option)
+                conflict_param = None
+                for p in self.get_params(ctx):
+                    if isinstance(p, Option) and p.name == normalized_conflict:
+                        conflict_param = p
+                        break
+
+                if conflict_param is None:
+                    # Unknown option name - raise error if the referencing option is provided
+                    if param.name in explicit_sources:
+                        raise UsageError(
+                            f"Option {param.opts[0]!r} cannot be used together with "
+                            f"unknown option {conflict_name!r}."
+                        )
+                    continue
+
+                # Now check if both options were explicitly provided
+                if param.name not in explicit_sources:
+                    continue
+                if normalized_conflict not in explicit_sources:
+                    continue
+                # Both options were explicitly provided - raise error
+                # Get the actual option strings for the error message
+                first_opt = param.opts[0] if param.opts else f"--{param.name}"
+                second_opt = conflict_param.opts[0] if conflict_param.opts else f"--{normalized_conflict}"
+
+                raise UsageError(
+                    f"Option {first_opt!r} cannot be used together with "
+                    f"{second_opt!r}."
+                )
+
