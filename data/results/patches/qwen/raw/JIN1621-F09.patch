+class _FileSystemLoaderMonitor:
+    """Background monitor for FileSystemLoader that proactively invalidates
+    template caches when files are modified, deleted, or added.
+    """
+
+    def __init__(self, loader: "FileSystemLoader") -> None:
+        self.loader = loader
+        self._thread: t.Optional[threading.Thread] = None
+        self._stop_event = threading.Event()
+        self._environments: t.List[weakref.ref] = []
+        self._lock = threading.Lock()
+        self._last_scan: t.Dict[str, float] = {}
+
+    def start(self) -> None:
+        """Start the monitoring thread. Idempotent - safe to call multiple times."""
+        if self._thread is not None and self._thread.is_alive():
+            return
+        
+        self._stop_event.clear()
+        self._thread = threading.Thread(
+            target=self._run, daemon=True, name="jinja2_fsloader_monitor"
+        )
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Stop the monitoring thread. Idempotent - safe to call multiple times."""
+        self._stop_event.set()
+        if self._thread is not None:
+            self._thread.join(timeout=1.0)
+            self._thread = None
+
+    def _run(self) -> None:
+        """Main loop for the monitoring thread."""
+        while not self._stop_event.is_set():
+            try:
+                self.scan_once()
+            except Exception:
+                # Background filesystem errors do not terminate the monitor
+                pass
+            
+            # Wait for the next interval (0.5 seconds) or stop event
+            self._stop_event.wait(0.5)
+
+    def add_environment(self, environment: "Environment") -> None:
+        """Add an environment to be tracked."""
+        with self._lock:
+            ref = weakref.ref(environment)
+            if ref not in self._environments:
+                self._environments.append(ref)
+
+    def remove_environments(self) -> None:
+        """Remove dead environment references."""
+        with self._lock:
+            self._environments = [ref for ref in self._environments if ref() is not None]
+
+    def scan_once(self) -> t.List[str]:
+        """Perform a synchronous comparison and invalidate changed entries.
+        
+        Returns canonical /-separated template names that were invalidated.
+        """
+        self.remove_environments()
+        
+        # Get current state of all templates
+        current_state = self._get_current_state()
+        
+        invalidated = []
+        
+        # Check for deleted templates
+        for name, mtime in list(self._last_scan.items()):
+            if name not in current_state:
+                self._invalidate_template(name)
+                invalidated.append(name)
+        
+        # Check for modified templates
+        for name, new_mtime in current_state.items():
+            old_mtime = self._last_scan.get(name)
+            if old_mtime is not None and old_mtime != new_mtime:
+                self._invalidate_template(name)
+                invalidated.append(name)
+        
+        # Update last scan state
+        self._last_scan = current_state
+        
+        return invalidated
+    
+    def _get_current_state(self) -> t.Dict[str, float]:
+        """Get current mtime for all templates."""
+        state = {}
+        for searchpath in self.loader.searchpath:
+            walk_dir = os.walk(searchpath, followlinks=self.loader.followlinks)
+            for dirpath, _, filenames in walk_dir:
+                for filename in filenames:
+                    full_path = os.path.join(dirpath, filename)
+                    try:
+                        mtime = os.path.getmtime(full_path)
+                        # Convert to canonical template name
+                        rel_path = os.path.relpath(full_path, searchpath)
+                        template_name = (
+                            rel_path.replace(os.path.sep, "/")
+                            .lstrip("./")
+                        )
+                        state[template_name] = mtime
+                    except OSError:
+                        pass
+        return state
+    
+    def _invalidate_template(self, name: str) -> None:
+        """Invalidate a template in all tracked environments."""
+        with self._lock:
+            for ref in self._environments:
+                env = ref()
+                if env is not None and env.cache is not None:
+                    cache_key = (weakref.ref(self.loader), name)
+                    if cache_key in env.cache:
+                        del env.cache[cache_key]
+
