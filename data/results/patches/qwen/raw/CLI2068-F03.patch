+def _create_backup(filename: str) -> None:
+    """Create a backup of the given file.
+
+    The backup file is named ``{filename}.backup.YYYYMMDD_HHMMSS``.
+    If a backup file with the same name already exists, a collision suffix
+    will be added.
+
+    :raises ClickException: if the backup cannot be created.
+    """
+    if not os.path.isfile(filename):
+        return
+
+    timestamp = time.strftime("%Y%m%d_%H%M%S")
+    base_name = f"{filename}.backup.{timestamp}"
+
+    # Handle collisions by adding a suffix
+    backup_path = base_name
+    counter = 1
+    while os.path.exists(backup_path):
+        backup_path = f"{base_name}.{counter}"
+        counter += 1
+
+    try:
+        shutil.copy2(filename, backup_path)
+    except OSError as e:
+        raise ClickException(f"Failed to create backup file: {e}") from e
+
