@@ -0,0 +1,174 @@
+"""Test grammar validation policy for XGrammar backend."""
+import unittest
+from unittest.mock import MagicMock, patch
+import sys
+
+
+class TestGrammarValidationPolicy(unittest.TestCase):
+    """Test cases for grammar validation policy."""
+
+    def setUp(self):
+        """Set up test fixtures."""
+        # Create mock transformers model components
+        self.mock_transformers_model = MagicMock()
+        self.mock_transformers_model.config._name_or_path = "test-model"
+        
+        self.mock_tokenizer = MagicMock()
+        self.mock_tokenizer.padding_side = None
+        
+        # Import Transformers class and create mock instance
+        from outlines.models.transformers import Transformers
+        self.model = Transformers(self.mock_transformers_model, self.mock_tokenizer)
+        
+        # Mock xgrammar module - patch at the actual import location
+        self.mock_xgr = MagicMock()
+        self.mock_tokenizer_info = MagicMock()
+        self.mock_grammar_compiler = MagicMock()
+        
+        # Configure mock tokenizer info to have vocab_size attribute
+        type(self.mock_tokenizer_info).vocab_size = 1000
+        
+        self.mock_xgr.TokenizerInfo.from_huggingface.return_value = self.mock_tokenizer_info
+        self.mock_xgr.GrammarCompiler.return_value = self.mock_grammar_compiler
+        
+        # Setup compiler mocks
+        self.mock_json_schema = MagicMock()
+        self.mock_regex = MagicMock()
+        self.mock_cfg = MagicMock()
+        self.mock_grammar_compiler.compile_json_schema.return_value = self.mock_json_schema
+        self.mock_grammar_compiler.compile_regex.return_value = self.mock_regex
+        self.mock_grammar_compiler.compile_cfg.return_value = self.mock_cfg
+        
+        # Patch AutoConfig from_pretrained at transformers module level
+        self.patch_autocfg = patch('transformers.AutoConfig')
+        self.mock_autocfg = self.patch_autocfg.start()
+        self.mock_config = MagicMock()
+        self.mock_config.vocab_size = 1000
+        self.mock_autocfg.from_pretrained.return_value = self.mock_config
+        
+        # Replace xgrammar in sys.modules BEFORE importing XGrammarBackend
+        sys.modules['xgrammar'] = self.mock_xgr
+        
+        # Now import AFTER setting up patches
+        from outlines.backends.xgrammar import XGrammarBackend
+        self.XGrammarBackend = XGrammarBackend
+
+    def tearDown(self):
+        """Clean up patches."""
+        self.patch_autocfg.stop()
+        if 'xgrammar' in sys.modules:
+            del sys.modules['xgrammar']
+
+    def test_backend_without_validation(self):
+        """Test backend without validation callback."""
+        backend = self.XGrammarBackend(self.model)
+        self.assertIsNone(backend.validate_grammar)
+        
+        # Should be able to create processor without validation
+        processor = backend.get_json_schema_logits_processor('{"type": "object"}')
+        self.assertIsNotNone(processor)
+
+    def test_backend_with_validation_callback(self):
+        """Test backend with validation callback."""
+        my_validator = MagicMock(return_value=True)
+        backend = self.XGrammarBackend(self.model, validate_grammar=my_validator)
+        self.assertEqual(backend.validate_grammar, my_validator)
+        
+        # Should call validator when creating processor
+        processor = backend.get_json_schema_logits_processor('{"type": "object"}')
+        self.assertIsNotNone(processor)
+        my_validator.assert_called_once_with('{"type": "object"}')
+
+    def test_explicit_none_overrides_default(self):
+        """Test explicit None disables validation for specific request."""
+        my_validator = MagicMock(return_value=True)
+        backend = self.XGrammarBackend(self.model, validate_grammar=my_validator)
+        
+        # Without override, should use default
+        processor1 = backend.get_json_schema_logits_processor('{"type": "object"}')
+        my_validator.assert_called_once_with('{"type": "object"}')
+        
+        # With explicit None, should not call validator
+        my_validator.reset_mock()
+        processor2 = backend.get_json_schema_logits_processor(
+            '{"type": "string"}', 
+            validate_grammar=None
+        )
+        self.assertIsNotNone(processor2)
+        my_validator.assert_not_called()
+
+    def test_false_return_value(self):
+        """Test that False return value means validation completed."""
+        def my_validator(grammar: str) -> bool:
+            return False  # Invalid grammar but still completes
+        
+        backend = self.XGrammarBackend(self.model, validate_grammar=my_validator)
+        
+        # Should complete even with False return
+        processor = backend.get_json_schema_logits_processor('invalid')
+        self.assertIsNotNone(processor)
+
+    def test_exception_propagation(self):
+        """Test that exceptions during validation are propagated."""
+        def my_validator(grammar: str) -> bool:
+            raise ValueError("Invalid grammar")
+        
+        backend = self.XGrammarBackend(self.model, validate_grammar=my_validator)
+        
+        # Exception should propagate
+        with self.assertRaises(ValueError) as context:
+            backend.get_json_schema_logits_processor('invalid')
+        
+        self.assertIn("Invalid grammar", str(context.exception))
+        
+        # Backend should still work for other requests
+        def good_validator(grammar: str) -> bool:
+            return True
+        
+        backend.validate_grammar = good_validator
+        processor = backend.get_json_schema_logits_processor('{"type": "object"}')
+        self.assertIsNotNone(processor)
+
+    def test_independent_backend_instances(self):
+        """Test that different backend instances don't affect each other."""
+        validator_a = MagicMock(return_value=True)
+        validator_b = MagicMock(return_value=False)
+        
+        backend_a = self.XGrammarBackend(self.model, validate_grammar=validator_a)
+        backend_b = self.XGrammarBackend(self.model, validate_grammar=validator_b)
+        
+        # Each backend uses its own validator
+        processor_a = backend_a.get_json_schema_logits_processor('{"type": "object"}')
+        self.assertIsNotNone(processor_a)
+        validator_a.assert_called_once_with('{"type": "object"}')
+        validator_b.assert_not_called()
+        
+        processor_b = backend_b.get_json_schema_logits_processor('{"type": "string"}')
+        self.assertIsNotNone(processor_b)
+        validator_b.assert_called_once_with('{"type": "string"}')
+        validator_a.assert_called_once_with('{"type": "object"}')
+
+    def test_regex_processor_validation(self):
+        """Test validation works for regex processor."""
+        my_validator = MagicMock(return_value=True)
+        backend = self.XGrammarBackend(self.model, validate_grammar=my_validator)
+        
+        processor = backend.get_regex_logits_processor(r'^[a-z]+$')
+        self.assertIsNotNone(processor)
+        my_validator.assert_called_once_with(r'^[a-z]+$')
+
+    def test_cfg_processor_validation(self):
+        """Test validation works for CFG processor."""
+        my_validator = MagicMock(return_value=True)
+        backend = self.XGrammarBackend(self.model, validate_grammar=my_validator)
+        
+        cfg = '''
+        root ::= "hello"
+        '''
+        processor = backend.get_cfg_logits_processor(cfg)
+        self.assertIsNotNone(processor)
+        my_validator.assert_called_once_with(cfg)
+
+
+if __name__ == '__main__':
+    unittest.main()
