+    def _generate_cache_salt(self, pred_i, demo_set_i):
+        """Generate a nonempty ASCII cache salt for distinguishing proposals.
+        
+        The salt is generated using the RNG to ensure reproducibility with the same seed.
+        Each proposal gets a distinct salt based on its position (pred_i, demo_set_i).
+        """
+        # Use the RNG to generate a reproducible salt string
+        # We'll use a simple approach: generate random hex-like characters
+        salt_length = 16
+        chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
+        salt_chars = []
+        for _ in range(salt_length):
+            idx = self.rng.randint(0, len(chars) - 1)
+            salt_chars.append(chars[idx])
+        return "".join(salt_chars)
