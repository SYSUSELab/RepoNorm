+def test_nested_namespace_contexts(cache_config, tmp_path):
+    """Test nested namespace contexts restore prior state."""
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="",
+        namespace="outer_ns"
+    )
+    
+    # Outer context
+    with cache.namespace("middle_ns"):
+        assert cache.namespace.value == "middle_ns"
+        
+        # Inner context
+        with cache.namespace("inner_ns"):
+            assert cache.namespace.value == "inner_ns"
+        
+        # Back to middle after inner exits
+        assert cache.namespace.value == "middle_ns"
+    
+    # Back to outer after outer exits
+    assert cache.namespace.value == "outer_ns"
+
+
+def test_namespace_exception_restoration(cache_config, tmp_path):
+    """Test that namespace is restored even when exception occurs."""
+    cache = Cache(
