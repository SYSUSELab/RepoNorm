+def test_namespace_initialization(cache_config, tmp_path):
+    """Test cache initialization with namespace."""
+    # Test with namespace
+    cache_with_ns = Cache(
+        **cache_config,
+        namespace="test_namespace"
+    )
+    assert cache_with_ns.namespace.value == "test_namespace"
+    
+    # Test without namespace (None)
+    cache_without_ns = Cache(
+        **cache_config,
+        namespace=None
+    )
+    assert cache_without_ns.namespace.value is None
+    
+    # Test with empty string namespace
+    cache_empty_ns = Cache(
+        **cache_config,
+        namespace=""
+    )
+    assert cache_empty_ns.namespace.value == ""
+
