+def test_namespace_context_manager(cache_config, tmp_path):
+    """Test namespace context manager."""
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="",
+        namespace="original_ns"
+    )
+    
+    # Test context manager
+    with cache.namespace("temp_ns"):
+        assert cache.namespace.value == "temp_ns"
+    
+    # After context, should be back to original
+    assert cache.namespace.value == "original_ns"
+
