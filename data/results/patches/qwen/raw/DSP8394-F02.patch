+def test_cache_isolation_between_namespaces(cache_config, tmp_path):
+    """Test that different namespaces have isolated caches."""
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="",
+        namespace=None
+    )
+    
+    request = {"prompt": "test"}
+    
+    # Put value with ns1
+    cache.set_namespace("ns1")
+    cache.put(request, {"data": "value_from_ns1"})
+    
+    # Put value with ns2
+    cache.set_namespace("ns2")
+    cache.put(request, {"data": "value_from_ns2"})
+    
+    # Retrieve from ns1 - should get ns1 value
+    cache.set_namespace("ns1")
+    retrieved = cache.get(request)
+    assert retrieved == {"data": "value_from_ns1"}
+    
+    # Retrieve from ns2 - should get ns2 value
+    cache.set_namespace("ns2")
+    retrieved = cache.get(request)
+    assert retrieved == {"data": "value_from_ns2"}
+    
+    # Retrieve without namespace - should get None
+    cache.set_namespace(None)
+    retrieved = cache.get(request)
+    assert retrieved is None
+
