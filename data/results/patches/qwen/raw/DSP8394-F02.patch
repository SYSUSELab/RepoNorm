+class _NamespaceAccessor:
+    """
+    Namespace accessor for cache operations.
+    
+    Supports:
+    - Comparison with string or None (e.g., ns == "my_ns" or ns is None)
+    - Accessing the current value via .value property
+    - Context manager usage: with cache.namespace("ns"): ...
+    - Assignment: cache.namespace = "ns"
+    """
+    
+    def __init__(self, cache_instance):
+        self._cache = cache_instance
+    
+    @property
+    def value(self) -> Optional[str]:
+        """Get the current namespace value."""
+        return self._cache._get_current_namespace()
+    
+    def __eq__(self, other):
+        """Compare with string or None."""
+        if other is None:
+            return self.value is None
+        if isinstance(other, str):
+            return self.value == other
+        return False
+    
+    def __ne__(self, other):
+        """Not equal comparison."""
+        return not self.__eq__(other)
+    
+    def __repr__(self):
+        return f"_NamespaceAccessor(value={self.value!r})"
+    
+    def set(self, value: Optional[str]) -> None:
+        """Set the namespace for the current context."""
+        self._cache.set_namespace(value)
+    
+    @contextmanager
+    def __call__(self, value: Optional[str]):
+        """Context manager for temporary namespace changes."""
+        old_value = self._cache._get_current_namespace()
+        try:
+            self._cache.set_namespace(value)
+            yield
+        finally:
+            self._cache.set_namespace(old_value)
+
+
+def _validate_namespace(value: Any) -> None:
+    """Validate that namespace is a string or None."""
+    if value is not None and not isinstance(value, str):
+        raise ValueError(f"Namespace must be a string or None, got {type(value).__name__}")
+
+
+def _namespace_to_prefix(namespace: Optional[str]) -> Optional[str]:
+    """Convert namespace to its prefix (first 8 hex chars of SHA-256)."""
+    if namespace is None:
+        return None
+    # Hash the UTF-8 encoded namespace and take first 8 hex characters
+    hash_hex = sha256(namespace.encode('utf-8')).hexdigest()[:8]
+    return hash_hex
+
