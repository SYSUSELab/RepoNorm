+def test_namespace_key_prefixing(cache_config, tmp_path):
+    """Test that namespace prefixes cache keys correctly."""
+    from hashlib import sha256
+    
+    cache = Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir="",
+        namespace="my_namespace"
+    )
+    
+    request = {"prompt": "Hello", "model": "gpt-4"}
+    
+    # Get key with namespace
+    key_with_ns = cache.cache_key(request)
+    
+    # Verify it has the prefix format
+    assert ":" in key_with_ns
+    prefix = key_with_ns.split(":")[0]
+    assert len(prefix) == 8  # First 8 hex chars of SHA-256
+    
+    # Verify the prefix is correct
+    expected_prefix = sha256("my_namespace".encode('utf-8')).hexdigest()[:8]
+    assert prefix == expected_prefix
+    
+    # Now test without namespace
+    cache.set_namespace(None)
+    key_without_ns = cache.cache_key(request)
+    assert ":" not in key_without_ns
+
