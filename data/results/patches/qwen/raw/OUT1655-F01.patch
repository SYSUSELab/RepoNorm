@@ -52,6 +52,26 @@ whitespace = Regex(r"\s")
 sentence = Regex(r"[A-Z].*\s*[.!?]")
 paragraph = Regex(rf"{sentence.pattern}(?:\s+{sentence.pattern})*\n+")
 
+# Hexadecimal string type
+# Contains one or more ASCII hexadecimal digits (0-9, a-f, A-F), optionally
+# preceded by the exact lowercase prefix `0x`. A bare prefix, uppercase `0X`,
+# whitespace, and non-hexadecimal characters are invalid.
+hex_str = Regex(r"(?:0x)?[0-9a-fA-F]+")
+
+# UUID4 type
+# Uses the canonical hyphenated 8-4-4-4-12 UUID layout with ASCII hexadecimal
+# digits. The version nibble is `4`; the variant nibble is one of `8`, `9`,
+# `a`, `A`, `b`, or `B`. Braces, missing hyphens, and surrounding whitespace
+# are invalid.
+uuid4 = Regex(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}")
+
+# IPv4 type
+# Has exactly four dot-separated octets. Each octet has one to three ASCII
+# decimal digits, may contain leading zeroes, and has a numeric value from 0
+# through 255 inclusive. Therefore `00.01.10.99` and `000.001.025.255` are
+# valid, while four-digit octets and numeric values above 255 are invalid.
+ipv4 = Regex(r"(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}")
+
 
