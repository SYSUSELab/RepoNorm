+def extract_json_from_markdown(text: str) -> str | None:
+    """Extract JSON from markdown fenced code blocks.
+    
+    Only considers the first triple-backtick block. The opening fence may have
+    any language label (including json, JSON, or no label), followed by a newline;
+    the next triple-backtick delimiter closes it. Parse the trimmed body as JSON,
+    ignoring surrounding prose.
+    
+    Args:
+        text: The input text that may contain markdown fenced code blocks.
+        
+    Returns:
+        The extracted JSON string if a valid markdown fence is found, otherwise None.
+        
+    Examples:
+        >>> extract_json_from_markdown('```json\n{"key": "value"}\n```')
+        '{"key": "value"}'
+        >>> extract_json_from_markdown('Some text\n```json\n{"key": "value"}\n```\nMore text')
+        '{"key": "value"}'
+        >>> extract_json_from_markdown('Plain JSON without fences')
+        None
+    """
+    # Pattern to match the first markdown code fence anywhere in text
+    # Opening fence: ``` followed by optional language label, then newline
+    # Content: anything until closing fence
+    # Closing fence: ``` at start of line
+    # Use search() without anchors to find first fence anywhere
+    # Non-greedy match for content, then closing fence
+    pattern = r'\`\`\`(?:[a-zA-Z]+)?\n(.*?)\n\`\`\`\s*'
+    match = re.search(pattern, text, re.DOTALL)
+    
+    if match:
+        return match.group(1).strip()
+    
+    # If no markdown fence found, return None
+    return None
+
 
