+            [{'name': 'search', 'args': {'query': 'hello'}}]
+        """
+        import json
+        
+        # If already a list or dict, try to process it directly
+        if isinstance(data, list):
+            return data
+        if isinstance(data, dict):
+            # Single object format - wrap in list
+            return [data]
