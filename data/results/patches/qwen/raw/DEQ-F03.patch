diff --git a/dirty_equals/_email.py b/dirty_equals/_email.py
new file mode 100644
index 0000000..dcee9f4
--- /dev/null
+++ b/dirty_equals/_email.py
@@ -0,0 +1,86 @@
+import re
+from typing import Any, Optional
+
+from ._base import DirtyEquals
+from ._utils import plain_repr
+
+try:
+    from typing import Literal
+except ImportError:
+    from typing_extensions import Literal  # type: ignore[misc]
+
+
+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address.
+
+    This validator uses a deliberately finite grammar for email addresses, not full RFC syntax.
+
+    The local part uses ASCII letters/digits and `_ % + -`, with dots only between nonempty runs
+    (no leading, trailing or consecutive dots). Domain labels use ASCII letters/digits and internal
+    hyphens; labels are nonempty and cannot start or end with a hyphen. There are at least two
+    labels and the final label consists of at least two ASCII letters.
+
+    Args:
+        domain: Optional domain filter. If provided, the email's domain must match exactly
+            (case-sensitive). A subdomain is not an implicit match.
+
+    Examples:
+        ```py title="IsEmail"
+        from dirty_equals import IsEmail
+
+        assert 'test@example.com' == IsEmail
+        assert 'test.email+tag@domain.co.uk' == IsEmail
+        assert 'user_name@test-domain.org' == IsEmail
+
+        assert 'test@example.com' == IsEmail('example.com')
+        assert 'test@sub.example.com' != IsEmail('example.com')  # subdomain doesn't match
+        assert 'test@EXAMPLE.COM' != IsEmail('example.com')  # case-sensitive
+        assert 'invalid' != IsEmail
+        assert 123 != IsEmail
+        ```
+    """
+
+    # Regex pattern for email validation
+    # Local part: ASCII letters/digits and _%+-, dots only between nonempty runs
+    # Domain: labels with ASCII letters/digits and internal hyphens, at least 2 labels,
+    #         final label at least 2 ASCII letters
+    # Label pattern: starts/ends with alphanumeric, can have internal hyphens
+    _LABEL_PATTERN = r'[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?'
+    _EMAIL_PATTERN = re.compile(
+        rf'^[A-Za-z0-9_]+([.%+-][A-Za-z0-9_]+)*@{_LABEL_PATTERN}(?:\.{_LABEL_PATTERN})*\.[A-Za-z]{{2,}}$'
+    )
+
+    def __init__(self, domain: Optional[str] = None):
+        """
+        Args:
+            domain: Optional domain filter. If provided, the email's domain must match exactly
+                (case-sensitive). A subdomain is not an implicit match.
+        """
+        self.domain = domain
+        if domain is None:
+            super().__init__(plain_repr('*'))
+        else:
+            super().__init__(domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Match the entire string without trimming whitespace
+        if not self._EMAIL_PATTERN.match(other):
+            return False
+
+        # If domain filter is provided, check exact match
+        if self.domain is not None:
+            # Extract domain from email (everything after @)
+            try:
+                email_domain = other.split('@', 1)[1]
+            except IndexError:
+                return False
+
+            # Case-sensitive exact match
+            if email_domain != self.domain:
+                return False
+
+        return True
diff --git a/tests/test_email.py b/tests/test_email.py
new file mode 100644
index 0000000..ba8c5fd
--- /dev/null
+++ b/tests/test_email.py
@@ -0,0 +1,104 @@
+"""Tests for IsEmail validator."""
+import pytest
+from dirty_equals import IsEmail, IsStr
+
+
+class TestIsEmail:
+    """Test cases for IsEmail validator."""
+
+    def test_valid_emails(self):
+        """Test various valid email formats."""
+        valid_emails = [
+            'a@b.co',
+            'test@example.com',
+            'user.name@example.com',
+            'user+tag@example.com',
+            'user_name@example.com',
+            'user-name@example.com',
+            'user123@example.com',
+            'test.email+tag@domain.co.uk',
+            'x@sub.domain.com',
+            'test@my-domain.com',
+            'test@sub.my-domain.com',
+        ]
+        for email in valid_emails:
+            assert email == IsEmail()
+
+    def test_invalid_emails(self):
+        """Test invalid email formats."""
+        invalid_emails = [
+            '',  # empty string
+            '@example.com',  # no local part
+            'test@',  # no domain
+            'test',  # no @ symbol
+            'test@.com',  # leading dot in domain
+            'test@domain.',  # trailing dot in domain
+            'test@domain..com',  # consecutive dots
+            '.test@example.com',  # leading dot in local part
+            'test.@example.com',  # trailing dot in local part
+            'test@-domain.com',  # domain starts with hyphen
+            'test@domain-.com',  # domain label ends with hyphen
+            'test@domain.c',  # TLD too short (needs 2+ letters)
+            'test@domain',  # only one domain label
+            'test@domain.c-d',  # TLD has hyphen
+            'test@domain.x-y-z',  # TLD has multiple parts with hyphens
+            'a.b.c@d.e.f',  # TLD .f is only 1 letter
+        ]
+        for email in invalid_emails:
+            assert email != IsEmail()
+
+    def test_non_string_values(self):
+        """Test that non-string values are rejected."""
+        assert None != IsEmail()
+        assert 123 != IsEmail()
+        assert [] != IsEmail()
+        assert {} != IsEmail()
+        assert object() != IsEmail()
+
+    def test_whitespace_handling(self):
+        """Test that whitespace is not trimmed."""
+        assert ' test@example.com' != IsEmail()
+        assert 'test@example.com ' != IsEmail()
+        assert ' test@example.com ' != IsEmail()
+        assert '\ntest@example.com\n' != IsEmail()
+
+    def test_domain_filter(self):
+        """Test domain filtering."""
+        assert 'test@example.com' == IsEmail('example.com')
+        assert 'test@example.com' != IsEmail('EXAMPLE.COM')  # case-sensitive
+        assert 'test@other.com' != IsEmail('example.com')
+        assert 'test@sub.example.com' != IsEmail('example.com')  # subdomain not match
+        assert 'test@example.com' != IsEmail('other.com')
+
+    def test_repr_without_domain(self):
+        """Test repr without domain filter."""
+        assert repr(IsEmail()) == 'IsEmail(*)'
+
+    def test_repr_with_domain(self):
+        """Test repr with domain filter."""
+        assert repr(IsEmail('example.com')) == "IsEmail('example.com')"
+
+    def test_value_property(self):
+        """Test value property access."""
+        # Need to do an equality check first to set _was_equal and _other
+        email_validator = IsEmail()
+        assert 'test@example.com' == email_validator
+        assert email_validator.value == 'test@example.com'
+        
+        email_validator_with_domain = IsEmail('example.com')
+        assert 'test@example.com' == email_validator_with_domain
+        assert email_validator_with_domain.value == 'test@example.com'
+
+    def test_boolean_operators(self):
+        """Test boolean operators."""
+        # OR operator
+        assert 'test@example.com' == IsEmail | IsStr()
+        assert 'test@example.com' == IsStr() | IsEmail()
+        
+        # AND operator
+        assert 'test@example.com' == IsEmail & IsStr()
+        assert 'test@example.com' == IsStr() & IsEmail()
+        
+        # NOT operator
+        assert 'invalid' == ~IsEmail
+        assert 'test@example.com' != ~IsEmail()
