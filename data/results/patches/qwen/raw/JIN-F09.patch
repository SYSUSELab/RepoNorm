@@ -1157,12 +1157,48 @@ class _GroupTuple(t.NamedTuple):
         return tuple.__str__(self)
 
 
+
+def _group_by_level(
+    environment: "Environment",
+    items: "t.List[V]",
+    exprs: t.List[t.Callable[[t.Any], t.Any]],
+    level: int,
+    default: t.Optional[t.Any],
+) -> "t.List[t.Tuple[t.Any, t.Any]]":
+    """Recursively group items by attribute at the specified level."""
+    if level == len(exprs) - 1:
+        # Leaf level - just group by the current expression
+        expr = exprs[level]
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(items, key=expr), expr)
+        ]
+    
+    # Intermediate level - group and recurse
+    expr = exprs[level]
+    grouped = {}
+    
+    for item in items:
+        key = expr(item)
+        if key not in grouped:
+            grouped[key] = []
+        grouped[key].append(item)
+    
+    result = []
+    for key in sorted(grouped.keys()):
+        nested = _group_by_level(environment, grouped[key], exprs, level + 1, default)
+        result.append(_GroupTuple(key, nested))
+    
+    return result
+
