+    # Normalize attribute to a list
+    if isinstance(attribute, str):
+        # Check if it's a comma-separated list
+        if "," in attribute:
+            attrs = [a.strip() for a in attribute.split(",")]
+        else:
+            attrs = [attribute]
+    elif isinstance(attribute, (list, tuple)):
+        attrs = list(attribute)
+    else:
+        attrs = [attribute]
+    
+    # Validate levels parameter
+    if levels is not None:
+        # Check for boolean (bool is subclass of int in Python)
+        if isinstance(levels, bool):
+            raise FilterArgumentError("levels must be an integer or None")
+        
+        # Check for non-positive or non-integer
+        if not isinstance(levels, int) or levels <= 0:
+            raise FilterArgumentError("levels must be a positive integer")
+        
+        # Validate attribute count matches levels
+        if len(attrs) != levels:
+            raise FilterArgumentError(
+                f"attribute list length ({len(attrs)}) must equal levels ({levels})"
+            )
+    
+    # Create attribute getters
+    exprs = [make_attrgetter(environment, attr, default=default) for attr in attrs]
+    
+    # Convert value to list for sorting
+    items = list(value)
+    
+    if levels is None or levels == 1:
+        # Single-level grouping (original behavior)
+        expr = exprs[0]
+        return [
