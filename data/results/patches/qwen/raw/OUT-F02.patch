+class _InProgressCompilation:
+    """Represents an in-progress compilation that can be awaited by multiple threads."""
+
+    def __init__(self):
+        self._future: Optional[Any] = None
+        self._lock = threading.Lock()
+        self._exception: Optional[Exception] = None
+
+    def set_result(self, result: Any) -> None:
+        """Set the result of the compilation."""
+        with self._lock:
+            self._future = result
+
+    def set_exception(self, exception: Exception) -> None:
+        """Set the exception raised during compilation."""
+        with self._lock:
+            self._exception = exception
+
+    def get_result(self) -> Any:
+        """Get the result or raise the exception."""
+        with self._lock:
+            if self._exception is not None:
+                raise self._exception
+            if self._future is not None:
+                return self._future
+            raise RuntimeError("No result available yet")
+
