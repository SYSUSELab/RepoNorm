+    def _compile_and_cache(
+        self,
+        kind: str,
+        source: str,
+        compile_func,
+    ) -> Any:
+        """Compile a grammar and cache the result if caching is enabled.
+
+        Parameters
+        ----------
+        kind: str
+            The kind of grammar ("json_schema", "regex", or "cfg").
+        source: str
+            The source string of the grammar.
+        compile_func: callable
+            The function to call to compile the grammar.
+
+        Returns
+        -------
+        Any
+            The compiled grammar.
+
+        Raises
+        ------
+        Exception
+            If compilation fails.
+        """
+        cache_key = self._get_cache_key(kind, source)
+
+        if not self.cache_compiled_grammars:
+            return compile_func()
+
+        with self._cache_lock:
+            # Check if already cached
+            if cache_key in self._cache:
+                # Move to end (most recently used)
+                self._cache.move_to_end(cache_key)
+                return self._cache[cache_key].compiled_grammar
+
+            # Check if compilation is in progress
+            if cache_key in self._in_progress:
+                # Wait for the in-progress compilation
+                in_progress = self._in_progress[cache_key]
+
+        try:
+            # Compile the grammar
+            result = compile_func()
+        except Exception as e:
+            # Compilation failed - notify waiters and re-raise
+            with self._cache_lock:
+                if cache_key in self._in_progress:
+                    self._in_progress[cache_key].set_exception(e)
+                    del self._in_progress[cache_key]
+            raise
+
+        # Store the result
+        with self._cache_lock:
+            # Check again if another thread finished first
+            if cache_key in self._cache:
+                self._cache.move_to_end(cache_key)
+                return self._cache[cache_key].compiled_grammar
+
+            # Remove in-progress marker
+            if cache_key in self._in_progress:
+                del self._in_progress[cache_key]
+
+            # Add to cache
+            self._cache[cache_key] = _CompiledGrammarCacheEntry(result)
+
+            # Enforce max size if needed
+            if self.max_cached_grammars is not None:
+                while len(self._cache) > self.max_cached_grammars:
+                    # Evict least recently used (first item)
+                    self._cache.popitem(last=False)
+
+        return result
