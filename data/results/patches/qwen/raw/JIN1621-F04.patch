+                    )
+                # Validate that path is a valid path-like object
+                try:
+                    path_str = os.fspath(path)
+                except TypeError as e:
+                    raise TypeError(
+                        f"path must be a string or os.PathLike object, got {type(path).__name__} at index {i}"
+                    ) from e
+                processed_paths.append((path_str, priority))
+            else:
+                # Ordinary path item with priority 0
+                try:
+                    path_str = os.fspath(item)
+                except TypeError as e:
+                    raise TypeError(
+                        f"searchpath items must be paths or (path, priority) tuples, "
+                        f"got {type(item).__name__} at index {i}"
+                    ) from e
+                processed_paths.append((path_str, 0))
+
+        # Sort by descending priority, maintaining stable order for equal priorities
+        processed_paths.sort(key=lambda x: x[1], reverse=True)
+
+        # Extract just the paths for the public searchpath attribute
+        self.searchpath = [path for path, priority in processed_paths]
+        self.encoding = encoding
+        self.followlinks = followlinks
+
+'''
+
+# Replace the __init__ method
+new_lines = lines[:start_line] + [new_init] + lines[end_line:]
+
+# Also update the docstring to mention the new feature
+docstring_update = False
+for i, line in enumerate(new_lines):
+    if ':param searchpath:' in line:
+        # Insert the new documentation after this line
+        new_lines.insert(i+1, '        contains the templates. Each path can also be a tuple of\n')
+        new_lines.insert(i+2, '        ``(path, priority)`` where ``priority`` is an integer. Paths\n')
+        new_lines.insert(i+3, '        with higher priority are searched first. Ordinary paths have\n')
+        new_lines.insert(i+4, '        priority 0.\n')
+        break
+
+# Write the modified file
+with open('/workspace/repo/src/jinja2/loaders.py', 'w') as f:
+    f.writelines(new_lines)
+
+print("File patched successfully!")
