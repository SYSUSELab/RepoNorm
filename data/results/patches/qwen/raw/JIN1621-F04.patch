@@ -0,0 +1,104 @@
+import re
+
+# Read the original file
+with open('/workspace/repo/src/jinja2/loaders.py', 'r') as f:
+    content = f.read()
+
+# New FileSystemLoader class definition
+new_filesystem_loader = '''class FileSystemLoader(BaseLoader):
+    """Load templates from a directory in the file system.
+
+    The path can be relative or absolute. Relative paths are relative to
+    the current working directory.
+
+    .. code-block:: python
+
+        loader = FileSystemLoader("templates")
+
+    A list of paths can be given. The directories will be searched in
+    order, stopping at the first matching template.
+
+    .. code-block:: python
+
+        loader = FileSystemLoader(["/override/templates", "/default/templates"])
+
+    :param searchpath: A path, or list of paths, to the directory that
+        contains the templates. Each path can also be a tuple of
+        ``(path, priority)`` where ``priority`` is an integer. Paths
+        with higher priority are searched first. Ordinary paths have
+        priority 0.
+    :param encoding: Use this encoding to read the text from template
+        files.
+    :param followlinks: Follow symbolic links in the path.
+
+    .. versionchanged:: 2.8
+        Added the ``followlinks`` parameter.
+    .. versionadded:: NEXT_VERSION
+        Added support for ``(path, priority)`` tuples in ``searchpath``.
+    """
+
+    def __init__(
+        self,
+        searchpath: t.Union[
+            str,
+            os.PathLike,
+            t.Sequence[t.Union[str, os.PathLike, t.Tuple[t.Union[str, os.PathLike], int]]],
+        ],
+        encoding: str = "utf-8",
+        followlinks: bool = False,
+    ) -> None:
+        if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
+            searchpath = [searchpath]
+
+        # Process each item in the searchpath
+        processed_paths = []
+        for i, item in enumerate(searchpath):
+            if isinstance(item, tuple):
+                # Tuple form: (path, priority)
+                if len(item) != 2:
+                    raise TypeError(
+                        f"searchpath items must be paths or (path, priority) tuples, "
+                        f"got {len(item)}-tuple at index {i}"
+                    )
+                path, priority = item
+                # Check that priority is an integer (not a boolean)
+                if isinstance(priority, bool) or not isinstance(priority, int):
+                    raise TypeError(
+                        f"priority must be an integer, got {type(priority).__name__} at index {i}"
+                    )
+                # Validate that path is a valid path-like object
+                try:
+                    path_str = os.fspath(path)
+                except TypeError as e:
+                    raise TypeError(
+                        f"path must be a string or os.PathLike object, got {type(path).__name__} at index {i}"
+                    ) from e
+                processed_paths.append((path_str, priority))
+            else:
+                # Ordinary path item with priority 0
+                try:
+                    path_str = os.fspath(item)
+                except TypeError as e:
+                    raise TypeError(
+                        f"searchpath items must be paths or (path, priority) tuples, "
+                        f"got {type(item).__name__} at index {i}"
+                    ) from e
+                processed_paths.append((path_str, 0))
+
+        # Sort by descending priority, maintaining stable order for equal priorities
+        processed_paths.sort(key=lambda x: x[1], reverse=True)
+
+        # Extract just the paths for the public searchpath attribute
+        self.searchpath = [path for path, priority in processed_paths]
+        self.encoding = encoding
+        self.followlinks = followlinks'''
+
+# Find and replace the FileSystemLoader class
+pattern = r'class FileSystemLoader\(BaseLoader\):.*?(?=\n\nclass |\Z)'
+content = re.sub(pattern, new_filesystem_loader + '\n\n', content, flags=re.DOTALL)
+
+# Write the modified file
+with open('/workspace/repo/src/jinja2/loaders.py', 'w') as f:
+    f.write(content)
+
+print("File patched successfully!")
