+
+    def resize_path_cache(self, capacity: int) -> None:
+        """Change the cache capacity immediately.
+
+        If capacity is zero, disables and clears the cache.
+        Positive capacity evicts least-recently-used entries as needed.
+        Negative values are rejected.
+
+        :param capacity: The new maximum number of cached entries.
+        :raises ValueError: If capacity is negative.
+        """
+        if capacity < 0:
+            raise ValueError("capacity must be non-negative")
+
+        if capacity == 0:
+            self._path_cache = None
+            self._path_cache_capacity = 0
+        elif self._path_cache is None:
+            self._path_cache = OrderedDict()
+            self._path_cache_capacity = capacity
+        else:
+            self._path_cache_capacity = capacity
+            # Evict LRU entries if capacity decreased
+            while len(self._path_cache) > capacity:
+                self._path_cache.popitem(last=False)
