+HASH_ALGORITHMS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid hash string for a given algorithm.
+
+    Supports MD5, SHA1, SHA224, SHA256, SHA384, and SHA512 algorithms.
+    The hash must be exactly the correct length for the algorithm and contain
+    only hexadecimal characters (0-9, a-f, A-F).
+
+    Examples:
+    ```py title="IsHash"
+    from dirty_equals import IsHash
+
+    assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+    assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('SHA1')
+    assert 'invalid' != IsHash('md5')
+    assert 123 != IsHash('md5')
+    ```
+    """
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm to check. Supported values are:
+                'MD5', 'SHA1', 'SHA224', 'SHA256', 'SHA384', 'SHA512'
+                (case-insensitive).
+
+        Raises:
+            ValueError: If an unsupported algorithm is provided.
+        """
+        self.algorithm = algorithm
+        self._algorithm_lower = algorithm.lower()
+        try:
+            self.expected_length = HASH_ALGORITHMS[self._algorithm_lower]
+        except KeyError:
+            raise ValueError(
+                f"Unsupported algorithm: {algorithm!r}. "
+                f"Supported algorithms: {', '.join(sorted(HASH_ALGORITHMS.keys()))}"
+            )
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check length first
+        if len(other) != self.expected_length:
+            return False
+
+        # Check if all characters are valid hex digits
+        try:
+            int(other, 16)
+            return True
+        except ValueError:
+            return False
