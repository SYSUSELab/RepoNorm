+def truncate_description(description, max_chars):
+    """Truncate description to max_chars characters.
+    
+    Args:
+        description: The description string to truncate.
+        max_chars: Maximum number of characters allowed. None means no limit.
+                   Must be a positive integer or None.
+    
+    Returns:
+        Truncated description with ellipsis if needed.
+    
+    Raises:
+        ValueError: If max_chars is not None or a positive integer.
+    """
+    # Validate max_chars
+    if max_chars is None:
+        return description
+    
+    if isinstance(max_chars, bool) or not isinstance(max_chars, int) or max_chars < 1:
+        raise ValueError(f"max_description_chars must be None or a positive integer, got {max_chars}")
+    
+    # No truncation needed
+    if len(description) <= max_chars:
+        return description
+    
+    # Cap of 1 produces only …
+    if max_chars == 1:
+        return "…"
+    
+    # Reserve one character for ellipsis
+    cap = max_chars - 1
+    
+    # Try to find the last complete sentence ending (. ! or ?, followed by whitespace or end)
+    # that fits within cap characters
+    best_end = -1
+    for i in range(cap - 1, -1, -1):
+        char = description[i]
+        if char in ".!?":
+            # Check if followed by whitespace or end of string
+            if i + 1 >= cap or (i + 1 < len(description) and description[i + 1].isspace()):
+                best_end = i + 1
+                break
+    
+    if best_end > 0:
+        result = description[:best_end]
+    else:
+        # No sentence boundary found, take hard prefix of cap-1 characters
+        result = description[:cap]
+    
+    # Remove trailing whitespace from the prefix
+    result = result.rstrip()
+    
+    # Append ellipsis
+    result += "…"
+    
+    return result
