+    def _wait_with_monitoring(self, proc: subprocess.Popen, command: str) -> int:
+        """Wait for process to complete, emitting suspend/resume events on POSIX."""
+        import signal
+        
+        # On Windows, just wait normally
+        if WIN:
+            proc.wait()
+            # Emit terminate event on Windows
+            if self.monitor_process is not None:
+                try:
+                    self.monitor_process("terminate", proc.pid, command, time.time())
+                except Exception as e:
+                    import warnings
+                    warnings.warn(f"Monitor process callback raised an exception: {e}", UserWarning)
+            return 0
+        
+        # On POSIX, we can detect suspend/resume using waitpid with WNOHANG
+        # Use a thread to monitor the process state
+        import threading
+        
+        result = {"exit_code": None}
+        done = threading.Event()
+        
+        def wait_thread():
+            result["exit_code"] = proc.wait()
+            done.set()
+        
+        thread = threading.Thread(target=wait_thread, daemon=True)
+        thread.start()
+        
+        # Poll for state changes
+        last_state = "running"
+        while not done.is_set():
+            # Check if process has terminated
+            if proc.poll() is not None:
+                break
+            
+            # Try to get process status using waitpid with WNOHANG
+            try:
+                pid, status = os.waitpid(proc.pid, os.WNOHANG)
+                if pid == proc.pid:
+                    # Process changed state
+                    if os.WIFSTOPPED(status):
+                        # Process was stopped (suspended)
+                        if last_state != "stopped":
+                            last_state = "stopped"
+                            if self.monitor_process is not None:
+                                try:
+                                    self.monitor_process("suspend", proc.pid, command, time.time())
+                                except Exception as e:
+                                    import warnings
+                                    warnings.warn(f"Monitor process callback raised an exception: {e}", UserWarning)
+                    elif os.WIFCONTINUED(status):
+                        # Process was resumed
+                        if last_state != "running":
+                            last_state = "running"
+                            if self.monitor_process is not None:
+                                try:
+                                    self.monitor_process("resume", proc.pid, command, time.time())
+                                except Exception as e:
+                                    import warnings
+                                    warnings.warn(f"Monitor process callback raised an exception: {e}", UserWarning)
+            except (OSError, ValueError):
+                pass
+            
+            # Small sleep to avoid busy waiting
+            time.sleep(0.01)
+        
+        # Wait for the thread to finish
+        thread.join()
+        
+        # Emit terminate event
+        if self.monitor_process is not None:
+            try:
+                self.monitor_process("terminate", proc.pid, command, time.time())
+            except Exception as e:
+                import warnings
+                warnings.warn(f"Monitor process callback raised an exception: {e}", UserWarning)
+        
+        return result["exit_code"]
