+def _get_active_condition(conditional_filters: Optional[Dict[str, Dict[str, Callable]]]) -> Optional[str]:
+    """Determine which condition is active based on environment variables.
+    
+    Returns the name of the active condition, or None if no standard conditions match.
+    If multiple standard conditions are active, priority is debug > production > testing.
+    """
+    if conditional_filters is None or len(conditional_filters) == 0:
+        return None
+    
+    # Check for active conditions based on environment variables
+    active_conditions = []
+    
+    # OUTLINES_DEBUG=true activates debug
+    if os.environ.get("OUTLINES_DEBUG", "").lower() == "true":
+        active_conditions.append("debug")
+    
+    # ENVIRONMENT=production activates production
+    if os.environ.get("ENVIRONMENT", "").lower() == "production":
+        active_conditions.append("production")
+    
+    # ENV=testing, OUTLINES_TESTING=true, or TESTING_MODE=on activates testing
+    env_value = os.environ.get("ENV", "").lower()
+    outlines_testing = os.environ.get("OUTLINES_TESTING", "").lower()
+    testing_mode = os.environ.get("TESTING_MODE", "").lower()
+    if env_value == "testing" or outlines_testing == "true" or testing_mode == "on":
+        active_conditions.append("testing")
+    
+    # Filter to only include conditions that are in the supplied mapping
+    available_conditions = set(conditional_filters.keys())
+    matching_conditions = [c for c in active_conditions if c in available_conditions]
+    
+    if not matching_conditions:
+        # No standard condition matches - select alphabetically first supplied condition key
+        return sorted(available_conditions)[0] if available_conditions else None
+    
+    # Priority: debug > production > testing
+    priority_order = ["debug", "production", "testing"]
+    for condition in priority_order:
+        if condition in matching_conditions:
+            return condition
+    
+    # Fallback (shouldn't happen given the logic above)
+    return matching_conditions[0]
+
