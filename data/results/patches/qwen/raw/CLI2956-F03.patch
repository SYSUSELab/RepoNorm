@@ -0,0 +1,103 @@
+import click
+from click.testing import CliRunner
+
+runner = CliRunner()
+
+# Test with False values
+@click.command()
+@click.option("--val", type=bool, multiple=True, batch_size=2)
+def cli_false(val):
+    click.echo(f"val={val}")
+
+result = runner.invoke(cli_false, ["--val", "true", "--val", "false", "--val", "true"])
+print("Test - False values:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with empty string values
+@click.command()
+@click.option("--val", type=str, multiple=True, batch_size=2)
+def cli_empty_str(val):
+    click.echo(f"val={val}")
+
+result = runner.invoke(cli_empty_str, ["--val", "", "--val", "hello", "--val", ""])
+print("Test - Empty string values:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with None values (using nargs=1 and multiple)
+@click.command()
+@click.option("--val", type=str, multiple=True, nargs=1, batch_size=2)
+def cli_none(val):
+    click.echo(f"val={val}")
+
+result = runner.invoke(cli_none, ["--val", "a", "--val", "b"])
+print("Test - Normal values:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test batch_size=1
+@click.command()
+@click.option("--item", multiple=True, batch_size=1)
+def cli_batch1(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_batch1, ["--item", "a", "--item", "b", "--item", "c"])
+print("Test - batch_size=1:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test batch_size larger than input
+@click.command()
+@click.option("--item", multiple=True, batch_size=10)
+def cli_large_batch(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_large_batch, ["--item", "a", "--item", "b"])
+print("Test - batch_size larger than input:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with callback
+def my_callback(ctx, param, value):
+    return tuple(x.upper() for x in value)
+
+@click.command()
+@click.option("--item", multiple=True, batch_size=2, callback=my_callback)
+def cli_callback(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_callback, ["--item", "a", "--item", "b", "--item", "c"])
+print("Test - With callback:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with default values
+@click.command()
+@click.option("--item", multiple=True, batch_size=2, default=("x", "y"))
+def cli_default(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_default, [])
+print("Test - With default values:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with nargs > 1 and multiple
+@click.command()
+@click.option("--item", type=(str, int), multiple=True, batch_size=2)
+def cli_nargs(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_nargs, ["--item", "a", "1", "--item", "b", "2", "--item", "c", "3"])
+print("Test - With nargs > 1 and multiple:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
diff --git a/tests/test_options.py b/tests/test_options.py
