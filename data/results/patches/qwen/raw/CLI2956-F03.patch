--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -1139,3 +1139,184 @@ def test_duplicate_names_warning(runner, opts_one, opts_two):
 
     with pytest.warns(UserWarning):
         runner.invoke(cli, [])
+
+
+# Tests for batch_size parameter
+def test_batch_size_basic(runner):
+    """Test basic batching functionality."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=2)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a", "--item", "b", "--item", "c", "--item", "d", "--item", "e"])
+    assert not result.exception
+    assert result.output == "item=(('a', 'b'), ('c', 'd'), ('e',)))\n"
+
+
+def test_batch_size_empty_input(runner):
+    """Test empty input produces empty tuple."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=2)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, [])
+    assert not result.exception
+    assert result.output == "item=()\n"
+
+
+def test_batch_size_single_value(runner):
+    """Test single value produces one batch."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=2)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a"])
+    assert not result.exception
+    assert result.output == "item=(('a',),))\n"
+
+
+def test_batch_size_one(runner):
+    """Test batch_size=1 produces individual batches."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=1)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a", "--item", "b", "--item", "c"])
+    assert not result.exception
+    assert result.output == "item=(('a',), ('b',), ('c',)))\n"
+
+
+def test_batch_size_larger_than_input(runner):
+    """Test batch_size larger than input produces single batch."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=10)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a", "--item", "b"])
+    assert not result.exception
+    assert result.output == "item=(('a', 'b'),))\n"
+
+
+def test_batch_size_with_callback(runner):
+    """Test batching works with callback."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=2, callback=lambda ctx, param, v: tuple(x.upper() for x in v))
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a", "--item", "b", "--item", "c"])
+    assert not result.exception
+    assert result.output == "item=(('A', 'B'), ('C',)))\n"
+
+
+def test_batch_size_with_default(runner):
+    """Test batching works with default values."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=2, default=("x", "y"))
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, [])
+    assert not result.exception
+    assert result.output == "item=(('x', 'y'),))\n"
+
+
+def test_batch_size_decorator(runner):
+    """Test batching with decorator syntax."""
+    @click.command()
+    @click.option("-i", "--item", multiple=True, batch_size=2)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["-i", "a", "-i", "b", "-i", "c"])
+    assert not result.exception
+    assert result.output == "item=(('a', 'b'), ('c',)))\n"
+
+
+def test_batch_size_special_values(runner):
+    """Test batching preserves special values like 0, False, empty string."""
+    @click.command()
+    @click.option("--val", multiple=True, type=int, batch_size=2)
+    def cli(val):
+        click.echo(f"val={val}")
+
+    result = runner.invoke(cli, ["--val", "0", "--val", "-1", "--val", "5"])
+    assert not result.exception
+    assert result.output == "val=((0, -1), (5,))\n"
+
+
+def test_batch_size_no_multiple_error(runner):
+    """Test that batch_size without multiple raises TypeError."""
+    with pytest.raises(TypeError, match="batch_size is only valid with multiple=True"):
+        click.Option(["--item"], batch_size=2)
+
+
+def test_batch_size_non_positive_error(runner):
+    """Test that non-positive batch_size raises ValueError."""
+    with pytest.raises(ValueError, match="batch_size must be a positive integer"):
+        click.Option(["--item"], multiple=True, batch_size=0)
+
+
+def test_batch_size_boolean_error(runner):
+    """Test that boolean batch_size raises TypeError."""
+    with pytest.raises(TypeError, match="batch_size must be an integer, not a boolean"):
+        click.Option(["--item"], multiple=True, batch_size=True)
+
+
+def test_batch_size_non_int_error(runner):
+    """Test that non-integer batch_size raises TypeError."""
+    with pytest.raises(TypeError, match="batch_size must be an integer"):
+        click.Option(["--item"], multiple=True, batch_size="2")
+
+
+def test_batch_size_none_no_batching(runner):
+    """Test that batch_size=None preserves existing behavior."""
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=None)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a", "--item", "b", "--item", "c"])
+    assert not result.exception
+    assert result.output == "item=('a', 'b', 'c')\n"
+
+
+def test_batch_size_false_values(runner):
+    """Test batching preserves False values."""
+    @click.command()
+    @click.option("--val", multiple=True, type=bool, batch_size=2)
+    def cli(val):
+        click.echo(f"val={val}")
+
+    result = runner.invoke(cli, ["--val", "True", "--val", "False", "--val", "True"])
+    assert not result.exception
+    assert result.output == "val=((True, False), (True,))\n"
+
+
+def test_batch_size_empty_string_values(runner):
+    """Test batching preserves empty string values."""
+    @click.command()
+    @click.option("--val", multiple=True, batch_size=2)
+    def cli(val):
+        click.echo(f"val={val}")
+
+    result = runner.invoke(cli, ["--val", "", "--val", "hello", "--val", ""])
+    assert not result.exception
+    assert result.output == "val=(('', 'hello'), ('',))\n"
+
+
+def test_batch_size_nargs(runner):
+    """Test batching with nargs > 1 and multiple."""
+    @click.command()
+    @click.option("--item", multiple=True, nargs=2, batch_size=2)
+    def cli(item):
+        click.echo(f"item={item}")
+
+    result = runner.invoke(cli, ["--item", "a", "1", "--item", "b", "2", "--item", "c", "3"])
+    assert not result.exception
