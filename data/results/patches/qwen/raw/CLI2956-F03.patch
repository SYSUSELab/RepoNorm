--- /dev/null
+++ b/test_batch.py
@@ -0,0 +1,108 @@
+import click
+from click.testing import CliRunner
+
+runner = CliRunner()
+
+# Test basic batching with multiple=True
+@click.command()
+@click.option("--item", multiple=True, batch_size=2)
+def cli(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli, ["--item", "a", "--item", "b", "--item", "c", "--item", "d", "--item", "e"])
+print("Test 1 - Basic batching:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with empty input
+@click.command()
+@click.option("--item", multiple=True, batch_size=2)
+def cli_empty(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_empty, [])
+print("Test 2 - Empty input:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test with single value
+@click.command()
+@click.option("--item", multiple=True, batch_size=2)
+def cli_single(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_single, ["--item", "a"])
+print("Test 3 - Single value:")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test preserving special values (0, False, "", None)
+@click.command()
+@click.option("--val", type=int, multiple=True, batch_size=2)
+def cli_special(val):
+    click.echo(f"val={val}")
+
+result = runner.invoke(cli_special, ["--val", "0", "--val", "-1", "--val", "5"])
+print("Test 4 - Special values (0, -1, 5):")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
+
+# Test batch_size without multiple=True should raise TypeError
+try:
+    @click.command()
+    @click.option("--item", batch_size=2)
+    def cli_no_multiple(item):
+        pass
+    print("Test 5 - Should have raised TypeError!")
+except TypeError as e:
+    print(f"Test 5 - Correctly raised TypeError: {e}")
+print()
+
+# Test non-positive batch_size should raise ValueError
+try:
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=0)
+    def cli_zero_batch(item):
+        pass
+    print("Test 6 - Should have raised ValueError!")
+except ValueError as e:
+    print(f"Test 6 - Correctly raised ValueError: {e}")
+print()
+
+# Test boolean batch_size should raise TypeError
+try:
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=True)
+    def cli_bool_batch(item):
+        pass
+    print("Test 7 - Should have raised TypeError!")
+except TypeError as e:
+    print(f"Test 7 - Correctly raised TypeError: {e}")
+print()
+
+# Test non-integer batch_size should raise TypeError
+try:
+    @click.command()
+    @click.option("--item", multiple=True, batch_size="2")
+    def cli_str_batch(item):
+        pass
+    print("Test 8 - Should have raised TypeError!")
+except TypeError as e:
+    print(f"Test 8 - Correctly raised TypeError: {e}")
+print()
+
+# Test batch_size=None preserves existing behavior
+@click.command()
+@click.option("--item", multiple=True, batch_size=None)
+def cli_none_batch(item):
+    click.echo(f"item={item}")
+
+result = runner.invoke(cli_none_batch, ["--item", "a", "--item", "b", "--item", "c"])
+print("Test 9 - batch_size=None (no batching):")
+print(result.output)
+print(f"Exit code: {result.exit_code}")
+print()
