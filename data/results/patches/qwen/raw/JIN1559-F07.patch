+class TestFallbackInternationalization:
+    """Tests for install_gettext_callables_with_fallback."""
+
+    def setup_method(self):
+        """Set up fresh environment for each test."""
+        self.env = Environment(extensions=[InternationalizationExtension])
+
+    def _create_primary_gettext(self, name="primary"):
+        """Create a primary gettext that returns source (no translation)."""
+        def gettext(s):
+            print(f"{name}_gettext called with: {s!r}")
+            return s
+        return gettext
+
+    def _create_primary_ngettext(self, name="primary"):
+        """Create a primary ngettext that returns source (no translation)."""
+        def ngettext(singular, plural, n):
+            print(f"{name}_ngettext called with: {singular!r}, {plural!r}, {n}")
+            return singular if n == 1 else plural
+        return ngettext
+
+    def test_basic_fallback_chain(self):
+        """Test basic fallback chain where first fallback succeeds."""
+        @pass_context
+        def fallback1(context, s):
+            print(f"fallback1_gettext called with: {s!r}")
+            if s == "hello":
+                return "bonjour"
+            return s
+
+        @pass_context
+        def fallback2(context, s):
+            print(f"fallback2_gettext called with: {s!r}")
+            return f"[{s}]"
+
+        self.env.install_gettext_callables_with_fallback(
+            gettext=self._create_primary_gettext(),
+            ngettext=self._create_primary_ngettext(),
+            fallback_gettext_funcs=[fallback1, fallback2],
+            newstyle=True,
+        )
+
+        # Test translation found in first fallback
+        template = self.env.from_string("{{ _('hello') }}")
+        result = template.render()
+        assert result == "bonjour", f"Expected 'bonjour', got {result!r}"
+
+        # Test translation not found - falls through to second fallback
+        template = self.env.from_string("{{ _('world') }}")
+        result = template.render()
+        assert result == "[world]", f"Expected '[world]', got {result!r}"
+
+    def test_second_fallback_succeeds(self):
+        """Test when first fallback misses and second succeeds."""
+        @pass_context
+        def fallback1(context, s):
+            print(f"fallback1_gettext called with: {s!r}")
+            return s  # Always returns source (miss)
+
+        @pass_context
+        def fallback2(context, s):
+            print(f"fallback2_gettext called with: {s!r}")
+            return f"translated_{s}"
+
+        self.env.install_gettext_callables_with_fallback(
+            gettext=lambda s: s,
+            ngettext=self._create_primary_ngettext(),
+            fallback_gettext_funcs=[fallback1, fallback2],
+            newstyle=True,
+        )
+
+        template = self.env.from_string("{{ _('test') }}")
+        result = template.render()
+        assert result == "translated_test", f"Expected 'translated_test', got {result!r}"
+
+    def test_exception_propagation(self):
+        """Test that exceptions propagate without calling later providers."""
+        @pass_context
+        def failing_gettext(context, s):
+            print(f"failing_gettext called with: {s!r}")
+            raise ValueError("Translation failed!")
+
+        @pass_context
+        def working_gettext(context, s):
+            print(f"working_gettext called with: {s!r}")
+            return f"worked_{s}"
+
+        self.env.install_gettext_callables_with_fallback(
+            gettext=lambda s: s,
+            ngettext=self._create_primary_ngettext(),
+            fallback_gettext_funcs=[failing_gettext, working_gettext],
+            newstyle=True,
+        )
+
+        template = self.env.from_string("{{ _('fail') }}")
+        with pytest.raises(ValueError, match="Translation failed!"):
+            template.render()
+
+    def test_validation_error_for_contextual_fallbacks(self):
