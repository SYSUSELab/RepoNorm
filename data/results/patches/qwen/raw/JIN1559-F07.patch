+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, int], str]]] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str], str]]] = None,
+        fallback_npgettext_funcs: t.Optional[t.Iterable[t.Callable[[str, str, str, int], str]]] = None,
+    )  -> None:
+        """Install gettext callables with optional fallback providers.
+        
+        Each fallback argument is an optional finite iterable of callables matching its
+        primary provider's signature. The installer snapshots each iterable when called.
+        A missing or empty iterable behaves like :meth:`install_gettext_callables`.
+        Supplying a non-empty contextual fallback iterable without the matching
+        :attr:`pgettext` or :attr:`npgettext` primary raises :exc:`ValueError`.
+        
+        Call the primary provider first. A :func:`gettext` or :func:`pgettext` result
+        is missing when it equals the source message. An :func:`ngettext` or
+        :func:`npgettext` result is missing when it equals the selected source form:
+        singular for ``n == 1``, plural otherwise. Only on a miss, call matching
+        fallback providers in their declared order and stop at the first non-missing
+        result. If every provider misses, return the selected source message.
+        Provider exceptions propagate without calling later providers. Context
+        providers receive the context string on every attempt.
+        """
+        self._install_callables(
+            gettext,
+            ngettext,
+            newstyle=newstyle,
+            pgettext=pgettext,
+            npgettext=npgettext,
+            fallback_gettext_funcs=fallback_gettext_funcs,
+            fallback_ngettext_funcs=fallback_ngettext_funcs,
+            fallback_pgettext_funcs=fallback_pgettext_funcs,
+            fallback_npgettext_funcs=fallback_npgettext_funcs,
+        )
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
         for key in ("gettext", "ngettext", "pgettext", "npgettext"):
             self.environment.globals.pop(key, None)
