index 000000000..5b8317c39
--- /dev/null
+++ b/tests/adapters/test_tool_calls_input_contribution.py
@@ -0,0 +1,25 @@
+import copy
+
+from dspy.adapters.types.tool import ToolCalls
+
+
+def test_flexible_inputs_preserve_order_values_and_caller_data():
+    source = [
+        {"name": "first", "args": {"nested": [1, {"ok": True}]}},
+        {"name": "second", "args": {}},
+    ]
+    before = copy.deepcopy(source)
+
+    calls = ToolCalls.model_validate(source)
+
+    assert source == before
+    assert [call.name for call in calls.tool_calls] == ["first", "second"]
+    assert calls.tool_calls[0].args == source[0]["args"]
+    assert calls.format()[0]["type"] == "tool_calls"
+
+
+def test_validate_input_is_a_normalizer_not_a_constructor():
+    normalized = ToolCalls.validate_input('{"name":"search","args":{"q":"x"}}')
+
+    assert normalized == {"tool_calls": [{"name": "search", "args": {"q": "x"}}]}
+    assert not isinstance(normalized, ToolCalls)
