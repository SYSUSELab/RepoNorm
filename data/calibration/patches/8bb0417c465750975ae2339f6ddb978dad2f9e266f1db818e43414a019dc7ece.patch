@@ -0,0 +1,143 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import pass_context
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_context_provider_selection_and_formatting(newstyle):
+    env = Environment(autoescape=True, extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    @pass_context
+    def primary(context, message):
+        seen.append(("primary", context.environment, message))
+        return message
+
+    @pass_context
+    def fallback(context, message):
+        seen.append(("fallback", context.environment, message))
+        return "<b>%(name)s</b>"
+
+    env.install_gettext_callables_with_fallback(
+        primary,
+        lambda one, many, n: many,
+        fallback_gettext_funcs=[fallback],
+        newstyle=newstyle,
+    )
+    template = env.from_string("{% trans name=value %}Hi {{ name }}{% endtrans %}")
+    assert template.render(value="<x>") == "<b>&lt;x&gt;</b>"
+    assert seen == [
+        ("primary", env, "Hi %(name)s"),
+        ("fallback", env, "Hi %(name)s"),
+    ]
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_all_provider_kinds_snapshot_context_and_short_circuit(newstyle):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    @pass_context
+    def gettext(context, message):
+        seen.append((context.environment, message))
+        return message
+
+    @pass_context
+    def ngettext(context, one, many, n):
+        seen.append((context.environment, n))
+        return one if n == 1 else many
+
+    @pass_context
+    def pgettext(context, domain, message):
+        seen.append((context.environment, domain))
+        return message
+
+    @pass_context
+    def npgettext(context, domain, one, many, n):
+        seen.append((context.environment, domain, n))
+        return one if n == 1 else many
+
+    fallbacks = [lambda message: "result"]
+    env.install_gettext_callables_with_fallback(
+        gettext,
+        ngettext,
+        fallback_gettext_funcs=iter(fallbacks),
+        fallback_ngettext_funcs=[lambda one, many, n: "items"],
+        newstyle=newstyle,
+        pgettext=pgettext,
+        npgettext=npgettext,
+        fallback_pgettext_funcs=[lambda domain, message: "context"],
+        fallback_npgettext_funcs=[lambda domain, one, many, n: "contexts"],
+    )
+    fallbacks[0] = lambda message: "changed"
+    text = env.from_string(
+        '{{ gettext("x") }}|{{ ngettext("one", "many", 2) }}|'
+        '{{ pgettext("menu", "x") }}|'
+        '{{ npgettext("menu", "one", "many", 2) }}'
+    ).render()
+    assert text == "result|items|context|contexts"
+    assert seen == [(env, "x"), (env, 2), (env, "menu"), (env, "menu", 2)]
+
+
+def test_provider_exception_does_not_call_later_provider():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    def broken(message):
+        raise LookupError("catalog failed")
+
+    env.install_gettext_callables_with_fallback(
+        broken,
+        lambda one, many, n: many,
+        fallback_gettext_funcs=[lambda message: seen.append(message) or "x"],
+    )
+    with pytest.raises(LookupError, match="catalog failed"):
+        env.from_string('{{ gettext("x") }}').render()
+    assert seen == []
+
+
+def test_reinstallation_and_uninstall_replace_all_providers():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    template = env.from_string('{{ gettext("x") }}')
+    for value in ("first", "second"):
+        env.install_gettext_callables_with_fallback(
+            lambda message: message,
+            lambda one, many, n: many,
+            fallback_gettext_funcs=[lambda message: value],
+        )
+        assert template.render() == value
+    env.install_gettext_callables(lambda message: "normal", lambda one, many, n: many)
+    assert template.render() == "normal"
+    env.uninstall_gettext_translations(None)
+    assert not {"gettext", "ngettext", "pgettext", "npgettext"}.intersection(
+        env.globals
+    )
+
+
+@pytest.mark.parametrize("kind", ["pgettext", "npgettext"])
+def test_contextual_fallback_requires_primary(kind):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    with pytest.raises(ValueError, match=kind):
+        env.install_gettext_callables_with_fallback(
+            lambda message: message,
+            lambda one, many, n: many,
+            **{"fallback_" + kind + "_funcs": [lambda *args: "result"]},
+        )
+
+
+def test_nonempty_falsey_iterable_is_not_missing():
+    class Providers:
+        def __bool__(self):
+            return False
+
+        def __iter__(self):
+            yield lambda message: "translated"
+
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.install_gettext_callables_with_fallback(
+        lambda message: message,
+        lambda one, many, n: many,
+        fallback_gettext_funcs=Providers(),
+    )
+    assert env.from_string('{{ gettext("x") }}').render() == "translated"
