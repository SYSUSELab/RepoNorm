+    def _install_callables_with_fallback(
+        self,
+        gettext: t.Callable[[str], str],
+        ngettext: t.Callable[[str, str, int], str],
+        fallback_gettext_funcs: t.Optional[t.Iterable[t.Callable[[str], str]]] = None,
+        fallback_ngettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str, int], str]]
+        ] = None,
+        newstyle: t.Optional[bool] = None,
+        pgettext: t.Optional[t.Callable[[str, str], str]] = None,
+        npgettext: t.Optional[t.Callable[[str, str, str, int], str]] = None,
+        fallback_pgettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str], str]]
+        ] = None,
+        fallback_npgettext_funcs: t.Optional[
+            t.Iterable[t.Callable[[str, str, str, int], str]]
+        ] = None,
+    ) -> None:
+        """Install callables with ordered, snapshotted fallbacks.
+
+        Each chain uses the primary provider first, then its fallbacks
+        until a result differs from the selected source message.
+        Provider exceptions propagate. Formatting and autoescaping use
+        the existing installer; ``newstyle=None`` preserves its mode.
+        Contextual fallbacks require their corresponding primary.
+
+        .. versionadded:: 3.1.0
+        """
+        gettext_fallbacks = tuple(
+            () if fallback_gettext_funcs is None else fallback_gettext_funcs
+        )
+        ngettext_fallbacks = tuple(
+            () if fallback_ngettext_funcs is None else fallback_ngettext_funcs
+        )
+        pgettext_fallbacks = tuple(
+            () if fallback_pgettext_funcs is None else fallback_pgettext_funcs
+        )
+        npgettext_fallbacks = tuple(
+            () if fallback_npgettext_funcs is None else fallback_npgettext_funcs
+        )
+
+        if gettext_fallbacks:
+            gettext = _make_gettext_with_fallback(gettext, gettext_fallbacks)
+
+        if ngettext_fallbacks:
+            ngettext = _make_ngettext_with_fallback(ngettext, ngettext_fallbacks)
+
+        if pgettext_fallbacks:
+            if pgettext is None:
+                raise ValueError("fallback_pgettext_funcs requires pgettext")
+
+            pgettext = _make_pgettext_with_fallback(pgettext, pgettext_fallbacks)
+
+        if npgettext_fallbacks:
+            if npgettext is None:
+                raise ValueError("fallback_npgettext_funcs requires npgettext")
+
+            npgettext = _make_npgettext_with_fallback(npgettext, npgettext_fallbacks)
+
+        self._install_callables(
+            gettext,
+            ngettext,
+            newstyle=newstyle,
+            pgettext=pgettext,
+            npgettext=npgettext,
+        )
+
     def _uninstall(self, translations: "_SupportedTranslations") -> None:
         for key in ("gettext", "ngettext", "pgettext", "npgettext"):
             self.environment.globals.pop(key, None)
