diff --git a/src/click/termui.py b/src/click/termui.py
index e14e670..e7eaaad 100644
--- a/src/click/termui.py
+++ b/src/click/termui.py
@@ -650,37 +650,17 @@ def edit(
     require_save: bool = True,
     extension: str = ".txt",
     filename: str | None = None,
+    process_group: bool = False,
 ) -> t.AnyStr | None:
-    r"""Edits the given text in the defined editor.  If an editor is given
-    (should be the full path to the executable but the regular operating
-    system search path is used for finding the executable) it overrides
-    the detected editor.  Optionally, some environment variables can be
-    used.  If the editor is closed without changes, `None` is returned.  In
-    case a file is edited directly the return value is always `None` and
-    `require_save` and `extension` are ignored.
-
-    If the editor cannot be opened a :exc:`UsageError` is raised.
-
-    Note for Windows: to simplify cross-platform usage, the newlines are
-    automatically converted from POSIX to Windows and vice versa.  As such,
-    the message here will have ``\n`` as newline markers.
-
-    :param text: the text to edit.
-    :param editor: optionally the editor to use.  Defaults to automatic
-                   detection.
-    :param env: environment variables to forward to the editor.
-    :param require_save: if this is true, then not saving in the editor
-                         will make the return value become `None`.
-    :param extension: the extension to tell the editor about.  This defaults
-                      to `.txt` but changing this might change syntax
-                      highlighting.
-    :param filename: if provided it will edit this file instead of the
-                     provided text contents.  It will not use a temporary
-                     file as an indirection in that case.
-    """
     from ._termui_impl import Editor
 
-    ed = Editor(editor=editor, env=env, require_save=require_save, extension=extension)
+    ed = Editor(
+        editor=editor,
+        env=env,
+        require_save=require_save,
+        extension=extension,
+        process_group=process_group,
+    )
 
     if filename is None:
         return ed.edit(text)
diff --git a/tests/test_n4c_author_edit_process_group.py b/tests/test_n4c_author_edit_process_group.py
new file mode 100644
index 0000000..da51ce3
--- /dev/null
+++ b/tests/test_n4c_author_edit_process_group.py
@@ -0,0 +1,63 @@
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def test_disabled_preserves_process_creation_exactly(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(filename="one", editor="editor")
+    assert calls[0] == {"env": None, "shell": True}
+
+
+def test_posix_group_applies_to_direct_and_text_modes(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(filename="one", editor="editor", process_group=True)
+    click.edit("text", editor="editor", process_group=True)
+    assert [call["start_new_session"] for call in calls] == [True, True]
+
+
+def test_unsupported_windows_group_degrades_to_normal(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.WIN", True)
+    monkeypatch.delattr("subprocess.CREATE_NEW_PROCESS_GROUP", raising=False)
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(filename="one", editor="editor", process_group=True)
+    assert calls[0] == {"env": None, "shell": True}
+
+
+def test_environment_and_nonzero_exit_are_preserved(monkeypatch):
+    calls = []
+    monkeypatch.setenv("PARENT", "kept")
+
+    def launch(*args, **kwargs):
+        calls.append(kwargs)
+        return _Process(7)
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(
+            filename="one",
+            editor="editor",
+            env={"EXPLICIT": "added"},
+            process_group=True,
+        )
+    assert calls[0]["env"]["PARENT"] == "kept"
+    assert calls[0]["env"]["EXPLICIT"] == "added"
