+    def _create_isolated_env(self) -> dict[str, str]:
+        allowed = {
+            "PATH",
+            "HOME",
+            "USER",
+            "USERNAME",
+            "LOGNAME",
+            "SHELL",
+            "TERM",
+            "DISPLAY",
+            "XAUTHORITY",
+            "WAYLAND_DISPLAY",
+            "LANG",
+            "LANGUAGE",
+            "LC_ALL",
+            "LC_CTYPE",
+            "LC_MESSAGES",
+            "TMPDIR",
+            "TMP",
+            "TEMP",
+            "SYSTEMROOT",
+            "COMSPEC",
+            "PATHEXT",
+        }
+        return {
+            key: value for key, value in os.environ.items() if key.upper() in allowed
+        }
 
