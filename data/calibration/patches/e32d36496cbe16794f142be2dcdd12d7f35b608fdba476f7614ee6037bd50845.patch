--- /dev/null
+++ b/tests/test_n4c_author_searchpath_priorities.py
@@ -0,0 +1,61 @@
+import os
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import FileSystemLoader
+from jinja2 import TemplateNotFound
+
+
+def test_priority_paths_preserve_source_protocol(tmp_path):
+    default, high = tmp_path / "default", tmp_path / "high"
+    default.mkdir()
+    high.mkdir()
+    (default / "page").write_text("wrong")
+    path = high / "page"
+    path.write_bytes("café".encode("latin-1"))
+    loader = FileSystemLoader([default, (high, 3)], encoding="latin-1")
+    text, filename, current = loader.get_source(Environment(), "page")
+    assert text == "café" and os.path.samefile(filename, path)
+    assert current() is True
+    stamp = path.stat()
+    os.utime(path, ns=(stamp.st_atime_ns, stamp.st_mtime_ns + 2000000000))
+    assert current() is False
+    path.unlink()
+    assert current() is False
+
+
+def test_priority_paths_preserve_parent_guard(tmp_path):
+    root = tmp_path / "root"
+    root.mkdir()
+    (tmp_path / "secret").write_text("outside")
+    loader = FileSystemLoader([(root, 2)])
+    with pytest.raises(TemplateNotFound) as caught:
+        loader.get_source(Environment(), "../secret")
+    assert caught.value.name == "../secret"
+
+
+@pytest.mark.parametrize("follow", [False, True])
+def test_priority_listing_remains_sorted_unique_and_follows_option(tmp_path, follow):
+    root, linked = tmp_path / "root", tmp_path / "linked"
+    root.mkdir()
+    linked.mkdir()
+    (root / "z").write_text("z")
+    (root / "a").write_text("a")
+    (linked / "child").write_text("child")
+    (root / "nested").symlink_to(linked, target_is_directory=True)
+    loader = FileSystemLoader([(root, 1), (root, -1)], followlinks=follow)
+    expected = ["a", "nested/child", "z"] if follow else ["a", "z"]
+    assert loader.list_templates() == expected
+
+
+def test_priority_ties_plain_path_and_duplicate_entries(tmp_path):
+    a, b = tmp_path / "a", tmp_path / "b"
+    loader = FileSystemLoader([a, (b, 0), (a, 0), (b, -1)])
+    assert loader.searchpath == [str(a), str(b), str(a), str(b)]
+
+
+@pytest.mark.parametrize("entry", [("path", True), ("path", 1.2), ("path",)])
+def test_priority_configuration_errors_are_not_skipped(entry):
+    with pytest.raises(TypeError):
+        FileSystemLoader([entry])
