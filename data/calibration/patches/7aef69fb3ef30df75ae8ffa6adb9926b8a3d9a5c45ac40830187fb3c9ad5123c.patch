+    def bind(self, environment: Environment) -> "InternationalizationExtension":
+        """Bind a copied extension to the supplied environment.
+
+        .. versionchanged:: 3.1.0
+           Copy translation versions and rebind their public methods.
+        """
+        rv = t.cast("InternationalizationExtension", super().bind(environment))
+        rv._translation_versions = dict(self._translation_versions)
+        bound_environment = t.cast("t.Any", environment)
+        bound_environment.set_translation_version = rv._set_translation_version
+        bound_environment.get_translation_version = rv._get_translation_version
+        bound_environment.compare_translation_versions = (
+            rv._compare_translation_versions
+        )
+        bound_environment.remove_translation_version = rv._remove_translation_version
+        bound_environment.clear_translation_versions = rv._clear_translation_versions
+        return rv
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        """Set a string message's string application version."""
+        if not isinstance(message, str) or not isinstance(version, str):
+            raise TypeError("message and version must be strings")
+        self._translation_versions[message] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        """Get a version, or None for an unregistered message."""
+        return self._translation_versions.get(message)
+
+    def _compare_translation_versions(self, message1: str, message2: str) -> bool:
+        """Compare versions only when both messages are registered."""
+        if (
+            message1 not in self._translation_versions
+            or message2 not in self._translation_versions
+        ):
+            return False
+        return (
+            self._translation_versions[message1] == self._translation_versions[message2]
+        )
+
+    def _remove_translation_version(self, message: str) -> None:
+        """Remove one version entry; unknown messages are harmless."""
+        self._translation_versions.pop(message, None)
+
+    def _clear_translation_versions(self) -> None:
+        """Remove every application version from this environment."""
+        self._translation_versions.clear()
+
 
