+    def _priority_launch_options(self) -> dict[str, t.Any]:
+        priority = self.process_priority
+        if priority is None:
+            return {}
+        if WIN:
+            import subprocess
+
+            flags = {
+                "low": getattr(subprocess, "IDLE_PRIORITY_CLASS", 0),
+                "below_normal": getattr(subprocess, "BELOW_NORMAL_PRIORITY_CLASS", 0),
+                "normal": getattr(subprocess, "NORMAL_PRIORITY_CLASS", 0),
+                "above_normal": getattr(subprocess, "ABOVE_NORMAL_PRIORITY_CLASS", 0),
+                "high": getattr(subprocess, "HIGH_PRIORITY_CLASS", 0),
+            }
+            return {"creationflags": flags[priority]} if flags[priority] else {}
+
+        if not hasattr(os, "nice"):
+            return {}
+
+        adjustments = {
+            "low": 15,
+            "below_normal": 5,
+            "normal": 0,
+            "above_normal": -5,
+            "high": -10,
+        }
+        adjustment = adjustments[priority]
+
+        def apply_priority() -> None:
+            try:
+                os.nice(adjustment)
+            except OSError:
+                pass
+
+        return {"preexec_fn": apply_priority}
+
