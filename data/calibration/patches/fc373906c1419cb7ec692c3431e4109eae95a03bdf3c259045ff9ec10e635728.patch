+    def bind(self, environment: Environment) -> "InternationalizationExtension":
+        """Bind independent translation cache state to an overlay.
+
+        .. versionchanged:: 3.1.0
+            Translation cache state is independent across overlays.
+        """
+        rv = t.cast("InternationalizationExtension", super().bind(environment))
+        environment.globals = dict(environment.globals)
+        environment.i18n_translation_cache = OrderedDict(  # type: ignore
+            self.environment.i18n_translation_cache  # type: ignore
+        )
+        for name, method in (
+            ("install_gettext_translations", rv._install),
+            ("install_null_translations", rv._install_null),
+            ("install_gettext_callables", rv._install_callables),
+            ("uninstall_gettext_translations", rv._uninstall),
+            ("extract_translations", rv._extract),
+            ("clear_translation_cache", rv._clear_translation_cache),
+            ("resize_translation_cache", rv._resize_translation_cache),
+            ("set_translation_cache_partition", rv._set_translation_cache_partition),
+        ):
+            setattr(environment, name, method)
+        return rv
+
+    def _clear_translation_cache(self) -> None:
+        """Clear this environment's application translation cache."""
+        self.environment.i18n_translation_cache.clear()  # type: ignore
+
+    def _resize_translation_cache(self, capacity: int) -> None:
+        """Set capacity, evict excess entries, and disable at zero."""
+        if isinstance(capacity, bool) or not isinstance(capacity, int) or capacity < 0:
+            raise ValueError(
+                "translation cache capacity must be a non-negative integer"
+            )
+        self.environment.i18n_cache_size = capacity  # type: ignore
+        cache = self.environment.i18n_translation_cache  # type: ignore
+        while len(cache) > capacity:
+            cache.popitem(last=False)
+        if capacity == 0:
+            cache.clear()
+
+    def _set_translation_cache_partition(self, partition: t.Hashable) -> None:
+        """Change the cache partition and clear existing entries."""
+        hash(partition)
+        if partition != self.environment.i18n_cache_partition:  # type: ignore
+            self.environment.i18n_cache_partition = partition  # type: ignore
+            self._clear_translation_cache()
+
+    def _cache_callable(
+        self, kind: str, function: t.Callable[..., str]
+    ) -> t.Callable[..., str]:
+        @pass_context
+        def cached(context: Context, *args: t.Any) -> str:
+            environment = context.environment
+            capacity = environment.i18n_cache_size  # type: ignore
+            if capacity == 0:
+                return t.cast(str, context.call(function, *args))
+            key = (kind, environment.i18n_cache_partition, args)  # type: ignore
+            cache = environment.i18n_translation_cache  # type: ignore
+            try:
+                result = cache.pop(key)
+            except KeyError:
+                result = t.cast(str, context.call(function, *args))
+            cache[key] = result
+            while len(cache) > capacity:
+                cache.popitem(last=False)
+            return t.cast(str, result)
+
+        return cached
