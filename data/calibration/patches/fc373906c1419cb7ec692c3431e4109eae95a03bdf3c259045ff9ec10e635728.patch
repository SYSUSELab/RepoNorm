diff --git a/tests/test_n4c_author_translation_cache.py b/tests/test_n4c_author_translation_cache.py
new file mode 100644
index 00000000..8fc021b4
--- /dev/null
+++ b/tests/test_n4c_author_translation_cache.py
@@ -0,0 +1,119 @@
+import pytest
+
+from jinja2 import Environment
+
+
+def make_environment(capacity=2):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    def gettext(message):
+        seen.append(message)
+        return message
+
+    env.install_gettext_callables(
+        gettext, lambda one, many, n: one if n == 1 else many, cache_size=capacity
+    )
+    return env, seen
+
+
+def test_cache_lru_and_immediate_resize():
+    env, seen = make_environment()
+    template = env.from_string("{{ gettext(message) }}")
+    for message in ("a", "b", "a", "c", "b"):
+        template.render(message=message)
+    assert seen == ["a", "b", "c", "b"]
+    env.resize_translation_cache(0)
+    template.render(message="b")
+    template.render(message="b")
+    assert seen[-2:] == ["b", "b"]
+
+
+@pytest.mark.parametrize("capacity", [-1, True, 1.5, "2"])
+def test_cache_rejects_invalid_capacity(capacity):
+    env, _ = make_environment()
+    with pytest.raises(ValueError):
+        env.resize_translation_cache(capacity)
+
+
+def test_cache_partition_and_provider_lifecycle():
+    env, seen = make_environment()
+    template = env.from_string('{{ gettext("x") }}')
+    template.render()
+    template.render()
+    env.set_translation_cache_partition("fr")
+    template.render()
+    assert seen == ["x", "x"]
+    env.install_gettext_callables(
+        lambda value: "new", lambda one, many, n: many, cache_size=2
+    )
+    assert template.render() == "new"
+    env.uninstall_gettext_translations(None)
+    assert "gettext" not in env.globals
+
+
+def test_overlay_render_and_reinstallation_are_independent():
+    env, seen = make_environment()
+    parent = env.from_string('{{ gettext("x") }}')
+    parent.render()
+    overlay = env.overlay()
+    overlay.clear_translation_cache()
+    assert overlay.from_string('{{ gettext("x") }}').render() == "x"
+    assert seen == ["x", "x"]
+    assert parent.render() == "x"
+    assert seen == ["x", "x"]
+    overlay.install_gettext_callables(
+        lambda value: "overlay", lambda one, many, n: many, cache_size=1
+    )
+    assert overlay.from_string('{{ gettext("x") }}').render() == "overlay"
+    assert parent.render() == "x"
+
+
+def test_raw_cache_preserves_each_render_formatting_and_escape():
+    env, seen = make_environment()
+    env.install_gettext_callables(
+        lambda value: seen.append(value) or "<b>%(name)s</b>",
+        lambda one, many, n: many,
+        newstyle=True,
+        cache_size=2,
+    )
+    template = env.from_string(
+        '{% autoescape escape %}{{ gettext("x", name=name) }}{% endautoescape %}'
+    )
+    assert template.render(name="<one>", escape=True) == "<b>&lt;one&gt;</b>"
+    assert template.render(name="<two>", escape=False) == "<b><two></b>"
+    assert seen == ["x"]
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_all_provider_kinds_context_count_and_clear(newstyle):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    calls = {"g": 0, "n": 0, "p": 0, "np": 0}
+
+    def provider(kind):
+        def translate(*args):
+            calls[kind] += 1
+            return "translated"
+
+        return translate
+
+    env.install_gettext_callables(
+        provider("g"),
+        provider("n"),
+        pgettext=provider("p"),
+        npgettext=provider("np"),
+        cache_size=16,
+        newstyle=newstyle,
+    )
+    template = env.from_string(
+        '{{ gettext("x") }}{{ ngettext("x", "xs", n) }}'
+        '{{ pgettext(context, "x") }}{{ npgettext(context, "x", "xs", n) }}'
+    )
+    template.render(context="a", n=1)
+    template.render(context="a", n=1)
+    assert calls == {"g": 1, "n": 1, "p": 1, "np": 1}
+    template.render(context="b", n=2)
+    assert calls == {"g": 1, "n": 2, "p": 2, "np": 2}
+    env.clear_translation_cache()
+    template.render(context="b", n=2)
+    assert calls == {"g": 2, "n": 3, "p": 3, "np": 3}
