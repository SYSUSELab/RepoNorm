diff --git a/tests/test_n4c_author_option_conflicts.py b/tests/test_n4c_author_option_conflicts.py
new file mode 100644
index 0000000..ca5b296
--- /dev/null
+++ b/tests/test_n4c_author_option_conflicts.py
@@ -0,0 +1,61 @@
+import pytest
+
+import click
+
+
+def test_command_line_and_prompt_conflict(runner):
+    @click.command()
+    @click.option("--left", prompt=True, conflicts_with=["right"])
+    @click.option("--right", is_flag=True)
+    def cli(left, right):
+        pass
+
+    result = runner.invoke(cli, ["--right"], input="value\n")
+    assert result.exit_code == 2
+    assert "cannot be used together" in result.output
+
+
+@pytest.mark.parametrize("source", ["default", "env", "default_map"])
+def test_non_explicit_sources_do_not_conflict(runner, source):
+    kwargs = (
+        {"default": True}
+        if source == "default"
+        else ({"envvar": "RIGHT"} if source == "env" else {})
+    )
+    settings = {"default_map": {"right": True}} if source == "default_map" else {}
+
+    @click.command(context_settings=settings)
+    @click.option("--left", is_flag=True, conflicts_with=["right"])
+    @click.option("--right", is_flag=True, **kwargs)
+    def cli(left, right):
+        click.echo("ok")
+
+    assert (
+        runner.invoke(
+            cli, ["--left"], env={"RIGHT": "1"} if source == "env" else None
+        ).output
+        == "ok\n"
+    )
+
+
+def test_invalid_unknown_and_self_declarations(runner):
+    for value in ("other", ["--other"], [1]):
+        with pytest.raises(TypeError):
+            click.Option(["--left"], conflicts_with=value)
+    for target in ("missing", "left"):
+
+        @click.command()
+        @click.option("--left", conflicts_with=[target])
+        def cli(left):
+            pass
+
+        assert isinstance(
+            runner.invoke(cli, standalone_mode=False).exception, click.UsageError
+        )
+
+
+def test_info_dict_always_exposes_list():
+    assert click.Option(["--left"]).to_info_dict()["conflicts_with"] == []
+    assert click.Option(["--left"], conflicts_with=["right"]).to_info_dict()[
+        "conflicts_with"
+    ] == ["right"]
