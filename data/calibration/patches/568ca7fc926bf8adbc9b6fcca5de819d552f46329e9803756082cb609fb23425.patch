index 000000000..276b1d0a4
--- /dev/null
+++ b/tests/propose/test_grounded_proposer_history_limit_contribution.py
@@ -0,0 +1,27 @@
+import pytest
+
+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+from dspy.utils.dummies import DummyLM
+
+
+def make_proposer(**kwargs):
+    return GroundedProposer(
+        prompt_model=DummyLM([{"proposed_instruction": "instruction"}]),
+        program=dspy.Predict("question -> answer"),
+        trainset=[],
+        program_aware=False,
+        use_dataset_summary=False,
+        **kwargs,
+    )
+
+
+@pytest.mark.parametrize(("configured", "expected"), [(-4, 0), (0, 0), (7, 7), (99, 20)])
+def test_history_limit_is_clamped(configured, expected):
+    assert make_proposer(max_instruct_history=configured).max_instruct_history == expected
+
+
+@pytest.mark.parametrize("invalid", [True, 1.5, "5", None])
+def test_history_limit_rejects_non_integer_values(invalid):
+    with pytest.raises(ValueError, match="integer"):
+        make_proposer(max_instruct_history=invalid)
