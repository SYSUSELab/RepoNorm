diff --git a/tests/test_n4c_author_edit_monitor.py b/tests/test_n4c_author_edit_monitor.py
new file mode 100644
index 0000000..3334c22
--- /dev/null
+++ b/tests/test_n4c_author_edit_monitor.py
@@ -0,0 +1,86 @@
+import os
+
+import pytest
+
+import click
+
+
+class _Process:
+    pid = 1011
+
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def test_start_terminate_order_and_payload(monkeypatch):
+    events = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process())
+    click.edit(
+        filename="one", editor="editor", monitor_process=lambda *e: events.append(e)
+    )
+    assert [event[0] for event in events] == ["start", "terminate"]
+    assert all(event[1:3] == (1011, "editor") for event in events)
+    assert all(isinstance(event[3], float) for event in events)
+
+
+def test_callback_errors_warn_and_later_events_continue(monkeypatch):
+    events = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process())
+
+    def callback(event, *args):
+        events.append(event)
+        raise RuntimeError(event)
+
+    with pytest.warns(UserWarning) as seen:
+        click.edit(filename="one", editor="editor", monitor_process=callback)
+    assert events == ["start", "terminate"]
+    assert len(seen) == 2
+
+
+def test_invalid_callback_rejected_before_launch(monkeypatch):
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: pytest.fail("must not launch")
+    )
+    with pytest.raises(TypeError, match="must be callable"):
+        click.edit(filename="one", monitor_process=object())
+
+
+def test_nonzero_exit_still_terminates_then_raises(monkeypatch):
+    events = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process(7))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(
+            filename="one",
+            editor="editor",
+            monitor_process=lambda event, *args: events.append(event),
+        )
+    assert events == ["start", "terminate"]
+
+
+@pytest.mark.skipif(os.name == "nt", reason="fixed POSIX stopped-state protocol")
+def test_real_suspend_resume_protocol(tmp_path):
+    script = tmp_path / "monitor.py"
+    output = tmp_path / "ready"
+    script.write_text(
+        "import os, signal, sys, time\n"
+        "child = os.fork()\n"
+        "if child == 0:\n"
+        "    time.sleep(0.2)\n"
+        "    os.kill(os.getppid(), signal.SIGCONT)\n"
+        "    os._exit(0)\n"
+        "open(sys.argv[1], 'w').write('ready')\n"
+        "os.kill(os.getpid(), signal.SIGSTOP)\n"
+        "os.waitpid(child, 0)\n"
+        "time.sleep(0.2)\n"
+    )
+    events = []
+    click.edit(
+        filename=str(output),
+        editor=f"exec python {script}",
+        monitor_process=lambda event, *args: events.append(event),
+    )
+    assert output.read_text() == "ready"
+    assert events == ["start", "suspend", "resume", "terminate"]
