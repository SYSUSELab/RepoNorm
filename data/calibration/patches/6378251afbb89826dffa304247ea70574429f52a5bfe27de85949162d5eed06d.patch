diff --git a/tests/test_n4c_author_edit_multiple.py b/tests/test_n4c_author_edit_multiple.py
new file mode 100644
index 0000000..3003742
--- /dev/null
+++ b/tests/test_n4c_author_edit_multiple.py
@@ -0,0 +1,54 @@
+import shlex
+
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def _argv(call):
+    command = call[0]
+    return shlex.split(command) if isinstance(command, str) else list(command)
+
+
+def test_multiple_filenames_are_one_safe_editor_invocation(monkeypatch):
+    filenames = ["plain.txt", "space name.txt", "$(touch marker).txt", "line\nbreak"]
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen",
+        lambda *args, **kwargs: calls.append((args[0], kwargs)) or _Process(),
+    )
+
+    click.edit(filename=(name for name in filenames), editor="editor --wait")
+
+    assert len(calls) == 1
+    assert _argv(calls[0]) == ["editor", "--wait", *filenames]
+
+
+@pytest.mark.parametrize("filename, error", [([], ValueError), (["ok", 3], TypeError)])
+def test_invalid_filename_iterables_do_not_launch(monkeypatch, filename, error):
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *args, **kwargs: pytest.fail("must not launch")
+    )
+    with pytest.raises(error):
+        click.edit(filename=filename, editor="editor")
+
+
+def test_multiple_filenames_preserve_environment_and_exit_error(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen",
+        lambda *args, **kwargs: calls.append((args[0], kwargs)) or _Process(3),
+    )
+
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename=["one", "two"], editor="editor", env={"EDIT_TEST": "1"})
+
+    assert calls[0][1]["env"]["EDIT_TEST"] == "1"
