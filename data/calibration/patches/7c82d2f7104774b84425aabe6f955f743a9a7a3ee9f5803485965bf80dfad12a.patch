diff --git a/tests/test_n4c_author_translation_domain.py b/tests/test_n4c_author_translation_domain.py
new file mode 100644
index 00000000..db489de7
--- /dev/null
+++ b/tests/test_n4c_author_translation_domain.py
@@ -0,0 +1,103 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import pass_context
+from jinja2 import TemplateAssertionError
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_domain_singular_plural_and_ordinary_regression(newstyle):
+    calls = []
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.install_gettext_callables(
+        lambda message: calls.append(("gettext", message)) or message,
+        lambda singular, plural, count: singular if count == 1 else plural,
+        newstyle=newstyle,
+        dgettext=lambda domain, message: calls.append(("dgettext", domain, message))
+        or message,
+        dngettext=lambda domain, singular, plural, count: calls.append(
+            ("dngettext", domain, singular, plural, count)
+        )
+        or plural,
+    )
+    singular = env.from_string(
+        '{% trans domain="admin", name=user %}Hi {{ name }}{% endtrans %}'
+    )
+    plural_source = (
+        '{% trans n=2, domain="shop", trimmed %}\n'
+        "One{% pluralize %}\nMany{% endtrans %}"
+    )
+    plural = env.from_string(plural_source)
+    ordinary = env.from_string("{% trans %}Plain{% endtrans %}")
+
+    assert singular.render(user="A") == "Hi A"
+    assert plural.render() == "Many"
+    assert ordinary.render() == "Plain"
+    assert calls == [
+        ("dgettext", "admin", "Hi %(name)s"),
+        ("dngettext", "shop", "One", "Many", 2),
+        ("gettext", "Plain"),
+    ]
+
+
+def test_domain_fallback_reinstall_and_uninstall():
+    calls = []
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.install_gettext_callables(
+        lambda message: calls.append(message) or f"old:{message}",
+        lambda singular, plural, count: plural,
+    )
+    template = env.from_string('{% trans domain="admin" %}Hello{% endtrans %}')
+    assert template.render() == "old:Hello"
+    assert calls == ["Hello"]
+
+    env.install_gettext_callables(
+        lambda message: f"new:{message}",
+        lambda singular, plural, count: plural,
+    )
+    assert template.render() == "new:Hello"
+    env.uninstall_gettext_translations(None)
+    assert "dgettext" not in env.globals
+    assert "dngettext" not in env.globals
+
+
+@pytest.mark.parametrize(
+    ("source", "match"),
+    [
+        ('{% trans domain="a", domain="b" %}x{% endtrans %}', "domain.*twice"),
+        ("{% trans domain=name %}x{% endtrans %}", "domain.*string.*literal"),
+    ],
+)
+def test_domain_declaration_errors(source, match):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    with pytest.raises(TemplateAssertionError, match=match):
+        env.from_string(source)
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+@pytest.mark.parametrize("escape", [False, True])
+def test_domain_fallback_keeps_existing_decorated_providers(newstyle, escape):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    @pass_context
+    def gettext(context, message):
+        seen.append(context.environment)
+        return "<b>%(name)s</b>"
+
+    @pass_context
+    def ngettext(context, singular, plural, count):
+        seen.append(context.environment)
+        return "<b>%(name)s</b>"
+
+    env.install_gettext_callables(gettext, ngettext, newstyle=newstyle)
+    source = (
+        '{% autoescape escape %}{% trans domain="admin", n=2, name=name %}'
+        "one{% pluralize %}many{% endtrans %}{% endautoescape %}"
+    )
+    domain_result = env.from_string(source).render(name="<x>", escape=escape)
+    plain_result = env.from_string(source.replace('domain="admin", ', "")).render(
+        name="<x>", escape=escape
+    )
+    assert domain_result == plain_result
+    assert seen == [env, env]
