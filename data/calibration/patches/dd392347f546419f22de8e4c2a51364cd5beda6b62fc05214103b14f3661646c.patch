index 0000000..bb7e1c7
--- /dev/null
+++ b/tests/test_n4c_author_option_validators.py
@@ -0,0 +1,87 @@
+import pytest
+
+import click
+
+
+def test_validators_run_after_callback_and_transform_in_order(runner):
+    events = []
+
+    def callback(ctx, param, value):
+        events.append(("callback", value))
+        return value + 1
+
+    def double(ctx, param, value):
+        events.append(("double", value))
+        return value * 2
+
+    @click.command()
+    @click.option("--number", type=int, callback=callback, validators=[double])
+    def cli(number):
+        click.echo(number)
+
+    result = runner.invoke(cli, ["--number", "3"])
+    assert result.exit_code == 0
+    assert result.output == "8\n"
+    assert events == [("callback", 3), ("double", 4)]
+
+
+def test_multiple_value_is_validated_once_as_a_tuple(runner):
+    seen = []
+
+    def join(ctx, param, value):
+        seen.append(value)
+        return ":".join(value)
+
+    @click.command()
+    @click.option("--item", multiple=True, validators=[join])
+    def cli(item):
+        click.echo(item)
+
+    result = runner.invoke(cli, ["--item", "a", "--item", "b"])
+    assert result.exit_code == 0
+    assert result.output == "a:b\n"
+    assert seen == [("a", "b")]
+
+
+def test_bad_parameter_retries_prompt_without_double_validation(runner):
+    seen = []
+
+    def positive(ctx, param, value):
+        seen.append(value)
+        if value <= 0:
+            raise click.BadParameter("must be positive")
+        return value
+
+    @click.command()
+    @click.option("--number", type=int, prompt=True, validators=[positive])
+    def cli(number):
+        click.echo(number)
+
+    result = runner.invoke(cli, input="-1\n2\n")
+    assert result.exit_code == 0
+    assert result.output.endswith("2\n")
+    assert seen == [-1, 2]
+
+
+def test_invalid_validator_inputs_are_rejected_at_construction():
+    for value in ("validator", [lambda c, p, v: v, None], [object()]):
+        with pytest.raises(TypeError, match="sequence of callables"):
+            click.Option(["--value"], validators=value)
+
+
+def test_none_and_empty_sequences_preserve_existing_callback(runner):
+    for validators in (None, []):
+
+        @click.command()
+        @click.option(
+            "--value",
+            type=int,
+            callback=lambda ctx, param, value: value * 2,
+            validators=validators,
+        )
+        def cli(value):
+            click.echo(value)
+
+        result = runner.invoke(cli, ["--value", "4"])
+        assert result.exit_code == 0
+        assert result.output == "8\n"
