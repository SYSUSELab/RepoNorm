@@ -516,12 +523,55 @@ class Editor:
             environ.update(self.env)
 
         try:
-            c = subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True)
-            exit_code = c.wait()
+            popen_kwargs: dict[str, t.Any] = {}
+
+            # A shell is used for compatibility with editor configurations such
+            # as ``vim -f``. Start a new POSIX session for timed calls so that a
+            # timeout can stop the editor and any children started by the shell.
+            if self.timeout is not None and not WIN:
+                popen_kwargs["start_new_session"] = True
+
+            c = subprocess.Popen(
+                f'{editor} "{filename}"',
+                env=environ,
+                shell=True,
+                **popen_kwargs,
+            )
+            exit_code = c.wait(timeout=self.timeout)
             if exit_code != 0:
                 raise ClickException(
                     _("{editor}: Editing failed").format(editor=editor)
                 )
+        except subprocess.TimeoutExpired:
+            if WIN:
+                c.terminate()
+            else:
+                import signal
+
+                try:
+                    os.killpg(c.pid, signal.SIGTERM)
+                except ProcessLookupError:
+                    pass
+
+            try:
+                c.wait(timeout=1)
+            except subprocess.TimeoutExpired:
+                if WIN:
+                    c.kill()
+                else:
+                    try:
+                        os.killpg(c.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+
+                # Reap the process after forceful termination.
+                c.wait()
+
+            raise ClickException(
+                _("{editor}: Editing timed out after {timeout} seconds").format(
+                    editor=editor, timeout=self.timeout
+                )
+            ) from None
         except OSError as e:
             raise ClickException(
                 _("{editor}: Editing failed: {e}").format(editor=editor, e=e)
