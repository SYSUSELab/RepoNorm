@@ -0,0 +1,21 @@
+import pytest
+from pydantic import ValidationError
+
+from dspy.adapters.types.tool import ToolCalls
+
+
+def test_first_fenced_block_is_normalized_without_changing_output_shape():
+    text = 'prefix\n```JSON\n[{"name":"first","args":{}},{"name":"second","args":{"x":1}}]\n```\nsuffix'
+
+    calls = ToolCalls.model_validate(text)
+
+    assert [item.name for item in calls.tool_calls] == ["first", "second"]
+    assert calls.format()[0]["type"] == "tool_calls"
+
+
+def test_invalid_first_fence_is_not_skipped_for_a_later_valid_one():
+    text = '```json\nnot json\n```\n```json\n{"name":"later","args":{}}\n```'
+
+    assert ToolCalls.validate_input(text) == text
+    with pytest.raises(ValidationError):
+        ToolCalls.model_validate(text)
