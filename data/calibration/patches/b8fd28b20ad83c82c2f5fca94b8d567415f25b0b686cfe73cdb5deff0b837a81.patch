     class ToolCall(BaseModel):
         name: str
         args: dict[str, Any]
 
     tool_calls: list[ToolCall]
 
+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Extract ordinary JSON or the first complete multiline fenced block."""
+        if not isinstance(data, str):
+            return data
+        try:
+            return json.loads(data)
+        except json.JSONDecodeError:
+            pass
+        opening = data.find("`" * 3)
+        if opening < 0:
+            return data
+        newline = data.find("\n", opening + 3)
+        closing = data.find("```", opening + 3)
+        if newline < 0 or closing < newline:
+            return data
+        try:
+            return json.loads(data[newline + 1 : closing].strip())
+        except json.JSONDecodeError:
+            return data
+
+    @model_validator(mode="before")
+    @classmethod
+    def _normalize_input(cls, data: Any):
+        parsed = cls.validate_input(data)
+        if isinstance(parsed, list):
+            return {"tool_calls": parsed}
+        if isinstance(parsed, dict) and "tool_calls" not in parsed and "name" in parsed and "args" in parsed:
+            return {"tool_calls": [parsed]}
+        return parsed
+
