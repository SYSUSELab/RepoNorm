diff --git a/tests/test_n4c_author_edit_backup.py b/tests/test_n4c_author_edit_backup.py
new file mode 100644
index 0000000..4e35d48
--- /dev/null
+++ b/tests/test_n4c_author_edit_backup.py
@@ -0,0 +1,69 @@
+import os
+
+import pytest
+
+import click
+
+
+class _Process:
+    def wait(self):
+        return 0
+
+
+def test_backup_precedes_launch_and_preserves_metadata(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("before")
+    path.chmod(0o640)
+
+    def launch(*args, **kwargs):
+        (backup,) = tmp_path.glob("note.txt.backup.*")
+        assert backup.read_text() == "before"
+        assert backup.stat().st_mode & 0o777 == 0o640
+        return _Process()
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    click.edit(filename=str(path), editor="editor", auto_backup=True)
+
+
+def test_backups_do_not_overwrite_and_default_remains_off(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("first")
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process())
+
+    click.edit(filename=str(path), editor="editor")
+    assert not list(tmp_path.glob("note.txt.backup.*"))
+
+    click.edit(filename=str(path), editor="editor", auto_backup=True)
+    path.write_text("second")
+    click.edit(filename=str(path), editor="editor", auto_backup=True)
+    assert {item.read_text() for item in tmp_path.glob("note.txt.backup.*")} == {
+        "first",
+        "second",
+    }
+
+
+def test_missing_direct_file_and_text_mode_skip_backup(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process())
+
+    click.edit(filename="new.txt", editor="editor", auto_backup=True)
+    click.edit("text", editor="editor", auto_backup=True)
+    assert not list(tmp_path.glob("*.backup.*"))
+
+
+def test_backup_oserror_is_chained_and_prevents_launch(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("before")
+    monkeypatch.setattr(
+        "shutil.copy2", lambda *a, **k: (_ for _ in ()).throw(OSError("full"))
+    )
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: pytest.fail("editor must not launch")
+    )
+
+    with pytest.raises(
+        click.ClickException, match="^Failed to create backup file"
+    ) as e:
+        click.edit(filename=os.fspath(path), editor="editor", auto_backup=True)
+
+    assert isinstance(e.value.__cause__, OSError)
