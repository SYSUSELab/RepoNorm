+    ed = Editor(
+        editor=editor,
+        env=env,
+        require_save=require_save,
+        extension=extension,
+        isolate_env=isolate_env,
+    )
 
     if filename is None:
         return ed.edit(text)
diff --git a/tests/test_n4c_author_edit_isolate_env.py b/tests/test_n4c_author_edit_isolate_env.py
new file mode 100644
index 0000000..a54d975
--- /dev/null
+++ b/tests/test_n4c_author_edit_isolate_env.py
@@ -0,0 +1,70 @@
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def test_isolation_is_exact_case_insensitive_allowlist(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "click._termui_impl.os.environ",
+        {"PATH": "/bin", "SystemRoot": "win", "TOKEN": "no", "MONKEY": "no"},
+    )
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(filename="one", editor="editor", isolate_env=True)
+    assert calls[0]["env"] == {"PATH": "/bin", "SystemRoot": "win"}
+
+
+def test_explicit_environment_is_applied_after_filter(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "click._termui_impl.os.environ", {"PATH": "parent", "TOKEN": "no"}
+    )
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(
+        filename="one",
+        editor="editor",
+        isolate_env=True,
+        env={"PATH": "chosen", "TOKEN": "explicit"},
+    )
+    assert calls[0]["env"] == {"PATH": "chosen", "TOKEN": "explicit"}
+
+
+def test_disabled_modes_preserve_existing_environment_behavior(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.os.environ", {"PARENT": "yes"})
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(filename="one", editor="editor")
+    click.edit(filename="one", editor="editor", env={"CHILD": "yes"})
+    assert calls[0]["env"] is None
+    assert calls[1]["env"] == {"PARENT": "yes", "CHILD": "yes"}
+
+
+def test_isolation_applies_to_text_and_preserves_nonzero_error(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "click._termui_impl.os.environ", {"PATH": "/bin", "SECRET": "no"}
+    )
+
+    def launch(*args, **kwargs):
+        calls.append(kwargs)
+        return _Process(0 if len(calls) == 1 else 7)
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    assert click.edit("text", editor="editor", isolate_env=True) is None
+    assert calls[0]["env"] == {"PATH": "/bin"}
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="one", editor="editor", isolate_env=True)
