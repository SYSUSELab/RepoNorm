diff --git a/tests/test_n4c_author_logical_paths.py b/tests/test_n4c_author_logical_paths.py
new file mode 100644
index 00000000..533ddce9
--- /dev/null
+++ b/tests/test_n4c_author_logical_paths.py
@@ -0,0 +1,77 @@
+import sys
+import zipfile
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import FileSystemLoader
+from jinja2 import PackageLoader
+from jinja2 import TemplateNotFound
+
+
+@pytest.mark.parametrize("name", ["child/../page", "child\\..\\page"])
+def test_safe_internal_parent_and_original_environment_keys(tmp_path, name):
+    (tmp_path / "page").write_text("hello")
+    env = Environment(loader=FileSystemLoader(tmp_path))
+    original = env.get_template("page")
+    other = env.get_template(name)
+    assert other.render() == "hello"
+    assert other is not original
+    assert env.get_template(name) is other
+
+
+@pytest.mark.parametrize("name", ["../secret", "child/../../secret"])
+def test_parent_escape_is_rejected_before_reading(tmp_path, name):
+    root = tmp_path / "root"
+    root.mkdir()
+    (tmp_path / "secret").write_text("outside")
+    with pytest.raises(TemplateNotFound) as caught:
+        FileSystemLoader(root).get_source(Environment(), name)
+    assert caught.value.name == name
+
+
+def test_safe_missing_retains_original_spelling(tmp_path):
+    name = "child\\..\\missing"
+    with pytest.raises(TemplateNotFound) as caught:
+        FileSystemLoader(tmp_path).get_source(Environment(), name)
+    assert caught.value.name == name
+
+
+@pytest.mark.parametrize("archive", [False, True])
+def test_package_parent_paths_keep_filename_and_freshness(
+    tmp_path, monkeypatch, archive
+):
+    name = "n4c_author_paths_pkg"
+    if archive:
+        path = tmp_path / "package.zip"
+        with zipfile.ZipFile(path, "w") as z:
+            z.writestr(name + "/__init__.py", "")
+            z.writestr(name + "/templates/page", "café".encode("latin-1"))
+    else:
+        path = tmp_path
+        directory = path / name / "templates"
+        directory.mkdir(parents=True)
+        (directory.parent / "__init__.py").write_text("")
+        (directory / "page").write_bytes("café".encode("latin-1"))
+    monkeypatch.syspath_prepend(str(path))
+    try:
+        loader = PackageLoader(name, encoding="latin-1")
+        text, filename, current = loader.get_source(Environment(), "child/../page")
+        assert text == "café"
+        assert filename.endswith("templates/page")
+        if archive:
+            assert current is None
+        else:
+            assert current() is True
+            (directory / "page").unlink()
+            assert current() is False
+    finally:
+        sys.modules.pop(name, None)
+
+
+def test_ascii_drive_prefix_does_not_reject_non_ascii_filename(tmp_path):
+    (tmp_path / "é:page").write_text("ordinary")
+    env = Environment(loader=FileSystemLoader(tmp_path))
+    assert env.get_template("é:page").render() == "ordinary"
+    with pytest.raises(TemplateNotFound):
+        env.get_template("C:page")
