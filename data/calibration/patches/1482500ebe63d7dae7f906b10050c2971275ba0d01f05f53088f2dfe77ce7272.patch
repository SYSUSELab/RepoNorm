diff --git a/tests/test_n4c_author_required_if.py b/tests/test_n4c_author_required_if.py
new file mode 100644
index 0000000..aecd252
--- /dev/null
+++ b/tests/test_n4c_author_required_if.py
@@ -0,0 +1,62 @@
+import pytest
+
+import click
+
+
+def test_mapping_uses_final_converted_values_independent_of_order(runner):
+    @click.command()
+    @click.option("--token", required_if={"amount": 2})
+    @click.option("--amount", type=int)
+    def cli(token, amount):
+        click.echo(token or "none")
+
+    assert runner.invoke(cli, ["--amount", "2"]).exit_code == 2
+    assert runner.invoke(cli, ["--amount", "2", "--token", "ok"]).output == "ok\n"
+    assert runner.invoke(cli, ["--amount", "1"]).output == "none\n"
+
+
+def test_predicate_sees_processed_value(runner):
+    seen = []
+
+    def condition(ctx, param):
+        seen.append((param.name, ctx.params["amount"]))
+        return ctx.params["amount"] > 10
+
+    @click.command()
+    @click.option("--token", required_if=condition)
+    @click.option("--amount", type=int, callback=lambda c, p, value: value * 2)
+    def cli(token, amount):
+        pass
+
+    result = runner.invoke(cli, ["--amount", "6"], standalone_mode=False)
+    assert isinstance(result.exception, click.MissingParameter)
+    assert seen == [("token", 12)]
+
+
+def test_configuration_validation_and_unknown_name(runner):
+    for value in ("mode", [("mode", "x")]):
+        with pytest.raises(TypeError):
+            click.Option(["--target"], required_if=value)
+    for value in ({"--mode": "x"}, {1: "x"}):
+        with pytest.raises(TypeError):
+            click.Option(["--target"], required_if=value)
+
+    @click.command()
+    @click.option("--target", required_if={"missing": True})
+    def cli(target):
+        pass
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert isinstance(result.exception, click.UsageError)
+
+
+def test_none_empty_and_existing_required_behavior(runner):
+    @click.command()
+    @click.option("--optional", required_if=None)
+    @click.option("--empty", required_if={})
+    @click.option("--always", required=True)
+    def cli(optional, empty, always):
+        click.echo(always)
+
+    assert runner.invoke(cli).exit_code == 2
+    assert runner.invoke(cli, ["--always", "yes"]).output == "yes\n"
