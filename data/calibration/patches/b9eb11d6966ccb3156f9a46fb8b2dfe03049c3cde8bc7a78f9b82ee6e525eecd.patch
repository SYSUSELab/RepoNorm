@@ -0,0 +1,40 @@
+import dspy
+from dspy.propose.grounded_proposer import DescribeModule, DescribeProgram, GroundedProposer
+from dspy.utils.dummies import DummyLM
+
+
+class MinimalRNG:
+    def __init__(self, values):
+        self.values = iter(values)
+
+    def random(self):
+        return next(self.values)
+
+
+def make_proposer(values):
+    return GroundedProposer(
+        prompt_model=DummyLM([{"proposed_instruction": "instruction"}]),
+        program=dspy.Predict("question -> answer"),
+        trainset=[],
+        program_aware=False,
+        use_dataset_summary=False,
+        rng=MinimalRNG(values),
+    )
+
+
+def test_cache_salts_use_injected_rng_and_are_reproducible():
+    first = make_proposer([0.125, 0.5])
+    second = make_proposer([0.125, 0.5])
+
+    first_sequence = [first._cache_salt(0, 0), first._cache_salt(0, 0)]
+    second_sequence = [second._cache_salt(0, 0), second._cache_salt(0, 0)]
+
+    assert first_sequence == second_sequence
+    assert first_sequence[0] != first_sequence[1]
+    assert all(value and value.isascii() for value in first_sequence)
+
+
+def test_description_signatures_expose_the_ignorable_cache_salt():
+    for signature in (DescribeProgram, DescribeModule):
+        field = signature.fields["cache_salt"]
+        assert field.json_schema_extra["prefix"] == "CACHE SALT (IGNORE):"
