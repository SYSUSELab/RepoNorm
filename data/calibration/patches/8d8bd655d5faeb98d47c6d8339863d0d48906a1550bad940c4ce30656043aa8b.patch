index 000000000..42f3dce6c
--- /dev/null
+++ b/tests/adapters/test_tool_coercion_contribution.py
@@ -0,0 +1,23 @@
+import pytest
+
+from dspy.adapters.types.tool import Tool
+
+
+@pytest.mark.asyncio
+async def test_sync_and_async_calls_share_non_mutating_coercion():
+    def describe(enabled: bool, count: int, seconds: float):
+        return enabled, count, seconds
+
+    tool = Tool(describe)
+    supplied = {"enabled": " TRUE ", "count": "9007199254740993", "seconds": "250 ms"}
+
+    assert tool(**supplied) == (True, 9007199254740993, 0.25)
+    assert await tool.acall(**supplied) == (True, 9007199254740993, 0.25)
+    assert supplied == {"enabled": " TRUE ", "count": "9007199254740993", "seconds": "250 ms"}
+
+
+def test_string_fields_and_unknown_kwargs_are_not_coerced():
+    def echo(label: str, **kwargs):
+        return label, kwargs
+
+    assert Tool(echo)(label=" true ", extra="10 MB") == (" true ", {"extra": "10 MB"})
