+                context.prec = max(28, len(number) + 20)
+                parsed = Decimal(number)
+                factors = {
+                    None: "1",
+                    "ms": "0.001",
+                    "s": "1",
+                    "m": "60",
+                    "h": "3600",
+                    "KB": "1000",
+                    "MB": "1000000",
+                    "GB": "1000000000",
+                }
