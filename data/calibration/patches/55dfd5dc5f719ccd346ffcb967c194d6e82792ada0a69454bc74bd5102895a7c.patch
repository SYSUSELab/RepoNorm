+class TranslationExtractorExtension(Extension):
+    """Mark messages for stateless, structured extraction.
+
+    Marker bodies render normally. Installed Environment methods accept
+    source text or an AST, or read logical names from its loader.
+
+    .. versionadded:: 3.1
+    """
+
+    tags = {"extract"}
+
+    def __init__(self, environment: Environment) -> None:
+        super().__init__(environment)
+        environment.extend(extract_marked_translations=self._extract_marked)
+        environment.extend(
+            extract_marked_translations_from_templates=self._extract_templates
+        )
+
+    def _extract_templates(
+        self, names: t.Optional[t.Iterable[str]] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Extract markers from logical names without rendering.
+
+        Explicit names need no loader listing. Sources identify logical
+        names even when the loader provides no physical filename.
+        """
+        loader = self.environment.loader
+        assert loader is not None, "No loader configured."
+        if names is None:
+            names = self.environment.list_templates()
+        for name in names:
+            source, _, _ = loader.get_source(self.environment, name)
+            yield from self._extract_marked(source, name)
+
+    def parse(self, parser: "Parser") -> nodes.Scope:
+        """Parse constant metadata and an ordinary marker body."""
+        lineno = next(parser.stream).lineno
+        metadata: t.Dict[str, t.Any] = {}
+        while parser.stream.current.type != "block_end":
+            if metadata:
+                parser.stream.expect("comma")
+            token = parser.stream.expect("name")
+            if token.value in metadata:
+                parser.fail(
+                    f"extract metadata {token.value!r} defined twice", token.lineno
+                )
+            parser.stream.expect("assign")
+            value = parser.parse_expression()
+            try:
+                metadata[token.value] = value.as_const(
+                    nodes.EvalContext(self.environment)
+                )
+            except nodes.Impossible:
+                parser.fail(
+                    f"extract metadata {token.value!r} must be a compile-time constant",
+                    token.lineno,
+                )
+        body = list(parser.parse_statements(("name:endextract",), drop_needle=True))
+        scope = nodes.Scope(body, lineno=lineno)
+        scope.extract_metadata = metadata  # type: ignore[attr-defined]
+        return scope
+
+    def _extract_marked(
+        self, source: t.Union[str, nodes.Template], source_name: t.Optional[str] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        """Yield fresh marker records for source text or an AST.
+
+        Metadata and messages are independent of later extractions.
+        ``source_name`` identifies the source without changing parsing.
+        """
+        if isinstance(source, str):
+            source = self.environment.parse(source)
+        for scope in source.find_all(nodes.Scope):
+            metadata = getattr(scope, "extract_metadata", None)
+            if metadata is None:
+                continue
+            messages = [
+                {"lineno": lineno, "function": function, "message": message}
+                for lineno, function, message in extract_from_ast(
+                    nodes.Template(scope.body)
+                )
+            ]
+            yield {
+                "source": source_name,
+                "lineno": scope.lineno,
+                "metadata": deepcopy(metadata),
+                "messages": messages,
+            }
+
+
 def extract_from_ast(
