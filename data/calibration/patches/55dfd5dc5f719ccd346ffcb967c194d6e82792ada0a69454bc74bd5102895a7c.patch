@@ -0,0 +1,65 @@
+import pytest
+
+from jinja2 import DictLoader
+from jinja2 import Environment
+from jinja2 import FunctionLoader
+from jinja2 import TemplateSyntaxError
+
+
+def environment(loader=None):
+    env = Environment(
+        loader=loader, extensions=["jinja2.ext.i18n", "jinja2.ext.extractor"]
+    )
+    env.install_null_translations()
+    return env
+
+
+@pytest.mark.parametrize(
+    "metadata", ["priority=-2", 'note=["first", "second"]', 'data={"x": 1}']
+)
+def test_compile_time_values_and_ast_record_independence(metadata):
+    env = environment()
+    source = "{% extract " + metadata + ' %}{{ gettext("Open") }}{% endextract %}'
+    ast = env.parse(source)
+    first = list(env.extract_marked_translations(ast))
+    pristine = list(env.extract_marked_translations(ast))
+    value = next(iter(first[0]["metadata"].values()))
+    if isinstance(value, list):
+        value.append("changed")
+    elif isinstance(value, dict):
+        value["changed"] = True
+    first[0]["metadata"]["new"] = True
+    first[0]["messages"][0]["message"] = "changed"
+    assert list(env.extract_marked_translations(ast)) == pristine
+    assert env.from_string(source).render() == "Open"
+
+
+@pytest.mark.parametrize("bad", ["note=missing", 'note="a", note="b"'])
+def test_metadata_errors_name_key(bad):
+    with pytest.raises(TemplateSyntaxError, match="note"):
+        environment().parse("{% extract " + bad + " %}text{% endextract %}")
+
+
+def test_source_is_extracted_without_render_or_dependency_loading():
+    source = (
+        '{% include "missing" %}{% extract note="static" %}'
+        '{{ explode() }}{{ gettext("Open") }}{% endextract %}'
+    )
+    env = environment(DictLoader({"page": source}))
+    env.globals["explode"] = lambda: 1 / 0
+    assert (
+        list(env.extract_marked_translations_from_templates(["page"]))[0]["source"]
+        == "page"
+    )
+
+
+def test_explicit_names_do_not_require_loader_listing():
+    env = environment(
+        FunctionLoader(lambda name: '{% extract note="x" %}x{% endextract %}')
+    )
+    assert [
+        r["source"]
+        for r in env.extract_marked_translations_from_templates(iter(["b", "a"]))
+    ] == ["b", "a"]
+    with pytest.raises(TypeError):
+        list(env.extract_marked_translations_from_templates())
