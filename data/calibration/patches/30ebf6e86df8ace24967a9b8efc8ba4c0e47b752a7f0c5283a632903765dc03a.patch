@@ -187,10 +194,192 @@ class FileSystemLoader(BaseLoader):
         self.searchpath = [os.fspath(p) for p in searchpath]
         self.encoding = encoding
         self.followlinks = followlinks
+        # Whether to run the background watcher for automatic cache invalidation
+        self.auto_reload = auto_reload
+
+        # Monitoring state
+        self._environments: "weakref.WeakSet[Environment]" = weakref.WeakSet()
+        self._searchpath_abs = [os.path.abspath(p) for p in self.searchpath]
+        self._snapshot: t.Dict[str, t.Tuple[int, int]] = {}
+        self._lock = threading.Lock()
+        self._stop_event = threading.Event()
+        self._poll_interval = 0.5
+        self._watcher_thread: t.Optional[threading.Thread] = None
+
+        # Monitoring begins when an environment first loads from this loader.
+        # Disabled loaders neither scan nor retain environments.
+
+    def _register_environment(self, environment: "Environment") -> None:
+        """Track using environments with weak references."""
+        if self.auto_reload:
+            self._environments.add(environment)
+            self.start_monitoring()
+
+    def _build_snapshot(self) -> t.Dict[str, t.Tuple[int, int]]:
+        """Map absolute file paths to nanosecond mtimes and sizes."""
+        snapshot: t.Dict[str, t.Tuple[int, int]] = {}
+        for root in self._searchpath_abs:
+            if not os.path.isdir(root):
+                continue
+            for dirpath, _, filenames in os.walk(root, followlinks=self.followlinks):
+                for fname in filenames:
+                    fpath = os.path.join(dirpath, fname)
+                    try:
+                        stat = os.stat(fpath)
+                        snapshot[fpath] = (stat.st_mtime_ns, stat.st_size)
+                    except OSError:
+                        # File might have been removed between list and stat
+                        continue
+        return snapshot
+
+    def _path_to_template_name(self, abs_path: str) -> t.Optional[str]:
+        for root in self._searchpath_abs:
+            # Ensure root ends with a path separator when comparing prefixes
+            root_prefix = root.rstrip(os.path.sep) + os.path.sep
+            if abs_path.startswith(root_prefix) or abs_path == root:
+                rel = os.path.relpath(abs_path, root)
+                template = rel.replace(os.path.sep, "/")
+                return template
+        return None
+
+    def _invalidate_names(self, names: t.Set[str]) -> None:
+        if not names:
+            return
+        # Iterate over a list copy to avoid issues if the WeakSet changes
+        for env in list(self._environments):
+            cache = getattr(env, "cache", None)
+            if not cache:
+                continue
+            to_delete: t.List[t.Tuple[weakref.ref, str]] = []
+            for key in list(cache.keys()):
+                try:
+                    loader_ref, name = key
+                except Exception:
+                    continue
+                if name in names:
+                    obj = loader_ref()
+                    if obj is self:
+                        to_delete.append(key)
+            for key in to_delete:
+                try:
+                    del cache[key]
+                except Exception:
+                    pass
+
+    def _on_template_changed(self, file_paths: t.List[str]) -> None:
+        """Manual cache invalidation method for testing purposes.
+
+        Takes a list of absolute file paths that have changed and
+        invalidates corresponding template cache entries.
+        """
+        self.invalidate_changed(file_paths)
+
+    def scan_once(self) -> t.Set[str]:
+        """Compare a filesystem snapshot and invalidate changed names.
+
+        Return canonical names for added, deleted or modified files.
+        This explicit synchronous operation does not start a thread.
+
+        .. versionadded:: 3.1.0
+        """
+        with self._lock:
+            new_snapshot = self._build_snapshot()
+            old_snapshot = self._snapshot
+            added_paths = set(new_snapshot) - set(old_snapshot)
+            removed_paths = set(old_snapshot) - set(new_snapshot)
+            modified_paths = {
+                p for p, m in new_snapshot.items() if old_snapshot.get(p) != m
+            }
+            self._snapshot = new_snapshot
+
+        changed_paths = added_paths | removed_paths | modified_paths
+        changed_names: t.Set[str] = set()
+        for p in changed_paths:
+            name = self._path_to_template_name(p)
+            if name:
+                changed_names.add(name)
+        if changed_names:
+            self._invalidate_names(changed_names)
+        return changed_names
+
+    def start_monitoring(self) -> None:
+        """Start polling after recording the current filesystem state.
+
+        Repeated calls are harmless. A closed monitor can restart.
+        A loader with ``auto_reload=False`` does not start monitoring.
+
+        .. versionadded:: 3.1.0
+        """
+        if not self.auto_reload:
+            return
+        current = self._watcher_thread
+        if current is not None and current.is_alive():
+            return
+        self._snapshot = self._build_snapshot()
+        self._stop_event = threading.Event()
+        stop_event = self._stop_event
+        loader_ref = weakref.ref(self)
+
+        def watch() -> None:
+            while not stop_event.wait(0.5):
+                loader = loader_ref()
+                if loader is None:
+                    return
+                try:
+                    loader.scan_once()
+                except OSError:
+                    pass
+                finally:
+                    del loader
+
+        self._watcher_thread = threading.Thread(
+            target=watch,
+            name=f"jinja2.FileSystemLoader.watch.{id(self):x}",
+            daemon=True,
+        )
+        self._watcher_thread.start()
+
+    def invalidate_changed(self, file_paths: t.Iterable[str]) -> t.Set[str]:
+        """Invalidate absolute paths inside the configured search roots.
+
+        Return their canonical template names. Ignore outside paths;
+        leave other names and other loaders' cache entries unchanged.
+
+        .. versionadded:: 3.1.0
+        """
+        names = set()
+        for path in file_paths:
+            name = self._path_to_template_name(os.path.abspath(path))
+            if name is not None:
+                names.add(name)
+        self._invalidate_names(names)
+        return names
+
+    def close(self) -> None:
+        """Stop polling, allowing repeated calls and later restart.
+
+        Context-manager exit also closes the monitor.
+
+        .. versionadded:: 3.1.0
+        """
+        self._stop_event.set()
+        current = self._watcher_thread
+        if current is not None and current.is_alive():
+            current.join(timeout=1.0)
+        self._watcher_thread = None
+
+    def __enter__(self) -> "FileSystemLoader":
+        self.start_monitoring()
+        return self
+
+    def __exit__(self, *args: t.Any) -> None:
+        self.close()
 
     def get_source(
         self, environment: "Environment", template: str
     ) -> t.Tuple[str, str, t.Callable[[], bool]]:
+        # Register this environment to enable cache invalidation across instances
+        self._register_environment(environment)
         pieces = split_template_path(template)
         for searchpath in self.searchpath:
             filename = os.path.join(searchpath, *pieces)
diff --git a/tests/test_n4c_author_monitor.py b/tests/test_n4c_author_monitor.py
new file mode 100644
index 00000000..35d13ecd
--- /dev/null
+++ b/tests/test_n4c_author_monitor.py
@@ -0,0 +1,100 @@
+import gc
+import os
+import weakref
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import FileSystemLoader
+
+
+def test_manual_invalidation_preserves_unrelated_cache(tmp_path):
+    (tmp_path / "nested").mkdir()
+    path = tmp_path / "nested/.dot"
+    path.write_text("first")
+    (tmp_path / "other").write_text("other")
+    with FileSystemLoader(tmp_path) as loader:
+        env = Environment(loader=loader, auto_reload=False)
+        old = env.get_template("nested/.dot")
+        other = env.get_template("other")
+        path.write_text("second")
+        assert loader.invalidate_changed(
+            [str(path), str(tmp_path.parent / "outside")]
+        ) == {"nested/.dot"}
+        assert env.get_template("nested/.dot") is not old
+        assert env.get_template("nested/.dot").render() == "second"
+        assert env.get_template("other") is other
+
+
+def test_scan_with_no_environment_cache(tmp_path):
+    path = tmp_path / "page"
+    path.write_text("old")
+    with FileSystemLoader(tmp_path) as loader:
+        env = Environment(loader=loader, cache_size=0)
+        env.get_template("page")
+        path.unlink()
+        assert loader.scan_once() == {"page"}
+        assert env.cache is None
+
+
+def test_disabled_loader_does_not_start_thread(tmp_path, monkeypatch):
+    import threading
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("disabled loader started a thread")
+
+    monkeypatch.setattr(threading, "Thread", forbidden)
+    (tmp_path / "page").write_text("page")
+    loader = FileSystemLoader(tmp_path, auto_reload=False)
+    try:
+        assert Environment(loader=loader).get_template("page").render() == "page"
+        loader.start_monitoring()
+        loader.close()
+        loader.close()
+    finally:
+        loader.close()
+
+
+def test_weak_environment_lifetime(tmp_path):
+    (tmp_path / "page").write_text("page")
+    with FileSystemLoader(tmp_path) as loader:
+        env = Environment(loader=loader)
+        env.get_template("page")
+        ref = weakref.ref(env)
+        del env
+        gc.collect()
+        assert ref() is None
+
+
+def test_context_closes_on_exception(tmp_path):
+    loader = FileSystemLoader(tmp_path)
+    with pytest.raises(RuntimeError):
+        with loader:
+            raise RuntimeError("body")
+    assert loader._watcher_thread is None
+    loader.close()
+
+
+def test_explicit_restart_after_close(tmp_path):
+    loader = FileSystemLoader(tmp_path)
+    try:
+        loader.start_monitoring()
+        loader.start_monitoring()
+        loader.close()
+        loader.start_monitoring()
+        assert loader._watcher_thread.is_alive()
+    finally:
+        loader.close()
+
+
+def test_scan_detects_size_change_with_unchanged_timestamp(tmp_path):
+    path = tmp_path / "page"
+    path.write_text("a")
+    with FileSystemLoader(tmp_path) as loader:
+        env = Environment(loader=loader, auto_reload=False)
+        env.get_template("page")
+        stamp = path.stat().st_mtime_ns
+        path.write_text("longer text")
+        os.utime(path, ns=(stamp, stamp))
+        assert loader.scan_once() == {"page"}
+        assert env.get_template("page").render() == "longer text"
