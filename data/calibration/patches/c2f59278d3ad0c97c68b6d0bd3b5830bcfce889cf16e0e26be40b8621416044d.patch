index 000000000..8c351915b
--- /dev/null
+++ b/tests/propose/test_grounded_proposer_tip_logging_contribution.py
@@ -0,0 +1,49 @@
+from types import MethodType
+
+import pytest
+
+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+from dspy.utils.dummies import DummyLM
+
+
+class FixedRNG:
+    def choice(self, values):
+        return "creative"
+
+
+def run_proposal(verbose, capsys):
+    program = dspy.Predict("question -> answer")
+    proposer = GroundedProposer(
+        prompt_model=DummyLM([{"proposed_instruction": "unused"}]),
+        program=program,
+        trainset=[],
+        program_aware=False,
+        use_dataset_summary=False,
+        set_history_randomly=False,
+        verbose=verbose,
+        rng=FixedRNG(),
+    )
+    observed = []
+
+    def capture(self, **kwargs):
+        observed.append(kwargs["tip"])
+        return "instruction"
+
+    proposer.propose_instruction_for_predictor = MethodType(capture, proposer)
+    proposer.propose_instructions_for_program([], program, None, {}, N=1, T=0.5)
+    return observed, capsys.readouterr().out.splitlines()
+
+
+def test_verbose_tip_log_matches_the_tip_used_for_generation(capsys):
+    observed, lines = run_proposal(True, capsys)
+    selected_index = lines.index("Selected tip: creative")
+
+    assert lines[selected_index + 1] == f"Chosen tip: {observed[0]} (tip_key=creative)"
+
+
+@pytest.mark.parametrize("verbose", [False])
+def test_tip_selection_logs_are_silent_without_verbose(verbose, capsys):
+    _, lines = run_proposal(verbose, capsys)
+
+    assert not any(line.startswith(("Selected tip:", "Chosen tip:")) for line in lines)
