diff --git a/tests/test_n4c_author_edit_escape.py b/tests/test_n4c_author_edit_escape.py
new file mode 100644
index 0000000..b87a1f9
--- /dev/null
+++ b/tests/test_n4c_author_edit_escape.py
@@ -0,0 +1,68 @@
+import shlex
+
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+@pytest.mark.parametrize(
+    "filename",
+    ["", "two words", 'a"b', "a'b", "semi;colon", "$(marker)", "line\nbreak"],
+)
+def test_filename_is_one_literal_argument(filename, monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen",
+        lambda command, **kwargs: calls.append(command) or _Process(),
+    )
+    click.edit(filename=filename, editor="editor --wait", escape_shell=True)
+    assert shlex.split(calls[0]) == ["editor", "--wait", filename]
+
+
+def test_shell_payload_cannot_execute(tmp_path):
+    marker = tmp_path / "marker"
+    click.edit(filename=f"unused; touch {marker}", editor="true", escape_shell=True)
+    assert not marker.exists()
+
+
+def test_temporary_mode_environment_and_return_are_preserved(monkeypatch):
+    calls = []
+    monkeypatch.setenv("PARENT", "kept")
+    monkeypatch.setattr(
+        "subprocess.Popen",
+        lambda command, **kwargs: calls.append((command, kwargs)) or _Process(),
+    )
+    assert (
+        click.edit(
+            "text",
+            editor="editor -f",
+            env={"EXPLICIT": "added"},
+            escape_shell=True,
+        )
+        is None
+    )
+    assert shlex.split(calls[0][0])[:2] == ["editor", "-f"]
+    assert calls[0][1]["env"]["PARENT"] == "kept"
+    assert calls[0][1]["env"]["EXPLICIT"] == "added"
+
+
+def test_default_command_and_nonzero_failure_are_preserved(monkeypatch):
+    calls = []
+
+    def launch(command, **kwargs):
+        calls.append(command)
+        return _Process(0 if len(calls) == 1 else 7)
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    click.edit(filename="plain", editor="editor --wait")
+    assert calls[0] == 'editor --wait "plain"'
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="plain", editor="editor", escape_shell=True)
