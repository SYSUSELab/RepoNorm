diff --git a/tests/test_n4c_author_listing_filters.py b/tests/test_n4c_author_listing_filters.py
new file mode 100644
index 00000000..90cbcd66
--- /dev/null
+++ b/tests/test_n4c_author_listing_filters.py
@@ -0,0 +1,75 @@
+import re
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import loaders
+
+
+def test_nested_scope_restores_and_leaves_direct_load_available():
+    child = loaders.DictLoader({"a.html": "A", "b.txt": "B", "c.html": "C"})
+    child.add_filter("b.*")
+    parent = loaders.PrefixLoader({"site": child}, delimiter=":")
+    with parent.filter_scope(re.compile("a")):
+        assert parent.list_templates() == ["site:c.html"]
+        with parent.filter_scope(lambda name: name.endswith("c.html")):
+            assert parent.list_templates() == []
+            parent.clear_filters()
+        assert parent.list_templates() == ["site:c.html"]
+        assert Environment(loader=parent).get_template("site:a.html").render() == "A"
+    assert parent.list_templates() == ["site:a.html", "site:c.html"]
+
+
+def test_failed_entry_and_body_leave_configuration_intact():
+    loader = loaders.DictLoader({"a": "A", "b": "B"})
+    loader.add_filter("b")
+    with pytest.raises(TypeError):
+        with loader.filter_scope("a", object()):
+            pytest.fail("entry must fail")
+    assert loader.list_templates() == ["a"]
+    error = RuntimeError("body")
+    with pytest.raises(RuntimeError) as caught:
+        with loader.filter_scope("a"):
+            raise error
+    assert caught.value is error and loader.list_templates() == ["a"]
+
+
+def test_live_mapping_and_environment_include_predicate():
+    mapping = {"z.html": "Z", "a.txt": "A"}
+    loader = loaders.DictLoader(mapping)
+    loader.add_filter("*.txt")
+    mapping["m.html"] = "M"
+    env = Environment(loader=loader)
+    assert env.list_templates(filter_func=lambda name: name == "m.html") == ["m.html"]
+    with pytest.raises(TypeError):
+        env.list_templates(extensions=["html"], filter_func=lambda name: True)
+    loader.clear_filters()
+    assert loader.list_templates() == ["a.txt", "m.html", "z.html"]
+
+
+@pytest.mark.parametrize("kind", ["function", "module"])
+def test_filters_do_not_invent_listing_capability(tmp_path, kind):
+    loader = (
+        loaders.FunctionLoader(lambda name: "ok")
+        if kind == "function"
+        else loaders.ModuleLoader(tmp_path)
+    )
+    with loader.filter_scope("*"):
+        with pytest.raises(TypeError):
+            Environment(loader=loader).list_templates()
+
+
+def test_custom_child_delegation_without_new_base_init():
+    class Child(loaders.BaseLoader):
+        def __init__(self):
+            self.names = ["z.html", "a.txt"]
+
+        def list_templates(self):
+            return self.names[:]
+
+    child = Child()
+    parent = loaders.PrefixLoader({"site": child}, delimiter=":")
+    parent.add_filter("*.txt")
+    assert parent.list_templates() == ["site:z.html"]
+    child.names.append("m.html")
+    assert set(parent.list_templates()) == {"site:z.html", "site:m.html"}
