+    def _select_tip_with_weights(self):
+        tips = list(TIPS)
+        if self.tip_weights is None:
+            return self.rng.choice(tips)
+        weights = []
+        for tip in tips:
+            value = self.tip_weights.get(tip, 1.0)
+            valid = type(value) in (int, float) and value > 0
+            if isinstance(value, float):
+                valid = valid and math.isfinite(value)
+            weights.append(value if valid else 0.0)
+        largest = max(weights)
+        if largest == 0:
+            return self.rng.choice(tips)
+        weights = [value / largest for value in weights]
+        point = self.rng.random() * sum(weights)
+        last_positive = None
+        for tip, weight in zip(tips, weights, strict=False):
+            if weight:
+                last_positive = tip
+                if point < weight:
+                    return tip
+                point -= weight
+        return last_positive
