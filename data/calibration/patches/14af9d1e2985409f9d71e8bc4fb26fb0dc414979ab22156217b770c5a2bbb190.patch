+++ b/tests/propose/test_grounded_proposer_tip_weights_contribution.py
@@ -0,0 +1,57 @@
+import dspy
+from dspy.propose.grounded_proposer import GroundedProposer
+from dspy.utils.dummies import DummyLM
+
+
+class RecordingRNG:
+    def __init__(self, point=0.0):
+        self.point = point
+        self.choice_calls = 0
+
+    def random(self):
+        return self.point
+
+    def choice(self, values):
+        self.choice_calls += 1
+        return values[-1]
+
+
+def make_proposer(rng, tip_weights):
+    return GroundedProposer(
+        prompt_model=DummyLM([{"proposed_instruction": "instruction"}]),
+        program=dspy.Predict("question -> answer"),
+        trainset=[],
+        program_aware=False,
+        use_dataset_summary=False,
+        rng=rng,
+        tip_weights=tip_weights,
+    )
+
+
+def test_positive_weight_excludes_zero_weight_tips():
+    rng = RecordingRNG()
+    proposer = make_proposer(
+        rng, {"none": 0, "creative": 5, "simple": 0, "description": 0, "high_stakes": 0, "persona": 0}
+    )
+
+    assert proposer._select_tip_with_weights() == "creative"
+    assert rng.choice_calls == 0
+
+
+def test_all_unusable_weights_fall_back_to_uniform_selection():
+    rng = RecordingRNG()
+    proposer = make_proposer(
+        rng,
+        {
+            "none": False,
+            "creative": float("inf"),
+            "simple": -1,
+            "description": 0,
+            "high_stakes": "invalid",
+            "persona": float("nan"),
+            "unknown": 100,
+        },
+    )
+
+    assert proposer._select_tip_with_weights() == "persona"
+    assert rng.choice_calls == 1
