diff --git a/tests/test_n4c_author_resolved_path_cache.py b/tests/test_n4c_author_resolved_path_cache.py
new file mode 100644
index 00000000..92cec6d5
--- /dev/null
+++ b/tests/test_n4c_author_resolved_path_cache.py
@@ -0,0 +1,84 @@
+import os
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import FileSystemLoader
+from jinja2 import TemplateNotFound
+
+
+def test_cached_source_preserves_encoding_freshness_and_filename(tmp_path):
+    path = tmp_path / "page"
+    path.write_bytes("café".encode("latin-1"))
+    loader = FileSystemLoader(tmp_path, encoding="latin-1", path_cache_size=2)
+    text, filename, current = loader.get_source(Environment(), "page")
+    assert text == "café" and os.path.samefile(filename, path)
+    assert current() is True
+    stamp = path.stat()
+    os.utime(path, ns=(stamp.st_atime_ns, stamp.st_mtime_ns + 2000000000))
+    assert current() is False
+    assert loader.get_source(Environment(), "page")[0] == "café"
+    path.unlink()
+    assert current() is False
+
+
+def test_cache_does_not_bypass_parent_guard(tmp_path):
+    root = tmp_path / "root"
+    root.mkdir()
+    (root / "safe").write_text("safe")
+    (tmp_path / "secret").write_text("outside")
+    loader = FileSystemLoader(root, path_cache_size=2)
+    env = Environment()
+    loader.get_source(env, "safe")
+    loader.get_source(env, "safe")
+    with pytest.raises(TemplateNotFound) as caught:
+        loader.get_source(env, "../secret")
+    assert caught.value.name == "../secret"
+
+
+def test_default_disabled_cache_still_exposes_management(tmp_path):
+    loader = FileSystemLoader(tmp_path)
+    loader.clear_path_cache()
+    loader.resize_path_cache(0)
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(Environment(), "new")
+
+
+def test_resolution_hook_uses_valid_hits_with_absolute_filename(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "page").write_text("ok")
+
+    class AbsoluteLoader(FileSystemLoader):
+        calls = 0
+
+        def resolve_template_path(self, template):
+            self.calls += 1
+            filename = super().resolve_template_path(template)
+            return os.path.abspath(filename) if filename is not None else None
+
+    loader = AbsoluteLoader(".", path_cache_size=2)
+    for _ in range(2):
+        assert loader.get_source(Environment(), "page")[0] == "ok"
+    assert loader.calls == 1
+    loader.clear_path_cache()
+    loader.get_source(Environment(), "page")
+    assert loader.calls == 2
+
+
+def test_misses_and_later_earlier_path_are_observed(tmp_path):
+    early, late = tmp_path / "early", tmp_path / "late"
+    early.mkdir()
+    late.mkdir()
+    loader = FileSystemLoader([early, late], path_cache_size=1)
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(Environment(), "page")
+    (late / "page").write_text("late")
+    assert loader.get_source(Environment(), "page")[0] == "late"
+    (early / "page").write_text("early")
+    assert loader.get_source(Environment(), "page")[0] == "early"
+
+
+@pytest.mark.parametrize("size", [True, -1, "2"])
+def test_invalid_bounds_are_configuration_errors(tmp_path, size):
+    with pytest.raises(ValueError):
+        FileSystemLoader(tmp_path, path_cache_size=size)
