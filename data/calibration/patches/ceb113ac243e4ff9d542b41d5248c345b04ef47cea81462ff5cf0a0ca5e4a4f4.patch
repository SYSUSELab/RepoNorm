--- /dev/null
+++ b/tests/test_n4c_author_translation_versions.py
@@ -0,0 +1,70 @@
+import pytest
+
+from jinja2 import Environment
+
+
+def environment():
+    return Environment(extensions=["jinja2.ext.i18n"])
+
+
+@pytest.mark.parametrize("message", ["", "你好", "x" * 10000])
+def test_exact_message_lifecycle(message):
+    env = environment()
+    env.set_translation_version(message, "initial")
+    env.set_translation_version("other", "initial")
+    assert env.get_translation_version(message) == "initial"
+    assert env.compare_translation_versions(message, "other")
+    env.set_translation_version(message, "updated")
+    assert not env.compare_translation_versions(message, "other")
+    env.remove_translation_version("unknown")
+    assert env.get_translation_version(message) == "updated"
+    env.remove_translation_version(message)
+    assert env.get_translation_version(message) is None
+    assert env.get_translation_version("other") == "initial"
+    env.clear_translation_versions()
+    assert env.get_translation_version("other") is None
+
+
+def test_missing_messages_never_compare_equal():
+    env = environment()
+    env.set_translation_version("known", "")
+    assert not env.compare_translation_versions("known", "missing")
+    assert not env.compare_translation_versions("missing", "known")
+    assert not env.compare_translation_versions("missing", "also-missing")
+
+
+def test_parent_child_grandchild_and_other_environment_are_independent():
+    parent = environment()
+    parent.set_translation_version("message", "parent")
+    child = parent.overlay()
+    grandchild = child.overlay()
+    other = environment()
+    assert (
+        child.get_translation_version("message")
+        == grandchild.get_translation_version("message")
+        == "parent"
+    )
+    child.set_translation_version("message", "child")
+    parent.remove_translation_version("message")
+    assert child.get_translation_version("message") == "child"
+    assert grandchild.get_translation_version("message") == "parent"
+    assert other.get_translation_version("message") is None
+    grandchild.clear_translation_versions()
+    assert child.get_translation_version("message") == "child"
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_version_tracking_preserves_provider_render_and_extract(newstyle):
+    env = environment()
+    env.install_null_translations(newstyle=newstyle)
+    source = "{% trans name=name %}Hello {{ name }}{% endtrans %}"
+    before = env.from_string(source).render(name="<x>")
+    extracted = list(env.extract_translations(source))
+    env.set_translation_version("Hello", "v1")
+    env.install_gettext_callables(
+        lambda msg: msg, lambda one, many, n: many, newstyle=newstyle
+    )
+    assert env.from_string(source).render(name="<x>") == before
+    assert list(env.extract_translations(source)) == extracted
+    env.uninstall_gettext_translations(None)
+    assert env.get_translation_version("Hello") == "v1"
