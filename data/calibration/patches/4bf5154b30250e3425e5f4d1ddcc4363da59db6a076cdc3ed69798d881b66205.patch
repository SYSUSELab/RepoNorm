diff --git a/tests/test_n4c_author_edit_lock.py b/tests/test_n4c_author_edit_lock.py
new file mode 100644
index 0000000..8e9f4c1
--- /dev/null
+++ b/tests/test_n4c_author_edit_lock.py
@@ -0,0 +1,86 @@
+from pathlib import Path
+
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def _lock(path):
+    return path.with_name(f".{path.name}.lock")
+
+
+def test_lock_is_atomic_visible_during_launch_and_removed(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+
+    def launch(*args, **kwargs):
+        lines = _lock(path).read_text().splitlines()
+        assert lines[0].startswith("PID: ") and lines[0][5:].isdigit()
+        assert lines[1].startswith("Time: ")
+        return _Process()
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    click.edit(filename=str(path), editor="editor", lock_files=True)
+    assert not _lock(path).exists()
+
+
+def test_existing_lock_reports_owner_without_launch(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    lock = _lock(path)
+    lock.write_text("PID: 42\nTime: earlier\n")
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: pytest.fail("must not launch")
+    )
+    with pytest.raises(click.ClickException) as error:
+        click.edit(filename=str(path), editor="editor", lock_files=True)
+    assert str(lock) in str(error.value)
+    assert "PID: 42" in str(error.value)
+    assert lock.read_text().startswith("PID: 42")
+
+
+@pytest.mark.parametrize("failure", [OSError("launch"), 7])
+def test_lock_is_removed_after_editor_failure(tmp_path, monkeypatch, failure):
+    path = tmp_path / "note.txt"
+
+    def launch(*args, **kwargs):
+        if isinstance(failure, OSError):
+            raise failure
+        return _Process(failure)
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    with pytest.raises(click.ClickException):
+        click.edit(filename=str(path), editor="editor", lock_files=True)
+    assert not _lock(path).exists()
+
+
+def test_cleanup_error_is_chained(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process())
+    monkeypatch.setattr(
+        "click._termui_impl.os.unlink",
+        lambda name: (_ for _ in ()).throw(OSError("busy")),
+    )
+    with pytest.raises(click.ClickException, match="Failed to remove") as error:
+        click.edit(filename=str(path), editor="editor", lock_files=True)
+    assert isinstance(error.value.__cause__, OSError)
+
+
+def test_text_mode_and_default_do_not_create_locks(tmp_path, monkeypatch):
+    paths = []
+
+    def launch(command, **kwargs):
+        paths.append(Path(command.rsplit('"', 2)[1]))
+        return _Process()
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    direct = tmp_path / "note.txt"
+    click.edit(filename=str(direct), editor="editor")
+    click.edit("text", editor="editor", lock_files=True)
+    assert all(not _lock(path).exists() for path in [direct, *paths])
