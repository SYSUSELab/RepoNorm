diff --git a/tests/test_n4c_author_template_validation.py b/tests/test_n4c_author_template_validation.py
new file mode 100644
index 00000000..64960342
--- /dev/null
+++ b/tests/test_n4c_author_template_validation.py
@@ -0,0 +1,71 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import loaders
+from jinja2 import TemplateNotFound
+
+
+@pytest.mark.parametrize("name", [None, "", "bad\x00name", "C:page", "a\x02b"])
+def test_public_malformed_contract(name):
+    with pytest.raises(TemplateNotFound) as caught:
+        loaders.validate_template_path(name)
+    assert caught.value.name == name
+
+
+@pytest.mark.parametrize("name", ["é:page", "tab\tpage", "line\npage", "cr\rpage"])
+def test_declared_valid_names_can_still_load(name):
+    assert loaders.validate_template_path(name) is None
+    assert (
+        Environment(loader=loaders.DictLoader({name: "ok"})).get_template(name).render()
+        == "ok"
+    )
+
+
+@pytest.mark.parametrize("kind", ["dict", "function"])
+def test_existing_invalid_key_cannot_skip_validation(kind):
+    name = "/page"
+    child = (
+        loaders.DictLoader({name: "invalid"})
+        if kind == "dict"
+        else loaders.FunctionLoader(lambda requested: "invalid")
+    )
+    for loader, request in (
+        (child, name),
+        (loaders.ChoiceLoader([child]), name),
+        (loaders.PrefixLoader({"site": child}), "/site/page"),
+    ):
+        with pytest.raises(TemplateNotFound) as caught:
+            loader.load(Environment(), request)
+        assert caught.value.name == request
+
+
+def test_module_direct_source_rejects_malformed_before_unsupported(tmp_path):
+    loader = loaders.ModuleLoader(tmp_path)
+    with pytest.raises(TemplateNotFound) as caught:
+        loader.get_source(Environment(), "/page")
+    assert caught.value.name == "/page"
+    with pytest.raises(RuntimeError):
+        loader.get_source(Environment(), "page")
+
+
+@pytest.mark.parametrize("kind", ["module", "prefix", "choice"])
+def test_valid_compiled_templates_remain_source_less(tmp_path, kind):
+    source = Environment(loader=loaders.DictLoader({"page": "Hello {{ who }}"}))
+    source.compile_templates(str(tmp_path), zip=None)
+    child = loaders.ModuleLoader(tmp_path)
+    loader = child
+    name = "page"
+    if kind == "prefix":
+        loader = loaders.PrefixLoader({"site": child})
+        name = "site/page"
+    elif kind == "choice":
+        loader = loaders.ChoiceLoader([loaders.DictLoader({}), child])
+    assert Environment(loader=loader).get_template(name).render(who="world") == (
+        "Hello world"
+    )
+
+
+def test_valid_function_tuple_preserves_reload_helper():
+    loader = loaders.FunctionLoader(lambda name: ("ok", None, lambda: False))
+    text, filename, current = loader.get_source(Environment(), "page")
+    assert text == "ok" and filename is None and current() is False
