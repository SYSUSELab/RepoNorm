index 00000000..e772b9c3
--- /dev/null
+++ b/tests/test_n4c_author_fallback_paths.py
@@ -0,0 +1,72 @@
+from pathlib import Path
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import FileSystemLoader
+from jinja2 import TemplateNotFound
+
+
+@pytest.mark.parametrize("empty", [None, []])
+def test_empty_fallback_keeps_normal_paths(tmp_path, empty):
+    (tmp_path / "main").write_text("base")
+    loader = FileSystemLoader(tmp_path, fallback_searchpath=empty)
+    assert loader.fallback_searchpath == []
+    assert Environment(loader=loader).get_template("main").render() == "base"
+    assert loader.list_templates() == ["main"]
+
+
+@pytest.mark.parametrize("convert", [str, Path])
+def test_single_fallback_path_and_lookup_order(tmp_path, convert):
+    first, second, fallback = (tmp_path / n for n in ("a", "b", "c"))
+    for directory in (first, second, fallback):
+        directory.mkdir()
+    (second / "page").write_text("second primary")
+    (fallback / "page").write_text("fallback")
+    (fallback / "extra").write_text("extra")
+    loader = FileSystemLoader([first, second], fallback_searchpath=convert(fallback))
+    assert loader.fallback_searchpath == [str(fallback)]
+    env = Environment(loader=loader)
+    assert env.get_template("page").render() == "second primary"
+    assert env.get_template("extra").render() == "extra"
+
+
+def test_multiple_fallbacks_keep_order_and_deduplicate_listing(tmp_path):
+    one, two = tmp_path / "one", tmp_path / "two"
+    for directory in (one, two):
+        directory.mkdir()
+        (directory / "shared").write_text(directory.name)
+    (two / "only").write_text("only")
+    loader = FileSystemLoader(tmp_path / "absent", fallback_searchpath=[one, two, one])
+    assert Environment(loader=loader).get_template("shared").render() == "one"
+    assert loader.list_templates() == ["only", "shared"]
+
+
+def test_primary_removal_reloads_fallback_with_encoding(tmp_path):
+    first, fallback = tmp_path / "first", tmp_path / "fallback"
+    for directory in (first, fallback):
+        directory.mkdir()
+    old = first / "page"
+    old.write_bytes("première".encode("latin-1"))
+    (fallback / "page").write_bytes("deuxième".encode("latin-1"))
+    env = Environment(
+        loader=FileSystemLoader(first, "latin-1", False, fallback_searchpath=fallback)
+    )
+    before = env.get_template("page")
+    assert before.render() == "première"
+    old.unlink()
+    assert before.is_up_to_date is False
+    after = env.get_template("page")
+    assert after is not before
+    assert after.render() == "deuxième"
+
+
+def test_missing_and_escaping_names_keep_original_error(tmp_path):
+    fallback = tmp_path / "fallback"
+    fallback.mkdir()
+    (tmp_path / "secret").write_text("outside")
+    loader = FileSystemLoader([], fallback_searchpath=fallback)
+    for name in ("not-here", "../secret"):
+        with pytest.raises(TemplateNotFound) as caught:
+            loader.get_source(Environment(), name)
+        assert caught.value.name == name
