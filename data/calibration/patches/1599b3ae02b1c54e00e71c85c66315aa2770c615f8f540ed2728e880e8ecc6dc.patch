diff --git a/tests/test_n4c_author_translation_metadata.py b/tests/test_n4c_author_translation_metadata.py
new file mode 100644
index 00000000..70474b6c
--- /dev/null
+++ b/tests/test_n4c_author_translation_metadata.py
@@ -0,0 +1,104 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import pass_context
+from jinja2 import TemplateAssertionError
+
+
+def test_metadata_records_are_complete_and_independent():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    source = (
+        '{% trans note="提示", created="", n=2, trimmed %}\n'
+        "one {{ n }}\n{% pluralize %}\nmany {{ n }}{% endtrans %}"
+    )
+    expected_message = ("one %(n)s", "many %(n)s", None)
+    first = list(env.extract_translations_with_metadata(source, "page.html"))
+    assert first == [
+        {
+            "source": "page.html",
+            "lineno": 1,
+            "metadata": {"note": "提示", "created": ""},
+            "messages": [
+                {"lineno": 1, "function": "ngettext", "message": expected_message}
+            ],
+        }
+    ]
+    first[0]["metadata"]["note"] = "changed"
+    first[0]["messages"].clear()
+    assert list(env.extract_translations_with_metadata(source, "page.html"))[0] == {
+        "source": "page.html",
+        "lineno": 1,
+        "metadata": {"note": "提示", "created": ""},
+        "messages": [
+            {"lineno": 1, "function": "ngettext", "message": expected_message}
+        ],
+    }
+
+
+def test_metadata_does_not_change_rendering_or_ordinary_extraction():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.install_null_translations()
+    plain = "{% trans name=name %}Hello {{ name }}{% endtrans %}"
+    annotated = (
+        '{% trans modified="2024-02-03", note="Greeting", name=name %}'
+        "Hello {{ name }}{% endtrans %}"
+    )
+    assert env.from_string(annotated).render(name="World") == "Hello World"
+    assert list(env.extract_translations(plain)) == list(
+        env.extract_translations(annotated)
+    )
+    assert list(env.extract_translations_with_metadata(plain)) == []
+
+
+@pytest.mark.parametrize(
+    ("source", "key", "reason"),
+    [
+        ("{% trans note %}x{% endtrans %}", "note", "requires"),
+        ("{% trans created=value %}x{% endtrans %}", "created", "string literal"),
+        ('{% trans modified="a", modified="b" %}x{% endtrans %}', "modified", "twice"),
+    ],
+)
+def test_metadata_rejects_invalid_declarations(source, key, reason):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    with pytest.raises(TemplateAssertionError, match=rf"{key}.*{reason}"):
+        env.from_string(source)
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+@pytest.mark.parametrize("escape", [False, True])
+def test_metadata_preserves_decorated_provider_and_dynamic_escape(newstyle, escape):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    @pass_context
+    def gettext(context, message):
+        seen.append(context.environment)
+        return "<b>%(name)s</b>"
+
+    env.install_gettext_callables(
+        gettext, lambda singular, plural, count: plural, newstyle=newstyle
+    )
+    source = (
+        '{% autoescape escape %}{% trans note="compile", name=name %}'
+        "Hello {{ name }}{% endtrans %}{% endautoescape %}"
+    )
+    assert env.from_string(source).render(name="<x>", escape=escape) == (
+        env.from_string(source.replace('note="compile", ', "")).render(
+            name="<x>", escape=escape
+        )
+    )
+    assert seen == [env, env]
+
+
+def test_metadata_accepts_each_key_and_a_parsed_template():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    source = (
+        '{% trans modified="m", value=value, note="n", created="c", notrimmed %}'
+        "{{ value }}{% endtrans %}"
+    )
+    parsed = env.parse(source)
+    assert list(env.extract_translations_with_metadata(parsed))[0]["metadata"] == {
+        "modified": "m",
+        "note": "n",
+        "created": "c",
+    }
