diff --git a/tests/test_n4c_author_option_batching.py b/tests/test_n4c_author_option_batching.py
new file mode 100644
index 0000000..a27bc00
--- /dev/null
+++ b/tests/test_n4c_author_option_batching.py
@@ -0,0 +1,49 @@
+import pytest
+
+import click
+
+
+def test_batching_runs_after_conversion_and_callback(runner):
+    def reverse(ctx, param, value):
+        assert value == (1, 2, 3)
+        return tuple(reversed(value))
+
+    @click.command()
+    @click.option("--item", multiple=True, type=int, callback=reverse, batch_size=2)
+    def cli(item):
+        click.echo(repr(item))
+
+    result = runner.invoke(cli, ["--item", "1", "--item", "2", "--item", "3"])
+    assert result.exit_code == 0
+    assert result.output == "((3, 2), (1,))\n"
+
+
+def test_batching_preserves_falsy_values_and_empty_input(runner):
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=2)
+    def cli(item):
+        click.echo(repr(item))
+
+    assert runner.invoke(cli).output == "()\n"
+    result = runner.invoke(cli, ["--item", "", "--item", "0", "--item", "x"])
+    assert result.output == "(('', '0'), ('x',))\n"
+
+
+def test_batch_size_validation_is_strict():
+    for value in (True, False, 1.5, "2"):
+        with pytest.raises(TypeError):
+            click.Option(["--item"], multiple=True, batch_size=value)
+    for value in (0, -1):
+        with pytest.raises(ValueError):
+            click.Option(["--item"], multiple=True, batch_size=value)
+    with pytest.raises(TypeError):
+        click.Option(["--item"], batch_size=2)
+
+
+def test_none_preserves_existing_multiple_tuple(runner):
+    @click.command()
+    @click.option("--item", multiple=True)
+    def cli(item):
+        click.echo(repr(item))
+
+    assert runner.invoke(cli, ["--item", "a", "--item", "b"]).output == "('a', 'b')\n"
