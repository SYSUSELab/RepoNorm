+) -> t.Callable[..., str]:
+    @pass_context
+    def npgettext(
+        __context: Context,
+        __string_ctx: str,
+        __singular: str,
+        __plural: str,
+        __num: int,
+    ) -> str:
+        rv = __context.call(func, __string_ctx, __singular, __plural, __num)
+        expected = __singular if __num == 1 else __plural
+
+        if rv == expected:
+            for fallback_func in fallback_funcs:
+                rv = __context.call(
+                    fallback_func,
+                    __string_ctx,
+                    __singular,
+                    __plural,
+                    __num,
+                )
+
+                if rv != expected:
