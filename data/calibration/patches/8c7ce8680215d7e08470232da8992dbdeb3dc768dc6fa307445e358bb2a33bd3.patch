@@ -0,0 +1,94 @@
+import os
+from pathlib import Path
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import FileSystemLoader
+from jinja2 import TemplateNotFound
+
+
+@pytest.mark.parametrize("kind", ["string", "pathlike", "mixed"])
+def test_expansion_order_once_and_frozen(tmp_path, monkeypatch, kind):
+    home = tmp_path / "home"
+    root = home / "templates"
+    root.mkdir(parents=True)
+    (root / "page").write_text("first")
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setenv("N4C_ALIAS", "~")
+    calls = []
+    expandvars, expanduser = os.path.expandvars, os.path.expanduser
+
+    def variables(value):
+        calls.append(("variables", value))
+        return expandvars(value)
+
+    def user(value):
+        calls.append(("user", value))
+        return expanduser(value)
+
+    monkeypatch.setattr(os.path, "expandvars", variables)
+    monkeypatch.setattr(os.path, "expanduser", user)
+    marker = "$N4C_ALIAS/templates"
+    paths = marker if kind == "string" else Path(marker)
+    expected = [("variables", marker), ("user", "~/templates")]
+    if kind == "mixed":
+        paths = [Path(marker), str(root)]
+        expected += [("variables", str(root)), ("user", str(root))]
+    loader = FileSystemLoader(paths, expand_searchpath=True)
+    assert calls == expected
+    monkeypatch.setenv("N4C_ALIAS", "/different")
+    env = Environment(loader=loader)
+    assert env.get_template("page").render() == "first"
+    assert env.get_template("page").render() == "first"
+    assert calls == expected
+
+
+def test_default_keeps_literal_marker(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    literal = tmp_path / "$N4C_LITERAL"
+    literal.mkdir()
+    (literal / "page").write_text("literal")
+    monkeypatch.setenv("N4C_LITERAL", "/does-not-exist")
+    loader = FileSystemLoader("$N4C_LITERAL", expand_searchpath=False)
+    assert Environment(loader=loader).get_template("page").render() == "literal"
+
+
+def test_expanded_relative_path_keeps_lookup_cwd(tmp_path, monkeypatch):
+    first, second = tmp_path / "first", tmp_path / "second"
+    for root, text in [(first, "first"), (second, "second")]:
+        (root / "templates").mkdir(parents=True)
+        (root / "templates/page").write_text(text)
+    monkeypatch.chdir(first)
+    monkeypatch.setenv("N4C_RELATIVE", "templates")
+    loader = FileSystemLoader("$N4C_RELATIVE", expand_searchpath=True)
+    monkeypatch.chdir(second)
+    assert Environment(loader=loader).get_template("page").render() == "second"
+
+
+@pytest.mark.parametrize("follow", [False, True])
+def test_expanded_listing_obeys_links(tmp_path, monkeypatch, follow):
+    root, linked = tmp_path / "root", tmp_path / "linked"
+    root.mkdir()
+    linked.mkdir()
+    (root / "z").write_text("z")
+    (root / "a").write_text("a")
+    (linked / "child").write_text("child")
+    (root / "nested").symlink_to(linked, target_is_directory=True)
+    monkeypatch.setenv("N4C_LISTING", str(root))
+    loader = FileSystemLoader(
+        ["$N4C_LISTING", root], followlinks=follow, expand_searchpath=True
+    )
+    assert loader.list_templates() == (
+        ["a", "nested/child", "z"] if follow else ["a", "z"]
+    )
+
+
+def test_expanded_root_retains_logical_guard(tmp_path, monkeypatch):
+    root = tmp_path / "root"
+    root.mkdir()
+    (tmp_path / "secret").write_text("outside")
+    monkeypatch.setenv("N4C_SAFE", str(root))
+    loader = FileSystemLoader("$N4C_SAFE", expand_searchpath=True)
+    with pytest.raises(TemplateNotFound):
+        loader.get_source(Environment(), "../secret")
