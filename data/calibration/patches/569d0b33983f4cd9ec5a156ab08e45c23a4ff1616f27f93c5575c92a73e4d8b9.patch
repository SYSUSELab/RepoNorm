     if filename is None:
         return ed.edit(text)
diff --git a/tests/test_n4c_author_edit_args.py b/tests/test_n4c_author_edit_args.py
new file mode 100644
index 0000000..70d5c74
--- /dev/null
+++ b/tests/test_n4c_author_edit_args.py
@@ -0,0 +1,70 @@
+import shlex
+
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def _argv(command):
+    return shlex.split(command) if isinstance(command, str) else list(command)
+
+
+def test_literal_arguments_and_existing_editor_options_keep_boundaries(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda command, **kw: calls.append(command) or _Process()
+    )
+    values = ["", "two words", 'a"b', "semi;colon", "$(marker)", "line\nbreak"]
+    click.edit(filename="file name", editor="editor --wait", editor_args=values)
+    assert _argv(calls[0]) == ["editor", "--wait", *values, "file name"]
+
+
+def test_generator_is_consumed_once_and_applies_to_text_mode(monkeypatch):
+    calls = []
+    consumed = []
+
+    def values():
+        consumed.append(True)
+        yield "--mode"
+        yield "plain text"
+
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda command, **kw: calls.append(command) or _Process()
+    )
+    assert click.edit("text", editor="editor -f", editor_args=values()) is None
+    assert consumed == [True]
+    assert _argv(calls[0])[:4] == ["editor", "-f", "--mode", "plain text"]
+
+
+def test_non_string_is_rejected_before_launch(monkeypatch):
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: pytest.fail("must not launch")
+    )
+    with pytest.raises(TypeError, match="only strings"):
+        click.edit(filename="one", editor_args=["ok", 1])
+
+
+def test_none_empty_environment_and_nonzero_behavior(monkeypatch):
+    calls = []
+    monkeypatch.setenv("PARENT_VALUE", "kept")
+
+    def launch(command, **kwargs):
+        calls.append((command, kwargs))
+        return _Process(0 if len(calls) < 3 else 7)
+
+    monkeypatch.setattr("subprocess.Popen", launch)
+    click.edit(filename="one", editor="editor --wait", editor_args=None)
+    click.edit(filename="one", editor="editor --wait", editor_args=[], env={"X": "y"})
+    assert [_argv(item[0]) for item in calls] == [["editor", "--wait", "one"]] * 2
+    assert calls[1][1]["env"]["PARENT_VALUE"] == "kept"
+    assert calls[1][1]["env"]["X"] == "y"
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="one", editor="editor", editor_args=["--flag"])
