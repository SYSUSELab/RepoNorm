@@ -0,0 +1,129 @@
+import pytest
+
+import click
+from click.core import ParameterSource
+
+
+@pytest.mark.parametrize(
+    ("source", "arguments", "environment", "default_map", "prompt", "input"),
+    [
+        (ParameterSource.COMMANDLINE, ["--dep", "explicit"], {}, None, False, None),
+        (
+            ParameterSource.ENVIRONMENT,
+            [],
+            {"DEPENDENCY": "explicit"},
+            None,
+            False,
+            None,
+        ),
+        (ParameterSource.DEFAULT_MAP, [], {}, {"dep": "explicit"}, False, None),
+        (ParameterSource.PROMPT, [], {}, None, True, "explicit\n"),
+    ],
+)
+def test_explicit_dynamic_dependency_is_not_resolved_again(
+    runner, source, arguments, environment, default_map, prompt, input
+):
+    observed = {}
+
+    @click.command()
+    @click.option(
+        "--target",
+        default={"--dep": {"explicit": "wanted", "derived": "wrong"}},
+    )
+    @click.option(
+        "--dep",
+        default={"--seed": {"base": "derived"}},
+        envvar="DEPENDENCY",
+        prompt=prompt,
+    )
+    @click.option("--seed", default="base")
+    @click.pass_context
+    def cli(ctx, target, dep, seed):
+        observed.update(
+            target=target,
+            dependency=dep,
+            source=ctx.get_parameter_source("dep"),
+        )
+
+    result = runner.invoke(
+        cli,
+        arguments,
+        env=environment,
+        default_map=default_map,
+        input=input,
+    )
+    assert result.exit_code == 0, result.output
+    assert observed == {"target": "wanted", "dependency": "explicit", "source": source}
+
+
+def test_dependency_resolves_then_target_pipeline_once(runner):
+    seen = []
+
+    @click.command()
+    @click.option(
+        "--port",
+        type=int,
+        callback=lambda c, p, v: seen.append(v) or v + 1,
+        default={"--protocol": {"https": "443"}},
+    )
+    @click.option("--protocol", default="https")
+    def cli(port, protocol):
+        click.echo(port)
+
+    assert runner.invoke(cli).output == "444\n"
+    assert seen == [443]
+
+
+def test_explicit_source_wins_and_later_match_wins(runner):
+    @click.command(context_settings={"default_map": {"level": "MAP"}})
+    @click.option(
+        "--level",
+        envvar="LEVEL",
+        default={"--env": {"dev": "INFO"}, "--debug": {"True": "DEBUG"}},
+    )
+    @click.option("--debug/--no-debug", default=True)
+    @click.option("--env", default="dev")
+    def cli(level, debug, env):
+        click.echo(level)
+
+    assert runner.invoke(cli).output == "MAP\n"
+    assert (
+        runner.invoke(cli, ["--level", "CLI"], env={"LEVEL": "ENV"}).output == "CLI\n"
+    )
+
+
+def test_unknown_cycle_and_invalid_shape_fail(runner):
+    @click.command()
+    @click.option("--target", default={"--missing": {"x": "y"}})
+    def unknown(target):
+        pass
+
+    assert isinstance(
+        runner.invoke(unknown, standalone_mode=False).exception, click.UsageError
+    )
+
+    @click.command()
+    @click.option("--left", default={"--right": {"None": "x"}})
+    @click.option("--right", default={"--left": {"None": "y"}})
+    def cycle(left, right):
+        pass
+
+    assert isinstance(
+        runner.invoke(cycle, standalone_mode=False).exception, click.UsageError
+    )
+    with pytest.raises(TypeError):
+        option = click.Option(["--target"], default={"--mode": "bad"})
+        runner.invoke(
+            click.Command("x", params=[click.Option(["--mode"]), option]),
+            catch_exceptions=False,
+        )
+
+
+def test_help_marks_dynamic_default(runner):
+    @click.command()
+    @click.option("--port", show_default=True, default={"--protocol": {"http": 80}})
+    @click.option("--protocol", default="http")
+    def cli(port, protocol):
+        pass
+
+    assert "[default: (dynamic)]" in runner.invoke(cli, ["--help"]).output
