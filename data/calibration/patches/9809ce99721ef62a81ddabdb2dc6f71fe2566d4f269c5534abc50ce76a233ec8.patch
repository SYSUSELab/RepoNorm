diff --git a/docs/utils.rst b/docs/utils.rst
index 995c171..2d7a887 100644
--- a/docs/utils.rst
+++ b/docs/utils.rst
@@ -217,6 +217,10 @@ Example usage::
     import click
     click.edit(filename='/etc/passwd')
 
+Set ``auto_backup=True`` to preserve an existing directly edited file before
+the editor starts. Backups retain file metadata and use timestamped names;
+temporary text edits and new direct filenames do not create backups.
+
 
 Launching Applications
 ----------------------
diff --git a/src/click/_termui_impl.py b/src/click/_termui_impl.py
index 7b97bfb..eef3a22 100644
--- a/src/click/_termui_impl.py
+++ b/src/click/_termui_impl.py
@@ -505,8 +505,25 @@ class Editor:
                 return editor
         return "vi"
 
-    def edit_file(self, filename: str) -> None:
+    def edit_file(self, filename: str, auto_backup: bool = False) -> None:
+        import shutil
         import subprocess
+        from datetime import datetime
+
+        # Create backup if requested and file exists
+        if auto_backup and os.path.exists(filename):
+            try:
+                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+                backup_filename = f"{filename}.backup.{timestamp}"
+                suffix = 1
+                while os.path.exists(backup_filename):
+                    backup_filename = f"{filename}.backup.{timestamp}.{suffix}"
+                    suffix += 1
+                shutil.copy2(filename, backup_filename)
+            except OSError as e:
+                raise ClickException(
+                    _("Failed to create backup file: {e}").format(e=e)
+                ) from e
 
         editor = self.get_editor()
         environ: dict[str, str] | None = None
