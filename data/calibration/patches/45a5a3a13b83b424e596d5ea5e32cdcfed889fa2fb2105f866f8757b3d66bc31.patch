diff --git a/tests/streaming/test_buffer_watermark_contribution.py b/tests/streaming/test_buffer_watermark_contribution.py
new file mode 100644
index 000000000..2da08c70f
--- /dev/null
+++ b/tests/streaming/test_buffer_watermark_contribution.py
@@ -0,0 +1,29 @@
+import pytest
+from litellm.types.utils import Delta, ModelResponseStream, StreamingChoices
+
+import dspy
+
+
+def chunk(content):
+    return ModelResponseStream(model="test", choices=[StreamingChoices(delta=Delta(content=content))])
+
+
+@pytest.mark.parametrize("value", [False, 2, 65, 3.5])
+def test_end_buffer_rejects_values_outside_plain_integer_contract(value):
+    with pytest.raises(ValueError):
+        dspy.streaming.StreamListener("answer", end_buffer_size=value)
+
+
+def test_watermark_uses_depth_before_emission_without_changing_content():
+    listener = dspy.streaming.StreamListener("answer", end_buffer_size=3)
+    responses = []
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(chunk("[[ ## answer ## ]]\n"))
+        for value in "abcd":
+            response = listener.receive(chunk(value))
+            if response is not None:
+                responses.append(response)
+        responses.append(listener.receive(chunk("[[ ## completed ## ]]")))
+
+    assert "".join(response.chunk for response in responses) == "abcd"
+    assert [response.buffer_watermark for response in responses] == [3, 3]
