+    def _is_dynamic_default(self) -> bool:
+        value = self.default
+        if not isinstance(value, dict) or not value:
+            return False
+        if not all(isinstance(key, str) and key.startswith("--") for key in value):
+            return False
+        if not all(isinstance(mapping, dict) for mapping in value.values()):
+            raise TypeError("Dynamic default values must be dictionaries")
+        return True
+
+    def process_value(self, ctx: Context, value: t.Any) -> t.Any:
+        key = f"click.dynamic-default.{id(self)}"
+        if self._is_dynamic_default() and value is None and key not in ctx.meta:
+            return None
+        return super().process_value(ctx, value)
+
