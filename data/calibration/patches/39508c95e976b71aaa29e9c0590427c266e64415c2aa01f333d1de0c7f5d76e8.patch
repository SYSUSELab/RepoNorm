@@ -518,6 +520,19 @@ class Editor:
         try:
             c = subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True)
             exit_code = c.wait()
+
+            # Handle exit codes if custom handlers are provided
+            if self.handle_exit_codes and exit_code in self.handle_exit_codes:
+                try:
+                    self.handle_exit_codes[exit_code](exit_code)
+                    return
+                except Exception as e:
+                    raise ClickException(
+                        _("{editor}: Exit code handler failed: {e}").format(
+                            editor=editor, e=e
+                        )
+                    ) from e
+
             if exit_code != 0:
