diff --git a/tests/test_n4c_author_path_transform.py b/tests/test_n4c_author_path_transform.py
new file mode 100644
index 00000000..410e76b5
--- /dev/null
+++ b/tests/test_n4c_author_path_transform.py
@@ -0,0 +1,78 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import loaders
+from jinja2 import TemplateNotFound
+
+
+@pytest.mark.parametrize("kind", ["prefix", "choice"])
+@pytest.mark.parametrize("reload", [False, True])
+def test_transform_preserves_custom_child_reload_and_globals(kind, reload):
+    state = {"source": "first {{ label }}"}
+
+    class Child(loaders.BaseLoader):
+        def get_source(self, environment, name):
+            assert name == "actual"
+            source = state["source"]
+            return source, None, lambda: source == state["source"]
+
+    if kind == "prefix":
+        loader = loaders.PrefixLoader(
+            {"site": Child()}, path_transform=lambda name: "site/actual"
+        )
+    else:
+        loader = loaders.ChoiceLoader(
+            [loaders.DictLoader({}), Child()], path_transform=lambda name: "actual"
+        )
+    env = Environment(loader=loader, auto_reload=reload)
+    first = env.get_template("alias", globals={"label": "ok"})
+    assert first.render() == "first ok"
+    assert env.get_template("alias") is first
+    state["source"] = "second {{ label }}"
+    latest = env.get_template("alias", globals={"label": "ok"})
+    assert latest.render() == ("second ok" if reload else "first ok")
+
+
+def test_transformed_aliases_keep_distinct_environment_cache_entries():
+    loader = loaders.DictLoader({"stored": "ok"}, path_transform=lambda name: "stored")
+    env = Environment(loader=loader)
+    one, two = env.get_template("one"), env.get_template("two")
+    assert one is not two
+    assert env.get_template("one") is one
+    assert env.get_template("two") is two
+    assert loader.list_templates() == ["stored"]
+
+
+def test_transformed_source_keeps_encoding_filename_and_freshness(tmp_path):
+    path = tmp_path / "stored"
+    path.write_bytes("café".encode("latin-1"))
+    loader = loaders.FileSystemLoader(
+        tmp_path, encoding="latin-1", path_transform=lambda name: "stored"
+    )
+    source, filename, current = loader.get_source(Environment(), "alias")
+    assert source == "café" and filename.endswith("stored") and current()
+    path.unlink()
+    assert current() is False
+    with pytest.raises(TemplateNotFound) as caught:
+        loader.get_source(Environment(), "alias")
+    assert caught.value.name == "alias"
+
+
+def test_transform_cannot_escape_filesystem_root(tmp_path):
+    root = tmp_path / "root"
+    root.mkdir()
+    (tmp_path / "secret").write_text("outside")
+    loader = loaders.FileSystemLoader(root, path_transform=lambda name: "../secret")
+    with pytest.raises(TemplateNotFound) as caught:
+        loader.get_source(Environment(), "alias")
+    assert caught.value.name == "alias"
+
+
+def test_transform_supports_compiled_child_without_source(tmp_path):
+    Environment(loader=loaders.DictLoader({"actual": "{{ who }}"})).compile_templates(
+        str(tmp_path), zip=None
+    )
+    loader = loaders.ChoiceLoader(
+        [loaders.ModuleLoader(tmp_path)], path_transform=lambda name: "actual"
+    )
+    assert Environment(loader=loader).get_template("alias").render(who="ok") == "ok"
