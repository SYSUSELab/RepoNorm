diff --git a/tests/test_n4c_author_edit_working_dir.py b/tests/test_n4c_author_edit_working_dir.py
new file mode 100644
index 0000000..13dbf04
--- /dev/null
+++ b/tests/test_n4c_author_edit_working_dir.py
@@ -0,0 +1,62 @@
+import os
+
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+def test_working_dir_pathlike_relative_filename_and_env(tmp_path, monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append((a, k)) or _Process()
+    )
+    click.edit(
+        filename="note.txt",
+        editor="editor --wait",
+        working_dir=tmp_path,
+        env={"CLICK_TEST": "yes"},
+    )
+    args, kwargs = calls[0]
+    assert args[0].endswith(' "note.txt"')
+    assert kwargs["cwd"] == os.fspath(tmp_path)
+    assert kwargs["env"]["CLICK_TEST"] == "yes"
+
+
+def test_default_working_dir_preserves_inherited_directory(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append(k) or _Process()
+    )
+    click.edit(filename="note.txt", editor="editor")
+    assert calls[0]["cwd"] is None
+
+
+def test_text_mode_uses_absolute_temporary_filename(tmp_path, monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: calls.append((a, k)) or _Process()
+    )
+    click.edit("text", editor="editor", working_dir=tmp_path, require_save=False)
+    filename = calls[0][0][0].rsplit(' "', 1)[1][:-1]
+    assert os.path.isabs(filename)
+    assert calls[0][1]["cwd"] == os.fspath(tmp_path)
+
+
+def test_missing_working_dir_preserves_error_chain(tmp_path, monkeypatch):
+    def fail(*args, **kwargs):
+        raise FileNotFoundError(os.fspath(kwargs["cwd"]))
+
+    monkeypatch.setattr("subprocess.Popen", fail)
+    with pytest.raises(click.ClickException, match="Editing failed") as exc_info:
+        click.edit(
+            filename="note.txt", editor="editor", working_dir=tmp_path / "missing"
+        )
+    assert isinstance(exc_info.value.__cause__, FileNotFoundError)
