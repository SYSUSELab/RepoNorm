diff --git a/tests/streaming/test_on_chunk_contribution.py b/tests/streaming/test_on_chunk_contribution.py
new file mode 100644
index 000000000..771bbf6f2
--- /dev/null
+++ b/tests/streaming/test_on_chunk_contribution.py
@@ -0,0 +1,38 @@
+import pytest
+from litellm.types.utils import Delta, ModelResponseStream, StreamingChoices
+
+import dspy
+
+
+def chunk(content):
+    return ModelResponseStream(model="test", choices=[StreamingChoices(delta=Delta(content=content))])
+
+
+def drive_to_emission(listener):
+    listener.receive(chunk("[[ ## answer ## ]]\n"))
+    response = None
+    for value in "abcdefghijk":
+        response = listener.receive(chunk(value)) or response
+    return response
+
+
+def test_callback_observes_the_same_response_once():
+    observed = []
+    listener = dspy.streaming.StreamListener("answer", on_chunk=observed.append)
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        response = drive_to_emission(listener)
+    assert observed == [response]
+    assert observed[0] is response
+
+
+def test_callback_exception_propagates_unchanged():
+    error = RuntimeError("callback failed")
+
+    def reject(_response):
+        raise error
+
+    listener = dspy.streaming.StreamListener("answer", on_chunk=reject)
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        with pytest.raises(RuntimeError) as raised:
+            drive_to_emission(listener)
+    assert raised.value is error
