diff --git a/tests/test_n4c_author_option_history.py b/tests/test_n4c_author_option_history.py
new file mode 100644
index 0000000..8c374c7
--- /dev/null
+++ b/tests/test_n4c_author_option_history.py
@@ -0,0 +1,75 @@
+import click
+from click.core import ParameterSource
+
+
+def test_final_value_source_and_alias_lookup(runner):
+    seen = []
+
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", type=int, callback=lambda c, p, v: v + 1)
+    def cli(count):
+        ctx = click.get_current_context()
+        seen.extend(
+            (
+                ctx.get_option_history("count"),
+                ctx.get_option_history("--count"),
+                ctx.get_option_history("-c"),
+            )
+        )
+
+    assert runner.invoke(cli, ["-c", "2"]).exit_code == 0
+    assert all(
+        items[0]["value"] == 3 and items[0]["source"] is ParameterSource.COMMANDLINE
+        for items in seen
+    )
+
+
+def test_disabled_unknown_and_argument_boundaries(runner):
+    values = []
+
+    @click.command()
+    @click.option("--value")
+    def off(value):
+        values.append(click.get_current_context().get_option_history("value"))
+
+    @click.command(track_changes=True)
+    @click.argument("item")
+    def on(item):
+        ctx = click.get_current_context()
+        values.extend(
+            (ctx.get_option_history("missing"), ctx.get_option_history("item"))
+        )
+
+    runner.invoke(off, ["--value", "x"])
+    runner.invoke(on, ["x"])
+    assert values == [None, [], []]
+
+
+def test_later_assignment_and_snapshot_copy(runner):
+    captured = []
+
+    @click.command(track_changes=True)
+    @click.option("--value")
+    def cli(value):
+        ctx = click.get_current_context()
+        first = ctx.get_option_history("value")
+        ctx.params["value"] = "later"
+        second = ctx.get_option_history("value")
+        first[0]["value"] = "mutated"
+        captured.extend((first, second, ctx.get_option_history("value")))
+
+    runner.invoke(cli, ["--value", "initial"])
+    assert captured[1][-1]["source"] is None and captured[2][0]["value"] == "initial"
+
+
+def test_each_invocation_has_fresh_history(runner):
+    histories = []
+
+    @click.command(track_changes=True)
+    @click.option("--item", multiple=True)
+    def cli(item):
+        histories.append(click.get_current_context().get_option_history("item"))
+
+    runner.invoke(cli, ["--item", "a", "--item", "b"])
+    runner.invoke(cli)
+    assert histories[0][0]["value"] == ("a", "b") and len(histories[1]) == 1
