+    def _resolve_option_name(self, name: str) -> str | None:
+        """Resolve a parameter name or spelling to an option name."""
+        for parameter in self.command.params:
+            if not isinstance(parameter, Option) or parameter.name is None:
+                continue
+
+            if (
+                name == parameter.name
+                or name in parameter.opts + parameter.secondary_opts
+            ):
+                return parameter.name
+
+        return None
+
+    def _record_option_assignment(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        if not self._track_changes or self._resolve_option_name(name) != name:
+            return
+
+        import time
+
+        self._option_history.setdefault(name, []).append(
+            {"value": value, "source": source, "timestamp": time.time()}
+        )
+
+    def _assign_parameter_value(self, parameter: Parameter, value: t.Any) -> None:
+        if parameter.name is None:
+            return
+
+        dict.__setitem__(self.params, parameter.name, value)
+
+        if isinstance(parameter, Option):
+            self._record_option_assignment(
+                parameter.name,
+                value,
+                source=self.get_parameter_source(parameter.name),
+            )
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Return the assignment history for an option in this context.
+
+        ``name`` may be the Python parameter name or any declared option
+        spelling. When tracking is disabled, this returns ``None``.
+        When tracking is enabled but the name does not identify an
+        option, or that option has no exposed value, this returns an
+        empty list.
+
+        The list and record dictionaries are copied; recorded values
+        themselves are not copied.
+
+        .. versionchanged:: 8.3.0
+            Added option assignment history queries.
+        """
+        if not self._track_changes:
+            return None
+
+        resolved_name = self._resolve_option_name(name)
+
+        if resolved_name is None:
+            return []
+
+        return [dict(record) for record in self._option_history.get(resolved_name, ())]
+
 
