diff --git a/tests/streaming/test_listener_debug_contribution.py b/tests/streaming/test_listener_debug_contribution.py
new file mode 100644
index 000000000..7e02899ed
--- /dev/null
+++ b/tests/streaming/test_listener_debug_contribution.py
@@ -0,0 +1,33 @@
+import logging
+from unittest import mock
+
+from litellm.types.utils import Delta, ModelResponseStream, StreamingChoices
+
+import dspy
+
+
+def chunk(content):
+    return ModelResponseStream(model="test", choices=[StreamingChoices(delta=Delta(content=content))])
+
+
+def test_disabled_debug_does_not_build_or_emit_messages():
+    logger = mock.Mock()
+    logger.isEnabledFor.return_value = True
+    listener = dspy.streaming.StreamListener("answer", debug=False, debug_logger=logger)
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(chunk("[[ ## answer ## ]]\n"))
+    logger.debug.assert_not_called()
+
+
+def test_enabled_debug_reports_emission_without_changing_chunk(caplog):
+    logger = logging.getLogger("dspy.contribution.debug")
+    caplog.set_level(logging.DEBUG, logger=logger.name)
+    listener = dspy.streaming.StreamListener("answer", debug=True, debug_logger=logger)
+    response = None
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(chunk("[[ ## answer ## ]]\n"))
+        for value in "abcdefghijk":
+            response = listener.receive(chunk(value)) or response
+
+    assert response.chunk == "a"
+    assert any(record.getMessage().startswith("Emit chunk:") for record in caplog.records)
