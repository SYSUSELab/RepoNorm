diff --git a/tests/test_n4c_author_option_cache.py b/tests/test_n4c_author_option_cache.py
new file mode 100644
index 0000000..dd0634c
--- /dev/null
+++ b/tests/test_n4c_author_option_cache.py
@@ -0,0 +1,58 @@
+import click
+
+
+class Counting(click.ParamType):
+    name = "counting"
+
+    def __init__(self):
+        self.calls = []
+
+    def convert(self, value, param, ctx):
+        self.calls.append(value)
+        if value == "bad":
+            self.fail("bad", param, ctx)
+        return str(value)
+
+
+def command(kind, **kwargs):
+    @click.command()
+    @click.option("--value", type=kind, cache=True, **kwargs)
+    def cli(value):
+        click.echo(value)
+
+    return cli
+
+
+def test_success_reused_but_callback_runs_each_invocation(runner):
+    kind, callbacks = Counting(), []
+    cli = command(kind, callback=lambda c, p, v: callbacks.append(v) or v)
+    assert runner.invoke(cli, ["--value", "x"]).output == "x\n"
+    assert runner.invoke(cli, ["--value", "x"]).output == "x\n"
+    assert kind.calls == ["x"] and callbacks == ["x", "x"]
+
+
+def test_failures_are_not_cached(runner):
+    kind = Counting()
+    cli = command(kind)
+    assert runner.invoke(cli, ["--value", "bad"]).exit_code == 2
+    assert runner.invoke(cli, ["--value", "bad"]).exit_code == 2
+    assert kind.calls == ["bad", "bad"]
+
+
+def test_cache_is_per_option_and_clearable(runner):
+    left, right = Counting(), Counting()
+    left_cli, right_cli = command(left), command(right)
+    runner.invoke(left_cli, ["--value", "x"])
+    runner.invoke(left_cli, ["--value", "x"])
+    runner.invoke(right_cli, ["--value", "x"])
+    left_cli.params[0].clear_value_cache()
+    runner.invoke(left_cli, ["--value", "x"])
+    assert left.calls == ["x", "x"] and right.calls == ["x"]
+
+
+def test_multiple_is_excluded(runner):
+    kind = Counting()
+    cli = command(kind, multiple=True)
+    runner.invoke(cli, ["--value", "x"])
+    runner.invoke(cli, ["--value", "x"])
+    assert kind.calls == ["x", "x"]
