+def validate_template_path(template: str) -> None:
+    """Raise :exc:`TemplateNotFound` for malformed requests.
+    Reject None, empty names, NUL, leading slash or backslash, and ASCII
+    drive prefixes. Controls below 32 are invalid except tab, LF and CR.
+
+    .. versionadded:: 3.1.0
+    """
+    if not template or not isinstance(template, str):
+        raise TemplateNotFound(template)
+
+    if template.startswith(("/", "\\")):
+        raise TemplateNotFound(template)
+
+    if (
+        len(template) >= 2
+        and template[0] in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+        and template[1] == ":"
+    ):
+        raise TemplateNotFound(template)
+
+    if "\x00" in template or any(
+        ord(char) < 32 and char not in "\t\n\r" for char in template
+    ):
+        raise TemplateNotFound(template)
+
