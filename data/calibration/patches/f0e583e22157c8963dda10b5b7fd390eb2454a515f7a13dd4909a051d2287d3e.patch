diff --git a/tests/test_n4c_author_translation_validation.py b/tests/test_n4c_author_translation_validation.py
new file mode 100644
index 00000000..4576b4c8
--- /dev/null
+++ b/tests/test_n4c_author_translation_validation.py
@@ -0,0 +1,107 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import pass_context
+from jinja2 import TemplateAssertionError
+from jinja2 import TemplateSyntaxError
+
+
+@pytest.fixture
+def env():
+    value = Environment(extensions=["jinja2.ext.i18n"])
+    value.install_null_translations()
+    return value
+
+
+@pytest.mark.parametrize("name", ["gettext", "ngettext", "pgettext", "npgettext", "_"])
+@pytest.mark.parametrize("location", ["header", "body"])
+def test_reserved_translation_names(env, name, location):
+    if location == "header":
+        source = f"{{% trans {name}=1 %}}{{{{ {name} }}}}{{% endtrans %}}"
+    else:
+        source = f"{{% trans %}}{{{{ {name} }}}}{{% endtrans %}}"
+    with pytest.raises(
+        TemplateSyntaxError, match="conflicts with translation function names"
+    ) as error:
+        env.from_string(source)
+    assert name in str(error.value)
+
+
+@pytest.mark.parametrize(
+    "expression",
+    [
+        "42",
+        "value",
+        "user.name",
+        "make(value, default='x')",
+        "value|default('x')",
+        "value is defined",
+        "user.name|upper",
+    ],
+)
+def test_safe_translation_expressions(env, expression):
+    env.from_string(f"{{% trans item={expression} %}}{{{{ item }}}}{{% endtrans %}}")
+
+
+@pytest.mark.parametrize(
+    "expression",
+    [
+        "items[0]",
+        "left + right",
+        "value if enabled else other",
+        "user.make()",
+        "make(items[0])",
+        "value|default(*args)",
+        "make(**kwargs)",
+    ],
+)
+def test_unsafe_translation_expressions(env, expression):
+    with pytest.raises(
+        TemplateSyntaxError, match="template data.*translation contexts"
+    ) as error:
+        env.from_string(
+            f"{{% trans item={expression} %}}{{{{ item }}}}{{% endtrans %}}"
+        )
+    assert "item" in str(error.value)
+
+
+def test_plural_unicode_trim_and_existing_duplicate_error(env):
+    template = env.from_string(
+        "{% trans количество=2, trimmed %} {{ количество }} item "
+        "{% pluralize %} {{ количество }} items {% endtrans %}"
+    )
+    assert template.render() == "2 items"
+    with pytest.raises(TemplateAssertionError, match="defined twice"):
+        env.from_string("{% trans value=1, value=2 %}{{ value }}{% endtrans %}")
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+@pytest.mark.parametrize("escape", [False, True])
+@pytest.mark.parametrize("count", [1, 2])
+def test_validation_preserves_provider_and_count_evaluation(newstyle, escape, count):
+    environment = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+    counts = []
+
+    @pass_context
+    def translate(context, singular, plural, n):
+        seen.append((context.environment, n))
+        return "<b>%(name)s</b>"
+
+    def make():
+        counts.append(count)
+        return count
+
+    environment.install_gettext_callables(
+        lambda message: message, translate, newstyle=newstyle
+    )
+    source = (
+        "{% autoescape escape %}{% trans n=make(), name=name, trimmed %}\n"
+        "one{% pluralize %}\nmany{% endtrans %}{% endautoescape %}"
+    )
+    result = environment.from_string(source).render(
+        make=make, name="<x>", escape=escape
+    )
+    assert result == ("<b>&lt;x&gt;</b>" if escape else "<b><x></b>")
+    assert seen == [(environment, count)]
+    assert counts == [count]
