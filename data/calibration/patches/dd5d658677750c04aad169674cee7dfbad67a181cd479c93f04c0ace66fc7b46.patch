diff --git a/tests/test_n4c_author_edit_timeout.py b/tests/test_n4c_author_edit_timeout.py
new file mode 100644
index 0000000..2a43bf9
--- /dev/null
+++ b/tests/test_n4c_author_edit_timeout.py
@@ -0,0 +1,50 @@
+import subprocess
+
+import pytest
+
+import click
+
+
+class _Process:
+    pid = 123
+
+    def __init__(self, results):
+        self.results = iter(results)
+        self.waits = []
+
+    def wait(self, timeout=None):
+        self.waits.append(timeout)
+        result = next(self.results)
+        if isinstance(result, BaseException):
+            raise result
+        return result
+
+
+@pytest.mark.parametrize("timeout", [0, -1, True, 1.5, "1"])
+def test_invalid_timeout_is_rejected_before_launch(monkeypatch, timeout):
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *args, **kwargs: pytest.fail("must not launch")
+    )
+    with pytest.raises(ValueError):
+        click.edit(filename="one", editor="editor", timeout=timeout)
+
+
+def test_timeout_is_forwarded_for_direct_and_text_modes(monkeypatch):
+    processes = [_Process([0]), _Process([0])]
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: processes.pop(0))
+
+    assert click.edit(filename="one", editor="editor", timeout=3) is None
+    assert click.edit("text", editor="editor", timeout=4) is None
+
+
+def test_timeout_terminates_then_reaps(monkeypatch):
+    process = _Process([subprocess.TimeoutExpired("editor", 2), -15])
+    signals = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: process)
+    monkeypatch.setattr("click._termui_impl.os.killpg", lambda *a: signals.append(a))
+
+    with pytest.raises(click.ClickException, match="timed out after 2 seconds"):
+        click.edit(filename="one", editor="editor", timeout=2)
+
+    assert process.waits == [2, 1]
+    assert signals
