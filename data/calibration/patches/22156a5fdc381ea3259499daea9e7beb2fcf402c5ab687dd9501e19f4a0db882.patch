diff --git a/tests/test_n4c_author_edit_priority.py b/tests/test_n4c_author_edit_priority.py
new file mode 100644
index 0000000..381c2fe
--- /dev/null
+++ b/tests/test_n4c_author_edit_priority.py
@@ -0,0 +1,76 @@
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code=0):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+@pytest.mark.parametrize("value", ["", "urgent", 1, False])
+def test_invalid_priority_is_rejected_before_launch(monkeypatch, value):
+    monkeypatch.setattr(
+        "subprocess.Popen", lambda *a, **k: pytest.fail("must not launch")
+    )
+    with pytest.raises(ValueError, match="process_priority"):
+        click.edit(filename="one", process_priority=value)
+
+
+def test_none_preserves_original_shell_launch(monkeypatch):
+    calls = []
+    monkeypatch.setattr(
+        "subprocess.Popen",
+        lambda *args, **kwargs: calls.append((args, kwargs)) or _Process(),
+    )
+    click.edit(filename="file name", editor="editor --wait")
+    assert calls[0][0][0] == 'editor --wait "file name"'
+    assert calls[0][1]["shell"] is True
+
+
+def test_priority_preserves_command_boundaries_environment_and_options(monkeypatch):
+    calls = []
+    monkeypatch.setenv("PARENT", "kept")
+    monkeypatch.setattr(
+        "click._termui_impl.Editor._priority_launch_options",
+        lambda self: {"priority_probe": self.process_priority},
+    )
+    monkeypatch.setattr(
+        "subprocess.Popen",
+        lambda *args, **kwargs: calls.append((args, kwargs)) or _Process(),
+    )
+    click.edit(
+        filename="file name",
+        editor="editor --wait",
+        env={"EXPLICIT": "added"},
+        process_priority="low",
+    )
+    assert calls[0][0][0] == ["editor", "--wait", "file name"]
+    assert calls[0][1]["shell"] is False
+    assert calls[0][1]["priority_probe"] == "low"
+    assert calls[0][1]["env"]["PARENT"] == "kept"
+    assert calls[0][1]["env"]["EXPLICIT"] == "added"
+
+
+def test_missing_posix_support_falls_back_to_default(monkeypatch):
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+    monkeypatch.delattr("click._termui_impl.os.nice", raising=False)
+    editor = click._termui_impl.Editor(process_priority="high")
+    assert editor._priority_launch_options() == {}
+
+
+def test_priority_failure_degrades_and_nonzero_exit_remains_error(monkeypatch):
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+    monkeypatch.setattr(
+        "click._termui_impl.os.nice", lambda value: (_ for _ in ()).throw(OSError())
+    )
+    option = click._termui_impl.Editor(
+        process_priority="high"
+    )._priority_launch_options()
+    option["preexec_fn"]()
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process(7))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="one", editor="editor", process_priority="high")
