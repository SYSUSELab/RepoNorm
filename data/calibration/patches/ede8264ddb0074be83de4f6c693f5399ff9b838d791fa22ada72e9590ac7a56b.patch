diff --git a/tests/test_n4c_author_edit_exit_codes.py b/tests/test_n4c_author_edit_exit_codes.py
new file mode 100644
index 0000000..d0ab58a
--- /dev/null
+++ b/tests/test_n4c_author_edit_exit_codes.py
@@ -0,0 +1,55 @@
+import pytest
+
+import click
+
+
+class _Process:
+    def __init__(self, code):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+@pytest.mark.parametrize("code", [0, 7])
+def test_matching_handler_runs_once_for_direct_edit(code, monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process(code))
+    assert (
+        click.edit(
+            filename="one",
+            editor="editor",
+            handle_exit_codes={code: lambda value: calls.append(value)},
+        )
+        is None
+    )
+    assert calls == [code]
+
+
+def test_handler_return_is_ignored_in_text_mode(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process(0))
+    result = click.edit(
+        "unchanged",
+        editor="editor",
+        require_save=False,
+        handle_exit_codes={0: lambda code: "replacement"},
+    )
+    assert result == "unchanged\n"
+
+
+@pytest.mark.parametrize("mapping", [None, {}, {3: lambda code: None}])
+def test_unmatched_nonzero_preserves_failure(mapping, monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process(4))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="one", editor="editor", handle_exit_codes=mapping)
+
+
+def test_handler_failure_is_wrapped_and_chained(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **k: _Process(2))
+
+    def fail(code):
+        raise RuntimeError("handler broke")
+
+    with pytest.raises(click.ClickException, match="handler failed") as exc_info:
+        click.edit(filename="one", editor="editor", handle_exit_codes={2: fail})
+    assert isinstance(exc_info.value.__cause__, RuntimeError)
