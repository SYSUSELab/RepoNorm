@@ -0,0 +1,72 @@
+from collections import namedtuple
+
+import pytest
+
+import click
+from click.shell_completion import CompletionItem
+
+
+def values(option, incomplete=""):
+    ctx = click.Context(click.Command("cli", params=[option]))
+    return [item.value for item in option.shell_complete(ctx, incomplete)]
+
+
+def test_explicit_callback_precedes_smart_strategy():
+    option = click.Option(
+        ["--username"],
+        auto_complete=True,
+        shell_complete=lambda ctx, param, incomplete: [CompletionItem("custom")],
+    )
+    assert values(option) == ["custom"]
+
+
+def test_environment_returns_sorted_unique_names_not_values(monkeypatch):
+    monkeypatch.setenv("N4C_AUTO_B", "secret-b")
+    monkeypatch.setenv("N4C_AUTO_A", "secret-a")
+    option = click.Option(["--env-var"], auto_complete=True)
+    assert values(option, "N4C_AUTO_") == ["N4C_AUTO_A", "N4C_AUTO_B"]
+
+
+def test_user_strategy_filters_private_and_limits(monkeypatch):
+    import pwd
+
+    entry = namedtuple("Entry", "pw_name")
+    names = [entry(f"person{i:02}") for i in range(25)] + [entry("_private")]
+    monkeypatch.setattr(
+        pwd, "getpwall", lambda: list(reversed(names)) + [entry("person00")]
+    )
+    result = values(click.Option(["--owner"], auto_complete=True), "")
+    assert result == [f"person{i:02}" for i in range(20)]
+
+
+def test_explicit_strategy_ignores_parameter_name(monkeypatch):
+    monkeypatch.setenv("N4C_EXPLICIT", "not-returned")
+    option = click.Option(["--branch"], auto_complete="environment")
+    assert values(option, "N4C_") == ["N4C_EXPLICIT"]
+
+
+def test_unknown_name_falls_back_to_type_completion():
+    option = click.Option(["--color"], type=click.Choice(["amber"]), auto_complete=True)
+    assert values(option, "a") == ["amber"]
+
+
+def test_path_strategies_delegate_with_directory_boundary():
+    for strategy in ("file", "directory"):
+        option = click.Option(["--destination"], auto_complete=strategy)
+        ctx = click.Context(click.Command("cli", params=[option]))
+        expected = click.Path(file_okay=strategy != "directory").shell_complete(
+            ctx, option, "project"
+        )
+        actual = option.shell_complete(ctx, "project")
+        assert [(item.value, item.type) for item in actual] == [
+            (item.value, item.type) for item in expected
+        ]
+
+
+@pytest.mark.parametrize(
+    ("value", "error"),
+    [("unknown", ValueError), ("", ValueError), (1, TypeError), (None, TypeError)],
+)
+def test_invalid_values_are_rejected(value, error):
+    with pytest.raises(error):
+        click.Option(["--identity"], auto_complete=value)
