diff --git a/tests/streaming/test_listener_stats_contribution.py b/tests/streaming/test_listener_stats_contribution.py
new file mode 100644
index 000000000..4993557e4
--- /dev/null
+++ b/tests/streaming/test_listener_stats_contribution.py
@@ -0,0 +1,38 @@
+from litellm.types.utils import Delta, ModelResponseStream, StreamingChoices
+
+import dspy
+
+
+def chunk(content):
+    return ModelResponseStream(model="test", choices=[StreamingChoices(delta=Delta(content=content))])
+
+
+def test_stats_track_emitted_content_then_reset_on_end():
+    listener = dspy.streaming.StreamListener("answer", predict_name="predict")
+    assert listener.stats()["chunk_count"] == 0
+
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(chunk("[[ ## answer ## ]]\n"))
+        for value in "abcdefghijk":
+            listener.receive(chunk(value))
+        active = listener.stats()
+        final = listener.receive(chunk("[[ ## completed ## ]]"))
+
+    assert active["chunk_count"] == 1
+    assert active["char_count"] == 1
+    assert final.chunk.endswith("k")
+    assert listener.stats()["chunk_count"] == 0
+
+
+def test_initial_stats_have_stable_serialization_shape():
+    stats = dspy.streaming.StreamListener("answer", predict_name="p").stats()
+    assert list(stats) == [
+        "predict_name",
+        "field",
+        "chunk_count",
+        "char_count",
+        "first_ts",
+        "last_ts",
+        "duration_s",
+        "avg_chunk_chars",
+    ]
