+class ConditionalI18nExtension(Extension):
+
+    tags = {"ctrans"}
+
+    def __init__(self, environment: Environment) -> None:
+        super().__init__(environment)
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        lineno = next(parser.stream).lineno
+
+        # Parse the condition expression
+        condition = parser.parse_expression()
+
+        # Parse optional variables like in regular trans blocks
+        variables: t.Dict[str, nodes.Expr] = {}
+        context_string: t.Optional[str] = None
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_assignment: t.Optional[nodes.Assign] = None
+        num_called_num = False
+        trimmed = None
+
+        while parser.stream.current.type != "block_end":
+            if parser.stream.current.test("comma"):
+                next(parser.stream)
+
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+
+            if parser.stream.current.type != "name":
+                break
+
+            token = parser.stream.current
+            if token.value == "context":
+                next(parser.stream)
+                parser.stream.expect("assign")
+                value = parser.parse_expression()
+                if context_string is not None:
+                    parser.fail(
+                        "context defined twice",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                if not isinstance(value, nodes.Const) or not isinstance(
+                    value.value, str
+                ):
+                    parser.fail(
+                        "context must be a string literal",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                context_string = value.value
+                continue
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # Handle trimmed/notrimmed
+            if (
+                trimmed is None
+                and token.value in ("trimmed", "notrimmed")
+                and parser.stream.look().type != "assign"
+            ):
+                trimmed = token.value == "trimmed"
+                next(parser.stream)
+                continue
+
+            next(parser.stream)  # consume the name token
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_ctrans_count", "load")
+                    variables[token.value] = plural_expr
+                    plural_assignment = nodes.Assign(
+                        nodes.Name("_ctrans_count", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        # Parse the translatable content
+        singular_names, singular = self._parse_block(parser, True)
+        if singular_names and plural_expr is None:
+            plural_expr = nodes.Name(singular_names[0], "load")
+            num_called_num = singular_names[0] == "num"
+        if singular_names:
+            for name in singular_names:
+                if name not in variables:
+                    variables[name] = nodes.Name(name, "load")
+
+        # Check for pluralize block
+        plural = None
+        have_plural = False
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+            for name in plural_names:
+                variables.setdefault(name, nodes.Name(name, "load"))
+            # Don't consume the next token here, let _parse_block handle it
+
+        # Ensure we're at the fallback block
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block in conditional translation")
+
+        next(parser.stream)
+        fallback_body = list(
+            parser.parse_statements(("name:endctrans",), drop_needle=True)
+        )
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+
+        # Create the conditional node
+        node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            fallback_body,
+            variables,
+            plural_expr,
+            num_called_num and have_plural,
+            context_string,
+            bool(singular_names or (have_plural and plural_names)),
+        )
+        if plural_assignment is not None:
+            node.body.insert(0, plural_assignment)
+        node.set_lineno(lineno)
+        return node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(
+        self, parser: "Parser", allow_pluralize: bool
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next block tag with a given name."""
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:endctrans"):
+                    next(parser.stream)  # consume 'endctrans'
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if allow_pluralize:
+                        break
+                    parser.fail(
+                        "a translatable section can have only one pluralize section"
+                    )
+                elif parser.stream.current.test("name:fallback"):
+                    break
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: t.List[nodes.Node],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        num_called_num: bool,
+        context_string: t.Optional[str],
+        vars_referenced: bool,
+    ) -> nodes.If:
+        """Generate a conditional node that renders translation or fallback."""
+        # Create translation node (similar to I18nExtension)
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+        if not vars_referenced and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural is not None:
+                plural = plural.replace("%%", "%")
+        call: nodes.Call
+
+        # Create singular translation
+        if plural_expr is None:
+            gettext = nodes.Name(
+                "pgettext" if context_string is not None else "gettext", "load"
+            )
+            args: t.List[nodes.Expr] = [nodes.Const(singular)]
+            if context_string is not None:
+                args.insert(0, nodes.Const(context_string))
+            call = nodes.Call(gettext, args, [], None, None)
+        else:
+            ngettext = nodes.Name(
+                "npgettext" if context_string is not None else "ngettext", "load"
+            )
+            args = [nodes.Const(singular), nodes.Const(plural), plural_expr]
+            if context_string is not None:
+                args.insert(0, nodes.Const(context_string))
+            call = nodes.Call(
+                ngettext,
+                args,
+                [],
+                None,
+                None,
+            )
+
+        # Handle newstyle gettext
+        trans_node: nodes.Expr = call
+        if newstyle:
+            for key, value in variables.items():
+                if num_called_num and key == "num":
+                    continue
+                call.kwargs.append(nodes.Keyword(key, value))
+        else:
+            trans_node = nodes.MarkSafeIfAutoescape(trans_node)
+            if variables:
+                trans_node = nodes.Mod(
+                    trans_node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+
+        if_node = nodes.If(condition, [nodes.Output([trans_node])], [], fallback)
+
+        return if_node
+
+
 #: nicer import names
 i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+conditional_i18n = ConditionalI18nExtension
