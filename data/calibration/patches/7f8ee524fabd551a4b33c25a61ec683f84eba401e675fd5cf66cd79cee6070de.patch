@@ -0,0 +1,82 @@
+import pytest
+
+from jinja2 import Environment
+
+
+def environment(newstyle=False):
+    env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+    env.install_null_translations(newstyle=newstyle)
+    return env
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+@pytest.mark.parametrize("count", [1, 2])
+def test_implicit_count_and_plural_only_placeholder(newstyle, count):
+    env = environment(newstyle)
+    template = env.from_string(
+        "{% ctrans enabled %}{{ n }} item{% pluralize %}"
+        "{{ n }} {{ label }}{% fallback %}off{% endctrans %}"
+    )
+    expected = "1 item" if count == 1 else "2 items"
+    assert template.render(enabled=True, n=count, label="items") == expected
+    assert template.render(enabled=False, n=count, label="items") == "off"
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_count_call_is_once_and_lazy(newstyle):
+    env = environment(newstyle)
+    seen = []
+    template = env.from_string(
+        "{% ctrans enabled, n=count() %}{{ n }} item{% pluralize %}"
+        "{{ n }} items{% fallback %}off{% endctrans %}"
+    )
+
+    def count():
+        seen.append("count")
+        return 2
+
+    assert template.render(enabled=False, count=count) == "off"
+    assert not seen
+    assert template.render(enabled=True, count=count) == "2 items"
+    assert seen == ["count"]
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_percent_and_distinct_num_variable(newstyle):
+    env = environment(newstyle)
+    assert (
+        env.from_string(
+            "{% ctrans True %}100%{% fallback %}off{% endctrans %}"
+        ).render()
+        == "100%"
+    )
+    assert (
+        env.from_string(
+            "{% ctrans True, n=n, num=num %}{{ num }} item{% pluralize %}"
+            "{{ num }} items{% fallback %}off{% endctrans %}"
+        ).render(n=2, num=7)
+        == "7 items"
+    )
+
+
+def test_fallback_include_and_independent_gettext_extraction():
+    env = environment()
+    source = (
+        "{% ctrans enabled %}message{% fallback %}plain "
+        '{{ gettext("independent") }}{% endctrans %}'
+    )
+    assert env.from_string(source).render(enabled=False) == "plain independent"
+    assert list(env.extract_translations(source)) == [
+        (1, "gettext", "message"),
+        (1, "gettext", "independent"),
+    ]
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_trim_keyword_can_be_an_explicit_placeholder(newstyle):
+    env = environment(newstyle)
+    source = (
+        "{% ctrans True, trimmed=value %}{{ trimmed }}"
+        "{% fallback %}off{% endctrans %}"
+    )
+    assert env.from_string(source).render(value="visible") == "visible"
