     from .environment import Template
 
 
+def _normalize_template_path(template: str) -> str:
+    if (
+        template.startswith(("/", "\\"))
+        or len(template) >= 2
+        and template[0] in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+        and template[1] == ":"
+    ):
+        raise TemplateNotFound(template)
+
+    pieces: t.List[str] = []
+
+    for piece in template.replace("\\", "/").split("/"):
+        if not piece or piece == ".":
+            continue
+
+        if piece == "..":
+            if not pieces:
+                raise TemplateNotFound(template)
+
+            pieces.pop()
+        else:
+            pieces.append(piece)
+
+    return "/".join(pieces)
+
+
