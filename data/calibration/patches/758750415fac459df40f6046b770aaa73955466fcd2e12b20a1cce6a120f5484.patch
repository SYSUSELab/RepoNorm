diff --git a/tests/propose/test_grounded_proposer_description_limit_contribution.py b/tests/propose/test_grounded_proposer_description_limit_contribution.py
new file mode 100644
index 000000000..4966b99aa
--- /dev/null
+++ b/tests/propose/test_grounded_proposer_description_limit_contribution.py
@@ -0,0 +1,35 @@
+import pytest
+
+from dspy.propose.grounded_proposer import GenerateModuleInstruction
+
+
+def make_generator(limit):
+    return GenerateModuleInstruction(
+        use_dataset_summary=False,
+        program_aware=False,
+        use_task_demos=False,
+        use_instruct_history=False,
+        use_tip=False,
+        max_description_chars=limit,
+    )
+
+
+@pytest.mark.parametrize("boundary", [".", "!", "?"])
+def test_description_limit_prefers_a_complete_sentence(boundary):
+    generator = make_generator(12)
+    description = f"First{boundary} second sentence"
+
+    assert generator._truncate_description_at_sentence_boundary(description, 12) == f"First{boundary}…"
+
+
+def test_description_limit_supports_none_and_a_single_character_cap():
+    generator = make_generator(None)
+
+    assert generator._truncate_description_at_sentence_boundary("unchanged", None) == "unchanged"
+    assert generator._truncate_description_at_sentence_boundary("too long", 1) == "…"
+
+
+@pytest.mark.parametrize("invalid", [0, -1, True, 1.5])
+def test_description_limit_rejects_invalid_values(invalid):
+    with pytest.raises(ValueError, match="positive integer or None"):
+        make_generator(invalid)
