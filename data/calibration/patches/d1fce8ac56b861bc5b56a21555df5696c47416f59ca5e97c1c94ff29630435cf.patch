+    def prompt_for_value(self, ctx: Context) -> t.Any:
+        key = f"click.validators.prompt.{id(self)}"
+        ctx.meta[key] = "processing"
+        try:
+            return self._base_prompt_for_value(ctx)
+        finally:
+            if ctx.meta.get(key) == "processing":
+                ctx.meta.pop(key, None)
+
+    def process_value(self, ctx: Context, value: t.Any) -> t.Any:
+        key = f"click.validators.prompt.{id(self)}"
+        prompt_state = ctx.meta.get(key)
+        if prompt_state == "processed":
+            ctx.meta.pop(key, None)
+            return value
+
+        value = super().process_value(ctx, value)
+        for validator in self.validators:
+            value = validator(ctx, self, value)
+
+        if prompt_state == "processing":
+            ctx.meta[key] = "processed"
+        return value
