#!/bin/sh
set -eu

metadata_source=/tmp/n4c-preflight-runtime/outlines/_version.py
metadata_destination=outlines/_version.py
if [ -f "$metadata_source" ] && [ ! -e "$metadata_destination" ]; then
    mkdir -p "$(dirname "$metadata_destination")"
    cp "$metadata_source" "$metadata_destination"
    echo "N4C preflight: restored image-preinstalled Outlines version metadata"
fi

if [ "${1:-}" = "sync" ]; then
    echo "N4C preflight: using image-preinstalled uv environment"
    exit 0
fi

if [ "${1:-}" = "pip" ] && [ "${2:-}" = "install" ]; then
    echo "N4C preflight: using image-preinstalled uv dependencies"
    exit 0
fi

exec /usr/local/bin/uv "$@"
