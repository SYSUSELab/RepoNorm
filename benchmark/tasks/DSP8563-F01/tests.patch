+@pytest.mark.parametrize('shape', ['single', 'list', 'canonical'])
+@pytest.mark.parametrize('as_text', [False, True])
+def test_flexible_tool_calls_containers(shape, as_text):
+    import copy
+    import json
+    from dspy import ToolCalls
+    call = {'name': 'search', 'args': {'query': '雪', 'nested': [1, None, {'ok': True}]}}
+    value = {'single': call, 'list': [call], 'canonical': {'tool_calls': [call]}}[shape]
+    before = copy.deepcopy(value)
+    supplied = json.dumps(value) if as_text else value
+    parsed = ToolCalls.model_validate(supplied)
+    assert [item.model_dump() for item in parsed.tool_calls] == [call]
+    assert ToolCalls.model_validate_json(json.dumps(value)) == parsed
+    assert value == before
+    helper = ToolCalls.validate_input(supplied)
+    assert not isinstance(helper, ToolCalls)
+    assert ToolCalls.model_validate(helper) == parsed
+
+
+def test_flexible_empty_order_and_existing_model():
+    from dspy import ToolCalls
+    assert ToolCalls.model_validate([]).tool_calls == []
+    values = [{'name': 'second', 'args': {'n': 2}}, {'name': 'first', 'args': {'n': 1}}]
+    parsed = ToolCalls.model_validate(values)
+    assert [call.name for call in parsed.tool_calls] == ['second', 'first']
+    assert ToolCalls.model_validate(parsed) == parsed
+    assert ToolCalls.from_dict_list(values) == parsed
+    assert parsed.format() == [{'type': 'tool_calls', 'tool_calls': [
+        {'type': 'function', 'function': {'name': item['name'], 'arguments': item['args']}}
+        for item in values]}]
+
+
+@pytest.mark.parametrize('value', [None, 3, {}, [1], [{'name': 'missing'}],
+    {'name': 'bad', 'args': []}, {'tool_calls': 'bad'}, 'not JSON',
+    '{"tool_calls": [}', "__import__('os').getcwd()"])
+def test_flexible_inputs_still_validate_fields(value):
+    from dspy import ToolCalls
+    with pytest.raises(ValueError):
+        ToolCalls.model_validate(value)
+
