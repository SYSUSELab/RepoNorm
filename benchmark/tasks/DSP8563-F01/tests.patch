+def test_normalization_helper_does_not_execute(tmp_path):
+    from dspy import ToolCalls
+    marker = tmp_path / 'must-not-exist'
+    text = "__import__('pathlib').Path(%r).touch()" % str(marker)
+    assert ToolCalls.validate_input(text) == text
+    with pytest.raises(ValueError):
+        ToolCalls.model_validate(text)
+    assert not marker.exists()
+
