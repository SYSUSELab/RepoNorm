+@pytest.mark.parametrize('body', [
+    '{"name":"search","args":{"query":"hello"}}',
+    '[{"name":"search","args":{"query":"hello"}}]',
+    '{"tool_calls":[{"name":"search","args":{"query":"hello"}}]}',
+])
+def test_chat_adapter_flexible_tool_calls_output(body):
+    class Calls(dspy.Signature):
+        question: str = dspy.InputField()
+        calls: dspy.ToolCalls = dspy.OutputField()
+    completion = '[[ ## calls ## ]]\n' + body + '\n[[ ## completed ## ]]'
+    result = dspy.ChatAdapter().parse(Calls, completion)
+    assert [item.model_dump() for item in result['calls'].tool_calls] == [
+        {'name': 'search', 'args': {'query': 'hello'}}]
