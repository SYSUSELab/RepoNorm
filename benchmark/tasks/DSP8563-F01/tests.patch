+@pytest.mark.parametrize("adapter_name", ["ChatAdapter", "JSONAdapter", "XMLAdapter"])
+@pytest.mark.parametrize("shape", ["single", "list", "canonical"])
+def test_flexible_toolcalls_nested_signature_adapters(adapter_name, shape):
+    import json
+    import dspy
+    from pydantic import BaseModel
+    from dspy.utils.exceptions import AdapterParseError
+
+    class Batch(BaseModel):
+        calls: dspy.ToolCalls
+
+    class Result(dspy.Signature):
+        question: str = dspy.InputField()
+        batch: Batch = dspy.OutputField()
+
+    call = {"name": "search", "args": {"query": "snow", "limit": 2}}
+    value = {"single": call, "list": [call], "canonical": {"tool_calls": [call]}}[shape]
+    adapter = getattr(dspy, adapter_name)()
+
+    def completion(body):
+        payload = json.dumps({"calls": body})
+        if adapter_name == "JSONAdapter":
+            return '{"batch":' + payload + '}'
+        if adapter_name == "XMLAdapter":
+            return "<batch>" + payload + "</batch><completed/>"
+        return "[[ ## batch ## ]]\n" + payload + "\n[[ ## completed ## ]]"
+
+    for supplied in (value, json.dumps(value)):
+        result = adapter.parse(Result, completion(supplied))["batch"]
+        assert isinstance(result, Batch)
+        assert isinstance(result.calls, dspy.ToolCalls)
+        assert [item.model_dump() for item in result.calls.tool_calls] == [call]
+    with pytest.raises((ValueError, AdapterParseError)):
+        adapter.parse(Result, completion({"tool_calls": [{"name": "missing-args"}]}))
