@@ -0,0 +1,55 @@
+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_guid_is_an_exported_composable_regex_term():
+    value = getattr(types, "guid")
+    assert isinstance(value, Regex)
+    assert re.fullmatch(
+        to_regex("<" + value + ">"), "<{12345678-1234-1234-1234-123456789012}>"
+    )
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "{00000000-0000-0000-0000-000000000000}",
+        "{ABCDEF12-3456-7890-ABCD-EF1234567890}",
+    ],
+)
+def test_guid_accepts_supported_shapes_without_version_constraints(value):
+    assert re.fullmatch(to_regex(getattr(types, "guid")), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "12345678-1234-1234-1234-123456789012",
+        "(12345678-1234-1234-1234-123456789012)",
+        "{1234567-1234-1234-1234-123456789012}",
+        "{12345678-123-1234-1234-123456789012}",
+        "{12345678-1234-1234-1234-12345678901}",
+        "{12345678_1234_1234_1234_123456789012}",
+        "{12345678-1234-1234-1234-12345678901G}",
+        " {12345678-1234-1234-1234-123456789012}",
+    ],
+)
+def test_guid_rejects_invalid_complete_shapes(value):
+    assert re.fullmatch(to_regex(getattr(types, "guid")), value) is None
+
+
+def test_guid_works_in_pydantic_schema_and_validation():
+    class Identifier(BaseModel):
+        value: types.guid
+
+    pattern = Identifier.model_json_schema()["properties"]["value"]["pattern"]
+    valid = "{ffffffff-ffff-ffff-ffff-ffffffffffff}"
+    assert re.fullmatch(pattern, valid)
+    assert Identifier(value=valid).value == valid
+    with pytest.raises(ValidationError):
+        Identifier(value=valid[1:-1])
