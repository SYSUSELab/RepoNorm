@@ -0,0 +1,64 @@
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+def test_encode_budget_accepts_equality_and_rejects_overflow(encoding) -> None:
+    text = "hello world"
+    expected = encoding.encode(text)
+    assert encoding.encode(text, max_tokens=len(expected)) == expected
+    with pytest.raises(ValueError, match="max_tokens|maximum allowed"):
+        encoding.encode(text, max_tokens=len(expected) - 1)
+
+
+@pytest.mark.parametrize("value", [0, -1, True, 1.5, "2"])
+def test_explicit_budget_domains_are_positive_integers(encoding, value) -> None:
+    with pytest.raises(ValueError):
+        encoding.encode("", max_tokens=value)
+    with pytest.raises(ValueError):
+        encoding.encode_batch([], max_tokens=value)
+    with pytest.raises(ValueError):
+        encoding.encode_batch([], max_total_tokens=value)
+
+
+def test_batch_per_document_budget_reports_first_input_index(encoding) -> None:
+    texts = ["a", "a somewhat longer document", "another long document"]
+    lengths = [len(encoding.encode(item)) for item in texts]
+    with pytest.raises(ValueError, match="document 1"):
+        encoding.encode_batch(texts, max_tokens=lengths[0])
+
+
+def test_batch_total_budget_and_combined_precedence(encoding) -> None:
+    texts = ["hello", "world"]
+    encoded = encoding.encode_batch(texts)
+    total = sum(map(len, encoded))
+    assert encoding.encode_batch(texts, max_total_tokens=total) == encoded
+    with pytest.raises(ValueError, match="max_total_tokens"):
+        encoding.encode_batch(texts, max_total_tokens=total - 1)
+    with pytest.raises(ValueError, match="document 0"):
+        encoding.encode_batch(["hello world"], max_tokens=1, max_total_tokens=1)
+
+
+def test_budgeted_encode_preserves_special_token_policy(encoding) -> None:
+    special = "<|endoftext|>"
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode(special, max_tokens=100)
+    expected = encoding.encode(special, allowed_special="all")
+    assert encoding.encode(special, allowed_special="all", max_tokens=len(expected)) == expected
+
+
+def test_budgeted_encode_preserves_unicode_recovery(encoding) -> None:
+    text = "prefix \ud800 suffix"
+    expected = encoding.encode(text)
+    assert encoding.encode(text, max_tokens=len(expected)) == expected
+
+
+def test_batch_order_and_content_are_unchanged(encoding) -> None:
+    texts = ["third", "first", "second", "\ud800"]
+    expected = [encoding.encode(item) for item in texts]
+    assert encoding.encode_batch(texts, max_tokens=max(map(len, expected))) == expected
