+import pytest
+import tiktoken
+
+
+@pytest.mark.parametrize('name', ['cl100k_base', 'byte_vocab'])
+def test_batch_budgets(name):
+    enc = (tiktoken.get_encoding(name) if name != 'byte_vocab' else tiktoken.Encoding(
+        name='byte_vocab', pat_str=r'[\s\S]+',
+        mergeable_ranks={bytes([i]): i for i in range(256)},
+        special_tokens={'<|endoftext|>': 256},
+    ))
+    texts = ['hello world', '你好😀', '', '<|endoftext|>']
+    expected = [enc.encode(s, allowed_special='all') for s in texts]
+    largest, total = max(map(len, expected)), sum(map(len, expected))
+    assert enc.encode_batch(texts, allowed_special='all', max_tokens=largest, max_total_tokens=total) == expected
+    with pytest.raises(ValueError, match='max_total_tokens'):
+        enc.encode_batch(texts, allowed_special='all', max_tokens=largest, max_total_tokens=total - 1)
+    first = next(i for i, tokens in enumerate(expected) if len(tokens) > 1)
+    with pytest.raises(ValueError, match=str(first)):
+        enc.encode_batch(texts, allowed_special='all', max_tokens=1, max_total_tokens=total)
+    with pytest.raises(ValueError) as caught:
+        enc.encode_batch(texts, allowed_special='all', max_tokens=1, max_total_tokens=1)
+    assert str(first) in str(caught.value)
+    assert 'max_total_tokens' not in str(caught.value)
+    assert enc.encode_batch([], max_tokens=1, max_total_tokens=1) == []
+    with pytest.raises(ValueError):
+        enc.encode_batch(['<|endoftext|>'], max_tokens=100)
+
+
+@pytest.mark.parametrize('value', [0, -1, True, 1.5, '2'])
+def test_budget_domain(value):
+    enc = tiktoken.get_encoding('cl100k_base')
+    with pytest.raises(ValueError):
+        enc.encode('', max_tokens=value)
+    for param in ['max_tokens', 'max_total_tokens']:
+        with pytest.raises(ValueError):
+            enc.encode_batch([], **{param: value})
