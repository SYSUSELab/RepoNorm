+            for dirpath, _, filenames in os.walk(root, followlinks=self.followlinks):
+                for fname in filenames:
+                    fpath = os.path.join(dirpath, fname)
+                    try:
+                        snapshot[fpath] = os.path.getmtime(fpath)
+                    except OSError:
