diff --git a/tests/test_options.py b/tests/test_options.py
index 5c30418..7bc58c2 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -1139,3 +1139,95 @@ def test_duplicate_names_warning(runner, opts_one, opts_two):
 
     with pytest.warns(UserWarning):
         runner.invoke(cli, [])
+
+
+def test_option_batch_size_uses_custom_envvar_split(runner):
+    received = []
+
+    class PipeSeparated(click.ParamType):
+        name = "pipe-separated"
+
+        def split_envvar_value(self, value):
+            return value.split("|")
+
+        def convert(self, value, param, ctx):
+            return value.upper()
+
+    @click.command()
+    @click.option("--item", type=PipeSeparated(), multiple=True, batch_size=2,
+                  envvar="CLICK_BATCH_ITEMS")
+    def cli(item):
+        received.append(item)
+
+    result = runner.invoke(cli, env={"CLICK_BATCH_ITEMS": "left value|right value|last value"})
+    assert result.exit_code == 0, (result.output, result.exception)
+    assert received == [(("LEFT VALUE", "RIGHT VALUE"), ("LAST VALUE",))]
+
+
+def test_option_batch_size_groups_converted_values(runner):
+    @click.command()
+    @click.option("--item", multiple=True, type=int, batch_size=2)
+    def cli(item):
+        assert item == ((1, 2), (3,))
+
+    result = runner.invoke(cli, ["--item", "1", "--item", "2", "--item", "3"])
+    assert result.exit_code == 0
+
+
+def test_option_batch_size_preserves_falsy_and_none(runner):
+    class MaybeNone(click.ParamType):
+        name = "maybe"
+        def convert(self, value, param, ctx):
+            return None if value == "none" else value
+
+    @click.command()
+    @click.option("--item", multiple=True, type=MaybeNone(), batch_size=2)
+    def cli(item):
+        assert item == (("", "0"), (None, "end"))
+
+    result = runner.invoke(cli, ["--item", "", "--item", "0", "--item", "none", "--item", "end"])
+    assert result.exit_code == 0
+
+
+def test_option_batch_size_empty_and_large(runner):
+    @click.command()
+    @click.option("--item", multiple=True, batch_size=5)
+    def cli(item):
+        click.echo(repr(item))
+
+    assert runner.invoke(cli).output == "()\n"
+    assert runner.invoke(cli, ["--item", "a", "--item", "b"]).output == "(('a', 'b'),)\n"
+
+
+@pytest.mark.parametrize("value", [True, False, 1.5, "2"])
+def test_option_batch_size_rejects_non_integer(value):
+    with pytest.raises(TypeError) as error:
+        click.Option(["--item"], multiple=True, batch_size=value)
+    assert str(error.value).strip()
+
+
+@pytest.mark.parametrize("value", [0, -1])
+def test_option_batch_size_rejects_non_positive(value):
+    with pytest.raises(ValueError) as error:
+        click.Option(["--item"], multiple=True, batch_size=value)
+    assert str(error.value).strip()
+
+
+def test_option_batch_size_requires_multiple():
+    with pytest.raises(TypeError) as error:
+        click.Option(["--item"], batch_size=2)
+    assert str(error.value).strip()
+
+
+def test_option_batch_size_runs_after_callback(runner):
+    def callback(ctx, param, value):
+        assert value == (1, 2, 3)
+        return tuple(reversed(value))
+
+    @click.command()
+    @click.option("--item", multiple=True, type=int, callback=callback, batch_size=2)
+    def cli(item):
+        assert item == ((3, 2), (1,))
+
+    result = runner.invoke(cli, ["--item", "1", "--item", "2", "--item", "3"])
+    assert result.exit_code == 0
