+
+
+class TestFallbackSearchPath:
+    @pytest.mark.parametrize("followlinks", [False, True])
+    def test_fallback_preserves_encoding_and_listing_symlink_policy(
+        self, tmp_path, followlinks
+    ):
+        primary = tmp_path / "primary"
+        fallback = tmp_path / "fallback"
+        linked = tmp_path / "linked"
+        for path in (primary, fallback, linked):
+            path.mkdir()
+        (fallback / "page.html").write_bytes("café {{ name }}".encode("latin-1"))
+        (linked / "child.html").write_text("linked")
+        (fallback / "nested").symlink_to(linked, target_is_directory=True)
+        loader = loaders.FileSystemLoader(
+            primary, fallback_searchpath=fallback, encoding="latin-1",
+            followlinks=followlinks,
+        )
+        assert Environment(loader=loader).get_template("page.html").render(name="reader") == "café reader"
+        expected = ["nested/child.html", "page.html"] if followlinks else ["page.html"]
+        assert loader.list_templates() == expected
+
+    def test_primary_then_fallback_order(self, tmp_path):
+        primary = tmp_path / "primary"
+        fallback1 = tmp_path / "fallback1"
+        fallback2 = tmp_path / "fallback2"
+        for path in (primary, fallback1, fallback2):
+            path.mkdir()
+        (primary / "shared.html").write_text("primary")
+        (fallback1 / "shared.html").write_text("fallback one")
+        (fallback1 / "only.html").write_text("first fallback")
+        (fallback2 / "only.html").write_text("second fallback")
+        loader = loaders.FileSystemLoader(
+            primary, fallback_searchpath=[fallback1, fallback2]
+        )
+        env = Environment(loader=loader)
+
+        assert env.get_template("shared.html").render() == "primary"
+        assert env.get_template("only.html").render() == "first fallback"
+
+    def test_single_pathlike_and_empty_values(self, tmp_path):
+        fallback = tmp_path / "fallback"
+        fallback.mkdir()
+        (fallback / "page.html").write_text("fallback")
+
+        loader = loaders.FileSystemLoader(
+            tmp_path / "missing", fallback_searchpath=fallback
+        )
+        assert loader.fallback_searchpath == [str(fallback)]
+        assert Environment(loader=loader).get_template("page.html").render() == (
+            "fallback"
+        )
+        assert loaders.FileSystemLoader(tmp_path).fallback_searchpath == []
+        assert loaders.FileSystemLoader(
+            tmp_path, fallback_searchpath=[]
+        ).fallback_searchpath == []
+
+    def test_listing_combines_unique_names(self, tmp_path):
+        primary = tmp_path / "primary"
+        fallback = tmp_path / "fallback"
+        primary.mkdir()
+        fallback.mkdir()
+        (primary / "shared.html").write_text("primary")
+        (fallback / "shared.html").write_text("fallback")
+        (fallback / "only.html").write_text("fallback")
+        loader = loaders.FileSystemLoader(
+            primary, fallback_searchpath=fallback
+        )
+
+        assert loader.list_templates() == ["only.html", "shared.html"]
+
+    def test_primary_deletion_allows_fallback_takeover(self, tmp_path):
+        primary = tmp_path / "primary"
+        fallback = tmp_path / "fallback"
+        primary.mkdir()
+        fallback.mkdir()
+        primary_file = primary / "page.html"
+        primary_file.write_text("primary")
+        (fallback / "page.html").write_text("fallback")
+        env = Environment(
+            loader=loaders.FileSystemLoader(
+                primary, fallback_searchpath=fallback
+            )
+        )
+
+        first = env.get_template("page.html")
+        assert first.render() == "primary"
+        primary_file.unlink()
+        second = env.get_template("page.html")
+        assert second.render() == "fallback"
+        assert second is not first
+
+    def test_missing_name_is_preserved(self, tmp_path):
+        loader = loaders.FileSystemLoader(
+            tmp_path / "primary", fallback_searchpath=tmp_path / "fallback"
+        )
+        with pytest.raises(TemplateNotFound) as exc_info:
+            Environment(loader=loader).get_template("missing.html")
+        assert exc_info.value.name == "missing.html"
