+    @staticmethod
+    def _priority_limit(value: t.Any) -> int:
+        try:
+            return max(0, min(int(value), 9))
+        except (TypeError, ValueError, OverflowError):
+            return 0
+
+    @pass_context
+    def _priority_gettext(
+        self, context: Context, message: str, priority: t.Any, **variables: t.Any
+    ) -> str:
+        resolver = context.resolve("priority_gettext")
+        if isinstance(resolver, Undefined):
+            resolver = None
+        if resolver is None:
+            result = context.call(context.resolve("gettext"), message)
+        else:
+            result = message
+            for level in range(self._priority_limit(priority) + 1):
+                result = context.call(resolver, message, level)
+                if result != message:
+                    break
+        if context.eval_ctx.autoescape:
+            result = Markup(result)
+        return result % variables if variables else result
+
+    @pass_context
+    def _priority_ngettext(
+        self, context: Context, singular: str, plural: str, num: int,
+        priority: t.Any, **variables: t.Any,
+    ) -> str:
+        source = singular if num == 1 else plural
+        resolver = context.resolve("priority_ngettext")
+        if isinstance(resolver, Undefined):
+            resolver = None
+        if resolver is None:
+            result = context.call(context.resolve("ngettext"), singular, plural, num)
+        else:
+            result = source
+            for level in range(self._priority_limit(priority) + 1):
+                result = context.call(resolver, singular, plural, num, level)
+                if result != source:
+                    break
+        variables.setdefault("num", num)
+        if context.eval_ctx.autoescape:
+            result = Markup(result)
+        return result % variables
+
 
