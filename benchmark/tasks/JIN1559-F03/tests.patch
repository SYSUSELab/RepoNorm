+def test_priority_resolver_levels_and_short_circuit():
+    env = Environment(extensions=["jinja2.ext.i18n"]); seen=[]
+    def pg(message, level):
+        seen.append(level); return "translated" if level == 2 else message
+    env.install_gettext_callables(lambda x: x, lambda s,p,n:s if n==1 else p, priority_gettext=pg)
+    assert env.from_string("{% trans priority=8 %}source{% endtrans %}").render() == "translated"
+    assert seen == [0, 1, 2]
+
+
+def test_priority_plural_levels_and_cap():
+    env = Environment(extensions=["jinja2.ext.i18n"]); seen=[]
+    def pn(s, p, n, level): seen.append(level); return p
+    env.install_gettext_callables(lambda x:x, lambda s,p,n:p, priority_ngettext=pn)
+    assert env.from_string("{% trans n=2, priority=99 %}one{% pluralize %}many{% endtrans %}").render() == "many"
+    assert seen == list(range(10))
+
+
+def test_priority_without_resolver_calls_ordinary_once():
+    env = Environment(extensions=["jinja2.ext.i18n"]); seen=[]
+    env.install_gettext_callables(lambda x: seen.append(x) or x, lambda s,p,n:p)
+    assert env.from_string("{% trans priority=9 %}source{% endtrans %}").render() == "source"
+    assert seen == ["source"]
+
+
+@pytest.mark.parametrize("value", ["-2", "'bad'", "none", "false", "1.9"])
+def test_priority_conversion(value):
+    env = Environment(extensions=["jinja2.ext.i18n"]); seen=[]
+    env.install_gettext_callables(lambda x:x, lambda s,p,n:p, priority_gettext=lambda m,l: seen.append(l) or m)
+    env.from_string("{% trans priority=" + value + " %}x{% endtrans %}").render()
+    expected = [0] if value != "1.9" else [0, 1]
+    assert seen == expected
+
+
+def test_duplicate_priority_is_compile_error():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    with pytest.raises(TemplateAssertionError, match="priority.*twice"):
+        env.from_string("{% trans priority=1, priority=2 %}x{% endtrans %}")
