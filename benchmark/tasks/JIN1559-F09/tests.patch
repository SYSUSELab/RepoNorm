+def test_marker_batch_logical_names_selection_and_independent_records():
+    from jinja2 import PrefixLoader
+
+    child = DictLoader({
+        "a.html": '{% extract note="A" %}{{ gettext("Alpha") }}{% endextract %}',
+        "b.html": '{% extract note="B" %}{{ gettext("Beta") }}{% endextract %}',
+    })
+    env = Environment(loader=PrefixLoader({"pkg": child}), extensions=["jinja2.ext.TranslationExtractorExtension"])
+    selected = list(env.extract_marked_translations_from_templates(iter(["pkg/b.html", "pkg/a.html"])))
+    assert [r["source"] for r in selected] == ["pkg/b.html", "pkg/a.html"]
+    assert [r["messages"][0]["message"] for r in selected] == ["Beta", "Alpha"]
+    selected[0]["metadata"]["note"] = "changed"
+    all_records = list(env.extract_marked_translations_from_templates())
+    assert [r["source"] for r in all_records] == ["pkg/a.html", "pkg/b.html"]
+    assert [r["metadata"]["note"] for r in all_records] == ["A", "B"]
+    assert list(env.extract_marked_translations_from_templates([])) == []
+
