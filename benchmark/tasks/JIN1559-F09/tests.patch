+@pytest.mark.parametrize("silent", [False, True])
+def test_marker_babel_preserves_configured_syntax_error_policy(silent):
+    from jinja2.ext import babel_extract
+
+    options = {
+        "extensions": "jinja2.ext.TranslationExtractorExtension",
+        "silent": str(silent).lower(),
+    }
+    source = BytesIO(b'{% extract note=dynamic %}{{ gettext("Open") }}{% endextract %}')
+    if silent:
+        assert list(babel_extract(source, ("gettext",), [], options)) == []
+    else:
+        with pytest.raises(TemplateSyntaxError, match="note"):
+            list(babel_extract(source, ("gettext",), [], options))
+
