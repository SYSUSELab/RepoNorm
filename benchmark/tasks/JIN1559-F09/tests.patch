+def test_extract_marker_validation_and_stability():
+    env = Environment(extensions=["jinja2.ext.TranslationExtractorExtension"])
+    with pytest.raises(TemplateSyntaxError, match="note"):
+        env.from_string("{% extract note=value %}x{% endextract %}")
+    with pytest.raises(TemplateSyntaxError, match="note"):
+        env.from_string('{% extract note="a", note="b" %}x{% endextract %}')
+    source = '{% extract note="a" %}x{% endextract %}'
+    assert list(env.extract_marked_translations(source)) == list(env.extract_marked_translations(source))
+
