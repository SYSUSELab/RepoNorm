+def test_extract_marker_public_records_and_render():
+    env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.TranslationExtractorExtension"])
+    env.install_null_translations()
+    source = '{% extract comment="Button", priority=2 %}{{ _("Login") }}{% endextract %}'
+    assert env.from_string(source).render() == "Login"
+    records = list(env.extract_marked_translations(source, "page.html"))
+    assert records == [{
+        "source": "page.html", "lineno": 1,
+        "metadata": {"comment": "Button", "priority": 2},
+        "messages": [{"lineno": 1, "function": "_", "message": "Login"}],
+    }]
+    records[0]["metadata"]["comment"] = "changed"
+    assert list(env.extract_marked_translations(source))[0]["metadata"]["comment"] == "Button"
+
+
+def test_extract_marker_nested_messages_and_normal_extraction():
+    env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.TranslationExtractorExtension"])
+    source = '{% extract context="outer" %}{{ _("A") }}{% if ok %}{{ gettext("B") }}{% endif %}{% endextract %}'
+    record = list(env.extract_marked_translations(source))[0]
+    assert [m["message"] for m in record["messages"]] == ["A", "B"]
+    assert [m[2] for m in env.extract_translations(source)] == ["A", "B"]
+
