+def test_marker_batch_does_not_render_or_follow_dependencies():
+    source = '{% extends "absent-parent.html" %}{% include "absent-child.html" %}{% extract note="static" %}{{ explode() }}{{ gettext("Static") }}{% endextract %}'
+    env = Environment(loader=DictLoader({"page.html": source}), extensions=["jinja2.ext.TranslationExtractorExtension"])
+    env.globals["explode"] = lambda: 1 / 0
+    records = list(env.extract_marked_translations_from_templates())
+    assert len(records) == 1
+    assert records[0]["messages"] == [{"lineno": 1, "function": "gettext", "message": "Static"}]
