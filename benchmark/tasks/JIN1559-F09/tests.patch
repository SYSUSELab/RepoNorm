+@pytest.mark.parametrize("filename", [None, "/virtual/resource.html"])
+def test_marker_batch_custom_loader_source_contract(filename):
+    from jinja2 import BaseLoader
+    from jinja2 import TemplateNotFound
+
+    class ResourceLoader(BaseLoader):
+        def __init__(self):
+            self.message = "First"
+
+        def get_source(self, environment, name):
+            if name != "logical.html":
+                raise TemplateNotFound(name)
+            source = '{% extract note="resource" %}{{ gettext("' + self.message + '") }}{% endextract %}'
+            return source, filename, None
+
+    loader = ResourceLoader()
+    env = Environment(loader=loader, extensions=["jinja2.ext.TranslationExtractorExtension"])
+    record = list(env.extract_marked_translations_from_templates(["logical.html"]))[0]
+    assert record["source"] == "logical.html"
+    assert record["messages"] == [{"lineno": 1, "function": "gettext", "message": "First"}]
+    loader.message = "Second"
+    assert list(env.extract_marked_translations_from_templates(["logical.html"]))[0]["messages"][0]["message"] == "Second"
+    with pytest.raises(TemplateNotFound) as error:
+        list(env.extract_marked_translations_from_templates(["missing.html"]))
+    assert error.value.name == "missing.html"
+
+
+def test_marker_batch_function_loader_explicit_names_without_listing():
+    from jinja2 import FunctionLoader
+
+    source = '{% extract note="callable" %}{{ gettext("Hello") }}{% endextract %}'
+    env = Environment(loader=FunctionLoader(lambda name: source), extensions=["jinja2.ext.TranslationExtractorExtension"])
+    assert list(env.extract_marked_translations_from_templates(["page.html"]))[0]["source"] == "page.html"
+    with pytest.raises(TypeError):
+        list(env.extract_marked_translations_from_templates())
+
