+def test_marker_babel_entrypoint_preserves_message_lines_and_comments():
+    from jinja2.ext import babel_extract
+
+    source = (
+        '{% extract note="button" %}\n'
+        '{# trans Button caption #}\n'
+        '{{ gettext("Open") }}\n'
+        '{# trans Number of files #}\n'
+        '{{ ngettext("one file", "many files", n) }}\n'
+        '{% endextract %}\n'
+    )
+    options = {"extensions": "jinja2.ext.TranslationExtractorExtension", "silent": "false"}
+    assert list(babel_extract(BytesIO(source.encode()), ("gettext", "ngettext"), ["trans"], options)) == [
+        (3, "gettext", "Open", ["Button caption"]),
+        (5, "ngettext", ("one file", "many files", None), ["Number of files"]),
+    ]
+
