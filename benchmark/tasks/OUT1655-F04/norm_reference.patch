+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_mac_address_is_an_exported_composable_regex_term():
+    assert isinstance(types.mac_address, Regex)
+    framed = "<" + types.mac_address + ">"
+    assert re.fullmatch(to_regex(framed), "<00:1B:44:11:3A:B7>")
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["00:1B:44:11:3A:B7", "00-1b-44-11-3a-b7", "ff:ff:ff:ff:ff:ff"],
+)
+def test_mac_address_accepts_complete_valid_values(value):
+    assert re.fullmatch(to_regex(types.mac_address), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "00:1B:44:11:3A",
+        "00:1B:44:11:3A:B7:C8",
+        "00:1B:44-11:3A:B7",
+        "00.1B.44.11.3A.B7",
+        "001B44113AB7",
+        "GG:1B:44:11:3A:B7",
+        " 00:1B:44:11:3A:B7",
+    ],
+)
+def test_mac_address_rejects_invalid_complete_values(value):
+    assert re.fullmatch(to_regex(types.mac_address), value) is None
+
+
+def test_mac_address_works_in_pydantic_schema_and_validation():
+    class Interface(BaseModel):
+        address: types.mac_address
+
+    pattern = Interface.model_json_schema()["properties"]["address"]["pattern"]
+    assert re.fullmatch(pattern, "AA-BB-CC-DD-EE-FF")
+    assert Interface(address="AA-BB-CC-DD-EE-FF").address == "AA-BB-CC-DD-EE-FF"
+    with pytest.raises(ValidationError):
+        Interface(address="AA-BB:CC-DD-EE-FF")
