+def test_domain_public_installer_and_uninstall():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    calls = []
+    env.install_gettext_callables(
+        lambda message: "plain:" + message,
+        lambda singular, plural, n: singular if n == 1 else plural,
+        dgettext=lambda domain, message: f"{domain}:{message}",
+        dngettext=lambda domain, singular, plural, n: f"{domain}:" + (singular if n == 1 else plural),
+    )
+    assert env.from_string('{% trans domain="admin" %}Hello{% endtrans %}').render() == "admin:Hello"
+    assert env.from_string('{% trans domain="admin", n=2 %}One{% pluralize %}Many{% endtrans %}').render() == "admin:Many"
+    env.install_gettext_callables(lambda message: "new:" + message, lambda s, p, n: p)
+    assert env.from_string('{% trans domain="admin" %}Hello{% endtrans %}').render() == "new:Hello"
+    env.uninstall_gettext_translations(None)
+    assert "dgettext" not in env.globals and "dngettext" not in env.globals
+
+
+def test_domain_newstyle_variables():
+    env = Environment(extensions=["jinja2.ext.i18n"], autoescape=True)
+    env.install_gettext_callables(
+        lambda message: message, lambda s, p, n: p, newstyle=True,
+        dgettext=lambda domain, message: domain + ":" + message,
+        dngettext=lambda domain, s, p, n: domain + ":" + (s if n == 1 else p),
+    )
+    rendered = env.from_string('{% trans domain="shop" %}Hi {{ name }}{% endtrans %}').render(name="<x>")
+    assert rendered == "shop:Hi &lt;x&gt;"
+
+
+@pytest.mark.parametrize("plural", [False, True])
+@pytest.mark.parametrize("autoescape", [False, True])
+@pytest.mark.parametrize("domain_provider", [False, True])
+def test_domain_newstyle_translation_and_parameter_markup(
+    plural, autoescape, domain_provider
+):
+    env = Environment(extensions=["jinja2.ext.i18n"], autoescape=autoescape)
+    translated = "<strong>%(trusted)s / %(name)s</strong>"
+    domain = {}
+    if domain_provider:
+        domain = {
+            "dgettext": lambda domain, message: translated,
+            "dngettext": lambda domain, singular, plural, n: translated,
+        }
+    env.install_gettext_callables(
+        lambda message: translated, lambda singular, plural, n: translated,
+        newstyle=True, **domain,
+    )
+    if plural:
+        source = (
+            '{% trans domain="shop", n=2, trusted=trusted|safe %}'
+            '{{ trusted }} {{ name }} item{% pluralize %}'
+            '{{ trusted }} {{ name }} items{% endtrans %}'
+        )
+    else:
+        source = (
+            '{% trans domain="shop", trusted=trusted|safe %}'
+            '{{ trusted }} {{ name }}{% endtrans %}'
+        )
+    result = env.from_string(source).render(trusted="<em>ok</em>", name="<user>")
+    name = "&lt;user&gt;" if autoescape else "<user>"
+    assert result == f"<strong><em>ok</em> / {name}</strong>"
+
+
+@pytest.mark.parametrize("plural", [False, True])
+def test_domain_newstyle_formats_translation_without_placeholders(plural):
+    env = Environment(extensions=["jinja2.ext.i18n"], autoescape=True)
+    env.install_gettext_callables(
+        lambda message: message, lambda singular, plural, n: plural,
+        newstyle=True,
+        dgettext=lambda domain, message: "<b>100%%</b>",
+        dngettext=lambda domain, singular, plural, n: "<b>100%%</b>",
+    )
+    source = (
+        '{% trans domain="shop", n=2 %}One{% pluralize %}Many{% endtrans %}'
+        if plural else '{% trans domain="shop" %}Done{% endtrans %}'
+    )
+    assert env.from_string(source).render() == "<b>100%</b>"
