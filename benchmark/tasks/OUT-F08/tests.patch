+@pytest.fixture
+def v5_memory_runtime(monkeypatch):
+    import xgrammar as xgr
+    import psutil
+    from types import SimpleNamespace
+    from unittest.mock import Mock
+    primary = Mock(side_effect=lambda ids, logits: logits)
+    monkeypatch.setattr(xgr.contrib.hf, "LogitsProcessor", lambda grammar: primary)
+    rss = Mock(return_value=SimpleNamespace(rss=0))
+    monkeypatch.setattr(psutil, "Process", lambda *a, **k: SimpleNamespace(memory_info=rss))
+    return primary, rss
