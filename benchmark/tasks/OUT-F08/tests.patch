+@pytest.mark.parametrize("limit", [None, 0, 2])
+def test_v5_memory_window_and_lifetime(v5_memory_runtime, limit):
+    import torch
+    from types import SimpleNamespace
+    primary, rss = v5_memory_runtime
+    readings = [100, 112, 112, 115, 115, 114, 114, 119]
+    rss.side_effect = [SimpleNamespace(rss=n * 1024 ** 2) for n in readings]
+    processor = XGrammarLogitsProcessor("test", track_memory_usage=True, memory_history_limit=limit)
+    for _ in range(4):
+        result = processor(torch.tensor([1]), torch.zeros(5))
+        assert result.shape == (5,)
+    expected = [12.0, 3.0, 0.0, 5.0]
+    stats = processor.get_memory_stats()
+    assert stats == {"peak_memory_mb": 12.0, "total_calls": 4, "avg_memory_per_call_mb": 5.0,
+                     "memory_history": expected if limit is None else expected[-limit:] if limit else []}
+    stats["memory_history"].append(999)
+    stats["total_calls"] = 999
+    assert processor.get_memory_stats()["total_calls"] == 4
+    assert 999 not in processor.get_memory_stats()["memory_history"]
+    processor.reset()
+    assert processor.get_memory_stats() == {"peak_memory_mb": 0.0, "total_calls": 0,
+                                           "avg_memory_per_call_mb": 0.0, "memory_history": []}
+
+
+def test_v5_memory_sampling_and_processing_errors(v5_memory_runtime):
+    import torch
+    from types import SimpleNamespace
+    primary, rss = v5_memory_runtime
+    processor = XGrammarLogitsProcessor("test", track_memory_usage=True)
+    rss.side_effect = [OSError("rss"), SimpleNamespace(rss=100 * 1024 ** 2),
+                       SimpleNamespace(rss=100 * 1024 ** 2), OSError("rss")]
+    for _ in range(2):
+        processor(torch.tensor([[1]]), torch.zeros(1, 5))
+    assert processor.get_memory_stats()["memory_history"] == [0.0, 0.0]
+    rss.side_effect = None
+    error = ValueError("processing failed")
+    primary.side_effect = error
+    with pytest.raises(ValueError) as caught:
+        processor(torch.tensor([[1]]), torch.zeros(1, 5))
+    assert caught.value is error
+    assert processor.get_memory_stats()["total_calls"] == 2
+    primary.side_effect = lambda ids, scores: scores
+    disabled = XGrammarLogitsProcessor("test")
+    before = rss.call_count
+    disabled(torch.tensor([[1]]), torch.zeros(1, 5))
+    disabled.reset()
+    assert rss.call_count == before
+    assert disabled.get_memory_stats()["total_calls"] == 0
+
+
+def test_v5_memory_public_concurrent_updates(v5_memory_runtime):
+    import torch
+    from concurrent.futures import ThreadPoolExecutor
+    processor = XGrammarLogitsProcessor("test", track_memory_usage=True, memory_history_limit=3)
+    def process(_):
+        return processor(torch.tensor([[1]]), torch.zeros(1, 5))
+    with ThreadPoolExecutor(max_workers=8) as executor:
+        list(executor.map(process, range(200)))
+    assert processor.get_memory_stats() == {
+        "total_calls": 200, "peak_memory_mb": 0.0,
+        "avg_memory_per_call_mb": 0.0, "memory_history": [0.0] * 3}
+
+
+@pytest.mark.parametrize("factory,grammar", [
+    ("get_regex_logits_processor", "a|b"),
+    ("get_cfg_logits_processor", 'root ::= "a" | "b"'),
+    ("get_json_schema_logits_processor", '{"type":"string"}'),
+])
+def test_v5_memory_factories(model_transformers, v5_memory_runtime, factory, grammar):
+    import torch
+    primary, rss = v5_memory_runtime
+    method = getattr(XGrammarBackend(model_transformers), factory)
+    processor = method(grammar, track_memory_usage=True, memory_history_limit=0)
+    for _ in range(12):  # Cover periodic logging with an empty retained history.
+        processor(torch.tensor([[1]]), torch.zeros(1, 5))
+    assert processor.get_memory_stats()["total_calls"] == 12
+    assert processor.get_memory_stats()["memory_history"] == []
+    for bad in (-1, 1.5, True, "1"):
+        with pytest.raises(ValueError):
+            method(grammar, memory_history_limit=bad)
