index 00000000..571b8868
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,129 @@
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+
+
+def install_runtime(monkeypatch, readings):
+    primary = Mock(side_effect=lambda input_ids, logits: logits)
+    monkeypatch.setattr(
+        "xgrammar.contrib.hf.LogitsProcessor", Mock(return_value=primary)
+    )
+    memory_info = Mock(
+        side_effect=[SimpleNamespace(rss=value * 1024**2) for value in readings]
+    )
+    monkeypatch.setattr(
+        "outlines.backends.xgrammar.psutil.Process",
+        lambda: SimpleNamespace(memory_info=memory_info),
+    )
+    return primary, memory_info
+
+
+@pytest.mark.parametrize(
+    "limit,expected", [(None, [12.0, 3.0, 0.0, 5.0]), (0, []), (2, [0.0, 5.0])]
+)
+def test_history_window_keeps_lifetime_statistics(monkeypatch, limit, expected):
+    install_runtime(monkeypatch, [100, 112, 112, 115, 115, 114, 114, 119])
+    processor = XGrammarLogitsProcessor("grammar", True, limit)
+
+    for _ in range(4):
+        assert processor(torch.tensor([1]), torch.zeros(5)).shape == (5,)
+
+    stats = processor.get_memory_stats()
+    assert stats == {
+        "peak_memory_mb": 12.0,
+        "total_calls": 4,
+        "avg_memory_per_call_mb": 5.0,
+        "memory_history": expected,
+    }
+    stats["total_calls"] = 99
+    stats["memory_history"].append(99.0)
+    assert processor.get_memory_stats()["total_calls"] == 4
+    assert 99.0 not in processor.get_memory_stats()["memory_history"]
+
+    processor.reset()
+    assert processor.track_memory_usage is True
+    assert processor.memory_history_limit == limit
+    assert processor.get_memory_stats() == {
+        "peak_memory_mb": 0.0,
+        "total_calls": 0,
+        "avg_memory_per_call_mb": 0.0,
+        "memory_history": [],
+    }
+
+
+def test_sampling_and_processing_failures(monkeypatch):
+    primary, memory_info = install_runtime(monkeypatch, [0, 0, 0, 0])
+    memory_info.side_effect = [
+        OSError("before"),
+        SimpleNamespace(rss=10),
+        SimpleNamespace(rss=10),
+        OSError("after"),
+    ]
+    processor = XGrammarLogitsProcessor("grammar", True)
+    for _ in range(2):
+        processor(torch.tensor([[1]]), torch.zeros(1, 5))
+    assert processor.get_memory_stats()["memory_history"] == [0.0, 0.0]
+
+    error = ValueError("processing failed")
+    primary.side_effect = error
+    with pytest.raises(ValueError) as caught:
+        processor(torch.tensor([[1]]), torch.zeros(1, 5))
+    assert caught.value is error
+    assert processor.get_memory_stats()["total_calls"] == 2
+
+    disabled = XGrammarLogitsProcessor("grammar")
+    before = memory_info.call_count
+    primary.side_effect = lambda input_ids, logits: logits
+    disabled(torch.tensor([[1]]), torch.zeros(1, 5))
+    assert memory_info.call_count == before
+
+
+def test_public_statistics_updates_are_thread_safe(monkeypatch):
+    install_runtime(monkeypatch, [0] * 400)
+    processor = XGrammarLogitsProcessor("grammar", True, 3)
+
+    with ThreadPoolExecutor(max_workers=8) as executor:
+        list(
+            executor.map(
+                lambda _: processor(torch.tensor([[1]]), torch.zeros(1, 5)),
+                range(200),
+            )
+        )
+
+    assert processor.get_memory_stats() == {
+        "peak_memory_mb": 0.0,
+        "total_calls": 200,
+        "avg_memory_per_call_mb": 0.0,
+        "memory_history": [0.0, 0.0, 0.0],
+    }
+
+
+@pytest.mark.parametrize(
+    "factory,compile_method,source",
+    [
+        ("get_json_schema_logits_processor", "compile_json_schema", "{}"),
+        ("get_regex_logits_processor", "compile_regex", "a|b"),
+        ("get_cfg_logits_processor", "compile_grammar", 'root ::= "a"'),
+    ],
+)
+def test_factories_forward_memory_options(factory, compile_method, source):
+    backend = object.__new__(XGrammarBackend)
+    compiler = Mock()
+    setattr(compiler, compile_method, Mock(return_value="compiled"))
+    backend.grammar_compiler = compiler
+
+    processor = getattr(backend, factory)(source, True, 0)
+
+    assert processor.track_memory_usage is True
+    assert processor.memory_history_limit == 0
+
+
+@pytest.mark.parametrize("value", [-1, 1.5, True, "1"])
+def test_invalid_history_limits_are_rejected(value):
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor("grammar", memory_history_limit=value)
