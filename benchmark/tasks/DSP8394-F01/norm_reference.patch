@@ -0,0 +1,84 @@
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+from unittest.mock import patch
+
+import pytest
+
+from dspy.clients.cache import Cache, request_cache
+
+
+@pytest.fixture
+def cache(tmp_path):
+    return Cache(
+        enable_disk_cache=False,
+        enable_memory_cache=True,
+        disk_cache_dir=str(tmp_path),
+        memory_max_entries=20,
+    )
+
+
+def test_bypass_recomputes_and_retains_the_fresh_value(cache):
+    calls = []
+
+    @request_cache()
+    def compute(*, value):
+        calls.append(value)
+        return len(calls)
+
+    with patch("dspy.cache", cache):
+        assert compute(value="same") == 1
+        assert compute(value="same") == 1
+        with cache.bypass():
+            assert compute(value="same") == 2
+            assert compute(value="same") == 3
+        assert compute(value="same") == 3
+
+
+def test_nested_and_exceptional_exit_restore_prior_state(cache):
+    request = {"value": 1}
+    cache.put(request, "cached")
+
+    with pytest.raises(RuntimeError), cache.bypass():
+        assert cache.get(request) is None
+        with cache.bypass():
+            assert cache.get(request) is None
+        assert cache.get(request) is None
+        raise RuntimeError("stop")
+
+    assert cache.get(request) == "cached"
+
+
+def test_bypass_is_local_to_cache_instance_and_thread(cache, tmp_path):
+    other = Cache(False, True, str(tmp_path / "other"), memory_max_entries=20)
+    request = {"value": 1}
+    cache.put(request, "first")
+    other.put(request, "second")
+
+    with cache.bypass():
+        assert cache.get(request) is None
+        assert other.get(request) == "second"
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            assert executor.submit(cache.get, request).result() == "first"
+
+
+@pytest.mark.asyncio
+async def test_sync_bypass_survives_await_without_leaking_to_sibling(cache):
+    request = {"value": 1}
+    cache.put(request, "cached")
+    sibling_started = asyncio.Event()
+    release_sibling = asyncio.Event()
+
+    async def sibling():
+        sibling_started.set()
+        await release_sibling.wait()
+        return cache.get(request)
+
+    task = asyncio.create_task(sibling())
+    await sibling_started.wait()
+    with cache.bypass():
+        await asyncio.sleep(0)
+        assert cache.get(request) is None
+        release_sibling.set()
+        assert await task == "cached"
+
+    assert cache.get(request) == "cached"
