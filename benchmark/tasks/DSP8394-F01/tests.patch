+def test_bypass_thread_isolation_with_overlap(cache):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Event
+    request = {"prompt": "overlap"}
+    cache.put(request, "available")
+    entered, inspected = Event(), Event()
+    def bypass_reader():
+        with cache.bypass():
+            entered.set()
+            assert inspected.wait(10)
+            return cache.get(request)
+    def normal_reader():
+        try:
+            assert entered.wait(10)
+            return cache.get(request)
+        finally:
+            inspected.set()
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        bypassed = executor.submit(bypass_reader)
+        normal = executor.submit(normal_reader)
+        assert normal.result(timeout=15) == "available"
+        assert bypassed.result(timeout=15) is None
+    assert cache.get(request) == "available"
+
+
+@pytest.mark.asyncio
+async def test_bypass_async_decorator_and_task_isolation(cache):
+    import asyncio
+    from dspy.clients.cache import request_cache
+    calls = []
+    @request_cache()
+    async def compute(prompt):
+        calls.append(prompt)
+        return len(calls)
+    entered, observed = asyncio.Event(), asyncio.Event()
+    async def bypassed():
+        with cache.bypass():
+            entered.set()
+            await asyncio.wait_for(observed.wait(), 10)
+            assert await compute("async") == 2
+    async def normal():
+        try:
+            await asyncio.wait_for(entered.wait(), 10)
+            assert await compute("async") == 1
+        finally:
+            observed.set()
+    with patch("dspy.cache", cache):
+        assert await compute("async") == 1
+        await asyncio.gather(bypassed(), normal())
+        assert await compute("async") == 2
+        assert calls == ["async", "async"]
+
+
+def test_bypass_is_limited_to_its_cache_instance(tmp_path):
+    caches = [Cache(False, True, str(tmp_path / str(i))) for i in range(2)]
+    request = {"prompt": "independent"}
+    first, second = caches
+    first.put(request, "first")
+    second.put(request, "second")
+    with first.bypass():
+        assert first.get(request) is None
+        assert second.get(request) == "second"
+        with second.bypass():
+            assert first.get(request) is second.get(request) is None
+            first.put(request, "fresh first")
+            second.put(request, "fresh second")
+        assert first.get(request) is None
+        assert second.get(request) == "fresh second"
+    assert first.get(request) == "fresh first"
+    assert second.get(request) == "fresh second"
