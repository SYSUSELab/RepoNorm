+def test_bypass_exception_restores_nested_state(cache):
+    request = {"prompt": "restore"}
+    cache.put(request, "before")
+    with cache.bypass():
+        with pytest.raises(RuntimeError, match="sentinel"):
+            with cache.bypass():
+                cache.put(request, "written")
+                raise RuntimeError("sentinel")
+        assert cache.get(request) is None
+    assert cache.get(request) == "written"
+
