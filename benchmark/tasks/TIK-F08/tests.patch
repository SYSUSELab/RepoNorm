+from collections import Counter
+import pytest
+import tiktoken
+
+
+@pytest.mark.parametrize('text', ['', 'a','aaa','abababa','abcdef','<X><X><X>', '你好😀'])
+def test_pair_frequency_boundaries(text):
+    enc=tiktoken.Encoding('byte-patterns',pat_str=r'[\s\S]',
+        mergeable_ranks={bytes([i]):i for i in range(256)},special_tokens={'<X>':256})
+    expected=enc.encode(text,allowed_special='all')
+    tokens,counts=enc.encode(text,allowed_special='all',return_repeated_pattern=True)
+    truth=Counter(zip(expected,expected[1:]))
+    assert tokens==expected
+    assert len(counts)==min(3,len(truth))
+    assert all(key in truth and count==truth[key] for key,count in counts.items())
+    if len(truth)>3:
+        assert min(counts.values()) >= max(v for k,v in truth.items() if k not in counts)
+    else:
+        assert counts==truth
+    with pytest.raises(ValueError):
+        enc.encode('<X>',return_repeated_pattern=True)
