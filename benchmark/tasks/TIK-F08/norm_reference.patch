@@ -0,0 +1,49 @@
+from collections import Counter
+
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def byte_encoding():
+    return tiktoken.Encoding(
+        "byte-patterns",
+        pat_str=r"[\s\S]",
+        mergeable_ranks={bytes([i]): i for i in range(256)},
+        special_tokens={"<X>": 256},
+    )
+
+
+@pytest.mark.parametrize("text", ["", "a", "aaa", "abababa", "abcdef", "你好😀"])
+def test_pair_counts_match_top_three(byte_encoding, text) -> None:
+    expected = byte_encoding.encode(text)
+    tokens, patterns = byte_encoding.encode(text, return_repeated_pattern=True)
+    truth = Counter(zip(expected, expected[1:]))
+    assert tokens == expected
+    assert len(patterns) == min(3, len(truth))
+    assert all(truth[pair] == count for pair, count in patterns.items())
+    if len(truth) > 3:
+        omitted = [count for pair, count in truth.items() if pair not in patterns]
+        assert min(patterns.values()) >= max(omitted)
+
+
+def test_overlapping_pairs_and_default_shape(byte_encoding) -> None:
+    tokens, patterns = byte_encoding.encode("aaaa", return_repeated_pattern=True)
+    assert patterns == {(tokens[0], tokens[0]): 3}
+    assert isinstance(byte_encoding.encode("aaaa"), list)
+
+
+def test_special_policy_and_surrogate_recovery_are_preserved(byte_encoding) -> None:
+    with pytest.raises(ValueError, match="disallowed special token"):
+        byte_encoding.encode("<X>", return_repeated_pattern=True)
+    tokens, patterns = byte_encoding.encode(
+        "<X>", allowed_special="all", return_repeated_pattern=True
+    )
+    assert tokens == [256]
+    assert patterns == {}
+
+    text = "before \ud800 after"
+    tokens, patterns = byte_encoding.encode(text, return_repeated_pattern=True)
+    assert tokens == byte_encoding.encode(text)
+    assert sum(patterns.values()) <= max(0, len(tokens) - 1)
