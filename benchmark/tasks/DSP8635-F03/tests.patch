+import copy
+import random
+from types import SimpleNamespace
+
+import pytest
+import dspy
+from dspy.predict.predict import Predict as RealPredict
+from dspy.propose import grounded_proposer as gp
+
+
+class ExampleProgram(dspy.Module):
+    def __init__(self, two=False):
+        super().__init__()
+        self.first = RealPredict('question -> answer')
+        if two:
+            self.second = RealPredict('question -> answer')
+
+
+def recording_proposer(monkeypatch, *, outputs=None, program=None, rng=None, **options):
+    program = program or ExampleProgram()
+    outputs = outputs or {}
+    events = []
+    model = SimpleNamespace(kwargs={'temperature': 0.7, 'max_tokens': 500}, inspect_history=lambda **kw: None)
+    class Recorder:
+        def __init__(self, signature):
+            self.signature = signature
+        def __call__(self, **kwargs):
+            events.append({'signature': self.signature, 'kwargs': copy.deepcopy(kwargs),
+                           'model_kwargs': dict(model.kwargs)})
+            if outputs.get('raise_on') == self.signature.__name__:
+                raise RuntimeError('recorded generation failure')
+            values = {}
+            for field in self.signature.output_fields:
+                if self.signature.__name__ == 'ShortenInstruction':
+                    values[field] = outputs.get('shortened', 'A shortened instruction.')
+                else:
+                    values[field] = outputs.get(field, {
+                        'program_description': 'Program description. More details.',
+                        'module_description': 'Module description. More details.',
+                        'proposed_instruction': 'PROPOSED INSTRUCTION: A useful generated instruction.',
+                    }.get(field, 'value'))
+            return dspy.Prediction(**values)
+    monkeypatch.setattr(gp.dspy, 'Predict', Recorder)
+    monkeypatch.setattr(gp, 'get_prompt_model', lambda supplied: supplied)
+    monkeypatch.setattr(gp, 'get_dspy_source_code', lambda program: 'recorded program code')
+    monkeypatch.setattr(gp, 'create_dataset_summary', lambda **kwargs: 'recorded summary')
+    settings = dict(use_dataset_summary=False, program_aware=True, use_task_demos=False,
+                    set_tip_randomly=False, set_history_randomly=False, rng=rng or random.Random(17))
+    settings.update(options)
+    proposer = gp.GroundedProposer(prompt_model=model, program=program, trainset=[], **settings)
+    return proposer, program, model, events
+
+
+def propose(proposer, program, *, count=1, logs=None):
+    return proposer.propose_instructions_for_program([], program, None, logs or {}, count, 0.5)
+
+
+def generation_events(events):
+    return [event for event in events if event['signature'].__name__ == 'GenerateSingleModuleInstruction']
+
+
+class ControlledRng:
+    def __init__(self, point=0.0, fallback='creative'):
+        self.point = point
+        self.fallback = fallback
+        self.uniform_choices = 0
+    def random(self):
+        return self.point
+    def choice(self, choices):
+        self.uniform_choices += 1
+        assert self.fallback in choices
+        return self.fallback
+    def choices(self, population, weights=None, *, cum_weights=None, k=1):
+        weights = weights or [1] * len(population)
+        cumulative = 0
+        point = self.point * sum(weights)
+        for item, weight in zip(population, weights):
+            cumulative += weight
+            if point < cumulative:
+                return [item] * k
+        return [population[-1]] * k
+    def uniform(self, low, high):
+        return .02
+
+
+def test_weighted_selection_reaches_prompt_and_excludes_zero_boundary(monkeypatch):
+    weights = {key: 0 for key in gp.TIPS}
+    weights['creative'] = 1
+    proposer, program, model, events = recording_proposer(monkeypatch, rng=ControlledRng(0),
+        set_tip_randomly=True, tip_weights=weights)
+    propose(proposer, program, count=2)
+    assert [event['kwargs']['tip'] for event in generation_events(events)] == [gp.TIPS['creative']] * 2
+
+
+@pytest.mark.parametrize('invalid', [-1, 'bad', None, float('nan'), float('inf'), True])
+def test_invalid_weights_are_zero_and_missing_weights_default_one(monkeypatch, invalid):
+    weights = {key: invalid for key in gp.TIPS}
+    del weights['simple']
+    proposer, program, model, events = recording_proposer(monkeypatch, rng=ControlledRng(0),
+        set_tip_randomly=True, tip_weights=weights)
+    propose(proposer, program)
+    assert generation_events(events)[0]['kwargs']['tip'] == gp.TIPS['simple']
+
+
+@pytest.mark.parametrize('weights', [None, {key: 0 for key in gp.TIPS}])
+def test_uniform_fallback_is_used_for_none_or_all_zero(monkeypatch, weights):
+    rng = ControlledRng(point=.99, fallback='persona')
+    proposer, program, model, events = recording_proposer(monkeypatch, rng=rng,
+        set_tip_randomly=True, tip_weights=weights)
+    propose(proposer, program)
+    assert generation_events(events)[0]['kwargs']['tip'] == gp.TIPS['persona']
+
+
+def test_large_finite_weights_and_seed_replay(monkeypatch):
+    weights = {key: 0 for key in gp.TIPS}
+    weights.update(creative=1e308, simple=1e308)
+    proposer, program, model, events = recording_proposer(monkeypatch, rng=ControlledRng(.75),
+        set_tip_randomly=True, tip_weights=weights)
+    propose(proposer, program)
+    assert generation_events(events)[0]['kwargs']['tip'] == gp.TIPS['simple']
+    def replay():
+        proposer, program, model, events = recording_proposer(monkeypatch, rng=random.Random(123),
+            set_tip_randomly=True, tip_weights={'creative': 5, 'simple': 2})
+        propose(proposer, program, count=10)
+        return [event['kwargs']['tip'] for event in generation_events(events)]
+    assert replay() == replay()
