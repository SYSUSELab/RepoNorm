diff --git a/tests/backends/test_xgrammar_contribution.py b/tests/backends/test_xgrammar_contribution.py
new file mode 100644
index 00000000..514565c2
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,48 @@
+from unittest.mock import Mock
+
+import pytest
+import torch
+import xgrammar as xgr
+
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+
+
+@pytest.fixture
+def passthrough_wrapper(monkeypatch):
+    class PassthroughProcessor:
+        def __init__(self, grammar):
+            self.grammar = grammar
+
+        def __call__(self, input_ids, logits):
+            return logits
+
+    monkeypatch.setattr(xgr.contrib.hf, "LogitsProcessor", PassthroughProcessor)
+
+
+@pytest.mark.parametrize("value", [-1, True, 1.5, "2"])
+def test_batch_limit_rejects_invalid_values(value):
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor(object(), max_batch_size=value)
+
+
+def test_rejected_first_call_does_not_consume_state(passthrough_wrapper):
+    processor = XGrammarLogitsProcessor(object(), max_batch_size=1)
+    with pytest.raises(ValueError, match="Batch size 2 exceeds maximum"):
+        processor(torch.tensor([[1], [2]]), torch.zeros(2, 4))
+
+    result = processor(torch.tensor([1]), torch.zeros(4))
+    assert result.shape == (4,)
+    processor.reset()
+    with pytest.raises(ValueError, match="Batch size 2 exceeds maximum"):
+        processor(torch.tensor([[1], [2]]), torch.zeros(2, 4))
+
+
+def test_all_backend_factories_forward_batch_limit():
+    backend = object.__new__(XGrammarBackend)
+    backend.grammar_compiler = Mock()
+    processors = [
+        backend.get_json_schema_logits_processor("{}", max_batch_size=1),
+        backend.get_regex_logits_processor("a", max_batch_size=2),
+        backend.get_cfg_logits_processor('root ::= "a"', max_batch_size=3),
+    ]
+    assert [processor.max_batch_size for processor in processors] == [1, 2, 3]
