+def test_state_snapshot_preserves_aliases_cycles_and_shared_meta():
+    parent = click.Context(click.Command("parent"))
+    child = click.Context(click.Command("child"), parent=parent)
+    shared = []
+    shared.append(shared)
+    child.params["shared"] = shared
+    child.obj = {"shared": shared, "metadata": child.meta}
+    child.meta["shared"] = shared
+    child.meta["self"] = child.meta
+    meta_identity = child.meta
+    snapshot = child.save_state()
+    assert snapshot["params"]["shared"] is snapshot["obj"]["shared"]
+    assert snapshot["params"]["shared"] is not shared
+    child.params = {}
+    child.meta.clear()
+    for _ in range(2):
+        child.restore_state(snapshot)
+        restored = child.params["shared"]
+        assert restored is child.obj["shared"] is child.meta["shared"]
+        assert restored[0] is restored
+        assert restored is not snapshot["params"]["shared"]
+        assert parent.meta is child.meta is meta_identity
+        assert child.meta["self"] is child.meta
+        assert child.obj["metadata"] is child.meta
+        restored.append("changed")
+        assert len(snapshot["params"]["shared"]) == 1
+
+
+@pytest.mark.parametrize("damage", ["missing", "copy_failure", "invalid_meta"])
+def test_restore_state_is_atomic_and_ignores_unknown_fields(damage):
+    class CannotCopy:
+        def __deepcopy__(self, memo):
+            raise RuntimeError("uncopyable")
+
+    ctx = click.Context(click.Command("cmd"))
+    ctx.params = {"value": "saved"}
+    snapshot = ctx.save_state()
+    if damage == "missing":
+        del snapshot["color"]
+    elif damage == "copy_failure":
+        snapshot["obj"] = CannotCopy()
+    else:
+        snapshot["_meta"] = None
+    ctx.params = {"value": "current"}
+    ctx.obj = ["current"]
+    ctx.meta["current"] = True
+    before = ctx.save_state()
+    identities = (ctx.params, ctx.obj, ctx.meta)
+    with pytest.raises((ValueError, KeyError, RuntimeError, TypeError)):
+        ctx.restore_state(snapshot)
+    assert ctx.save_state() == before
+    assert (
+        ctx.params is identities[0]
+        and ctx.obj is identities[1]
+        and ctx.meta is identities[2]
+    )
+    events = []
+    ctx.call_on_close(lambda: events.append("closed"))
+    valid = ctx.save_state()
+    valid.update(
+        _exit_stack=CannotCopy(), parent="wrong", command="wrong", arbitrary=True
+    )
+    command = ctx.command
+    ctx.restore_state(valid)
+    assert ctx.command is command and ctx.parent is None
+    assert not hasattr(ctx, "arbitrary")
+    ctx.close()
+    assert events == ["closed"]
