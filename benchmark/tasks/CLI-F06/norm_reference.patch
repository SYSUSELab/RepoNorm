index 0000000..bb26a1b
--- /dev/null
+++ b/tests/test_context_state_contribution.py
@@ -0,0 +1,114 @@
+from contextlib import contextmanager
+
+import pytest
+
+import click
+
+
+def test_snapshot_is_independent_and_reusable() -> None:
+    ctx = click.Context(click.Command("cmd"), obj={"items": [1]})
+    ctx.params = {"value": [1]}
+    snapshot = ctx.save_state()
+
+    ctx.params["value"].append(2)
+    ctx.obj["items"].append(2)
+    assert snapshot["params"] == {"value": [1]}
+    assert snapshot["obj"] == {"items": [1]}
+
+    ctx.restore_state(snapshot)
+    ctx.params["value"].append(3)
+    assert snapshot["params"] == {"value": [1]}
+    ctx.restore_state(snapshot)
+    assert ctx.params == {"value": [1]}
+
+
+def test_snapshot_preserves_aliases_and_cycles() -> None:
+    shared = []
+    shared.append(shared)
+    ctx = click.Context(click.Command("cmd"), obj=shared)
+    ctx.params = {"shared": shared}
+    snapshot = ctx.save_state()
+    assert snapshot["obj"] is snapshot["params"]["shared"]
+    assert snapshot["obj"][0] is snapshot["obj"]
+
+    ctx.restore_state(snapshot)
+    assert ctx.obj is ctx.params["shared"]
+    assert ctx.obj[0] is ctx.obj
+    assert ctx.obj is not snapshot["obj"]
+
+
+def test_restore_preserves_parent_child_metadata_identity() -> None:
+    parent = click.Context(click.Command("parent"), obj={"name": "parent"})
+    child = click.Context(click.Command("child"), parent=parent)
+    child.meta["items"] = [1]
+    child.obj = {"metadata": child.meta}
+    snapshot = child.save_state()
+    child.meta["items"].append(2)
+
+    child.restore_state(snapshot)
+    assert child.meta is parent.meta
+    assert child.obj["metadata"] is parent.meta
+    assert child.meta == {"items": [1]}
+    assert child.meta is not snapshot["_meta"]
+
+
+@pytest.mark.parametrize("damage", ["missing", "invalid_meta", "copy_failure"])
+def test_restore_validation_and_copy_failures_are_transactional(damage) -> None:
+    class Uncopyable:
+        def __deepcopy__(self, memo):
+            raise RuntimeError("cannot copy")
+
+    ctx = click.Context(click.Command("cmd"), obj={"before": True})
+    ctx.params = {"before": [1]}
+    snapshot = ctx.save_state()
+    snapshot["unknown"] = "ignored"
+    if damage == "missing":
+        snapshot.pop("args")
+        expected = ValueError
+    elif damage == "invalid_meta":
+        snapshot["_meta"] = []
+        expected = TypeError
+    else:
+        snapshot["obj"] = Uncopyable()
+        expected = RuntimeError
+
+    before_obj = ctx.obj
+    before_params = ctx.params
+    with pytest.raises(expected):
+        ctx.restore_state(snapshot)
+    assert ctx.obj is before_obj
+    assert ctx.params is before_params
+
+
+def test_unknown_keys_are_ignored_and_parameter_sources_restore() -> None:
+    option = click.Option(["--value"])
+    ctx = click.Context(click.Command("cmd", params=[option]))
+    ctx.set_parameter_source("value", click.core.ParameterSource.COMMANDLINE)
+    snapshot = ctx.save_state()
+    snapshot["unknown"] = object()
+    ctx.set_parameter_source("value", click.core.ParameterSource.DEFAULT)
+    ctx.restore_state(snapshot)
+    assert ctx.get_parameter_source("value") is click.core.ParameterSource.COMMANDLINE
+    assert not hasattr(ctx, "unknown")
+
+
+def test_restore_does_not_replace_resource_lifecycle_or_dynamic_attributes() -> None:
+    events = []
+
+    @contextmanager
+    def resource():
+        events.append("enter")
+        try:
+            yield
+        finally:
+            events.append("exit")
+
+    ctx = click.Context(click.Command("cmd"))
+    snapshot = ctx.save_state()
+    ctx.dynamic_value = "keep"
+    ctx.call_on_close(lambda: events.append("callback"))
+    ctx.with_resource(resource())
+    ctx.restore_state(snapshot)
+    assert ctx.dynamic_value == "keep"
+    ctx.close()
+    assert events == ["enter", "exit", "callback"]
