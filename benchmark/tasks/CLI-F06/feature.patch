+    def save_state(self) -> dict[str, t.Any]:
+        """Create a snapshot of the current context state.
+
+        This captures the supported mutable parsing and presentation state,
+        including parameters, options, and command metadata. Open resources,
+        the exit stack, and arbitrary dynamically added attributes are excluded. The snapshot
+        can be used with :meth:`restore_state` to revert the context
+        back to the captured state.
+
+        :return: A dictionary containing the snapshot of the context state.
+
+        .. versionadded:: 8.2
+        """
+        import copy
+
+        return copy.deepcopy({name: getattr(self, name) for name in self._state_fields})
+
+    _state_fields = (
+        "params",
+        "args",
+        "_protected_args",
+        "_opt_prefixes",
+        "obj",
+        "_meta",
+        "default_map",
+        "invoked_subcommand",
+        "terminal_width",
+        "max_content_width",
+        "allow_extra_args",
+        "allow_interspersed_args",
+        "ignore_unknown_options",
+        "help_option_names",
+        "token_normalize_func",
+        "resilient_parsing",
+        "auto_envvar_prefix",
+        "color",
+        "show_default",
+        "_parameter_source",
+    )
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Restore the context to a previously saved state.
+
+        This reverts the supported parsing and presentation attributes to
+        the state captured in the provided snapshot. Resource lifecycle state
+        and arbitrary dynamically added attributes are not restored.
+
+        :param snapshot: A snapshot dictionary created by :meth:`save_state`.
+
+        .. versionadded:: 8.2
+        """
+        import copy
+
+        if not isinstance(snapshot, dict):
+            raise TypeError("snapshot must be a dictionary")
+        if any(name not in snapshot for name in self._state_fields):
+            raise ValueError("snapshot is missing supported fields")
+        raw = {name: snapshot[name] for name in self._state_fields}
+        if not isinstance(raw["_meta"], dict):
+            raise TypeError("snapshot metadata must be a dictionary")
+        # Preserve the existing hierarchy-shared metadata root, including
+        # references to that root elsewhere in the copied state graph.
+        memo = {id(raw["_meta"]): self._meta}
+        metadata = copy.deepcopy(dict(raw["_meta"]), memo)
+        restored = copy.deepcopy(raw, memo)
+        self._meta.clear()
+        self._meta.update(metadata)
+        for name, value in restored.items():
+            if name != "_meta":
+                setattr(self, name, value)
+
 
