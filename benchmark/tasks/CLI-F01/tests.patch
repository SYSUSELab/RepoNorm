+@pytest.mark.parametrize("chain", [False, True])
+def test_completion_resources_live_until_candidates_then_close(tmp_path, chain):
+    opened = []
+    path = tmp_path / "config.txt"
+    path.write_text("payload")
+
+    class RecordingFile(File):
+        def convert(self, value, param, ctx):
+            value = super().convert(value, param, ctx)
+            opened.append(value)
+            return value
+
+    def option():
+        return Option(["--config"], default=str(path), type=RecordingFile())
+
+    def complete(ctx, param, incomplete):
+        assert all(not file.closed for file in opened)
+        assert ctx.params["config"].read() == "payload"
+        return [CompletionItem("candidate")]
+
+    leaf = Command(
+        "leaf", params=[option(), Argument(["value"], shell_complete=complete)]
+    )
+    if chain:
+        cli = Group(
+            "cli",
+            chain=True,
+            params=[option()],
+            commands=[Command("first", params=[option()]), leaf],
+        )
+        args = ["first", "leaf"]
+    else:
+        cli = Group(
+            "cli",
+            params=[option()],
+            commands=[Group("middle", params=[option()], commands=[leaf])],
+        )
+        args = ["middle", "leaf"]
+    with warnings.catch_warnings(record=True) as captured:
+        warnings.simplefilter("always", ResourceWarning)
+        for _ in range(2):
+            opened.clear()
+            assert _get_words(cli, args, "") == ["candidate"]
+            assert len(opened) == 3
+            assert all(file.closed for file in opened)
+        opened.clear()
+        gc.collect()
+        assert not [w for w in captured if issubclass(w.category, ResourceWarning)]
+
+
+def test_completion_failure_closes_parsed_resources(tmp_path):
+    opened = []
+    path = tmp_path / "config"
+    path.write_text("payload")
+
+    class FailingCommand(Command):
+        def parse_args(self, ctx, args):
+            super().parse_args(ctx, args)
+            opened.append(ctx.params["config"])
+            raise RuntimeError("parse failed")
+
+    cli = FailingCommand(
+        "cli", params=[Option(["--config"], default=str(path), type=File())]
+    )
+    with pytest.raises(RuntimeError, match="parse failed"):
+        _get_completions(cli, [], "")
+    assert opened and all(file.closed for file in opened)
+
+
+def test_completion_callback_failure_keeps_error_and_closes_file(tmp_path):
+    path = tmp_path / "file"
+    path.write_text("payload")
+    opened = []
+
+    def complete(ctx, param, incomplete):
+        opened.append(ctx.params["config"])
+        assert not opened[0].closed
+        raise RuntimeError("completion failed")
+
+    cli = Command(
+        "cli",
+        params=[
+            Option(["--config"], type=File(), default=str(path)),
+            Argument(["value"], shell_complete=complete),
+        ],
+    )
+    with pytest.raises(RuntimeError, match="completion failed"):
+        _get_completions(cli, [], "")
+    assert len(opened) == 1 and opened[0].closed
