diff --git a/tests/test_completion_contribution.py b/tests/test_completion_contribution.py
new file mode 100644
index 0000000..1e52a78
--- /dev/null
+++ b/tests/test_completion_contribution.py
@@ -0,0 +1,50 @@
+from contextlib import contextmanager
+
+import pytest
+
+import click
+from click.shell_completion import CompletionItem
+from click.shell_completion import ShellComplete
+
+
+@pytest.mark.parametrize("raise_error", [False, True])
+def test_completion_resource_lifetime(raise_error):
+    events = []
+    contexts = []
+
+    @contextmanager
+    def resource():
+        events.append("opened")
+        try:
+            yield
+        finally:
+            events.append("closed")
+
+    def prepare(ctx, param, value):
+        # Do not let destruction of an unclosed context hide a missing close.
+        contexts.append(ctx)
+        ctx.with_resource(resource())
+        return value
+
+    def complete(ctx, param, incomplete):
+        assert events == ["opened"]
+        if raise_error:
+            raise LookupError("completion failed")
+        return [CompletionItem("candidate")]
+
+    command = click.Command(
+        "demo",
+        params=[
+            click.Option(["--setup"], callback=prepare),
+            click.Argument(["value"], shell_complete=complete),
+        ],
+    )
+    completion = ShellComplete(command, {}, "demo", "_DEMO_COMPLETE")
+    if raise_error:
+        with pytest.raises(LookupError, match="completion failed"):
+            completion.get_completions([], "")
+    else:
+        assert [item.value for item in completion.get_completions([], "")] == [
+            "candidate"
+        ]
+    assert events == ["opened", "closed"]
