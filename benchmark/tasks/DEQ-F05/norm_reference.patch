+
+def _phone_parentheses_valid(value: str) -> bool:
+    opened = False
+    digits_in_group = 0
+    for char in value:
+        if char == '(':
+            if opened:
+                return False
+            opened, digits_in_group = True, 0
+        elif char == ')':
+            if not opened or not digits_in_group:
+                return False
+            opened = False
+        elif opened and char in '0123456789':
+            digits_in_group += 1
+    return not opened
+
+
+class IsPhoneNumber(DirtyEquals[str]):
+    """
+    Match the supported international or national phone-number syntax,
+    optionally using the US or GB rules.
+    """
+
+    def __init__(self, country: Optional[str] = None):
+        """
+        Args:
+            country: The case-insensitive country code to validate against.
+                US and GB have national rules; other values accept only the
+                generic international syntax.
+
+        ```py title="IsPhoneNumber"
+        from dirty_equals import IsPhoneNumber
+
+        assert '+1-555-123-4567' == IsPhoneNumber()
+        assert '555-123-4567' == IsPhoneNumber('US')
+        assert '+44 20 7946 0958' == IsPhoneNumber('GB')
+        assert '(555) 123-4567' == IsPhoneNumber('US')
+        assert '+1 555 123 4567' == IsPhoneNumber()
+        assert 'invalid-phone' != IsPhoneNumber()
+        ```
+        """
+        self.country = country
+        super().__init__(country or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+        if not re.fullmatch(r'\+?[0-9 .()\-\t]+', other):
+            return False
+
+        if not _phone_parentheses_valid(other):
+            return False
+
+        normalized = re.sub(r'[\s\-\(\)\.]', '', other)
+        patterns: Tuple[str, ...]
+        if self.country is None:
+            patterns = (r'\+\d{8,19}', r'\d{7,15}')
+        elif self.country.upper() == 'US':
+            patterns = (r'\+1\d{10}', r'\d{10}')
+        elif self.country.upper() == 'GB':
+            patterns = (r'\+44\d{10,11}', r'0\d{9,10}')
+        else:
+            patterns = (r'\+\d{8,19}',)
+        return any(re.fullmatch(pattern, normalized) for pattern in patterns)
