+++ b/tests/test_phone_contribution.py
@@ -0,0 +1,38 @@
+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize(
+    'value,country',
+    [
+        ('555-123-4567', 'us'),
+        ('+1 (555) 123-4567', 'US'),
+        ('020 7946 0958', 'gb'),
+        ('+44 20 7946 0958', 'GB'),
+        ('+358 12345678', None),
+    ],
+)
+def test_phone_supported_syntax_and_value(value, country):
+    validator = de.IsPhoneNumber(country)
+    assert value == validator
+    assert validator.value == value
+
+
+def test_phone_country_and_generic_boundaries():
+    assert '+44 20 7946 0958' != de.IsPhoneNumber('US')
+    assert '+1 555 123 4567' != de.IsPhoneNumber('GB')
+    assert '5551234567' != de.IsPhoneNumber('FR')
+    assert '+3312345678' == de.IsPhoneNumber('FR')
+
+
+@pytest.mark.parametrize('value', ['+1 ((555)) 1234567', '(555 1234567', '+1\n5551234567', None])
+def test_phone_rejects_invalid_syntax(value):
+    assert value != de.IsPhoneNumber()
+
+
+def test_phone_composition_and_repr():
+    value = '+1 555 123 4567'
+    assert value == (de.IsPhoneNumber('US') & de.IsStr())
+    assert value == ~de.IsPhoneNumber('GB')
+    assert repr(de.IsPhoneNumber()) == 'IsPhoneNumber(*)'
