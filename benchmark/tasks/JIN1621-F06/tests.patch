+class TestModuleLoaderPathTransformation:
+    def test_module_loader_transforms_before_module_lookup(self, tmp_path):
+        source_env = Environment(
+            loader=loaders.DictLoader({"actual.html": "module source"})
+        )
+        source_env.compile_templates(str(tmp_path), zip=None)
+        calls = []
+
+        def transform(name):
+            calls.append(name)
+            return {"alias": "actual.html"}.get(name, name)
+
+        env = Environment(
+            loader=loaders.ModuleLoader(tmp_path, path_transform=transform)
+        )
+        assert env.get_template("alias").render() == "module source"
+        assert calls == ["alias"]
+
+    def test_module_loader_not_found_uses_original_name(self, tmp_path):
+        source_env = Environment(loader=loaders.DictLoader({"known": "source"}))
+        source_env.compile_templates(str(tmp_path), zip=None)
+        loader = loaders.ModuleLoader(
+            tmp_path, path_transform=lambda name: "missing"
+        )
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            Environment(loader=loader).get_template("alias")
+
+        assert exc_info.value.name == "alias"
+
