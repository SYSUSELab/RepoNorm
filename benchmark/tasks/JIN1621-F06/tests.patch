+@pytest.mark.parametrize("composite_kind", ["prefix", "choice"])
+@pytest.mark.parametrize("child_kind", ["custom", "function"])
+@pytest.mark.parametrize("auto_reload", [True, False])
+def test_transformed_composite_preserves_source_reload_contract(
+    composite_kind, child_kind, auto_reload
+):
+    state = {"source": "first {{ label }}"}
+
+    def source_for(name):
+        if name != "actual":
+            raise TemplateNotFound(name)
+        source = state["source"]
+        return source, None, lambda: state["source"] == source
+
+    class CustomLoader(loaders.BaseLoader):
+        def __init__(self, provide):
+            self.provide = provide
+
+        def get_source(self, environment, template):
+            return self.provide(template)
+
+    if child_kind == "custom":
+        child = CustomLoader(source_for)
+    else:
+        child = loaders.FunctionLoader(source_for)
+
+    if composite_kind == "prefix":
+        loader = loaders.PrefixLoader(
+            {"site": child}, path_transform=lambda name: "site/actual"
+        )
+    else:
+        loader = loaders.ChoiceLoader(
+            [loaders.DictLoader({}), child], path_transform=lambda name: "actual"
+        )
+
+    env = Environment(loader=loader, auto_reload=auto_reload)
+    first = env.get_template("alias")
+    assert first.render(label="page") == "first page"
+    assert env.get_template("alias") is first
+    state["source"] = "second {{ label }}"
+    latest = env.get_template("alias")
+    assert latest.render(label="page") == (
+        "second page" if auto_reload else "first page"
+    )
+    assert (latest is first) is (not auto_reload)
