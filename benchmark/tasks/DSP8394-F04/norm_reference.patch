index 000000000..f6321f721
--- /dev/null
+++ b/tests/clients/test_cache_stats_contribution.py
@@ -0,0 +1,86 @@
+import asyncio
+from dataclasses import dataclass
+
+import pytest
+
+import dspy
+from dspy.clients.cache import Cache, request_cache
+from dspy.utils.usage_tracker import track_usage
+
+
+@dataclass
+class Response:
+    value: str
+    usage: dict
+
+
+def make_cache(tmp_path, *, disk=False):
+    return Cache(disk, True, str(tmp_path), memory_max_entries=20)
+
+
+def test_stats_preserve_hit_lifecycle_and_return_copies(tmp_path):
+    cache = make_cache(tmp_path, disk=True)
+    request = {"key": 1}
+    original = Response("stored", {"tokens": 2})
+    cache.put(request, original)
+    hit = cache.get(request)
+    assert hit == Response("stored", {}) and hit is not original
+    cache.reset_memory_cache()
+    assert cache.get(request) == Response("stored", {})
+    assert cache.stats() == {"hits": 2, "mem_hits": 1, "disk_hits": 1, "misses": 0}
+    snapshot = cache.stats()
+    snapshot["hits"] = 99
+    cache.reset_stats()
+    assert cache.stats() == {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+    assert cache.get(request) == Response("stored", {})
+
+
+@pytest.mark.asyncio
+async def test_stats_keep_async_request_cache_transparent(tmp_path, monkeypatch):
+    cache = make_cache(tmp_path)
+    monkeypatch.setattr(dspy, "cache", cache)
+    calls = []
+
+    @request_cache()
+    async def compute(value):
+        calls.append(value)
+        await asyncio.sleep(0)
+        return len(calls)
+
+    assert await compute("same") == await compute("same") == 1
+    assert calls == ["same"]
+
+
+def test_cache_tracking_preserves_existing_lm_tracker(tmp_path, monkeypatch):
+    cache = make_cache(tmp_path)
+    monkeypatch.setattr(dspy, "cache", cache)
+
+    class Read(dspy.Module):
+        def forward(self):
+            cache.get({"missing": 1})
+            return dspy.Prediction(answer="ok")
+
+    with dspy.settings.context(track_usage=True):
+        with track_usage() as lm_tracker:
+            result = Read()()
+            assert result.get_lm_usage() is None
+            assert lm_tracker.get_total_tokens() == {}
+    assert result.get_cache_usage()["misses"] == 1
+
+
+@pytest.mark.asyncio
+async def test_per_call_tracking_is_context_local(tmp_path, monkeypatch):
+    cache = make_cache(tmp_path)
+    monkeypatch.setattr(dspy, "cache", cache)
+
+    class Read(dspy.Module):
+        async def aforward(self, count):
+            await asyncio.sleep(0)
+            for index in range(count):
+                cache.get({"missing": index})
+            return dspy.Prediction(count=count)
+
+    with dspy.settings.context(track_usage=True):
+        one, two = await asyncio.gather(Read().acall(1), Read().acall(2))
+    assert one.get_cache_usage()["misses"] == 1
+    assert two.get_cache_usage()["misses"] == 2

