+def test_statistics_invalid_key_and_returned_copies(cache):
+    cache.reset_stats()
+    assert cache.get({'unserializable': object()}) is None
+    assert cache.stats() == dict(hits=0, mem_hits=0, disk_hits=0, misses=1)
+    snapshot = cache.stats()
+    snapshot['misses'] = 999
+    assert cache.stats()['misses'] == 1
+    cache.put({'key': 1}, 'retained')
+    cache.reset_stats()
+    assert cache.get({'key': 1}) == 'retained'
+    assert cache.stats() == dict(hits=1, mem_hits=1, disk_hits=0, misses=0)
+
