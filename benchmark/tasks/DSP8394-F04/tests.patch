+def test_statistics_concurrent_counts(cache):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    cache.put({'key': 'hit'}, 'present')
+    cache.reset_stats()
+    barrier = Barrier(4)
+    def worker(index):
+        barrier.wait(timeout=15)
+        for _ in range(10):
+            assert cache.get({'key': 'hit'}) == 'present'
+            assert cache.get({'key': 'missing'}) is None
+    with ThreadPoolExecutor(4) as executor:
+        list(executor.map(worker, range(4)))
+    assert cache.stats() == dict(hits=40, mem_hits=40, disk_hits=0, misses=40)
+
