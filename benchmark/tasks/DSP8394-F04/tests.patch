+@pytest.mark.asyncio
+async def test_prediction_async_overlap_and_exception_restore(cache, monkeypatch):
+    import asyncio
+    import dspy
+    monkeypatch.setattr(dspy, 'cache', cache)
+    entered = asyncio.Event()
+    proceed = asyncio.Event()
+    class Call(dspy.Module):
+        async def aforward(self, number):
+            if number == 1:
+                entered.set()
+                await asyncio.wait_for(proceed.wait(), 15)
+            else:
+                await asyncio.wait_for(entered.wait(), 15)
+                proceed.set()
+            for _ in range(number):
+                cache.get({'key': 'missing'})
+            return dspy.Prediction(number=number)
+    class Broken(dspy.Module):
+        def forward(self):
+            cache.get({'key': 'failed call'})
+            raise RuntimeError('intentional')
+    with dspy.settings.context(track_usage=True):
+        with pytest.raises(RuntimeError):
+            Broken()()
+        one, two = await asyncio.gather(Call().acall(1), Call().acall(2))
+    assert one.get_cache_usage() == dict(hits=0, mem_hits=0, disk_hits=0, misses=1)
+    assert two.get_cache_usage() == dict(hits=0, mem_hits=0, disk_hits=0, misses=2)
