+def test_prediction_nested_tracking_with_existing_lm_tracker(cache, monkeypatch):
+    import dspy
+    from dspy.utils.usage_tracker import track_usage
+    monkeypatch.setattr(dspy, 'cache', cache)
+    class Child(dspy.Module):
+        def forward(self):
+            cache.get({'key': 'child missing'})
+            return dspy.Prediction(answer='child')
+    class Parent(dspy.Module):
+        def forward(self):
+            child = Child()()
+            cache.get({'key': 'parent missing'})
+            return dspy.Prediction(child=child)
+    with dspy.settings.context(track_usage=True):
+        with track_usage():
+            result = Parent()()
+    assert result.get_cache_usage() == dict(hits=0, mem_hits=0, disk_hits=0, misses=2)
+    assert result.child.get_cache_usage() == dict(hits=0, mem_hits=0, disk_hits=0, misses=1)
+    result.get_cache_usage()['misses'] = 999
+    cache.reset_stats()
+    assert result.get_cache_usage()['misses'] == 2
+    with dspy.settings.context(track_usage=False):
+        assert Child()().get_cache_usage() is None
+
