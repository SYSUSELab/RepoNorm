diff --git a/dspy/utils/usage_tracker.py b/dspy/utils/usage_tracker.py
index 5199f3a..0081daa 100644
--- a/dspy/utils/usage_tracker.py
+++ b/dspy/utils/usage_tracker.py
@@ -3,6 +3,7 @@
 from collections import defaultdict
 from contextlib import contextmanager
 from typing import Any
+import threading
 
 from dspy.dsp.utils.settings import settings
 
@@ -60,6 +61,32 @@ class UsageTracker:
         return total_usage_by_lm
 
 
+class CacheUsageTracker:
+    """One call's counter, with inclusive accounting for enclosing calls."""
+
+    def __init__(self):
+        self.cache_usage = dict(hits=0, mem_hits=0, disk_hits=0, misses=0)
+        self.parent = getattr(settings, "cache_usage_tracker", None)
+        self.lock = threading.RLock()
+
+    def add_cache_hit(self, hit_type: str):
+        with self.lock:
+            self.cache_usage["hits"] += 1
+            self.cache_usage["mem_hits" if hit_type == "memory" else "disk_hits"] += 1
+        if self.parent is not None:
+            self.parent.add_cache_hit(hit_type)
+
+    def add_cache_miss(self):
+        with self.lock:
+            self.cache_usage["misses"] += 1
+        if self.parent is not None:
+            self.parent.add_cache_miss()
+
+    def get_cache_usage(self):
+        with self.lock:
+            return dict(self.cache_usage)
+
+
 @contextmanager
 def track_usage():
     """Context manager for tracking LM usage."""
@@ -67,3 +94,12 @@ def track_usage():
 
     with settings.context(usage_tracker=tracker):
         yield tracker
+
+
+@contextmanager
+def track_cache_usage():
+    """Context manager for tracking cache usage."""
+    tracker = CacheUsageTracker()
+
+    with settings.context(cache_usage_tracker=tracker):
+        yield tracker
