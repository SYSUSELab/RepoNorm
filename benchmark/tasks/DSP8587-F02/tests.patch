diff --git a/tests/streaming/test_streaming.py b/tests/streaming/test_streaming.py
index fe67bd6..7bbcb0a 100644
--- a/tests/streaming/test_streaming.py
+++ b/tests/streaming/test_streaming.py
@@ -837,3 +837,62 @@ async def test_stream_listener_returns_correct_chunk_xml_adapter():
     assert all_chunks[1].predict_name == "predict2"
     assert all_chunks[1].signature_field_name == "judgement"
     assert all_chunks[1].chunk == "The answer is humorous."
+
+def _feature2_model_chunk(content):
+    return ModelResponseStream(
+        model="test", choices=[StreamingChoices(delta=Delta(content=content))]
+    )
+
+
+@pytest.mark.parametrize("value", [True, False, 3.0, "10", None])
+def test_end_buffer_size_requires_a_plain_integer(value):
+    with pytest.raises(ValueError, match="^end_buffer_size must be an integer$"):
+        dspy.streaming.StreamListener(
+            signature_field_name="answer", end_buffer_size=value
+        )
+
+
+@pytest.mark.parametrize(
+    "value,message",
+    [
+        (2, "end_buffer_size must be at least 3"),
+        (65, "end_buffer_size must be at most 64"),
+    ],
+)
+def test_end_buffer_size_bounds(value, message):
+    with pytest.raises(ValueError, match=f"^{message}$"):
+        dspy.streaming.StreamListener(
+            signature_field_name="answer", end_buffer_size=value
+        )
+
+
+def test_end_buffer_size_boundaries_and_default():
+    assert dspy.streaming.StreamListener("answer").end_buffer_size == 10
+    assert dspy.streaming.StreamListener("answer", end_buffer_size=3).end_buffer_size == 3
+    assert dspy.streaming.StreamListener("answer", end_buffer_size=64).end_buffer_size == 64
+
+
+def test_receive_reports_queue_depth_before_dequeue_or_final_flush():
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer",
+        predict_name="predict",
+        end_buffer_size=3,
+    )
+    responses = []
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(_feature2_model_chunk("[[ ## answer ## ]]\n"))
+        for token in ("0", "1", "2", "3"):
+            response = listener.receive(_feature2_model_chunk(token))
+            if response is not None:
+                responses.append(response)
+        responses.append(
+            listener.receive(_feature2_model_chunk("[[ ## completed ## ]]"))
+        )
+
+    assert "".join(response.chunk for response in responses) == "0123"
+    assert [response.buffer_watermark for response in responses] == [3, 3]
+
+
+def test_stream_response_exposes_supplied_buffer_watermark():
+    response = dspy.streaming.StreamResponse("predict", "answer", "value", 2)
+    assert response.buffer_watermark == 2
