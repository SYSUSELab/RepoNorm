+def test_builtin_filters_work_in_decorator_and_file_templates(tmp_path):
+    @outlines.prompt(builtin_filters=["string_utils"])
+    def decorated(value):
+        """{{ value | pad_left(3, "0") }}"""
+
+    assert decorated("7") == "007"
+
+    (tmp_path / "included.txt").write_text(
+        "{{ value | subtract(3) }}", encoding="utf-8"
+    )
+    path = tmp_path / "prompt.txt"
+    path.write_text('{% include "included.txt" %}', encoding="utf-8")
+    assert Prompt.from_file(path, builtin_filters=["math_utils"])(value=8) == "5"
