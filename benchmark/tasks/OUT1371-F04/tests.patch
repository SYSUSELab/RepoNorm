+def test_builtin_string_filters():
+    filters = ["string_utils"]
+    assert Prompt.from_str("{{ value | upper }}", filters)(value="hello") == "HELLO"
+    assert Prompt.from_str("{{ value | lower }}", filters)(value="HELLO") == "hello"
+    assert Prompt.from_str("{{ value | title }}", filters)(value="hello world") == "Hello World"
+    assert Prompt.from_str("{{ value | reverse }}", filters)(value="abc") == "cba"
+    assert Prompt.from_str("{{ value | truncate(4) }}", filters)(value="abcdef") == "a..."
+    assert Prompt.from_str("{{ value | truncate(6) }}", filters)(value="abcdef") == "abcdef"
+    assert Prompt.from_str("{{ value | pad_left(3, '_') }}", filters)(value="x") == "__x"
+    assert Prompt.from_str("{{ value | pad_right(3, '_') }}", filters)(value="x") == "x__"
+
+
+def test_builtin_math_filters():
+    prompt = Prompt.from_str(
+        "{{ value | add(2) }} "
+        "{{ value | subtract(2) }} "
+        "{{ value | multiply(2) }} "
+        "{{ value | divide(2) }} "
+        "{{ fraction | round }} "
+        "{{ negative | abs }} "
+        "{{ value | min(2, 8) }} "
+        "{{ value | max(2, 8) }}",
+        builtin_filters=["math_utils"],
+    )
+    assert prompt(value=4, fraction=3.6, negative=-5) == "6 2 8 2.0 4 5 2 8"
+
+
+def test_builtin_format_filters():
+    assert (
+        Prompt.from_str("{{ value | json }}", ["format_utils"])(value={"a": 1})
+        == '{"a": 1}'
+    )
+    assert (
+        Prompt.from_str("{{ value | csv }}", ["format_utils"])(value=["a,b", "c"])
+        == '"a,b",c'
+    )
+    assert (
+        Prompt.from_str("{{ value | indent(2) }}", ["format_utils"])(value="a\nb")
+        == "  a\n  b"
+    )
+    assert (
+        Prompt.from_str("{{ value | wrap(7) }}", ["format_utils"])(
+            value="one two three"
