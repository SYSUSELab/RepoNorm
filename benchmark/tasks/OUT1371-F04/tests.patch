+def test_builtin_filter_category_selection_and_defaults():
+    with pytest.raises(jinja2.TemplateAssertionError, match="No filter named"):
+        Prompt.from_str("{{ value | pad_left(3) }}")
+
+    assert Prompt.from_str("{{ value | upper }}", builtin_filters=None)(
+        value="text"
+    ) == "TEXT"
+    assert Prompt.from_str("{{ value | upper }}", builtin_filters=[])(
+        value="text"
+    ) == "TEXT"
+
+    @outlines.prompt
+    def undecorated(value):
+        """{{ value }}"""
+
+    assert undecorated("text") == "text"
