+def _truncate(value: Any, length: int, end: str = "...") -> str:
+    text = str(value)
+    if length < 0:
+        raise ValueError("truncate length must be non-negative")
+    if len(text) <= length:
+        return text
+    suffix = str(end)[:length]
+    return text[: length - len(suffix)] + suffix
+
+
+def _csv_row(value: Any) -> str:
+    output = io.StringIO(newline="")
+    csv.writer(output, lineterminator="").writerow(value)
+    return output.getvalue()
+
+
+def _round(value: Any, ndigits: Optional[int] = None) -> Any:
+    if ndigits is None:
+        return builtins.round(value)
+    return builtins.round(value, ndigits)
+
+
+def _get_builtin_filters() -> Dict[str, Dict[str, Callable]]:
+    return {
+        "string_utils": {
+            "upper": lambda value: str(value).upper(),
+            "lower": lambda value: str(value).lower(),
+            "title": lambda value: str(value).title(),
+            "reverse": lambda value: str(value)[::-1],
+            "truncate": _truncate,
+            "pad_left": lambda value, width, fill=" ": str(value).rjust(width, fill),
+            "pad_right": lambda value, width, fill=" ": str(value).ljust(width, fill),
+        },
+        "math_utils": {
+            "add": lambda value, other: value + other,
+            "subtract": lambda value, other: value - other,
+            "multiply": lambda value, other: value * other,
+            "divide": lambda value, other: value / other,
+            "round": _round,
+            "abs": builtins.abs,
+            "min": lambda value, *others: builtins.min(value, *others),
+            "max": lambda value, *others: builtins.max(value, *others),
+        },
+        "format_utils": {
+            "json": json.dumps,
+            "csv": _csv_row,
+            "indent": lambda value, width=4: textwrap.indent(
+                str(value), " " * width
+            ),
+            "wrap": lambda value, width=70: textwrap.fill(str(value), width),
+            "escape": lambda value: html.escape(str(value), quote=True),
+            "unescape": lambda value: html.unescape(str(value)),
+        },
+    }
+
+
+def _create_builtin_filter_environment(
+    loader: Optional[jinja2.BaseLoader] = None,
+    builtin_filters: Optional[List[str]] = None,
+) -> jinja2.Environment:
+    env = jinja2.Environment(
+        loader=loader,
+        trim_blocks=True,
+        lstrip_blocks=True,
+        keep_trailing_newline=True,
+        undefined=jinja2.StrictUndefined,
+    )
+    env.filters.update(
+        {
+            "name": get_fn_name,
+            "description": get_fn_description,
+            "source": get_fn_source,
+            "signature": get_fn_signature,
+            "schema": get_schema,
+            "args": get_fn_args,
+        }
+    )
+
+    available = _get_builtin_filters()
+    for category in builtin_filters or []:
+        if category not in available:
+            raise ValueError(f"Unknown builtin filter category: {category}")
+        env.filters.update(available[category])
+    return env
+
