+from pathlib import Path
+
+import jinja2
+import pytest
+
+import outlines
+from outlines.prompts import Prompt
+
+
+def test_builtin_categories_cover_all_prompt_entrypoints(tmp_path: Path):
+    @outlines.prompt(builtin_filters=["string_utils"])
+    def decorated(value="snow"):
+        """{{ value | upper }}"""
+
+    assert decorated() == "SNOW"
+    assert list(decorated.signature.parameters) == ["value"]
+    with pytest.raises(TypeError):
+        decorated(unexpected="x")
+
+    assert (
+        Prompt.from_str("{{ value | reverse }}", ["string_utils"])(value="abc") == "cba"
+    )
+
+    (tmp_path / "part.txt").write_text("{{ value | title }}", encoding="utf-8")
+    root = tmp_path / "root.txt"
+    root.write_text('{% include "part.txt" %}', encoding="utf-8")
+    assert (
+        Prompt.from_file(root, ["string_utils"])(value="winter wind") == "Winter Wind"
+    )
+
+
+def test_string_filters_and_boundary_behavior():
+    prompt = Prompt.from_str(
+        "{{ value | lower }}|{{ value | truncate(5) }}|"
+        "{{ value | pad_left(12, '-') }}|{{ value | pad_right(12, '-') }}",
+        ["string_utils"],
+    )
+    assert prompt(value="SNOWSTORM") == "snowstorm|SN...|---SNOWSTORM|SNOWSTORM---"
+    assert (
+        Prompt.from_str("{{ value | truncate(2) }}", ["string_utils"])(value="abcd")
+        == ".."
+    )
+    with pytest.raises(ValueError):
+        Prompt.from_str("{{ value | truncate(-1) }}", ["string_utils"])(value="abcd")
+    with pytest.raises(TypeError):
+        Prompt.from_str("{{ value | pad_left(5, '--') }}", ["string_utils"])(value="x")
+
+
+def test_math_and_format_filters():
+    math_prompt = Prompt.from_str(
+        "{{ value | add(2) }}|{{ value | subtract(2) }}|{{ value | multiply(2) }}|"
+        "{{ value | divide(2) }}|{{ value | round }}|{{ value | abs }}|"
+        "{{ value | min(1, 9) }}|{{ value | max(1, 9) }}",
+        ["math_utils"],
+    )
+    assert math_prompt(value=-3.5) == "-1.5|-5.5|-7.0|-1.75|-4|3.5|-3.5|9"
+
+    format_prompt = Prompt.from_str(
+        "{{ data | json }}|{{ row | csv }}|{{ text | escape }}|{{ escaped | unescape }}",
+        ["format_utils"],
+    )
+    assert (
+        format_prompt(data={"a": 1}, row=["a,b", "c"], text='"<&', escaped="&lt;b&gt;")
+        == '{"a": 1}|"a,b",c|&quot;&lt;&amp;|<b>'
+    )
+
+
+def test_selection_defaults_duplicates_errors_and_existing_filters():
+    assert (
+        Prompt.from_str("{{ fn | name }}")(
+            fn=test_selection_defaults_duplicates_errors_and_existing_filters
+        )
+        == "test_selection_defaults_duplicates_errors_and_existing_filters"
+    )
+    assert Prompt.from_str("plain", [])() == "plain"
+    assert (
+        Prompt.from_str("{{ value | upper }}", ["string_utils", "string_utils"])(
+            value="x"
+        )
+        == "X"
+    )
+    with pytest.raises(ValueError, match="Unknown builtin filter category: unknown"):
+        Prompt.from_str("plain", ["unknown"])
+    with pytest.raises(ValueError, match="Unknown builtin filter category: $"):
+        Prompt.from_str("plain", [""])
+    with pytest.raises(jinja2.UndefinedError):
+        Prompt.from_str("{{ missing }}", ["math_utils"])()
+
+
+def test_prompt_formatting_is_unchanged_with_categories():
+    prompt = Prompt.from_str(
+        """
+        Heading
+            {{ value | upper }}
+
+        """,
+        ["string_utils"],
+    )
+    assert prompt(value="snow") == "Heading\n    SNOW\n"
