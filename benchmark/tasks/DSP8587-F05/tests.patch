diff --git a/tests/streaming/test_streaming.py b/tests/streaming/test_streaming.py
index fe67bd6..4c0496e 100644
--- a/tests/streaming/test_streaming.py
+++ b/tests/streaming/test_streaming.py
@@ -837,3 +837,89 @@ async def test_stream_listener_returns_correct_chunk_xml_adapter():
     assert all_chunks[1].predict_name == "predict2"
     assert all_chunks[1].signature_field_name == "judgement"
     assert all_chunks[1].chunk == "The answer is humorous."
+
+def _feature5_model_chunk(content):
+    return ModelResponseStream(
+        model="test", choices=[StreamingChoices(delta=Delta(content=content))]
+    )
+
+
+@pytest.mark.parametrize(
+    ("debug", "logger_enabled"),
+    [(False, True), (True, False)],
+)
+def test_disabled_debug_condition_does_not_call_the_logger(debug, logger_enabled):
+    logger = mock.Mock()
+    logger.isEnabledFor.return_value = logger_enabled
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer",
+        debug=debug,
+        debug_logger=logger,
+    )
+    chunk = _feature5_model_chunk(
+        "[[ ## answer ## ]]cached[[ ## completed ## ]]"
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        assert listener.receive(chunk) is None
+    logger.debug.assert_not_called()
+
+
+def test_debug_logs_public_stream_events_with_exact_format(caplog):
+    import logging
+
+    logger = logging.getLogger("test.dspy.streaming.feature5")
+    caplog.set_level(logging.DEBUG, logger=logger.name)
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer",
+        predict_name="predict",
+        allow_reuse=True,
+        debug=True,
+        debug_logger=logger,
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(_feature5_model_chunk("[[ ## answer ## ]]\n"))
+        for _ in range(11):
+            listener.receive(_feature5_model_chunk("x"))
+        listener.receive(_feature5_model_chunk("[[ ## completed ## ]]"))
+        listener.receive(_feature5_model_chunk("ignored"))
+
+    messages = [record.getMessage() for record in caplog.records]
+    assert "Start detection: adapter=ChatAdapter, field='answer', stream_start=True, buffer_preview='x'" in messages
+    assert "Emit chunk: len(token)=1, queue_size=10, is_last_chunk=False" in messages
+    assert any(
+        message.startswith(
+            "Rolling end check: adapter=ChatAdapter, field='answer', reason='regex_match', buffered_size="
+        )
+        for message in messages
+    )
+    assert any(
+        message.startswith(
+            "Flush: adapter=ChatAdapter, field='answer', truncated_buffer_length="
+        )
+        for message in messages
+    )
+    assert "State reset for field 'answer' (allow_reuse=True)" in messages
+
+
+def test_debug_preview_has_a_strict_eighty_character_limit(caplog):
+    import logging
+
+    logger = logging.getLogger("test.dspy.streaming.feature5.preview")
+    caplog.set_level(logging.DEBUG, logger=logger.name)
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer", debug=True, debug_logger=logger
+    )
+    chunk = _feature5_model_chunk(
+        "[[ ## answer ## ]]" + "x" * 200 + "[[ ## completed ## ]]"
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(chunk)
+
+    start_message = next(
+        record.getMessage()
+        for record in caplog.records
+        if record.getMessage().startswith("Start detection:")
+    )
+    preview = start_message.split("buffer_preview='", 1)[1][:-1]
+    assert len(preview) == 80
+    assert preview.endswith("...")
