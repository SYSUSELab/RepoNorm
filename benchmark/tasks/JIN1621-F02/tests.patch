+
+
+class TestTemplatePathNormalization:
+    @pytest.mark.parametrize(
+        "name",
+        [
+            "nested//page.html",
+            "./nested/page.html",
+            "nested/./page.html",
+            "nested/child/../page.html",
+            "nested\\child\\..\\page.html",
+        ],
+    )
+    def test_filesystem_normalizes_equivalent_names(self, tmp_path, name):
+        nested = tmp_path / "nested"
+        nested.mkdir()
+        (nested / "page.html").write_text("normalized")
+        env = Environment(loader=loaders.FileSystemLoader(tmp_path))
+        assert env.get_template(name).render() == "normalized"
+
+    def test_internal_parent_can_reach_search_root(self, tmp_path):
+        (tmp_path / "page.html").write_text("root")
+        env = Environment(loader=loaders.FileSystemLoader(tmp_path))
+        assert env.get_template("nested/../page.html").render() == "root"
+
+    @pytest.mark.parametrize(
+        "name",
+        [
+            "../outside.html",
+            "nested/../../outside.html",
+            "/absolute.html",
+            "\\absolute.html",
+            "C:drive.html",
+            "d:/drive.html",
+            "//server/share.html",
+            "\\\\server\\share.html",
+        ],
+    )
+    def test_root_escape_and_absolute_forms_are_rejected(self, tmp_path, name):
+        loader = loaders.FileSystemLoader(tmp_path)
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loader.get_source(Environment(), name)
+        assert exc_info.value.name == name
+
+    @pytest.mark.parametrize(
+        "name", ["foo//test.html", "./foo/test.html", "foo/bar/../test.html"]
+    )
+    def test_package_directory_normalizes_names(
+        self, package_dir_loader, name
+    ):
+        source, _, _ = package_dir_loader.get_source(None, name)
+        assert source.rstrip() == "FOO"
+
+    def test_package_archive_normalizes_names(self, package_zip_loader):
+        source, _, _ = package_zip_loader.get_source(
+            None, "foo\\child\\..\\test.html"
+        )
+        assert source.rstrip() == "FOO"
+
+    def test_missing_reports_original_request(self, tmp_path):
+        name = "nested/../missing.html"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loaders.FileSystemLoader(tmp_path).get_source(Environment(), name)
+        assert exc_info.value.name == name
