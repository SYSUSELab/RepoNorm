+# XGrammarLogitsProcessor API Tests
+def test_v5_low_level_independent_rows_and_reset(monkeypatch):
+    import xgrammar as xgr
+
+    compiler = xgr.GrammarCompiler(
+        xgr.TokenizerInfo(["a", "b", "c", "d", "<eos>"], stop_token_ids=[4])
+    )
+    grammar = compiler.compile_regex("ab|cd")
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("HF wrapper must not implement the low-level feature")
+
+    monkeypatch.setattr(xgr.contrib.hf, "LogitsProcessor", forbidden)
+    processor = XGrammarLogitsProcessor(grammar, "torch")
+    scores = processor(torch.tensor([[4], [4]]), torch.zeros(2, 5))
+    assert torch.isfinite(scores).tolist() == [[True, False, True, False, False]] * 2
+    scores = processor(torch.tensor([[4, 0], [4, 2]]), torch.zeros(2, 5))
+    assert torch.isfinite(scores).tolist() == [[False, True, False, False, False], [False, False, False, True, False]]
+    scores = processor(torch.tensor([[4, 0, 1], [4, 2, 3]]), torch.zeros(2, 5))
+    assert torch.isfinite(scores).tolist() == [[False, False, False, False, True]] * 2
+    processor.reset()
+    scores = processor(torch.tensor([4]), torch.zeros(5))
+    assert scores.shape == (5,)
+    assert torch.isfinite(scores).tolist() == [True, False, True, False, False]
+
