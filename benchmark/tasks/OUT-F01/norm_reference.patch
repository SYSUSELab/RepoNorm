diff --git a/tests/backends/test_xgrammar_contribution.py b/tests/backends/test_xgrammar_contribution.py
new file mode 100644
index 00000000..aa1db196
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,39 @@
+import torch
+import xgrammar as xgr
+
+from outlines.backends.xgrammar import XGrammarLogitsProcessor
+
+
+def test_low_level_processor_tracks_rows_and_resets(monkeypatch):
+    compiler = xgr.GrammarCompiler(
+        xgr.TokenizerInfo(["a", "b", "c", "d", "<eos>"], stop_token_ids=[4])
+    )
+    grammar = compiler.compile_regex("ab|cd")
+
+    def reject_wrapper(*args, **kwargs):
+        raise AssertionError("the high-level HF wrapper was used")
+
+    monkeypatch.setattr(xgr.contrib.hf, "LogitsProcessor", reject_wrapper)
+    processor = XGrammarLogitsProcessor(grammar, "torch")
+
+    first = processor(torch.tensor([[4], [4]]), torch.zeros(2, 5))
+    assert torch.isfinite(first).tolist() == [
+        [True, False, True, False, False],
+        [True, False, True, False, False],
+    ]
+    second = processor(torch.tensor([[4, 0], [4, 2]]), torch.zeros(2, 5))
+    assert torch.isfinite(second).tolist() == [
+        [False, True, False, False, False],
+        [False, False, False, True, False],
+    ]
+
+    processor.reset()
+    restarted = processor(torch.tensor([4]), torch.zeros(5))
+    assert restarted.shape == (5,)
+    assert torch.isfinite(restarted).tolist() == [
+        True,
+        False,
+        True,
+        False,
+        False,
+    ]
