+    def add_alias(self, alias: str, target: str) -> None:
+        """Add or overwrite a loader-owned, one-step template alias.
+
+        Both arguments must be strings. Invalidate this alias in every
+        Environment that has loaded it; leave other entries untouched.
+        Aliases do not chain within one loader.
