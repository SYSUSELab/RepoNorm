+        .. versionadded:: 3.1.0
+        """
+        self._ensure_alias_state()
+        return self.aliases.get(template, template)
+
+    def _listed_with_aliases(self, names: t.Iterable[str]) -> t.List[str]:
+        ordinary = set(names)
+        self._ensure_alias_state()
+        included = {
+            alias for alias, target in self.aliases.items() if target in ordinary
+        }
+        return sorted(ordinary | included)
