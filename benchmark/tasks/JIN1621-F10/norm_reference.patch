+    def _invalidate_alias(self, alias: str) -> None:
+        for environment in list(self._alias_environments):
+            cache = environment.cache
+            if cache is None:
+                continue
+            for key in list(cache):
+                loader_ref, name = key
+                if loader_ref() is self and name == alias:
+                    del cache[key]
