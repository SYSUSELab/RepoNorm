+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias and invalidate its cached requests.
+
+        Removing an unknown alias is harmless.
+
+        .. versionadded:: 3.1.0
+        """
+        self._ensure_alias_state()
+        if not isinstance(alias, str):
+            raise TypeError("alias must be a string")
+        self.aliases.pop(alias, None)
+        self._invalidate_alias(alias)
