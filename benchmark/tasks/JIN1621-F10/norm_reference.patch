diff --git a/tests/test_n4c_author_aliases.py b/tests/test_n4c_author_aliases.py
new file mode 100644
index 00000000..ee3ed744
--- /dev/null
+++ b/tests/test_n4c_author_aliases.py
@@ -0,0 +1,109 @@
+import pytest
+
+from jinja2 import BaseLoader
+from jinja2 import ChoiceLoader
+from jinja2 import DictLoader
+from jinja2 import Environment
+from jinja2 import PackageLoader
+from jinja2 import PrefixLoader
+from jinja2 import TemplateNotFound
+
+
+def test_alias_mutation_rejects_non_string_names():
+    loader = DictLoader({"real": "R"})
+    with pytest.raises(TypeError):
+        loader.add_alias(1, "real")
+    with pytest.raises(TypeError):
+        loader.add_alias("public", 1)
+    with pytest.raises(TypeError):
+        loader.remove_alias(1)
+
+
+def test_listing_does_not_accidentally_chain_aliases():
+    loader = DictLoader({"real": "R"})
+    loader.add_alias("public", "real")
+    loader.add_alias("chain", "public")
+    loader.add_alias("broken", "absent")
+    assert loader.list_templates() == ["public", "real"]
+    assert Environment(loader=loader).get_template("public").render() == "R"
+    with pytest.raises(TemplateNotFound) as caught:
+        Environment(loader=loader).get_template("chain")
+    assert caught.value.name == "public"
+
+
+def test_custom_subclass_without_base_initialization():
+    class Source(BaseLoader):
+        def __init__(self):
+            self.source = "{{ who }}"
+
+        def get_source(self, environment, name):
+            if name != "page":
+                raise TemplateNotFound(name)
+            return self.source, None, None
+
+    source = Source()
+    assert (
+        Environment(loader=source).get_template("page", globals={"who": "one"}).render()
+        == "one"
+    )
+    source.add_alias("public", "page")
+    assert (
+        Environment(loader=source)
+        .get_template("public", globals={"who": "two"})
+        .render()
+        == "two"
+    )
+
+
+def test_alias_cache_updates_multiple_environments_without_collateral():
+    loader = DictLoader({"one": "ONE", "two": "TWO", "stable": "STABLE"})
+    loader.add_alias("current", "one")
+    environments = [Environment(loader=loader, auto_reload=False) for _ in range(2)]
+    originals = [env.get_template("current") for env in environments]
+    unchanged = [env.get_template("stable") for env in environments]
+    loader.add_alias("current", "two")
+    for env, old, stable in zip(environments, originals, unchanged):
+        assert env.get_template("current") is not old
+        assert env.get_template("current").render() == "TWO"
+        assert env.get_template("stable") is stable
+    loader.remove_alias("not-present")
+
+
+@pytest.mark.parametrize("kind", ["prefix", "choice"])
+def test_composite_owns_one_step_aliases_and_preserves_globals(kind):
+    child = DictLoader({"real": "{{ who }}"})
+    child.add_alias("local", "real")
+    loader, target = ChoiceLoader([child]), "local"
+    if kind == "prefix":
+        loader, target = PrefixLoader({"pkg": child}, delimiter=":"), "pkg:local"
+    loader.add_alias("public", target)
+    loader.add_alias("chain", "public")
+    assert (
+        Environment(loader=loader)
+        .get_template("public", globals={"who": "ok"})
+        .render()
+        == "ok"
+    )
+    assert "public" in loader.list_templates()
+    assert "chain" not in loader.list_templates()
+
+
+def test_prefix_missing_target_reports_target_name():
+    loader = PrefixLoader({"pkg": DictLoader({})})
+    loader.add_alias("public", "pkg/missing")
+    with pytest.raises(TemplateNotFound) as caught:
+        Environment(loader=loader).get_template("public")
+    assert caught.value.name == "pkg/missing"
+
+
+def test_package_listing_exposes_resolvable_alias(tmp_path, monkeypatch):
+    package = tmp_path / "n4c_author_alias_package"
+    (package / "templates").mkdir(parents=True)
+    (package / "__init__.py").write_text("")
+    (package / "templates/page").write_text("page")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    loader = PackageLoader(package.name)
+    loader.add_alias("public", "page")
+    loader.add_alias("chain", "public")
+    assert loader.list_templates() == ["page", "public"]
+    assert Environment(loader=loader).get_template("public").render() == "page"
