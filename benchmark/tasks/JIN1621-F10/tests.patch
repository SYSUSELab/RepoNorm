         sys.meta_path[:] = before
+
+
+def test_alias_mutation_invalidates_environment_cache():
+    loader = loaders.DictLoader({"a": "A", "b": "B"})
+    loader.add_alias("current", "a")
+    env = Environment(loader=loader)
+    assert env.get_template("current").render() == "A"
+    loader.add_alias("current", "b")
+    assert env.get_template("current").render() == "B"
+    loader.remove_alias("current")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("current")
+    assert exc_info.value.name == "current"
+
+
+def test_alias_is_one_step_and_composite_owned():
+    loader = loaders.PrefixLoader({"pkg": loaders.DictLoader({"real": "R"})})
+    loader.add_alias("public", "pkg/real")
+    loader.add_alias("other", "public")
+    env = Environment(loader=loader)
+    assert env.get_template("public").render() == "R"
+    with pytest.raises(TemplateNotFound):
+        env.get_template("other")
+    assert "public" in loader.list_templates()
+
+
+def test_choice_top_level_alias():
+    loader = loaders.ChoiceLoader([loaders.DictLoader({"real": "R"})])
+    loader.add_alias("public", "real")
+    assert Environment(loader=loader).get_template("public").render() == "R"
