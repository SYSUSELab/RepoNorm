     #: .. versionadded:: 2.4
     has_source_access = True
 
+    def __init__(self, aliases: t.Optional[t.Mapping[str, str]] = None) -> None:
+        self.aliases: t.Dict[str, str] = dict(aliases or ())
+        self._alias_environments: weakref.WeakSet[Environment] = weakref.WeakSet()
+
+    def _invalidate_alias(self, alias: str) -> None:
+        for environment in list(self._alias_environments):
+            cache = environment.cache
+            if cache is None:
+                continue
+            for key in list(cache):
+                loader_ref, name = key
+                if loader_ref() is self and name == alias:
+                    del cache[key]
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Add a template path alias.
+ 
+        :param alias: The alias name for the template
+        :param target: The actual template path
+        """
+        if not isinstance(alias, str) or not isinstance(target, str):
+            raise TypeError("alias and target must be strings")
+        self.aliases[alias] = target
+        self._invalidate_alias(alias)
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove a template path alias.
+ 
+        :param alias: The alias name to remove
+        """
+        self.aliases.pop(alias, None)
+        self._invalidate_alias(alias)
+
+    def resolve_template_name(self, template: str) -> str:
+        """Resolve template name through aliases.
+ 
+        :param template: The template name (possibly an alias)
+        :return: The actual template path
+        """
+        return self.aliases.get(template, template)
+
+    def _listed_with_aliases(self, names: t.Iterable[str]) -> t.List[str]:
+        result = set(names)
+        result.update(alias for alias, target in self.aliases.items() if target in result)
+        return sorted(result)
+
