+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize(
+    'value, format',
+    [
+        (' #aBc ', None),
+        ('RGB(000%, 034%, 20)', 'rgb'),
+        ('hSl(360DeG, 100%, 0%)', 'hsl'),
+        ('ffffff', 'hex'),
+    ],
+)
+def test_color_matches(value, format):
+    assert value == de.IsColor(format)
+
+
+@pytest.mark.parametrize(
+    'value',
+    ['RGB(256,0,0)', 'HSL(0,101%,0%)', 'RGB(١,0,0)', 'rgb(1,2,3)junk'],
+)
+def test_color_rejections(value):
+    assert value != de.IsColor()
+
+
+def test_color_composition_and_value():
+    validator = de.IsColor('rgb')
+    value = 'RGB(0,0,0)'
+    assert value == (validator & de.IsStr())
+    assert '#abc' == (validator | de.IsColor('hex'))
+    assert 'not-a-color' == ~de.IsColor()
+    assert value == validator
+    assert validator.value is value
+
+
+def test_color_repr():
+    assert repr(de.IsColor()) == 'IsColor(*)'
+    assert repr(de.IsColor('hex')) == "IsColor('hex')"
