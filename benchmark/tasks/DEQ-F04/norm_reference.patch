@@ -0,0 +1,32 @@
+import pytest
+
+import dirty_equals as de
+
+
+def test_url_filters_and_value():
+    value = 'https://example.com:8443/path'
+    validator = de.IsURL(protocol={'http', 'https'}, domain='example.com:8443')
+    assert value == validator
+    assert validator.value == value
+    assert repr(validator) == repr(value)
+    assert value != de.IsURL(protocol='http')
+    assert value != de.IsURL(domain='example.com')
+
+
+def test_url_protocol_collections_and_empty_filter():
+    value = 'https://example.com'
+    for protocols in (['https'], ('https',), {'https'}, frozenset({'https'})):
+        assert value == de.IsURL(protocols)
+    assert value != de.IsURL([])
+
+
+@pytest.mark.parametrize('value', ['example.com', 'https:///path', 'not a url', None])
+def test_url_rejects_incomplete_values(value):
+    assert value != de.IsURL()
+
+
+def test_url_public_composition_and_repr():
+    value = 'https://example.com'
+    assert value == (de.IsURL('https') & de.IsStr())
+    assert value == ~de.IsURL('ftp')
+    assert repr(de.IsURL()) == 'IsURL(*)'
