+@pytest.mark.parametrize('text,expected', [
+    ('9007199254740993', 9007199254740993), (' -42 ', -42), ('42.0', 42),
+    ('1e3', 1000), ('2m', 120), ('1500ms', None), ('1.25 KB', 1250),
+])
+def test_tool_integer_coercion_preserves_exact_values(text, expected):
+    from dspy import Tool
+    tool = Tool(lambda value: value, args={'value': {'type': 'integer'}})
+    if expected is None:
+        with pytest.raises(ValueError):
+            tool(value=text)
+    else:
+        actual = tool(value=text)
+        assert actual == expected
+        assert type(actual) is int
+
+
+@pytest.mark.parametrize('text,expected', [('750ms', .75), ('2h', 7200),
+    ('3 MB', 3000000), ('3.25', 3.25), (' false ', False), ('TrUe', True)])
+def test_tool_scalar_and_units(text, expected):
+    from dspy import Tool
+    kind = 'boolean' if type(expected) is bool else 'number'
+    tool = Tool(lambda value: value, args={'value': {'type': kind}})
+    assert tool(value=text) == expected
+
+
+@pytest.mark.parametrize('invalid', ['NaN', 'Inf', '-Infinity', '2days',
+    '1+2', '2mb', '7x', '-2m'])
+def test_tool_invalid_numeric_strings_still_fail_schema(invalid):
+    from dspy import Tool
+    tool = Tool(lambda value: value, args={'value': {'type': 'number'}})
+    with pytest.raises(ValueError):
+        tool(value=invalid)
+
+
+def test_coercion_keeps_strings_unknown_kwargs_and_schema_bounds():
+    from dspy import Tool
+    def accept(text: str, amount: int = 7, **kwargs):
+        return text, amount, kwargs
+    tool = Tool(accept, args={'text': {'type': 'string'}, 'amount': {'type': 'integer', 'minimum': 1}})
+    supplied = {'text': ' 42 ', 'amount': '2m', 'extra': 'true'}
+    assert tool(**supplied) == (' 42 ', 120, {'extra': 'true'})
+    assert supplied == {'text': ' 42 ', 'amount': '2m', 'extra': 'true'}
+    assert tool(text='hello') == ('hello', 7, {})
+    with pytest.raises(ValueError):
+        tool(text='hello', amount='-1')
+
+
+@pytest.mark.asyncio
+async def test_coercion_through_async_tool_call():
+    from dspy import Tool
+    async def wait(seconds: float):
+        return seconds
+    assert await Tool(wait).acall(seconds='250ms') == .25
