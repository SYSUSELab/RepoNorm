+def _coerce_args(kwargs: dict[str, Any], schema: dict[str, Any]) -> dict[str, Any]:
+    result = kwargs.copy()
+    for key, original in kwargs.items():
+        if key not in schema or not isinstance(original, str):
+            continue
+        field = schema[key]
+        kind = field.get("type")
+        value = original.strip()
+        if kind == "boolean":
+            if value.lower() in ("true", "false"):
+                result[key] = value.lower() == "true"
+            continue
+        if kind == "string" or not (kind in ("integer", "number") or field.get("format") in ("duration", "bytes")):
+            continue
+        match = re.fullmatch(r"([+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?:\s*(ms|s|m|h|KB|MB|GB))?", value)
+        if not match:
+            continue
+        number, unit = match.groups()
+        if unit and (number.startswith('-') or 'e' in number.lower()):
+            continue
+        try:
+            with localcontext() as context:
+                context.prec = max(28, len(number) + 20)
+                parsed = Decimal(number)
+                factors = {None: '1', 'ms': '0.001', 's': '1', 'm': '60', 'h': '3600',
+                           'KB': '1000', 'MB': '1000000', 'GB': '1000000000'}
+                parsed *= Decimal(factors[unit])
+                if unit in ('KB', 'MB', 'GB') or parsed == parsed.to_integral_value():
+                    result[key] = int(parsed)
+                else:
+                    converted = float(parsed)
+                    if math.isfinite(converted):
+                        result[key] = converted
+        except (InvalidOperation, ValueError, OverflowError):
+            continue
+    return result
