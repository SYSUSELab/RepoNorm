--- /dev/null
+++ b/tests/test_validators_contribution.py
@@ -0,0 +1,69 @@
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+def test_each_validator_gets_an_independent_copy(encoding) -> None:
+    expected = encoding.encode("hello hello")
+    seen = []
+
+    def mutate(tokens):
+        tokens.clear()
+
+    def observe(tokens):
+        seen.append(tokens)
+        return True
+
+    assert encoding.encode("hello hello", validators=(mutate, observe)) == expected
+    assert seen == [expected]
+
+
+def test_false_rejects_but_none_and_true_accept(encoding) -> None:
+    expected = encoding.encode("hello")
+    assert encoding.encode("hello", validators=[lambda tokens: None]) == expected
+    assert encoding.encode("hello", validators=[lambda tokens: True]) == expected
+    with pytest.raises(ValueError, match="index 0"):
+        encoding.encode("hello", validators=[lambda tokens: False])
+
+
+def test_failure_short_circuits_and_preserves_exception_identity(encoding) -> None:
+    called = []
+    error = RuntimeError("original")
+
+    def fail(tokens):
+        raise error
+
+    def later(tokens):
+        called.append(tokens)
+
+    with pytest.raises(RuntimeError) as info:
+        encoding.encode("hello", validators=[fail, later])
+    assert info.value is error
+    assert called == []
+
+
+def test_special_policy_and_surrogate_recovery_precede_validation(encoding) -> None:
+    special = "<|endoftext|>"
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode(special, validators=[lambda tokens: True])
+    text = "before \ud800 after"
+    assert encoding.encode(text, validators=[lambda tokens: True]) == encoding.encode(text)
+
+
+def test_batch_validates_each_document_and_preserves_order(encoding) -> None:
+    texts = ["b", "", "a", "b"]
+    expected = [encoding.encode(text) for text in texts]
+    seen = []
+
+    def observe(tokens):
+        seen.append(tokens)
+        return True
+
+    assert encoding.encode_batch(texts, validators=[observe], num_threads=1) == expected
+    assert seen == expected
+    assert encoding.encode_batch([], validators=[lambda tokens: False]) == []
