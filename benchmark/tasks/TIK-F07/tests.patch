+import pytest
+import tiktoken
+
+
+def test_validator_copies_batch_and_none():
+    enc=tiktoken.get_encoding('cl100k_base')
+    texts=['hello','', '你😀', '<|endoftext|>']
+    expected=[enc.encode(s,allowed_special='all') for s in texts]
+    seen=[]
+    def mutate(tokens):
+        tokens.clear()
+    def observe(tokens):
+        seen.append(list(tokens))
+        return True
+    result=enc.encode_batch(texts,allowed_special='all',validators=[mutate,observe],num_threads=1)
+    assert result==expected and seen==expected
+    assert enc.encode('hello',validators=[mutate])==expected[0]
+    assert enc.encode_batch([],validators=[lambda t:False])==[]
+
+
+def test_validator_failure_short_circuit_and_identity():
+    enc=tiktoken.get_encoding('cl100k_base')
+    calls=[]
+    def later(tokens):calls.append(tokens)
+    error=RuntimeError('original')
+    def fail(tokens):raise error
+    for method,arg in [(enc.encode,'hello'),(enc.encode_batch,['hello'])]:
+        with pytest.raises(ValueError):method(arg,validators=[lambda t:False,later])
+        assert calls==[]
+        with pytest.raises(RuntimeError) as info:method(arg,validators=[fail,later])
+        assert info.value is error and calls==[]
+    with pytest.raises(ValueError):
+        enc.encode_batch(['hello',''],validators=[lambda t:bool(t)])
