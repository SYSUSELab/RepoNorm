diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..d5a2180 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,66 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _EditorArgsProcess:
+    pid = 1005
+    def __init__(self, code=0): self.code = code
+    def wait(self): return self.code
+
+
+def _editor_args_argv(command):
+    import shlex
+    return shlex.split(command) if isinstance(command, str) else list(command)
+
+
+def test_edit_editor_args_preserve_existing_editor_command(monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kw: calls.append((command, kw)) or _EditorArgsProcess())
+    values = ["--flag", "", "two words", 'a"b', "semi;colon", "$(marker)", "line\nbreak"]
+
+    click.edit(filename="file name.txt", editor="editor --wait", editor_args=values)
+
+    assert _editor_args_argv(calls[0][0]) == ["editor", "--wait", *values, "file name.txt"]
+
+
+def test_edit_editor_args_apply_to_temporary_text(monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kw: calls.append((command, kw)) or _EditorArgsProcess())
+
+    result = click.edit("text", editor="editor -f", editor_args=["--mode", "plain"], require_save=False)
+
+    argv = _editor_args_argv(calls[0][0])
+    assert argv[:4] == ["editor", "-f", "--mode", "plain"]
+    assert result == "text\n"
+
+
+def test_edit_editor_args_none_and_empty_preserve_command(monkeypatch):
+    commands = []
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kw: commands.append(command) or _EditorArgsProcess())
+    click.edit(filename="file.txt", editor="editor --wait", editor_args=None)
+    click.edit(filename="file.txt", editor="editor --wait", editor_args=[])
+    assert [_editor_args_argv(command) for command in commands] == [["editor", "--wait", "file.txt"]] * 2
+
+
+def test_edit_editor_args_generator_consumed_once(monkeypatch):
+    count = 0
+    def args():
+        nonlocal count
+        count += 1
+        yield "--one"
+        yield "two words"
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _EditorArgsProcess())
+    click.edit(filename="file.txt", editor="editor", editor_args=args())
+    assert count == 1
+
+
+def test_edit_editor_args_reject_non_string_before_launch(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: pytest.fail("must not launch"))
+    with pytest.raises(TypeError, match="only strings"):
+        click.edit(filename="file.txt", editor="editor", editor_args=["ok", 1])
+
+
+def test_edit_editor_args_nonzero_keeps_failure(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _EditorArgsProcess(2))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="file.txt", editor="editor", editor_args=["--wait"])
