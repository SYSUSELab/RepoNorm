+
+class _WorkingDirProcess:
+    pid = 1003
+
+    def wait(self):
+        return 0
+
+
+def test_edit_working_dir_accepts_pathlike_and_relative_filename(tmp_path, monkeypatch):
+    seen = {}
+
+    def popen(command, **kwargs):
+        seen.update(command=command, kwargs=kwargs)
+        return _WorkingDirProcess()
+
+    monkeypatch.setattr("subprocess.Popen", popen)
+    click.edit(filename="note.txt", editor="editor", working_dir=tmp_path)
+
+    assert seen["command"].endswith(' "note.txt"')
+    assert os.fspath(seen["kwargs"]["cwd"]) == os.fspath(tmp_path)
+
+
+def test_edit_working_dir_default_is_none(tmp_path, monkeypatch):
+    seen = {}
+
+    def popen(command, **kwargs):
+        seen.update(kwargs)
+        return _WorkingDirProcess()
+
+    monkeypatch.setattr("subprocess.Popen", popen)
+    click.edit(filename=str(tmp_path / "note.txt"), editor="editor")
+    assert seen["cwd"] is None
+
+
+def test_edit_working_dir_combines_with_custom_env(tmp_path, monkeypatch):
+    seen = {}
+
+    def popen(command, **kwargs):
+        seen.update(kwargs)
+        return _WorkingDirProcess()
+
+    monkeypatch.setattr("subprocess.Popen", popen)
+    click.edit(filename="note.txt", editor="editor", working_dir=tmp_path, env={"CLICK_TEST": "yes"})
+
+    assert os.fspath(seen["cwd"]) == os.fspath(tmp_path)
+    assert seen["env"]["CLICK_TEST"] == "yes"
+
+
+def test_edit_working_dir_process_creation_error_is_chained(tmp_path, monkeypatch):
+    missing = tmp_path / "missing"
+
+    def popen(*args, **kwargs):
+        raise FileNotFoundError(os.fspath(kwargs["cwd"]))
+
+    monkeypatch.setattr("subprocess.Popen", popen)
+    with pytest.raises(click.ClickException, match="Editing failed") as exc_info:
+        click.edit(filename="note.txt", editor="editor", working_dir=missing)
+
+    assert isinstance(exc_info.value.__cause__, FileNotFoundError)
+
+
+def test_edit_working_dir_text_uses_absolute_temporary_file(tmp_path, monkeypatch):
+    commands = []
+
+    def popen(command, **kwargs):
+        commands.append((command, kwargs))
+        return _WorkingDirProcess()
+
+    monkeypatch.setattr("subprocess.Popen", popen)
+    click.edit("text", editor="editor", working_dir=tmp_path, require_save=False)
+
+    command, kwargs = commands[0]
+    filename = command.rsplit(' "', 1)[1][:-1]
+    assert os.path.isabs(filename)
+    assert os.fspath(kwargs["cwd"]) == os.fspath(tmp_path)
