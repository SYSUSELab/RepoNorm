@@ -0,0 +1,68 @@
+import tiktoken
+
+class CountingBPE:
+    def __init__(self, wrapped):
+        self.wrapped = wrapped
+        self.calls = 0
+
+    def encode(self, *args, **kwargs):
+        self.calls += 1
+        return self.wrapped.encode(*args, **kwargs)
+
+    def __getattr__(self, name):
+        return getattr(self.wrapped, name)
+
+
+def counting_encoding():
+    enc = tiktoken.Encoding('fresh-byte-cache', pat_str=r'[\s\S]',
+        mergeable_ranks={bytes([i]):i for i in range(256)},
+        special_tokens={'<|endoftext|>':256})
+    enc._core_bpe = CountingBPE(enc._core_bpe)
+    return enc
+
+
+def test_cache_is_opt_in_and_hits_without_timing_assumptions():
+    enc = counting_encoding()
+
+    assert enc.encode("repeated", use_cache=False) == enc.encode("repeated", use_cache=False)
+    assert enc._core_bpe.calls == 2
+
+    first = enc.encode("cached", use_cache=True)
+    second = enc.encode("cached", use_cache=True)
+    assert first == second
+    assert enc._core_bpe.calls == 3
+
+
+def test_cached_results_cannot_be_mutated_by_the_caller():
+    enc = counting_encoding()
+    expected = enc.encode("immutable cache entry", use_cache=True)
+    expected.append(-1)
+
+    assert -1 not in enc.encode("immutable cache entry", use_cache=True)
+    assert enc._core_bpe.calls == 1
+
+
+def test_cache_key_includes_special_token_policy():
+    enc = counting_encoding()
+    text = "<|endoftext|>"
+
+    natural = enc.encode(text, disallowed_special=(), use_cache=True)
+    special = enc.encode(text, allowed_special="all", use_cache=True)
+    assert natural != special
+    assert enc._core_bpe.calls == 2
+    assert enc.encode(text, disallowed_special=(), use_cache=True) == natural
+    assert enc._core_bpe.calls == 2
+
+
+def test_cache_is_bounded_and_evicts_least_recently_used_entry():
+    enc = counting_encoding()
+    for index in range(128):
+        enc.encode(f"entry-{index}", use_cache=True)
+
+    enc.encode("entry-0", use_cache=True)
+    enc.encode("entry-128", use_cache=True)
+    calls_after_eviction = enc._core_bpe.calls
+    enc.encode("entry-0", use_cache=True)
+    assert enc._core_bpe.calls == calls_after_eviction
+    enc.encode("entry-1", use_cache=True)
+    assert enc._core_bpe.calls == calls_after_eviction + 1
diff --git a/tests/test_feature_engineering.py b/tests/test_feature_engineering.py
new file mode 100644
