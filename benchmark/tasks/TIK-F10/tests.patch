+++ b/tests/test_feature_engineering.py
@@ -0,0 +1,40 @@
+import pickle
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+import pytest
+import tiktoken
+from tests.test_feature10 import counting_encoding
+
+
+def test_cross_entry_hits_and_policy_validation():
+    enc=counting_encoding()
+    ordinary=enc.encode('text',use_cache=True)
+    assert enc.encode_batch(['text'],use_cache=True)==[ordinary]
+    assert enc._core_bpe.calls==1
+    special=enc.encode('<|endoftext|>',allowed_special='all',use_cache=True)
+    assert enc.encode_batch(['<|endoftext|>'],allowed_special='all',use_cache=True)==[special]
+    assert enc._core_bpe.calls==2
+    with pytest.raises(ValueError):enc.encode_batch(['<|endoftext|>'],use_cache=True)
+    assert enc.encode_batch([],use_cache=True)==[]
+    value=enc.encode_batch(['text'],use_cache=True)
+    value[0].append(-1)
+    assert enc.encode('text',use_cache=True)==ordinary
+
+
+def test_concurrent_cache_eviction_and_pickle():
+    enc=counting_encoding()
+    gate=Barrier(4)
+    def worker(i):
+        gate.wait(timeout=10)
+        texts=[str(n) for n in range(i*40,i*40+140)]
+        return texts,enc.encode_batch(texts,num_threads=2,use_cache=True)
+    with ThreadPoolExecutor(4) as pool:
+        for texts,results in pool.map(worker,range(4)):
+            assert results==[enc.encode(t) for t in texts]
+    for original in [enc,tiktoken.get_encoding('cl100k_base')]:
+        original.encode('pickle',use_cache=True)
+        restored=pickle.loads(pickle.dumps(original))
+        assert restored.encode_batch(['pickle',''],use_cache=True)==[original.encode('pickle'),[]]
+    other=tiktoken.Encoding('shifted',pat_str=r'[\s\S]',
+        mergeable_ranks={bytes([i]):i+1 for i in range(256)},special_tokens={})
+    assert other.encode_batch(['x'],use_cache=True)!=enc.encode_batch(['x'],use_cache=True)
