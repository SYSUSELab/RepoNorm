+++ b/tests/test_cache_contribution.py
@@ -0,0 +1,93 @@
+import pickle
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+import tiktoken
+
+
+class CountingBPE:
+    def __init__(self, wrapped):
+        self.wrapped = wrapped
+        self.calls = 0
+
+    def encode(self, *args, **kwargs):
+        self.calls += 1
+        return self.wrapped.encode(*args, **kwargs)
+
+    def __getattr__(self, name):
+        return getattr(self.wrapped, name)
+
+
+def counting_encoding():
+    encoding = tiktoken.Encoding(
+        "contribution-cache",
+        pat_str=r"[\s\S]",
+        mergeable_ranks={bytes([i]): i for i in range(256)},
+        special_tokens={"<X>": 256},
+    )
+    encoding._core_bpe = CountingBPE(encoding._core_bpe)
+    return encoding
+
+
+def test_cache_is_opt_in_shared_and_copy_safe() -> None:
+    encoding = counting_encoding()
+    encoding.encode("uncached")
+    encoding.encode("uncached")
+    assert encoding._core_bpe.calls == 2
+
+    first = encoding.encode("cached", use_cache=True)
+    assert encoding.encode_batch(["cached"], use_cache=True) == [first]
+    assert encoding._core_bpe.calls == 3
+    first.append(-1)
+    assert -1 not in encoding.encode("cached", use_cache=True)
+
+
+def test_cache_key_preserves_special_policy() -> None:
+    encoding = counting_encoding()
+    natural = encoding.encode("<X>", disallowed_special=(), use_cache=True)
+    special = encoding.encode("<X>", allowed_special="all", use_cache=True)
+    assert natural != special
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode("<X>", use_cache=True)
+
+
+def test_serial_lru_capacity_and_instance_isolation() -> None:
+    encoding = counting_encoding()
+    for index in range(128):
+        encoding.encode(f"entry-{index}", use_cache=True)
+    encoding.encode("entry-0", use_cache=True)
+    encoding.encode("entry-128", use_cache=True)
+    calls = encoding._core_bpe.calls
+    encoding.encode("entry-0", use_cache=True)
+    encoding.encode("entry-1", use_cache=True)
+    assert encoding._core_bpe.calls == calls + 1
+
+    other = tiktoken.Encoding(
+        "shifted",
+        pat_str=r"[\s\S]",
+        mergeable_ranks={bytes([i]): i + 1 for i in range(256)},
+        special_tokens={},
+    )
+    assert other.encode("x", use_cache=True) != encoding.encode("x", use_cache=True)
+
+
+def test_concurrent_cache_access_and_pickle_round_trip() -> None:
+    encoding = counting_encoding()
+    texts = [str(index % 25) for index in range(200)]
+    with ThreadPoolExecutor(8) as pool:
+        results = list(pool.map(lambda text: encoding.encode(text, use_cache=True), texts))
+    assert results == [encoding.encode(text) for text in texts]
+
+    restored = pickle.loads(pickle.dumps(encoding))
+    assert restored.encode_batch(["pickle", ""], use_cache=True) == [
+        encoding.encode("pickle"),
+        [],
+    ]
+
+
+def test_cached_surrogate_recovery_is_stable() -> None:
+    encoding = counting_encoding()
+    text = "before \ud800 after"
+    assert encoding.encode(text, use_cache=True) == encoding.encode(text)
+    assert encoding.encode(text, use_cache=True) == encoding.encode(text)
