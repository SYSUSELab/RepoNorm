+def _make_gettext_with_fallback(
+    func: t.Callable[[str], str],
+    fallback_funcs: t.Sequence[t.Callable[[str], str]],
+) -> t.Callable[..., str]:
+    @pass_context
+    def gettext(__context: Context, __string: str) -> str:
+        rv = __context.call(func, __string)
+
+        if rv == __string:
+            for fallback_func in fallback_funcs:
+                rv = __context.call(fallback_func, __string)
+
+                if rv != __string:
+                    break
+
+        return rv
+
+    return gettext
