+def _make_ngettext_with_fallback(
+    func: t.Callable[[str, str, int], str],
+    fallback_funcs: t.Sequence[t.Callable[[str, str, int], str]],
+) -> t.Callable[..., str]:
+    @pass_context
+    def ngettext(
+        __context: Context,
+        __singular: str,
+        __plural: str,
+        __num: int,
+    ) -> str:
+        rv = __context.call(func, __singular, __plural, __num)
+        expected = __singular if __num == 1 else __plural
+
+        if rv == expected:
+            for fallback_func in fallback_funcs:
+                rv = __context.call(fallback_func, __singular, __plural, __num)
+
+                if rv != expected:
+                    break
+
+        return rv
+
+    return ngettext
+
