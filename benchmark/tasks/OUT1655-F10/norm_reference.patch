+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_hash_sha256_is_an_exported_composable_regex_term():
+    value = getattr(types, "hash_sha256")
+    assert isinstance(value, Regex)
+    assert re.fullmatch(to_regex("<" + value + ">"), "<" + "a" * 64 + ">")
+
+
+@pytest.mark.parametrize("value", ["0" * 64, "A" * 64, "AbCdEf12" * 8])
+def test_hash_sha256_accepts_exact_ascii_hex_shape(value):
+    assert re.fullmatch(to_regex(getattr(types, "hash_sha256")), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "a" * 63,
+        "a" * 65,
+        "g" + "a" * 63,
+        "0x" + "a" * 64,
+        "aa:" * 21 + "a",
+        " " + "a" * 64,
+        "١" * 64,
+    ],
+)
+def test_hash_sha256_rejects_invalid_complete_shapes(value):
+    assert re.fullmatch(to_regex(getattr(types, "hash_sha256")), value) is None
+
+
+def test_hash_sha256_works_in_pydantic_schema_and_validation():
+    class Digest(BaseModel):
+        value: types.hash_sha256
+
+    pattern = Digest.model_json_schema()["properties"]["value"]["pattern"]
+    valid = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+    assert re.fullmatch(pattern, valid)
+    assert Digest(value=valid).value == valid
+    with pytest.raises(ValidationError):
+        Digest(value="0x" + valid)
