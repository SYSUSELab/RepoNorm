           <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
         {% endfor %}</ul>
 
+    You can control whether items with empty or falsy attribute values
+    are included in the output using the ``include_empty`` parameter.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", include_empty=false) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,9 +1220,24 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
+
+    if include_empty:
+        filtered_value = value
+    else:
+        # Filter out items where the grouping attribute is falsy
+        filtered_value = [item for item in value if expr(item)]
+
+    # Create a sort key that handles None values and missing attributes properly
+    def sort_key(item):
+        val = expr(item)
+        if isinstance(val, Undefined):
+            bool(val)  # Preserve StrictUndefined's error behavior.
+            return (2, "")
+        return (1, "") if val is None else (0, val)
+
     return [
         _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
+        for key, values in groupby(sorted(filtered_value, key=sort_key), expr)
     ]
 
 
