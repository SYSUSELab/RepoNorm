diff --git a/tests/test_groupby_empty_contribution.py b/tests/test_groupby_empty_contribution.py
new file mode 100644
index 00000000..65b05016
--- /dev/null
+++ b/tests/test_groupby_empty_contribution.py
@@ -0,0 +1,46 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import StrictUndefined
+from jinja2 import Undefined
+from jinja2.exceptions import UndefinedError
+
+
+def test_groupby_retains_distinct_empty_none_and_missing_groups():
+    env = Environment()
+    rows = [{}, {"key": None}, {"key": ""}, {}, {"key": "z"}, {"key": None}]
+    groups = env.call_filter("groupby", rows, ["key"], {"include_empty": True})
+    assert [group.grouper for group in groups[:3]] == ["", "z", None]
+    assert isinstance(groups[3].grouper, Undefined)
+    assert groups[2].list == [rows[1], rows[5]]
+    assert groups[3].list == [rows[0], rows[3]]
+
+
+def test_groupby_filters_after_default_substitution():
+    env = Environment()
+    rows = [{"key": value} for value in [None, "", 0, False, "yes"]] + [{}]
+    groups = env.call_filter(
+        "groupby", rows, ["key"], {"default": "fallback", "include_empty": False}
+    )
+    assert [group.grouper for group in groups] == ["fallback", "yes"]
+
+
+def test_groupby_preserves_strict_undefined_error():
+    env = Environment(undefined=StrictUndefined)
+    with pytest.raises(UndefinedError):
+        env.call_filter("groupby", [{}], ["key"], {"include_empty": True})
+
+
+def test_async_groupby_empty_key_order():
+    env = Environment(enable_async=True)
+
+    async def rows():
+        for value in [None, "", "z"]:
+            yield {"key": value}
+
+    groups = asyncio.run(
+        env.call_filter("groupby", rows(), ["key"], {"include_empty": True})
+    )
+    assert [group.grouper for group in groups] == ["", "z", None]
