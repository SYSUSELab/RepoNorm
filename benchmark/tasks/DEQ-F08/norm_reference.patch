+import re
+
+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize(
+    'value, pattern, flags, mode',
+    [
+        ('ABC', re.compile('abc', re.IGNORECASE), 0, 'match'),
+        ('xABC', 'abc', re.IGNORECASE, 'search'),
+        ('abc', 'abc', 0, 'fullmatch'),
+        ('line1\nline2', '^line2$', re.MULTILINE, 'search'),
+    ],
+)
+def test_regex_matches(value, pattern, flags, mode):
+    assert value == de.IsRegex(pattern, flags, mode=mode)
+
+
+@pytest.mark.parametrize('value', [123, b'abc', None, 'xbc'])
+def test_regex_rejections(value):
+    assert value != de.IsRegex('abc')
+
+
+def test_regex_construction_errors():
+    with pytest.raises(re.error):
+        de.IsRegex('[')
+    with pytest.raises(ValueError):
+        de.IsRegex('abc', mode='unknown')
+    with pytest.raises(ValueError):
+        de.IsRegex(re.compile('abc'), re.IGNORECASE)
+    with pytest.raises(TypeError):
+        de.IsRegex(re.compile(b'abc'))
+
+
+def test_regex_composition_repr_and_value():
+    validator = de.IsRegex('abc', mode='search')
+    assert 'xabc' == (validator & de.IsStr())
+    assert 'xyz' == (validator | de.IsRegex('xyz'))
+    assert 'xyz' == ~de.IsRegex('abc')
+    assert "mode='search'" in repr(de.IsRegex('abc', mode='search'))
+    assert 'xabc' == validator
+    assert validator.value == 'xabc'
+    assert '"xabc"' == de.IsJson(de.IsRegex('abc', mode='search'))
