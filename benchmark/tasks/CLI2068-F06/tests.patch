+import os
 import platform
 import time
 
@@ -470,3 +471,56 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _PriorityProcess:
+    pid = 1010
+    def __init__(self, code=0): self.code = code
+    def wait(self): return self.code
+
+
+@pytest.mark.parametrize("priority", ["urgent", "", 1, False])
+def test_edit_process_priority_rejects_invalid_values(priority, monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: pytest.fail("must not launch"))
+    with pytest.raises(ValueError, match="process_priority"):
+        click.edit(filename="file.txt", editor="editor", process_priority=priority)
+
+
+def _priority_probe(tmp_path):
+    script = tmp_path / "priority.py"
+    output = tmp_path / "priority.txt"
+    script.write_text(
+        "import os, pathlib, sys\n"
+        "pathlib.Path(sys.argv[1]).write_text(str(os.getpriority(os.PRIO_PROCESS, 0)))\n"
+    )
+    return script, output
+
+
+@pytest.mark.skipif(not hasattr(os, "getpriority"), reason="POSIX priority observation")
+def test_edit_process_priority_low_is_observable(tmp_path):
+    script, output = _priority_probe(tmp_path)
+    parent_priority = os.getpriority(os.PRIO_PROCESS, 0)
+    click.edit(filename=str(output), editor=f"python {script}", process_priority="low")
+    assert int(output.read_text()) > parent_priority
+
+
+@pytest.mark.skipif(not hasattr(os, "getpriority"), reason="POSIX priority observation")
+def test_edit_process_priority_permission_failure_degrades(tmp_path, monkeypatch):
+    script, output = _priority_probe(tmp_path)
+    monkeypatch.setattr("click._termui_impl.os.nice", lambda value: (_ for _ in ()).throw(PermissionError("denied")))
+    click.edit(filename=str(output), editor=f"python {script}", process_priority="high")
+    assert output.exists()
+
+
+def test_edit_process_priority_none_preserves_edit_result(tmp_path, monkeypatch):
+    path = tmp_path / "file.txt"; path.write_text("x")
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append((a, kw)) or _PriorityProcess())
+    assert click.edit(filename=str(path), editor="editor") is None
+    assert len(calls) == 1
+
+
+def test_edit_process_priority_nonzero_keeps_failure(monkeypatch):
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _PriorityProcess(2))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="file.txt", editor="editor", process_priority="low")
