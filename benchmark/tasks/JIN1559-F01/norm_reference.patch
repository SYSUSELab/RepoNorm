index 00000000..ffd4289c
--- /dev/null
+++ b/tests/test_n4c_author_translation_context.py
@@ -0,0 +1,97 @@
+import pytest
+
+from jinja2 import Environment
+from jinja2 import pass_context
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_context_calls_and_non_context_regression(newstyle):
+    calls = []
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.install_gettext_callables(
+        lambda message: calls.append(("gettext", message)) or message,
+        lambda singular, plural, count: singular if count == 1 else plural,
+        newstyle=newstyle,
+        pgettext=lambda context, message: calls.append(("pgettext", context, message))
+        or message,
+        npgettext=lambda context, singular, plural, count: calls.append(
+            ("npgettext", context, singular, plural, count)
+        )
+        or (singular if count == 1 else plural),
+    )
+
+    contextual = env.from_string(
+        '{% trans "menu" name=user %}Open {{ name }}{% endtrans %}'
+    )
+    ordinary = env.from_string("{% trans %}Close{% endtrans %}")
+
+    assert contextual.render(user="File") == "Open File"
+    assert ordinary.render() == "Close"
+    assert calls == [
+        ("pgettext", "menu", "Open %(name)s"),
+        ("gettext", "Close"),
+    ]
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+def test_context_plural_trimmed(newstyle):
+    calls = []
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.install_gettext_callables(
+        lambda message: message,
+        lambda singular, plural, count: singular if count == 1 else plural,
+        newstyle=newstyle,
+        pgettext=lambda context, message: message,
+        npgettext=lambda context, singular, plural, count: calls.append(
+            (context, singular, plural, count)
+        )
+        or (singular if count == 1 else plural),
+    )
+    template = env.from_string(
+        '{% trans "search" count=n, trimmed %}\n'
+        "  {{ count }} result\n"
+        "{% pluralize %}\n"
+        "  {{ count }} results\n"
+        "{% endtrans %}"
+    )
+
+    assert template.render(n=2) == "2 results"
+    assert calls == [("search", "%(count)s result", "%(count)s results", 2)]
+
+
+def test_context_extraction():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    source = (
+        '{% trans "menu" %}Open{% endtrans %}\n'
+        '{% trans "files" n=count %}One{% pluralize %}Many{% endtrans %}'
+    )
+    assert list(env.extract_translations(source)) == [
+        (1, "pgettext", ("menu", "Open")),
+        (2, "npgettext", ("files", "One", "Many", None)),
+    ]
+
+
+@pytest.mark.parametrize("newstyle", [False, True])
+@pytest.mark.parametrize("escape", [False, True])
+def test_context_provider_keeps_jinja_call_and_escape_protocol(newstyle, escape):
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    seen = []
+
+    @pass_context
+    def provider(context, domain, message):
+        seen.append(context.environment)
+        return "<b>%(name)s</b>"
+
+    env.install_gettext_callables(
+        lambda message: message,
+        lambda one, many, n: many,
+        pgettext=provider,
+        newstyle=newstyle,
+    )
+    source = (
+        '{% autoescape escape %}{% trans "html" name=value %}'
+        "Hi {{ name }}{% endtrans %}{% endautoescape %}"
+    )
+    expected = "<b>&lt;x&gt;</b>" if escape else "<b><x></b>"
+    assert env.from_string(source).render(value="<x>", escape=escape) == expected
+    assert seen == [env]
