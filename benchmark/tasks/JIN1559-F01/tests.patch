+class TestTranslationBlockContext:
+    @pytest.mark.parametrize("newstyle", [False, True])
+    def test_context_singular_with_variable(self, newstyle):
+        calls = []
+
+        def contextual(context, message):
+            calls.append((context, message))
+            return {("menu", "Open %(name)s"): "Open menu %(name)s"}.get(
+                (context, message), message
+            )
+
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda message: message,
+            lambda singular, plural, n: singular if n == 1 else plural,
+            newstyle=newstyle,
+            pgettext=contextual,
+            npgettext=lambda context, singular, plural, n: (
+                singular if n == 1 else plural
+            ),
+        )
+        template = env.from_string(
+            '{% trans "menu" name=user %}Open {{ name }}{% endtrans %}'
+        )
+
+        assert template.render(user="File") == "Open menu File"
+        assert calls == [("menu", "Open %(name)s")]
+
+    @pytest.mark.parametrize("newstyle", [False, True])
+    @pytest.mark.parametrize(("count", "expected"), [(1, "one result"), (2, "2 results")])
+    def test_context_plural(self, newstyle, count, expected):
+        calls = []
+
+        def contextual(context, singular, plural, n):
+            calls.append((context, singular, plural, n))
+            return "one result" if n == 1 else "%(count)s results"
+
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda message: message,
+            lambda singular, plural, n: singular if n == 1 else plural,
+            newstyle=newstyle,
+            pgettext=lambda context, message: message,
+            npgettext=contextual,
+        )
+        template = env.from_string(
+            '{% trans "search" count=n, trimmed %}{{ count }} item'
+            "{% pluralize %}{{ count }} items{% endtrans %}"
+        )
+
+        assert template.render(n=count) == expected
+        assert calls == [
+            ("search", "%(count)s item", "%(count)s items", count)
+        ]
+
+    def test_no_context_still_uses_gettext(self):
+        calls = []
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda message: calls.append(message) or "ordinary",
+            lambda singular, plural, n: singular if n == 1 else plural,
+            pgettext=lambda context, message: "unexpected",
+        )
+
+        assert env.from_string("{% trans %}Message{% endtrans %}").render() == (
+            "ordinary"
+        )
+        assert calls == ["Message"]
+
+    def test_context_messages_are_extracted_through_public_api(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        source = (
+            '{% trans "menu" %}Open{% endtrans %}\n'
+            '{% trans "files" n=count %}One file{% pluralize %}'
+            "Many files{% endtrans %}"
+        )
+        extracted = list(env.extract_translations(source))
+
+        assert extracted == [
+            (1, "pgettext", ("menu", "Open")),
+            (2, "npgettext", ("files", "One file", "Many files", None)),
+        ]
