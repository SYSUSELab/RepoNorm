diff --git a/tests/test_groupby_stable_contribution.py b/tests/test_groupby_stable_contribution.py
new file mode 100644
index 00000000..14616b21
--- /dev/null
+++ b/tests/test_groupby_stable_contribution.py
@@ -0,0 +1,92 @@
+import asyncio
+from copy import deepcopy
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import StrictUndefined
+from jinja2 import UndefinedError
+
+
+def test_stable_supports_unhashable_equal_keys_without_mutation():
+    env = Environment()
+    keys = [[2], {"a": 1, "b": 2}, 4, [2], {"b": 2, "a": 1}, "[2]"]
+    rows = [{"meta": {"key": key}, "id": i} for i, key in enumerate(keys)]
+    before = deepcopy(rows)
+
+    result = env.call_filter("groupby", iter(rows), ["meta.key"], {"stable": True})
+
+    assert [group.grouper for group in result] == [
+        [2],
+        {"a": 1, "b": 2},
+        4,
+        "[2]",
+    ]
+    assert result[0].grouper is keys[0]
+    assert result[1].grouper is keys[1]
+    assert [[row["id"] for row in group.list] for group in result] == [
+        [0, 3],
+        [1, 4],
+        [2],
+        [5],
+    ]
+    assert rows == before
+
+
+def test_stable_changes_group_order_but_preserves_group_interface():
+    env = Environment()
+    rows = [
+        {"kind": "b", "value": 1},
+        {"kind": "a", "value": 2},
+        {"kind": "b", "value": 3},
+    ]
+
+    stable = env.call_filter("groupby", rows, ["kind"], {"stable": True})
+    sorted_result = env.call_filter("groupby", rows, ["kind"], {"stable": False})
+
+    assert [group.grouper for group in stable] == ["b", "a"]
+    assert [group.grouper for group in sorted_result] == ["a", "b"]
+    assert stable[0] == ("b", [rows[0], rows[2]])
+    assert repr(stable[0]) == repr(("b", [rows[0], rows[2]]))
+
+
+def test_stable_uses_environment_lookup_and_default():
+    class UpperKeyEnvironment(Environment):
+        def getitem(self, obj, argument):
+            if argument == "kind" and argument in obj:
+                return obj[argument].upper()
+
+            return super().getitem(obj, argument)
+
+    env = UpperKeyEnvironment()
+    rows = [{"kind": "b"}, {}, {"kind": "B"}]
+
+    result = env.call_filter(
+        "groupby", rows, ["kind"], {"default": "missing", "stable": True}
+    )
+
+    assert [group.grouper for group in result] == ["B", "missing"]
+    assert [group.list for group in result] == [[rows[0], rows[2]], [rows[1]]]
+
+
+def test_stable_propagates_strict_undefined():
+    env = Environment(undefined=StrictUndefined)
+
+    with pytest.raises(UndefinedError):
+        env.call_filter("groupby", [{}, {}], ["missing"], {"stable": True})
+
+
+def test_stable_async_accepts_async_input():
+    async def stream():
+        for row in [{"kind": [2], "id": 1}, {"kind": [2], "id": 2}]:
+            yield row
+
+    async def run():
+        env = Environment(enable_async=True)
+        result = await env.call_filter("groupby", stream(), ["kind"], {"stable": True})
+        return result
+
+    result = asyncio.run(run())
+
+    assert [group.grouper for group in result] == [[2]]
+    assert [[row["id"] for row in group.list] for group in result] == [[1, 2]]
