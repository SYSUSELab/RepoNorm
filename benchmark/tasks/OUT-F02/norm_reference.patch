+        # Caching infrastructure
+        self._cache_enabled = bool(cache_compiled_grammars)
+        self._grammar_cache: OrderedDict[tuple[str, str], Any] = OrderedDict()
+        self._inflight: dict[tuple[str, str], Future[Any]] = {}
