diff --git a/tests/backends/test_xgrammar_contribution.py b/tests/backends/test_xgrammar_contribution.py
new file mode 100644
index 00000000..2b09640b
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,84 @@
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier, Event
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import xgrammar as xgr
+
+from outlines.backends.xgrammar import XGrammarBackend
+from outlines.models.transformers import Transformers
+
+
+@pytest.fixture
+def backend_factory(monkeypatch):
+    model = Mock(spec=Transformers)
+    model.model = SimpleNamespace(config=SimpleNamespace(_name_or_path="local"))
+    model.hf_tokenizer = object()
+    monkeypatch.setattr(
+        "transformers.AutoConfig.from_pretrained",
+        lambda *args, **kwargs: SimpleNamespace(vocab_size=5),
+    )
+    info = xgr.TokenizerInfo(
+        ["a", "b", "c", "d", "<eos>"], stop_token_ids=[4]
+    )
+    monkeypatch.setattr(
+        xgr.TokenizerInfo,
+        "from_huggingface",
+        lambda *args, **kwargs: info,
+    )
+    return lambda **kwargs: XGrammarBackend(model, **kwargs)
+
+
+def test_cache_is_lru_and_returns_fresh_processors(backend_factory):
+    backend = backend_factory(
+        cache_compiled_grammars=True, max_cached_grammars=2
+    )
+    backend.grammar_compiler = Mock(wraps=backend.grammar_compiler)
+
+    first = backend.get_regex_logits_processor("ab")
+    backend.get_regex_logits_processor("cd")
+    again = backend.get_regex_logits_processor("ab")
+    assert first is not again
+    assert backend.grammar_compiler.compile_regex.call_count == 2
+
+    backend.get_regex_logits_processor("ac")
+    backend.get_regex_logits_processor("cd")
+    assert backend.grammar_compiler.compile_regex.call_count == 4
+
+
+def test_concurrent_cache_miss_is_shared_and_failure_can_retry(backend_factory):
+    backend = backend_factory(cache_compiled_grammars=True)
+    real_compile = backend.grammar_compiler.compile_regex
+    entered = Event()
+    release = Event()
+
+    def compile_regex(source):
+        entered.set()
+        assert release.wait(10)
+        return real_compile(source)
+
+    spy = Mock(side_effect=compile_regex)
+    backend.grammar_compiler = SimpleNamespace(compile_regex=spy)
+    start = Barrier(5)
+
+    def request():
+        start.wait(timeout=10)
+        return backend.get_regex_logits_processor("ab")
+
+    with ThreadPoolExecutor(max_workers=4) as executor:
+        jobs = [executor.submit(request) for _ in range(4)]
+        start.wait(timeout=10)
+        assert entered.wait(10)
+        release.set()
+        processors = [job.result(timeout=10) for job in jobs]
+
+    assert spy.call_count == 1
+    assert len({id(processor) for processor in processors}) == 4
+
+    error = ValueError("invalid grammar")
+    spy.side_effect = [error, real_compile("cd")]
+    with pytest.raises(ValueError) as caught:
+        backend.get_regex_logits_processor("cd")
+    assert caught.value is error
+    backend.get_regex_logits_processor("cd")
