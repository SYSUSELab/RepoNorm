+        self._cache_lock = threading.Lock() if self._cache_enabled else None
+    def _compile_with_cache(
+        self, kind: str, source: str, compiler_func: Callable[[str], Any]
+    ) -> Any:
+        """Compile a grammar with optional caching.
+
+        Parameters
+        ----------
+        kind
+            A short string distinguishing JSON schema, regex, and CFG entries.
+        source
+            The exact grammar source used as part of the cache key.
+        compiler_func
+            The compiler operation for this grammar kind.
+        """
+        if not self._cache_enabled:
+            return compiler_func(source)
+
+        cache_key = (kind, source)
+        assert self._cache_lock is not None
+        with self._cache_lock:
+            if cache_key in self._grammar_cache:
+                self._grammar_cache.move_to_end(cache_key)
+                return self._grammar_cache[cache_key]
+            future = self._inflight.get(cache_key)
+            owner = future is None
+            if owner:
+                future = self._inflight[cache_key] = Future()
+        if not owner:
+            assert future is not None
+            return future.result()
+        try:
+            compiled = compiler_func(source)
+        except BaseException as exc:
+            with self._cache_lock:
+                self._inflight.pop(cache_key)
+                assert future is not None
+                future.set_exception(exc)
+            raise
+        with self._cache_lock:
+            self._grammar_cache[cache_key] = compiled
+            if self._cache_limit is not None and len(self._grammar_cache) > self._cache_limit:
+                self._grammar_cache.popitem(last=False)
+            self._inflight.pop(cache_key)
+            assert future is not None
+            future.set_result(compiled)
+            return compiled
 
