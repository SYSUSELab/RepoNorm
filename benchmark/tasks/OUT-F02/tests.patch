+def test_v5_cache_lru_and_independent_processors(v5_backend_factory):
+    backend = v5_backend_factory(cache_compiled_grammars=True, max_cached_grammars=2)
+    real = backend.grammar_compiler
+    backend.grammar_compiler = Mock(wraps=real)
+    a = backend.get_regex_logits_processor("ab")
+    b = backend.get_regex_logits_processor("cd")
+    again = backend.get_regex_logits_processor("ab")
+    assert a is not again
+    assert backend.grammar_compiler.compile_regex.call_count == 2
+    backend.get_regex_logits_processor("ac")
+    backend.get_regex_logits_processor("ab")
+    backend.get_regex_logits_processor("cd")
+    assert backend.grammar_compiler.compile_regex.call_count == 4
+    a(torch.tensor([[4]]), torch.zeros(1, 5))
+    a(torch.tensor([[4, 0]]), torch.zeros(1, 5))
+    assert torch.isfinite(again(torch.tensor([[4]]), torch.zeros(1, 5))).tolist() == [[True, False, False, False, False]]
+
