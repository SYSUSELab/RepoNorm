+def test_v5_cache_concurrent_and_retry(v5_backend_factory):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier, Event
+    backend = v5_backend_factory(cache_compiled_grammars=True)
+    real = backend.grammar_compiler.compile_regex
+    entered, release = Event(), Event()
+    def compile(source):
+        entered.set()
+        assert release.wait(10)
+        return real(source)
+    spy = Mock(side_effect=compile)
+    backend.grammar_compiler = SimpleNamespace(compile_regex=spy)
+    start = Barrier(5)
+    def request():
+        start.wait(timeout=10)
+        return backend.get_regex_logits_processor("ab")
+    with ThreadPoolExecutor(max_workers=4) as executor:
+        jobs = [executor.submit(request) for _ in range(4)]
+        start.wait(timeout=10)
+        assert entered.wait(10)
+        release.set()
+        results = [job.result(timeout=10) for job in jobs]
+    assert spy.call_count == 1
+    assert len({id(p) for p in results}) == 4
+    error = ValueError("compiler rejected input")
+    spy.side_effect = [error, real("cd")]
+    with pytest.raises(ValueError) as caught:
+        backend.get_regex_logits_processor("cd")
+    assert caught.value is error
+    backend.get_regex_logits_processor("cd")
+    assert spy.call_count == 3
+
