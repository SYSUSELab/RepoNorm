@@ -401,3 +401,91 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+class TestTemplatePathValidation:
+    @pytest.mark.parametrize(
+        "name",
+        [
+            None,
+            "",
+            "bad\x00name",
+            "/absolute",
+            "\\absolute",
+            "C:drive",
+            "z:/drive",
+            "control\x01name",
+            "control\x1fname",
+        ],
+    )
+    def test_public_validator_rejects_invalid_names(self, name):
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loaders.validate_template_path(name)
+        assert exc_info.value.name == name
+
+    @pytest.mark.parametrize(
+        "name", ["page.html", "nested/page.html", "tab\tname", "line\nname", "cr\rname"]
+    )
+    def test_public_validator_accepts_declared_valid_names(self, name):
+        assert loaders.validate_template_path(name) is None
+
+    @pytest.mark.parametrize("kind", ["dict", "function"])
+    @pytest.mark.parametrize("name", ["/absolute", "bad\x00name", "C:drive"])
+    def test_non_filesystem_loader_rejects_existing_invalid_key(self, kind, name):
+        if kind == "dict":
+            loader = loaders.DictLoader({name: "should not load"})
+        else:
+            loader = loaders.FunctionLoader(
+                lambda requested: "should not load" if requested == name else None
+            )
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loader.get_source(Environment(), name)
+        assert exc_info.value.name == name
+
+    @pytest.mark.parametrize("kind", ["filesystem", "package"])
+    def test_filesystem_style_loaders_validate_direct_get_source(
+        self, kind, tmp_path, package_dir_loader
+    ):
+        loader = (
+            loaders.FileSystemLoader(tmp_path)
+            if kind == "filesystem"
+            else package_dir_loader
+        )
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loader.get_source(Environment(), "/test.html")
+        assert exc_info.value.name == "/test.html"
+
+    @pytest.mark.parametrize("kind", ["prefix", "choice"])
+    def test_composite_loader_validates_before_child(self, kind):
+        invalid = "/absolute"
+        child = loaders.DictLoader({invalid: "should not load"})
+        loader = (
+            loaders.PrefixLoader({"site": child})
+            if kind == "prefix"
+            else loaders.ChoiceLoader([child])
+        )
+        requested = "/site/absolute" if kind == "prefix" else invalid
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loader.load(Environment(), requested)
+        assert exc_info.value.name == requested
+
+    def test_module_loader_rejects_precompiled_invalid_name(self, tmp_path):
+        invalid = "/absolute"
+        safe = "safe"
+        source_env = Environment(loader=loaders.DictLoader({safe: "compiled"}))
+        source_env.compile_templates(str(tmp_path), zip=None)
+        (tmp_path / loaders.ModuleLoader.get_module_filename(safe)).rename(
+            tmp_path / loaders.ModuleLoader.get_module_filename(invalid)
+        )
+        loader = loaders.ModuleLoader(tmp_path)
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loader.load(Environment(), invalid)
+        assert exc_info.value.name == invalid
+
+    def test_allowed_control_exception_can_load_from_dict(self):
+        name = "line\nname"
+        env = Environment(loader=loaders.DictLoader({name: "allowed"}))
+        assert env.get_template(name).render() == "allowed"
