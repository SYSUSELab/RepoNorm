@@ -0,0 +1,32 @@
+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize(
+    'value,format',
+    [
+        ('00:1B:44:11:3A:B7', 'colon'),
+        ('00-1b-44-11-3a-b7', 'hyphen'),
+        ('001B.4411.3AB7', 'dot'),
+        ('001b44113ab7', 'compact'),
+    ],
+)
+def test_mac_formats_and_value(value, format):
+    validator = de.IsMac(format)
+    assert value == validator
+    assert validator.value == value
+    assert repr(validator) == repr(value)
+
+
+def test_mac_rejects_malformed_and_wrong_format():
+    validator = de.IsMac()
+    for value in ('00:1B-44:11-3A:B7', '00:1B:44:11:3A', 'GG:1B:44:11:3A:B7', None):
+        assert value != validator
+    assert '00-1B-44-11-3A-B7' != de.IsMac('colon')
+
+
+def test_mac_public_composition_and_fresh_repr():
+    assert repr(de.IsMac()) == 'IsMac(*)'
+    assert '00:1B:44:11:3A:B7' == (de.IsMac('colon') & de.IsStr())
+    assert '00:1B:44:11:3A:B7' == ~de.IsMac('compact')
