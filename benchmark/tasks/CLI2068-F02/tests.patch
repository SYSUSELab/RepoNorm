+@pytest.mark.parametrize("timeout", [0, -1, True, False, 1.0, "1", object()])
+def test_edit_timeout_rejects_values_other_than_positive_integers(timeout):
+    with pytest.raises(ValueError):
+        click.edit("text", editor="unused", timeout=timeout)
+
