@@ -0,0 +1,37 @@
+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_binary_str_is_an_exported_regex_term():
+    assert isinstance(types.binary_str, Regex)
+    combined = "value=" + types.binary_str
+    assert re.fullmatch(to_regex(combined), "value=0b101")
+
+
+@pytest.mark.parametrize("value", ["0b0", "0b1", "0b101010", "0b" + "1" * 100])
+def test_binary_str_accepts_complete_valid_values(value):
+    assert re.fullmatch(to_regex(types.binary_str), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "0b", "101", "0B10", "+0b1", "0b2", "0b10_01", " 0b1", "0b١٠"],
+)
+def test_binary_str_rejects_invalid_complete_values(value):
+    assert re.fullmatch(to_regex(types.binary_str), value) is None
+
+
+def test_binary_str_works_in_pydantic_schema_and_validation():
+    class Model(BaseModel):
+        value: types.binary_str
+
+    pattern = Model.model_json_schema()["properties"]["value"]["pattern"]
+    assert re.fullmatch(pattern, "0b101")
+    assert Model(value="0b101").value == "0b101"
+    with pytest.raises(ValidationError):
+        Model(value="101")
