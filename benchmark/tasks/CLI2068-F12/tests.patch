diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..35d53b5 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,64 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _ExitCodeProcess:
+    pid = 1002
+
+    def __init__(self, code):
+        self.code = code
+
+    def wait(self):
+        return self.code
+
+
+@pytest.mark.parametrize("code", [0, 7])
+def test_edit_exit_code_handler_runs_once(code, tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("text")
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _ExitCodeProcess(code))
+
+    assert click.edit(filename=str(path), editor="editor", handle_exit_codes={code: lambda value: calls.append(value)}) is None
+
+    assert calls == [code]
+
+
+def test_edit_exit_code_handler_return_is_ignored_for_text(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _ExitCodeProcess(0))
+
+    result = click.edit("unchanged", editor="editor", require_save=False, handle_exit_codes={0: lambda code: "replacement"})
+
+    assert result == "unchanged\n"
+
+
+def test_edit_exit_code_unmatched_nonzero_keeps_failure(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("text")
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _ExitCodeProcess(4))
+
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename=str(path), editor="editor", handle_exit_codes={3: lambda code: None})
+
+
+def test_edit_exit_code_empty_mapping_keeps_failure(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("text")
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _ExitCodeProcess(4))
+
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename=str(path), editor="editor", handle_exit_codes={})
+
+
+def test_edit_exit_code_handler_failure_is_chained(tmp_path, monkeypatch):
+    path = tmp_path / "note.txt"
+    path.write_text("text")
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _ExitCodeProcess(2))
+
+    def fail(code):
+        raise RuntimeError("handler broke")
+
+    with pytest.raises(click.ClickException, match="Exit code handler failed") as exc_info:
+        click.edit(filename=str(path), editor="editor", handle_exit_codes={2: fail})
+
+    assert isinstance(exc_info.value.__cause__, RuntimeError)
