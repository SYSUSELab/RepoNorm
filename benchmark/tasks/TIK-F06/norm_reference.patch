+++ b/tests/test_transformers_contribution.py
@@ -0,0 +1,77 @@
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+def test_single_and_ordered_transformers(encoding) -> None:
+    calls = []
+
+    def append(text):
+        calls.append("append")
+        return text + "A"
+
+    def lower(text):
+        calls.append("lower")
+        return text.lower()
+
+    assert encoding.encode("X", transformers=(append, lower)) == encoding.encode("xa")
+    assert calls == ["append", "lower"]
+    assert encoding.encode("HELLO", transformers=str.lower) == encoding.encode("hello")
+
+
+def test_transformed_text_uses_special_policy(encoding) -> None:
+    special = "<|endoftext|>"
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode("ordinary", transformers=lambda text: special)
+    assert encoding.encode(
+        "ordinary", transformers=lambda text: special, allowed_special="all"
+    ) == encoding.encode(special, allowed_special="all")
+
+
+def test_transformed_surrogate_uses_text_recovery(encoding) -> None:
+    transformed = "before \ud800 after"
+    assert encoding.encode("source", transformers=lambda text: transformed) == encoding.encode(
+        transformed
+    )
+
+
+def test_errors_stop_the_pipeline_and_preserve_identity(encoding) -> None:
+    calls = []
+    error = RuntimeError("original")
+
+    def fail(text):
+        raise error
+
+    def later(text):
+        calls.append(text)
+        return text
+
+    with pytest.raises(RuntimeError) as info:
+        encoding.encode("text", transformers=[fail, later])
+    assert info.value is error
+    assert calls == []
+    with pytest.raises(TypeError, match="return str"):
+        encoding.encode("text", transformers=[lambda text: 42, later])
+    assert calls == []
+
+
+def test_batch_invokes_pipeline_per_document_and_preserves_order(encoding) -> None:
+    calls = []
+
+    def record(text):
+        calls.append(text)
+        return text.upper()
+
+    texts = ["b", "a", "b", ""]
+    pipeline = [record]
+    assert encoding.encode_batch(texts, transformers=pipeline, num_threads=1) == [
+        encoding.encode(text.upper()) for text in texts
+    ]
+    assert calls == texts
+    assert pipeline == [record]
+    assert encoding.encode_batch([], transformers=pipeline) == []
