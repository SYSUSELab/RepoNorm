+import pytest
+import tiktoken
+
+
+def test_batch_transformations_and_special_policy():
+    enc=tiktoken.get_encoding('cl100k_base')
+    pipeline=(lambda s:s+'!', lambda s:s.upper())
+    texts=['abc','你😀','abc','']
+    for threads in [1,3]:
+        assert enc.encode_batch(texts,transformers=pipeline,num_threads=threads)==[enc.encode(s.upper()+'!') for s in texts]
+    assert enc.encode_batch([],transformers=pipeline)==[]
+    assert enc.encode_batch(['<|endoftext|>'],transformers=lambda s:'')==[[]]
+    with pytest.raises(ValueError):
+        enc.encode_batch(['x'],transformers=lambda s:'<|endoftext|>')
+    assert enc.encode_batch(['x'],transformers=lambda s:'<|endoftext|>',allowed_special='all')==[enc.encode('<|endoftext|>',allowed_special='all')]
+
+
+def test_transformer_failure_and_independent_invocation():
+    enc=tiktoken.get_encoding('cl100k_base')
+    calls=[]
+    def first(s):
+        calls.append(s)
+        return s
+    pipeline=[first]
+    enc.encode_batch(['a','a'],transformers=pipeline,num_threads=1)
+    assert calls==['a','a'] and pipeline==[first]
+    error=RuntimeError('original error')
+    def fail(s):raise error
+    for method,arg in [(enc.encode,'a'),(enc.encode_batch,['a'])]:
+        calls.clear()
+        with pytest.raises(RuntimeError) as info:method(arg,transformers=[fail,first])
+        assert info.value is error and calls==[]
+        with pytest.raises(TypeError):method(arg,transformers=[lambda s:123,first])
+        assert calls==[]
