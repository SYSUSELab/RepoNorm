diff --git a/tests/test_separator_contribution.py b/tests/test_separator_contribution.py
new file mode 100644
index 00000000..2968a2d0
--- /dev/null
+++ b/tests/test_separator_contribution.py
@@ -0,0 +1,30 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_separator_map_and_groupby(asynchronous):
+    env = Environment(enable_async=asynchronous)
+    template = env.from_string(
+        "{% for g in xs|groupby('data__0__literal.key', separator='__') %}"
+        "{{ g.grouper }}:{{ g.list|map(attribute='data__0__literal.key', "
+        "separator='__')|join(',') }};{% endfor %}"
+    )
+    values = iter([{"data": [{"literal.key": "b"}]}, {"data": [{"literal.key": "a"}]}])
+    if asynchronous:
+        result = asyncio.run(template.render_async(xs=values))
+    else:
+        result = template.render(xs=values)
+    assert result == "a:a;b:b;"
+
+
+def test_separator_empty_path_evaluation():
+    env = Environment()
+    template = env.from_string("{{ xs|map(attribute='name', separator='')|list }}")
+    assert template.render(xs=[]) == "[]"
+    with pytest.raises(FilterArgumentError):
+        template.render(xs=[{"name": "a"}])
