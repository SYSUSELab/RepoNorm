+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_separator_groupby_map(asynchronous):
+    from types import SimpleNamespace
+    from jinja2 import Environment
+    env = Environment(enable_async=asynchronous)
+    rows = [SimpleNamespace(p=[{"literal.key": v}]) for v in ["b", "a", "b"]]
+    async def stream():
+        for row in rows:
+            yield row
+    tmpl = env.from_string('{% for g in rows|groupby("p__0__literal.key", separator="__") %}{{g.grouper}}:{{g.list|map(attribute="p__0__literal.key", separator="__")|join(",")}};{% endfor %}')
+    assert tmpl.render(rows=stream() if asynchronous else iter(rows)) == "a:a;b:b,b;"
+    tmpl = env.from_string('{{ rows|map(attribute="p->0->key", separator="->", default="missing")|join(",") }}')
+    assert tmpl.render(rows=[{}, {"p": [{"key": "yes"}]}]) == "missing,yes"
+    env.filters["custom"] = lambda value, separator: separator.join(value)
+    assert env.from_string('{{ rows|map("custom", separator="!")|join(",") }}').render(rows=["ab"]) == "a!b"
+    assert env.from_string('{{ rows|map(attribute="p.key")|join }}').render(rows=[{"p": {"key": "ok"}}]) == "ok"
+
+
