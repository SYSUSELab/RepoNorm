+def test_metadata_public_extraction_and_rendering():
+    env = Environment(extensions=["jinja2.ext.i18n"]); env.install_null_translations()
+    source = '{% trans note="Greeting", created="2024-01-01" %}Hello {{ name }}{% endtrans %}'
+    records = list(env.extract_translations_with_metadata(source, "page.html"))
+    assert records == [{
+        "source": "page.html", "lineno": 1,
+        "metadata": {"note": "Greeting", "created": "2024-01-01"},
+        "messages": [{"lineno": 1, "function": "gettext", "message": "Hello %(name)s"}],
+    }]
+    records[0]["metadata"]["note"] = "changed"
+    assert list(env.extract_translations_with_metadata(source, "page.html"))[0]["metadata"]["note"] == "Greeting"
+    assert env.from_string(source).render(name="World") == "Hello World"
+
+
+def test_metadata_plural_trimmed_unicode():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    source = '{% trans note="提示", modified="", n=2, trimmed %} one {{ n }} {% pluralize %} many {{ n }} {% endtrans %}'
+    record = list(env.extract_translations_with_metadata(source))[0]
+    assert record["metadata"] == {"note": "提示", "modified": ""}
+    assert record["messages"][0]["function"] == "ngettext"
+
+
+def test_metadata_validation():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    with pytest.raises(TemplateAssertionError, match="note.*string literal"):
+        env.from_string("{% trans note=value %}x{% endtrans %}")
+    with pytest.raises(TemplateAssertionError, match="note.*requires"):
+        env.from_string("{% trans note %}x{% endtrans %}")
+    with pytest.raises(TemplateAssertionError, match="note.*twice"):
+        env.from_string('{% trans note="a", note="b" %}x{% endtrans %}')
+
+
+def test_metadata_free_and_repeated_extraction():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    assert list(env.extract_translations_with_metadata("{% trans %}x{% endtrans %}")) == []
+    source = '{% trans note="n" %}x{% endtrans %}'
+    assert list(env.extract_translations_with_metadata(source)) == list(env.extract_translations_with_metadata(source))
