+    def _extract_with_metadata(
+        self, source: t.Union[str, nodes.Template], source_name: t.Optional[str] = None
+    ) -> t.Iterator[t.Dict[str, t.Any]]:
+        if isinstance(source, str):
+            source = self.environment.parse(source)
+        for output in source.find_all(nodes.Output):
+            metadata = getattr(output, "trans_metadata", None)
+            if metadata is None:
+                continue
+            messages = [
+                {"lineno": lineno, "function": function, "message": message}
+                for lineno, function, message in extract_from_ast(output)
+            ]
+            yield {
+                "source": source_name,
+                "lineno": output.lineno,
+                "metadata": dict(metadata),
+                "messages": messages,
+            }
+
