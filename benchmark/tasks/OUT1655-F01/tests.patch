+def test_new_regex_types_are_composable_terms():
+    assert isinstance(types.hex_str, Regex)
+    assert isinstance(types.uuid4, Regex)
+    assert isinstance(types.ipv4, Regex)
+
+    combined = types.hex_str + ":" + types.ipv4
+    assert re.fullmatch(to_regex(combined), "0xCAFE:001.002.003.004") is not None
+
+
+def test_new_regex_types_validate_real_pydantic_fields_and_collections():
+    from pydantic import ValidationError
+
+    class Connection(BaseModel):
+        token: types.hex_str
+        address: types.ipv4
+        request_ids: list[types.uuid4]
+
+    valid = {"token": "0xCAFE", "address": "001.002.003.004",
+             "request_ids": ["123e4567-e89b-42d3-a456-426614174000"]}
+    assert Connection.model_validate(valid).model_dump() == valid
+    parsed = Connection.model_validate(valid)
+    assert Connection.model_validate_json(parsed.model_dump_json()) == parsed
+    for field, invalid in (("token", "0xZZ"), ("address", "256.2.3.4"),
+                           ("request_ids", ["123e4567-e89b-12d3-a456-426614174000"])):
+        with pytest.raises(ValidationError):
+            Connection.model_validate({**valid, field: invalid})
+
+
