@@ -0,0 +1,74 @@
+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+@pytest.mark.parametrize("name", ["hex_str", "uuid4", "ipv4"])
+def test_added_types_are_exported_regex_terms(name):
+    assert isinstance(getattr(types, name), Regex)
+
+
+@pytest.mark.parametrize(
+    "name,valid,invalid",
+    [
+        ("hex_str", ["0", "CAFE", "0x01aF"], ["", "0x", "0X12", " 12"]),
+        (
+            "uuid4",
+            [
+                "123e4567-e89b-42d3-a456-426614174000",
+                "123E4567-E89B-42D3-B456-426614174000",
+            ],
+            [
+                "123e4567-e89b-12d3-a456-426614174000",
+                "{123e4567-e89b-42d3-a456-426614174000}",
+            ],
+        ),
+        (
+            "ipv4",
+            ["0.0.0.0", "255.255.255.255", "000.001.025.255"],
+            ["256.1.2.3", "0256.1.2.3", "1.2.3", "1.2.3.4.5"],
+        ),
+    ],
+)
+def test_added_types_match_complete_values_in_dsl_and_schema(
+    name, valid, invalid
+):
+    custom_type = getattr(types, name)
+    class Model(BaseModel):
+        value: custom_type
+
+    patterns = [
+        to_regex(custom_type),
+        Model.model_json_schema()["properties"]["value"]["pattern"],
+    ]
+    for pattern in patterns:
+        assert all(re.fullmatch(pattern, value) for value in valid)
+        assert not any(re.fullmatch(pattern, value) for value in invalid)
+
+
+def test_added_types_validate_pydantic_fields_and_collections():
+    class Connection(BaseModel):
+        token: types.hex_str
+        address: types.ipv4
+        request_ids: list[types.uuid4]
+
+    valid = {
+        "token": "0xCAFE",
+        "address": "001.002.003.004",
+        "request_ids": ["123e4567-e89b-42d3-a456-426614174000"],
+    }
+    parsed = Connection.model_validate(valid)
+    assert parsed.model_dump() == valid
+    assert Connection.model_validate_json(parsed.model_dump_json()) == parsed
+    with pytest.raises(ValidationError):
+        Connection.model_validate({**valid, "address": "256.2.3.4"})
+
+
+def test_added_regex_terms_compose_with_existing_dsl_terms():
+    combined = types.hex_str + ":" + types.ipv4
+    assert re.fullmatch(to_regex(combined), "0xCAFE:001.002.003.004")
+    assert re.fullmatch(to_regex(combined), "0xCAFE:256.2.3.4") is None
