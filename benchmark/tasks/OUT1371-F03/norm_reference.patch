diff --git a/tests/test_prompt_conditional_filters.py b/tests/test_prompt_conditional_filters.py
new file mode 100644
index 00000000..cc175f1c
--- /dev/null
+++ b/tests/test_prompt_conditional_filters.py
@@ -0,0 +1,101 @@
+from pathlib import Path
+
+import jinja2
+import pytest
+
+import outlines
+from outlines.prompts import Prompt
+
+
+@pytest.fixture(autouse=True)
+def clean_condition_environment(monkeypatch):
+    for name in (
+        "OUTLINES_DEBUG",
+        "ENVIRONMENT",
+        "ENV",
+        "OUTLINES_TESTING",
+        "TESTING_MODE",
+    ):
+        monkeypatch.delenv(name, raising=False)
+
+
+def test_conditions_select_once_by_exact_value_and_priority(monkeypatch):
+    filters = {
+        "debug": {"active": lambda value: f"debug:{value}"},
+        "production": {"active": lambda value: f"production:{value}"},
+        "testing": {"active": lambda value: f"testing:{value}"},
+    }
+    monkeypatch.setenv("OUTLINES_DEBUG", "TRUE")
+    monkeypatch.setenv("ENVIRONMENT", "production")
+    prompt = Prompt.from_str("{{ value | active }}", conditional_filters=filters)
+    monkeypatch.setenv("OUTLINES_DEBUG", "false")
+
+    assert prompt(value="x") == "debug:x"
+
+    monkeypatch.setenv("ENVIRONMENT", "production-ish")
+    fallback = Prompt.from_str("{{ value | active }}", conditional_filters=filters)
+    assert fallback(value="x") == "debug:x"
+
+
+def test_conditional_filters_work_at_all_public_entrypoints(
+    monkeypatch, tmp_path: Path
+):
+    filters = {"testing": {"decorate": lambda value: f"<{value}>"}}
+    monkeypatch.setenv("TESTING_MODE", "ON")
+
+    @outlines.prompt(conditional_filters=filters)
+    def decorated(value="snow"):
+        """{{ value | decorate }}"""
+
+    include = tmp_path / "include.txt"
+    include.write_text("{{ value | decorate }}", encoding="utf-8")
+    path = tmp_path / "prompt.txt"
+    path.write_text('{% include "include.txt" %}', encoding="utf-8")
+
+    assert list(decorated.signature.parameters) == ["value"]
+    assert decorated() == "<snow>"
+    assert (
+        Prompt.from_str("{{ value | decorate }}", conditional_filters=filters)(
+            value="x"
+        )
+        == "<x>"
+    )
+    assert Prompt.from_file(path, conditional_filters=filters)(value="x") == "<x>"
+
+
+def test_unselected_filters_are_absent_and_selected_filters_override():
+    filters = {
+        "alpha": {"upper": lambda value: f"local:{value}"},
+        "zebra": {"zebra_only": str},
+    }
+    selected = Prompt.from_str("{{ value | upper }}", conditional_filters=filters)
+
+    assert selected(value="x") == "local:x"
+    with pytest.raises(jinja2.TemplateAssertionError, match="No filter named"):
+        Prompt.from_str("{{ value | zebra_only }}", conditional_filters=filters)
+
+
+def test_conditional_environment_keeps_existing_prompt_contracts(monkeypatch):
+    monkeypatch.setenv("ENV", "testing")
+    filters = {"testing": {"identity": lambda value: value}}
+    prompt = Prompt.from_str(
+        """
+        Heading
+            {{ value | identity }} / {{ missing }}
+
+        """,
+        conditional_filters=filters,
+    )
+
+    with pytest.raises(jinja2.UndefinedError):
+        prompt(value="snow")
+
+    rendered = Prompt.from_str(
+        """
+        Heading
+            {{ value | identity }}
+
+        """,
+        conditional_filters=filters,
+    )
+    assert rendered(value="snow") == "Heading\n    snow\n"
