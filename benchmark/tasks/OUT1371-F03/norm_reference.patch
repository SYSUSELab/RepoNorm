+def _select_conditional_filters(
+    conditional_filters: Optional[Dict[str, Dict[str, Callable]]],
+) -> Dict[str, Callable]:
+    if not conditional_filters:
+        return {}
+
+    active_conditions = []
+    if os.environ.get("OUTLINES_DEBUG", "").lower() == "true":
+        active_conditions.append("debug")
+    if os.environ.get("ENVIRONMENT", "").lower() == "production":
+        active_conditions.append("production")
+    if (
+        os.environ.get("ENV", "").lower() == "testing"
+        or os.environ.get("OUTLINES_TESTING", "").lower() == "true"
+        or os.environ.get("TESTING_MODE", "").lower() == "on"
+    ):
+        active_conditions.append("testing")
+
+    selected = next(
+        (name for name in active_conditions if name in conditional_filters),
+        sorted(conditional_filters)[0],
+    )
+    return dict(conditional_filters[selected])
+
+
+def _create_prompt_environment(
+    loader: Optional[jinja2.BaseLoader] = None,
+    conditional_filters: Optional[Dict[str, Dict[str, Callable]]] = None,
+) -> jinja2.Environment:
+    env = jinja2.Environment(
+        loader=loader,
+        trim_blocks=True,
+        lstrip_blocks=True,
+        keep_trailing_newline=True,
+        undefined=jinja2.StrictUndefined,
+    )
+    env.filters.update(
+        {
+            "name": get_fn_name,
+            "description": get_fn_description,
+            "source": get_fn_source,
+            "signature": get_fn_signature,
+            "schema": get_schema,
+            "args": get_fn_args,
+        }
+    )
+    env.filters.update(_select_conditional_filters(conditional_filters))
+    return env
+
