+def test_conditional_filters_across_public_entry_points(monkeypatch, tmp_path):
+    filters = {
+        "debug": {"active": lambda value: f"debug:{value}"},
+        "production": {"active": lambda value: f"production:{value}"},
+        "testing": {"active": lambda value: f"testing:{value}"},
+    }
+
+    monkeypatch.setenv("OUTLINES_DEBUG", "TRUE")
+
+    @outlines.prompt(conditional_filters=filters)
+    def decorated(value):
+        """{{ value | active }}"""
+
+    assert decorated("decorator") == "debug:decorator"
+
+    monkeypatch.delenv("OUTLINES_DEBUG")
+    monkeypatch.setenv("ENVIRONMENT", "Production")
+    assert (
+        Prompt.from_str("{{ value | active }}", conditional_filters=filters)(
+            value="string"
+        )
+        == "production:string"
+    )
+
+    monkeypatch.delenv("ENVIRONMENT")
+    monkeypatch.setenv("TESTING_MODE", "ON")
+    (tmp_path / "included.txt").write_text(
+        "{{ value | active }}", encoding="utf-8"
+    )
+    template_path = tmp_path / "prompt.txt"
+    template_path.write_text('{% include "included.txt" %}', encoding="utf-8")
+    assert (
+        Prompt.from_file(template_path, conditional_filters=filters)(value="file")
+        == "testing:file"
+    )
+
