+def test_conditional_filter_priority(monkeypatch):
+    filters = {
+        "debug": {"active": lambda value: "debug"},
+        "production": {"active": lambda value: "production"},
+        "testing": {"active": lambda value: "testing"},
+    }
+    monkeypatch.setenv("OUTLINES_DEBUG", "true")
+    monkeypatch.setenv("ENVIRONMENT", "production")
+    monkeypatch.setenv("ENV", "testing")
+
+    prompt = Prompt.from_str("{{ value | active }}", conditional_filters=filters)
+    assert prompt(value="ignored") == "debug"
+
+
+def test_conditional_filter_fallback_is_alphabetical():
+    filters = {
+        "zebra": {"active": lambda value: "zebra"},
+        "alpha": {"active": lambda value: "alpha"},
+    }
+
+    prompt = Prompt.from_str("{{ value | active }}", conditional_filters=filters)
+    assert prompt(value="ignored") == "alpha"
