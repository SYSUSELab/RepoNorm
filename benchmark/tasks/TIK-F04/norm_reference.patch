+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+@pytest.mark.parametrize(
+    "text,size,overlap,windows",
+    [
+        ("abcde", 3, 1, ["abc", "cde"]),
+        ("abcdef", 3, 1, ["abc", "cde", "ef"]),
+        ("你😀好呀", 2, 1, ["你😀", "😀好", "好呀"]),
+        ("", 3, 1, [""]),
+    ],
+)
+def test_character_windows(encoding, text, size, overlap, windows) -> None:
+    assert encoding.encode(text, chunk_size=size, chunk_overlap=overlap) == [
+        encoding.encode(window) for window in windows
+    ]
+
+
+@pytest.mark.parametrize(
+    "size,overlap",
+    [(0, 0), (-1, 0), (True, 0), (2.5, 0), (3, 3), (3, -1), (3, True), (None, 1)],
+)
+def test_invalid_chunk_options(encoding, size, overlap) -> None:
+    with pytest.raises(ValueError):
+        encoding.encode("text", chunk_size=size, chunk_overlap=overlap)
+
+
+def test_complete_input_special_policy_is_checked_before_chunking(encoding) -> None:
+    special = "<|endoftext|>"
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode(special, chunk_size=3, chunk_overlap=1)
+    actual = encoding.encode(
+        special, allowed_special="all", chunk_size=3, chunk_overlap=1
+    )
+    windows = ["<|e", "end", "dof", "fte", "ext", "t|>"]
+    assert actual == [encoding.encode(window, allowed_special="all") for window in windows]
+
+
+def test_nonchunked_default_and_surrogate_paths_are_unchanged(encoding) -> None:
+    assert isinstance(encoding.encode("ordinary"), list)
+    text = "before \ud800 after"
+    assert encoding.encode(text) == encoding.encode_batch([text])[0]
