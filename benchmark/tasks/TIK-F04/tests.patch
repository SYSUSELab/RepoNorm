+import pytest
+import tiktoken
+
+
+@pytest.mark.parametrize('text,size,overlap,windows', [
+    ('abcdef', 3, 1, ['abc', 'cde', 'ef']),
+    ('abcde', 3, 1, ['abc', 'cde']),
+    ('abcdef', 3, 0, ['abc', 'def']),
+    ('abcd', 3, 2, ['abc', 'bcd']),
+    ('你😀好呀', 2, 1, ['你😀', '😀好', '好呀']),
+    ('', 3, 1, ['']),
+    ('ab', 3, 1, ['ab']),
+])
+def test_character_windows(text, size, overlap, windows):
+    enc = tiktoken.get_encoding('cl100k_base')
+    assert enc.encode(text, chunk_size=size, chunk_overlap=overlap) == [enc.encode(w) for w in windows]
+
+
+@pytest.mark.parametrize('size,overlap', [(0, 0), (-1, 0), (True, 0), (2.5, 0), (3, 3), (3, -1), (3, True), (3, .5), (None, 1)])
+def test_invalid_windows(size, overlap):
+    enc = tiktoken.get_encoding('cl100k_base')
+    with pytest.raises(ValueError):
+        enc.encode('', chunk_size=size, chunk_overlap=overlap)
+
+
+def test_special_policy_before_windows():
+    enc = tiktoken.get_encoding('cl100k_base')
+    text = '<|endoftext|>'
+    with pytest.raises(ValueError):
+        enc.encode(text, chunk_size=3, chunk_overlap=1)
+    windows = ['<|e', 'end', 'dof', 'fte', 'ext', 't|>']
+    assert enc.encode(text, allowed_special='all', chunk_size=3, chunk_overlap=1) == [enc.encode(w, allowed_special='all') for w in windows]
