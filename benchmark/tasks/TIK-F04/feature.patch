+        start_pos = 0
+        text_length = len(text)
+ 
+        while start_pos < text_length:
+            # Determine the end position for the current chunk
+            end_pos = min(start_pos + chunk_size, text_length)
+ 
+            # Extract the current chunk
+            chunk_text = text[start_pos:end_pos]
