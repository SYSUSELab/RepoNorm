+    def _validate_required_if(self, ctx: Context) -> None:
+        """Validate conditional option requirements after all parameters are processed."""
+        params = self.get_params(ctx)
+        known_names = {param.name for param in params if param.name is not None}
+        for param in params:
+            if not isinstance(param, Option) or not param.name:
+                continue
+            condition = param.required_if
+            if callable(condition):
+                required = condition(ctx, param)
+            else:
+                if not condition:
+                    continue
+                unknown = set(condition).difference(known_names)
+                if unknown:
+                    names = ", ".join(sorted(unknown))
+                    raise UsageError(f"Unknown parameter in required_if: {names}", ctx=ctx)
+                required = all(ctx.params.get(name) == expected for name, expected in condition.items())
+            if required:
+                if param.value_is_missing(ctx.params.get(param.name)):
+                    raise MissingParameter(ctx=ctx, param=param)
+
