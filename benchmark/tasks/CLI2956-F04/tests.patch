+def test_required_if_predicate_threshold(runner):
+    seen = []
+    def needs_token(ctx, param):
+        seen.append((ctx.command.name, param.name, ctx.params["amount"]))
+        return ctx.params["amount"] > 10
+    @click.command()
+    @click.option("--token", required_if=needs_token)
+    @click.option("--amount", type=int, default=5)
+    def cli(token, amount):
+        click.echo(token or "none")
+    assert runner.invoke(cli).output == "none\n"
+    assert seen and all(item == ("cli", "token", 5) for item in seen)
+    seen.clear()
+    missing = runner.invoke(cli, ["--amount", "11"], standalone_mode=False)
+    assert isinstance(missing.exception, click.MissingParameter)
+    assert missing.exception.param.name == "token"
+    assert seen and all(item == ("cli", "token", 11) for item in seen)
+    seen.clear()
+    assert runner.invoke(cli, ["--amount", "11", "--token", "approved"]).output == "approved\n"
+    assert seen and all(item == ("cli", "token", 11) for item in seen)
+
+
+@pytest.mark.parametrize("source", ["commandline", "environment", "default_map"])
+def test_required_if_predicate_sees_processed_values(runner, source):
+    seen = []
+    def condition(ctx, param):
+        seen.append(ctx.params["amount"])
+        return ctx.params["amount"] > 10
+    @click.command()
+    @click.option("--token", required_if=condition)
+    @click.option("--amount", type=int, envvar="N4C_PREDICATE_AMOUNT",
+                  callback=lambda ctx, param, value: value * 2)
+    def cli(token, amount):
+        pass
+    args, kwargs = (["--amount", "6"], {}) if source == "commandline" else (
+        ([], {"env": {"N4C_PREDICATE_AMOUNT": "6"}}) if source == "environment"
+        else ([], {"default_map": {"amount": "6"}})
+    )
+    result = runner.invoke(cli, args, standalone_mode=False, **kwargs)
+    assert isinstance(result.exception, click.MissingParameter)
+    assert result.exception.param.name == "token"
+    assert seen and all(value == 12 for value in seen)
+
+
+@pytest.mark.parametrize("eager", ["version", "help"])
+def test_required_if_predicate_preserves_eager_exit(runner, eager):
+    seen = []
+    def condition(ctx, param):
+        seen.append(ctx.params["amount"])
+        return ctx.params["amount"] > 10
+    @click.command()
+    @click.option("--amount", type=int, default=5)
+    @click.option("--token", required_if=condition)
+    @click.version_option("1.0", prog_name="conditional-tool")
+    def cli(amount, token):
+        click.echo("normal invocation")
+    assert runner.invoke(cli).output == "normal invocation\n"
+    assert seen and all(value == 5 for value in seen)
+    seen.clear()
+    result = runner.invoke(cli, ["--amount", "invalid-integer", "--" + eager])
+    assert result.exit_code == 0, (result.output, result.exception)
+    assert ("conditional-tool, version 1.0" if eager == "version" else "--token") in result.output
+    assert "normal invocation" not in result.output
+    assert seen == []
