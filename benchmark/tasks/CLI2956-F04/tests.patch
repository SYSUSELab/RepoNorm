+@pytest.mark.parametrize("value", [[("mode", "x")], "mode"])
+def test_required_if_rejects_non_mapping(value):
+    with pytest.raises(TypeError) as error:
+        click.Option(["--target"], required_if=value)
+    assert str(error.value).strip()
+
+
+@pytest.mark.parametrize("value", [{"--mode": "x"}, {1: "x"}])
+def test_required_if_rejects_non_normalized_keys(value):
+    with pytest.raises(TypeError) as error:
+        click.Option(["--target"], required_if=value)
+    assert str(error.value).strip()
+
