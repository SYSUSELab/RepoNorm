+def test_required_if_preserves_eager_version_before_invalid_parameter(runner):
+    def show_version(ctx, param, value):
+        if value:
+            click.echo("tool version 1")
+            ctx.exit()
+
+    @click.command()
+    @click.option("--mode", type=int, default=1)
+    @click.option("--token", required_if={"mode": 1})
+    @click.option("--version", is_flag=True, is_eager=True, expose_value=False,
+                  callback=show_version)
+    def cli(mode, token):
+        pytest.fail("version request must not invoke the command")
+
+    result = runner.invoke(cli, ["--mode", "invalid-integer", "--version"])
+    assert result.exit_code == 0, (result.output, result.exception)
+    assert result.output == "tool version 1\n"
+
+
+def test_required_if_matches_final_converted_value(runner):
+    @click.command()
+    @click.option("--token", required_if={"mode": 2})
+    @click.option("--mode", type=int)
+    def cli(mode, token):
+        click.echo(token)
+
+    missing = runner.invoke(cli, ["--mode", "2"])
+    assert missing.exit_code == 2
+    assert "Missing option '--token'" in missing.output
+    assert runner.invoke(cli, ["--mode", "2", "--token", "ok"]).output == "ok\n"
+    assert runner.invoke(cli, ["--mode", "1"]).exit_code == 0
+
+
+def test_required_if_all_conditions_and_declaration_order(runner):
+    @click.command()
+    @click.option("--target", required_if={"left": "yes", "right": 3})
+    @click.option("--left", default="yes")
+    @click.option("--right", type=int, envvar="RIGHT")
+    def cli(target, left, right):
+        pass
+
+    assert runner.invoke(cli, env={"RIGHT": "3"}).exit_code == 2
+    assert runner.invoke(cli, ["--target", "ok"], env={"RIGHT": "3"}).exit_code == 0
+    assert runner.invoke(cli, ["--right", "4"]).exit_code == 0
+
+
+def test_required_if_target_default_is_present(runner):
+    @click.command()
+    @click.option("--target", default="fallback", required_if={"enabled": True})
+    @click.option("--enabled/--disabled", default=True)
+    def cli(target, enabled):
+        click.echo(target)
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0
+    assert result.output == "fallback\n"
+
+
+def test_required_if_none_condition(runner):
+    @click.command()
+    @click.option("--target", required_if={"other": None})
+    @click.option("--other")
+    def cli(target, other):
+        pass
+
+    assert runner.invoke(cli).exit_code == 2
+    assert runner.invoke(cli, ["--other", "x"]).exit_code == 0
+
