+def test_required_if_unknown_name_is_configuration_error(runner):
+    @click.command()
+    @click.option("--target", required_if={"typo": "x"})
+    def cli(target):
+        pass
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert isinstance(result.exception, click.UsageError)
+    assert str(result.exception).strip()
