diff --git a/tests/test_groupby_counts_contribution.py b/tests/test_groupby_counts_contribution.py
new file mode 100644
index 00000000..8ad2de30
--- /dev/null
+++ b/tests/test_groupby_counts_contribution.py
@@ -0,0 +1,80 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import StrictUndefined
+from jinja2 import UndefinedError
+
+
+def test_counted_groups_expose_tuple_and_named_fields():
+    env = Environment()
+    rows = [{"kind": "b"}, {"kind": "a"}, {"kind": "b"}]
+
+    groups = env.call_filter("groupby", iter(rows), ["kind"], {"with_counts": True})
+
+    assert [(g.grouper, g.list, g.count) for g in groups] == [
+        ("a", [rows[1]], 1),
+        ("b", [rows[0], rows[2]], 2),
+    ]
+    assert tuple(groups[1]) == ("b", [rows[0], rows[2]], 2)
+    assert groups[1][2] == 2
+    assert repr(groups[1]) == repr(("b", [rows[0], rows[2]], 2))
+    legacy = env.call_filter("groupby", rows, ["kind"])[0]
+    assert len(legacy) == 2
+    assert callable(legacy.count)
+
+
+def test_count_is_snapshot_of_materialized_members():
+    env = Environment()
+    groups = env.call_filter(
+        "groupby", [{"kind": "a"}], ["kind"], {"with_counts": True}
+    )
+
+    groups[0].list.append({"kind": "a"})
+
+    assert groups[0].count == 1
+    assert len(groups[0].list) == 2
+
+
+def test_counts_use_environment_lookup_and_default():
+    class UpperKeyEnvironment(Environment):
+        def getitem(self, obj, argument):
+            if argument == "kind" and argument in obj:
+                return obj[argument].upper()
+
+            return super().getitem(obj, argument)
+
+    env = UpperKeyEnvironment()
+    rows = [{"kind": "a"}, {}, {"kind": "A"}]
+    groups = env.call_filter(
+        "groupby",
+        rows,
+        ["kind"],
+        {"default": "missing", "with_counts": True},
+    )
+
+    assert [(g.grouper, g.count) for g in groups] == [("A", 2), ("missing", 1)]
+
+
+def test_counts_propagate_strict_undefined_comparison():
+    env = Environment(undefined=StrictUndefined)
+
+    with pytest.raises(UndefinedError):
+        env.call_filter("groupby", [{}, {}], ["kind"], {"with_counts": True})
+
+
+def test_counts_async_accepts_async_input():
+    async def stream():
+        for row in [{"kind": "a"}, {"kind": "a"}]:
+            yield row
+
+    async def run():
+        env = Environment(enable_async=True)
+        return await env.call_filter(
+            "groupby", stream(), ["kind"], {"with_counts": True}
+        )
+
+    groups = asyncio.run(run())
+
+    assert [(g.grouper, g.count, len(g.list)) for g in groups] == [("a", 2, 2)]
