+    When ``with_counts`` is ``True``, the filter returns tuples of
+    ``(grouper, list, count)`` instead of ``(grouper, list)``.
+
+    .. sourcecode:: html+jinja
+
+        <ul>{% for city, items, count in users|groupby("city", with_counts=true) %}
+          <li>{{ city }} ({{ count }} users)
+            <ul>{% for user in items %}
+              <li>{{ user.name }}
+            {% endfor %}</ul>
+          </li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,10 +1230,17 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
-        _GroupTuple(key, list(values))
-        for key, values in groupby(sorted(value, key=expr), expr)
-    ]
+    if with_counts:
+        result = []
+        for key, values in groupby(sorted(value, key=expr), expr):
+            items = list(values)
+            result.append(_CountedGroupTuple(key, items, len(items)))
+        return result
+    else:
+        return [
+            _GroupTuple(key, list(values))
+            for key, values in groupby(sorted(value, key=expr), expr)
+        ]
 
 
