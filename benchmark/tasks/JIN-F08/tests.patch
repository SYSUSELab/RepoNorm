+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_counted_group_interface(asynchronous):
+    import asyncio
+    from jinja2 import Environment
+    env = Environment(enable_async=asynchronous)
+    rows = [{"p": [{"k": 2}]}, {}, {"p": [{"k": 2}]}]
+    async def stream():
+        for row in rows:
+            yield row
+    result = env.call_filter("groupby", stream() if asynchronous else iter(rows), ["p.0.k"], {"default": 1, "with_counts": True})
+    if asynchronous:
+        result = asyncio.run(result)
+    assert [(g.grouper, g.list, g.count) for g in result] == [(1, [rows[1]], 1), (2, [rows[0], rows[2]], 2)]
+    assert tuple(result[1]) == (2, [rows[0], rows[2]], 2)
+    assert result[1][2] == 2
+    result[1].list.append({})
+    assert result[1].count == 2
+    template = env.from_string('{% for g in rows|groupby("p.0.k", default=1, with_counts=true) %}{{g.grouper}}:{{g.count}}:{{g.list|length}};{% endfor %}')
+    assert template.render(rows=rows) == "1:1:1;2:2:2;"
+    legacy = env.call_filter("groupby", [(1,), (1,)], [0])
+    if asynchronous:
+        legacy = asyncio.run(legacy)
+    assert len(legacy[0]) == 2 and callable(legacy[0].count)
