+def test_prompt_from_str_without_custom_filters():
+    assert Prompt.from_str("{{ value | upper }}", filters=None)(value="text") == "TEXT"
+    assert Prompt.from_str("{{ value | upper }}", filters={})(value="text") == "TEXT"
+
+
+@pytest.mark.parametrize("entrypoint", ["decorator", "from_str", "from_file"])
+def test_custom_filter_prompts_preserve_undefined_errors(entrypoint, tmp_path):
+    import jinja2
+
+    def build(body):
+        filters = {"tag": lambda value: "<" + value + ">"}
+        if entrypoint == "from_str":
+            return Prompt.from_str(body, filters=filters)
+        if entrypoint == "from_file":
+            (tmp_path / "body.txt").write_text(body, encoding="utf-8")
+            path = tmp_path / "prompt.txt"
+            path.write_text('{% include "body.txt" %}', encoding="utf-8")
+            return Prompt.from_file(path, filters=filters)
+        def template(value):
+            pass
+        template.__doc__ = body
+        return outlines.prompt(filters=filters)(template)
+
+    assert build("{{ value | tag }}")(value="snow") == "<snow>"
+    with pytest.raises(jinja2.UndefinedError):
+        build("{{ value | tag }} / {{ missing }}")(value="snow")
+    assert build('{{ value | tag }} / {{ missing | default("fallback") }}')(
+        value="snow"
+    ) == "<snow> / fallback"
+
+
+def test_with_filters_derives_independent_prompts():
+    original = Prompt.from_str(
+        '{{ "fixed" | upper }} / {{ value | tag("!") }}',
+        filters={"tag": lambda value, suffix: value + suffix},
+    )
+    overrides = {"upper": lambda value: "local:" + value}
+    derived = original.with_filters(overrides)
+    sibling = original.with_filters({"upper": lambda value: "other:" + value})
+    chained = derived.with_filters({"tag": lambda value, suffix: suffix + value})
+    overrides["upper"] = lambda value: "changed"
+    assert original(value="x") == "FIXED / x!"
+    assert derived(value="x") == "local:fixed / x!"
+    assert sibling(value="x") == "other:fixed / x!"
+    assert chained(value="x") == "local:fixed / !x"
+    assert isinstance(derived, Prompt)
+    assert derived is not original
+
+
