+def test_prompt_with_additional_filters():
+    def tagged(s: str, prefix: str) -> str:
+        return f"{prefix}:{s}"
+
+    @outlines.prompt(filters={"tagged": tagged})
+    def test_tpl(variable):
+        """{{ variable | tagged("value") }} test"""
+
+    assert list(test_tpl.signature.parameters) == ["variable"]
+
+    p = test_tpl("test")
+    assert p == "value:test test"
+
+    p = test_tpl(variable="example")
+    assert p == "value:example test"
+
