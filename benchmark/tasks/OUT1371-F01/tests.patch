+def test_custom_filters_override_existing_filters():
+    def local_upper(value):
+        return f"local-upper:{value}"
+
+    def local_name(value):
+        return f"local-name:{value}"
+
+    prompt = Prompt.from_str(
+        "{{ value | upper }} / {{ value | name }}",
+        filters={"upper": local_upper, "name": local_name},
+    )
+
+    assert prompt(value="example") == "local-upper:example / local-name:example"
+
