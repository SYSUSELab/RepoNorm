+def test_with_filters_preserves_decorated_signature_and_format():
+    @outlines.prompt
+    def original(value="snow", suffix="!"):
+        """
+        Heading
+            {{ value | upper }}{{ suffix }}
+
+        """
+
+    derived = original.with_filters({"upper": lambda value: "<" + value + ">"})
+    assert derived() == "Heading\n    <snow>!\n"
+    assert derived("rain", suffix="?") == "Heading\n    <rain>?\n"
+    assert original() == "Heading\n    SNOW!\n"
+    with pytest.raises(TypeError):
+        derived(unexpected="x")
+    from_str = Prompt.from_str("""
+        Heading
+            {{ value | upper }}
+
+        """).with_filters({"upper": lambda value: "<" + value + ">"})
+    assert from_str(value="snow") == "Heading\n    <snow>\n"
+
