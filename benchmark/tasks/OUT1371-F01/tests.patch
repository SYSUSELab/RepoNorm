+def test_with_filters_preserves_file_includes_and_inheritance(tmp_path):
+    (tmp_path / "base.txt").write_text("{% block body %}{% endblock %}", encoding="utf-8")
+    (tmp_path / "body.txt").write_text('{{ "fixed" | upper }} / {{ value | upper }}', encoding="utf-8")
+    path = tmp_path / "child.txt"
+    path.write_text('{% extends "base.txt" %}{% block body %}{% include "body.txt" %}{% endblock %}', encoding="utf-8")
+    original = Prompt.from_file(path)
+    assert original(value="snow") == "FIXED / SNOW"
+    derived = original.with_filters({"upper": lambda value: "<" + value + ">"})
+    assert derived(value="snow") == "<fixed> / <snow>"
+    assert original(value="snow") == "FIXED / SNOW"
+
