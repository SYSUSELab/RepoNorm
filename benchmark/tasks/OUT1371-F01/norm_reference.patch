diff --git a/tests/test_prompt_custom_filters.py b/tests/test_prompt_custom_filters.py
new file mode 100644
index 00000000..4c8425d0
--- /dev/null
+++ b/tests/test_prompt_custom_filters.py
@@ -0,0 +1,76 @@
+from pathlib import Path
+
+import jinja2
+import pytest
+
+import outlines
+from outlines.prompts import Prompt
+
+
+def test_custom_filters_work_at_each_public_entrypoint(tmp_path: Path):
+    filters = {"tag": lambda value, mark: f"{mark}{value}{mark}"}
+
+    @outlines.prompt(filters=filters)
+    def decorated(value):
+        """{{ value | tag("!") }}"""
+
+    path = tmp_path / "prompt.txt"
+    path.write_text('{{ value | tag("!") }}', encoding="utf-8")
+
+    assert decorated("x") == "!x!"
+    from_str = Prompt.from_str('{{ value | tag("!") }}', filters=filters)
+    assert from_str(value="x") == "!x!"
+    assert Prompt.from_file(path, filters=filters)(value="x") == "!x!"
+
+
+def test_derived_filters_are_chained_and_isolated():
+    original = Prompt.from_str("{{ value | upper }}")
+    derived = original.with_filters({"upper": lambda value: f"<{value}>"})
+    chained = derived.with_filters({"upper": lambda value: f"[{value}]"})
+
+    assert original(value="x") == "X"
+    assert derived(value="x") == "<x>"
+    assert chained(value="x") == "[x]"
+
+
+def test_derived_decorated_prompt_preserves_signature_and_defaults():
+    @outlines.prompt
+    def original(value="snow", suffix="!"):
+        """{{ value | upper }}{{ suffix }}"""
+
+    derived = original.with_filters({"upper": lambda value: f"<{value}>"})
+
+    assert list(derived.signature.parameters) == ["value", "suffix"]
+    assert derived() == "<snow>!"
+    assert derived("rain", suffix="?") == "<rain>?"
+    with pytest.raises(TypeError):
+        derived(unexpected="x")
+
+
+def test_custom_and_derived_prompts_keep_strict_undefined():
+    prompt = Prompt.from_str("{{ missing }}", filters={"tag": str})
+    derived = prompt.with_filters({"tag": repr})
+
+    with pytest.raises(jinja2.UndefinedError):
+        prompt()
+    with pytest.raises(jinja2.UndefinedError):
+        derived()
+
+
+def test_derived_file_prompt_keeps_relative_loading(tmp_path: Path):
+    (tmp_path / "base.txt").write_text(
+        "{% block body %}{% endblock %}", encoding="utf-8"
+    )
+    (tmp_path / "body.txt").write_text("{{ value | decorate }}", encoding="utf-8")
+    child = tmp_path / "child.txt"
+    child.write_text(
+        '{% extends "base.txt" %}'
+        '{% block body %}{% include "body.txt" %}{% endblock %}',
+        encoding="utf-8",
+    )
+
+    original = Prompt.from_file(child, filters={"decorate": str.upper})
+    derived = original.with_filters({"decorate": lambda value: f"<{value}>"})
+
+    assert original(value="snow") == "SNOW"
+    assert derived(value="snow") == "<snow>"
