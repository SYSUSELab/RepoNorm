@@ -1139,3 +1139,120 @@ def test_duplicate_names_warning(runner, opts_one, opts_two):
 
     with pytest.warns(UserWarning):
         runner.invoke(cli, [])
+
+
+def test_dynamic_default_preserves_nested_default_map(runner):
+    received = []
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.group()
+    def service():
+        pass
+
+    @service.command()
+    @click.option("--protocol", default="http")
+    @click.option("--port", type=int, default={"--protocol": {"http": 80}})
+    def start(protocol, port):
+        ctx = click.get_current_context()
+        received.append((port, ctx.get_parameter_source("port")))
+
+    result = runner.invoke(cli, ["service", "start"],
+                           default_map={"service": {"start": {"port": "9090"}}})
+    assert result.exit_code == 0, (result.output, result.exception)
+    assert received == [(9090, click.core.ParameterSource.DEFAULT_MAP)]
+
+
+def test_dynamic_default_after_dependencies_and_target_pipeline(runner):
+    callbacks = []
+    def callback(ctx, param, value):
+        callbacks.append(value)
+        return value + 1
+    @click.command()
+    @click.option("--port", type=int, callback=callback, default={"--protocol": {"https": "443"}})
+    @click.option("--protocol", default="https")
+    def cli(port, protocol): click.echo(port)
+    result = runner.invoke(cli)
+    assert result.exit_code == 0 and result.output == "444\n"
+    assert callbacks == [443]
+
+
+def test_dynamic_default_later_match_wins_and_boolean_string(runner):
+    @click.command()
+    @click.option("--level", default={"--env": {"dev": "INFO"}, "--debug": {"True": "DEBUG"}})
+    @click.option("--debug/--no-debug", default=True)
+    @click.option("--env", default="dev")
+    def cli(level, debug, env): click.echo(level)
+    assert runner.invoke(cli).output == "DEBUG\n"
+
+
+def test_dynamic_default_explicit_target_sources_win(runner):
+    @click.command(context_settings={"default_map": {"port": 81}})
+    @click.option("--port", type=int, envvar="PORT", default={"--protocol": {"http": 80}})
+    @click.option("--protocol", default="http")
+    def cli(port, protocol): click.echo(port)
+    assert runner.invoke(cli, env={"PORT": "82"}).output == "82\n"
+    assert runner.invoke(cli, ["--port", "83"], env={"PORT": "82"}).output == "83\n"
+
+
+def test_dynamic_default_no_match_processes_none_once(runner):
+    calls = []
+    def callback(ctx, param, value): calls.append(value); return "fallback" if value is None else value
+    @click.command()
+    @click.option("--target", callback=callback, default={"--mode": {"yes": "chosen"}})
+    @click.option("--mode", default="no")
+    def cli(target, mode): click.echo(target)
+    assert runner.invoke(cli).output == "fallback\n"
+    assert calls == [None]
+
+
+def test_dynamic_default_preserves_static_dict_default(runner):
+    class DictType(click.ParamType):
+        name = "dict"
+        def convert(self, value, param, ctx): return value
+    value = {"ordinary": {"nested": 1}, 2: "also ordinary"}
+    @click.command()
+    @click.option("--config", type=DictType(), default=value)
+    def cli(config): assert config == value
+    assert runner.invoke(cli).exit_code == 0
+
+
+def test_dynamic_default_unknown_and_cycle_are_errors(runner):
+    @click.command()
+    @click.option("--target", default={"--missing": {"x": "y"}})
+    def unknown(target):
+        pytest.fail("An unknown default dependency must stop the command.")
+    result = runner.invoke(unknown, standalone_mode=False)
+    assert result.exit_code != 0
+    assert isinstance(result.exception, click.UsageError)
+    assert str(result.exception).strip()
+
+    @click.command()
+    @click.option("--left", default={"--right": {"None": "x"}})
+    @click.option("--right", default={"--left": {"None": "y"}})
+    def cycle(left, right):
+        pytest.fail("Cyclic default dependencies must stop the command.")
+    result = runner.invoke(cycle, standalone_mode=False)
+    assert result.exit_code != 0
+    assert isinstance(result.exception, click.UsageError)
+    assert str(result.exception).strip()
+
+
+def test_dynamic_default_invalid_mapping_value(runner):
+    with pytest.raises(TypeError):
+        option = click.Option(["--target"], default={"--mode": "bad"})
+        mode = click.Option(["--mode"], default="http")
+        command = click.Command("cli", params=[mode, option])
+        runner.invoke(command, catch_exceptions=False)
+
+
+def test_dynamic_default_help_marker(runner):
+    @click.command()
+    @click.option("--port", show_default=True, default={"--protocol": {"http": 80}})
+    @click.option("--protocol", default="http")
+    def cli(port, protocol): pass
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "--port" in result.output and "[default: (dynamic)]" in result.output
