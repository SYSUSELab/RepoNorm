+def test_python_call_parser_nested_literals_and_dotted_names():
+    from dspy.adapters.types.tool import parse_python_calls
+    text = 'tools.search(data={"items": (1, -2.5, True, None, ["#雪", (+3,)])}); done()'
+    expected = {"tool_calls": [
+        {"name": "search", "args": {"data": {"items": [1, -2.5, True, None, ["#雪", [3]]]}}},
+        {"name": "done", "args": {}},
+    ]}
+    assert parse_python_calls(text) == expected
+    result = ToolCalls.model_validate(text)
+    assert [(call.name, call.args) for call in result.tool_calls] == [
+        (entry["name"], entry["args"]) for entry in expected["tool_calls"]
+    ]
+
