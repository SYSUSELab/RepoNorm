diff --git a/tests/backends/test_xgrammar_contribution.py b/tests/backends/test_xgrammar_contribution.py
new file mode 100644
index 00000000..fb03a564
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,73 @@
+from unittest.mock import Mock
+
+import pytest
+import torch
+import xgrammar as xgr
+
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+from outlines.processors.tensor_adapters.torch import TorchTensorAdapter
+
+
+class RecordingAdapter(TorchTensorAdapter):
+    def __init__(self):
+        super().__init__()
+        self.shapes = []
+
+    def shape(self, tensor):
+        self.shapes.append(tuple(tensor.shape))
+        return super().shape(tensor)
+
+
+@pytest.fixture
+def passthrough_wrapper(monkeypatch):
+    class PassthroughProcessor:
+        def __init__(self, grammar):
+            self.grammar = grammar
+
+        def __call__(self, input_ids, logits):
+            return logits
+
+    monkeypatch.setattr(xgr.contrib.hf, "LogitsProcessor", PassthroughProcessor)
+
+
+def test_custom_adapter_is_used_by_public_shape_path(passthrough_wrapper):
+    adapter = RecordingAdapter()
+    processor = XGrammarLogitsProcessor(
+        object(), tensor_library_name="custom", custom_adapter=adapter
+    )
+
+    one = processor(torch.tensor([1]), torch.zeros(4))
+    two = processor(torch.tensor([[1], [1]]), torch.zeros(2, 4))
+
+    assert processor.tensor_adapter is adapter
+    assert one.shape == (4,)
+    assert two.shape == (2, 4)
+    assert (4,) in adapter.shapes and (2, 4) in adapter.shapes
+
+
+def test_custom_adapter_parameter_combinations_are_validated():
+    adapter = RecordingAdapter()
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor(object(), tensor_library_name="custom")
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor(object(), custom_adapter=adapter)
+
+
+def test_all_backend_factories_forward_custom_adapter():
+    backend = object.__new__(XGrammarBackend)
+    backend.grammar_compiler = Mock()
+    adapter = RecordingAdapter()
+    processors = [
+        backend.get_json_schema_logits_processor(
+            "{}", tensor_library_name="custom", custom_adapter=adapter
+        ),
+        backend.get_regex_logits_processor(
+            "a", tensor_library_name="custom", custom_adapter=adapter
+        ),
+        backend.get_cfg_logits_processor(
+            'root ::= "a"',
+            tensor_library_name="custom",
+            custom_adapter=adapter,
+        ),
+    ]
+    assert all(processor.tensor_adapter is adapter for processor in processors)
