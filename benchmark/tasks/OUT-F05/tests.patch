+@pytest.mark.parametrize("factory,grammar", [
+    ("get_regex_logits_processor", "a|b"),
+    ("get_cfg_logits_processor", 'root ::= "a" | "b"'),
+    ("get_json_schema_logits_processor", '{"type":"string","enum":["a","b"]}'),
+])
+@pytest.mark.parametrize("shape", ["1d", "2d", "mixed"])
+def test_v5_custom_adapter_real_shapes(model_transformers, factory, grammar, shape):
+    import torch
+    from outlines.processors.tensor_adapters.torch import TorchTensorAdapter
+    class RecordingAdapter(TorchTensorAdapter):
+        def __init__(self):
+            super().__init__()
+            self.observed = []
+        def shape(self, tensor):
+            self.observed.append(tuple(tensor.shape))
+            return super().shape(tensor)
+    adapter = RecordingAdapter()
+    backend = XGrammarBackend(model_transformers)
+    method = getattr(backend, factory)
+    processor = method(grammar, tensor_library_name="custom", custom_adapter=adapter)
+    vocab = model_transformers.model.config.vocab_size
+    ids = torch.tensor([1]) if shape != "2d" else torch.tensor([[1], [1]])
+    scores = torch.zeros(vocab) if shape == "1d" else torch.zeros(1 if shape == "mixed" else 2, vocab)
+    for _ in range(2):
+        adapter.observed.clear()
+        result = processor(ids, scores.clone())
+        assert result.shape == scores.shape
+        assert torch.isfinite(result).any() and torch.isneginf(result).any()
+        assert tuple(ids.shape) in adapter.observed
+        assert tuple(scores.shape) in adapter.observed
+        processor.reset()
+    for library, selected in [("custom", None), ("torch", adapter)]:
+        with pytest.raises(ValueError):
+            method(grammar, tensor_library_name=library, custom_adapter=selected)
+
