+def test_option_history_keeps_hidden_option_and_callback_injection(runner):
+    received = []
+
+    def inject(ctx, param, value):
+        ctx.params["derived"] = value.upper()
+        return value
+
+    @click.command(track_changes=True)
+    @click.option("--secret", expose_value=False, callback=inject)
+    @click.option("--count", type=int, default=2)
+    def cli(count, derived):
+        ctx = click.get_current_context()
+        assert "secret" not in ctx.params
+        assert ctx.get_option_history("--secret") == []
+        assert ctx.get_option_history("derived") == []
+        history = ctx.get_option_history("count")
+        assert [entry["value"] for entry in history] == [2]
+        assert history[0]["source"] is click.core.ParameterSource.DEFAULT
+        received.append((count, derived))
+
+    result = runner.invoke(cli, ["--secret", "alpha"])
+    assert result.exit_code == 0, (result.output, result.exception)
+    assert received == [(2, "ALPHA")]
+
+
+def test_option_history_disabled_by_default(runner):
+    @click.command()
+    @click.option("-c", "--count", default=1)
+    def cli(count):
+        assert click.get_current_context().get_option_history("count") is None
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0, result.output
+
