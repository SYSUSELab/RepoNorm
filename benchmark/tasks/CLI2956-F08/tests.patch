+def test_option_history_group_and_subcommand_contexts_are_independent(runner):
+    parent_history = []
+    child_history = []
+    cross_context_results = []
+
+    @click.group(track_changes=True)
+    @click.option("--verbose", is_flag=True)
+    def cli(verbose):
+        ctx = click.get_current_context()
+        parent_history.extend(ctx.get_option_history("--verbose"))
+        cross_context_results.append(ctx.get_option_history("--count"))
+
+    @cli.command(track_changes=True)
+    @click.option("-c", "--count", type=int, default=1)
+    def child(count):
+        ctx = click.get_current_context()
+        child_history.extend(ctx.get_option_history("-c"))
+        cross_context_results.append(ctx.get_option_history("--verbose"))
+
+    result = runner.invoke(cli, ["--verbose", "child", "--count", "5"])
+    assert result.exit_code == 0, result.output
+    assert len(parent_history) == len(child_history) == 1
+    assert parent_history[0]["value"] is True
+    assert child_history[0]["value"] == 5
+    assert cross_context_results == [[], []]
+
+
+def test_option_history_is_fresh_for_each_invocation(runner):
+    histories = []
+
+    @click.command(track_changes=True)
+    @click.option("--count", type=int, default=1)
+    def cli(count):
+        histories.append(click.get_current_context().get_option_history("count"))
+
+    first = runner.invoke(cli)
+    second = runner.invoke(cli, ["--count", "9"])
+    assert first.exit_code == second.exit_code == 0
+    assert [len(history) for history in histories] == [1, 1]
+    assert [history[0]["value"] for history in histories] == [1, 9]
+    assert histories[0][0]["source"] is click.core.ParameterSource.DEFAULT
+    assert histories[1][0]["source"] is click.core.ParameterSource.COMMANDLINE
+
+
+def test_option_history_appends_later_context_assignments(runner):
+    snapshots = []
+
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", type=int, default=1)
+    def cli(count):
+        ctx = click.get_current_context()
+        snapshots.append(ctx.get_option_history("--count"))
+        ctx.params["count"] = 2
+        ctx.params["count"] = 3
+        snapshots.append(ctx.get_option_history("-c"))
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0, result.output
+    assert [entry["value"] for entry in snapshots[0]] == [1]
+    assert [entry["value"] for entry in snapshots[1]] == [1, 2, 3]
+    assert [entry["source"] for entry in snapshots[1]] == [
+        click.core.ParameterSource.DEFAULT,
+        None,
+        None,
+    ]
+
+
+def test_option_history_result_cannot_mutate_context_records(runner):
+    observed = []
+
+    @click.command(track_changes=True)
+    @click.option("--count", type=int, default=1)
+    def cli(count):
+        ctx = click.get_current_context()
+        first = ctx.get_option_history("count")
+        first[0]["value"] = 999
+        first.append({"value": 1000})
+        observed.extend(ctx.get_option_history("count"))
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0, result.output
+    assert len(observed) == 1
+    assert observed[0]["value"] == 1
