+def test_option_history_accepts_parameter_name_and_option_spellings(runner):
+    observed = []
+
+    @click.command(track_changes=True)
+    @click.option("-c", "--count", type=int, default=1)
+    def cli(count):
+        ctx = click.get_current_context()
+        by_name = ctx.get_option_history("count")
+        by_long_option = ctx.get_option_history("--count")
+        by_short_option = ctx.get_option_history("-c")
+        observed.extend((by_name, by_long_option, by_short_option))
+
+        assert ctx.get_option_history("--missing") == []
+
+    result = runner.invoke(cli, ["-c", "5"])
+    assert result.exit_code == 0, result.output
+    assert observed[0] == observed[1] == observed[2]
+    assert observed[0] is not observed[1]
+    assert observed[0] == [
+        {
+            "value": 5,
+            "source": click.core.ParameterSource.COMMANDLINE,
+            "timestamp": observed[0][0]["timestamp"],
+        }
+    ]
+    assert isinstance(observed[0][0]["timestamp"], float)
+    assert observed[0][0]["timestamp"] > 0
+
+
+@pytest.mark.parametrize(
+    ("invoke_kwargs", "expected_value", "expected_source"),
+    [
+        ({}, 1, click.core.ParameterSource.DEFAULT),
+        (
+            {"default_map": {"count": "2"}},
+            2,
+            click.core.ParameterSource.DEFAULT_MAP,
+        ),
+        (
+            {"env": {"CLICK_HISTORY_COUNT": "3"}},
+            3,
+            click.core.ParameterSource.ENVIRONMENT,
+        ),
+        (
+            {"args": ["--count", "4"]},
+            4,
+            click.core.ParameterSource.COMMANDLINE,
+        ),
+    ],
+)
+def test_option_history_records_final_value_and_winning_source(
+    runner, invoke_kwargs, expected_value, expected_source
+):
+    observed = []
+
+    @click.command(track_changes=True)
+    @click.option("--count", type=int, envvar="CLICK_HISTORY_COUNT", default=1)
+    def cli(count):
+        observed.extend(click.get_current_context().get_option_history("count"))
+
+    result = runner.invoke(cli, **invoke_kwargs)
+    assert result.exit_code == 0, result.output
+    assert len(observed) == 1
+    assert observed[0]["value"] == expected_value
+    assert observed[0]["source"] is expected_source
+
+
