diff --git a/tests/streaming/test_streaming.py b/tests/streaming/test_streaming.py
index fe67bd6..ed706a7 100644
--- a/tests/streaming/test_streaming.py
+++ b/tests/streaming/test_streaming.py
@@ -837,3 +837,72 @@ async def test_stream_listener_returns_correct_chunk_xml_adapter():
     assert all_chunks[1].predict_name == "predict2"
     assert all_chunks[1].signature_field_name == "judgement"
     assert all_chunks[1].chunk == "The answer is humorous."
+
+def _feature1_model_chunk(content):
+    return ModelResponseStream(
+        model="test", choices=[StreamingChoices(delta=Delta(content=content))]
+    )
+
+
+def test_stream_response_last_chunk_defaults_to_false():
+    response = dspy.streaming.StreamResponse("predict", "answer", "value")
+    assert response.is_last_chunk is False
+
+
+def test_receive_marks_only_the_final_emitted_chunk():
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer", predict_name="predict"
+    )
+    responses = []
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(_feature1_model_chunk("[[ ## answer ## ]]\n"))
+        for index in range(11):
+            response = listener.receive(_feature1_model_chunk(str(index)))
+            if response is not None:
+                responses.append(response)
+        responses.append(
+            listener.receive(_feature1_model_chunk("[[ ## completed ## ]]"))
+        )
+
+    assert "".join(response.chunk for response in responses) == "012345678910"
+    assert [response.is_last_chunk for response in responses] == [False, True]
+
+
+@pytest.mark.parametrize(
+    "adapter,message,expected",
+    [
+        (
+            dspy.ChatAdapter(),
+            "[[ ## answer ## ]]\ncached value\n\n[[ ## completed ## ]]",
+            "cached value",
+        ),
+        (dspy.JSONAdapter(), '{"answer":"cached value","other":"x"}', "cached value"),
+        (dspy.XMLAdapter(), "<answer>cached value</answer>", "cached value"),
+    ],
+)
+def test_cache_hit_emits_actual_content_as_one_final_response(
+    adapter, message, expected
+):
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer",
+        predict_name="predict",
+        allow_reuse=True,
+    )
+    chunk = _feature1_model_chunk(message)
+    with dspy.context(adapter=adapter):
+        first = listener.receive(chunk)
+        second = listener.receive(chunk)
+
+    assert first.chunk == expected
+    assert first.is_last_chunk is True
+    assert second.chunk == expected
+    assert second.is_last_chunk is True
+
+
+def test_cache_hit_for_another_field_emits_nothing():
+    listener = dspy.streaming.StreamListener(signature_field_name="answer")
+    chunk = _feature1_model_chunk(
+        "[[ ## other ## ]]value[[ ## completed ## ]]"
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        assert listener.receive(chunk) is None
