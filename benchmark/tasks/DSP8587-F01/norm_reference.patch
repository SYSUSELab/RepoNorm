diff --git a/tests/streaming/test_last_chunk_contribution.py b/tests/streaming/test_last_chunk_contribution.py
new file mode 100644
index 000000000..884b034c4
--- /dev/null
+++ b/tests/streaming/test_last_chunk_contribution.py
@@ -0,0 +1,26 @@
+from litellm.types.utils import Delta, ModelResponseStream, StreamingChoices
+
+import dspy
+
+
+def chunk(content):
+    return ModelResponseStream(model="test", choices=[StreamingChoices(delta=Delta(content=content))])
+
+
+def test_final_marker_preserves_stream_content_and_marks_only_final_response():
+    listener = dspy.streaming.StreamListener("answer", predict_name="predict")
+    responses = []
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(chunk("[[ ## answer ## ]]\n"))
+        for value in "abcdefghijk":
+            response = listener.receive(chunk(value))
+            if response is not None:
+                responses.append(response)
+        responses.append(listener.receive(chunk("[[ ## completed ## ]]")))
+
+    assert "".join(response.chunk for response in responses) == "abcdefghijk"
+    assert [response.is_last_chunk for response in responses] == [False, True]
+
+
+def test_three_argument_response_remains_compatible():
+    assert dspy.streaming.StreamResponse("predict", "answer", "text").is_last_chunk is False
