--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -401,3 +401,64 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+class TestSearchPathExpansion:
+    def test_default_preserves_literal_markers(self, monkeypatch):
+        monkeypatch.setenv("JINJA_TEMPLATE_ROOT", "/expanded")
+        loader = loaders.FileSystemLoader("$JINJA_TEMPLATE_ROOT/~/templates")
+        assert loader.searchpath == ["$JINJA_TEMPLATE_ROOT/~/templates"]
+
+    def test_expands_variables_then_user_home(self, tmp_path, monkeypatch):
+        home = tmp_path / "home"
+        templates = home / "templates"
+        templates.mkdir(parents=True)
+        (templates / "index.html").write_text("expanded")
+        monkeypatch.setenv("HOME", str(home))
+        monkeypatch.setenv("JINJA_HOME_ALIAS", "~")
+
+        loader = loaders.FileSystemLoader(
+            "$JINJA_HOME_ALIAS/templates", expand_searchpath=True
+        )
+        assert loader.searchpath == [str(templates)]
+        assert Environment(loader=loader).get_template("index.html").render() == (
+            "expanded"
+        )
+
+    def test_multiple_and_pathlike_inputs(self, tmp_path, monkeypatch):
+        first = tmp_path / "first"
+        second = tmp_path / "second"
+        first.mkdir()
+        second.mkdir()
+        monkeypatch.setenv("JINJA_SECOND", str(second))
+
+        loader = loaders.FileSystemLoader(
+            [first, "$JINJA_SECOND"], expand_searchpath=True
+        )
+        assert loader.searchpath == [str(first), str(second)]
+
+    def test_undefined_and_empty_variables(self, monkeypatch):
+        monkeypatch.delenv("JINJA_UNDEFINED", raising=False)
+        monkeypatch.setenv("JINJA_EMPTY", "")
+        loader = loaders.FileSystemLoader(
+            ["$JINJA_UNDEFINED/templates", "$JINJA_EMPTY/templates"],
+            expand_searchpath=True,
+        )
+        assert loader.searchpath == ["$JINJA_UNDEFINED/templates", "/templates"]
+
+    def test_expansion_is_frozen_at_initialization(self, tmp_path, monkeypatch):
+        first = tmp_path / "first"
+        second = tmp_path / "second"
+        first.mkdir()
+        second.mkdir()
+        (first / "page.html").write_text("first")
+        (second / "page.html").write_text("second")
+        monkeypatch.setenv("JINJA_ROOT", str(first))
+        loader = loaders.FileSystemLoader(
+            "$JINJA_ROOT", expand_searchpath=True
+        )
+        monkeypatch.setenv("JINJA_ROOT", str(second))
+
+        assert Environment(loader=loader).get_template("page.html").render() == (
+            "first"
+        )
