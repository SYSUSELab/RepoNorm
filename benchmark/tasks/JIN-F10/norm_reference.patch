diff --git a/tests/test_groupby_predicate_contribution.py b/tests/test_groupby_predicate_contribution.py
new file mode 100644
index 00000000..f36e89ea
--- /dev/null
+++ b/tests/test_groupby_predicate_contribution.py
@@ -0,0 +1,71 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+from jinja2 import pass_environment
+
+
+def test_predicate_receives_each_complete_group_once():
+    env = Environment()
+    rows = [(2, "a"), (1, "b"), (2, "c")]
+    calls = []
+
+    @pass_environment
+    def keep(environment, items):
+        assert environment is env
+        calls.append(list(items))
+        return len(items) > 1
+
+    groups = env.call_filter("groupby", iter(rows), [0], {"filter_groups": keep})
+
+    assert groups == [(2, [rows[0], rows[2]])]
+    assert calls == [[rows[1]], [rows[0], rows[2]]]
+
+
+def test_empty_input_does_not_invoke_predicate():
+    calls = []
+    groups = Environment().call_filter(
+        "groupby", [], [0], {"filter_groups": lambda items: calls.append(items)}
+    )
+    assert groups == []
+    assert calls == []
+
+
+def test_predicate_preserves_default_and_group_interface():
+    rows = [{"kind": "a"}, {}, {"kind": "a"}]
+    groups = Environment().call_filter(
+        "groupby",
+        rows,
+        ["kind"],
+        {"default": "missing", "filter_groups": lambda items: True},
+    )
+    assert [(group.grouper, group.list) for group in groups] == [
+        ("a", [rows[0], rows[2]]),
+        ("missing", [rows[1]]),
+    ]
+    assert repr(groups[0]) == repr(("a", [rows[0], rows[2]]))
+
+
+def test_predicate_exceptions_propagate():
+    def fail(items):
+        raise LookupError("predicate failed")
+
+    with pytest.raises(LookupError, match="predicate failed"):
+        Environment().call_filter("groupby", [(1,)], [0], {"filter_groups": fail})
+
+
+def test_async_predicate_is_awaited_for_async_input():
+    async def rows():
+        for row in [(2, "a"), (1, "b"), (2, "c")]:
+            yield row
+
+    async def keep(items):
+        await asyncio.sleep(0)
+        return len(items) > 1
+
+    async def run():
+        env = Environment(enable_async=True)
+        return await env.call_filter("groupby", rows(), [0], {"filter_groups": keep})
+
+    assert asyncio.run(run()) == [(2, [(2, "a"), (2, "c")])]
