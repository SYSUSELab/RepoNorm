+def test_toolcall_fingerprint_stable_readonly_and_serialization():
+    import hashlib
+    import json
+    from dspy import ToolCalls
+    raw = {'b': (' snow ', {'z': True, 'a': 1}), 'a': None}
+    call = ToolCalls.ToolCall(name='search', args=raw, fingerprint='forged', id='forged')
+    canonical = {'name': 'search', 'args': {'a': None, 'b': ['snow', {'a': 1, 'z': True}]}}
+    expected = hashlib.sha256(json.dumps(canonical, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+    assert call.fingerprint == expected
+    assert call.id == expected[:8]
+    assert call.args == raw
+    assert call.model_dump() == {'name': 'search', 'args': raw}
+    for attribute in ('fingerprint', 'id'):
+        with pytest.raises((AttributeError, ValueError)):
+            setattr(call, attribute, 'override')
+    call.args['a'] = 'edited later'
+    call.name = 'renamed'
+    assert call.fingerprint == expected
+
+
+def test_toolcall_fingerprint_public_ingestion_and_distinctions():
+    from dspy import ToolCalls
+    first = ToolCalls.from_dict_list([{'name': 'x', 'args': {'b': ' hi ', 'a': (1, 2)}}]).tool_calls[0]
+    second = ToolCalls.model_validate({'tool_calls': [{'name': 'x', 'args': {'a': [1, 2], 'b': 'hi'}}]}).tool_calls[0]
+    assert first.fingerprint == second.fingerprint
+    alternatives = [
+        ToolCalls.ToolCall(name='y', args=second.args),
+        ToolCalls.ToolCall(name='x', args={'a': [2, 1], 'b': 'hi'}),
+        ToolCalls.ToolCall(name='x', args={'a': ['1', 2], 'b': 'hi'}),
+        ToolCalls.ToolCall(name='x', args={'a': [True, 2], 'b': 'hi'}),
+    ]
+    assert all(other.fingerprint != first.fingerprint for other in alternatives)
+    result = ToolCalls(tool_calls=[second])
+    from dspy.adapters.types.base_type import CUSTOM_TYPE_START_IDENTIFIER, CUSTOM_TYPE_END_IDENTIFIER
+    serialized = result.model_dump()
+    assert isinstance(serialized, str)
+    assert serialized.startswith(CUSTOM_TYPE_START_IDENTIFIER) and serialized.endswith(CUSTOM_TYPE_END_IDENTIFIER)
+    assert second.fingerprint not in serialized
+    assert result.format() == [{'type': 'tool_calls', 'tool_calls': [
+        {'type': 'function', 'function': {'name': 'x', 'arguments': second.args}}]}]
+
+
+@pytest.mark.parametrize('value', [b'bytes', {1, 2}, float('nan'), float('inf'), object(), {1: 'nonstring'}])
+def test_toolcall_fingerprint_rejects_non_json(value):
+    from dspy import ToolCalls
+    with pytest.raises(ValueError):
+        ToolCalls.ToolCall(name='x', args={'value': value})
