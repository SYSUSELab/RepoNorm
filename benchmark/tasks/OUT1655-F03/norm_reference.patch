+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_octal_str_is_an_exported_composable_regex_term():
+    assert isinstance(types.octal_str, Regex)
+    combined = "mode=" + types.octal_str
+    assert re.fullmatch(to_regex(combined), "mode=0o755")
+
+
+@pytest.mark.parametrize("value", ["0o0", "0o7", "0o755", "0o0001", "0o" + "7" * 80])
+def test_octal_str_accepts_complete_valid_values(value):
+    assert re.fullmatch(to_regex(types.octal_str), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "0o", "755", "0O755", "+0o7", "0o8", "0o7_55", " 0o7", "0o٧"],
+)
+def test_octal_str_rejects_invalid_complete_values(value):
+    assert re.fullmatch(to_regex(types.octal_str), value) is None
+
+
+def test_octal_str_works_in_pydantic_schema_and_validation():
+    class Model(BaseModel):
+        value: types.octal_str
+
+    pattern = Model.model_json_schema()["properties"]["value"]["pattern"]
+    assert re.fullmatch(pattern, "0o755")
+    assert Model(value="0o755").value == "0o755"
+    with pytest.raises(ValidationError):
+        Model(value="755")
