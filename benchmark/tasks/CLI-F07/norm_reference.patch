diff --git a/tests/test_nesting_validation_contribution.py b/tests/test_nesting_validation_contribution.py
new file mode 100644
index 0000000..b3d4abb
--- /dev/null
+++ b/tests/test_nesting_validation_contribution.py
@@ -0,0 +1,95 @@
+from contextlib import contextmanager
+
+import pytest
+
+import click
+from click.testing import CliRunner
+
+
+@pytest.mark.parametrize("factory", ["constructor", "make_context"])
+def test_parent_rejects_open_child_and_recovers(factory) -> None:
+    events = []
+    parent = click.Context(click.Command("parent"), validate_nesting=True)
+    parent.call_on_close(lambda: events.append("parent-close"))
+    if factory == "constructor":
+        child = click.Context(click.Command("child"), parent=parent)
+    else:
+        child = click.Command("child").make_context("child", [], parent=parent)
+
+    with pytest.raises(RuntimeError, match="child"):
+        parent.close()
+    assert events == []
+    child.close()
+    parent.close()
+    assert events == ["parent-close"]
+
+
+def test_closed_child_is_tracked_again_when_reentered() -> None:
+    parent = click.Context(click.Command("parent"), validate_nesting=True)
+    child = click.Context(click.Command("child"), parent=parent)
+    child.close()
+    with child:
+        with pytest.raises(RuntimeError, match="child"):
+            parent.close()
+    parent.close()
+
+
+def test_failed_parent_exit_restores_current_context_stack() -> None:
+    parent = click.Context(click.Command("parent"), validate_nesting=True)
+    child = click.Context(click.Command("child"), parent=parent)
+    with pytest.raises(RuntimeError, match="child"):
+        with parent:
+            assert click.get_current_context() is parent
+    assert click.get_current_context(silent=True) is None
+    child.close()
+    parent.close()
+
+
+def test_failed_child_parse_does_not_leave_phantom_child() -> None:
+    parent = click.Context(click.Command("parent"), validate_nesting=True)
+    child = click.Command("child", params=[click.Option(["--required"], required=True)])
+    with pytest.raises(click.MissingParameter):
+        child.make_context("child", [], parent=parent)
+    parent.close()
+
+
+def test_validation_disabled_keeps_legacy_close_behavior() -> None:
+    parent = click.Context(click.Command("parent"))
+    child = click.Context(click.Command("child"), parent=parent)
+    parent.close()
+    child.close()
+
+
+def test_resources_survive_rejected_close_and_keep_lifo() -> None:
+    events = []
+
+    @contextmanager
+    def resource():
+        events.append("enter")
+        try:
+            yield
+        finally:
+            events.append("resource-exit")
+
+    parent = click.Context(click.Command("parent"), validate_nesting=True)
+    parent.call_on_close(lambda: events.append("first"))
+    parent.with_resource(resource())
+    parent.call_on_close(lambda: events.append("last"))
+    child = click.Context(click.Command("child"), parent=parent)
+    with pytest.raises(RuntimeError):
+        parent.close()
+    assert events == ["enter"]
+    child.close()
+    parent.close()
+    assert events == ["enter", "last", "resource-exit", "first"]
+
+
+@pytest.mark.parametrize("chain", [False, True])
+def test_normal_cli_execution_with_validation(chain) -> None:
+    group = click.Group(
+        "root", chain=chain, context_settings={"validate_nesting": True}
+    )
+    group.add_command(click.Command("sub", callback=lambda: click.echo("ok")))
+    result = CliRunner().invoke(group, ["sub"])
+    assert result.exit_code == 0
+    assert result.output == "ok\n"
