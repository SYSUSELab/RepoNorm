+@pytest.mark.parametrize("factory", ["constructor", "make_context"])
+def test_nesting_public_paths_and_reuse(factory):
+    root = click.Context(click.Command("root"), validate_nesting=True)
+    released = []
+    root.call_on_close(lambda: released.append(True))
+
+    def child(name):
+        command = click.Command(name)
+        if factory == "constructor":
+            return click.Context(command, parent=root)
+        return command.make_context(name, [], parent=root)
+
+    first, second = child("first"), child("second")
+    assert first.validate_nesting and second.validate_nesting
+    with pytest.raises(RuntimeError) as caught:
+        root.close()
+    assert "first" in str(caught.value) and "second" in str(caught.value)
+    assert released == []
+    first.close()
+    with pytest.raises(RuntimeError, match="second"):
+        root.close()
+    second.close()
+    root.close()
+    assert released == [True]
+    with root:
+        with first:
+            with pytest.raises(RuntimeError, match="first"):
+                root.close()
+    assert click.get_current_context(silent=True) is None
+
+
+def test_nesting_failed_exit_restores_current_context_stack():
+    root = click.Context(click.Command("root"), validate_nesting=True)
+    child = click.Context(click.Command("child"), parent=root)
+    grandchild = click.Context(click.Command("grandchild"), parent=child)
+    with pytest.raises(RuntimeError, match="child"):
+        with root:
+            pass
+    assert click.get_current_context(silent=True) is None
+    with pytest.raises(RuntimeError, match="grandchild"):
+        child.close()
+    grandchild.close()
+    child.close()
+    root.close()
+
+
+@pytest.mark.parametrize("chain", [False, True])
+def test_nesting_actual_cli_and_completion(runner, chain):
+    from click.shell_completion import ShellComplete
+
+    @click.group(chain=chain, context_settings={"validate_nesting": True})
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option("--value", default="x")
+    @click.pass_context
+    def child(ctx, value):
+        assert ctx.validate_nesting
+        click.echo(value)
+
+    assert runner.invoke(cli, ["child", "--value", "y"]).output == "y\n"
+    result = runner.invoke(cli, ["child", "--value", "y"])
+    assert result.exit_code == 0
+    complete = ShellComplete(cli, {}, "cli", "_CLI_COMPLETE")
+    assert "--value" in [
+        item.value for item in complete.get_completions(["child"], "--v")
+    ]
+
+
+def test_nesting_failed_child_parse_not_left_open():
+    root = click.Context(click.Command("root"), validate_nesting=True)
+    child = click.Command("child", params=[click.Option(["--number"], type=int)])
+    with pytest.raises(click.BadParameter):
+        child.make_context("child", ["--number", "bad"], parent=root)
+    root.close()
