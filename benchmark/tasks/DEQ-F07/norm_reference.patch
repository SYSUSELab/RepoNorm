@@ -0,0 +1,21 @@
+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize('algorithm,size', [('md5', 32), ('SHA256', 64)])
+def test_hash_contract(algorithm, size):
+    validator = de.IsHash(algorithm)
+    value = 'aB' * (size // 2)
+    assert value == validator
+    assert validator.value == value
+    assert repr(validator) == repr(value)
+    for invalid in (value + '\n', value[:-1], 'z' * size, None, 17):
+        assert invalid != validator
+    assert value == (de.IsHash(algorithm) & de.IsStr())
+    assert 'invalid' == ~de.IsHash(algorithm)
+
+
+def test_unsupported_algorithm():
+    with pytest.raises(ValueError):
+        de.IsHash('unknown')
