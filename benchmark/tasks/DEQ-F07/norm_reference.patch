+class IsHash(DirtyEquals[str]):
+    """
+    Match the complete hexadecimal representation of a hash digest.
+
+    Algorithm names are case-insensitive. Values must be strings of the
+    corresponding length, with no whitespace. This does not verify a file's
+    contents or compute its digest.
+    """
+
+    # Hexadecimal digest lengths.
+    _ALGORITHMS = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: One of md5, sha1, sha224, sha256, sha384 or sha512.
+
+        Raises:
+            ValueError: The algorithm is not supported.
+
+        ```py title="IsHash"
+        from dirty_equals import IsHash
+
+        assert 'a' * 32 == IsHash('md5')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+        assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == IsHash('sha256')
+        assert 'invalid' != IsHash('md5')
+        ```
+        """
+        normalized_algorithm = algorithm.lower()
+        if normalized_algorithm not in self._ALGORITHMS:
+            raise ValueError(
+                f'Unsupported hash algorithm: {algorithm}. Supported algorithms: {", ".join(self._ALGORITHMS.keys())}'
+            )
+
+        self.algorithm = algorithm
+        self.expected_length = self._ALGORITHMS[normalized_algorithm]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        # Check length
+        if len(other) != self.expected_length:
+            return False
+
+        # Check if it's a valid hexadecimal string (case insensitive)
+        return bool(re.fullmatch(r'[0-9a-fA-F]+', other))
+
+
