@@ -470,3 +471,38 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _ProcessGroupProcess:
+    pid = 1007
+    def wait(self): return 0
+
+
+def test_edit_process_group_disabled_has_no_separation_request(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _ProcessGroupProcess())
+    click.edit(filename="file.txt", editor="editor")
+    assert not calls[0].get("start_new_session", False)
+    assert calls[0].get("preexec_fn") is None
+    assert not calls[0].get("creationflags", 0)
+
+
+def test_edit_process_group_unsupported_platform_degrades(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.WIN", True)
+    monkeypatch.delattr("subprocess.CREATE_NEW_PROCESS_GROUP", raising=False)
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _ProcessGroupProcess())
+    click.edit(filename="file.txt", editor="editor", process_group=True)
+    assert "start_new_session" not in calls[0]
+    assert "preexec_fn" not in calls[0]
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIX process-group observation")
+def test_edit_process_group_is_observably_separate(tmp_path):
+    script = tmp_path / "group.py"
+    output = tmp_path / "group.txt"
+    script.write_text("import os, pathlib, sys\npathlib.Path(sys.argv[1]).write_text(str(os.getpgrp()))\n")
+
+    click.edit(filename=str(output), editor=f"python {script}", process_group=True)
+
+    assert int(output.read_text()) != os.getpgrp()
