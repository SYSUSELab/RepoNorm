+@pytest.mark.parametrize("loader_kind", ["function", "module"])
+@pytest.mark.parametrize("entrypoint", ["loader", "environment"])
+def test_filters_preserve_unsupported_listing_error(tmp_path, loader_kind, entrypoint):
+    if loader_kind == "function":
+        loader = loaders.FunctionLoader(lambda name: "source")
+    else:
+        loader = loaders.ModuleLoader(tmp_path)
+    loader.add_filter("*.html")
+    env = Environment(loader=loader)
+    for clear in (False, True):
+        if clear:
+            loader.clear_filters()
+        with pytest.raises(TypeError):
+            if entrypoint == "loader":
+                loader.list_templates()
+            else:
+                env.list_templates()
+
