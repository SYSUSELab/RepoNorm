+def test_filter_scope_nesting_restores_entering_filters():
+    import re
+
+    loader = loaders.DictLoader({"a.html": "A", "b.txt": "B", "c.html": "C", "hide.html": "H"})
+    loader.add_filter("hide.*")
+    with loader.filter_scope(re.compile(r"\.txt$")):
+        assert loader.list_templates() == ["a.html", "c.html"]
+        with loader.filter_scope(lambda name: name == "c.html"):
+            assert loader.list_templates() == ["a.html"]
+            loader.clear_filters()
+            loader.add_filter("a.*")
+        assert loader.list_templates() == ["a.html", "c.html"]
+    assert loader.list_templates() == ["a.html", "b.txt", "c.html"]
+    with loader.filter_scope():
+        loader.clear_filters()
+    assert loader.list_templates() == ["a.html", "b.txt", "c.html"]
+
+
+def test_filter_scope_failed_entry_and_body_restore_filters():
+    loader = loaders.DictLoader({"a.html": "A", "hidden.html": "H"})
+    loader.add_filter("hidden.*")
+    with pytest.raises(TypeError):
+        with loader.filter_scope("a.*", object()):
+            pytest.fail("invalid filter must fail on entry")
+    assert loader.list_templates() == ["a.html"]
+    with pytest.raises(ZeroDivisionError):
+        with loader.filter_scope(lambda name: 1 / 0):
+            loader.list_templates()
+    assert loader.list_templates() == ["a.html"]
+
