+@pytest.mark.parametrize("ignore_errors", [False, True])
+def test_filter_scope_compile_subset_preserves_error_policy(tmp_path, ignore_errors):
+    from jinja2 import TemplateNotFound
+    from jinja2 import TemplateSyntaxError
+
+    child = loaders.DictLoader({"keep.html": "KEEP", "omit.txt": "OMIT", "bad.html": "{% broken %}", "hidden.html": "HIDDEN"})
+    child.add_filter("hidden.*")
+    loader = loaders.PrefixLoader({"pkg": child})
+    env = Environment(loader=loader)
+    with loader.filter_scope("*/omit.*"):
+        assert env.get_template("pkg/omit.txt").render() == "OMIT"
+        with loader.filter_scope("*/bad.*"):
+            env.compile_templates(tmp_path / "subset", zip=None, ignore_errors=False)
+        compiled = Environment(loader=loaders.ModuleLoader(tmp_path / "subset"))
+        assert compiled.get_template("pkg/keep.html").render() == "KEEP"
+        for name in ("pkg/omit.txt", "pkg/bad.html", "pkg/hidden.html"):
+            with pytest.raises(TemplateNotFound):
+                compiled.get_template(name)
+    if ignore_errors:
+        with loader.filter_scope("*/omit.*"):
+            env.compile_templates(tmp_path / "errors", zip=None, ignore_errors=True)
+        assert Environment(loader=loaders.ModuleLoader(tmp_path / "errors")).get_template("pkg/keep.html").render() == "KEEP"
+    else:
+        with pytest.raises(TemplateSyntaxError):
+            with loader.filter_scope("*/omit.*"):
+                env.compile_templates(tmp_path / "errors", zip=None, ignore_errors=False)
+    assert env.list_templates() == ["pkg/bad.html", "pkg/keep.html", "pkg/omit.txt"]
+
+
+@pytest.mark.parametrize("loader_kind", ["function", "module"])
+def test_filter_scope_compile_keeps_unsupported_listing(tmp_path, loader_kind):
+    loader = loaders.FunctionLoader(lambda name: "source") if loader_kind == "function" else loaders.ModuleLoader(tmp_path)
+    env = Environment(loader=loader)
+    with pytest.raises(TypeError):
+        with loader.filter_scope("*.txt"):
+            env.compile_templates(tmp_path / "compiled", zip=None)
