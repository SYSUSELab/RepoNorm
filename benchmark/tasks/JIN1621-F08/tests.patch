+def test_persistent_parent_and_child_filters_compose():
+    child = loaders.DictLoader({"keep.html": "K", "child.txt": "C", "parent.html": "P"})
+    child.add_filter("*.txt")
+    loader = loaders.PrefixLoader({"pkg": child})
+    loader.add_filter("*/parent.html")
+    assert loader.list_templates() == ["pkg/keep.html"]
+    assert Environment(loader=loader).get_template("pkg/parent.html").render() == "P"
+
