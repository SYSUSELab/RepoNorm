diff --git a/tests/test_prompt_global_registry.py b/tests/test_prompt_global_registry.py
new file mode 100644
index 00000000..09d52025
--- /dev/null
+++ b/tests/test_prompt_global_registry.py
@@ -0,0 +1,97 @@
+from pathlib import Path
+
+import jinja2
+import pytest
+
+import outlines
+from outlines import prompts
+from outlines.prompts import Prompt
+
+
+@pytest.fixture
+def registered_names():
+    names = []
+    yield names
+    unregister = getattr(prompts, "unregister_filter", None)
+    if unregister is not None:
+        for name in names:
+            unregister(name)
+
+
+def test_registry_applies_to_all_public_entrypoints(registered_names, tmp_path: Path):
+    name = "n4c_surround"
+    registered_names.append(name)
+    prompts.register_filter(name, lambda value: f"<{value}>")
+
+    @outlines.prompt
+    def decorated(value):
+        """{{ value | n4c_surround }}"""
+
+    include = tmp_path / "include.txt"
+    include.write_text("{{ value | n4c_surround }}", encoding="utf-8")
+    prompt_path = tmp_path / "prompt.txt"
+    prompt_path.write_text('{% include "include.txt" %}', encoding="utf-8")
+
+    assert decorated("decorator") == "<decorator>"
+    assert Prompt.from_str("{{ value | n4c_surround }}")(value="string") == "<string>"
+    assert Prompt.from_file(prompt_path)(value="file") == "<file>"
+
+
+def test_registry_changes_only_future_prompts(registered_names):
+    name = "n4c_versioned"
+    registered_names.append(name)
+    prompts.register_filter(name, lambda value: f"first:{value}")
+    first = Prompt.from_str("{{ value | n4c_versioned }}")
+
+    prompts.register_filter(name, lambda value: f"second:{value}")
+    second = Prompt.from_str("{{ value | n4c_versioned }}")
+    prompts.unregister_filter(name)
+
+    assert first(value="x") == "first:x"
+    assert second(value="x") == "second:x"
+    with pytest.raises(jinja2.TemplateAssertionError, match="No filter named"):
+        Prompt.from_str("{{ value | n4c_versioned }}")
+
+
+def test_outlines_filters_are_protected_and_unknown_unregister_is_safe(
+    registered_names,
+):
+    registered_names.append("name")
+    prompts.register_filter("name", lambda value: "wrong")
+    prompts.unregister_filter("n4c_never_registered")
+
+    def sample():
+        pass
+
+    assert Prompt.from_str("{{ fn | name }}")(fn=sample) == "sample"
+
+
+def test_registry_preserves_prompt_error_format_and_signature_contracts(
+    registered_names,
+):
+    name = "n4c_identity"
+    registered_names.append(name)
+    prompts.register_filter(name, lambda value: value)
+
+    @outlines.prompt
+    def formatted(value="snow"):
+        """
+        Heading
+            {{ value | n4c_identity }} / {{ missing }}
+
+        """
+
+    assert list(formatted.signature.parameters) == ["value"]
+    with pytest.raises(TypeError):
+        formatted(unexpected="x")
+    with pytest.raises(jinja2.UndefinedError):
+        formatted()
+
+    rendered = Prompt.from_str(
+        """
+        Heading
+            {{ value | n4c_identity }}
+
+        """
+    )
+    assert rendered(value="snow") == "Heading\n    snow\n"
