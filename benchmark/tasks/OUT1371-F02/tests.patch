+def test_registration_changes_only_future_templates(registered_filter_names):
+    name = "versioned_global_registry_test"
+    registered_filter_names.append(name)
+    register_filter(name, lambda value: f"first:{value}")
+    first = Prompt.from_str("{{ value | versioned_global_registry_test }}")
+
+    register_filter(name, lambda value: f"second:{value}")
+    second = Prompt.from_str("{{ value | versioned_global_registry_test }}")
+    unregister_filter(name)
+
+    assert first(value="x") == "first:x"
+    assert second(value="x") == "second:x"
+
+    with pytest.raises(jinja2.TemplateAssertionError, match="No filter named"):
+        Prompt.from_str("{{ value | versioned_global_registry_test }}")
