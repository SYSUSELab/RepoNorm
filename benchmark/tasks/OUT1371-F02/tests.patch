+def test_global_filters_work_across_public_prompt_entry_points(
+    registered_filter_names, tmp_path
+):
+    name = "surround_for_global_registry_test"
+    registered_filter_names.append(name)
+    register_filter(name, lambda value, left, right: f"{left}{value}{right}")
+
+    @outlines.prompt
+    def decorated(value):
+        """{{ value | surround_for_global_registry_test("<", ">") }}"""
+
+    assert decorated("decorator") == "<decorator>"
+    assert (
+        Prompt.from_str("{{ value | surround_for_global_registry_test('[', ']') }}")(
+            value="string"
+        )
+        == "[string]"
+    )
+
+    (tmp_path / "included.txt").write_text(
+        "{{ value | surround_for_global_registry_test('(', ')') }}",
+        encoding="utf-8",
+    )
+    template_path = tmp_path / "prompt.txt"
+    template_path.write_text('{% include "included.txt" %}', encoding="utf-8")
+    assert Prompt.from_file(template_path)(value="file") == "(file)"
+
