@@ -68,3 +68,15 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches 16-digit credit card numbers either as contiguous digits or grouped
+# in blocks of four separated by a single consistent space or hyphen.
+# Examples of accepted formats:
+# - 1234567890123456
+# - 1234-5678-9012-3456
+# - 1234 5678 9012 3456
+# This pattern does not perform a Luhn checksum; it validates format only.
+credit_card = Regex(
+    r"[0-9]{16}|[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}|"
+    r"[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4}"
+)
