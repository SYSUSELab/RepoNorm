@@ -0,0 +1,57 @@
+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_credit_card_is_an_exported_composable_regex_term():
+    value = getattr(types, "credit_card")
+    assert isinstance(value, Regex)
+    assert re.fullmatch(to_regex("<" + value + ">"), "<1234-5678-9012-3456>")
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "1234567890123456",
+        "1234-5678-9012-3456",
+        "1234 5678 9012 3456",
+        "0000000000000000",
+        "1111111111111111",
+    ],
+)
+def test_credit_card_accepts_supported_shapes_without_checksum_validation(value):
+    assert re.fullmatch(to_regex(getattr(types, "credit_card")), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "123456789012345",
+        "12345678901234567",
+        "1234-5678 9012-3456",
+        "1234 5678-9012 3456",
+        "1234--5678--9012--3456",
+        "1234  5678  9012  3456",
+        "1234.5678.9012.3456",
+        "1234-5678-9012-345",
+        "abcd-efgh-ijkl-mnop",
+        "١٢٣٤٥٦٧٨٩٠١٢٣٤٥٦",
+    ],
+)
+def test_credit_card_rejects_invalid_complete_shapes(value):
+    assert re.fullmatch(to_regex(getattr(types, "credit_card")), value) is None
+
+
+def test_credit_card_works_in_pydantic_schema_and_validation():
+    class Payment(BaseModel):
+        number: types.credit_card
+
+    pattern = Payment.model_json_schema()["properties"]["number"]["pattern"]
+    assert re.fullmatch(pattern, "9999 9999 9999 9999")
+    assert Payment(number="1234567890123456").number == "1234567890123456"
+    with pytest.raises(ValidationError):
+        Payment(number="1234-5678 9012-3456")
