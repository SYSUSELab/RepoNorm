diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..e22d337 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,41 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _EscapedEditorProcess:
+    pid = 1006
+    def __init__(self, code=0): self.code = code
+    def wait(self): return self.code
+
+
+def _escaped_editor_argv(command):
+    import shlex
+    return shlex.split(command) if isinstance(command, str) else list(command)
+
+
+@pytest.mark.parametrize("filename", ["", "two words", 'a"b', "a'b", "semi;colon", "$(marker)", "`marker`", "line\nbreak"])
+def test_edit_escape_shell_preserves_literal_filename(filename, monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kw: calls.append((command, kw)) or _EscapedEditorProcess())
+    click.edit(filename=filename, editor="editor --wait", escape_shell=True)
+    assert _escaped_editor_argv(calls[0][0]) == ["editor", "--wait", filename]
+
+
+def test_edit_escape_shell_payload_does_not_create_marker(tmp_path):
+    marker = tmp_path / "marker"
+    filename = f"unused; touch {marker}"
+    click.edit(filename=filename, editor="true", escape_shell=True)
+    assert not marker.exists()
+
+
+def test_edit_escape_shell_default_is_unchanged(monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda command, **kw: calls.append((command, kw)) or _EscapedEditorProcess())
+    click.edit(filename="plain.txt", editor="editor --wait")
+    assert calls[0][0] == 'editor --wait "plain.txt"'
+
+
+def test_edit_escape_shell_nonzero_keeps_failure(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _EscapedEditorProcess(2))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename="plain.txt", editor="editor", escape_shell=True)
