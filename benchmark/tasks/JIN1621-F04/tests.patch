+
+
+class TestSearchPathPriorities:
+    def test_mixed_priorities_determine_lookup_order(self, tmp_path):
+        default1 = tmp_path / "default1"
+        high = tmp_path / "high"
+        default2 = tmp_path / "default2"
+        low = tmp_path / "low"
+        for path in (default1, high, default2, low):
+            path.mkdir()
+            (path / "page.html").write_text(path.name)
+        loader = loaders.FileSystemLoader(
+            [default1, (high, 10), default2, (low, -5)]
+        )
+
+        assert loader.searchpath == [
+            str(high),
+            str(default1),
+            str(default2),
+            str(low),
+        ]
+        assert Environment(loader=loader).get_template("page.html").render() == (
+            "high"
+        )
+
+    def test_equal_priorities_are_stable_and_duplicates_remain(self, tmp_path):
+        first = tmp_path / "first"
+        second = tmp_path / "second"
+        loader = loaders.FileSystemLoader(
+            [(first, 2), (second, 2), (first, 2)]
+        )
+        assert loader.searchpath == [str(first), str(second), str(first)]
+
+    def test_plain_sequence_keeps_existing_order(self, tmp_path):
+        first = tmp_path / "first"
+        second = tmp_path / "second"
+        loader = loaders.FileSystemLoader([first, second])
+        assert loader.searchpath == [str(first), str(second)]
+
+    @pytest.mark.parametrize(
+        "entry",
+        [
+            (),
+            ("path",),
+            ("path", 1, "extra"),
+            ("path", "high"),
+            ("path", 1.5),
+            ("path", True),
+            (42, 1),
+        ],
+    )
+    def test_invalid_priority_entry_is_rejected(self, entry):
+        with pytest.raises(TypeError):
+            loaders.FileSystemLoader([entry])
+
+    def test_listing_uses_priority_sorted_paths(self, tmp_path):
+        low = tmp_path / "low"
+        high = tmp_path / "high"
+        low.mkdir()
+        high.mkdir()
+        (low / "low.html").write_text("low")
+        (high / "high.html").write_text("high")
+        loader = loaders.FileSystemLoader([(low, -1), (high, 4)])
+        assert loader.list_templates() == ["high.html", "low.html"]
