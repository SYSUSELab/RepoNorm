diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..a7abb33 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,55 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _IsolatedEnvProcess:
+    pid = 1008
+    def wait(self): return 0
+
+
+def test_edit_isolated_env_is_exact_allowlist(monkeypatch):
+    parent = {
+        "PATH": "/bin", "HOME": "/home/user", "LANG": "C", "SystemRoot": "C:/Windows",
+        "TOKEN": "secret", "MONKEY": "ordinary", "BYPASS_MODE": "yes", "CAPITAL": "x",
+        "UNCLASSIFIED_CREDENTIAL": "hidden",
+    }
+    calls = []
+    monkeypatch.setattr("click._termui_impl.os.environ", parent)
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _IsolatedEnvProcess())
+
+    click.edit(filename="file.txt", editor="editor", isolate_env=True)
+
+    assert calls[0]["env"] == {"PATH": "/bin", "HOME": "/home/user", "LANG": "C", "SystemRoot": "C:/Windows"}
+
+
+def test_edit_isolated_env_explicit_values_win(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.os.environ", {"PATH": "/parent", "TOKEN": "parent"})
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _IsolatedEnvProcess())
+
+    click.edit(filename="file.txt", editor="editor", isolate_env=True, env={"PATH": "/chosen", "TOKEN": "explicit"})
+
+    assert calls[0]["env"] == {"PATH": "/chosen", "TOKEN": "explicit"}
+
+
+def test_edit_isolated_env_disabled_preserves_default(monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _IsolatedEnvProcess())
+    click.edit(filename="file.txt", editor="editor")
+    assert calls[0]["env"] is None
+
+
+def test_edit_isolated_env_disabled_custom_env_extends_parent(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.os.environ", {"PARENT": "yes"})
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _IsolatedEnvProcess())
+    click.edit(filename="file.txt", editor="editor", env={"CHILD": "yes"})
+    assert calls[0]["env"] == {"PARENT": "yes", "CHILD": "yes"}
+
+
+def test_edit_isolated_env_applies_to_temporary_text(monkeypatch):
+    calls = []
+    monkeypatch.setattr("click._termui_impl.os.environ", {"PATH": "/bin", "SECRET": "no"})
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append(kw) or _IsolatedEnvProcess())
+    click.edit("text", editor="editor", isolate_env=True, require_save=False)
+    assert calls[0]["env"] == {"PATH": "/bin"}
