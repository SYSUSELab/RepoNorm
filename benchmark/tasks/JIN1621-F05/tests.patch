+def test_resolved_path_cache_hit_clear_and_resize(tmp_path, monkeypatch):
+    high = tmp_path / "high"; low = tmp_path / "low"
+    high.mkdir(); low.mkdir(); (low / "a.html").write_text("A")
+    class CountingLoader(loaders.FileSystemLoader):
+        resolutions = 0
+        def resolve_template_path(self, template):
+            self.resolutions += 1
+            return super().resolve_template_path(template)
+    loader = CountingLoader([high, low], path_cache_size=2)
+    env = Environment(loader=loader, cache_size=0)
+    assert env.get_template("a.html").render() == "A"
+    assert loader.resolutions == 1
+    assert env.get_template("a.html").render() == "A"
+    assert loader.resolutions == 1
+    loader.clear_path_cache()
+    assert env.get_template("a.html").render() == "A"
+    assert loader.resolutions == 2
+    loader.resize_path_cache(0)
+    assert env.get_template("a.html").render() == "A"
+    assert loader.resolutions == 3
+
+
+def test_resolved_path_cache_never_caches_miss(tmp_path):
+    loader = loaders.FileSystemLoader(tmp_path, path_cache_size=2)
+    env = Environment(loader=loader, cache_size=0)
+    with pytest.raises(TemplateNotFound):
+        env.get_template("new.html")
+    (tmp_path / "new.html").write_text("new")
+    assert env.get_template("new.html").render() == "new"
+
+
+def test_resolved_path_cache_observes_higher_precedence(tmp_path):
+    high = tmp_path / "high"; low = tmp_path / "low"
+    high.mkdir(); low.mkdir(); (low / "x").write_text("low")
+    loader = loaders.FileSystemLoader([high, low], path_cache_size=2)
+    env = Environment(loader=loader, cache_size=0)
+    assert env.get_template("x").render() == "low"
+    (high / "x").write_text("high")
+    assert env.get_template("x").render() == "high"
+
+
+def test_resolved_path_cache_lru_capacity(tmp_path, monkeypatch):
+    high = tmp_path / "high"; low = tmp_path / "low"
+    high.mkdir(); low.mkdir()
+    for name in ("a", "b"):
+        (low / name).write_text(name)
+    class CountingLoader(loaders.FileSystemLoader):
+        resolutions = 0
+        def resolve_template_path(self, template):
+            self.resolutions += 1
+            return super().resolve_template_path(template)
+    loader = CountingLoader([high, low], path_cache_size=1)
+    env = Environment(loader=loader, cache_size=0)
+    env.get_template("a"); env.get_template("b")
+    assert loader.resolutions == 2
+    env.get_template("a")
+    assert loader.resolutions == 3  # a was the least-recently-used eviction
+    env.get_template("a")
+    assert loader.resolutions == 3  # the immediately repeated lookup is a cache hit
+
+
+def test_resolved_path_cache_validation(tmp_path):
+    with pytest.raises(ValueError):
+        loaders.FileSystemLoader(tmp_path, path_cache_size=-1)
+    with pytest.raises(ValueError):
+        loaders.FileSystemLoader(tmp_path, path_cache_size=True)
+    with pytest.raises(ValueError):
+        loaders.FileSystemLoader(tmp_path, path_cache_size="2")
+
+
+@pytest.mark.parametrize("entrypoint", ["source", "environment"])
+def test_resolved_path_cache_keeps_parent_path_rejection(tmp_path, entrypoint):
+    root = tmp_path / "templates"
+    root.mkdir()
+    (root / "ok.html").write_text("inside")
+    (tmp_path / "outside.html").write_text("outside")
+    loader = loaders.FileSystemLoader(root, path_cache_size=2)
+    env = Environment(loader=loader, cache_size=0)
+    assert env.get_template("ok.html").render() == "inside"
+    assert env.get_template("ok.html").render() == "inside"
+    for _ in range(2):
+        with pytest.raises(TemplateNotFound) as exc_info:
+            if entrypoint == "source":
+                loader.get_source(env, "../outside.html")
+            else:
+                env.get_template("../outside.html")
+        assert exc_info.value.name == "../outside.html"
+    assert env.get_template("ok.html").render() == "inside"
