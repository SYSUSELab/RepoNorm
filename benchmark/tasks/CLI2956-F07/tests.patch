@@ -1139,3 +1139,93 @@ def test_duplicate_names_warning(runner, opts_one, opts_two):
 
     with pytest.warns(UserWarning):
         runner.invoke(cli, [])
+
+
+def test_option_conflicts_keep_parent_and_child_sources_separate(runner):
+    received = []
+
+    @click.group()
+    @click.option("--right", is_flag=True)
+    def cli(right):
+        pass
+
+    @cli.command()
+    @click.option("--left", is_flag=True, conflicts_with=["right"])
+    @click.option("--right", is_flag=True)
+    def child(left, right):
+        received.append((left, right))
+
+    result = runner.invoke(cli, ["--right", "child", "--left"])
+    assert result.exit_code == 0, (result.output, result.exception)
+    assert received == [(True, False)]
+
+
+def test_option_conflicts_command_line_any_order(runner):
+    @click.command()
+    @click.option("--left", is_flag=True, conflicts_with=["right"])
+    @click.option("--right", is_flag=True)
+    def cli(left, right): pass
+    for args in (["--left", "--right"], ["--right", "--left"]):
+        result = runner.invoke(cli, args)
+        assert result.exit_code == 2
+        assert "Option '--left' cannot be used together with '--right'." in result.output
+
+
+def test_option_conflicts_prompt_and_command_line(runner):
+    @click.command()
+    @click.option("--left", prompt=True, conflicts_with=["right"])
+    @click.option("--right", is_flag=True)
+    def cli(left, right): pass
+    result = runner.invoke(cli, ["--right"], input="value\n")
+    assert result.exit_code == 2
+    assert "cannot be used together" in result.output
+
+
+def test_option_conflicts_two_prompts(runner):
+    @click.command()
+    @click.option("--left", prompt=True, conflicts_with=["right"])
+    @click.option("--right", prompt=True)
+    def cli(left, right): pass
+    result = runner.invoke(cli, input="r\nl\n")
+    assert result.exit_code == 2
+
+
+@pytest.mark.parametrize("source", ["default", "env", "default_map"])
+def test_option_conflicts_non_explicit_source_does_not_trigger(runner, source):
+    kwargs = {"default": True} if source == "default" else ({"envvar": "RIGHT"} if source == "env" else {})
+    settings = {"default_map": {"right": True}} if source == "default_map" else {}
+    @click.command(context_settings=settings)
+    @click.option("--left", is_flag=True, conflicts_with=["right"])
+    @click.option("--right", is_flag=True, **kwargs)
+    def cli(left, right): click.echo("ok")
+    env = {"RIGHT": "1"} if source == "env" else None
+    assert runner.invoke(cli, ["--left"], env=env).output == "ok\n"
+
+
+def test_option_conflicts_negative_count_and_multiple_are_explicit(runner):
+    @click.command()
+    @click.option("--enabled/--disabled", default=True, conflicts_with=["item"])
+    @click.option("--item", multiple=True)
+    def cli(enabled, item): pass
+    assert runner.invoke(cli, ["--disabled", "--item", "x"]).exit_code == 2
+
+
+def test_option_conflicts_unknown_is_configuration_error(runner):
+    @click.command()
+    @click.option("--left", conflicts_with=["missing"])
+    def cli(left): pass
+    result = runner.invoke(cli, standalone_mode=False)
+    assert isinstance(result.exception, click.UsageError)
+    assert str(result.exception).strip()
+
+
+@pytest.mark.parametrize("value", ["other", ["--other"], [1]])
+def test_option_conflicts_reject_invalid_declarations(value):
+    with pytest.raises(TypeError) as error:
+        click.Option(["--left"], conflicts_with=value)
+    assert str(error.value).strip()
+
+
+def test_option_conflicts_info_dict_is_list():
+    assert click.Option(["--left"]).to_info_dict()["conflicts_with"] == []
+    assert click.Option(["--left"], conflicts_with=["right"]).to_info_dict()["conflicts_with"] == ["right"]
