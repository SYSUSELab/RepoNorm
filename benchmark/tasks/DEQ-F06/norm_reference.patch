@@ -0,0 +1,36 @@
+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize(
+    'value,issuer',
+    [
+        ('4111 1111 1111 1111', 'Visa'),
+        (4111111111111111, 'Visa'),
+        ('5555-5555-5555-4444', 'Mastercard'),
+        ('378282246310005', 'AmericanExpress'),
+    ],
+)
+def test_card_issuer_luhn_and_value(value, issuer):
+    validator = de.IsCreditCard(issuer)
+    assert value == validator
+    assert validator.value == value
+
+
+def test_card_rejects_issuer_and_checksum_mismatches():
+    assert '5555555555554444' != de.IsCreditCard('Visa')
+    assert '4111111111111112' != de.IsCreditCard('Visa')
+    assert '411111111111' != de.IsCreditCard()
+
+
+@pytest.mark.parametrize('value', ['４１１１１１１１１１１１１１１１', '4111x1111', None, []])
+def test_card_rejects_non_ascii_or_wrong_types(value):
+    assert value != de.IsCreditCard()
+
+
+def test_card_composition_and_repr():
+    value = '4111111111111111'
+    assert value == (de.IsCreditCard('Visa') & de.IsStr())
+    assert value == ~de.IsCreditCard('Mastercard')
+    assert repr(de.IsCreditCard()) == 'IsCreditCard()'
