diff --git a/tests/clients/test_cache_namespace_contribution.py b/tests/clients/test_cache_namespace_contribution.py
new file mode 100644
index 000000000..dc9397f6b
--- /dev/null
+++ b/tests/clients/test_cache_namespace_contribution.py
@@ -0,0 +1,63 @@
+import asyncio
+import hashlib
+from unittest.mock import patch
+
+import pytest
+
+import dspy
+from dspy.clients.cache import Cache, request_cache
+
+
+@pytest.fixture
+def cache(tmp_path):
+    return Cache(False, True, str(tmp_path), memory_max_entries=20)
+
+
+def test_namespace_separates_keys_and_restores_nested_values(cache):
+    request = {"value": 1}
+    original = cache.cache_key(request)
+    cache.namespace = "outer"
+    assert cache.cache_key(request) == f"{hashlib.sha256(b'outer').hexdigest()[:8]}:{original}"
+
+    with cache.namespace("inner"):
+        assert cache.namespace.value == "inner"
+        with cache.namespace(None):
+            assert cache.cache_key(request) == original
+        assert cache.namespace == "inner"
+    assert cache.namespace == "outer"
+
+
+def test_namespaced_values_share_storage_without_colliding(cache):
+    request = {"value": 1}
+    with cache.namespace("first"):
+        cache.put(request, "one")
+    with cache.namespace("second"):
+        assert cache.get(request) is None
+        cache.put(request, "two")
+    with cache.namespace("first"):
+        assert cache.get(request) == "one"
+
+
+@pytest.mark.asyncio
+async def test_decorator_namespace_covers_async_call_and_restores(cache):
+    observed = []
+
+    @request_cache(namespace="fixed")
+    async def compute(value):
+        await asyncio.sleep(0)
+        observed.append(cache.namespace.value)
+        return value
+
+    with patch("dspy.cache", cache), cache.namespace("caller"):
+        assert await compute("value") == "value"
+        assert await compute("value") == "value"
+        assert cache.namespace == "caller"
+    assert observed == ["fixed"]
+
+
+def test_configure_cache_sets_and_clears_namespace(tmp_path):
+    with patch.object(dspy, "cache", None):
+        dspy.configure_cache(enable_disk_cache=False, disk_cache_dir=str(tmp_path), namespace="run")
+        assert dspy.cache.namespace == "run"
+        dspy.configure_cache(enable_disk_cache=False, disk_cache_dir=str(tmp_path), namespace=None)
+        assert dspy.cache.namespace.value is None
