+@pytest.mark.parametrize('tag', ['json', 'JSON', '', 'text', 'yaml'])
+@pytest.mark.parametrize('shape', ['single', 'list', 'canonical'])
+def test_toolcalls_fenced_normal_validation(tag, shape):
+    import json
+    from dspy import ToolCalls
+    call = {'name': 'search', 'args': {'q': 'snow'}}
+    value = {'single': call, 'list': [call], 'canonical': {'tool_calls': [call]}}[shape]
+    text = 'explanation\n```' + tag + '\n' + json.dumps(value) + '\n```\nafterward'
+    expected = {'tool_calls': [call]}
+    assert [item.model_dump() for item in ToolCalls.model_validate(text).tool_calls] == expected['tool_calls']
+    assert [item.model_dump() for item in ToolCalls.model_validate_json(json.dumps(text)).tool_calls] == expected['tool_calls']
+    assert ToolCalls.validate_input(text) == value
+
