+def test_toolcalls_raw_json_and_first_block_rules():
+    import json
+    from dspy import ToolCalls
+    call = {'name': 'search', 'args': {'literal': '``` is text'}}
+    assert [item.model_dump() for item in ToolCalls.model_validate(json.dumps(call)).tool_calls] == [call]
+    valid = '```json\n[]\n```'
+    assert ToolCalls.model_validate(valid).tool_calls == []
+    assert ToolCalls.model_validate(valid + '\n```json\n{}\n```').tool_calls == []
+    for text in ['```json\nnot-json\n```\n' + valid, '```json\n[]',
+                 '```[]```', 'explanation only', '```yaml\nname: search\n```']:
+        assert ToolCalls.validate_input(text) == text
+        with pytest.raises(ValueError):
+            ToolCalls.model_validate(text)
+
