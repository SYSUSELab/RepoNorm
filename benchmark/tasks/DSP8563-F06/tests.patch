+def test_toolcalls_fenced_chat_adapter_public_path():
+    import dspy
+    class Calls(dspy.Signature):
+        question: str = dspy.InputField()
+        calls: dspy.ToolCalls = dspy.OutputField()
+    completion = '[[ ## calls ## ]]\n```JSON\n[{"name":"search","args":{"q":"hello"}}]\n```\n[[ ## completed ## ]]'
+    parsed = dspy.ChatAdapter().parse(Calls, completion)
+    assert [item.model_dump() for item in parsed['calls'].tool_calls] == [{'name': 'search', 'args': {'q': 'hello'}}]
+
+
+def test_fences_do_not_bypass_toolcall_validation():
+    from dspy import ToolCalls
+    for body in ['[{"name":"missing-args"}]', '{"name":"x","args":[]}', '123']:
+        with pytest.raises(ValueError):
+            ToolCalls.model_validate('```json\n' + body + '\n```')
+
