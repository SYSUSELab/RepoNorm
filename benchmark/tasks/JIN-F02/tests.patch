+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_reverse_nested_one_shot(asynchronous):
+    import asyncio
+    from types import SimpleNamespace
+    from jinja2 import Environment
+    env = Environment(enable_async=asynchronous)
+    rows = [SimpleNamespace(p=[{"k": k}], id=i) for i, k in enumerate([2, 1, 2, 3, 1])]
+    async def stream():
+        for row in rows:
+            yield row
+    result = env.call_filter("groupby", stream() if asynchronous else iter(rows), ["p.0.k"], {"reverse": True})
+    if asynchronous:
+        result = asyncio.run(result)
+    assert [g.grouper for g in result] == [3, 2, 1]
+    assert [r.id for r in result[1].list] == [0, 2]
+    assert tuple(result[1]) == (2, [rows[0], rows[2]])
+    result = env.call_filter("groupby", iter([]), [0], {"reverse": True})
+    if asynchronous:
+        result = asyncio.run(result)
+    assert result == []
