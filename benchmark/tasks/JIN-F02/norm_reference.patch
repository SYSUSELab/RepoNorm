diff --git a/tests/test_groupby_reverse_contribution.py b/tests/test_groupby_reverse_contribution.py
new file mode 100644
index 00000000..a4cead74
--- /dev/null
+++ b/tests/test_groupby_reverse_contribution.py
@@ -0,0 +1,39 @@
+import asyncio
+
+from jinja2 import Environment
+
+
+def test_groupby_reverse_preserves_member_order():
+    env = Environment()
+    rows = [
+        {"key": 2, "id": "first"},
+        {"key": 1, "id": "middle"},
+        {"key": 2, "id": "last"},
+    ]
+    groups = env.call_filter("groupby", iter(rows), ["key"], {"reverse": True})
+    assert [group.grouper for group in groups] == [2, 1]
+    assert [item["id"] for item in groups[0].list] == ["first", "last"]
+
+
+def test_groupby_reverse_keeps_default_and_tuple_interface():
+    env = Environment()
+    rows = [{"key": 1}, {}, {"key": 2}]
+    groups = env.call_filter("groupby", rows, ["key"], {"default": 0, "reverse": True})
+    assert [group.grouper for group in groups] == [2, 1, 0]
+    assert tuple(groups[-1]) == (0, [{}])
+
+
+def test_groupby_reverse_empty_input():
+    env = Environment()
+    assert env.call_filter("groupby", iter(()), [0], {"reverse": True}) == []
+
+
+def test_async_groupby_reverse_accepts_async_iterable():
+    env = Environment(enable_async=True)
+
+    async def rows():
+        for key in [1, 3, 2]:
+            yield {"key": key}
+
+    groups = asyncio.run(env.call_filter("groupby", rows(), ["key"], {"reverse": True}))
+    assert [group.grouper for group in groups] == [3, 2, 1]
