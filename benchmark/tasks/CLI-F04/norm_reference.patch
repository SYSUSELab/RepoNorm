     def command_path(self) -> str:
diff --git a/tests/test_cleanup_timeout_contribution.py b/tests/test_cleanup_timeout_contribution.py
new file mode 100644
index 0000000..8265c57
--- /dev/null
+++ b/tests/test_cleanup_timeout_contribution.py
@@ -0,0 +1,121 @@
+import threading
+import time
+from contextlib import contextmanager
+
+import pytest
+
+import click
+
+
+def test_cleanup_timeout_inherits_and_validates() -> None:
+    root = click.Context(click.Command("root"), cleanup_timeout=0.5)
+    assert click.Context(click.Command("child"), parent=root).cleanup_timeout == 0.5
+    assert (
+        click.Context(
+            click.Command("child"), parent=root, cleanup_timeout=1
+        ).cleanup_timeout
+        == 1
+    )
+
+    for value in (0, -1):
+        with pytest.raises(ValueError):
+            click.Context(click.Command("bad"), cleanup_timeout=value)
+
+
+def test_untimed_cleanup_remains_synchronous_and_lifo() -> None:
+    events = []
+    ctx = click.Context(click.Command("cmd"))
+    ctx.call_on_close(lambda: events.append("first"))
+    ctx.call_on_close(lambda: events.append("last"))
+    ctx.close()
+    assert events == ["last", "first"]
+
+
+def test_timed_cleanup_preserves_resource_and_callback_lifo() -> None:
+    events = []
+
+    @contextmanager
+    def resource():
+        events.append("enter")
+        try:
+            yield
+        finally:
+            events.append("exit")
+
+    ctx = click.Context(click.Command("cmd"), cleanup_timeout=1)
+    ctx.call_on_close(lambda: events.append("first"))
+    ctx.with_resource(resource())
+    ctx.call_on_close(lambda: events.append("last"))
+    ctx.close()
+    assert events == ["enter", "last", "exit", "first"]
+
+
+def test_timeout_returns_and_late_error_is_reported(monkeypatch) -> None:
+    started = threading.Event()
+    release = threading.Event()
+    reported = threading.Event()
+    diagnostics = []
+
+    def record_diagnostic(message, **kwargs) -> None:
+        diagnostics.append(str(message))
+        if "late-cleanup" in str(message):
+            reported.set()
+
+    monkeypatch.setattr(click.core, "echo", record_diagnostic)
+    ctx = click.Context(click.Command("cmd"), cleanup_timeout=0.02)
+
+    def cleanup() -> None:
+        started.set()
+        assert release.wait(2)
+        raise RuntimeError("late-cleanup")
+
+    ctx.call_on_close(cleanup)
+    before = time.monotonic()
+    ctx.close()
+    assert time.monotonic() - before < 1
+    assert started.wait(1)
+    assert any("timed out" in item.lower() for item in diagnostics)
+    release.set()
+    assert reported.wait(2)
+    assert any("late-cleanup" in item for item in diagnostics)
+
+
+def test_registrations_during_cleanup_form_the_next_batch() -> None:
+    events = []
+    ctx = click.Context(click.Command("cmd"), cleanup_timeout=1)
+
+    def first_batch() -> None:
+        events.append("first")
+        ctx.call_on_close(lambda: events.append("second"))
+
+    ctx.call_on_close(first_batch)
+    ctx.close()
+    assert events == ["first"]
+    ctx.close()
+    ctx.close()
+    assert events == ["first", "second"]
+
+
+def test_new_batch_closes_while_timed_out_batch_finishes() -> None:
+    events = []
+    started = threading.Event()
+    release = threading.Event()
+    ctx = click.Context(click.Command("cmd"), cleanup_timeout=0.02)
+
+    def old_batch() -> None:
+        events.append("old-start")
+        started.set()
+        assert release.wait(2)
+        events.append("old-end")
+
+    ctx.call_on_close(old_batch)
+    ctx.close()
+    assert started.wait(1)
+    ctx.call_on_close(lambda: events.append("new"))
+    ctx.close()
+    assert events == ["old-start", "new"]
+    release.set()
+    deadline = time.monotonic() + 2
+    while time.monotonic() < deadline and events[-1] != "old-end":
+        time.sleep(0.01)
+    assert events == ["old-start", "new", "old-end"]
