+def test_cleanup_timeout_generations_and_late_error(capfd, recwarn):
+    events = []
+    release = threading.Event()
+    started = threading.Event()
+    ctx = click.Context(click.Command("test"), cleanup_timeout=0.05)
+
+    def old():
+        events.append("old-start")
+        started.set()
+        assert release.wait(5)
+        events.append("old-end")
+        raise ValueError("late-generation-error")
+
+    ctx.call_on_close(old)
+    try:
+        ctx.close()
+        assert started.wait(1)
+        ctx.call_on_close(lambda: events.append("new"))
+        ctx.close()
+        ctx.close()
+        assert events == ["old-start", "new"]
+        release.set()
+        deadline = time.monotonic() + 3
+        output = ""
+        while time.monotonic() < deadline:
+            output += capfd.readouterr().err
+            output += "\n".join(str(item.message) for item in recwarn)
+            if "late-generation-error" in output:
+                break
+            time.sleep(0.01)
+        assert "late-generation-error" in output
+        assert events == ["old-start", "new", "old-end"]
+    finally:
+        release.set()
+
+
+def test_cleanup_timeout_preserves_new_resources_registered_by_cleanup():
+    events = []
+    ctx = click.Context(click.Command("test"), cleanup_timeout=2)
+
+    def first_generation():
+        events.append("first")
+        ctx.call_on_close(lambda: events.append("second"))
+
+    ctx.call_on_close(first_generation)
+    ctx.close()
+    assert events == ["first"]
+    ctx.close()
+    assert events == ["first", "second"]
