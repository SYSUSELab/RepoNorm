+def test_ctrans_condition_once_and_lazy_fallback():
+    env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"]); env.install_null_translations()
+    seen=[]
+    template=env.from_string('{% ctrans decide() %}Hello{% fallback %}{{ fail() }}{% endctrans %}')
+    assert template.render(decide=lambda: seen.append("condition") or True, fail=lambda: 1/0) == "Hello"
+    assert seen == ["condition"]
+
+
+def test_ctrans_fallback_is_normal_jinja_body():
+    env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"]); env.install_null_translations()
+    source='{% ctrans enabled %}yes{% fallback %}{% if items %}{{ items|join(",") }}{% else %}none{% endif %}{% endctrans %}'
+    assert env.from_string(source).render(enabled=False, items=["a", "b"]) == "a,b"
+
+
+def test_ctrans_plural_context_and_extraction():
+    env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"]); env.install_null_translations()
+    source='{% ctrans enabled, context="menu", n=n %}one{% pluralize %}many{% fallback %}off{% endctrans %}'
+    assert env.from_string(source).render(enabled=True, n=2) == "many"
+    assert env.from_string(source).render(enabled=False, n=2) == "off"
+    assert list(env.extract_translations(source))[0][1] == "npgettext"
+
+
+def test_ctrans_requires_fallback_and_literal_context():
+    env = Environment(extensions=["jinja2.ext.conditional_i18n"])
+    with pytest.raises(TemplateSyntaxError, match="fallback"):
+        env.from_string("{% ctrans ok %}x{% endctrans %}")
+    with pytest.raises(TemplateAssertionError, match="string literal"):
+        env.from_string("{% ctrans ok, context=value %}x{% fallback %}y{% endctrans %}")
