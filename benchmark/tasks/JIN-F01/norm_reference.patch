diff --git a/tests/test_groupby_case_contribution.py b/tests/test_groupby_case_contribution.py
new file mode 100644
index 00000000..1f867241
--- /dev/null
+++ b/tests/test_groupby_case_contribution.py
@@ -0,0 +1,44 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+
+
+@pytest.mark.parametrize(
+    ("case_sensitive", "keys", "members"),
+    [
+        (False, ["a", "b"], [[1, 3], [2]]),
+        (True, ["A", "a", "b"], [[3], [1], [2]]),
+    ],
+)
+def test_groupby_case_behavior(case_sensitive, keys, members):
+    env = Environment()
+    rows = [{"key": "a", "id": 1}, {"key": "b", "id": 2}, {"key": "A", "id": 3}]
+    groups = env.call_filter(
+        "groupby", iter(rows), ["key"], {"case_sensitive": case_sensitive}
+    )
+    assert [group.grouper for group in groups] == keys
+    assert [[item["id"] for item in group.list] for group in groups] == members
+
+
+def test_groupby_preserves_default_and_tuple_interface():
+    env = Environment()
+    groups = env.call_filter("groupby", [{}, {"key": "NA"}], ["key"], {"default": "na"})
+    assert len(groups) == 1
+    assert tuple(groups[0]) == ("na", [{}, {"key": "NA"}])
+    assert str(groups[0]) == str(tuple(groups[0]))
+
+
+def test_async_groupby_accepts_async_iterable():
+    env = Environment(enable_async=True)
+
+    async def rows():
+        for key in ["a", "A", "b"]:
+            yield {"key": key}
+
+    groups = asyncio.run(
+        env.call_filter("groupby", rows(), ["key"], {"case_sensitive": False})
+    )
+    assert [group.grouper for group in groups] == ["a", "b"]
+    assert [len(group.list) for group in groups] == [2, 1]
