+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_case_paths_and_unicode(asynchronous):
+    import asyncio
+    from jinja2 import Environment
+
+    env = Environment(enable_async=asynchronous)
+    rows = [{"p": [{"k": x}], "id": i} for i, x in enumerate(["Ä", "z", "ä", "SS", "ß"])]
+    async def stream():
+        for row in rows:
+            yield row
+    result = env.call_filter("groupby", stream() if asynchronous else iter(rows), ["p.0.k"])
+    if asynchronous:
+        result = asyncio.run(result)
+    assert [g.grouper for g in result] == ["SS", "z", "ß", "Ä"]
+    assert result[-1].list == [rows[0], rows[2]]
+    assert tuple(result[-1]) == ("Ä", [rows[0], rows[2]])
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_case_default_and_numeric(asynchronous):
+    import asyncio
+    from jinja2 import Environment
+
+    env = Environment(enable_async=asynchronous)
+    result = env.call_filter("groupby", [{}, {"k": "NA"}], ["k"], {"default": "na"})
+    if asynchronous:
+        result = asyncio.run(result)
+    assert len(result) == 1 and result[0].grouper == "na"
+    result = env.call_filter("groupby", [(2, "a"), (1, "b"), (2, "c")], [0])
+    if asynchronous:
+        result = asyncio.run(result)
+    assert [g.grouper for g in result] == [1, 2]
+    assert result[1].list == [(2, "a"), (2, "c")]
