+    You can limit the number of groups returned by specifying ``max_groups``.
+    This is useful for displaying "top N" groups.
+
+    .. sourcecode:: jinja
+
+        <ul>{% for city, items in users|groupby("city", max_groups=3) %}
+          <li>{{ city }}: {{ items|map(attribute="name")|join(", ") }}</li>
+        {% endfor %}</ul>
+
     .. versionchanged:: 3.0
         Added the ``default`` parameter.
 
@@ -1210,11 +1220,18 @@ def sync_do_groupby(
         The attribute supports dot notation for nested access.
     """
     expr = make_attrgetter(environment, attribute, default=default)
-    return [
+    if max_groups is not None and (type(max_groups) is not int or max_groups < 0):
+        raise FilterArgumentError("max_groups must be a nonnegative integer or None")
+    groups = [
         _GroupTuple(key, list(values))
         for key, values in groupby(sorted(value, key=expr), expr)
     ]
 
+    if max_groups is not None:
+        return groups[:max_groups]
+
+    return groups
+
 
