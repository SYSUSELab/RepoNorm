diff --git a/tests/test_groupby_limit_contribution.py b/tests/test_groupby_limit_contribution.py
new file mode 100644
index 00000000..1c10a988
--- /dev/null
+++ b/tests/test_groupby_limit_contribution.py
@@ -0,0 +1,42 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
+
+
+def test_groupby_limit_keeps_complete_first_group():
+    env = Environment()
+    rows = [{"key": 2}, {"key": 1, "id": "a"}, {"key": 1, "id": "b"}]
+    groups = env.call_filter("groupby", iter(rows), ["key"], {"max_groups": 1})
+    assert [group.grouper for group in groups] == [1]
+    assert groups[0].list == rows[1:]
+
+
+def test_groupby_limit_zero_and_default():
+    env = Environment()
+    assert (
+        env.call_filter(
+            "groupby", [{}, {"key": 1}], ["key"], {"default": 0, "max_groups": 0}
+        )
+        == []
+    )
+
+
+@pytest.mark.parametrize("limit", [-1, 1.5, "1", True])
+def test_groupby_limit_rejects_invalid_values(limit):
+    env = Environment()
+    with pytest.raises(FilterArgumentError):
+        env.call_filter("groupby", [], ["key"], {"max_groups": limit})
+
+
+def test_async_groupby_limit_accepts_async_iterable():
+    env = Environment(enable_async=True)
+
+    async def rows():
+        for key in [2, 1, 3]:
+            yield {"key": key}
+
+    groups = asyncio.run(env.call_filter("groupby", rows(), ["key"], {"max_groups": 2}))
+    assert [group.grouper for group in groups] == [1, 2]
