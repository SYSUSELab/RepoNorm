+    def _validate_trans_variables(
+        self, variables: t.Dict[str, nodes.Expr], parser: "Parser", lineno: int
+    ) -> None:
+        """Validate names and expressions declared by a translation block."""
+        reserved = {"gettext", "ngettext", "pgettext", "npgettext", "_"}
+        for name, expression in variables.items():
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r}; translation variables must be Python identifiers.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            if name in reserved:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            if not self._is_valid_trans_expression(expression):
+                parser.fail(
+                    f"Variable {name!r} uses template data that is not allowed in translation contexts.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+    def _is_valid_trans_expression(self, expression: nodes.Expr) -> bool:
+        if isinstance(expression, (nodes.Const, nodes.Name)):
+            return True
+        if isinstance(expression, nodes.Getattr):
+            return self._is_valid_trans_expression(expression.node)
+        if isinstance(expression, nodes.Call):
+            if not isinstance(expression.node, nodes.Name):
+                return False
+        elif not isinstance(expression, (nodes.Filter, nodes.Test)):
+            return False
+        if not self._is_valid_trans_expression(expression.node):
+            return False
+        if any(not self._is_valid_trans_expression(arg) for arg in expression.args):
+            return False
+        if any(not self._is_valid_trans_expression(item.value) for item in expression.kwargs):
+            return False
+        return expression.dyn_args is None and expression.dyn_kwargs is None
+
