+class TestTranslationVariableValidation:
+    @pytest.fixture
+    def env(self):
+        env = Environment(extensions=["jinja2.ext.i18n"])
+        env.install_null_translations()
+        return env
+
+    @pytest.mark.parametrize("name", ["gettext", "ngettext", "pgettext", "npgettext", "_"])
+    def test_reserved_declared_name(self, env, name):
+        source = "{% trans " + name + "=1 %}{{ " + name + " }}{% endtrans %}"
+        with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names") as exc_info:
+            env.from_string(source)
+        assert name in str(exc_info.value)
+
+    @pytest.mark.parametrize("name", ["gettext", "ngettext", "pgettext", "npgettext", "_"])
+    def test_reserved_body_name(self, env, name):
+        source = "{% trans %}{{ " + name + " }}{% endtrans %}"
+        with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names"):
+            env.from_string(source)
+
+    @pytest.mark.parametrize("expression", [
+        "42", "value", "make(value)", "user.name",
+        "value|default('x')", "value is defined", "user.name|upper",
+    ])
+    def test_allowed_expressions(self, env, expression):
+        env.from_string("{% trans item=" + expression + " %}{{ item }}{% endtrans %}")
+
+    @pytest.mark.parametrize("expression", [
+        "items[0]", "left + right", "value if enabled else other",
+        "user.make()", "make(items[0])", "items[0]|default('x')",
+    ])
+    def test_rejected_expressions(self, env, expression):
+        with pytest.raises(TemplateSyntaxError, match="template data.*translation contexts") as exc_info:
+            env.from_string("{% trans item=" + expression + " %}{{ item }}{% endtrans %}")
+        assert "item" in str(exc_info.value)
+
+    def test_unicode_identifier_plural_and_trimmed(self, env):
+        template = env.from_string(
+            "{% trans количество=2, trimmed %} {{ количество }} item "
+            "{% pluralize %} {{ количество }} items {% endtrans %}"
+        )
+        assert template.render() == "2 items"
+
+    def test_duplicate_keeps_existing_error(self, env):
+        with pytest.raises(TemplateAssertionError, match="defined twice"):
+            env.from_string("{% trans value=1, value=2 %}{{ value }}{% endtrans %}")
