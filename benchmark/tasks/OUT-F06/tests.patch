 import pytest
+from unittest.mock import Mock
+
+
+@pytest.mark.parametrize("factory,compile_method", [
+    ("get_json_schema_logits_processor", "compile_json_schema"),
+    ("get_regex_logits_processor", "compile_regex"),
+    ("get_cfg_logits_processor", "compile_grammar"),
+])
+def test_v5_validator_default_override_disable(model_transformers, factory, compile_method):
+    events = []
+    default = Mock(side_effect=lambda s: events.append(("default", s)))
+    override = Mock(side_effect=lambda s: events.append(("override", s)))
+    backend = XGrammarBackend(model_transformers, validate_grammar=default)
+    compiler = Mock(side_effect=lambda s: events.append(("compile", s)))
+    backend.grammar_compiler = Mock(**{compile_method: compiler})
+    method = getattr(backend, factory)
+    source = "  raw grammar\n"
+    method(source)
+    assert events == [("default", source), ("compile", source)]
+    events.clear()
+    method(source, validate_grammar=override)
+    assert events == [("override", source), ("compile", source)]
+    events.clear()
+    method(source, validate_grammar=None)
+    assert events == [("compile", source)]
+    error = RuntimeError("rejected")
+    bad = Mock(side_effect=error)
+    before = compiler.call_count
+    with pytest.raises(RuntimeError) as caught:
+        method(source, validate_grammar=bad)
+    assert caught.value is error and compiler.call_count == before
+    bad.assert_called_once_with(source)
+    events.clear()
+    method(source)
+    assert events == [("default", source), ("compile", source)]
+    method(source, validate_grammar=lambda _: False)  # Only exceptions reject.
+    fresh = XGrammarBackend(model_transformers)
+    fresh.grammar_compiler = Mock()
+    calls = default.call_count
+    getattr(fresh, factory)(source)
+    assert default.call_count == calls
+    assert getattr(fresh.grammar_compiler, compile_method).call_count == 1
 
