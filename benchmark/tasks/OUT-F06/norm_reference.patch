diff --git a/tests/backends/test_xgrammar_contribution.py b/tests/backends/test_xgrammar_contribution.py
new file mode 100644
index 00000000..28db4850
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,67 @@
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import xgrammar as xgr
+
+from outlines.backends.xgrammar import XGrammarBackend
+from outlines.models.transformers import Transformers
+
+
+@pytest.fixture
+def model(monkeypatch):
+    model = Mock(spec=Transformers)
+    model.model = SimpleNamespace(config=SimpleNamespace(_name_or_path="local"))
+    model.hf_tokenizer = object()
+    monkeypatch.setattr(
+        "transformers.AutoConfig.from_pretrained",
+        lambda *args, **kwargs: SimpleNamespace(vocab_size=5),
+    )
+    info = xgr.TokenizerInfo(
+        ["a", "b", "c", "d", "<eos>"], stop_token_ids=[4]
+    )
+    monkeypatch.setattr(
+        xgr.TokenizerInfo,
+        "from_huggingface",
+        lambda *args, **kwargs: info,
+    )
+    return model
+
+
+@pytest.mark.parametrize(
+    "factory,compile_method",
+    [
+        ("get_json_schema_logits_processor", "compile_json_schema"),
+        ("get_regex_logits_processor", "compile_regex"),
+        ("get_cfg_logits_processor", "compile_grammar"),
+    ],
+)
+def test_validator_inheritance_override_and_disable(model, factory, compile_method):
+    events = []
+    default = Mock(side_effect=lambda value: events.append(("default", value)))
+    override = Mock(side_effect=lambda value: events.append(("override", value)))
+    backend = XGrammarBackend(model, validate_grammar=default)
+    compiler = Mock(side_effect=lambda value: events.append(("compile", value)))
+    backend.grammar_compiler = Mock(**{compile_method: compiler})
+    method = getattr(backend, factory)
+    source = "  original source\n"
+
+    method(source)
+    assert events == [("default", source), ("compile", source)]
+    events.clear()
+    method(source, validate_grammar=override)
+    assert events == [("override", source), ("compile", source)]
+    events.clear()
+    method(source, validate_grammar=None)
+    assert events == [("compile", source)]
+
+    error = RuntimeError("rejected")
+    before = compiler.call_count
+    with pytest.raises(RuntimeError) as caught:
+        method(source, validate_grammar=Mock(side_effect=error))
+    assert caught.value is error
+    assert compiler.call_count == before
+
+    events.clear()
+    method(source)
+    assert events == [("default", source), ("compile", source)]
