+def test_translation_cache_hit_keys_and_clear():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    calls = []
+    def gettext(message): calls.append(("g", message)); return "T:" + message
+    def ngettext(singular, plural, n): calls.append(("n", singular, plural, n)); return singular if n == 1 else plural
+    env.install_gettext_callables(gettext, ngettext, pgettext=lambda c, m: c + m, npgettext=lambda c, s, p, n: c + (s if n == 1 else p), cache_size=8)
+    template = env.from_string("{% trans %}Hello{% endtrans %}")
+    assert template.render() == "T:Hello"
+    assert template.render() == "T:Hello"
+    assert calls == [("g", "Hello")]
+    env.clear_translation_cache()
+    template.render()
+    assert len(calls) == 2
+
+
+def test_translation_cache_plural_n_and_lru():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    calls = []
+    def ng(s, p, n): calls.append(n); return s if n == 1 else p
+    env.install_gettext_callables(lambda x: x, ng, cache_size=1)
+    template = env.from_string("{% trans n=n %}one{% pluralize %}many{% endtrans %}")
+    template.render(n=1); template.render(n=2); template.render(n=1)
+    assert calls == [1, 2, 1]
+
+
+def test_translation_cache_partition_and_reinstall():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    calls = []
+    env.install_gettext_callables(lambda x: calls.append("a") or "A", lambda s,p,n:p, cache_size=2, cache_partition="en")
+    template = env.from_string("{% trans %}x{% endtrans %}")
+    assert template.render() == "A"; assert template.render() == "A"
+    env.set_translation_cache_partition("fr")
+    assert template.render() == "A"
+    env.install_gettext_callables(lambda x: calls.append("b") or "B", lambda s,p,n:p, cache_size=2, cache_partition="fr")
+    assert env.from_string("{% trans %}x{% endtrans %}").render() == "B"
+    assert calls == ["a", "a", "b"]
+
+
+def test_translation_cache_disabled_by_default():
+    env = Environment(extensions=["jinja2.ext.i18n"]); calls=[]
+    env.install_gettext_callables(lambda x: calls.append(x) or x, lambda s,p,n:p)
+    template=env.from_string("{% trans %}x{% endtrans %}"); template.render(); template.render()
+    assert calls == ["x", "x"]
+
+
+def test_translation_cache_overlay_isolation():
+    env = Environment(extensions=["jinja2.ext.i18n"]); calls=[]
+    env.install_gettext_callables(lambda x: calls.append(x) or x, lambda s,p,n:p, cache_size=2)
+    template = env.from_string("{% trans %}x{% endtrans %}"); template.render()
+    overlay = env.overlay(); overlay.clear_translation_cache()
+    assert template.render() == "x"
+    assert calls == ["x"]
+
+
+@pytest.mark.parametrize("first_escape", [False, True])
+def test_cached_translation_formats_each_render_in_current_eval_context(first_escape):
+    env = Environment(extensions=["jinja2.ext.i18n"], autoescape=False)
+    calls = []
+
+    def translated(message):
+        calls.append(message)
+        return "<b>%(name)s</b>"
+
+    env.install_gettext_callables(
+        translated, lambda singular, plural, n: plural, newstyle=True, cache_size=2
+    )
+    template = env.from_string(
+        '{% autoescape enabled %}{{ gettext("Hello", name=name) }}{% endautoescape %}'
+    )
+    for enabled, name in ((first_escape, "<first>"), (not first_escape, "<second>")):
+        expected = name.replace("<", "&lt;").replace(">", "&gt;") if enabled else name
+        assert template.render(enabled=enabled, name=name) == f"<b>{expected}</b>"
+    assert calls == ["Hello"]
