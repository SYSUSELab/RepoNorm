index 00000000..94d2ed09
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,84 @@
+import logging
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+from outlines.processors.base_logits_processor import OutlinesLogitsProcessor
+
+
+class FallbackProcessor(OutlinesLogitsProcessor):
+    def __init__(self):
+        super().__init__("torch")
+        self.calls = 0
+        self.resets = 0
+
+    def process_logits(self, input_ids, logits):
+        self.calls += 1
+        return logits + 20
+
+    def reset(self):
+        self.resets += 1
+
+
+def test_fallback_is_late_sticky_and_resettable(monkeypatch, caplog):
+    primary = Mock(side_effect=[lambda: None])
+    primary.side_effect = lambda input_ids, logits: (
+        logits + 10
+        if primary.call_count < 3
+        else (_ for _ in ()).throw(RuntimeError("grammar failed"))
+    )
+    constructor = Mock(return_value=primary)
+    monkeypatch.setattr("xgrammar.contrib.hf.LogitsProcessor", constructor)
+    fallback = FallbackProcessor()
+    processor = XGrammarLogitsProcessor("grammar", fallback)
+    scores = torch.zeros(4)
+
+    assert torch.equal(processor(torch.tensor([1]), scores), scores + 10)
+    assert torch.equal(processor(torch.tensor([1, 2]), scores), scores + 10)
+    assert fallback.calls == 0
+
+    caplog.set_level(logging.WARNING)
+    assert torch.equal(processor(torch.tensor([1, 2, 3]), scores), scores + 20)
+    assert len(caplog.records) == 1
+    assert torch.equal(processor(torch.tensor([1, 2, 3, 4]), scores), scores + 20)
+    assert primary.call_count == 3
+    assert len(caplog.records) == 1
+
+    processor.reset()
+    assert fallback.resets == 1
+    primary.side_effect = lambda input_ids, logits: logits + 10
+    assert torch.equal(processor(torch.tensor([1]), scores), scores + 10)
+    assert primary.call_count == 4
+
+
+def test_primary_error_is_preserved_without_fallback(monkeypatch):
+    error = RuntimeError("grammar failed")
+    monkeypatch.setattr("xgrammar.contrib.hf.LogitsProcessor", Mock(side_effect=error))
+    processor = XGrammarLogitsProcessor("grammar")
+
+    with pytest.raises(RuntimeError) as caught:
+        processor(torch.tensor([1]), torch.zeros(4))
+
+    assert caught.value is error
+
+
+@pytest.mark.parametrize(
+    "factory,compile_method,source",
+    [
+        ("get_json_schema_logits_processor", "compile_json_schema", "{}"),
+        ("get_regex_logits_processor", "compile_regex", "a|b"),
+        ("get_cfg_logits_processor", "compile_grammar", 'root ::= "a"'),
+    ],
+)
+def test_backend_factories_forward_fallback(factory, compile_method, source):
+    backend = object.__new__(XGrammarBackend)
+    compiler = Mock()
+    setattr(compiler, compile_method, Mock(return_value="compiled"))
+    backend.grammar_compiler = compiler
+    fallback = FallbackProcessor()
+
+    processor = getattr(backend, factory)(source, fallback)
+
+    assert processor.fallback_processor is fallback
