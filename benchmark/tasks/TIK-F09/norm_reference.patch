@@ -0,0 +1,48 @@
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def byte_encoding():
+    return tiktoken.Encoding(
+        "byte-compression",
+        pat_str=r"[\s\S]",
+        mergeable_ranks={bytes([i]): i for i in range(256)},
+        special_tokens={"<X>": 256},
+    )
+
+
+@pytest.mark.parametrize(
+    "text,expected",
+    [
+        ("", []),
+        ("a", [97]),
+        ("aaabbaa", [97, 98, 97]),
+        ("abab", [97, 98, 97, 98]),
+    ],
+)
+def test_compression_collapses_only_adjacent_runs(byte_encoding, text, expected) -> None:
+    assert byte_encoding.encode(text, compress=True) == expected
+
+
+def test_default_result_is_unchanged(byte_encoding) -> None:
+    assert byte_encoding.encode("aaabbaa", compress=False) == byte_encoding.encode(
+        "aaabbaa"
+    )
+
+
+def test_special_policy_and_surrogate_recovery_are_preserved(byte_encoding) -> None:
+    with pytest.raises(ValueError, match="disallowed special token"):
+        byte_encoding.encode("<X>", compress=True)
+    assert byte_encoding.encode(
+        "<X><X>", allowed_special="all", compress=True
+    ) == [256]
+
+    text = "before \ud800 after"
+    ordinary = byte_encoding.encode(text)
+    expected = [ordinary[0]]
+    for token in ordinary[1:]:
+        if token != expected[-1]:
+            expected.append(token)
+    assert byte_encoding.encode(text, compress=True) == expected
