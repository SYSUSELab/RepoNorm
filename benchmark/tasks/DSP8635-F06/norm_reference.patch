+def _process_instruction_length_bounds(
+    instruction, min_chars, max_chars, rephrase_when_too_long, basic_instruction, prompt_model, verbose=False
+):
+    import re
+
+    instruction = instruction.strip()
+    if len(instruction) < min_chars:
+        if verbose:
+            print(f"Instruction too short ({len(instruction)} chars < {min_chars}); using basic instruction")
+        instruction = basic_instruction
+    elif len(instruction) > max_chars and rephrase_when_too_long:
+        if verbose:
+            print(f"Instruction too long ({len(instruction)} chars > {max_chars}); requesting one rephrase")
+        with dspy.settings.context(lm=prompt_model):
+            shortened = dspy.Predict(ShortenInstruction)(
+                long_instruction=instruction, max_chars=max_chars
+            ).proposed_instruction
+        instruction = strip_prefix(shortened).strip()
+        if len(instruction) < min_chars:
+            instruction = basic_instruction
+        return instruction[:max_chars]
+    if len(instruction) <= max_chars:
+        return instruction
+    if verbose:
+        print(f"Instruction too long ({len(instruction)} chars > {max_chars}); trimming")
+    if max_chars == 0:
+        return ""
+    window = instruction[: max_chars - 1]
+    boundaries = [match.end() for match in re.finditer(r"[.!?](?=\s|$)", window)]
+    prefix = window[: boundaries[-1]] if boundaries else window
+    return prefix.rstrip() + "…"
+
+
