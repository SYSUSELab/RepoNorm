+import pytest
+
+import dspy
+from dspy.propose import grounded_proposer
+from dspy.propose.grounded_proposer import GroundedProposer
+from dspy.utils.dummies import DummyLM
+
+
+@pytest.mark.parametrize(
+    ("instruction", "minimum", "maximum", "basic", "expected"),
+    [
+        ("short", 10, 40, "canonical instruction", "canonical instruction"),
+        ("First. second sentence", 0, 12, "basic", "First.…"),
+        ("no boundary here", 0, 8, "basic", "no boun…"),
+        ("anything", 0, 0, "basic", ""),
+    ],
+)
+def test_instruction_length_fallback_and_trimming(instruction, minimum, maximum, basic, expected):
+    helper = getattr(grounded_proposer, "_process_instruction_length_bounds", None)
+    assert helper is not None
+    assert helper(instruction, minimum, maximum, False, basic, None) == expected
+
+
+@pytest.mark.parametrize("bounds", [(True, 10), (0, False), (-1, 10), (11, 10), (1.5, 10)])
+def test_instruction_bounds_reject_invalid_values(bounds):
+    with pytest.raises(ValueError, match="nonnegative integers"):
+        GroundedProposer(
+            prompt_model=DummyLM([{"proposed_instruction": "instruction"}]),
+            program=dspy.Predict("question -> answer"),
+            trainset=[],
+            program_aware=False,
+            use_dataset_summary=False,
+            min_instr_chars=bounds[0],
+            max_instr_chars=bounds[1],
+        )
