+def test_xgrammar_temperature_scales_logits_before_constraints():
+    """Observe the exact tensor received by the grammar processor."""
+    import torch
+
+    class CapturingGrammarProcessor:
+        def __init__(self):
+            self.received_logits = None
+
+        def __call__(self, input_ids, logits):
+            self.received_logits = logits.clone()
+            return logits
+
+    processor = XGrammarLogitsProcessor("unused", temperature=0.5)
+    grammar_processor = CapturingGrammarProcessor()
+    processor.xgrammar_logits_processor = grammar_processor
+    logits = torch.tensor([[2.0, 4.0]])
+
+    result = processor.process_logits(torch.tensor([[1]]), logits)
+
+    assert torch.equal(grammar_processor.received_logits, torch.tensor([[4.0, 8.0]]))
+    assert torch.equal(result, torch.tensor([[4.0, 8.0]]))
+
