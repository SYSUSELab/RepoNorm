+@pytest.mark.parametrize("batched", [False, True])
+@pytest.mark.parametrize("temperature", [0.5, 1.0, 2.0])
+def test_v5_public_temperature_mask_and_reset(batched, temperature):
+    import torch
+    import xgrammar as xgr
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo(["a", "b", "c", "d", "<eos>"], stop_token_ids=[4]))
+    grammar = compiler.compile_regex("(a|b)(c|d)")
+    processor = XGrammarLogitsProcessor(grammar, temperature=temperature)
+    scores = torch.tensor([2., 4., 6., 8., 10.], dtype=torch.float32)
+    ids = torch.tensor([4])
+    if batched:
+        scores, ids = scores.unsqueeze(0), ids.unsqueeze(0)
+    for _ in range(2):
+        first = processor(ids, scores.clone())
+        assert first.shape == scores.shape and first.dtype == scores.dtype and first.device == scores.device
+        assert torch.equal(first.reshape(-1)[:2], scores.reshape(-1)[:2] / temperature)
+        assert torch.isneginf(first.reshape(-1)[2:]).all()
+        next_ids = torch.tensor([[4, 0]]) if batched else torch.tensor([4, 0])
+        second = processor(next_ids, scores.clone()).reshape(-1)
+        assert torch.equal(second[2:4], scores.reshape(-1)[2:4] / temperature)
+        assert torch.isneginf(second[[0, 1, 4]]).all()
+        processor.reset()
+
