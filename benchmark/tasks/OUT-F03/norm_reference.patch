diff --git a/tests/backends/test_xgrammar_contribution.py b/tests/backends/test_xgrammar_contribution.py
new file mode 100644
index 00000000..1446e52e
--- /dev/null
+++ b/tests/backends/test_xgrammar_contribution.py
@@ -0,0 +1,52 @@
+from unittest.mock import Mock
+
+import pytest
+import torch
+import xgrammar as xgr
+
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+
+
+def test_temperature_scales_before_constraints_and_survives_reset(monkeypatch):
+    seen = []
+
+    class RecordingProcessor:
+        def __init__(self, grammar):
+            self.grammar = grammar
+
+        def __call__(self, input_ids, logits):
+            seen.append(logits.clone())
+            return logits
+
+    monkeypatch.setattr(xgr.contrib.hf, "LogitsProcessor", RecordingProcessor)
+    processor = XGrammarLogitsProcessor(object(), temperature=2.0)
+    result = processor(torch.tensor([1]), torch.tensor([2.0, 4.0]))
+
+    assert torch.equal(result, torch.tensor([1.0, 2.0]))
+    assert torch.equal(seen[0].squeeze(0), result)
+    processor.reset()
+    assert processor.temperature == 2.0
+
+
+@pytest.mark.parametrize("value", [0, -1, float("inf"), float("nan"), "1"])
+def test_temperature_rejects_invalid_values(value):
+    with pytest.raises(ValueError):
+        XGrammarLogitsProcessor(object(), temperature=value)
+
+
+def test_all_backend_factories_forward_temperature():
+    backend = object.__new__(XGrammarBackend)
+    backend.grammar_compiler = Mock()
+
+    processors = [
+        backend.get_json_schema_logits_processor("{}", temperature=0.5),
+        backend.get_regex_logits_processor("a", temperature=1.5),
+        backend.get_cfg_logits_processor('root ::= "a"', temperature=2.0),
+    ]
+
+    assert [processor.temperature for processor in processors] == [0.5, 1.5, 2.0]
+    backend.grammar_compiler.compile_json_schema.assert_called_once_with("{}")
+    backend.grammar_compiler.compile_regex.assert_called_once_with("a")
+    backend.grammar_compiler.compile_grammar.assert_called_once_with(
+        'root ::= "a"'
+    )
