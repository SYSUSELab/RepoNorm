+def test_toolcall_metadata_execution_format_and_falsey_values():
+    from dspy import ToolCalls
+    item = {'name': 'search', 'args': {'q': 'hello'}, 'note': '', 'comment': 'context',
+            'annotation': 'detail', 'tags': [], 'priority': 0, 'meta': {}}
+    parsed = ToolCalls.from_dict_list([item])
+    call = parsed.tool_calls[0]
+    assert call.note == '' and call.comment == 'context'
+    assert call.tags == [] and call.priority == 0 and call.meta == {}
+    executable = {'type': 'function', 'function': {'name': 'search', 'arguments': {'q': 'hello'}}}
+    assert parsed.format() == [{'type': 'tool_calls', 'tool_calls': [executable]}]
+    expected = {**executable, **{key: value for key, value in item.items() if key not in ('name', 'args')}}
+    assert parsed.format_with_metadata() == [{'type': 'tool_calls', 'tool_calls': [expected]}]
+    without = ToolCalls.from_dict_list([{'name': 'search', 'args': {}}])
+    assert without.format_with_metadata() == without.format()
+
+
+def test_metadata_comments_preserve_hashes_quotes_and_document_scope():
+    from dspy import ToolCalls
+    text = '''# document header
+    [{"name":"first", "args":{"url":"https://example.invalid/#fragment", "quote":"a\\\"#b"}, "note":"keep", "comment":"override"},
+     {"name":"second", "args":{"color":"#abc"}}] # document tail
+    # last line
+    '''
+    parsed = ToolCalls.from_string(text)
+    first, second = parsed.tool_calls
+    assert first.args == {'url': 'https://example.invalid/#fragment', 'quote': 'a"#b'}
+    assert second.args == {'color': '#abc'}
+    assert first.note == 'keep'
+    assert first.comment == second.comment == 'document header\ndocument tail\nlast line'
+    assert ToolCalls.from_string('{"tool_calls":[]} # empty').tool_calls == []
+
+
+def test_metadata_explicit_comment_input_not_mutated():
+    import copy
+    from dspy import ToolCalls
+    item = {'name': 'search', 'args': {'nested': [1]}, 'comment': 'explicit', 'unknown': 'ignored'}
+    before = copy.deepcopy(item)
+    assert ToolCalls.from_dict_list([item], comments=[' ', '']).tool_calls[0].comment == 'explicit'
+    assert ToolCalls.from_dict_list([item], comments=[' first ', 'second']).tool_calls[0].comment == 'first\nsecond'
+    assert item == before
+    assert 'unknown' not in ToolCalls.from_dict_list([item]).tool_calls[0].model_dump()
+
+
+@pytest.mark.parametrize('metadata', [{'tags': [1]}, {'note': []}, {'comment': 3}, {'meta': []}])
+def test_metadata_type_errors(metadata):
+    from dspy import ToolCalls
+    with pytest.raises(ValueError):
+        ToolCalls.from_dict_list([{'name': 'x', 'args': {}, **metadata}])
+
+
+def test_invalid_metadata_json_and_comment_list():
+    from dspy import ToolCalls
+    for text in ['[] trailing', '{"name":"x"}', '[123]', '123', 'not JSON']:
+        with pytest.raises(ValueError):
+            ToolCalls.from_string(text)
+    with pytest.raises(ValueError):
+        ToolCalls.from_dict_list([{'name': 'x', 'args': {}}], comments=[1])
