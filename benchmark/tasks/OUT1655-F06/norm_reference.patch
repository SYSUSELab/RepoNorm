@@ -0,0 +1,62 @@
+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_url_is_an_exported_composable_regex_term():
+    value = getattr(types, "url")
+    assert isinstance(value, Regex)
+    assert re.fullmatch(to_regex("<" + value + ">"), "<https://example.com/a?q=1#f>")
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "http://localhost",
+        "https://localhost:65535/",
+        "https://a-b.example.com/path_with~punctuation",
+        "http://0.0.0.0",
+        "https://255.255.255.255:1/a%20b",
+        "https://example.com/path?q=1&r=2#fragment",
+        "http://" + "a" * 63 + ".example",
+    ],
+)
+def test_url_accepts_complete_values_in_the_supported_subset(value):
+    assert re.fullmatch(to_regex(getattr(types, "url")), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "HTTP://example.com",
+        "ftp://example.com",
+        "http://example",
+        "http://-a.example.com",
+        "http://a-.example.com",
+        "http://" + "a" * 64 + ".example",
+        "http://01.2.3.4",
+        "http://256.2.3.4",
+        "http://user@example.com",
+        "http://[::1]",
+        "http://example.com?",
+        "http://example.com#",
+        "http://example.com/a b",
+    ],
+)
+def test_url_rejects_values_outside_the_supported_subset(value):
+    assert re.fullmatch(to_regex(getattr(types, "url")), value) is None
+
+
+def test_url_works_in_pydantic_schema_and_validation():
+    class Endpoint(BaseModel):
+        value: types.url
+
+    pattern = Endpoint.model_json_schema()["properties"]["value"]["pattern"]
+    assert re.fullmatch(pattern, "https://api.example.com:443/v1?q=x#result")
+    assert Endpoint(value="http://localhost").value == "http://localhost"
+    with pytest.raises(ValidationError):
+        Endpoint(value="http://01.2.3.4")
