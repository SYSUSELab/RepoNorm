diff --git a/tests/clients/test_cache_ttl_contribution.py b/tests/clients/test_cache_ttl_contribution.py
new file mode 100644
index 000000000..c43513e19
--- /dev/null
+++ b/tests/clients/test_cache_ttl_contribution.py
@@ -0,0 +1,63 @@
+import math
+
+import pytest
+
+import dspy
+import dspy.clients as clients
+import dspy.clients.cache as cache_module
+from dspy.clients.cache import Cache
+
+
+def make_cache(tmp_path, ttl=None):
+    return Cache(False, True, str(tmp_path), memory_max_entries=10, ttl=ttl)
+
+
+def test_ttl_expiry_and_overwrite_use_write_deadlines(tmp_path, monkeypatch):
+    now = 100.0
+    monkeypatch.setattr(cache_module.time, "time", lambda: now)
+    cache = make_cache(tmp_path, ttl=10)
+    request = {"value": 1}
+    cache.put(request, "first")
+    now = 109.0
+    assert cache.get(request) == "first"
+    cache.put(request, "second")
+    now = 111.0
+    assert cache.get(request) == "second"
+    now = 120.0
+    assert cache.get(request) is None
+
+
+@pytest.mark.parametrize("invalid", [0, -1, math.inf, math.nan, True, "1"])
+def test_invalid_ttl_is_rejected_without_changing_global_cache(tmp_path, invalid):
+    cache = make_cache(tmp_path)
+    dspy.cache = cache
+    with pytest.raises(ValueError):
+        clients.set_ttl(invalid)
+    assert dspy.cache is cache
+    assert dspy.cache.ttl is None
+
+
+def test_set_ttl_only_changes_future_writes(tmp_path, monkeypatch):
+    now = 100.0
+    monkeypatch.setattr(cache_module.time, "time", lambda: now)
+    cache = make_cache(tmp_path, ttl=10)
+    dspy.cache = cache
+    cache.put({"key": "old"}, "expires")
+    clients.set_ttl(None)
+    cache.put({"key": "new"}, "forever")
+    now = 111.0
+    assert cache.get({"key": "old"}) is None
+    assert cache.get({"key": "new"}) == "forever"
+
+
+def test_saved_memory_deadline_is_not_renewed(tmp_path, monkeypatch):
+    now = 100.0
+    monkeypatch.setattr(cache_module.time, "time", lambda: now)
+    cache = make_cache(tmp_path / "source", ttl=10)
+    cache.put({"key": 1}, "value")
+    saved = tmp_path / "cache.pkl"
+    cache.save_memory_cache(str(saved))
+    now = 111.0
+    loaded = make_cache(tmp_path / "loaded", ttl=None)
+    loaded.load_memory_cache(str(saved))
+    assert loaded.get({"key": 1}) is None

