+from ipaddress import IPv4Address, IPv4Network
+
+import pytest
+
+from dirty_equals import IsIP, IsJson, IsList
+
+
+def test_within_addresses_and_networks():
+    check = IsIP(within=['192.0.2.0/24', '2001:db8::/32'])
+    for value in ['192.0.2.0', '192.0.2.255', '192.0.2.128/25', '2001:db8::1',
+                  IPv4Address('192.0.2.5'), IPv4Address('192.0.2.5').packed,
+                  int(IPv4Address('192.0.2.5')), IPv4Network('192.0.2.0/24')]:
+        assert value == check
+        assert check.value == value
+    for value in ['192.0.3.0', '192.0.2.0/23', '2001:db9::1', object(), 'bad']:
+        assert not (value == check)
+
+
+def test_within_combined_constraints_and_composition():
+    assert '192.0.2.128/25' == IsIP(4, netmask='255.255.255.128', within='192.0.2.0/24')
+    assert not ('192.0.2.0/24' == IsIP(4, netmask='255.255.255.128', within='192.0.2.0/24'))
+    assert not ('2001:db8::1' == IsIP(4, within=['192.0.2.0/24', '2001:db8::/32']))
+    assert ['192.0.2.1', '192.0.2.2'] == IsList(IsIP(within='192.0.2.0/24'), IsIP(within='192.0.2.0/24'))
+    assert '"192.0.2.1"' == IsJson(IsIP(within='192.0.2.0/24'))
+    assert '2001:db8::1' == (IsIP(within='192.0.2.0/24') | IsIP(6))
+    assert '8.8.8.8' == IsIP(within=None)
+
+
+@pytest.mark.parametrize('within', [[], (), ['invalid'], '192.0.2.1/24', object(), 0, b'\x00\x00\x00\x00', True, '192.0.2.1'])
+def test_invalid_range_configuration(within):
+    with pytest.raises(ValueError):
+        IsIP(within=within)
+
+
+def test_zero_netmask_is_still_a_constraint():
+    assert '192.0.2.1' == IsIP(within=(IPv4Network('192.0.2.0/24'), '2001:db8::/32'))
+    assert '192.0.2.1' == IsIP(within=IPv4Network('192.0.2.0/24'))
+    assert '0.0.0.0/0' == IsIP(4, netmask=0, within='0.0.0.0/0')
+    assert not ('192.0.2.1' == IsIP(4, netmask=0))
+    with pytest.raises(TypeError):
+        IsIP(netmask=0)
