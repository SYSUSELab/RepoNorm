diff --git a/tests/test_ip_contribution.py b/tests/test_ip_contribution.py
new file mode 100644
index 0000000..2943c6a
--- /dev/null
+++ b/tests/test_ip_contribution.py
@@ -0,0 +1,37 @@
+from ipaddress import IPv4Address, IPv4Network
+
+import pytest
+
+import dirty_equals as de
+
+
+def test_ip_public_validator_and_composition():
+    value = IPv4Address('192.0.2.4')
+    validator = de.IsIP(4)
+    assert value == validator
+    assert validator.value is value
+    assert repr(validator) == repr(value)
+    assert value == (de.IsIP(4) & ~de.IsIP(6))
+    assert 'bad address' != de.IsIP()
+
+
+def test_ip_version_and_netmask_constraints():
+    assert '192.0.2.9/24' == de.IsIP(4, netmask='255.255.255.0')
+    assert '192.0.2.9/24' != de.IsIP(4, netmask=0)
+    assert '2001:db8::1' != de.IsIP(4)
+    with pytest.raises(TypeError, match='must specify the IP version'):
+        de.IsIP(netmask=0)
+
+
+def test_ip_within_requires_full_containment():
+    validator = de.IsIP(within=['192.0.2.0/24', '2001:db8::/32'])
+    assert '192.0.2.255' == validator
+    assert IPv4Network('192.0.2.128/25') == validator
+    assert IPv4Network('192.0.2.0/23') != validator
+    assert '2001:db9::1' != validator
+
+
+@pytest.mark.parametrize('within', [[], '192.0.2.1', '192.0.2.1/24', object()])
+def test_ip_rejects_invalid_range_configuration(within):
+    with pytest.raises(ValueError):
+        de.IsIP(within=within)
