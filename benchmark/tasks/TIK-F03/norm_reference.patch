@@ -0,0 +1,51 @@
+from collections import Counter
+
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+@pytest.mark.parametrize("text", ["", "hello hello", "🙂 café", "你好吗"])
+def test_frequency_matches_returned_tokens(encoding, text) -> None:
+    tokens, frequency = encoding.encode(text, analyze_frequency=True)
+    assert tokens == encoding.encode(text)
+    assert frequency == dict(Counter(tokens))
+
+
+def test_frequency_keeps_special_token_policy(encoding) -> None:
+    special = "<|endoftext|>"
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode(special, analyze_frequency=True)
+    tokens, frequency = encoding.encode(
+        special, allowed_special="all", analyze_frequency=True
+    )
+    assert frequency == {tokens[0]: 1}
+
+
+def test_frequency_keeps_surrogate_recovery(encoding) -> None:
+    text = "before \ud800 after"
+    tokens, frequency = encoding.encode(text, analyze_frequency=True)
+    assert tokens == encoding.encode(text)
+    assert frequency == dict(Counter(tokens))
+
+
+@pytest.mark.parametrize("threads", [1, 3])
+def test_batch_frequency_is_deterministic_and_preserves_order(encoding, threads) -> None:
+    texts = ["repeat repeat", "", "🙂", "repeat repeat"]
+    expected = [encoding.encode(text) for text in texts]
+    rows, frequency = encoding.encode_batch(
+        texts, analyze_frequency=True, num_threads=threads
+    )
+    assert rows == expected
+    assert frequency == dict(Counter(token for row in expected for token in row))
+
+
+def test_empty_batch_and_default_shapes(encoding) -> None:
+    assert encoding.encode_batch([], analyze_frequency=True) == ([], {})
+    assert isinstance(encoding.encode("text"), list)
+    assert isinstance(encoding.encode_batch(["text"]), list)
