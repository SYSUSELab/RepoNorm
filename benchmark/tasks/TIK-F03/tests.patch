@@ -0,0 +1,23 @@
+from collections import Counter
+import pytest
+import tiktoken
+
+
+@pytest.mark.parametrize('threads', [1, 3])
+def test_corpus_frequency(threads):
+    enc = tiktoken.get_encoding('cl100k_base')
+    texts = ['hello hello', '', '你好😀', 'hello hello', '<|endoftext|>']
+    expected = [enc.encode(text, allowed_special='all') for text in texts]
+    tokens, frequency = enc.encode_batch(texts, allowed_special='all', analyze_frequency=True, num_threads=threads)
+    assert tokens == expected
+    assert frequency == dict(Counter(token for row in expected for token in row))
+    assert sum(frequency.values()) == sum(map(len, expected))
+    assert enc.encode_batch(texts, allowed_special='all') == expected
+    assert enc.encode_batch([], analyze_frequency=True) == ([], {})
+    for text, row in zip(texts, expected):
+        assert enc.encode(text, allowed_special='all', analyze_frequency=True) == (row, dict(Counter(row)))
+    other = tiktoken.Encoding(name='bytes', pat_str=r'[\s\S]+', mergeable_ranks={bytes([i]): 255-i for i in range(256)}, special_tokens={})
+    other_tokens, other_frequency = other.encode_batch(['hello'], analyze_frequency=True)
+    assert other_frequency == dict(Counter(other_tokens[0]))
+    with pytest.raises(ValueError):
+        enc.encode_batch(['<|endoftext|>'], analyze_frequency=True)
