diff --git a/tests/test_termui.py b/tests/test_termui.py
index 8fdfe8d..c119503 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -470,3 +470,78 @@ def test_false_show_default_cause_no_default_display_in_prompt(runner):
     # is False
     result = runner.invoke(cmd, input="my-input", standalone_mode=False)
     assert "my-default-value" not in result.output
+
+class _MultiFileProcess:
+    pid = 1004
+    def __init__(self, code=0): self.code = code
+    def wait(self): return self.code
+
+
+def _editor_argv(call):
+    import shlex
+    command = call[0]
+    return shlex.split(command) if isinstance(command, str) else list(command)
+
+
+def test_edit_multiple_files_preserves_argument_boundaries(tmp_path, monkeypatch):
+    files = ["plain.txt", "space name.txt", 'quote"name.txt', "semi;name.txt", "$(marker).txt", "line\nbreak.txt"]
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append((a[0], kw)) or _MultiFileProcess())
+
+    click.edit(filename=files, editor="editor --wait")
+
+    assert len(calls) == 1
+    assert _editor_argv(calls[0]) == ["editor", "--wait", *files]
+
+
+def test_edit_multiple_files_consumes_generator_once(monkeypatch):
+    iterations = 0
+    def filenames():
+        nonlocal iterations
+        iterations += 1
+        yield "one.txt"
+        yield "two.txt"
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append((a[0], kw)) or _MultiFileProcess())
+
+    click.edit(filename=filenames(), editor="editor")
+
+    assert iterations == 1
+    assert _editor_argv(calls[0]) == ["editor", "one.txt", "two.txt"]
+
+
+def test_edit_multiple_files_single_string_is_one_argument(monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append((a[0], kw)) or _MultiFileProcess())
+    click.edit(filename="name.txt", editor="editor")
+    assert _editor_argv(calls[0]) == ["editor", "name.txt"]
+
+
+def test_edit_multiple_files_empty_rejected_before_launch(monkeypatch):
+    launched = False
+    def popen(*args, **kwargs):
+        nonlocal launched
+        launched = True
+    monkeypatch.setattr("subprocess.Popen", popen)
+    with pytest.raises(ValueError, match="must not be empty"):
+        click.edit(filename=[], editor="editor")
+    assert not launched
+
+
+def test_edit_multiple_files_non_string_rejected(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: pytest.fail("must not launch"))
+    with pytest.raises(TypeError, match="filename must be a string"):
+        click.edit(filename=["one", 2], editor="editor")
+
+
+def test_edit_multiple_files_custom_environment(monkeypatch):
+    calls = []
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: calls.append((a[0], kw)) or _MultiFileProcess())
+    click.edit(filename=["one", "two"], editor="editor", env={"CLICK_MULTI": "yes"})
+    assert calls[0][1]["env"]["CLICK_MULTI"] == "yes"
+
+
+def test_edit_multiple_files_nonzero_exit_keeps_failure(monkeypatch):
+    monkeypatch.setattr("subprocess.Popen", lambda *a, **kw: _MultiFileProcess(3))
+    with pytest.raises(click.ClickException, match="Editing failed"):
+        click.edit(filename=["one", "two"], editor="editor")
