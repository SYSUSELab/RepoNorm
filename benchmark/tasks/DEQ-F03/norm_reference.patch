@@ -0,0 +1,29 @@
+import pytest
+
+import dirty_equals as de
+
+
+@pytest.mark.parametrize(
+    'value',
+    ['a@x.io', 'test.email+tag@a-b.domain.co.uk', 'a_%+-@example.com'],
+)
+def test_email_supported_grammar_and_value(value):
+    validator = de.IsEmail()
+    assert value == validator
+    assert validator.value == value
+    assert repr(validator) == repr(value)
+
+
+def test_email_rejects_outside_finite_grammar():
+    validator = de.IsEmail()
+    for value in ('a..b@x.io', '.a@x.io', 'a@-x.io', 'a@x.i', 'a@x.io\n', None):
+        assert value != validator
+
+
+def test_email_exact_domain_and_composition():
+    assert 'a@example.com' == de.IsEmail('example.com')
+    assert 'a@sub.example.com' != de.IsEmail('example.com')
+    assert 'a@Example.com' != de.IsEmail('example.com')
+    assert 'a@example.com' == (de.IsEmail('example.com') & de.IsStr())
+    assert 'a@example.com' == ~de.IsEmail('other.com')
+    assert repr(de.IsEmail()) == 'IsEmail(*)'
