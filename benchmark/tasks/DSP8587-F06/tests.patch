diff --git a/tests/streaming/test_streaming.py b/tests/streaming/test_streaming.py
index fe67bd6..16b130f 100644
--- a/tests/streaming/test_streaming.py
+++ b/tests/streaming/test_streaming.py
@@ -837,3 +837,83 @@ async def test_stream_listener_returns_correct_chunk_xml_adapter():
     assert all_chunks[1].predict_name == "predict2"
     assert all_chunks[1].signature_field_name == "judgement"
     assert all_chunks[1].chunk == "The answer is humorous."
+
+def _feature6_model_chunk(content):
+    return ModelResponseStream(
+        model="test", choices=[StreamingChoices(delta=Delta(content=content))]
+    )
+
+
+def _drive_feature6_to_first_emission(listener):
+    listener.receive(_feature6_model_chunk("[[ ## answer ## ]]\n"))
+    response = None
+    for index in range(11):
+        response = listener.receive(_feature6_model_chunk(str(index)))
+    return response
+
+
+def test_on_chunk_is_called_once_with_returned_object_before_receive_returns():
+    callback_values = []
+    receive_returned = False
+
+    def on_chunk(response):
+        assert receive_returned is False
+        callback_values.append(response)
+
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer", on_chunk=on_chunk
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        response = _drive_feature6_to_first_emission(listener)
+        receive_returned = True
+
+    assert len(callback_values) == 1
+    assert callback_values[0] is response
+    assert response.chunk == "0"
+
+
+def test_on_chunk_receives_the_final_response_too():
+    callback_values = []
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer", on_chunk=callback_values.append
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        first = _drive_feature6_to_first_emission(listener)
+        final = listener.receive(
+            _feature6_model_chunk("[[ ## completed ## ]]")
+        )
+
+    assert len(callback_values) == 2
+    assert callback_values[0] is first
+    assert callback_values[1] is final
+
+
+def test_on_chunk_exception_propagates_from_receive():
+    error = RuntimeError("callback failed")
+
+    def on_chunk(response):
+        raise error
+
+    listener = dspy.streaming.StreamListener(
+        signature_field_name="answer", on_chunk=on_chunk
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        listener.receive(_feature6_model_chunk("[[ ## answer ## ]]\n"))
+        for index in range(10):
+            assert listener.receive(_feature6_model_chunk(str(index))) is None
+        with pytest.raises(RuntimeError, match="^callback failed$") as exc_info:
+            listener.receive(_feature6_model_chunk("10"))
+
+    assert exc_info.value is error
+
+
+def test_default_none_preserves_receive_output():
+    plain = dspy.streaming.StreamListener(signature_field_name="answer")
+    explicit = dspy.streaming.StreamListener(
+        signature_field_name="answer", on_chunk=None
+    )
+    with dspy.context(adapter=dspy.ChatAdapter()):
+        plain_response = _drive_feature6_to_first_emission(plain)
+        explicit_response = _drive_feature6_to_first_emission(explicit)
+
+    assert plain_response == explicit_response
