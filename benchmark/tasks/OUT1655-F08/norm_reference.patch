+import re
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from outlines import types
+from outlines.types.dsl import Regex, to_regex
+
+
+def test_ssn_is_an_exported_composable_regex_term():
+    value = getattr(types, "ssn")
+    assert isinstance(value, Regex)
+    assert re.fullmatch(to_regex("<" + value + ">"), "<123-45-6789>")
+
+
+@pytest.mark.parametrize("value", ["123-45-6789", "000-00-0000", "999-99-9999"])
+def test_ssn_accepts_supported_shapes_without_range_validation(value):
+    assert re.fullmatch(to_regex(getattr(types, "ssn")), value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "12-45-6789",
+        "1234-45-6789",
+        "123-4-6789",
+        "123-456-6789",
+        "123-45-678",
+        "123-45-67890",
+        "123456789",
+        "123_45_6789",
+        "123 45 6789",
+        "123-45-678a",
+        " 123-45-6789",
+        "١٢٣-٤٥-٦٧٨٩",
+    ],
+)
+def test_ssn_rejects_invalid_complete_shapes(value):
+    assert re.fullmatch(to_regex(getattr(types, "ssn")), value) is None
+
+
+def test_ssn_works_in_pydantic_schema_and_validation():
+    class Identity(BaseModel):
+        value: types.ssn
+
+    pattern = Identity.model_json_schema()["properties"]["value"]["pattern"]
+    assert re.fullmatch(pattern, "001-01-0001")
+    assert Identity(value="000-00-0000").value == "000-00-0000"
+    with pytest.raises(ValidationError):
+        Identity(value="123456789")
