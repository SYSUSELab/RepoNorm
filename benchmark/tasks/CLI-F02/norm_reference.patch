diff --git a/tests/test_on_exit_contribution.py b/tests/test_on_exit_contribution.py
new file mode 100644
index 0000000..6fcc382
--- /dev/null
+++ b/tests/test_on_exit_contribution.py
@@ -0,0 +1,90 @@
+import pytest
+
+import click
+
+
+def test_on_exit_runs_once_per_completed_teardown():
+    events = []
+    ctx = click.Context(click.Command("cmd"), on_exit=lambda ctx: events.append(ctx))
+
+    with ctx:
+        with ctx:
+            pass
+        assert events == []
+    assert events == [ctx]
+
+    with ctx.scope(cleanup=False):
+        pass
+    assert events == [ctx]
+
+    with ctx:
+        pass
+    assert events == [ctx, ctx]
+
+
+def test_on_exit_observes_final_command_and_parameters(runner):
+    observed = []
+
+    @click.command(context_settings={"on_exit": observed.append})
+    @click.option("--value", type=int)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--value", "7"])
+
+    assert result.exit_code == 0
+    assert observed[0].command is cli
+    assert observed[0].params == {"value": 7}
+
+
+def test_on_exit_ordinary_exception_does_not_prevent_lifo_cleanup():
+    events = []
+
+    def on_exit(ctx):
+        events.append("on_exit")
+        raise ValueError("ignored")
+
+    ctx = click.Context(click.Command("cmd"), on_exit=on_exit)
+    ctx.call_on_close(lambda: events.append("first"))
+    ctx.call_on_close(lambda: events.append("second"))
+
+    with ctx:
+        pass
+
+    assert events == ["on_exit", "second", "first"]
+
+
+@pytest.mark.parametrize("failure", [KeyboardInterrupt, SystemExit])
+def test_on_exit_base_exception_propagates_after_cleanup(failure):
+    events = []
+
+    def on_exit(ctx):
+        events.append("on_exit")
+        raise failure("stop")
+
+    ctx = click.Context(click.Command("cmd"), on_exit=on_exit)
+    ctx.call_on_close(lambda: events.append("cleanup"))
+
+    with pytest.raises(failure):
+        with ctx:
+            pass
+
+    assert events == ["on_exit", "cleanup"]
+    assert click.get_current_context(silent=True) is None
+
+
+def test_parent_and_child_have_independent_callbacks(runner):
+    events = []
+
+    @click.group(context_settings={"on_exit": lambda ctx: events.append(ctx.info_name)})
+    def cli():
+        pass
+
+    @cli.command(context_settings={"on_exit": lambda ctx: events.append(ctx.info_name)})
+    def child():
+        pass
+
+    result = runner.invoke(cli, ["child"])
+
+    assert result.exit_code == 0
+    assert events == ["child", "cli"]
