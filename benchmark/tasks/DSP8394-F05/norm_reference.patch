new file mode 100644
index 000000000..89acda266
--- /dev/null
+++ b/tests/clients/test_cache_compression_contribution.py
@@ -0,0 +1,74 @@
+from dataclasses import dataclass
+
+import pytest
+
+import dspy
+from dspy.clients import configure_cache
+from dspy.clients.cache import Cache, request_cache
+
+
+@dataclass
+class Response:
+    value: str
+    usage: dict
+
+
+def test_compressed_disk_hit_preserves_value_lifecycle(tmp_path):
+    cache = Cache(True, True, str(tmp_path), memory_max_entries=10, compress="gzip")
+    request = {"value": 1}
+    original = Response("stored" * 100, {"tokens": 2})
+    cache.put(request, original)
+    cache.reset_memory_cache()
+    hit = cache.get(request)
+    assert hit == Response("stored" * 100, {}) and hit is not original
+    assert cache.cache_key(request) in cache
+
+
+def test_codec_switch_keeps_existing_disk_entries(tmp_path):
+    cache = Cache(True, False, str(tmp_path), compress="zlib")
+    request = {"value": 1}
+    cache.put(request, {"nested": [1, None, True]})
+    cache.set_compression(None)
+    assert cache.get(request) == {"nested": [1, None, True]}
+    with pytest.raises(ValueError):
+        cache.set_compression("unknown")
+    assert cache.get(request) == {"nested": [1, None, True]}
+
+
+def test_configure_cache_keeps_existing_validation(tmp_path, monkeypatch):
+    with pytest.raises(ValueError):
+        configure_cache(enable_disk_cache=True, enable_litellm_cache=True)
+    monkeypatch.setattr(dspy, "cache", None)
+    configure_cache(
+        enable_disk_cache=True,
+        enable_memory_cache=False,
+        disk_cache_dir=str(tmp_path),
+        compress="gzip",
+        cull_limit=7,
+        eviction_policy="least-recently-used",
+    )
+    assert dspy.cache.disk_cache.cull_limit == 7
+    assert dspy.cache.disk_cache.eviction_policy == "least-recently-used"
+
+
+def test_compression_keeps_request_cache_semantics(tmp_path, monkeypatch):
+    cache = Cache(True, False, str(tmp_path), compress="gzip")
+    monkeypatch.setattr(dspy, "cache", cache)
+    calls = []
+
+    @request_cache()
+    def compute(value):
+        calls.append(value)
+        return {"call": len(calls)}
+
+    assert compute("same") == compute("same") == {"call": 1}
+    assert calls == ["same"]
+
+
+def test_headerless_bytes_are_not_unpickled(tmp_path):
+    cache = Cache(True, False, str(tmp_path), compress="gzip")
+    request = {"value": "legacy"}
+    key = cache.cache_key(request)
+    value = b"ordinary legacy bytes"
+    cache.disk_cache[key] = value
+    assert cache.get(request) == value

