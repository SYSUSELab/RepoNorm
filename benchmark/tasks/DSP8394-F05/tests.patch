+def test_compression_configuration_and_disabled_layers(tmp_path, monkeypatch):
+    import dspy
+    from dspy.clients import configure_cache
+    monkeypatch.setattr(dspy, 'cache', None)
+    configure_cache(disk_cache_dir=str(tmp_path), compress='gzip',
+                    cull_limit=7, eviction_policy='least-recently-used')
+    assert dspy.cache.disk_cache.cull_limit == 7
+    assert dspy.cache.disk_cache.eviction_policy == 'least-recently-used'
+    request = {'key': 'configuration'}
+    dspy.cache.put(request, {'answer': 3})
+    with pytest.raises(ValueError):
+        dspy.cache.set_compression('unknown')
+    dspy.cache.reset_memory_cache()
+    assert dspy.cache.get(request) == {'answer': 3}
+    with pytest.raises(ValueError):
+        Cache(False, True, '', compress='unknown')
+    for memory in [True, False]:
+        cache = Cache(False, memory, '', compress='zlib')
+        cache.put(request, {'answer': 3})
+        assert cache.get(request) == ({'answer': 3} if memory else None)
