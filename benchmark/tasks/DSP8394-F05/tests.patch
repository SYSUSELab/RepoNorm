+@pytest.mark.parametrize('codec,selector', [('gzip', 1), ('zlib', 2)])
+def test_disk_compression_format_roundtrip_and_switch(tmp_path, codec, selector):
+    import gzip
+    import pickle
+    import zlib
+    cache = Cache(True, True, str(tmp_path), compress=codec)
+    request = {'key': 'structured'}
+    value = DummyResponse('answer' * 1000, {'tokens': 9})
+    cache.put(request, value)
+    stored = cache.disk_cache[cache.cache_key(request)]
+    assert isinstance(stored, bytes)
+    assert stored[:5] == b'DSPC' + bytes([selector])
+    payload = gzip.decompress(stored[5:]) if codec == 'gzip' else zlib.decompress(stored[5:])
+    assert pickle.loads(payload) == value
+    cache.set_compression(None)
+    cache.reset_memory_cache()
+    result = cache.get(request)
+    assert isinstance(result, DummyResponse)
+    assert result.message == value.message
+    assert result.usage == {}
+    assert value.usage == {'tokens': 9}
+    result.message = 'changed by caller'
+    assert cache.get(request).message == value.message
+    reopened = Cache(True, False, str(tmp_path), compress='zlib' if codec == 'gzip' else 'gzip')
+    assert reopened.get(request).message == value.message
+
