+@pytest.mark.parametrize('codec', ['gzip', 'zlib'])
+def test_compressible_payload_is_smaller_on_disk(tmp_path, codec):
+    plain = Cache(True, False, str(tmp_path / 'plain'), disk_size_limit_bytes=32 * 1024 * 1024)
+    compressed = Cache(True, False, str(tmp_path / 'compressed'),
+                       disk_size_limit_bytes=32 * 1024 * 1024, compress=codec)
+    payload = {'text': 'repeatable response ' * 100000}
+    request = {'key': 1}
+    plain.put(request, payload)
+    compressed.put(request, payload)
+    assert plain.get(request) == compressed.get(request) == payload
+    assert compressed.disk_cache.volume() < plain.disk_cache.volume()
+
