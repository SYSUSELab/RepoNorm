+def test_real_legacy_values_and_codec_zero(tmp_path):
+    import pickle
+    import subprocess
+    namespace = {'__name__': 'baseline_cache_fixture'}
+    source = subprocess.run(['git', 'show', 'HEAD:dspy/clients/cache.py'],
+                            check=True, capture_output=True, text=True).stdout
+    exec(compile(source, '<frozen-baseline-cache>', 'exec'), namespace)
+    baseline = namespace['Cache'](True, False, str(tmp_path))
+    values = [{'nested': [1, None, True]}, b'ordinary bytes', pickle.dumps({'still': 'bytes'})]
+    for i, value in enumerate(values):
+        baseline.put({'key': i}, value)
+    reader = Cache(True, False, str(tmp_path), compress='gzip')
+    for i, value in enumerate(values):
+        assert reader.get({'key': i}) == value
+        assert type(reader.get({'key': i})) is type(value)
+    key = reader.cache_key({'key': 'codec-zero'})
+    reader.disk_cache[key] = b'DSPC\x00' + pickle.dumps({'plain': 3})
+    assert reader.get({'key': 'codec-zero'}) == {'plain': 3}
+    reader.disk_cache[key] = b'DSPC\xffinvalid'
+    with pytest.raises(ValueError):
+        reader.get({'key': 'codec-zero'})
+
