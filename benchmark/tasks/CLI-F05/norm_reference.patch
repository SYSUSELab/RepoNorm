diff --git a/tests/test_retry_cleanup_contribution.py b/tests/test_retry_cleanup_contribution.py
new file mode 100644
index 0000000..440021f
--- /dev/null
+++ b/tests/test_retry_cleanup_contribution.py
@@ -0,0 +1,119 @@
+from contextlib import contextmanager
+
+import pytest
+
+import click
+
+
+def test_retry_policy_inherits_and_explicit_zero_disables_it() -> None:
+    parent = click.Context(
+        click.Command("parent"), retry_cleanup=2, retry_cleanup_backoff=0.25
+    )
+    inherited = click.Context(click.Command("inherited"), parent=parent)
+    disabled = click.Context(click.Command("disabled"), parent=parent, retry_cleanup=0)
+    assert (inherited.retry_cleanup, inherited.retry_cleanup_backoff) == (2, 0.25)
+    assert disabled.retry_cleanup == 0
+
+
+@pytest.mark.parametrize("value", [0, -1, float("inf"), float("nan"), True, "1"])
+def test_backoff_rejects_non_positive_non_finite_or_non_numeric_values(value) -> None:
+    with pytest.raises(ValueError):
+        click.Context(click.Command("cmd"), retry_cleanup_backoff=value)
+
+
+def test_callback_retries_without_delay_before_first_or_after_success(
+    monkeypatch,
+) -> None:
+    sleeps = []
+    attempts = []
+    monkeypatch.setattr("time.sleep", sleeps.append)
+    ctx = click.Context(
+        click.Command("cmd"), retry_cleanup=3, retry_cleanup_backoff=0.25
+    )
+
+    def transient() -> str:
+        attempts.append(len(attempts))
+        if len(attempts) < 3:
+            raise OSError("transient")
+        return "done"
+
+    assert ctx.call_on_close(transient) is transient
+    ctx.close()
+    assert len(attempts) == 3
+    assert sleeps == [0.25, 0.5]
+
+
+def test_each_callback_gets_an_independent_backoff_sequence(monkeypatch) -> None:
+    sleeps = []
+    calls = {"first": 0, "second": 0}
+    monkeypatch.setattr("time.sleep", sleeps.append)
+    ctx = click.Context(
+        click.Command("cmd"), retry_cleanup=2, retry_cleanup_backoff=0.1
+    )
+
+    def transient(name: str) -> None:
+        calls[name] += 1
+        if calls[name] == 1:
+            raise ValueError(name)
+
+    ctx.call_on_close(lambda: transient("first"))
+    ctx.call_on_close(lambda: transient("second"))
+    ctx.close()
+    assert calls == {"first": 2, "second": 2}
+    assert sleeps == [0.1, 0.1]
+
+
+def test_exhaustion_raises_last_exception_and_other_callbacks_run(monkeypatch) -> None:
+    monkeypatch.setattr("time.sleep", lambda delay: None)
+    attempts = []
+    events = []
+    ctx = click.Context(click.Command("cmd"), retry_cleanup=2)
+    ctx.call_on_close(lambda: events.append("earlier"))
+
+    def exhausted() -> None:
+        error = RuntimeError(str(len(attempts)))
+        attempts.append(error)
+        raise error
+
+    ctx.call_on_close(exhausted)
+    with pytest.raises(RuntimeError) as caught:
+        ctx.close()
+    assert caught.value is attempts[-1]
+    assert len(attempts) == 3
+    assert events == ["earlier"]
+    ctx.close()
+    assert events == ["earlier"]
+
+
+@pytest.mark.parametrize("failure", [KeyboardInterrupt, SystemExit])
+def test_base_exceptions_are_not_retried(failure) -> None:
+    calls = []
+    ctx = click.Context(click.Command("cmd"), retry_cleanup=2)
+
+    def callback() -> None:
+        calls.append("call")
+        raise failure()
+
+    ctx.call_on_close(callback)
+    with pytest.raises(failure):
+        ctx.close()
+    assert calls == ["call"]
+
+
+def test_context_manager_resource_is_exited_only_once(monkeypatch) -> None:
+    monkeypatch.setattr("time.sleep", lambda delay: None)
+    calls = []
+
+    @contextmanager
+    def resource():
+        try:
+            yield
+        finally:
+            calls.append("exit")
+            raise ValueError("resource")
+
+    ctx = click.Context(click.Command("cmd"), retry_cleanup=2)
+    ctx.with_resource(resource())
+    with pytest.raises(ValueError, match="resource"):
+        ctx.close()
+    assert calls == ["exit"]
