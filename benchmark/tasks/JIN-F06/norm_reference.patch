diff --git a/tests/test_groupby_transform_contribution.py b/tests/test_groupby_transform_contribution.py
new file mode 100644
index 00000000..87fd9610
--- /dev/null
+++ b/tests/test_groupby_transform_contribution.py
@@ -0,0 +1,58 @@
+import asyncio
+
+import pytest
+
+from jinja2 import Environment
+from jinja2.utils import pass_environment
+
+
+def test_groupby_transforms_display_only_once_per_group():
+    env = Environment()
+    seen = []
+
+    def transform(key):
+        seen.append(key)
+        return "same"
+
+    groups = env.call_filter(
+        "groupby", [{"k": 1}, {"k": 2}], ["k"], {"key_transform": transform}
+    )
+    assert [group.grouper for group in groups] == ["same", "same"]
+    assert [len(group.list) for group in groups] == [1, 1]
+    assert seen == [1, 2]
+
+
+def test_groupby_transform_receives_environment():
+    env = Environment()
+
+    @pass_environment
+    def transform(active_env, key):
+        assert active_env is env
+        return f"key-{key}"
+
+    group = env.call_filter("groupby", [{"k": 1}], ["k"], {"key_transform": transform})[
+        0
+    ]
+    assert tuple(group) == ("key-1", [{"k": 1}])
+
+
+def test_groupby_transform_propagates_callback_error():
+    env = Environment()
+
+    def transform(key):
+        raise LookupError(key)
+
+    with pytest.raises(LookupError):
+        env.call_filter("groupby", [{"k": 1}], ["k"], {"key_transform": transform})
+
+
+def test_async_groupby_awaits_transform():
+    env = Environment(enable_async=True)
+
+    async def transform(key):
+        return f"key-{key}"
+
+    groups = asyncio.run(
+        env.call_filter("groupby", [{"k": 1}], ["k"], {"key_transform": transform})
+    )
+    assert groups[0].grouper == "key-1"
