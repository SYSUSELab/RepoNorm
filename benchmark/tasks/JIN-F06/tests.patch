+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_transform_environment_and_collision(asynchronous):
+    from jinja2 import Environment, pass_environment
+    from markupsafe import Markup
+    env = Environment(enable_async=asynchronous, autoescape=True)
+    calls = []
+    @pass_environment
+    def transform(environment, key):
+        assert environment is env
+        calls.append(key)
+        return "<same>"
+    template = env.from_string('{% for k, items in rows|groupby("k", key_transform=fn) %}{{k}}:{{items|length}};{% endfor %}')
+    rows = [{"k": 2}, {"k": 1}, {"k": 2}]
+    assert template.render(rows=iter(rows), fn=transform) == "&lt;same&gt;:1;&lt;same&gt;:2;"
+    assert sorted(calls) == [1, 2]
+    assert template.render(rows=rows, fn=lambda k: Markup("<b>")) == "<b>:1;<b>:2;"
+
+
+def test_v5_transform_awaitable_and_exception():
+    from jinja2 import Environment, pass_environment
+    env = Environment(enable_async=True)
+    calls = []
+    @pass_environment
+    async def transform(environment, key):
+        assert environment is env
+        calls.append(key)
+        return str(key * 10)
+    async def rows():
+        for key in [2, 1, 2]:
+            yield {"k": key}
+    template = env.from_string('{% for k, items in rows|groupby("k", key_transform=fn) %}{{k}}:{{items|length}};{% endfor %}')
+    assert template.render(rows=rows(), fn=transform) == "10:1;20:2;"
+    assert sorted(calls) == [1, 2]
+    error = ValueError("callback failure")
+    async def broken(key):
+        raise error
+    with pytest.raises(ValueError) as caught:
+        template.render(rows=[{"k": 1}], fn=broken)
+    assert caught.value is error
