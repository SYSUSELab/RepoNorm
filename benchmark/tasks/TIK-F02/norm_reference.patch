--- /dev/null
+++ b/tests/test_token_positions_contribution.py
@@ -0,0 +1,46 @@
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+@pytest.mark.parametrize("text", ["", "hello world", "🙂 café", "e\u0301", "你好吗"])
+def test_positions_align_with_existing_decode_offsets(encoding, text) -> None:
+    expected = encoding.encode(text)
+    tokens, positions = encoding.encode(text, return_positions=True)
+    assert tokens == expected
+    assert positions == encoding.decode_with_offsets(expected)[1]
+    assert len(tokens) == len(positions)
+
+
+def test_special_token_position_uses_literal_character_index(encoding) -> None:
+    text = "🙂x<|endoftext|>"
+    tokens, positions = encoding.encode(
+        text, allowed_special="all", return_positions=True
+    )
+    assert tokens == encoding.encode(text, allowed_special="all")
+    assert positions[-1] == text.index("<|endoftext|>")
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode(text, return_positions=True)
+
+
+def test_batch_positions_preserve_input_order(encoding) -> None:
+    texts = ["🙂", "alpha beta", "", "e\u0301"]
+    result = encoding.encode_batch(texts, return_positions=True)
+    assert result == [encoding.encode(text, return_positions=True) for text in texts]
+
+
+def test_default_return_shapes_are_unchanged(encoding) -> None:
+    assert isinstance(encoding.encode("text"), list)
+    batch = encoding.encode_batch(["a", "b"])
+    assert isinstance(batch, list)
+    assert all(isinstance(tokens, list) for tokens in batch)
+
+
+def test_non_position_surrogate_fallback_is_unchanged(encoding) -> None:
+    text = "before \ud800 after"
+    assert encoding.encode(text) == encoding.encode_batch([text])[0]
