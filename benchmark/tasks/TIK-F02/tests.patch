+import pytest
+import tiktoken
+
+
+@pytest.mark.parametrize('name', ['cl100k_base', 'byte_vocab'])
+def test_unicode_offsets_and_batch(name):
+    enc = (tiktoken.get_encoding(name) if name != 'byte_vocab' else tiktoken.Encoding(
+        name='byte_vocab', pat_str=r'[\s\S]+',
+        mergeable_ranks={bytes([i]): i for i in range(256)},
+        special_tokens={'<|endoftext|>': 256},
+    ))
+    texts = ['你好😀', 'e\u0301 e\u0301', '', ' hello hello', 'x<|endoftext|>😀']
+    for text in texts:
+        expected = enc.encode(text, allowed_special='all')
+        tokens, offsets = enc.encode(text, allowed_special='all', return_positions=True)
+        assert tokens == expected
+        # Independent byte-start to containing Python character mapping.
+        byte_chars = [i for i, char in enumerate(text) for _ in char.encode('utf8')]
+        byte_position = 0
+        expected_offsets = []
+        for token in tokens:
+            expected_offsets.append(byte_chars[byte_position])
+            byte_position += len(enc.decode_single_token_bytes(token))
+        assert offsets == expected_offsets
+        assert len(tokens) == len(offsets)
+    expected = [enc.encode(text, allowed_special='all', return_positions=True) for text in texts]
+    assert enc.encode_batch(texts, allowed_special='all', return_positions=True, num_threads=2) == expected
+    assert enc.encode_batch(texts, allowed_special='all') == [row[0] for row in expected]
+    with pytest.raises(ValueError):
+        enc.encode_batch(['<|endoftext|>'], return_positions=True)
+    assert enc.encode('\ud800') == enc.encode('\ufffd')
