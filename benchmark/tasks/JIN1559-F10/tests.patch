+def test_translation_versions_public_lifecycle():
+    env = Environment(extensions=["jinja2.ext.i18n"])
+    env.set_translation_version("hello", "v1")
+    env.set_translation_version("world", "v1")
+    assert env.get_translation_version("hello") == "v1"
+    assert env.compare_translation_versions("hello", "world") is True
+    env.set_translation_version("world", "v2")
+    assert env.compare_translation_versions("hello", "world") is False
+    assert env.compare_translation_versions("missing-a", "missing-b") is False
+    env.remove_translation_version("hello")
+    assert env.get_translation_version("hello") is None
+    env.clear_translation_versions()
+    assert env.get_translation_version("world") is None
+
+
+def test_translation_versions_unicode_empty_and_overlay_copy():
+    env = Environment(extensions=["jinja2.ext.i18n"]); env.set_translation_version("", "零")
+    overlay = env.overlay()
+    assert overlay.get_translation_version("") == "零"
+    overlay.set_translation_version("", "overlay")
+    overlay.set_translation_version("另", "v")
+    assert env.get_translation_version("") == "零"
+    assert env.get_translation_version("另") is None
+    assert overlay.get_translation_version("") == "overlay"
+
+
+def test_translation_versions_do_not_affect_gettext():
+    env = Environment(extensions=["jinja2.ext.i18n"]); env.install_null_translations()
+    env.set_translation_version("Hello", "v1")
+    assert env.from_string("{% trans %}Hello{% endtrans %}").render() == "Hello"
