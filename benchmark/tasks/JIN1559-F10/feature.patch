+    def bind(self, environment: Environment) -> "InternationalizationExtension":
+        rv = t.cast("InternationalizationExtension", super().bind(environment))
+        rv._translation_versions = dict(self._translation_versions)
+        environment.set_translation_version = rv._set_translation_version  # type: ignore
+        environment.get_translation_version = rv._get_translation_version  # type: ignore
+        environment.compare_translation_versions = rv._compare_translation_versions  # type: ignore
+        environment.remove_translation_version = rv._remove_translation_version  # type: ignore
+        environment.clear_translation_versions = rv._clear_translation_versions  # type: ignore
+        return rv
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        if not isinstance(message, str) or not isinstance(version, str):
+            raise TypeError("message and version must be strings")
+        self._translation_versions[message] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        return self._translation_versions.get(message)
+
+    def _compare_translation_versions(self, message1: str, message2: str) -> bool:
+        if message1 not in self._translation_versions or message2 not in self._translation_versions:
+            return False
+        return self._translation_versions[message1] == self._translation_versions[message2]
+
+    def _remove_translation_version(self, message: str) -> None:
+        self._translation_versions.pop(message, None)
+
+    def _clear_translation_versions(self) -> None:
+        self._translation_versions.clear()
+
 
