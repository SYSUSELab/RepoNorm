diff --git a/tests/test_resource_limit_contribution.py b/tests/test_resource_limit_contribution.py
new file mode 100644
index 0000000..9cd7b66
--- /dev/null
+++ b/tests/test_resource_limit_contribution.py
@@ -0,0 +1,91 @@
+from contextlib import contextmanager
+from contextlib import nullcontext
+
+import pytest
+
+import click
+
+
+def test_limit_rejects_before_entry_and_preserves_lifo_cleanup():
+    events = []
+
+    @contextmanager
+    def resource(name):
+        events.append(f"enter:{name}")
+        try:
+            yield name
+        finally:
+            events.append(f"exit:{name}")
+
+    ctx = click.Context(click.Command("cmd"), max_resources=2)
+    assert ctx.with_resource(resource("first")) == "first"
+    assert ctx.with_resource(resource("second")) == "second"
+    with pytest.raises(RuntimeError):
+        ctx.with_resource(resource("rejected"))
+    assert "enter:rejected" not in events
+
+    ctx.close()
+
+    assert events == ["enter:first", "enter:second", "exit:second", "exit:first"]
+
+
+def test_hierarchy_limits_cover_descendants_and_siblings():
+    root = click.Context(click.Command("root"), max_resources=2)
+    left = click.Context(click.Command("left"), parent=root, max_resources=1)
+    right = click.Context(click.Command("right"), parent=root, max_resources=5)
+    left.with_resource(nullcontext("left"))
+    right.with_resource(nullcontext("right"))
+
+    with pytest.raises(RuntimeError):
+        right.with_resource(nullcontext())
+    with pytest.raises(RuntimeError):
+        left.with_resource(nullcontext())
+
+    left.close()
+    assert right.with_resource(nullcontext("released")) == "released"
+
+
+def test_failed_and_reentrant_entries_release_reservations():
+    ctx = click.Context(click.Command("cmd"), max_resources=1)
+
+    @contextmanager
+    def reentrant():
+        ctx.with_resource(nullcontext())
+        yield
+
+    with pytest.raises(RuntimeError):
+        ctx.with_resource(reentrant())
+
+    assert ctx.with_resource(nullcontext("after")) == "after"
+    ctx.close()
+
+
+def test_cleanup_failure_releases_only_the_closed_context():
+    @contextmanager
+    def failing():
+        try:
+            yield
+        finally:
+            raise ValueError("cleanup")
+
+    root = click.Context(click.Command("root"), max_resources=2)
+    child = click.Context(click.Command("child"), parent=root)
+    root.with_resource(nullcontext())
+    child.with_resource(failing())
+
+    with pytest.raises(ValueError, match="cleanup"):
+        child.close()
+
+    assert child.with_resource(nullcontext("reused")) == "reused"
+    with pytest.raises(RuntimeError):
+        root.with_resource(nullcontext())
+
+
+@pytest.mark.parametrize("value", [-1, True, 1.5, "1"])
+def test_limit_requires_a_non_negative_integer(value):
+    with pytest.raises(TypeError):
+        click.Context(click.Command("cmd"), max_resources=value)
+
+    zero = click.Context(click.Command("cmd"), max_resources=0)
+    with pytest.raises(RuntimeError):
+        zero.with_resource(nullcontext())
