+@pytest.mark.parametrize("bad_exit", [False, True])
+def test_resource_quota_releases_only_closed_subtree(bad_exit):
+    from contextlib import contextmanager
+
+    @contextmanager
+    def resource(fail=False):
+        try:
+            yield object()
+        finally:
+            if fail:
+                raise ValueError("cleanup")
+
+    root = click.Context(click.Command("root"), max_resources=3)
+    left = click.Context(click.Command("left"), parent=root, max_resources=1)
+    right = click.Context(click.Command("right"), parent=root, max_resources=10)
+    root.with_resource(resource())
+    left.with_resource(resource(bad_exit))
+    right.with_resource(resource())
+    with pytest.raises(RuntimeError):
+        right.with_resource(resource())
+    if bad_exit:
+        with pytest.raises(ValueError, match="cleanup"):
+            left.close()
+    else:
+        left.close()
+    left.close()
+    right.with_resource(resource())
+    with pytest.raises(RuntimeError):
+        root.with_resource(resource())
+    right.close()
+    left.with_resource(resource())
+    with pytest.raises(RuntimeError):
+        left.with_resource(resource())
+    left.close()
+    root.close()
+
+
+def test_resource_quota_failed_enter_and_descendants():
+    from contextlib import contextmanager, nullcontext
+
+    @contextmanager
+    def failure():
+        raise ValueError("enter")
+        yield
+
+    root = click.Context(click.Command("root"), max_resources=2)
+    child = click.Context(click.Command("child"), parent=root, max_resources=1)
+    grandchild = click.Context(
+        click.Command("grandchild"), parent=child, max_resources=10
+    )
+    with pytest.raises(ValueError, match="enter"):
+        child.with_resource(failure())
+    grandchild.with_resource(nullcontext("ok"))
+    with pytest.raises(RuntimeError):
+        child.with_resource(nullcontext())
+    root.with_resource(nullcontext())
+    root.close()
+    # Closing root does not silently release a still-open descendant.
+    with pytest.raises(RuntimeError):
+        child.with_resource(nullcontext())
+    grandchild.close()
+    assert child.with_resource(nullcontext("reused")) == "reused"
+    child.close()
+
+
+def test_resource_quota_stays_active_until_exit_finishes():
+    from contextlib import contextmanager, nullcontext
+
+    ctx = click.Context(click.Command("ctx"), max_resources=1)
+
+    @contextmanager
+    def resource():
+        try:
+            yield
+        finally:
+            with pytest.raises(RuntimeError):
+                ctx.with_resource(nullcontext())
+
+    ctx.with_resource(resource())
+    ctx.close()
+    ctx.with_resource(nullcontext())
+    ctx.close()
+
+
+def test_resource_quota_completion_below_hierarchy_limit():
+    from contextlib import nullcontext
+    from click.shell_completion import ShellComplete
+
+    def resource_option(ctx, param, value):
+        return ctx.with_resource(nullcontext(value))
+
+    @click.group(context_settings={"max_resources": 2})
+    @click.option("--root-value", default="r", callback=resource_option)
+    def cli(root_value):
+        pass
+
+    @cli.command()
+    @click.option("--child-value", default="c", callback=resource_option)
+    def child(child_value):
+        pass
+
+    completion = ShellComplete(cli, {}, "cli", "_CLI_COMPLETE")
+    assert "--child-value" in [
+        item.value for item in completion.get_completions(["child"], "--child")
+    ]
+
+
+def test_resource_quota_reserves_reentrant_entry_and_rolls_back_failure():
+    from contextlib import contextmanager, nullcontext
+
+    ctx = click.Context(click.Command("ctx"), max_resources=1)
+
+    @contextmanager
+    def outer():
+        ctx.with_resource(nullcontext("inner"))
+        yield "outer"
+
+    with pytest.raises(RuntimeError):
+        ctx.with_resource(outer())
+    assert ctx.with_resource(nullcontext("after failure")) == "after failure"
+    ctx.close()
