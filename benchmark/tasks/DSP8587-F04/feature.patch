+    def tick(self, now_ts: float | None = None) -> "StreamResponse | None":
+        """Return one empty timeout response when the active stream is idle.
+
+        ``now_ts`` uses the same monotonic time domain as the configured clock.
+        When omitted, the listener calls its clock. A timeout clears all
+        per-stream state before the response is returned.
+        """
+        # If no timeout is configured, nothing to do
+        if self.idle_timeout_s is None:
+            return None
+ 
+        # If stream hasn't started or has already ended, nothing to do
+        if not self.stream_start or self.stream_end:
+            return None
+ 
+        # If no timestamp has been set, nothing to do
+        if self._last_chunk_ts is None:
+            return None
+ 
+        current_time = now_ts if now_ts is not None else self._clock()
+ 
+        # Check if timeout has occurred
+        if current_time - self._last_chunk_ts >= self.idle_timeout_s:
+            # Timeout occurred - emit final chunk and reset state
+            timeout_response = StreamResponse(
+                self.predict_name,
+                self.signature_field_name,
+                ""  # Empty chunk
+                # Note: is_last_chunk field will be added in feature1
+            )
+ 
+            # Clear the whole per-stream state so only one timeout response can
+            # be emitted and a reusable listener starts cleanly.
+            self.stream_start = False
+            self.stream_end = False
+            self.cache_hit = False
+            self.field_start_queue = []
+            self.field_end_queue = Queue()
+            self._last_chunk_ts = None
+ 
+            return timeout_response
+ 
+        return None
+
