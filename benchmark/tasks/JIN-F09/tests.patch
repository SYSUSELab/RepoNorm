+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_v5_hierarchy_complete_leaves(asynchronous):
+    import asyncio
+    from copy import deepcopy
+    from jinja2 import Environment
+    env = Environment(enable_async=asynchronous)
+    rows = [{"p": [{"a": a, "b": b}], "c": c, "id": i} for i, (a, b, c) in enumerate([(2, 1, 2), (1, 2, 1), (2, 1, 2), (2, 1, 1)])] + [{}]
+    before = deepcopy(rows)
+    attrs = ["p.0.a", "p.0.b", "c"]
+    async def stream():
+        for row in rows:
+            yield row
+    result = env.call_filter("groupby", stream() if asynchronous else iter(rows), [attrs], {"levels": 3, "default": 9})
+    if asynchronous:
+        result = asyncio.run(result)
+    leaves = [row for a in result for b in a.list for c in b.list for row in c.list]
+    assert sorted(id(row) for row in leaves) == sorted(id(row) for row in rows)
+    assert result[1].list[0].list[1].list == [rows[0], rows[2]]
+    assert attrs == ["p.0.a", "p.0.b", "c"] and rows == before
+
+
