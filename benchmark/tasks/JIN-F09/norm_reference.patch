--- /dev/null
+++ b/tests/test_groupby_levels_contribution.py
@@ -0,0 +1,88 @@
+import asyncio
+from copy import deepcopy
+
+import pytest
+
+from jinja2 import Environment
+from jinja2.exceptions import FilterArgumentError
+
+
+def test_levels_form_complete_hierarchy_without_mutation():
+    env = Environment()
+    rows = [
+        {"department": "eng", "role": "dev", "id": 1},
+        {"department": "sales", "role": "rep", "id": 2},
+        {"department": "eng", "role": "dev", "id": 3},
+    ]
+    before = deepcopy(rows)
+    attrs = ["department", "role"]
+
+    groups = env.call_filter("groupby", iter(rows), [attrs], {"levels": 2})
+    leaves = [row for outer in groups for inner in outer.list for row in inner.list]
+
+    assert sorted(row["id"] for row in leaves) == [1, 2, 3]
+    assert groups[0].grouper == "eng"
+    assert groups[0].list[0].grouper == "dev"
+    assert groups[0].list[0].list == [rows[0], rows[2]]
+    assert attrs == ["department", "role"]
+    assert rows == before
+
+
+def test_levels_accept_comma_separated_dotted_and_numeric_attributes():
+    env = Environment()
+    rows = [
+        {"meta": [{"department": "eng"}], "role": "dev"},
+        {"meta": [{"department": "eng"}], "role": "manager"},
+    ]
+    groups = env.call_filter(
+        "groupby", rows, ["meta.0.department, role"], {"levels": 2}
+    )
+
+    assert [group.grouper for group in groups] == ["eng"]
+    assert [group.grouper for group in groups[0].list] == ["dev", "manager"]
+
+
+def test_levels_apply_default_at_each_depth():
+    env = Environment()
+    rows = [{"department": "eng"}, {}]
+    groups = env.call_filter(
+        "groupby",
+        rows,
+        [["department", "role"]],
+        {"levels": 2, "default": "missing"},
+    )
+
+    assert [(g.grouper, [child.grouper for child in g.list]) for g in groups] == [
+        ("eng", ["missing"]),
+        ("missing", ["missing"]),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("attributes", "levels"),
+    [(["a", "b"], 1), (["a"], 2), (["a"], 0), (["a"], True), (["a"], 1.5)],
+)
+def test_levels_validate_attribute_count_and_domain(attributes, levels):
+    env = Environment()
+
+    with pytest.raises(FilterArgumentError):
+        env.call_filter("groupby", [], [attributes], {"levels": levels})
+
+
+def test_levels_async_accepts_async_input_and_preserves_group_interface():
+    async def rows():
+        for value in [{"a": "x", "b": 2}, {"a": "x", "b": 1}]:
+            yield value
+
+    async def run():
+        env = Environment(enable_async=True)
+        return await env.call_filter("groupby", rows(), [["a", "b"]], {"levels": 2})
+
+    groups = asyncio.run(run())
+
+    assert tuple(groups[0]) == ("x", groups[0].list)
+    assert [tuple(child) for child in groups[0].list] == [
+        (1, [groups[0].list[0].list[0]]),
+        (2, [groups[0].list[1].list[0]]),
+    ]
+    assert repr(groups[0]).startswith("('x', [")
