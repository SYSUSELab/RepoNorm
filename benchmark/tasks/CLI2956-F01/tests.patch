+@pytest.mark.parametrize("provider", ["callback", "missing_branch"])
+def test_auto_complete_explicit_strategy_keeps_completion_metadata(monkeypatch, tmp_path, provider):
+    monkeypatch.setenv("N4C_METADATA_VALUE", "secret")
+    assert _completion_values(click.Option(["--setting"], auto_complete="environment"), "N4C_METADATA_") == ["N4C_METADATA_VALUE"]
+    seen = []
+    def complete(ctx, param, incomplete):
+        seen.append((ctx, param, incomplete))
+        return [CompletionItem("alpha/", type="dir", help="Project directory")]
+    class ProjectType(click.ParamType):
+        name = "project"
+        def shell_complete(self, ctx, param, incomplete):
+            return complete(ctx, param, incomplete)
+    attrs = {"shell_complete": complete} if provider == "callback" else {"type": ProjectType()}
+    if provider == "missing_branch":
+        monkeypatch.setenv("PATH", str(tmp_path))
+    option = click.Option(["--identity"], auto_complete="branch", **attrs)
+    ctx = click.Context(click.Command("cli", params=[option]))
+    assert [(item.value, item.type, item.help) for item in option.shell_complete(ctx, "al")] == [
+        ("alpha/", "dir", "Project directory")
+    ]
+    assert seen and all(call == (ctx, option, "al") for call in seen)
+
