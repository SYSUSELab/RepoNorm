+def test_auto_complete_explicit_environment_overrides_name(monkeypatch):
+    monkeypatch.setenv("N4C_EXPLICIT_VALUE", "not-a-completion")
+    @click.command()
+    @click.option("--branch", auto_complete="environment")
+    def cli(branch):
+        pass
+    assert _completion_values(cli.params[0], "N4C_EXPLICIT_") == ["N4C_EXPLICIT_VALUE"]
+
