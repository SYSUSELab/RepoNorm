+@pytest.mark.parametrize("value,error", [("unknown", ValueError), ("", ValueError), (1, TypeError), (None, TypeError)])
+def test_auto_complete_explicit_strategy_invalid_values(value, error):
+    with pytest.raises(error):
+        click.Option(["--identity"], auto_complete=value)
