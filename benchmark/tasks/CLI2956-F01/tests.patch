+@pytest.mark.parametrize("strategy", ["file", "directory"])
+def test_auto_complete_explicit_path_strategy(strategy):
+    option = click.Option(["--destination"], auto_complete=strategy)
+    ctx = click.Context(click.Command("cli", params=[option]))
+    expected = click.Path(file_okay=strategy != "directory").shell_complete(ctx, option, "proj")
+    assert [(item.value, item.type, item.help) for item in option.shell_complete(ctx, "proj")] == [
+        (item.value, item.type, item.help) for item in expected
+    ]
+
