+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. If auto_complete
+        is enabled, uses smart completion based on option name and context.
+        Otherwise, uses the default behavior.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        # Custom shell_complete always takes precedence
+        if self._custom_shell_complete is not None:
+            return super().shell_complete(ctx, incomplete)
+
+        # Use smart completion if enabled
+        if self.auto_complete:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        from click.shell_completion import CompletionItem
+        if self.name is None:
+            return []
+        tokens = (
+            {self.auto_complete}
+            if isinstance(self.auto_complete, str)
+            else set(self.name.lower().split("_"))
+        )
+
+        if tokens.intersection({"user", "username", "owner", "author"}):
+            try:
+                import pwd
+            except ImportError:
+                return super().shell_complete(ctx, incomplete)
+            try:
+                values = {
+                    entry.pw_name for entry in pwd.getpwall()
+                    if entry.pw_name.startswith(incomplete) and not entry.pw_name.startswith("_")
+                }
+            except OSError:
+                return super().shell_complete(ctx, incomplete)
+            return [CompletionItem(value) for value in sorted(values)[:20]]
+
+        if tokens.intersection({"branch", "ref", "revision"}):
+            import subprocess
+            try:
+                result = subprocess.run(
+                    ["git", "branch", "-a", "--format=%(refname:short)"],
+                    capture_output=True, text=True, timeout=2,
+                )
+            except (subprocess.SubprocessError, OSError):
+                return super().shell_complete(ctx, incomplete)
+            if result.returncode != 0:
+                return super().shell_complete(ctx, incomplete)
+            values = {
+                line.strip() for line in result.stdout.splitlines()
+                if line.strip().startswith(incomplete)
+            }
+            return [CompletionItem(value) for value in sorted(values)[:20]]
+
+        if tokens.intersection({"env", "environment", "var"}):
+            prefix = incomplete.upper()
+            values = {name for name in os.environ if name.upper().startswith(prefix)}
+            return [CompletionItem(value) for value in sorted(values)[:20]]
+
+        if tokens.intersection({"file", "path", "dir", "directory", "output", "input"}):
+            path_type = types.Path(
+                file_okay=not tokens.intersection({"dir", "directory"})
+            )
+            return path_type.shell_complete(ctx, self, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+
 
