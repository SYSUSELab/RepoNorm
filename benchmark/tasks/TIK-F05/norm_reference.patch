new file mode 100644
index 0000000..bba27b5
--- /dev/null
+++ b/tests/test_filter_tokens_contribution.py
@@ -0,0 +1,55 @@
+import numpy as np
+import pytest
+
+import tiktoken
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return tiktoken.get_encoding("cl100k_base")
+
+
+@pytest.mark.parametrize("factory", [list, tuple, set])
+def test_list_and_numpy_filtering_match_without_mutation(encoding, factory) -> None:
+    text = "你好😀 hello hello <|endoftext|>"
+    tokens = encoding.encode(text, allowed_special="all")
+    selected = factory([tokens[0], tokens[0], tokens[-1]])
+    before = factory(selected)
+    expected = [token for token in tokens if token not in selected]
+
+    assert encoding.encode(
+        text, allowed_special="all", filter_tokens=selected
+    ) == expected
+    array = encoding.encode_to_numpy(
+        text, allowed_special="all", filter_tokens=selected
+    )
+    assert array.dtype == np.uint32
+    assert array.ndim == 1
+    assert array.tolist() == expected
+    assert selected == before
+
+
+def test_empty_and_all_removed_results_keep_return_types(encoding) -> None:
+    tokens = encoding.encode("hello")
+    assert encoding.encode("hello", filter_tokens=tokens) == []
+    array = encoding.encode_to_numpy("hello", filter_tokens=tokens)
+    assert array.dtype == np.uint32
+    assert array.shape == (0,)
+    assert encoding.encode_to_numpy("", filter_tokens=()).shape == (0,)
+
+
+def test_filtering_does_not_bypass_special_policy(encoding) -> None:
+    special = "<|endoftext|>"
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode(special, filter_tokens=[encoding.eot_token])
+    with pytest.raises(ValueError, match="disallowed special token"):
+        encoding.encode_to_numpy(special, filter_tokens=[encoding.eot_token])
+
+
+def test_list_surrogate_recovery_is_preserved(encoding) -> None:
+    text = "before \ud800 after"
+    unfiltered = encoding.encode(text)
+    assert encoding.encode(text, filter_tokens=()) == unfiltered
+    assert encoding.encode(text, filter_tokens={unfiltered[0]}) == [
+        token for token in unfiltered if token != unfiltered[0]
+    ]
