+import numpy as np
+import pytest
+import tiktoken
+
+
+@pytest.mark.parametrize('container', [list, tuple, set])
+def test_numpy_filter_matches_list(container):
+    enc = tiktoken.get_encoding('cl100k_base')
+    text = '你好😀 hello hello <|endoftext|>'
+    tokens = enc.encode(text, allowed_special='all')
+    for removed in [[], [tokens[0], tokens[0]], tokens]:
+        selected = container(removed)
+        expected = [token for token in tokens if token not in selected]
+        assert enc.encode(text, allowed_special='all', filter_tokens=selected) == expected
+        result = enc.encode_to_numpy(text, allowed_special='all', filter_tokens=selected)
+        assert isinstance(result, np.ndarray) and result.dtype == np.uint32 and result.ndim == 1
+        assert result.tolist() == expected
+        assert selected == container(removed)
+    assert enc.encode_to_numpy('', filter_tokens=[]).tolist() == []
+
+
+def test_numpy_special_policy_not_bypassed():
+    enc = tiktoken.get_encoding('cl100k_base')
+    special = '<|endoftext|>'
+    with pytest.raises(ValueError):
+        enc.encode_to_numpy(special, filter_tokens=[enc.eot_token])
+    for policy in [{"allowed_special": 'all'}, {"disallowed_special": ()}]:
+        assert enc.encode_to_numpy(special, filter_tokens=[], **policy).tolist() == enc.encode(special, **policy)
